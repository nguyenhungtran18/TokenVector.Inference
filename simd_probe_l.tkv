# PROBE L — smm_transpose 32x192 + smm_dot voi gyT
import tv.training.tensor
import tv.training.simd_matmul

def fill(m: 'i64', n: 'i64', kind: 'i64') -> "Tensor":
    out = t_zeros([m, n])
    d = out.data
    for i in range(m * n):
        if kind == 6:
            d[i] = (float((i * 13 + 7) % 59) - 29.0) / 29.0
        if kind == 5:
            d[i] = (float((i * 7 + 13) % 97) - 48.0) / 48.0
    return out

def md(a: "Tensor", b: "Tensor") -> 'f32':
    da = a.data
    db = b.data
    m = 0.0
    for i in range(len(da)):
        dd = da[i] - db[i]
        if dd < 0.0:
            dd = 0.0 - dd
        if dd > m:
            m = dd
    return m

def scalar_trans(a: "Tensor", rows: 'i64', cols: 'i64') -> "Tensor":
    out = t_zeros([cols, rows])
    od = out.data
    d = a.data
    for i in range(rows):
        for j in range(cols):
            od[j * rows + i] = d[i * cols + j]
    return out

def ref_dot(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64') -> "Tensor":
    c = t_zeros([m, n])
    cd = c.data
    ad = a.data
    bd = b.data
    for i in range(m):
        for j in range(n):
            acc = 0.0
            for p in range(k):
                acc = acc + ad[i * k + p] * bd[j * k + p]
            cd[i * n + j] = acc
    return c

def main() -> 'i32':
    m = 32
    out_d = 192
    in_d = 64
    gy = fill(m, out_d, 6)
    x = fill(m, in_d, 5)

    st = scalar_trans(gy, m, out_d)
    gt = smm_transpose(gy, m, out_d)
    print("L1 smm_transpose(32x192) vs scalar: diff=" + str(md(st, gt)))

    r = ref_dot(gt, x, out_d, in_d, m)
    s = smm_dot(gt, x, out_d, in_d, m)
    print("L2 smm_dot(gyT,x) vs scalar ref: diff=" + str(md(r, s)))
    return 0
