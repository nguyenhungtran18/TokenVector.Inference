@q bra L2W;
mul.wide.u32 off,idx,4;
add.u64 da,db,off;
ld.global.f32 dp,[da];
add.u64 pa,pb,off;
ld.global.f32 p,[pa];
sub.f32 t,dp,rs;
mul.f32 t,t,p;
L2W:
mul.wide.u32 off,idx,4;
add.u64 dsa,dsb,off;
st.global.f32 [dsa],t;
