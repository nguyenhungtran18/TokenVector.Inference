add.u32 idx,idx,hoff;
mul.wide.u32 off,idx,4;
add.u64 xa,sb,off;
ld.global.f32 x,[xa];
sub.f32 x,x,mx;
mul.f32 x,x,1.442695;
ex2.approx.f32 e,x;
add.f32 sum,sum,e;
add.u32 j,j,1;
bra L2;
L2D:
mov.u32 j,0;
L3:
setp.ge.u32 q,j,tn;
@q bra LEND;
mul.lo.u32 idx,j,tn;
add.u32 idx,idx,row;
add.u32 idx,idx,hoff;
mov.f32 p,0.0;
setp.gt.u32 q,j,row;
@q bra L3W;
mul.wide.u32 off,idx,4;
add.u64 xa,sb,off;
ld.global.f32 x,[xa];
sub.f32 x,x,mx;
mul.f32 x,x,1.442695;
ex2.approx.f32 e,x;
div.rn.f32 p,e,sum;
L3W:
mul.wide.u32 off,idx,4;
add.u64 pa,pb,off;
st.global.f32 [pa],p;
add.u32 j,j,1;
