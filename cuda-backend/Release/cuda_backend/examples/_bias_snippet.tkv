def bias_init() -> "i64":
    PTX = b".version 8.0\n.target sm_75\n.address_size 64\n.entry biasadd_kernel(.param .u64 pC, .param .u64 pB, .param .u32 pT, .param .u32 pN)\n{\n.reg .f32 c,b;\n.reg .u64 cb,bb,off,ca;\n.reg .u32 i,col,n,base,nt,t;\n.reg .pred q;\nld.param.u64 cb,[pC];\nld.param.u64 bb,[pB];\nld.param.u32 t,[pT];\nld.param.u32 n,[pN];\ncvta.to.global.u64 cb,cb;\ncvta.to.global.u64 bb,bb;\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 i,%tid.x;\nadd.u32 i,i,base;\nsetp.ge.u32 q,i,n;\n@q bra LEND;\ndiv.u32 col,i,t;\nmul.wide.u32 off,i,4;\nadd.u64 ca,cb,off;\nld.global.f32 c,[ca];\nmul.wide.u32 off,col,4;\nadd.u64 bb,bb,off;\nld.global.f32 b,[bb];\nadd.f32 c,c,b;\nst.global.f32 [ca],c;\nLEND:\nret;\n}\n\n.entry biasgrad_kernel(.param .u64 pG, .param .u64 pB, .param .u32 pT, .param .u32 pR)\n{\n.reg .f32 g,s;\n.reg .u64 gb,bb,off,ba,goff;\n.reg .u32 col,i,t,r,base,nt;\n.reg .pred q;\nld.param.u64 gb,[pG];\nld.param.u64 bb,[pB];\nld.param.u32 t,[pT];\nld.param.u32 r,[pR];\ncvta.to.global.u64 gb,gb;\ncvta.to.global.u64 bb,bb;\nmov.u32 nt,%ntid.x;\nmov.u32 base,%ctaid.x;\nmul.lo.u32 base,base,nt;\nmov.u32 col,%tid.x;\nadd.u32 col,col,base;\nsetp.ge.u32 q,col,r;\n@q bra LEND;\nmov.f32 s,0.0;\nmov.u32 i,0;\nLOOP:\nsetp.ge.u32 q,i,t;\n@q bra DONE;\nmul.lo.u32 off,i,t;\nadd.u32 off,off,col;\nmul.wide.u32 goff,off,4;\nadd.u64 ba,gb,goff;\nld.global.f32 g,[ba];\nadd.f32 s,s,g;\nadd.u32 i,i,1;\nbra LOOP;\nDONE:\nmul.wide.u32 off,col,4;\nadd.u64 bb,bb,off;\nst.global.f32 [bb],s;\nLEND:\nret;\n}\n"
    F1 = b"biasadd_kernel\x00"
    F2 = b"biasgrad_kernel\x00"
    pb = alloc_bytes(len(PTX) + 1)
    kk: "i32" = 0
    while kk < len(PTX):
        wh: "i64" = write_u8(pb, kk, PTX[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    mc = alloc_bytes(8)
    rc: "i32" = cu_module_load(mc, pb)
    if rc != 0:
        print("BIAS MOD FAIL", rc)
        return 0
    mod: "i64" = read_i64(mc, 0)
    h = alloc_bytes(16)
    kk = 0
    while kk < len(F1):
        wh = write_u8(pb, kk, F1[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    fc = alloc_bytes(8)
    rc = cu_module_fn(fc, mod, pb)
    if rc != 0:
        print("BIAS FN1 FAIL", rc)
        return 0
    wh = write_i64(h, 0, read_i64(fc, 0))
    kk = 0
    while kk < len(F2):
        wh = write_u8(pb, kk, F2[kk])
        kk = kk + 1
    wh = write_u8(pb, kk, 0)
    rc = cu_module_fn(fc, mod, pb)
    if rc != 0:
        print("BIAS FN2 FAIL", rc)
        return 0
    wh = write_i64(h, 8, read_i64(fc, 0))
    return h

def bias_add(fnh: "i64", c: "i64", b: "i64", t: "i32", n: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, c)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, b)
    a2 = alloc_bytes(4)
    wh = write_i32(a2, 0, t)
    a3 = alloc_bytes(4)
    wh = write_i32(a3, 0, n)
    pl = alloc_bytes(32)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    g: "i32" = (n + 255) >> 8
    rc: "i32" = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("BIAS ADD FAIL", rc)
    return rc

def bias_grad_k(fnh: "i64", gmat: "i64", b: "i64", t: "i32", rows: "i32") -> "i32":
    a0 = alloc_bytes(8)
    wh: "i64" = write_i64(a0, 0, gmat)
    a1 = alloc_bytes(8)
    wh = write_i64(a1, 0, b)
    a2 = alloc_bytes(4)
    wh = write_i32(a2, 0, t)
    a3 = alloc_bytes(4)
    wh = write_i32(a3, 0, rows)
    pl = alloc_bytes(32)
    wh = write_i64(pl, 0, a0)
    wh = write_i64(pl, 8, a1)
    wh = write_i64(pl, 16, a2)
    wh = write_i64(pl, 24, a3)
    g: "i32" = (rows + 255) >> 8
    rc: "i32" = cu_launch(fnh, g, 1, 1, 256, 1, 1, 0, 0, pl, 0)
    if rc != 0:
        print("BIAS GRAD FAIL", rc)
    return rc
