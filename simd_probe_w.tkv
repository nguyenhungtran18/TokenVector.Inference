# PROBE W — now_ms(): delta trong ham vs trong main, va gia tri thô
def _work() -> 'i64':
    s = 0
    for i in range(50000000):
        s = s + i % 3
    return s

def _f_delta() -> 'i64':
    a = now_ms()
    s = _work()
    b = now_ms()
    return b - a

def _f_ret_total(r: 'i64') -> 'i64':
    a = now_ms()
    for k in range(r):
        s = _work()
    return now_ms() - a

def main() -> 'i32':
    print("W raw t0 = " + str(now_ms()))
    t0 = now_ms()
    s = _work()
    print("W main delta = " + str(now_ms() - t0))
    print("W func delta = " + str(_f_delta()))
    print("W func total(2) = " + str(_f_ret_total(2)))
    print("W raw t1 = " + str(now_ms()))
    return 0
