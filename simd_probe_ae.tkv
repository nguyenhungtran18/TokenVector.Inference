# PROBE AE — AdamW tach vong (P6 form 1 phep gan) tren f32buf vs list[f32]
# Cau hoi: co dang tach nao P6 chay duoc (toc do) de quyet dinh P1.4' ?
# Timing toan bo trong main (bug #8). Doc KET QUA de JIT khong xoa vong.
import tv.training.tensor
def main() -> 'i32':
    n = 8000000
    # ---- bo dem f32buf ----
    p = f32buf(n)
    m = f32buf(n)
    v = f32buf(n)
    g = f32buf(n)
    i = 0
    while i < n:
        p[i] = 0.02
        m[i] = 0.0
        v[i] = 0.0
        g[i] = (float(i % 97) - 48.0) / 48.0
        i = i + 1

    # hang so (literal) — broadcast duoc; chi so khong can f32 var
    t0 = now_ms()
    i = 0
    while i < n:
        m[i] = 0.9 * m[i] + 0.1 * g[i]
        i = i + 1
    t1 = now_ms()
    i = 0
    while i < n:
        v[i] = 0.999 * v[i] + 0.001 * g[i] * g[i]
        i = i + 1
    t2 = now_ms()
    i = 0
    while i < n:
        p[i] = p[i] * 0.99 - 0.0025 * m[i] / (sqrt(v[i]) / 0.99949987 + 0.00000001)
        i = i + 1
    t3 = now_ms()
    print("AE buf m-loop=" + str(t1 - t0) + " ms v-loop=" + str(t2 - t1)
          + " ms p-loop(sinh sqrt)=" + str(t3 - t2) + " ms")

    # checksum doc truoc khi free (jit khong xoa)
    cs = 0.0
    i = 0
    while i < n:
        cs = cs + p[i]
        i = i + 1
    print("AE buf sum(p)=" + str(cs))
    f32buf_free(p)
    f32buf_free(m)
    f32buf_free(v)
    f32buf_free(g)

    # ---- cung phep tinh tren list[f32] (kieu hien tai cua AdamW) ----------
    m2 = t_zeros([n])
    v2 = t_zeros([n])
    p2 = t_zeros([n])
    g2 = t_zeros([n])
    j = 0
    while j < n:
        p2.data[j] = 0.02
        v2.data[j] = 0.0
        m2.data[j] = 0.0
        g2.data[j] = (float(j % 97) - 48.0) / 48.0
        j = j + 1

    s0 = now_ms()
    j = 0
    while j < n:
        m2.data[j] = 0.9 * m2.data[j] + 0.1 * g2.data[j]
        j = j + 1
    s1 = now_ms()
    j = 0
    while j < n:
        v2.data[j] = 0.999 * v2.data[j] + 0.001 * g2.data[j] * g2.data[j]
        j = j + 1
    s2 = now_ms()
    j = 0
    while j < n:
        p2.data[j] = p2.data[j] * 0.99 - 0.0025 * m2.data[j] / (sqrt(v2.data[j]) / 0.99949987 + 0.00000001)
        j = j + 1
    s3 = now_ms()
    print("AE list m-loop=" + str(s1 - s0) + " ms v-loop=" + str(s2 - s1)
          + " ms p-loop(sqrt)=" + str(s3 - s2) + " ms")
    cs2 = 0.0
    j = 0
    while j < n:
        cs2 = cs2 + p2.data[j]
        j = j + 1
    print("AE list sum(p)=" + str(cs2))
    print("AE done")
    return 0
