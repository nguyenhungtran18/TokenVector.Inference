# GPT-2 124M reference — G2 (ROADMAP_TRAIN.md)
# ---------------------------------------------------
# Kien truc chuan: HuggingFace `gpt2` (vocab 50257, hidden 768, 12 heads,
# 12 blocks, max_pos 1024, weight tying LM head <-> embedding).
#
# LUU Y: `numerics-contract.md` da duyet: fp32, GELU erf, dropout=0 cho parity.
# LUU Y: SIMT khong duoc bat cho parity (simd khong bit-exact). Kernel
# registry chuyen backend='cpu' cho duong parity.
# ---------------------------------------------------

import tv.training.ops

# ---- thong so GPT-2 chuan --------------------------------------------------
VocabSize = 50257
HiddenSize = 768
NHeads = 12
HeadDim = 64
NLayers = 12
MaxPos = 1024
EPS = 1e-6

# ---- Embedding (wte + wpe) + position -----------------------

class EmbeddingWte:
    _ok: 'i64'
    wte: 'list[f32]'
    wpe: 'list[f32]'
    vocab: 'i64'
    hidden: 'i64'
    max_pos: 'i64'
    d: 'i64'

    def __init__(self, vocab: 'i64', hidden: 'i64', max_pos: 'i64'):
        self.vocab = vocab
        self.hidden = hidden
        self.max_pos = max_pos
        self.d = hidden
        # init binh thuong; trong thuc te can init theo thu tu co dinh (normal(0,0.02))
        # de parity; o G2 ta se dung weight init co dinh.
        self.wte = []
        self.wpe = []

    def lookup(self, token_ids: 'list[i64]', d: 'i64') -> "Tensor":
        # G2: lookup su dung `op_embed_fwd` (index-add co sap xep chi so).
        # KET QUA: Tensor co `data` dai `len(token_ids)*self.hidden`.
        wt = tv.training.ops.t_new(self.wte, [self.vocab, self.hidden], 0)
        out = tv.training.ops.op_embed_fwd(wt, token_ids, self.hidden)
        out = Tensor(out.data, [len(token_ids), d], 0)
        return out

# ---- Block skeleton: Norm -> Attention -> Residual -> MLP -> Residual ----

def gpt2_block_skeleton(x: "Tensor", w_attn: "Tensor", w_mlp: "Tensor",
                         b_attn: "Tensor", b_mlp: "Tensor",
                         mask: 'list[i64]', target: 'i64') -> 'f32':
    # G2 skeleton: chung minh 6-tang op chain chay qua block tong quat
    # (norm -> attention -> add -> norm -> mlp -> ce).
    # Hien chi tra ve 0 de bien dich, chua tinh that. G2 se hoan thien.
    return 0.0

# ---- Attention MHA (manual) ---------------------------------------------

def gpt2_attn_skeleton(x: "Tensor", w_attn: "Tensor", b_attn: "Tensor",
                       mask: 'list[i64]', heads: 'i64', d_head: 'i64') -> "Tensor":
    # G2: MHA su dung matmul/softmax/mask. Chi tra ve Tensor zero cung
    # kich thuoc dau ra (n, hidden) de bi dich; tinh that de sau.
    n = x.shape[0]
    hidden = x.shape[1]
    out = tv.training.ops.t_zeros([n, hidden])
    return out

# ---- MLP skeleton (norm -> linear -> GELU -> linear -> add) -------------------

def gpt2_mlp_skeleton(x: "Tensor", w_mlp: "Tensor", b_mlp: "Tensor") -> "Tensor":
    # G2: MLP su dung matmul, relu/gelu, add. Chi tra ve Tensor zero.
    n = x.shape[0]
    hidden = x.shape[1]
    out = tv.training.ops.t_zeros([n, hidden])
    return out

# ---- LM head skeleton (tie embedding weights) -----------------------------

def gpt2_lm_head_skeleton(logits: "Tensor", emb_w: "Tensor") -> 'f32':
    # G2 skeleton: LM head su dung weight tying voi embedding.
    # Hien chi tra ve 0 de bien dich.
    return 0.0

# ---- Norm layer (LayerNorm/RMSNorm) dung lai op core -------------------

def _norm_zeros_like(t: "Tensor") -> "Tensor":
    # Khoi tao zero cung kich thuoc
    # (dung cho gradient buffer, loss seed, etc.)
    return tv.training.ops.t_zeros(t)
