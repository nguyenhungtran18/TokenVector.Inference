# G4 x G2: NOI TRAINER VAO GPT-2 (ROADMAP_TRAIN — muc tieu 2/3 cua §2)
#
# AdamW cua `trainer.tkv` lam viec tren MOT vector phang, con GPT-2 (`gpt2_ref`)
# giu 28 tensor rieng. Module nay lam cau noi:
#   - flatten/unflatten trong so (thu tu CO DINH = dung thu tu dau ra cua
#     `gpt2_backward`, cung la thu tu `gpt2_init`)
#   - mot buoc train that: forward -> loss -> backward -> clip -> AdamW -> ghi
#     trong so tro lai tensor
#   - checkpoint dung nguyen dinh dang cua trainer (bit f32 -> resume bit-exact)
#
# Thu tu 28 tensor (index trong list):
#   [0] wte  [1] wpe  [2] lnf_g  [3] lnf_b
#   layer li: base = 4 + li*12
#     0 ln1_g  1 ln1_b  2 w_qkv  3 b_qkv  4 w_proj  5 b_proj
#     6 ln2_g  7 ln2_b  8 w1     9 b1    10 w2     11 b2

import tv.training.gpt2_ref
import tv.training.trainer

def gpt2_group_sizes(ps: 'list[Tensor]') -> 'list[i64]':
    # kich thuoc tung tensor -> nhom cho grad norm (giong PyTorch: L2 tung
    # tensor roi L2 cac norm)
    out = []
    for i in range(len(ps)):
        # quirk compiler: `ps[i].data` truc tiep bi hieu sai dtype — phai
        # gan Tensor ra bien roi moi lay .data.
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def gpt2_n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def gpt2_flatten(ps: 'list[Tensor]') -> 'list[f32]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            out.append(d[j])
    return out

def gpt2_unflatten(ps: 'list[Tensor]', flat: 'list[f32]') -> 'i32':
    # Phase B2 (2026-10-27): thu duong buffer slice (f32buf_wrap + copy_from_buf)
    # — bench A/B cho 0% tai ca seq8/seq1024 + phinh ~0.9GB RAM @seq1024
    # (so voi 844ms uoc tinh) → DROP, giu duong interpreted cu.
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = flat[off + j]
        off = off + len(d)
    return 0

def gpt2_copy_into(dst: 'list[f32]', src: 'list[f32]') -> 'i32':
    for i in range(len(src)):
        dst[i] = src[i]
    return 0

# ---- goi model voi ps (thay vi 20 tham so roi) -----------------------------

def gpt2_fwd_ps(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32' = 0,
                sc5: "list[f32]" = None) -> "Tensor":
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    _wte = ps[0]
    _wpe = ps[1]
    _g = ps[2]
    _b = ps[3]
    return gpt2_forward(ids, pos, _wte, _wpe, ln1_g, ln1_b, wq, bq, wp, bp,
                        ln2_g, ln2_b, w1, b1, w2, b2, _g, _b, simd, sc5)

def gpt2_bwd_ps(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]',
                simd: 'i32' = 0, gflat: 'list[f32]' = None,
                sc4: "list[f32]" = None) -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    _wte = ps[0]
    _wpe = ps[1]
    _g = ps[2]
    _b = ps[3]
    return gpt2_backward(ids, pos, _wte, _wpe, ln1_g, ln1_b, wq, bq, wp, bp,
                         ln2_g, ln2_b, w1, b1, w2, b2, _g, _b, simd, gflat, None, sc4)

def gpt2_loss_of(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32' = 0,
                 sc5: "list[f32]" = None) -> 'f32':
    z = gpt2_fwd_ps(ps, ids, pos, simd, sc5)
    return gpt2_loss(z, ids)

# ---- mot buoc train --------------------------------------------------------

# P1.2 (perf-plan 2026-10-19): DA PROBE — fused step+unflatten KHONG THANG.
# So do best-of-5 tren 124M (probe simd_probe_ah): duong cu step()+unflatten
# = 4516ms; fused moi hinh thuc deu cham hon: while-loop 6468, for-range 5453,
# bo ghi d 4704, function-level 7547. Con ca bug do ra: `for jj in range(sz)`
# ket hop `jj = jj + 1` con lai tu while-loop → skip nua phan tu (loss sai,
# gate [5 bat duoc). KET LUAN: GIU 2 VONG RIENG — dung lam lai fused nay.
#
# P6 GĐ7 (2026-10-21, do BR[5]: zero_grad 124M = 250ms): zero_grad chay
# worker DONG THOI forward (forward khong dot opt.g) — join TRUOC backward
# (bwd ghi += vao opt.g) -> ket qua GIONG HET (bit-exact), an 250ms/buoc.
class _ZrJob:
    gl: "list[f32]"
    def __init__(self, gl: "list[f32]"):
        self.gl = gl

def _zr_one(j: "_ZrJob") -> 'i64':
    for i in range(len(j.gl)):
        j.gl[i] = 0.0
    return 0

def gpt2_train_step(opt: "AdamW", ps: 'list[Tensor]',
                    ids: 'list[i64]', pos: 'list[i64]', simd: 'i32' = 0,
                    sc5: "list[f32]" = None, sc4: "list[f32]" = None) -> 'f32':
    # P6 GĐ7: spawn zero_grad TRUOC forward, join TRUOC backward — an 250ms
    # (BR[5]) vi forward khong dot opt.g; ket qua khong doi (bit-exact).
    zh = thread_spawn(_zr_one, _ZrJob(opt.g))
    loss = gpt2_loss_of(ps, ids, pos, simd, sc5)
    jz = thread_join(zh)
    # P1.1 (perf-plan): bwd ghi THANG param grads vao opt.g (da zero) —
    # bo duoc materialization grads 148 tensor (~1.6 GB song) + vong GRAD_ACC
    # (~1.4s/buoc 124M). out list cua backward = placeholder len 0.
    # Khac thu tu accumulate vs duong cu -> ULP-scale (parity torch ok).
    grads = gpt2_bwd_ps(ps, ids, pos, simd, opt.g, sc4)
    opt.step()
    # ghi trong so da cap nhat tro lai tensor
    gpt2_unflatten(ps, opt.p)
    return loss

def gpt2_train_steps(opt: "AdamW", ps: 'list[Tensor]',
                     ids: 'list[i64]', pos: 'list[i64]', n_steps: 'i64', simd: 'i32' = 0,
                     sc5: "list[f32]" = None, sc4: "list[f32]" = None) -> 'list[f32]':
    # M3c: scratchpersistent cho lm-head C — neu caller khong truyen thi alloc
    # 1 lan o day (vong lap goi lai toi da n_steps lan) — fallback None van
    # binh thuong (t_zeros trong wrapper) neu khong alloc.
    if sc5 == None:
        n = len(ids)
        t5 = t_zeros([n * VocabSize])
        sc5 = t5.data
        t4 = t_zeros([VocabSize * HiddenSize])
        sc4 = t4.data
    losses = []
    for s in range(n_steps):
        losses.append(gpt2_train_step(opt, ps, ids, pos, simd, sc5, sc4))
    return losses
