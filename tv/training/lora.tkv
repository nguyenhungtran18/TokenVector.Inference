// TokenVector Module: Training — LoRA adapters + checkpoint activation arena
// TRIZ group 1 (pretrain/fine-tune): shrink trainable state (LoRA rank-r) and
// resolve the arena-vs-backward contradiction with a second allocation policy
// (Checkpoints pin buffers until backward finishes; scratchpad still recycles).
// Full-model pretraining remains out of scope (needs GPU — see runtime.hal).

module tv.training.lora

import tv.numerics.tensor
import tv.training.autograd

# LoRA: y = x @ W^T + b + (alpha/r) * (x @ A^T) @ D^T
# W,b frozen; A [r,k], D [n,r] trainable. K-blocked base path reuses LinHead.
public class LoRALinear:
    def __init__(self, w: NDArray[float32], b: NDArray[float32], m: int, n: int, k: int,
            rank: int, alpha: float32 = 1.0, seed: int = 13):
        if rank <= 0 or rank > min(n, k):
            raise Arg("rank must be in [1, min(n,k)]")
        self.base = LinHead(w, b, m, n, k)
        self.m = m
        self.n = n
        self.k = k
        self.rank = rank
        self.scale = alpha / float(rank)
        self.a = NDArray[float32]([rank * k])
        self.d = NDArray[float32]([n * rank])
        s = seed
        inv = 1.0 / sqrt(float(k))
        for i in range(len(self.a)):
            s = (s * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
            self.a[i] = (float(s % 2000) / 1000.0 - 1.0) * inv
        for i in range(len(self.d)):
            self.d[i] = 0.0
        self.ga = NDArray[float32]([rank * k])
        self.gd = NDArray[float32]([n * rank])
        self._x: NDArray[float32] = None
        self._h: NDArray[float32] = None
        self.zero_grad()

    public def zero_grad(self):
        for i in range(len(self.ga)):
            self.ga[i] = 0.0
        for i in range(len(self.gd)):
            self.gd[i] = 0.0
        self.base.zero_grad()

    # adapter path only: h = x @ A^T [m,r] ; y = base(x) + scale * h @ D^T
    public def forward(self, x: NDArray[float32]) -> NDArray[float32]:
        self._x = x
        y = self.base.forward(x)
        h = NDArray[float32]([self.m * self.rank])
        for mm in range(self.m):
            for r in range(self.rank):
                acc = 0.0
                kk = 0
                while kk + 32 <= self.k:
                    for l in range(32):
                        acc = acc + x[mm * self.k + kk + l] * self.a[r * self.k + kk + l]
                    kk = kk + 32
                while kk < self.k:
                    acc = acc + x[mm * self.k + kk] * self.a[r * self.k + kk]
                    kk = kk + 1
                h[mm * self.rank + r] = acc
        self._h = h
        for mm in range(self.m):
            for nn in range(self.n):
                acc = 0.0
                for r in range(self.rank):
                    acc = acc + h[mm * self.rank + r] * self.d[nn * self.rank + r]
                y[mm * self.n + nn] = y[mm * self.n + nn] + self.scale * acc
        return y

    # dy [m,n] -> accumulate ga, gd only (base frozen); returns dx [m,k]
    public def backward(self, dy: NDArray[float32]) -> NDArray[float32]:
        dx = self.base.backward(dy)
        for mm in range(self.m):
            for nn in range(self.n):
                g = dy[mm * self.n + nn] * self.scale
                for r in range(self.rank):
                    self.gd[nn * self.rank + r] = self.gd[nn * self.rank + r] + g * self._h[mm * self.rank + r]
                    gh = g * self.d[nn * self.rank + r]
                    for p in range(self.k):
                        self.ga[r * self.k + p] = self.ga[r * self.k + p] + gh * self._x[mm * self.k + p]
                        dx[mm * self.k + p] = dx[mm * self.k + p] + gh * self.a[r * self.k + p]
        return dx

    public def adapter_step(self, lr: float32):
        for i in range(len(self.a)):
            self.a[i] = self.a[i] - lr * self.ga[i]
        for i in range(len(self.d)):
            self.d[i] = self.d[i] - lr * self.gd[i]

    # merged W' = W + scale * D @ A  (still [n,k]) — export/inference path
    public def merged_weight(self) -> NDArray[float32]:
        out = NDArray[float32]([self.n * self.k])
        for i in range(len(self.base.w)):
            out[i] = self.base.w[i]
        for nn in range(self.n):
            for kk in range(self.k):
                acc = 0.0
                for r in range(self.rank):
                    acc = acc + self.d[nn * self.rank + r] * self.a[r * self.k + kk]
                out[nn * self.k + kk] = out[nn * self.k + kk] + self.scale * acc
        return out

public def lora_train_row(l: LoRALinear, x: NDArray[float32], t: NDArray[float32], lr: float32) -> float32:
    y = l.forward(x)
    loss = mse_forward(y, t)
    dy = NDArray[float32]([len(y)])
    mse_backward(y, t, dy)
    l.backward(dy)
    l.adapter_step(lr)
    l.zero_grad()
    return loss

# Second allocation policy: named activation checkpoints pinned until release().
# Contrasts with ExecutionMemoryArena scratch reuse — training marks buffers
# that backward still needs so liveness does not recycle them early.
public class CheckpointArena:
    def __init__(self, capacity: int = 64):
        self.capacity = capacity
        self._buf: dict[str, NDArray[float32]] = {}
        self._pinned: dict[str, bool] = {}
        self._order: list[str] = []
        self.hits: int = 0
        self.misses: int = 0

    public def save(self, name: str, src: NDArray[float32], pin: bool = True):
        if name not in self._buf:
            if len(self._order) >= self.capacity:
                raise Arg("checkpoint arena full — release() before save")
            self._order.append(name)
            self._buf[name] = NDArray[float32]([len(src)])
        dst = self._buf[name]
        for i in range(len(src)):
            dst[i] = src[i]
        self._pinned[name] = pin

    public def get(self, name: str) -> NDArray[float32]:
        if name not in self._buf:
            self.misses = self.misses + 1
            raise NotFound(f"checkpoint '{name}' not found")
        self.hits = self.hits + 1
        return self._buf[name]

    public def has(self, name: str) -> bool:
        return name in self._buf

    public def release(self, name: str):
        if name in self._pinned:
            self._pinned[name] = False

    # drop unpinned entries (scratch may recycle); pinned survive for backward
    public def reclaim(self):
        keep: list[str] = []
        for nm in self._order:
            if self._pinned.get(nm, False):
                keep.append(nm)
            else:
                self._buf.pop(nm, None)
                self._pinned.pop(nm, None)
        self._order = keep

    public def pinned_count(self) -> int:
        c = 0
        for nm in self._pinned:
            if self._pinned[nm]:
                c = c + 1
        return c

    public def release_all(self):
        for nm in list(self._pinned.keys()):
            self._pinned[nm] = False
