def _i64tok(t: 'str') -> 'i64':
    v = 0
    neg = 0
    start = 0
    if len(t) > 0 and t[0] == "-":
        neg = 1
        start = 1
    for i in range(start, len(t)):
        v = v * 10 + (ord(t[i]) - 48)
