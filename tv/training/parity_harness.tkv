# G5 PARITY HARNESS (ROADMAP_TRAIN G5) — mot lenh, bao cao ti le khop.
#
# Chay thu cong:
#   tkvc tv/tests/harness_tests.tkv harness.exe main
# hoac:  powershell -File tools/verify_train_parity.ps1
#
# Harness so sanh output cua backend (`tv/training/backend.tkv`) voi fixture
# PyTorch da check-in (`tools/gen_fixtures.py` sinh 1 lan). Moi case tra ve
# max_abs_diff; nguong 1e-5 giong parity_tests.
#
# Them op/backend moi:
#   - backend moi: them gia tri `kind` + nhanh trong be_* (backend.tkv)
#   - op moi: them case vao h_case_run + ten vao h_case_name, tang count
#   Khong phai sua trainer/ops.

import tv.training.backend

FIX_DIR = "tv/tests/fixtures/"
TOL = 1e-5

def _h_is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def _h_load(path: 'str') -> 'list[f32]':
    txt = read_file(path)
    lines = txt.split("\n")
    out = []
    for i in range(len(lines)):
        ln = lines[i]
        if _h_is_comment(ln) == 1:
            continue
        toks = ln.split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                out.append(float(toks[j]))
    return out

def _h_maxdiff(a: 'list[f32]', b: 'list[f32]') -> 'f32':
    n = len(a)
    if len(b) < n:
        n = len(b)
    m = 0.0
    for i in range(n):
        d = a[i] - b[i]
        if d < 0.0:
            d = 0.0 - d
        if d > m:
            m = d
    if len(a) != len(b):
        return 1000000.0
    return m

# ---- danh sach case --------------------------------------------------------

def h_case_count() -> 'i64':
    return 5

def h_case_name(i: 'i64') -> 'str':
    if i == 0:
        return "gelu_erf"
    if i == 1:
        return "gelu_tanh"
    if i == 2:
        return "softmax_row"
    if i == 3:
        return "rmsnorm"
    return "cross_entropy"

def h_case_tol(i: 'i64') -> 'f32':
    return TOL

# ---- chay 1 case: tra max_abs_diff vs fixture ------------------------------

def h_case_run(b: "Backend", i: 'i64') -> 'f32':
    if i == 0:
        gx = _h_load(FIX_DIR + "gelu_x.txt")
        gy = _h_load(FIX_DIR + "gelu_y_erf.txt")
        mine = []
        for k in range(len(gx)):
            mine.append(be_gelu_erf(b, gx[k]))
        return _h_maxdiff(mine, gy)
    if i == 1:
        gx = _h_load(FIX_DIR + "gelu_x.txt")
        gy = _h_load(FIX_DIR + "gelu_y_tanh.txt")
        mine = []
        for k in range(len(gx)):
            mine.append(be_gelu_tanh(b, gx[k]))
        return _h_maxdiff(mine, gy)
    if i == 2:
        sx = _h_load(FIX_DIR + "softmax_row_x.txt")
        sy = _h_load(FIX_DIR + "softmax_row_y.txt")
        return _h_maxdiff(be_softmax_row(b, sx), sy)
    if i == 3:
        rx = _h_load(FIX_DIR + "rmsnorm_x.txt")
        ry = _h_load(FIX_DIR + "rmsnorm_y.txt")
        return _h_maxdiff(be_rmsnorm_row(b, rx, 0.000001), ry)
    cl = _h_load(FIX_DIR + "ce_logits.txt")
    cy = _h_load(FIX_DIR + "ce_loss.txt")
    _mine = be_cross_entropy(b, cl, 2)
    _d = _mine - cy[0]
    if _d < 0.0:
        _d = 0.0 - _d
    return _d

# ---- bao cao: N/N khop (pct%) ---------------------------------------------

def h_report(b: "Backend") -> 'i32':
    n = h_case_count()
    fails = 0
    print("=== G5 parity harness (backend=" + b.name + ") ===")
    for i in range(n):
        tol = h_case_tol(i)
        d = h_case_run(b, i)
        if d <= tol:
            print("  [PASS] " + h_case_name(i) + "  max_abs_diff=" + str(d))
        else:
            print("  [FAIL] " + h_case_name(i) + "  max_abs_diff=" + str(d)
                  + "  tol=" + str(tol))
            fails = fails + 1
    ok = n - fails
    pct = ok * 100 / n
    print("=== " + str(ok) + "/" + str(n) + " khop (" + str(pct) + "%) ===")
    return fails
