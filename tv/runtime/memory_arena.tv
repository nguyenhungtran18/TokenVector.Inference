// TokenVector Module: Runtime — Memory Arena (Zero-GC scratchpad)
// 64-byte aligned unmanaged arena with tensor liveness reuse.
// This module owns lifetime + safe slice API.

module tv.runtime.memory_arena

import tv.numerics.tensor

public class ExecutionMemoryArena:
    def __init__(self, size_in_bytes: int):
        if size_in_bytes == 0:
            size_in_bytes = 64
        # Align up to 64 bytes (AVX2 / AVX-512)
        size_in_bytes = (size_in_bytes + 63) & ~63
        self.size_in_bytes = size_in_bytes
        self.handle = native_arena_alloc(size_in_bytes)

    def get_float_span(self, byte_offset: int, count: int) -> NDArray[float32]:
        self._check_range(byte_offset, count * 4)
        return native_arena_float_view(self.handle, byte_offset, count)

    # Pure .tv copies through zero-copy views (no host memmove dependency)
    def copy_from(self, byte_offset: int, src: NDArray[float32]):
        dst = self.get_float_span(byte_offset, len(src))
        for i in range(len(src)):
            dst[i] = src[i]

    def copy_to(self, byte_offset: int, dst: NDArray[float32]):
        src = self.get_float_span(byte_offset, len(dst))
        for i in range(len(dst)):
            dst[i] = src[i]

    def copy_from_int8(self, byte_offset: int, src: NDArray[int8]):
        dst = self.get_int8_span(byte_offset, len(src))
        for i in range(len(src)):
            dst[i] = src[i]

    def copy_to_int8(self, byte_offset: int, dst: NDArray[int8]):
        src = self.get_int8_span(byte_offset, len(dst))
        for i in range(len(dst)):
            dst[i] = src[i]

    def copy_from_int32(self, byte_offset: int, src: NDArray[int]):
        dst = self.get_int32_span(byte_offset, len(src))
        for i in range(len(dst)):
            dst[i] = src[i]

    def copy_to_int32(self, byte_offset: int, dst: NDArray[int]):
        src = self.get_int32_span(byte_offset, len(dst))
        for i in range(len(dst)):
            dst[i] = src[i]

    def get_int8_span(self, byte_offset: int, count: int) -> NDArray[int8]:
        self._check_range(byte_offset, count)
        return native_arena_int8_view(self.handle, byte_offset, count)

    def get_int32_span(self, byte_offset: int, count: int) -> NDArray[int]:
        self._check_range(byte_offset, count * 4)
        return native_arena_int32_view(self.handle, byte_offset, count)

    def _check_range(self, byte_offset: int, num_bytes: int):
        if byte_offset < 0 or byte_offset + num_bytes > self.size_in_bytes:
            raise OutOfRange(f"offset {byte_offset}+{num_bytes} exceeds arena {self.size_in_bytes}")

    def dispose(self):
        if self.handle != 0:
            native_arena_free(self.handle)
            self.handle = 0

# --- host intrinsics: raw memory only (alloc/free/view), like libc malloc.
# Everything built on top (copies, kernels, graphs) is pure .tv.
extern def native_arena_alloc(size_in_bytes: int) -> int
extern def native_arena_free(handle: int)
extern def native_arena_float_view(handle: int, byte_offset: int, count: int) -> NDArray[float32]
extern def native_arena_int8_view(handle: int, byte_offset: int, count: int) -> NDArray[int8]
extern def native_arena_int32_view(handle: int, byte_offset: int, count: int) -> NDArray[int]
