// TokenVector Module: Runtime — Execution Node (all operators)
// Pure .tv dispatch: elementwise/softmax/attention/shape ops run on zero-copy
// arena views; matmul/conv/norm route through tv.optimization.kernels.

module tv.runtime.execution_node

import tv.runtime.tensor_desc
import tv.runtime.memory_arena
import tv.optimization.kernels
import tv.quantization.matmul
import tv.numerics.tensor

public enum OperatorType:
    Custom = 0
    MatMul = 1
    FusedLinear = 2
    Conv2D = 3
    FusedConv2D = 4
    RMSNorm = 5
    LayerNorm = 6
    Attention = 7
    Relu = 8
    Gelu = 9
    Silu = 10
    Sigmoid = 11
    Tanh = 12
    Add = 13
    Sub = 14
    Mul = 15
    Div = 16
    Softmax = 17
    Reshape = 18
    Transpose = 19
    Concat = 20
    QuantizedGemm = 21
    Identity = 22
    Gather = 23
    Slice = 24
    Split = 25
    Squeeze = 26
    Unsqueeze = 27
    Expand = 28
    Clip = 29
    Cast = 30
    ReduceMean = 31
    ReduceSum = 32
    ReduceMax = 33
    GlobalAveragePool = 34
    MaxPool = 35
    AveragePool = 36
    BatchNormalization = 37
    Flatten = 38
    Pad = 39
    Dropout = 40
    Gemm = 41
    LeakyRelu = 42
    Elu = 43
    Softplus = 44
    Pow = 45
    Sqrt = 46
    Exp = 47
    Neg = 48
    ArgMax = 49
    Shape = 50
    Size = 51
    Min = 52
    Max = 53
    Mean = 54
    Sum = 55
    Where = 56
    Reciprocal = 57
    Abs = 58
    Log = 59
    LogSoftmax = 60
    Trilu = 61
    TopK = 62
    QuantizeLinear = 63
    DequantizeLinear = 64
    QLinearMatMul = 65

public class ExecutionNode:
    def __init__(self, name: str, op: OperatorType):
        self.id = -1
        self.name = name
        self.op_type = op
        self.inputs: list[str] = []
        self.outputs: list[str] = []
        self.input_descs: list[TensorDesc] = []
        self.output_descs: list[TensorDesc] = []
        self.activation: ActivationFunction = ActivationFunction.None
        self.alpha: float32 = 1.0
        self.beta: float32 = 1.0
        self.epsilon: float32 = 1e-5
        self.trans_a: int = 0
        self.trans_b: int = 0
        self.strides: list[int] = [1, 1]
        self.pads: list[int] = [0, 0, 0, 0]
        self.perm: list[int] = []
        self.axis: int = -1
        self.axes: list[int] = []
        self.keepdims: int = 1
        self.kernel_shape: list[int] = []
        self.clip_min: float32 = -3.4e38
        self.clip_max: float32 = 3.4e38
        self.tri_upper: int = 0
        self.tri_k: int = 0
        self.topk_largest: int = 1
        self.topk_sorted: int = 1
        self.qlinear_axis: int = 1
        # quantization params
        self.scale_a: float32 = 1.0
        self.scale_b: float32 = 1.0
        self.scale_y: float32 = 1.0
        self.zp_a: int = 0
        self.zp_b: int = 0
        self.zp_y: int = 0
        # per-channel weight scales (empty = per-tensor scale_b)
        self.scales_w: list[float32] = []
        # attention (SDPA / MHA / GQA) params:
        # Q:[Sq,H] K:[Skv,H] V:[Skv,H] (+ optional additive Mask:[Sq,Skv] as 4th input)
        # num_heads > 0 splits H into heads; num_kv_heads KV heads (1 = MQA)
        self.num_heads: int = 0
        self.num_kv_heads: int = 0
        self.causal: bool = False
        self.attn_scale_override: float32 = 0.0
        self.kv_offset: int = 0

    public def execute(self, arena: ExecutionMemoryArena):
        op = self.op_type
        if op == OperatorType.FusedLinear or op == OperatorType.MatMul:
            self._exec_linear(arena)
        elif op == OperatorType.Gemm:
            self._exec_gemm(arena)
        elif op == OperatorType.FusedConv2D or op == OperatorType.Conv2D:
            self._exec_conv2d(arena)
        elif op == OperatorType.RMSNorm:
            self._exec_rms_norm(arena)
        elif op == OperatorType.LayerNorm:
            self._exec_layer_norm(arena)
        elif op == OperatorType.Relu:
            self._exec_unary(arena, ActivationFunction.ReLU)
        elif op == OperatorType.Gelu:
            self._exec_unary(arena, ActivationFunction.GELU)
        elif op == OperatorType.Silu:
            self._exec_unary(arena, ActivationFunction.SiLU)
        elif op == OperatorType.Sigmoid:
            self._exec_unary(arena, ActivationFunction.Sigmoid)
        elif op == OperatorType.Tanh:
            self._exec_unary(arena, ActivationFunction.Tanh)
        elif op == OperatorType.LeakyRelu:
            self._exec_leaky(arena)
        elif op == OperatorType.Elu:
            self._exec_elu(arena)
        elif op == OperatorType.Softplus:
            self._exec_softplus(arena)
        elif op == OperatorType.Sqrt:
            self._exec_unary_math(arena, 0)
        elif op == OperatorType.Exp:
            self._exec_unary_math(arena, 1)
        elif op == OperatorType.Log:
            self._exec_unary_math(arena, 2)
        elif op == OperatorType.Neg:
            self._exec_unary_math(arena, 3)
        elif op == OperatorType.Reciprocal:
            self._exec_unary_math(arena, 4)
        elif op == OperatorType.Abs:
            self._exec_unary_math(arena, 5)
        elif op == OperatorType.Add:
            self._exec_binary(arena, BinaryOp.Add)
        elif op == OperatorType.Sub:
            self._exec_binary(arena, BinaryOp.Sub)
        elif op == OperatorType.Mul:
            self._exec_binary(arena, BinaryOp.Mul)
        elif op == OperatorType.Div:
            self._exec_binary(arena, BinaryOp.Div)
        elif op == OperatorType.Pow:
            self._exec_pow(arena)
        elif op == OperatorType.Min:
            self._exec_variadic(arena, 0)
        elif op == OperatorType.Max:
            self._exec_variadic(arena, 1)
        elif op == OperatorType.Mean:
            self._exec_variadic(arena, 2)
        elif op == OperatorType.Sum:
            self._exec_variadic(arena, 3)
        elif op == OperatorType.Where:
            self._exec_where(arena)
        elif op == OperatorType.Clip:
            self._exec_clip(arena)
        elif op == OperatorType.Softmax:
            self._exec_softmax(arena)
        elif op == OperatorType.LogSoftmax:
            self._exec_log_softmax(arena)
        elif op == OperatorType.Trilu:
            self._exec_trilu(arena)
        elif op == OperatorType.TopK:
            self._exec_topk(arena)
        elif op == OperatorType.QuantizeLinear:
            self._exec_quantize_linear(arena)
        elif op == OperatorType.DequantizeLinear:
            self._exec_dequantize_linear(arena)
        elif op == OperatorType.QLinearMatMul:
            self._exec_qlinear_matmul(arena)
        elif op == OperatorType.Attention:
            self._exec_attention(arena)
        elif op == OperatorType.QuantizedGemm:
            # Quantized operands live in the arena as int8; views (not raw
            # pointers) match the pure-.tv matmul signatures.
            aq = arena.get_int8_span(self.input_descs[0].offset, self.input_descs[0].element_count)
            wq = arena.get_int8_span(self.input_descs[1].offset, self.input_descs[1].element_count)
            yf = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
            if len(self.input_descs) > 2:
                bf = arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)
            else:
                bf = NDArray[float32]([0])
            if len(self.scales_w) > 0:
                matmul.matmul_int8_per_channel(aq, wq, bf, yf,
                    self._m(), self._n_gemm(), self._k_gemm(), self.scale_a, self.scales_w)
            else:
                matmul.matmul_int8_symmetric(aq, wq, bf, yf,
                    self._m(), self._n_gemm(), self._k_gemm(), self.scale_a, self.scale_b)
        elif op == OperatorType.Gather:
            self._exec_gather(arena)
        elif op == OperatorType.Slice:
            self._exec_slice(arena)
        elif op == OperatorType.Split:
            self._exec_split(arena)
        elif op == OperatorType.Expand:
            self._exec_expand(arena)
        elif op == OperatorType.ReduceMean:
            self._exec_reduce(arena, 0)
        elif op == OperatorType.ReduceSum:
            self._exec_reduce(arena, 1)
        elif op == OperatorType.ReduceMax:
            self._exec_reduce(arena, 2)
        elif op == OperatorType.GlobalAveragePool:
            self._exec_gap(arena)
        elif op == OperatorType.MaxPool:
            self._exec_pool(arena, True)
        elif op == OperatorType.AveragePool:
            self._exec_pool(arena, False)
        elif op == OperatorType.BatchNormalization:
            self._exec_batchnorm(arena)
        elif op == OperatorType.Pad:
            self._exec_pad(arena)
        elif op == OperatorType.Concat:
            self._exec_concat(arena)
        elif op == OperatorType.ArgMax:
            self._exec_argmax(arena)
        elif op == OperatorType.Shape:
            self._exec_shape(arena)
        elif op == OperatorType.Size:
            self._exec_size(arena)
        elif op == OperatorType.Transpose:
            self._exec_transpose(arena)
        else:
            # Reshape/Identity/Cast/Dropout/Flatten/Squeeze/Unsqueeze: row-major layout unchanged
            self._exec_identity(arena)

    def _exec_linear(self, arena: ExecutionMemoryArena):
        a = self.input_descs[0]
        b = self.input_descs[1]
        y = self.output_descs[0]
        m = a.shape[0] if len(a.shape) > 1 else 1
        k = a.shape[len(a.shape)-1] if len(a.shape) > 1 else a.element_count
        if len(a.shape) > 2:
            m = 1
            for i in range(len(a.shape) - 1):
                m = m * a.shape[i]
            k = a.shape[len(a.shape)-1]
        n = b.element_count
        trans_b = self.trans_b != 0
        if len(b.shape) == 2:
            if b.shape[1] == k:
                trans_b = True
                n = b.shape[0]
            elif b.shape[0] == k:
                trans_b = False
                n = b.shape[1]
        xv = arena.get_float_span(a.offset, a.element_count)
        wv = arena.get_float_span(b.offset, b.element_count)
        yv = arena.get_float_span(y.offset, y.element_count)
        if len(self.input_descs) > 2:
            bv = arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)
        else:
            bv = NDArray[float32]([0])
        kernels.fused_matmul_bias_act(xv, wv, bv, yv, m, n, k, self.activation, trans_b)

    def _exec_rms_norm(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        xv = arena.get_float_span(x.offset, x.element_count)
        yv = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        if len(self.input_descs) > 1:
            gv = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        else:
            gv = NDArray[float32]([0])
        kernels.fused_rms_norm(xv, gv, yv, self._n(), self._d(), self.epsilon)

    def _exec_layer_norm(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        xv = arena.get_float_span(x.offset, x.element_count)
        yv = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        if len(self.input_descs) > 1:
            gv = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        else:
            gv = NDArray[float32]([0])
        if len(self.input_descs) > 2:
            bv = arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)
        else:
            bv = NDArray[float32]([0])
        kernels.fused_layer_norm(xv, gv, bv, yv, self._n(), self._d(), self.epsilon)

    # Y = alpha*op(A)*op(B) + beta*C — pure .tv so alpha/beta stay exact
    def _exec_gemm(self, arena: ExecutionMemoryArena):
        ad = self.input_descs[0]
        bd = self.input_descs[1]
        yd = self.output_descs[0]
        a = arena.get_float_span(ad.offset, ad.element_count)
        b = arena.get_float_span(bd.offset, bd.element_count)
        y = arena.get_float_span(yd.offset, yd.element_count)
        m = ad.shape[0] if len(ad.shape) > 1 else 1
        ka = ad.shape[1] if len(ad.shape) > 1 else ad.element_count
        kb = bd.shape[0] if len(bd.shape) > 1 else bd.element_count
        n = bd.shape[1] if len(bd.shape) > 1 else bd.element_count
        k = ka
        has_c = len(self.input_descs) > 2
        c = arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count) if has_c else None
        c_bcast = has_c and self.input_descs[2].element_count == n
        for i in range(m):
            for j in range(n):
                s = 0.0
                for p in range(k):
                    av = a[p * m + i] if self.trans_a != 0 else a[i * k + p]
                    bv = b[j * kb + p] if self.trans_b != 0 else b[p * n + j]
                    s = s + av * bv
                v = self.alpha * s
                if has_c:
                    v = v + self.beta * (c[j] if c_bcast else c[i * n + j])
                # activation fusion (Gemm followed by act is fused by passes into FusedLinear;
                # direct act here keeps standalone Gemm+act graphs exact)
                y[i * n + j] = kernels.apply_activation(v, self.activation)

    def _exec_conv2d(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        w = self.input_descs[1]
        y = self.output_descs[0]
        batch = x.shape[0] if len(x.shape) >= 4 else 1
        in_c = x.shape[1] if len(x.shape) >= 4 else 1
        in_h = x.shape[2] if len(x.shape) >= 4 else x.shape[0]
        in_w = x.shape[3] if len(x.shape) >= 4 else x.shape[1]
        out_c = w.shape[0] if len(w.shape) >= 4 else 1
        kh = w.shape[2] if len(w.shape) >= 4 else 3
        kw = w.shape[3] if len(w.shape) >= 4 else 3
        sh = self.strides[0] if len(self.strides) > 0 else 1
        sw = self.strides[1] if len(self.strides) > 1 else sh
        ph = self.pads[0] if len(self.pads) > 0 else 0
        pw = self.pads[1] if len(self.pads) > 1 else ph
        xv = arena.get_float_span(x.offset, x.element_count)
        wv = arena.get_float_span(w.offset, w.element_count)
        yv = arena.get_float_span(y.offset, y.element_count)
        opts: list[NDArray[float32]] = []
        for i in range(2, 7):
            if len(self.input_descs) > i:
                opts.append(arena.get_float_span(self.input_descs[i].offset, self.input_descs[i].element_count))
            else:
                opts.append(NDArray[float32]([0]))
        kernels.fused_conv2d_bn_relu(xv, wv, opts[0], opts[1], opts[2], opts[3], opts[4], yv,
            batch, in_c, in_h, in_w, out_c, kh, kw, sh, sw, ph, pw, self.epsilon)

    # Branch ONCE per node (never per element); ReLU/binary/softmax run
    # SIMD-blocked kernels over zero-copy arena views.
    def _exec_unary(self, arena: ExecutionMemoryArena, act: ActivationFunction):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        if act == ActivationFunction.ReLU:
            kernels.unary_relu(x, y)
            return
        for i in range(len(x)):
            y[i] = kernels.apply_activation(x[i], act)

    def _exec_leaky(self, arena: ExecutionMemoryArena):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for i in range(len(x)):
            y[i] = x[i] if x[i] >= 0.0 else self.alpha * x[i]

    def _exec_elu(self, arena: ExecutionMemoryArena):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for i in range(len(x)):
            y[i] = x[i] if x[i] >= 0.0 else self.alpha * (exp(x[i]) - 1.0)

    def _exec_softplus(self, arena: ExecutionMemoryArena):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for i in range(len(x)):
            # stable softplus: max(x,0) + log1p(exp(-|x|))
            ax = x[i] if x[i] >= 0.0 else -x[i]
            y[i] = (x[i] if x[i] > 0.0 else 0.0) + log(1.0 + exp(-ax))

    # code: 0 sqrt, 1 exp, 2 log, 3 neg, 4 reciprocal, 5 abs
    def _exec_unary_math(self, arena: ExecutionMemoryArena, code: int):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for i in range(len(x)):
            if code == 0: y[i] = sqrt(x[i])
            elif code == 1: y[i] = exp(x[i])
            elif code == 2: y[i] = log(x[i])
            elif code == 3: y[i] = -x[i]
            elif code == 4: y[i] = 1.0 / x[i]
            else: y[i] = abs(x[i])

    def _exec_binary(self, arena: ExecutionMemoryArena, op: BinaryOp):
        a = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        b = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        kernels.elementwise_binary(a, b, y, int(op))

    def _exec_pow(self, arena: ExecutionMemoryArena):
        a = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        b = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        ca = len(a)
        cb = len(b)
        for i in range(len(y)):
            y[i] = pow(a[i] if ca == len(y) else (a[0] if ca == 1 else a[i % ca]),
                       b[i] if cb == len(y) else (b[0] if cb == 1 else b[i % cb]))

    # code: 0 min, 1 max, 2 mean, 3 sum — fold over all inputs
    def _exec_variadic(self, arena: ExecutionMemoryArena, code: int):
        n_in = len(self.input_descs)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        first = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        for i in range(len(y)):
            acc = first[i] if len(first) == len(y) else first[0]
            for k in range(1, n_in):
                v = arena.get_float_span(self.input_descs[k].offset, self.input_descs[k].element_count)
                vv = v[i] if len(v) == len(y) else v[0]
                if code == 0: acc = acc if acc < vv else vv
                elif code == 1: acc = acc if acc > vv else vv
                else: acc = acc + vv
            y[i] = acc / n_in if code == 2 else acc

    def _exec_where(self, arena: ExecutionMemoryArena):
        c = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        a = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        b = arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for i in range(len(y)):
            cc = c[i] if len(c) == len(y) else c[0]
            aa = a[i] if len(a) == len(y) else a[0]
            bb = b[i] if len(b) == len(y) else b[0]
            y[i] = aa if cc != 0.0 else bb

    def _exec_clip(self, arena: ExecutionMemoryArena):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        lo = self.clip_min
        hi = self.clip_max
        if len(self.input_descs) > 1:
            lo = arena.get_float_span(self.input_descs[1].offset, 1)[0]
        if len(self.input_descs) > 2:
            hi = arena.get_float_span(self.input_descs[2].offset, 1)[0]
        for i in range(len(x)):
            v = x[i]
            if v < lo: v = lo
            if v > hi: v = hi
            y[i] = v

    def _exec_softmax(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        d = x.shape[len(x.shape)-1] if len(x.shape) > 0 else x.element_count
        n = x.element_count // (d if d > 0 else 1)
        xv = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        yv = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        kernels.softmax_rows(xv, yv, n, d)

    # Attention with O(1) extra memory: row-wise online softmax streaming over K
    # (no Sq*Skv score buffer — safe for long sequences). Supports additive mask
    # (4th input), causal masking, kv_offset (decode with KV-cache) and GQA/MQA.
    def _exec_attention(self, arena: ExecutionMemoryArena):
        qd = self.input_descs[0]
        kd = self.input_descs[1]
        vd = self.input_descs[2]
        yd = self.output_descs[0]
        sq = qd.shape[0] if len(qd.shape) > 1 else 1
        hidden = qd.shape[1] if len(qd.shape) > 1 else qd.element_count
        skv = kd.shape[0] if len(kd.shape) > 1 else 1
        hidden_k = kd.shape[1] if len(kd.shape) > 1 else kd.element_count
        hidden_v = vd.shape[1] if len(vd.shape) > 1 else vd.element_count
        if hidden_k != hidden or hidden_v != hidden:
            raise Shape(f"attention hidden mismatch Q={hidden} K={hidden_k} V={hidden_v}")
        heads = self.num_heads if self.num_heads > 0 else 1
        if hidden % heads != 0:
            raise Shape(f"hidden {hidden} not divisible by num_heads {heads}")
        head_dim = hidden // heads
        kv_heads = self.num_kv_heads if self.num_kv_heads > 0 else heads
        if heads % kv_heads != 0:
            raise Shape(f"num_heads {heads} must be a multiple of num_kv_heads {kv_heads}")
        group = heads // kv_heads
        scale = self.attn_scale_override if self.attn_scale_override > 0.0 else 1.0 / sqrt(float(head_dim))
        has_mask = len(self.input_descs) > 3
        q = arena.get_float_span(qd.offset, qd.element_count)
        k = arena.get_float_span(kd.offset, kd.element_count)
        v = arena.get_float_span(vd.offset, vd.element_count)
        y = arena.get_float_span(yd.offset, yd.element_count)
        mask = arena.get_float_span(self.input_descs[3].offset, self.input_descs[3].element_count) if has_mask else None
        mask_skv = self.input_descs[3].shape[1] if has_mask and len(self.input_descs[3].shape) > 1 else (self.input_descs[3].element_count if has_mask else 0)
        for qi in range(sq):
            for h in range(heads):
                kvh = h // group
                qb = qi * hidden + h * head_dim
                yb = qi * hidden + h * head_dim
                # pass 1: row max (causal + additive mask)
                max_v = -3.4e38
                found = False
                for kj in range(skv):
                    if self.causal and kj > self.kv_offset + qi:
                        continue
                    kb = kj * hidden + kvh * head_dim
                    dot = 0.0
                    for d in range(head_dim):
                        dot = dot + q[qb + d] * k[kb + d]
                    s = dot * scale
                    if has_mask:
                        s = s + mask[qi * mask_skv + min(kj, mask_skv - 1)]
                    if not found or s > max_v:
                        max_v = s
                        found = True
                if not found:
                    for d in range(head_dim):
                        y[yb + d] = 0.0
                    continue
                # pass 2: sumExp + weighted sum (scores recomputed, O(1) memory)
                sum_exp = 0.0
                for d in range(head_dim):
                    y[yb + d] = 0.0
                for kj in range(skv):
                    if self.causal and kj > self.kv_offset + qi:
                        continue
                    kb = kj * hidden + kvh * head_dim
                    dot = 0.0
                    for d in range(head_dim):
                        dot = dot + q[qb + d] * k[kb + d]
                    s = dot * scale
                    if has_mask:
                        s = s + mask[qi * mask_skv + min(kj, mask_skv - 1)]
                    w = exp(s - max_v)
                    sum_exp = sum_exp + w
                    vb = kj * hidden + kvh * head_dim
                    for d in range(head_dim):
                        y[yb + d] = y[yb + d] + w * v[vb + d]
                inv = 1.0 / (sum_exp if sum_exp > 1e-8 else 1e-8)
                for d in range(head_dim):
                    y[yb + d] = y[yb + d] * inv

    def _exec_gather(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        id = self.input_descs[1]
        yd = self.output_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        idx = arena.get_float_span(id.offset, id.element_count)
        y = arena.get_float_span(yd.offset, yd.element_count)
        rank = len(dd.shape)
        ax = self.axis if self.axis >= 0 else self.axis + rank
        outer = 1
        for i in range(ax):
            outer = outer * dd.shape[i]
        axis_dim = dd.shape[ax]
        inner = 1
        for i in range(ax + 1, rank):
            inner = inner * dd.shape[i]
        ni = id.element_count
        for o in range(outer):
            for j in range(ni):
                ii = int(idx[j])
                if ii < 0: ii = ii + axis_dim
                if ii < 0 or ii >= axis_dim:
                    raise Arg(f"gather index {ii} out of range [0,{axis_dim})")
                for t in range(inner):
                    y[(o * ni + j) * inner + t] = x[(o * axis_dim + ii) * inner + t]

    def _exec_slice(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        rank = len(dd.shape)
        starts = _read_ints(arena, self.input_descs, 1)
        ends = _read_ints(arena, self.input_descs, 2)
        axes = _read_ints(arena, self.input_descs, 3)
        steps = _read_ints(arena, self.input_descs, 4)
        if len(axes) == 0:
            axes = list(range(min(len(starts), rank)))
        if len(steps) == 0:
            steps = [1] * len(axes)
        lo: list[int] = [0] * rank
        hi: list[int] = []
        st: list[int] = [1] * rank
        for i in range(rank):
            hi.append(dd.shape[i])
        for k in range(len(axes)):
            a = axes[k] if axes[k] >= 0 else axes[k] + rank
            s = starts[k] if k < len(starts) else 0
            e = ends[k] if k < len(ends) else dd.shape[a]
            if s < 0: s = s + dd.shape[a]
            if e < 0: e = e + dd.shape[a]
            if s < 0: s = 0
            if e > dd.shape[a]: e = dd.shape[a]
            lo[a] = s
            hi[a] = e
            st[a] = steps[k] if k < len(steps) and steps[k] != 0 else 1
        # odometer over output coordinates
        out_lens: list[int] = []
        for a in range(rank):
            out_lens.append((hi[a] - lo[a] + st[a] - 1) // st[a] if hi[a] > lo[a] else 0)
        src_st = _strides(dd.shape)
        coord: list[int] = [0] * rank
        pos = 0
        total = 1
        for a in range(rank):
            total = total * out_lens[a]
        for n in range(total):
            # decode n into output coords, map to source offset
            rem = n
            off = 0
            for a in range(rank - 1, -1, -1):
                c = rem % out_lens[a] if out_lens[a] > 0 else 0
                rem = rem // out_lens[a] if out_lens[a] > 0 else 0
                off = off + (lo[a] + c * st[a]) * src_st[a]
            y[pos] = x[off]
            pos = pos + 1

    def _exec_split(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        rank = len(dd.shape)
        ax = self.axis if self.axis >= 0 else self.axis + rank
        if len(self.input_descs) > 1 and self.input_descs[1].element_count == len(self.output_descs):
            sizes = _read_ints(arena, self.input_descs, 1)
        else:
            total = dd.shape[ax]
            each = total // len(self.output_descs)
            sizes = [each] * len(self.output_descs)
        outer = 1
        for i in range(ax):
            outer = outer * dd.shape[i]
        inner = 1
        for i in range(ax + 1, rank):
            inner = inner * dd.shape[i]
        base = 0
        for o in range(len(self.output_descs)):
            y = arena.get_float_span(self.output_descs[o].offset, self.output_descs[o].element_count)
            for r in range(outer):
                for t in range(sizes[o]):
                    for u in range(inner):
                        y[(r * sizes[o] + t) * inner + u] = x[(r * dd.shape[ax] + base + t) * inner + u]
            base = base + sizes[o]

    def _exec_expand(self, arena: ExecutionMemoryArena):
        x = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        cx = len(x)
        for i in range(len(y)):
            y[i] = x[i % cx]

    # code: 0 mean, 1 sum, 2 max
    def _exec_reduce(self, arena: ExecutionMemoryArena, code: int):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        rank = len(dd.shape)
        axes = self.axes if len(self.axes) > 0 else list(range(rank))
        normed: list[int] = []
        for a in axes:
            normed.append(a if a >= 0 else a + rank)
        src_st = _strides(dd.shape)
        yd = self.output_descs[0]
        out_shape = yd.shape if len(yd.shape) > 0 else [1]
        # init accumulators
        for i in range(len(y)):
            y[i] = -3.4e38 if code == 2 else 0.0
        counts: list[int] = [0] * len(y)
        for n in range(dd.element_count):
            out_idx = _reduce_out_index(n, dd.shape, src_st, normed, self.keepdims, out_shape)
            if code == 2:
                if x[n] > y[out_idx]: y[out_idx] = x[n]
            else:
                y[out_idx] = y[out_idx] + x[n]
            counts[out_idx] = counts[out_idx] + 1
        if code == 0:
            for i in range(len(y)):
                y[i] = y[i] / counts[i] if counts[i] > 0 else 0.0

    def _exec_gap(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        n = dd.shape[0] if len(dd.shape) > 0 else 1
        c = dd.shape[1] if len(dd.shape) > 1 else 1
        spatial = dd.element_count // (n * c) if n * c > 0 else 1
        for i in range(n):
            for j in range(c):
                s = 0.0
                for t in range(spatial):
                    s = s + x[(i * c + j) * spatial + t]
                y[i * c + j] = s / spatial if spatial > 0 else 0.0

    def _exec_pool(self, arena: ExecutionMemoryArena, is_max: bool):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        n = dd.shape[0]
        c = dd.shape[1]
        ih = dd.shape[2]
        iw = dd.shape[3]
        kh = self.kernel_shape[0] if len(self.kernel_shape) > 0 else 2
        kw = self.kernel_shape[1] if len(self.kernel_shape) > 1 else kh
        sh = self.strides[0] if len(self.strides) > 0 else kh
        sw = self.strides[1] if len(self.strides) > 1 else sh
        pt = self.pads[0] if len(self.pads) > 0 else 0
        pl = self.pads[1] if len(self.pads) > 1 else 0
        oh = (ih + pt + (self.pads[2] if len(self.pads) > 2 else pt) - kh) // sh + 1
        ow = (iw + pl + (self.pads[3] if len(self.pads) > 3 else pl) - kw) // sw + 1
        for b in range(n):
            for ch in range(c):
                for o in range(oh):
                    for u in range(ow):
                        acc = -3.4e38 if is_max else 0.0
                        cnt = 0
                        for r in range(kh):
                            for s in range(kw):
                                h = o * sh - pt + r
                                w = u * sw - pl + s
                                if h >= 0 and h < ih and w >= 0 and w < iw:
                                    v = x[((b * c + ch) * ih + h) * iw + w]
                                    if is_max:
                                        if v > acc: acc = v
                                    else:
                                        acc = acc + v
                                    cnt = cnt + 1
                        if is_max and cnt == 0:
                            acc = 0.0
                        y[((b * c + ch) * oh + o) * ow + u] = acc if is_max else (acc / cnt if cnt > 0 else 0.0)

    def _exec_batchnorm(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        ch = dd.shape[1] if len(dd.shape) > 1 else 1
        spatial = dd.element_count // ch if ch > 0 else 1
        scale = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        bias = arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)
        mean = arena.get_float_span(self.input_descs[3].offset, self.input_descs[3].element_count)
        var = arena.get_float_span(self.input_descs[4].offset, self.input_descs[4].element_count)
        for i in range(dd.element_count):
            c = (i // spatial) % ch if spatial > 0 else 0
            inv = 1.0 / sqrt(var[c] + self.epsilon)
            y[i] = (x[i] - mean[c]) * inv * scale[c] + bias[c]

    def _exec_pad(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        rank = len(dd.shape)
        pads = _read_ints(arena, self.input_descs, 1)
        val = 0.0
        if len(self.input_descs) > 2:
            val = arena.get_float_span(self.input_descs[2].offset, 1)[0]
        out_shape = self.output_descs[0].shape
        for i in range(len(y)):
            y[i] = val
        src_st = _strides(dd.shape)
        out_st = _strides(out_shape)
        for n in range(dd.element_count):
            rem = n
            dst = 0
            ok = True
            for a in range(rank - 1, -1, -1):
                co = rem % dd.shape[a]
                rem = rem // dd.shape[a]
                before = pads[a] if a < len(pads) else 0
                dst = dst + (co + before) * out_st[a]
            y[dst] = x[n]

    def _exec_log_softmax(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        d = x.shape[len(x.shape)-1] if len(x.shape) > 0 else x.element_count
        n = x.element_count // (d if d > 0 else 1)
        xv = arena.get_float_span(self.input_descs[0].offset, self.input_descs[0].element_count)
        yv = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for r in range(n):
            base = r * d
            mx = xv[base]
            for j in range(1, d):
                if xv[base + j] > mx: mx = xv[base + j]
            s = 0.0
            for j in range(d):
                e = exp(xv[base + j] - mx)
                yv[base + j] = e
                s = s + e
            ls = log(s if s > 1e-30 else 1e-30)
            for j in range(d):
                # log_softmax = (x - max) - log(sum_exp)
                yv[base + j] = (xv[base + j] - mx) - ls

    # 2D triangular mask; upper=1 keeps j-i>=k, else keeps j-i<=k
    def _exec_trilu(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        y = self.output_descs[0]
        if len(x.shape) != 2:
            self._exec_identity(arena)
            return
        xv = arena.get_float_span(x.offset, x.element_count)
        yv = arena.get_float_span(y.offset, y.element_count)
        rows = x.shape[0]
        cols = x.shape[1]
        for i in range(rows):
            for j in range(cols):
                keep = (j - i >= self.tri_k) if self.tri_upper != 0 else (j - i <= self.tri_k)
                yv[i * cols + j] = xv[i * cols + j] if keep else 0.0

    # TopK along axis (default last): outputs values + indices; O(cells*K)
    def _exec_topk(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        xv = arena.get_float_span(dd.offset, dd.element_count)
        kv = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        kk = int(kv[0])
        rank = len(dd.shape)
        ax = rank - 1
        if len(self.axes) > 0:
            ax = self.axes[0] if self.axes[0] >= 0 else self.axes[0] + rank
        if kk < 1: kk = 1
        if kk > dd.shape[ax]: kk = dd.shape[ax]
        outer = 1
        for i in range(ax):
            outer = outer * dd.shape[i]
        dim = dd.shape[ax]
        inner = 1
        for i in range(ax + 1, rank):
            inner = inner * dd.shape[i]
        yv = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        iv = arena.get_float_span(self.output_descs[1].offset, self.output_descs[1].element_count)
        for o in range(outer):
            for t in range(inner):
                # repeated max-extraction over the axis line
                picked: list[int] = []
                for s in range(kk):
                    best = -1
                    for j in range(dim):
                        if j in picked:
                            continue
                        v = xv[(o * dim + j) * inner + t]
                        if best < 0:
                            best = j
                        else:
                            bv = xv[(o * dim + best) * inner + t]
                            if (v > bv) if self.topk_largest != 0 else (v < bv):
                                best = j
                    picked.append(best)
                    yv[(o * kk + s) * inner + t] = xv[(o * dim + best) * inner + t]
                    iv[(o * kk + s) * inner + t] = float(best)

    # QuantizeLinear: y = clamp(round(x/scale) + zp) — tensor-wise or per-axis
    def _exec_quantize_linear(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_int8_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        sc = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        zp = 0
        if len(self.input_descs) > 2:
            zp = int(arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)[0])
        if len(sc) == 1:
            s = sc[0] if sc[0] > 1e-12 else 1e-12
            for i in range(len(x)):
                y[i] = max(-128, min(127, int(round(x[i] / s)) + zp))
        else:
            rank = len(dd.shape)
            ax = self.qlinear_axis if self.qlinear_axis >= 0 else self.qlinear_axis + rank
            outer = 1
            for i in range(ax):
                outer = outer * dd.shape[i]
            dim = dd.shape[ax]
            inner = 1
            for i in range(ax + 1, rank):
                inner = inner * dd.shape[i]
            for o in range(outer):
                for j in range(dim):
                    s = sc[j] if sc[j] > 1e-12 else 1e-12
                    for t in range(inner):
                        y[(o * dim + j) * inner + t] = max(-128, min(127, int(round(x[(o * dim + j) * inner + t] / s)) + zp))

    # DequantizeLinear: y = (x - zp) * scale — tensor-wise or per-axis
    def _exec_dequantize_linear(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_int8_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        sc = arena.get_float_span(self.input_descs[1].offset, self.input_descs[1].element_count)
        zp = 0
        if len(self.input_descs) > 2:
            zp = int(arena.get_float_span(self.input_descs[2].offset, self.input_descs[2].element_count)[0])
        if len(sc) == 1:
            for i in range(len(x)):
                y[i] = float(int(x[i]) - zp) * sc[0]
        else:
            rank = len(dd.shape)
            ax = self.qlinear_axis if self.qlinear_axis >= 0 else self.qlinear_axis + rank
            outer = 1
            for i in range(ax):
                outer = outer * dd.shape[i]
            dim = dd.shape[ax]
            inner = 1
            for i in range(ax + 1, rank):
                inner = inner * dd.shape[i]
            for o in range(outer):
                for j in range(dim):
                    for t in range(inner):
                        y[(o * dim + j) * inner + t] = float(int(x[(o * dim + j) * inner + t]) - zp) * sc[j]

    # QLinearMatMul (8 inputs, no bias): O(1) extra memory, exact zp/scale math.
    # A[M,K] int8, B[K,N] int8 -> Y[M,N] int8.
    def _exec_qlinear_matmul(self, arena: ExecutionMemoryArena):
        ad = self.input_descs[0]
        bd = self.input_descs[3]
        yd = self.output_descs[0]
        a = arena.get_int8_span(ad.offset, ad.element_count)
        b = arena.get_int8_span(bd.offset, bd.element_count)
        y = arena.get_int8_span(yd.offset, yd.element_count)
        sa = arena.get_float_span(self.input_descs[1].offset, 1)[0]
        zpa = int(arena.get_float_span(self.input_descs[2].offset, 1)[0])
        sw = arena.get_float_span(self.input_descs[4].offset, 1)[0]
        zpw = int(arena.get_float_span(self.input_descs[5].offset, 1)[0])
        sy = arena.get_float_span(self.input_descs[6].offset, 1)[0]
        if sy == 0.0: sy = 1.0
        zpy = int(arena.get_float_span(self.input_descs[7].offset, 1)[0])
        m = ad.shape[0] if len(ad.shape) > 1 else 1
        k = ad.shape[1] if len(ad.shape) > 1 else ad.element_count
        n = bd.shape[1] if len(bd.shape) > 1 else bd.element_count
        mult = sa * sw / sy
        for i in range(m):
            for j in range(n):
                acc = 0
                for p in range(k):
                    acc = acc + (int(a[i * k + p]) - zpa) * (int(b[p * n + j]) - zpw)
                y[i * n + j] = max(-128, min(127, int(round(acc * mult)) + zpy))

    def _exec_concat(self, arena: ExecutionMemoryArena):
        yd = self.output_descs[0]
        y = arena.get_float_span(yd.offset, yd.element_count)
        first = self.input_descs[0]
        rank = len(first.shape)
        ax = self.axis if self.axis >= 0 else self.axis + rank
        outer = 1
        for i in range(ax):
            outer = outer * first.shape[i]
        inner = 1
        for i in range(ax + 1, rank):
            inner = inner * first.shape[i]
        dst_base = 0
        for k in range(len(self.input_descs)):
            dk = self.input_descs[k]
            v = arena.get_float_span(dk.offset, dk.element_count)
            dim = dk.shape[ax] if ax < len(dk.shape) else dk.element_count
            for o in range(outer):
                for t in range(dim):
                    for u in range(inner):
                        y[(o * yd.shape[ax] + dst_base + t) * inner + u] = v[(o * dim + t) * inner + u]
            dst_base = dst_base + dim

    def _exec_argmax(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        x = arena.get_float_span(dd.offset, dd.element_count)
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        rank = len(dd.shape)
        ax = self.axis if self.axis >= 0 else self.axis + rank
        if len(self.axes) > 0:
            ax = self.axes[0] if self.axes[0] >= 0 else self.axes[0] + rank
        outer = 1
        for i in range(ax):
            outer = outer * dd.shape[i]
        dim = dd.shape[ax]
        inner = 1
        for i in range(ax + 1, rank):
            inner = inner * dd.shape[i]
        for o in range(outer):
            for t in range(inner):
                best = 0
                bv = x[(o * dim + 0) * inner + t]
                for j in range(1, dim):
                    v = x[(o * dim + j) * inner + t]
                    if v > bv:
                        bv = v
                        best = j
                y[o * inner + t] = float(best)

    def _exec_shape(self, arena: ExecutionMemoryArena):
        dd = self.input_descs[0]
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        for i in range(len(dd.shape)):
            y[i] = float(dd.shape[i])

    def _exec_size(self, arena: ExecutionMemoryArena):
        y = arena.get_float_span(self.output_descs[0].offset, self.output_descs[0].element_count)
        y[0] = float(self.input_descs[0].element_count)

    def _exec_identity(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        y = self.output_descs[0]
        if x.offset != y.offset:
            xv = arena.get_float_span(x.offset, x.element_count)
            yv = arena.get_float_span(y.offset, y.element_count)
            kernels.memcpy_views(yv, xv, min(len(xv), len(yv)))

    def _exec_transpose(self, arena: ExecutionMemoryArena):
        x = self.input_descs[0]
        y = self.output_descs[0]
        if len(x.shape) == 2:
            xv = arena.get_float_span(x.offset, x.element_count)
            yv = arena.get_float_span(y.offset, y.element_count)
            kernels.transpose2d_views(xv, yv, x.shape[0], x.shape[1])
        else:
            self._exec_identity(arena)

    # --- helpers ---
    def _n(self) -> int:
        x = self.input_descs[0]
        d = self._d()
        return x.element_count // (d if d > 0 else 1)
    def _d(self) -> int:
        x = self.input_descs[0]
        return x.shape[len(x.shape)-1] if len(x.shape) > 0 else x.element_count
    def _m(self) -> int:
        a = self.input_descs[0]
        return a.shape[0] if len(a.shape) > 1 else 1
    def _k_gemm(self) -> int:
        a = self.input_descs[0]
        return a.shape[1] if len(a.shape) > 1 else a.element_count
    def _n_gemm(self) -> int:
        b = self.input_descs[1]
        return b.shape[0] if len(b.shape) > 1 else b.element_count

# row-major strides for a shape
def _strides(shape: list[int]) -> list[int]:
    n = len(shape)
    st: list[int] = [1] * n
    for i in range(n - 2, -1, -1):
        st[i] = st[i + 1] * shape[i + 1]
    return st

# read an int list input (Slice starts/ends/axes/steps, Split sizes, Pad pads);
# missing input -> empty list
def _read_ints(arena: ExecutionMemoryArena, descs: list[TensorDesc], pos: int) -> list[int]:
    if len(descs) <= pos:
        return []
    d = descs[pos]
    v = arena.get_float_span(d.offset, d.element_count)
    out: list[int] = []
    for i in range(len(v)):
        out.append(int(v[i]))
    return out

# output flat index for a reduction input element n
def _reduce_out_index(n: int, shape: list[int], src_st: list[int], axes: list[int], keepdims: int, out_shape: list[int]) -> int:
    out_st = _strides(out_shape)
    rem = n
    idx = 0
    o = len(out_shape) - 1
    for a in range(len(shape) - 1, -1, -1):
        c = rem % shape[a]
        rem = rem // shape[a]
        if a in axes:
            if keepdims != 0:
                idx = idx + 0 * out_st[o]
                o = o - 1
            # else: dropped, no output dim consumed
        else:
            idx = idx + c * out_st[o]
            o = o - 1
    return idx

public enum BinaryOp:
    Add = 0
    Sub = 1
    Mul = 2
    Div = 3

# NOTE: zero externs — dispatch and all elementwise/shape/attention paths are
# pure .tv over arena views. Only the arena allocator itself (memory_arena.tv)
# remains a host intrinsic, like libc malloc.
