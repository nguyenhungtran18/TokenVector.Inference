// TokenVector Module: Runtime — Paged KV-cache block manager
// Fixed-size pages from a shared pool, per-sequence block tables (vLLM-style
// paging at the .tkv level). Sequences address logical token positions; the
// manager maps them to physical pages, evicting LRU victims under pressure.

module tv.runtime.paged_kv

import tv.numerics.tensor

public class PagedKVPool:
    def __init__(self, num_pages: int, page_len: int, hidden_dim: int):
        if num_pages <= 0 or page_len <= 0 or hidden_dim <= 0:
            raise Arg("num_pages/page_len/hidden_dim must be > 0")
        self.num_pages = num_pages
        self.page_len = page_len
        self.hidden_dim = hidden_dim
        self.free: list[int] = list(range(num_pages))
        self.last_use: list[int] = [0] * num_pages
        self.tick = 0
        # physical storage: pages are logical here; payload lives in per-seq
        # AttentionKvCache rows, this manager owns placement + eviction policy
        self.owner: dict[int, int] = {}  # page -> seq id (-1 = free)

    public def free_count(self) -> int:
        return len(self.free)

    public def alloc_page(self, seq_id: int) -> int:
        self.tick = self.tick + 1
        if len(self.free) == 0:
            return -1
        p = self.free.pop()
        self.owner[p] = seq_id
        self.last_use[p] = self.tick
        return p

    public def touch(self, page: int):
        self.tick = self.tick + 1
        self.last_use[page] = self.tick

    public def release_seq(self, seq_id: int):
        for p in list(self.owner.keys()):
            if self.owner[p] == seq_id:
                self.owner.pop(p)
                self.free.append(p)

    # evict the least-recently-used page owned by any seq except `spare`;
    # returns (victim_seq, page) or (-1, -1) when nothing is evictable
    public def evict_lru(self, spare: int = -1) -> tuple[int, int]:
        best = -1
        best_tick = -1
        for p in self.owner:
            if self.owner[p] == spare:
                continue
            if best < 0 or self.last_use[p] < best_tick:
                best = p
                best_tick = self.last_use[p]
        if best < 0:
            return (-1, -1)
        victim = self.owner[best]
        self.owner.pop(best)
        return (victim, best)

    public def reclaim(self, page: int, seq_id: int):
        # hand an evicted page to a new owner (caller copies surviving rows)
        self.owner[page] = seq_id
        self.last_use[page] = self.tick

public class PagedSequence:
    def __init__(self, seq_id: int):
        self.seq_id = seq_id
        self.pages: list[int] = []
        self.tokens: int = 0

    public def pages_needed(self, total_tokens: int, page_len: int) -> int:
        return (total_tokens + page_len - 1) // page_len

    public def ensure_capacity(self, pool: PagedKVPool, total_tokens: int) -> bool:
        need = self.pages_needed(total_tokens, pool.page_len)
        while len(self.pages) < need:
            p = pool.alloc_page(self.seq_id)
            if p < 0:
                return False
            self.pages.append(p)
            pool.touch(p)
        return True

    # logical token -> (page, offset-in-page)
    public def locate(self, pos: int, page_len: int) -> tuple[int, int]:
        return (self.pages[pos // page_len], pos % page_len)

# Shared prefix store: content-hashed token blocks interned once and
# referenced by many sequences (vLLM-style automatic prefix caching at the
# block level). Physical rows live here; sequences hold (shared?, page, rows).
# Memory is shared immediately; skipping recompute additionally requires
# graph-level prefix attention (packed mask below covers the common case).
public class PrefixStore:
    def __init__(self, hidden_dim: int):
        self.hidden_dim = hidden_dim
        self.pages: dict[int, NDArray[float32]] = {}  # hash -> rows (page_len*hidden)
        self.refs: dict[int, int] = {}
        self.hits: int = 0
        self.misses: int = 0

    public def block_hash(self, toks: list[int]) -> int:
        # FNV-1a 64-bit over the token block
        h = 14695981039346656037
        for t in toks:
            h = (h ^ (t & 0xFFFFFFFF)) * 1099511628211 & 0xFFFFFFFFFFFFFFFF
        return h

    # returns True on hit (rows already stored), False on miss (caller fills)
    public def intern(self, toks: list[int], page_len: int) -> tuple[int, bool]:
        h = self.block_hash(toks)
        if h in self.pages:
            self.refs[h] = self.refs[h] + 1
            self.hits = self.hits + 1
            return (h, True)
        self.pages[h] = NDArray[float32]([page_len * self.hidden_dim])
        self.refs[h] = 1
        self.misses = self.misses + 1
        return (h, False)

    public def release(self, h: int):
        if h in self.refs:
            self.refs[h] = self.refs[h] - 1
            if self.refs[h] <= 0:
                self.refs.pop(h)
                self.pages.pop(h)

    public def hit_rate(self) -> float:
        tot = self.hits + self.misses
        return float(self.hits) / tot if tot > 0 else 0.0
