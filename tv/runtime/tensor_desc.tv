// TokenVector Native Module: Runtime — Tensor Descriptor
// Ported from: Runtime/TensorDesc.cs
// Native backend: TokenVector.Inference.Runtime.TensorDesc (C# AOT)

module tv.runtime.tensor_desc

import tv.numerics.tensor

public enum TensorDataType:
    Undefined = 0
    Float = 1
    Uint8 = 2
    Int8 = 3
    Uint16 = 4
    Int16 = 5
    Int32 = 6
    Int64 = 7
    String = 8
    Bool = 9
    Float16 = 10
    Double = 11
    Uint32 = 12
    Uint64 = 13
    Complex64 = 14
    Complex128 = 15
    BFloat16 = 16
    Float8E4M3FN = 17
    Float8E4M3FNUZ = 18
    Float8E5M2 = 19
    Float8E5M2FNUZ = 20

public class TensorDesc:
    def __init__(self, name: str, shape: list[int], dtype: TensorDataType = TensorDataType.Float):
        self.name = name
        self.shape = shape
        self.dtype = dtype
        self.element_count = TensorDesc.calc_element_count(shape)
        self.byte_size = self.element_count * TensorDesc.dtype_size(dtype)
        self.offset = -1
        self.is_input = False
        self.is_output = False
        self.is_initializer = False
        self.lifetime_start = -1
        self.lifetime_end = -1

    public static def calc_element_count(shape: list[int]) -> int:
        if shape is None or len(shape) == 0:
            return 1
        total = 1
        for d in shape:
            dim = d if d > 0 else 1
            total = total * dim
        return total

    public static def dtype_size(dtype: TensorDataType) -> int:
        if dtype == TensorDataType.Float:
            return 4
        if dtype == TensorDataType.Float16 or dtype == TensorDataType.BFloat16:
            return 2
        if dtype == TensorDataType.Int8 or dtype == TensorDataType.Uint8:
            return 1
        if dtype == TensorDataType.Float8E4M3FN or dtype == TensorDataType.Float8E5M2:
            return 1
        if dtype == TensorDataType.Int32:
            return 4
        if dtype == TensorDataType.Int64 or dtype == TensorDataType.Double:
            return 8
        return 4
