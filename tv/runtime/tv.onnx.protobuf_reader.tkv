# TokenVector Module: ONNX — Fast Protobuf Reader (zero-copy)


# enum -> module constants

class Corrupt(Exception):
    msg: "str"

class EOF(Exception):
    msg: "str"

class Unsupported(Exception):
    msg: "str"


WireType_Varint = 0
WireType_Fixed64 = 1
WireType_LengthDelimited = 2
WireType_StartGroup = 3
WireType_EndGroup = 4
WireType_Fixed32 = 5

class FastProtobufReader:
    _ok: "i64"
    buf: 'str'
    pos: 'i64'
    last_wt: 'i64'
    def __init__(self, buf: "str"):
        self.buf = buf
        self.pos = 0

    def has_more(self) -> "i32":
        return self.pos < len(self.buf)

    def remaining(self) -> "i64":
        return len(self.buf) - self.pos

    def read_tag_field(self) -> "i64":
        if self.pos >= len(self.buf):
            self.last_wt = 0
            return 0
        tag = self.read_varint32()
        self.last_wt = tag & 7
        return int(tag >> 3)

    def read_varint32(self) -> "i64":
        result = 0
        shift = 0
        while self.pos < len(self.buf) and shift < 35:
            b = ord(self.buf[self.pos])
            self.pos = self.pos + 1
            result = result | ((b & 127) << shift)
            if (b & 128) == 0:
                return result
            shift = shift + 7
        return result

    def read_varint64(self) -> "i64":
        result = 0
        shift = 0
        while self.pos < len(self.buf) and shift < 70:
            b = ord(self.buf[self.pos])
            self.pos = self.pos + 1
            result = result | (int(b & 127) << shift)
            if (b & 128) == 0:
                return result
            shift = shift + 7
        return result

    def read_float(self) -> "f32":
        if self.pos + 4 > len(self.buf):
            raise EOF("Float32")
        v = native_read_f32(self.buf, self.pos)
        self.pos = self.pos + 4
        return v

    def read_double(self) -> "f64":
        if self.pos + 8 > len(self.buf):
            raise EOF("Float64")
        v = native_read_f64(self.buf, self.pos)
        self.pos = self.pos + 8
        return v

    def read_fixed32(self) -> "i64":
        v = native_read_u32(self.buf, self.pos)
        self.pos = self.pos + 4
        return v

    def read_fixed64(self) -> "i64":
        v = native_read_u64(self.buf, self.pos)
        self.pos = self.pos + 8
        return v

    def read_length_delimited(self) -> "str":
        ln = self.read_varint32()
        if ln < 0 or self.pos + ln > len(self.buf):
            raise Corrupt("bad LD segment " + str(ln) + "")
        sl = self.buf[self.pos:self.pos + ln]
        self.pos = self.pos + ln
        return sl

    def read_string(self) -> "str":
        raw = self.read_length_delimited()
        if len(raw) == 0:
            return ""
        return utf8_decode(raw)

    def skip_field(self, wt: "i64") -> 'i32':
        if wt == WireType_Varint:
            self.read_varint64()
        elif wt == WireType_Fixed64:
            self.pos = self.pos + 8
        elif wt == WireType_LengthDelimited:
            ln = self.read_varint32()
            self.pos = self.pos + ln
        elif wt == WireType_Fixed32:
            self.pos = self.pos + 4
        else:
            raise Unsupported("wire " + str(wt) + "")
        return 0

def native_read_f32(buf: "str", pos: "i64") -> "f32":
    return 0.0
def native_read_f64(buf: "str", pos: "i64") -> "f64":
    return 0.0
def native_read_u32(buf: "str", pos: "i64") -> "i64":
    return 0
def native_read_u64(buf: "str", pos: "i64") -> "i64":
    return 0
def utf8_decode(raw: "str") -> "str":
    return ""
