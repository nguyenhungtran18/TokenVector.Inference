# TokenVector Module: ONNX — Fast Protobuf Reader (zero-copy)


# enum -> module constants

class Corrupt(Exception):
    msg: "str"

class EOF(Exception):
    msg: "str"

class Unsupported(Exception):
    msg: "str"


WireType_Varint = 0
WireType_Fixed64 = 1
WireType_LengthDelimited = 2
WireType_StartGroup = 3
WireType_EndGroup = 4
WireType_Fixed32 = 5

class FastProtobufReader:
    _ok: "i64"
    buf: 'str'
    pos: 'i64'
    last_wt: 'i64'
    def __init__(self, buf: "str"):
        self.buf = buf
        self.pos = 0

    def has_more(self) -> "i32":
        return self.pos < len(self.buf)

    def remaining(self) -> "i64":
        return len(self.buf) - self.pos

    def read_tag_field(self) -> "i64":
        if self.pos >= len(self.buf):
            self.last_wt = 0
            return 0
        tag = self.read_varint32()
        self.last_wt = tag & 7
        return int(tag >> 3)

    def read_varint32(self) -> "i64":
        # (2026-09-27) Code lai cho dung: so hoc i64 (gia tri 5-byte nhu
        # 2^32 tran int32 -> OverflowException o ban cu). Tra ve uint32
        # (wrap theo semantics C# unchecked).
        result = _pb_i64(0)
        shift = _pb_i64(0)
        while self.pos < len(self.buf) and shift < 35:
            b = ord(self.buf[self.pos])
            self.pos = self.pos + 1
            result = _pb_or(result, _pb_shl(_pb_i64(b & 127), shift))
            if (b & 128) == 0:
                return result & 4294967295
            shift = shift + 7
        return result & 4294967295

    def read_varint64(self) -> "i64":
        result = _pb_i64(0)
        shift = _pb_i64(0)
        while self.pos < len(self.buf) and shift < 70:
            b = ord(self.buf[self.pos])
            self.pos = self.pos + 1
            result = _pb_or(result, _pb_shl(_pb_i64(b & 127), shift))
            if (b & 128) == 0:
                return result
            shift = shift + 7
        return result

    def read_float(self) -> "f32":
        if self.pos + 4 > len(self.buf):
            raise EOF("Float32")
        v = native_read_f32(self.buf, self.pos)
        self.pos = self.pos + 4
        return v

    def read_double(self) -> "f64":
        if self.pos + 8 > len(self.buf):
            raise EOF("Float64")
        v = native_read_f64(self.buf, self.pos)
        self.pos = self.pos + 8
        return v

    def read_fixed32(self) -> "i64":
        v = native_read_u32(self.buf, self.pos)
        self.pos = self.pos + 4
        return v

    def read_fixed64(self) -> "i64":
        v = native_read_u64(self.buf, self.pos)
        self.pos = self.pos + 8
        return v

    def read_length_delimited(self) -> "str":
        ln = self.read_varint32()
        if ln < 0 or self.pos + ln > len(self.buf):
            raise Corrupt("bad LD segment " + str(ln) + "")
        sl = self.buf[self.pos:self.pos + ln]
        self.pos = self.pos + ln
        return sl

    def read_string(self) -> "str":
        raw = self.read_length_delimited()
        if len(raw) == 0:
            return ""
        return utf8_decode(raw)

    def skip_field(self, wt: "i64") -> 'i32':
        if wt == WireType_Varint:
            self.read_varint64()
        elif wt == WireType_Fixed64:
            self.pos = self.pos + 8
        elif wt == WireType_LengthDelimited:
            ln = self.read_varint32()
            self.pos = self.pos + ln
        elif wt == WireType_Fixed32:
            self.pos = self.pos + 4
        else:
            raise Unsupported("wire " + str(wt) + "")
        return 0

def _pb_i64(v: "i64") -> "i64":
    # Ep ve i64 (int32 -> i64 tu mo rong). Mau dung nhu tham so i64 o
    # _pb_u32_impl: tranh TkvInt.MulSlow/Overflow o dich bit lon.
    return v

def _pb_or(a: "i64", b: "i64") -> "i64":
    return a | b

def _pb_shl(v: "i64", s: "i64") -> "i64":
    return v << s

def _pb_u32_le(buf: "str", pos: "i64") -> "i64":    # (2026-09-27) Code lai cho dung: doc 4 byte LE thanh u32 (i64).
    # Dua ve i64 NGAY qua tham so kieu i64 (int32 -> i64 tu mo rong, mau
    # dung nhu literal trong list[i64]); so hoc i64 giong native_f16_encode
    # (da pass test 12), tranh TkvInt.MulSlow.
    return _pb_u32_impl(ord(buf[pos]), ord(buf[pos + 1]), ord(buf[pos + 2]), ord(buf[pos + 3]))

def _pb_u32_impl(b0: "i64", b1: "i64", b2: "i64", b3: "i64") -> "i64":
    return b0 + b1 * 256 + b2 * 65536 + b3 * 16777216

def _pb_u64_le(buf: "str", pos: "i64") -> "i64":
    return _pb_u64_impl(ord(buf[pos]), ord(buf[pos + 1]), ord(buf[pos + 2]), ord(buf[pos + 3]), ord(buf[pos + 4]), ord(buf[pos + 5]), ord(buf[pos + 6]), ord(buf[pos + 7]))

def _pb_u64_impl(b0: "i64", b1: "i64", b2: "i64", b3: "i64", b4: "i64", b5: "i64", b6: "i64", b7: "i64") -> "i64":
    lo = b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
    hi = b4 + b5 * 256 + b6 * 65536 + b7 * 16777216
    return lo + hi * 4294967296

def _pb_f32_from_bits(b: "i64") -> "f32":
    # Giong native_f16_decode (da pass test 12): hep f64 -> f32 bang
    # float() TUONG MINH (tra ve truc tiep bi sai kieu).
    return float(f32_bits_to_f64_local(b))

def f32_bits_to_f64_local(b: "i64") -> "f64":
    s = b & 2147483648
    ex = (b >> 23) & 255
    mant = b & 8388607
    if ex == 0:
        v = float(mant) * pow(2.0, 0.0 - 149.0)
    elif ex == 255:
        v = pow(2.0, 128.0) * 2.0
    else:
        v = (1.0 + float(mant) / 8388608.0) * pow(2.0, float(ex - 127))
    if s != 0:
        v = 0.0 - v
    return v

def native_read_f32(buf: "str", pos: "i64") -> "f32":
    return _pb_f32_from_bits(_pb_u32_le(buf, pos))

def native_read_f64(buf: "str", pos: "i64") -> "f64":
    u = _pb_u64_le(buf, pos)
    s = u >> 63
    ex = (u >> 52) & 2047
    mant = u & 4503599627370495
    if ex == 0:
        v = float(mant) * pow(2.0, 0.0 - 1074.0)
    elif ex == 2047:
        v = pow(2.0, 512.0) * 2.0
    else:
        v = (1.0 + float(mant) / 4503599627370496.0) * pow(2.0, float(ex - 1023))
    if s != 0:
        v = 0.0 - v
    return v

def native_read_u32(buf: "str", pos: "i64") -> "i64":
    return _pb_u32_le(buf, pos)

def native_read_u64(buf: "str", pos: "i64") -> "i64":
    return _pb_u64_le(buf, pos)

def utf8_decode(raw: "str") -> "str":
    # (2026-09-27) Code lai cho dung: giai ma UTF-8 thuan tkv (truoc la
    # stub tra ""). Dung chr() nhu string_tensor (da pass test 20/21).
    out = ""
    i = 0
    n = len(raw)
    while i < n:
        b0 = ord(raw[i])
        if b0 < 128:
            out = out + chr(b0)
            i = i + 1
        elif b0 < 224:
            b1 = ord(raw[i + 1])
            out = out + chr((b0 & 31) * 64 + (b1 & 63))
            i = i + 2
        elif b0 < 240:
            b1 = ord(raw[i + 1])
            b2 = ord(raw[i + 2])
            out = out + chr((b0 & 15) * 4096 + (b1 & 63) * 64 + (b2 & 63))
            i = i + 3
        else:
            b1 = ord(raw[i + 1])
            b2 = ord(raw[i + 2])
            b3 = ord(raw[i + 3])
            out = out + chr((b0 & 7) * 262144 + (b1 & 63) * 4096 + (b2 & 63) * 64 + (b3 & 63))
            i = i + 4
    return out
