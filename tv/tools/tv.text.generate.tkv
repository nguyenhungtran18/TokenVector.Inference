import tv.runtime.session
import tv.text.tokenizer
import tv.text.sampling
import tv.text.chat_template
import tv.numerics.tensor

class GenConfig:
    _ok: 'i64'
    max_new_tokens: 'i64'
    eos_token: 'i64'
    stop_strings: 'list[str]'
    template: 'str'
    params: 'inferred'

    def __init__(self):
        self.max_new_tokens = 128
        self.eos_token = -1
        self.stop_strings = []
        self.template = "chatml"
        self.params = default_sample_params()

class GenResult:
    _ok: 'i64'
    text: 'str'
    prompt_tokens: 'i64'
    completion_tokens: 'i64'

    def __init__(self, text: 'str', prompt_tokens: 'i64', completion_tokens: 'i64'):
        self.text = text
        self.prompt_tokens = prompt_tokens
        self.completion_tokens = completion_tokens

def _gen_core(session: 'InferenceSession', tokenizer: 'Tokenizer', prompt: 'str', cfg: 'GenConfig') -> 'list[i64]':
    ids = tokenizer.encode(prompt)
    gr = session.graph
    _gins = gr.inputs
    _gtens = gr.tensors
    _first_in = _gins[0]
    _inp_desc = _gtens[_first_in]
    in_dim = _inp_desc.element_count
    vocab = tokenizer.vocab_size()
    gen = []
    _qx1000 = []
    for _qx1001 in ids:
        _qx1000.append(_qx1001)
    history = _qx1000
    _sparams = cfg.params
    for _step in range(cfg.max_new_tokens):
        inp = _nd_f32(in_dim)
        for _i0 in range(in_dim):
            inp[_i0] = 0.0
        n_hist = 0
        for _h in history:
            n_hist = n_hist + 1
        if n_hist > in_dim:
            tail_n = in_dim
            start = n_hist - in_dim
        else:
            tail_n = n_hist
            start = 0
        base = in_dim - tail_n
        for _i1 in range(tail_n):
            inp[base + _i1] = float(history[start + _i1])
        out = session.run_single(inp)
        _n_out = len(out)
        ln = min(_n_out, vocab)
        logits = _nd_f32(ln)
        for _i2 in range(ln):
            logits[_i2] = out[_n_out - ln + _i2]
        nxt = sample_token(logits, _sparams, history)
        history.append(nxt)
        gen.append(nxt)
        if nxt == cfg.eos_token:
            break
        if len(cfg.stop_strings) > 0:
            _text0 = tokenizer.decode(gen)
            hit = 0
            for _st in cfg.stop_strings:
                if _text0.find(_st) >= 0:
                    hit = 1
                    break
            if hit:
                break
    return gen

def generate_text(session: 'InferenceSession', tokenizer: 'Tokenizer', prompt: 'str', cfg: 'GenConfig') -> 'GenResult':
    ids = tokenizer.encode(prompt)
    gen = _gen_core(session, tokenizer, prompt, cfg)
    _n_ids = len(ids)
    _n_gen = len(gen)
    _txt = tokenizer.decode(gen)
    return GenResult(1, _txt, _n_ids, _n_gen)

def chat_generate(session: 'InferenceSession', tokenizer: 'Tokenizer', messages: 'list[ChatMessage]', cfg: 'GenConfig') -> 'GenResult':
    _tpl = apply_template(messages, cfg.template)
    return generate_text(session, tokenizer, _tpl, cfg)


