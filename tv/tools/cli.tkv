class CliArg(Exception):
    msg: 'str'

def _flags(args: 'list[str]') -> 'dict[str,str]':
    out = {}
    i = 0
    while i < len(args):
        a = args[i]
        if a[:2] == "--" and i + 1 < len(args):
            out[a[2:]] = args[i + 1]
            i = i + 2
        else:
            i = i + 1
    return out

def _get(flags: 'dict[str,str]', key: 'str', default: 'str') -> 'str':
    if key in flags:
        _c1 = flags[key]
    else:
        _c1 = default
    return _c1

def main() -> 'i32':
    args = argv()
    if len(args) == 0:
        print("usage: tkvc tv/tools/cli.tkv cli.exe -- <serve|gen|export|calibrate|latency|train> [--key value]")
        return 0
    cmd = args[0]
    flags = _flags(args[1:])
    if cmd == "serve":
        _cmd_serve(flags)
    elif cmd == "gen":
        _cmd_gen(flags)
    elif cmd == "export":
        _cmd_export(flags)
    elif cmd == "calibrate":
        _cmd_calibrate(flags)
    elif cmd == "latency":
        _cmd_latency(flags)
    elif cmd == "train":
        _cmd_train(flags)
    else:
        print("unknown command: " + cmd)
    return 0

def _session_of(flags: 'dict[str,str]') -> 'InferenceSession':
    model = _get(flags, "model", "")
    if model == "":
        raise CliArg("--model <path.onnx> required")
    # 'InferenceSession.from_onnx_file' KHONG ton tai (static method do khong
    # class nao khai bao) - bien dich that la parse .onnx -> translate sang
    # ExecutionGraph -> phuc session. Day la duong duy nhat ma cac module
    # da import san (tv.onnx.parser/tv.onnx.translator/tv.runtime.session).
    _m = parse_file(model)
    _g = translate(_m)
    return session_from_graph(_g, 1)

def _cmd_serve(flags: 'dict[str,str]') -> 'i32':
    s = _session_of(flags)
    # 'ServerOptions()' khong hop le: .ctor cua record nhan DUNG so field
    # (11 tham so - xem default_server_options() trong tv/server/
    # embedded_server.tkv, noi truyen day du). Dung factory co san do.
    opts = default_server_options()
    # 'port' la field cua EmbeddedServer (xem tv/server/embedded_server.tkv),
    # KHONG phai cua ServerOptions - giu no o local roi truyen cho
    # EmbeddedServer, thay v gan 'opts.port' (field khong ton tai).
    port = int(_get(flags, "port", "8080"))
    opts.api_key = _get(flags, "api-key", "")
    opts.tokenizer_kind = _get(flags, "tokenizer", "")
    opts.tokenizer_vocab = _get(flags, "vocab", "")
    opts.tokenizer_merges = _get(flags, "merges", "")
    opts.chat_format = _get(flags, "format", "chatml")
    srv = new_embedded_server(s, port, opts)
    print("serving on :" + str(port))
    wait_forever()
    return 0

def _cmd_gen(flags: 'dict[str,str]') -> 'i32':
    s = _session_of(flags)
    kind = _get(flags, "tokenizer", "bpe")
    if kind == "bpe":
        _c2 = bpe_tokenizer_new(_get(flags, "vocab", "vocab.json"), _get(flags, "merges", "merges.txt"))
    else:
        _c2 = wordpiece_tokenizer_new(_get(flags, "vocab", "vocab.txt"), "[UNK]")
    tok = _c2
    cfg = GenConfig(1, 128, -1, "chatml", default_sample_params())
    cfg.max_new_tokens = int(_get(flags, "max-tokens", "64"))
    res = generate_text(s, tok, _get(flags, "prompt", "Hello"), cfg)
    print(res.text)
    s.close()
    return 0

def _cmd_export(flags: 'dict[str,str]') -> 'i32':
    s = _session_of(flags)
    raw = export_model(s.graph, "tokenvector-opt")
    file_write_bytes(_get(flags, "out", "model.opt.onnx"), raw)
    print("exported " + str(len(raw)) + " bytes")
    s.close()
    return 0

def _cmd_calibrate(flags: 'dict[str,str]') -> 'i32':
    s = _session_of(flags)
    data = _cli_file_read_all_bytes(_get(flags, "data", "calib.bin"))
    n = int(_get(flags, "count", str(len(data) // 4)))
    vals = _cli_nd_f32(n)
    for i in range(n):
        vals[i] = st_f32_le(data, i * 4)
    method = _get(flags, "method", "minmax")
    if method == "kl":
        p = calibrate_kl(vals)
    elif method == "percentile":
        p = calibrate_percentile(vals)
    elif method == "mse":
        p = calibrate_mse(vals)
    else:
        p = calibrate_minmax(vals)
    js = "{\"scale\":" + str(p.scale) + ",\"zero_point\":" + str(p.zero_point) + "}"
    out = _get(flags, "out", "")
    if out != "":
        file_write_bytes(out, _cli_utf8_encode(js))
    print(js)
    s.close()
    return 0

def _cmd_latency(flags: 'dict[str,str]') -> 'i32':
    s = _session_of(flags)
    _ah128_10 = s.graph
    _ah128_26 = s.graph
    _t0d = _ah128_10.tensors
    _in0 = _ah128_26.inputs[0]
    _td = _t0d[_in0]
    dim = _td.element_count
    x = _cli_nd_f32(dim)
    iters = int(_get(flags, "iters", "1000"))
    for i in range(100):
        s.run_single(x)
    t0 = now_us()
    for i in range(iters):
        s.run_single(x)
    dt = now_us() - t0
    print("{\"iters\":" + str(iters) + ",\"avg_us\":" + str(float(dt) / iters) + "}")
    s.close()
    return 0

# ---- train (G4) -----------------------------------------------------------
# Demo trainer: MLP 4-8-3 tren du lieu tong hop tat dinh (LCG), AdamW +
# warmup/cosine + clip + grad accumulation, in loss/ppl tung moc log.
#   --steps N  --lr X  --samples N  --accum K  --seed S  --log-every K
#   --out <file>  (checkpoint: trong so + m/v + step + RNG, bit-exact)
def _cli_rng(state: 'i64') -> 'i64':
    return (state * 1103515245 + 12345) % 2147483648

def _cli_gen_data(n: 'i64', seed: 'i64') -> 'list[f32]':
    # moi dong 5 so: x0..x3 + nhan (0/1/2 theo tong x0+x1). Tra ve MOT list
    # phang n*5 (quy tac: mot list phang moi ham).
    out = []
    s = seed % 2147483648
    for i in range(n):
        x0 = 0.0
        x1 = 0.0
        for j in range(4):
            s = _cli_rng(s)
            v = float(s) / 2147483648.0 - 0.5
            out.append(v)
            if j == 0:
                x0 = v
            if j == 1:
                x1 = v
        t = x0 + x1
        if t > 0.15:
            out.append(0.0)
        elif t < 0.0 - 0.15:
            out.append(1.0)
        else:
            out.append(2.0)
    return out

def _cmd_train(flags: 'dict[str,str]') -> 'i32':
    steps = int(_get(flags, "steps", "200"))
    lr = float(_get(flags, "lr", "0.05"))
    ns = int(_get(flags, "samples", "20"))
    accum = int(_get(flags, "accum", "2"))
    seed = int(_get(flags, "seed", "7"))
    log_every = int(_get(flags, "log-every", "50"))
    out = _get(flags, "out", "")
    data = _cli_gen_data(ns, seed)
    xs = []
    ys = []
    for i in range(ns):
        for j in range(4):
            xs.append(data[i * 5 + j])
        ys.append(int(data[i * 5 + 4]))
    warmup = steps // 10
    if warmup < 1:
        warmup = 1
    lr_min = lr * 0.05
    opt = new_adamw(67, warmup, steps, lr, lr_min, 0.9, 0.999, 0.00000001, 0.01, 1.0)
    p0 = mlp_init(seed)
    for i in range(67):
        opt.p[i] = p0[i]
    smp = new_sampler(ns, seed)
    t0 = now_ms()
    losses = run_steps(opt, xs, ys, ns, accum, steps, smp)
    i = 0
    while i < len(losses):
        if i == 0 or (i + 1) % log_every == 0:
            print("step " + str(i + 1) + "/" + str(steps) + " loss=" + str(losses[i])
                  + " ppl=" + str(ppl(losses[i])))
        i = i + 1
    ev = mlp_eval_loss(opt.p, xs, ys, ns)
    acc = mlp_eval_acc(opt.p, xs, ys, ns)
    dt = now_ms() - t0
    print("train done: steps=" + str(steps) + " eval_loss=" + str(ev)
          + " ppl=" + str(ppl(ev)) + " acc=" + str(acc)
          + " " + str(dt) + " ms")
    if out != "":
        _sv = ckpt_save(out, opt, smp)
        print("checkpoint -> " + out)
    return 0

def argv() -> 'list[str]':
    return []

def wait_forever() -> 'i32':
    return 0

def _cli_file_read_all_bytes(path: 'str') -> 'str':
    return ""

def file_write_bytes(path: 'str', data: 'str') -> 'i32':
    return 0

def st_f32_le(raw: 'str', pos: 'i64') -> 'f32':
    return 0.0

def _cli_utf8_encode(s: 'str') -> 'list[i64]':
    return []


def _cli_nd_f32(n: "i64") -> "list[f32]":
    out = []
    _zf72 = 0
    while _zf72 < n:
        out.append(0.0)
        _zf72 = _zf72 + 1
    return out

def _cli_nd_i64(n: "i64") -> "list[i64]":
    out = []
    _zf73 = 0
    while _zf73 < n:
        out.append(0)
        _zf73 = _zf73 + 1
    return out

def _cli_nd_i8(n: "i64") -> "list[i64]":
    out = []
    _zf74 = 0
    while _zf74 < n:
        out.append(0)
        _zf74 = _zf74 + 1
    return out
