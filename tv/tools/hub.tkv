# TokenVector Module: Tools — HuggingFace Hub download + cache
# Resolves repo/file to a local path, downloading once into cache_dir.
# Network + file writes are host intrinsics (same class as file reads).


class Net(Exception):
    msg: "str"


def model_file(repo: "str", filename: "str", cache_dir: "str" = "models") -> "str":
    path = cache_dir + "/" + repo.replace("/", "--") + "--" + filename
    if hub_file_exists(path):
        return path
    url = "https://huggingface.co/" + repo + "/resolve/main/" + filename
    data = hub_http_get(url)
    if len(data) == 0:
        raise Net("download failed or empty: " + url)
    file_write_bytes(path, data)
    return path

def tokenizer_files(repo: "str", cache_dir: "str" = "models") -> "dict[str,str]":
    # tries the common tokenizer artifacts, keeps whatever exists remotely
    out = {}
    for f in ["vocab.json", "merges.txt", "vocab.txt", "tokenizer.json", "tokenizer.model"]:
        try:
            out[f] = model_file(repo, f, cache_dir)
        except Exception:
            out[f] = ""
    return out

def hub_http_get(url: "str") -> "str":
    return ""
def file_write_bytes(path: "str", data: "str") -> "i32":
    return 0
def hub_file_exists(path: "str") -> "i32":
    return 0
