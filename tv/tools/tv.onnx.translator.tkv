        sh = tag + "_sh"
        _add_int_init(g, sh, [bat, inp])
        _xo1 = XtractOut(1, s1, e1, mid, sh)
        return _xo1
    s1 = tag + "_s"
    e1 = tag + "_e"
    _add_int_init(g, s1, [0, t, 0])
    _add_int_init(g, e1, [bat, t + 1, inp])
    mid = tag + "_m"
    sh = tag + "_sh"
    _add_int_init(g, sh, [bat, inp])
    _xo2 = XtractOut(1, s1, e1, mid, sh)
    return _xo2

def _emit_step_slice(out: 'list[OnnxNode]', g: 'ExecutionGraph', tag: 'str', x: 'str', mid: 'str', sh: 'str', s1: 'str', e1: 'str', y2d: 'str') -> 'i32':
    out.append(_mk_node(tag + "_sl", "Slice", [x, s1, e1], [mid]))
    out.append(_mk_node(tag + "_rs", "Reshape", [mid, sh], [y2d]))
    return 0

def _gate_mm(out: 'list[OnnxNode]', g: 'ExecutionGraph', tag: 'str', a2d: 'str', wmat: 'str', h2d: 'str', rmat: 'str', bw: 'str', br: 'str', y2d: 'str') -> 'i32':
    t1 = tag + "_xw"
    t2 = tag + "_hr"
    t3 = tag + "_s"
    out.append(_mk_node(tag + "_mm1", "MatMul", [a2d, wmat], [t1]))
    out.append(_mk_node(tag + "_mm2", "MatMul", [h2d, rmat], [t2]))
    out.append(_mk_node(tag + "_ad1", "Add", [t1, t2], [t3]))
    out.append(_mk_node(tag + "_ad2", "Add", [t3, bw], [t3 + "b"]))
    out.append(_mk_node(tag + "_ad3", "Add", [t3 + "b", br], [y2d]))
    return 0

def _dir_weights(g: 'ExecutionGraph', on: 'OnnxNode', d: 'i64', rows_per_gate: 'i64', gates: 'i64', in_dim: 'i64', hid: 'i64', prefix: 'str', wnames: 'list[str]', rnames: 'list[str]', wbn: 'list[str]', rbn: 'list[str]') -> 'i32':
    w = g.initializers[on.inputs[1]]
    r = g.initializers[on.inputs[2]]
    wnames = []
    rnames = []
    for gg in range(gates):
        _sa1 = g.tensors[on.inputs[1]]
        wf = _subarray_flat(w, _sa1.shape, [d, gg * hid, 0], [1, hid, in_dim])
        ws = _subarray_shape(w, _sa1.shape, [d, gg * hid, 0], [1, hid, in_dim])
        wn = prefix + "_W" + str(gg) + ""
        _add_float_init(g, wn, ws[1:], wf)
        wnames.append(wn)
        _sa2 = g.tensors[on.inputs[2]]
        rf = _subarray_flat(r, _sa2.shape, [d, gg * hid, 0], [1, hid, hid])
        rs = _subarray_shape(r, _sa2.shape, [d, gg * hid, 0], [1, hid, hid])
        rn = prefix + "_R" + str(gg) + ""
        _add_float_init(g, rn, rs[1:], rf)
        rnames.append(rn)
    wbn = []
    rbn = []
    if len(on.inputs) > 3 and on.inputs[3] != "":
        b = g.initializers[on.inputs[3]]
        for gg in range(gates):
            _sa3 = g.tensors[on.inputs[3]]
            bf = _subarray_flat(b, _sa3.shape, [d, gg * hid], [1, hid])
            bs = _subarray_shape(b, _sa3.shape, [d, gg * hid], [1, hid])
            bn = prefix + "_WB" + str(gg) + ""
            _add_float_init(g, bn, bs[1:], bf)
            wbn.append(bn)
            _sa4 = g.tensors[on.inputs[3]]
            bf2 = _subarray_flat(b, _sa4.shape, [d, gates * hid + gg * hid], [1, hid])
            bs2 = _subarray_shape(b, _sa4.shape, [d, gates * hid + gg * hid], [1, hid])
            bn2 = prefix + "_RB" + str(gg) + ""
            _add_float_init(g, bn2, bs2[1:], bf2)
            rbn.append(bn2)
    else:
        # (2026-09-26) KHONG dung `[0.0] * hid` o day.
        #
        # Nhan lặp list tren mot LITERAL chua duoc compiler xu ly: khi nam
        # trong danh sach tham so co ngu canh `list[f32]` thi khong co loi bien
        # dich nao bat, nhung IL sinh ra sai:
        #
        #     newobj List`1<float32>::.ctor()
        #     dup
        #     ldc.r4 0.0
        #     callvirt List`1<float32>::Add(!0)   <- list [0.0] da dung
        #     ldloc.s 6
        #     conv.r4
        #     ldloc.s 8
        #     conv.r4
        #     mul.ovf        <- opcode NHAN SO NGUYEN tren float32
        #     mul.ovf        <- va bi phat HAI LAN
        #
        # -> CLR nem BadImageFormatException, khong nap duoc method
        # `_expand_lstm`. O dang gan thu `r = [0.0] * n` compiler con bao loi
        # ro rang ("list-literal chua hang so thuc ... ngu canh doi kieu phan
        # tu nguyen 'int'"), nhung trong danh sach tham so thi ngu canh la
        # `list[f32]` nen loi bi bo qua.
        #
        # `_nd_f32(hid)` tao san list[f32] gom `hid` phan tu 0.0 - cung y nghia
        # va dung kieu.
        for gg in range(gates):
            wn = prefix + "_WB" + str(gg) + ""
            _add_float_init(g, wn, [hid], _nd_f32(hid))
            wbn.append(wn)
            wn2 = prefix + "_RB" + str(gg) + ""
            _add_float_init(g, wn2, [hid], _nd_f32(hid))
            rbn.append(wn2)
    return 0

def _rev_indices(g: 'ExecutionGraph', name: 'str', seq: 'i64') -> 'str':
    _qx1037 = []
    for i in range(seq):
        _qx1037.append(seq - 1 - i)
    _add_int_init(g, name, _qx1037)
    return name

def _expand_lstm(g: 'ExecutionGraph', on: 'OnnxNode') -> 'list[OnnxNode]':
    if "activation_alpha" in on.attrs or "activation_beta" in on.attrs:
        raise UnsupportedOp("LSTM with custom activation alpha/beta")
    _qx1000 = {}
    for nm in on.inputs:
        _qx1000[nm] = 1
    if "P" in _qx1000 and len(on.inputs) > 7 and (on.inputs[7] != ""):
        raise UnsupportedOp("LSTM with peepholes (P)")
    _rd = _rnn_common(g, on, "LSTM")
    seq = _rd.seq
    bat = _rd.bat
    inp = _rd.inp
    hid = _rd.hid
    ndir = _rd.ndir
    acts = _rd.acts
    if seq <= 0 or seq > 512 or hid <= 0:
        raise UnsupportedOp("LSTM needs static seq_len in [1,512] and hidden_size")
    if "layout" in on.attrs:
        _ah1813_19 = on.attrs["layout"]
        _c84 = int(_ah1813_19.i)
    else:
        _c84 = 0
    layout = _c84
    dirs = [0]
    if ndir == 2:
        dirs = [0, 1]
    out = []
    dir_hiddens = []
    dir_cells = []
    for d in dirs:
        pre = on.name + "_d" + str(d) + "_"
        wn = []
        rn = []
        wbn = []
        rbn = []
        _dir_weights(g, on, d, hid, 4, inp, hid, pre + "w", wn, rn, wbn, rbn)
        xseq = on.inputs[0]
        if d == 1:
            rev = pre + "rev_idx"
            _rev_indices(g, rev, seq)
            rx = pre + "rx"
            out.append(_mk_node(pre + "rev", "Gather", [xseq, rev], [rx]))
            xseq = rx
        if len(on.inputs) > 5 and on.inputs[5] != "":
            _c85 = on.inputs[5]
        else:
            _c85 = ""
        h_prev = _c85
        if len(on.inputs) > 6 and on.inputs[6] != "":
            _c86 = on.inputs[6]
        else:
            _c86 = ""
        c_prev = _c86
        # Tinh `bat * hid` MOT LAN truoc moi nhanh: bien dung o ca hai nhanh
        # `if` nen phai gan truoc khi vao chung, khong gan ben trong nhanh.
        _nbh = bat * hid
        if h_prev == "":
            h_prev = pre + "h0"
            _add_float_init(g, h_prev, [bat, hid], _td_f32_repeat(0.0, _nbh))
        if c_prev == "":
            c_prev = pre + "c0"
            _add_float_init(g, c_prev, [bat, hid], _td_f32_repeat(0.0, _nbh))
        if h_prev in g.initializers:
            _th0 = g.tensors[h_prev]
            if len(_th0.shape) == 3:
                hf = _subarray_flat(g.initializers[h_prev], _th0.shape, [d, 0, 0], [1, bat, hid])
                hs = _subarray_shape(g.initializers[h_prev], _th0.shape, [d, 0, 0], [1, bat, hid])
                hn = pre + "hd"
                _add_float_init(g, hn, hs[1:], hf)
                h_prev = hn
        if c_prev in g.initializers:
            _tc1 = g.tensors[c_prev]
            if len(_tc1.shape) == 3:
                cf = _subarray_flat(g.initializers[c_prev], _tc1.shape, [d, 0, 0], [1, bat, hid])
                cs = _subarray_shape(g.initializers[c_prev], _tc1.shape, [d, 0, 0], [1, bat, hid])
                cn = pre + "cd"
                _add_float_init(g, cn, cs[1:], cf)
                c_prev = cn
        hs = []
        cs = []
        for t in range(seq):
            tag = pre + "t" + str(t) + "_"
            if d == 0:
                _c87 = t
            else:
                _c87 = t
            _xo = _rnn_xtract(g, on, _c87, seq, bat, inp, layout, tag)
            s1 = _xo.s1
            e1 = _xo.e1
            mid = _xo.mid
            sh = _xo.sh
            xt = tag + "x"
            _emit_step_slice(out, g, tag, xseq, mid, sh, s1, e1, xt)
            outs = []
            for gg in range(4):
                _gate_mm(out, g, tag + "g" + str(gg) + "", xt, wn[gg], h_prev, rn[gg], wbn[gg], rbn[gg], tag + "z" + str(gg) + "")
                outs.append(tag + "z" + str(gg) + "")
            i_a = tag + "i"
            o_a = tag + "o"
            f_a = tag + ""
            g_a = tag + "g"
            out.append(_mk_node(tag + "ai", acts[0], [outs[0]], [i_a]))
            out.append(_mk_node(tag + "ao", acts[0], [outs[1]], [o_a]))
            out.append(_mk_node(tag + "a", acts[0], [outs[2]], [f_a]))
            out.append(_mk_node(tag + "ag", acts[1], [outs[3]], [g_a]))
            fc = tag + "fc"
            ig = tag + "ig"
            c_new = tag + "c"
            out.append(_mk_node(tag + "m1", "Mul", [f_a, c_prev], [fc]))
            out.append(_mk_node(tag + "m2", "Mul", [i_a, g_a], [ig]))
            out.append(_mk_node(tag + "a1", "Add", [fc, ig], [c_new]))
            tc = tag + "tc"
            h_new = tag + "h"
            out.append(_mk_node(tag + "ah", acts[2], [c_new], [tc]))
            out.append(_mk_node(tag + "m3", "Mul", [o_a, tc], [h_new]))
            h_prev = h_new
            c_prev = c_new
            hs.append(h_new)
            cs.append(c_new)
        dir_hiddens.append(hs)
        dir_cells.append(cs)
    # (2026-09-26) `seq` la int64 nen `dir_hiddens[d][seq - 1]` sinh
    # `ldloc(seq:int64); ldc.i4 1; sub.ovf` - tron do rong, CLR nem
    # BadImageFormatException khi JIT. Ep index ve i32 TRUOC vong lap de
    # `sub.ovf` nhan hai i32 va `get_Item(int32)` khop.
    _qx1039 = []
    _si = int(seq) - 1
    for d in range(len(dirs)):
        _qx1039.append(dir_hiddens[d][_si])
    lasts_h = _qx1039
    _qx1040 = []
    for d in range(len(dirs)):
        _qx1040.append(dir_cells[d][_si])
    lasts_c = _qx1040
    for d in range(len(dirs)):
        for t in range(seq):
            r4 = on.name + "_r4_" + str(d) + "_" + str(t) + ""
            _add_int_init(g, on.name + "_rsh_" + str(d) + "_" + str(t) + "", [1, 1, bat, hid])
            out.append(_mk_node(on.name + "_rs_" + str(d) + "_" + str(t) + "", "Reshape", [dir_hiddens[d][t], on.name + "_rsh_" + str(d) + "_" + str(t) + ""], [r4]))
            _dh = dir_hiddens[d]
            _dh[t] = r4
    if len(on.outputs) > 1 and on.outputs[1] != "":
        _assemble_last(g, out, on, lasts_h, bat, hid, on.outputs[1])
    if len(on.outputs) > 2 and on.outputs[2] != "":
        _assemble_last(g, out, on, lasts_c, bat, hid, on.outputs[2])
    if len(on.outputs) > 0 and on.outputs[0] != "":
        per_dir = []
        for d in range(len(dirs)):
            cd = on.name + "_cd" + str(d) + ""
            out.append(_concat_axis(on.name + "_cc" + str(d) + "", dir_hiddens[d], cd, 0))
            per_dir.append(cd)
        if len(per_dir) > 1:
            out.append(_concat_axis(on.name + "_y", per_dir, on.outputs[0], 1))
        else:
            out.append(_mk_node(on.name + "_y1", "Identity", per_dir, [on.outputs[0]]))
    return out

def _assemble_seq(g: 'ExecutionGraph', out: 'list[OnnxNode]', on: 'OnnxNode', per_dir_hs: 'list[list[str]]', seq: 'i64', bat: 'i64', hid: 'i64', y_name: 'str') -> 'i32':
    per_dir = []
    for d in range(len(per_dir_hs)):
        for t in range(seq):
            r4 = on.name + "_r4_" + str(d) + "_" + str(t) + ""
            _add_int_init(g, on.name + "_rsh_" + str(d) + "_" + str(t) + "", [1, 1, bat, hid])
            out.append(_mk_node(on.name + "_rs_" + str(d) + "_" + str(t) + "", "Reshape", [per_dir_hs[d][t], on.name + "_rsh_" + str(d) + "_" + str(t) + ""], [r4]))
            _ph = per_dir_hs[d]
            _ph[t] = r4
        cd = on.name + "_cd" + str(d) + ""
        out.append(_concat_axis(on.name + "_cc" + str(d) + "", per_dir_hs[d], cd, 0))
        per_dir.append(cd)
    if len(per_dir) > 1:
        out.append(_concat_axis(on.name + "_y", per_dir, y_name, 1))
    else:
        out.append(_mk_node(on.name + "_y1", "Identity", per_dir, [y_name]))
    return 0

def _assemble_last(g: 'ExecutionGraph', out: 'list[OnnxNode]', on: 'OnnxNode', lasts: 'list[str]', bat: 'i64', hid: 'i64', y_name: 'str') -> 'i32':
    per_dir = []
    for d in range(len(lasts)):
        r3 = on.name + "_lr3_" + str(d) + ""
        _add_int_init(g, on.name + "_lrsh_" + str(d) + "", [1, bat, hid])
        out.append(_mk_node(on.name + "_lrs_" + str(d) + "", "Reshape", [lasts[d], on.name + "_lrsh_" + str(d) + ""], [r3]))
        per_dir.append(r3)
    if len(per_dir) > 1:
        out.append(_concat_axis(on.name + "_yh", per_dir, y_name, 0))
    else:
        out.append(_mk_node(on.name + "_yh1", "Identity", per_dir, [y_name]))
    return 0

def _expand_gru(g: 'ExecutionGraph', on: 'OnnxNode') -> 'list[OnnxNode]':
    _rd = _rnn_common(g, on, "GRU")
    seq = _rd.seq
    bat = _rd.bat
    inp = _rd.inp
    hid = _rd.hid
    ndir = _rd.ndir
    acts = _rd.acts
    if seq <= 0 or seq > 512 or hid <= 0:
        raise UnsupportedOp("GRU needs static seq_len in [1,512] and hidden_size")
    if "layout" in on.attrs:
        _ah1979_19 = on.attrs["layout"]
        _c88 = int(_ah1979_19.i)
    else:
        _c88 = 0
    layout = _c88
    if "linear_before" in on.attrs:
        _ah1984_19 = on.attrs["linear_before"]
        _c89 = int(_ah1984_19.i)
    else:
        _c89 = 0
    lb = _c89
    if ndir == 2:
        _c90 = [0, 1]
    else:
        _c90 = [0]
    dirs = _c90
    out = []
    dir_hs = []
    dir_last = []
    for d in dirs:
        pre = on.name + "_d" + str(d) + "_"
        wn = []
        rn = []
        wbn = []
        rbn = []
        _dir_weights(g, on, d, hid, 3, inp, hid, pre + "w", wn, rn, wbn, rbn)
        xseq = on.inputs[0]
        if d == 1:
            rev = pre + "rev_idx"
            _rev_indices(g, rev, seq)
            rx = pre + "rx"
            out.append(_mk_node(pre + "rev", "Gather", [xseq, rev], [rx]))
            xseq = rx
        if len(on.inputs) > 5 and on.inputs[5] != "":
            _c91 = on.inputs[5]
        else:
            _c91 = ""
        h_prev = _c91
        if h_prev == "":
            h_prev = pre + "h0"
            _nbh2 = bat * hid
            _add_float_init(g, h_prev, [bat, hid], _td_f32_repeat(0.0, _nbh2))
        if h_prev in g.initializers:
            _th2 = g.tensors[h_prev]
            if len(_th2.shape) == 3:
                hf = _subarray_flat(g.initializers[h_prev], _th2.shape, [d, 0, 0], [1, bat, hid])
                hs = _subarray_shape(g.initializers[h_prev], _th2.shape, [d, 0, 0], [1, bat, hid])
                hn = pre + "hd"
                _add_float_init(g, hn, hs[1:], hf)
                h_prev = hn
        hs = []
        # (2026-09-26) `bat * hid` tinh truoc: viet inline sau literal 1.0
        # se bien dich `mul.ovf` (nhan so nguyen) tren float32 -> IL sai.
        _nbh2 = bat * hid
        _add_float_init(g, pre + "one", [bat, hid], _td_f32_repeat(1.0, _nbh2))
        for t in range(seq):
            tag = pre + "t" + str(t) + "_"
            _xo = _rnn_xtract(g, on, t, seq, bat, inp, layout, tag)
            s1 = _xo.s1
            e1 = _xo.e1
            mid = _xo.mid
            sh = _xo.sh
            xt = tag + "x"
            _emit_step_slice(out, g, tag, xseq, mid, sh, s1, e1, xt)
            _gate_mm(out, g, tag + "z", xt, wn[0], h_prev, rn[0], wbn[0], rbn[0], tag + "zz")
            _gate_mm(out, g, tag + "r", xt, wn[1], h_prev, rn[1], wbn[1], rbn[1], tag + "rr")
            zt = tag + "zt"
            rt = tag + "rt"
            out.append(_mk_node(tag + "az", acts[0], [tag + "zz"], [zt]))
            out.append(_mk_node(tag + "ar", acts[1], [tag + "rr"], [rt]))
            if lb == 0:
                rh = tag + "rh"
                out.append(_mk_node(tag + "mrh", "Mul", [rt, h_prev], [rh]))
                _gate_mm(out, g, tag + "h", xt, wn[2], rh, rn[2], wbn[2], rbn[2], tag + "hh")
            else:
                t1 = tag + "t1"
                t2 = tag + "t2"
                out.append(_mk_node(tag + "mm1", "MatMul", [xt, wn[2]], [t1 + "a"]))
                out.append(_mk_node(tag + "ad1", "Add", [t1 + "a", wbn[2]], [t1]))
                out.append(_mk_node(tag + "mm2", "MatMul", [h_prev, rn[2]], [t2 + "a"]))
                out.append(_mk_node(tag + "ad2", "Add", [t2 + "a", rbn[2]], [t2]))
                rm = tag + "rm"
                out.append(_mk_node(tag + "mrm", "Mul", [rt, t2], [rm]))
                out.append(_mk_node(tag + "ad3", "Add", [t1, rm], [tag + "hh"]))
            out.append(_mk_node(tag + "ah", acts[2], [tag + "hh"], [tag + "hc"]))
            om = tag + "om"
            out.append(_mk_node(tag + "m1", "Mul", [zt, h_prev], [om]))
            zc = tag + "zc"
            out.append(_mk_node(tag + "s1", "Sub", [pre + "one", zt], [zc]))
            h_new = tag + "h"
            out.append(_mk_node(tag + "m2", "Mul", [zc, tag + "hc"], [tag + "nh"]))
            out.append(_mk_node(tag + "a2", "Add", [om, tag + "nh"], [h_new]))
            h_prev = h_new
            hs.append(h_new)
        dir_hs.append(hs)
        dir_last.append(h_prev)
    if len(on.outputs) > 0 and on.outputs[0] != "":
        _assemble_seq(g, out, on, dir_hs, seq, bat, hid, on.outputs[0])
    if len(on.outputs) > 1 and on.outputs[1] != "":
        _assemble_last(g, out, on, dir_last, bat, hid, on.outputs[1])
    return out

def _expand_rnn(g: 'ExecutionGraph', on: 'OnnxNode') -> 'list[OnnxNode]':
    _rd = _rnn_common(g, on, "RNN")
    seq = _rd.seq
    bat = _rd.bat
    inp = _rd.inp
    hid = _rd.hid
    ndir = _rd.ndir
    acts = _rd.acts
    if seq <= 0 or seq > 512 or hid <= 0:
        raise UnsupportedOp("RNN needs static seq_len in [1,512] and hidden_size")
    if "layout" in on.attrs:
        _ah2082_19 = on.attrs["layout"]
        _c92 = int(_ah2082_19.i)
    else:
        _c92 = 0
    layout = _c92
    if ndir == 2:
        _c93 = [0, 1]
    else:
        _c93 = [0]
    dirs = _c93
    out = []
    dir_hs = []
    dir_last = []
    for d in dirs:
        pre = on.name + "_d" + str(d) + "_"
        wn = []
        rn = []
        wbn = []
        rbn = []
        _dir_weights(g, on, d, hid, 1, inp, hid, pre + "w", wn, rn, wbn, rbn)
        xseq = on.inputs[0]
        if d == 1:
            rev = pre + "rev_idx"
            _rev_indices(g, rev, seq)
            rx = pre + "rx"
            out.append(_mk_node(pre + "rev", "Gather", [xseq, rev], [rx]))
            xseq = rx
        if len(on.inputs) > 5 and on.inputs[5] != "":
            _c94 = on.inputs[5]
        else:
            _c94 = ""
        h_prev = _c94
        if h_prev == "":
            h_prev = pre + "h0"
            _nbh3 = bat * hid
            _add_float_init(g, h_prev, [bat, hid], _td_f32_repeat(0.0, _nbh3))
        if h_prev in g.initializers:
            _th3 = g.tensors[h_prev]
            if len(_th3.shape) == 3:
                hf = _subarray_flat(g.initializers[h_prev], _th3.shape, [d, 0, 0], [1, bat, hid])
                hs = _subarray_shape(g.initializers[h_prev], _th3.shape, [d, 0, 0], [1, bat, hid])
                hn = pre + "hd"
                _add_float_init(g, hn, hs[1:], hf)
                h_prev = hn
        hs = []
        for t in range(seq):
            tag = pre + "t" + str(t) + "_"
            _xo = _rnn_xtract(g, on, t, seq, bat, inp, layout, tag)
            s1 = _xo.s1
            e1 = _xo.e1
            mid = _xo.mid
            sh = _xo.sh
            xt = tag + "x"
            _emit_step_slice(out, g, tag, xseq, mid, sh, s1, e1, xt)
            _gate_mm(out, g, tag + "g", xt, wn[0], h_prev, rn[0], wbn[0], rbn[0], tag + "z")
            h_new = tag + "h"
            out.append(_mk_node(tag + "a", acts[0], [tag + "z"], [h_new]))
            h_prev = h_new
            hs.append(h_new)
        dir_hs.append(hs)
        dir_last.append(h_prev)
    if len(on.outputs) > 0 and on.outputs[0] != "":
        _assemble_seq(g, out, on, dir_hs, seq, bat, hid, on.outputs[0])
    if len(on.outputs) > 1 and on.outputs[1] != "":
        _assemble_last(g, out, on, dir_last, bat, hid, on.outputs[1])
    return out

def topo_sort(nodes: 'list[ExecutionNode]', inputs: 'list[str]', inits: 'list[str]') -> 'list[ExecutionNode]':
    ready = {}
    for _r in inputs:
        ready[_r] = 1
    for k in inits:
        ready[k] = 1
    remaining = []
    for nd in nodes:
        remaining.append(nd)
    out = []
    guard = len(remaining) + 1
    while len(remaining) > 0 and guard > 0:
        guard = guard - 1
        take = -1
        i = 0
        while i < len(remaining):
            nd = remaining[i]
            free = 1
            for nm in nd.inputs:
                if nm not in ready:
                    free = 0
            if free == 1:
                take = i
                i = len(remaining)
            i = i + 1
        if take < 0:
            for nd in remaining:
                out.append(nd)
            remaining.pop(0)
        else:
            nd = remaining[take]
            out.append(nd)
            for o in nd.outputs:
                ready[o] = 1
            remaining.pop(take)
    return out
