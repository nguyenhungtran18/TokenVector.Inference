    _shr = _infer_shapes_b(node, ins, g, op, same1)
    if len(_shr) > 0:
        return _shr
    _shr = _infer_shapes_c(node, ins, g, op, same1)
    if len(_shr) > 0:
        return _shr
    return [[]]

def _is_op_simple(op: 'i64') -> 'i32':
    return op == OperatorType_Relu or op == OperatorType_Gelu or op == OperatorType_Silu or op == OperatorType_Sigmoid or op == OperatorType_Tanh or op == OperatorType_LeakyRelu or op == OperatorType_Elu or op == OperatorType_Softplus or op == OperatorType_Sqrt or op == OperatorType_Exp or op == OperatorType_Log or op == OperatorType_Neg or op == OperatorType_Reciprocal or op == OperatorType_Abs or op == OperatorType_Clip or op == OperatorType_Cast or op == OperatorType_Dropout or op == OperatorType_Softmax or op == OperatorType_RMSNorm or op == OperatorType_LayerNorm or op == OperatorType_BatchNormalization or op == OperatorType_Attention or op == OperatorType_Identity

def _is_op_binary(op: 'i64') -> 'i32':
    return op == OperatorType_Add or op == OperatorType_Sub or op == OperatorType_Mul or op == OperatorType_Div or op == OperatorType_Pow or op == OperatorType_Min or op == OperatorType_Max or op == OperatorType_Mean or op == OperatorType_Sum or op == OperatorType_Where

def _is_op_reduce(op: 'i64') -> 'i32':
    return op == OperatorType_ReduceMean or op == OperatorType_ReduceSum or op == OperatorType_ReduceMax

def _is_op_scatter(op: 'i64') -> 'i32':
    return op == OperatorType_ScatterElements or op == OperatorType_CumSum or op == OperatorType_EyeLike or op == OperatorType_InstanceNormalization or op == OperatorType_Mish or op == OperatorType_PRelu

def _is_op_string(op: 'i64') -> 'i32':
    return op == OperatorType_StringConcat or op == OperatorType_StringEqual

