def _td_i64_list(dims: 'list[i64]') -> 'list[i64]':
    # (2026-09-26) Dung list RONG roi append, KHONG duoc viet `q = []` roi
    # `q.append(int(d))`.
    #
    # `[]` tao ra `List<TkvInt>`, khong phai `list[i64]`. Khi truyen
    # `List<TkvInt>` vao tham so khai bao `list[i64]`, compiler KHONG kiem tra
    # kieu phan tu nen khong bao loi bien dich. Ben trong ham nhan, phep nhan
    # `i64 * TkvInt` duoc sinh sai va ra ket qua rac:
    #
    #   calc_element_count(shape) voi shape = [1, 8, 2]
    #     -> 68719476736 + 2 (= 2^36 + 2) thay vi 16
    #
    # Do do `_nd_f32(calc_element_count(shape))` cap phat 68719476738 phan tu
    # float va CLR nem "Array dimensions exceeded supported range".
    #
    # `_nd_i64(0)` tra ve `list[i64]` rong dung kieu, nen moi an toan.
    # KHONG viet `out.append(int(d))`: ep kieu `int(...)` tren mot bien da la
    # int64 bi codegen thanh `conv.i4` (cat int64 -> int32), roi `List<int64>::Add`
    # lai nhan int64 -> stack type mismatch, CLR nem BadImageFormatException
    # ("An attempt was made to load a program with an incorrect format") khi
    # nap assembly. `d` da la int64 nen append truc tiep.
    out = _nd_i64(0)
    for d in dims:
        out.append(d)
    return out

def _td_f32_repeat(v: 'f32', n: 'i64') -> 'list[f32]':
    # (2026-09-26) Thay the cho `[v] * n` - nhan lap list tren LITERAL.
    #
    # LUU Y KHI GOI: truyen `bat * hid` INLINE cung toan hang voi ham nay se
    # lam ngung canh bien dich cua ca bieu thuc tro thanh f32 (vi tham so
    # `v` la float). Compiler chon `mul.ovf` - NHAN SO NGUYEN - roi phat no
    # tren hai toan hang float32, tao IL khong hop le. Hay tinh `bat * hid`
    # vao mot bien i64 truoc roi truyen bien do.
    #
    # Compiler CHUA xu ly nhan lap tren literal. O dang gan thu
    # `r = [0.0] * n` no bao loi ro rang, nhung khi nam trong danh sach tham so
    # co ngu canh `list[f32]` thi loi bi bo qua va IL sai duoc sinh ra:
    #
    #     newobj List`1<float32>::.ctor()
    #     dup
    #     ldc.r4 0.0
    #     callvirt List`1<float32>::Add(!0)   <- list [0.0] da dung
    #     <bieu thuc dem>                       <- con them day du vao stack
    #     conv.r4 / conv.r4
    #     mul.ovf                              <- opcode NHAN SO NGUYEN
    #     mul.ovf                              <- phat HAI LAN
    #
    # -> CLR nem BadImageFormatException khi nap method (`_expand_lstm`,
    # `_expand_gru`, `_expand_rnn` deu dung mau nay cho bias/initial state).
    #
    # Ham nay tao `list[f32]` ro bang cach gan truc tiep, dung kieu.
    out = _nd_f32(n)
    for i in range(n):
        out[i] = v
    return out

