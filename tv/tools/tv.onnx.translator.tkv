            in_shapes.append(_c14)
        out_shapes = _infer_node_shapes(node, in_shapes, g)
        for k in range(min(len(node.outputs), len(out_shapes))):
            nm = node.outputs[k]
            if nm in g.tensors:
                t = g.tensors[nm]
                _lh4 = out_shapes[k]
                if len(t.shape) == 0 and len(_lh4) > 0:
                    t.shape = out_shapes[k]
                    t.element_count = calc_element_count(t.shape)
                    t.byte_size = t.element_count * dtype_size(t.dtype)
    return 0

