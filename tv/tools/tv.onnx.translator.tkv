def map_op(op: 'str') -> 'i64':
    if op == "Gemm":
        return OperatorType_Gemm
    if op == "MatMul":
        return OperatorType_MatMul
    if op == "Conv":
        return OperatorType_Conv2D
    if op == "Relu":
        return OperatorType_Relu
    if op == "Gelu":
        return OperatorType_Gelu
    if op == "LeakyRelu":
        return OperatorType_LeakyRelu
    if op == "Elu":
        return OperatorType_Elu
    if op == "Softplus":
        return OperatorType_Softplus
    if op == "Sigmoid":
        return OperatorType_Sigmoid
    if op == "Tanh":
        return OperatorType_Tanh
    if op == "Add":
        return OperatorType_Add
    if op == "Sub":
        return OperatorType_Sub
    if op == "Mul":
        return OperatorType_Mul
    if op == "Div":
        return OperatorType_Div
    if op == "Pow":
        return OperatorType_Pow
    if op == "Sqrt":
        return OperatorType_Sqrt
    if op == "Exp":
        return OperatorType_Exp
    if op == "Log":
        return OperatorType_Log
    if op == "Neg":
        return OperatorType_Neg
    if op == "Reciprocal":
        return OperatorType_Reciprocal
    if op == "Abs":
        return OperatorType_Abs
    if op == "Min":
        return OperatorType_Min
    if op == "Max":
        return OperatorType_Max
    if op == "Mean":
        return OperatorType_Mean
    if op == "Sum":
        return OperatorType_Sum
    if op == "Where":
        return OperatorType_Where
    if op == "Clip":
        return OperatorType_Clip
    if op == "Cast":
        return OperatorType_Cast
    if op == "Dropout":
        return OperatorType_Dropout
    if op == "Softmax":
        return OperatorType_Softmax
    if op == "RMSNorm" or op == "SimplifiedLayerNormalization":
        return OperatorType_RMSNorm
    if op == "LayerNormalization":
        return OperatorType_LayerNorm
    if op == "BatchNormalization":
        return OperatorType_BatchNormalization
    if op == "Attention" or op == "MultiHeadAttention" or op == "ScaledDotProductAttention" or (op == "GQA"):
        return OperatorType_Attention
    if op == "GlobalAveragePool":
        return OperatorType_GlobalAveragePool
    if op == "MaxPool":
        return OperatorType_MaxPool
    if op == "AveragePool":
        return OperatorType_AveragePool
    if op == "Gather":
        return OperatorType_Gather
    if op == "Slice":
        return OperatorType_Slice
    if op == "Split":
        return OperatorType_Split
    if op == "Squeeze":
        return OperatorType_Squeeze
    if op == "Unsqueeze":
        return OperatorType_Unsqueeze
    if op == "Expand":
        return OperatorType_Expand
    if op == "Reshape":
        return OperatorType_Reshape
    if op == "Flatten":
        return OperatorType_Flatten
    if op == "Transpose":
        return OperatorType_Transpose
    if op == "Concat":
        return OperatorType_Concat
    if op == "Pad":
        return OperatorType_Pad
    if op == "ReduceMean":
        return OperatorType_ReduceMean
    if op == "ReduceSum":
        return OperatorType_ReduceSum
    if op == "ReduceMax":
        return OperatorType_ReduceMax
    if op == "ArgMax":
        return OperatorType_ArgMax
    if op == "Shape":
        return OperatorType_Shape
    if op == "Size":
        return OperatorType_Size
    if op == "Identity":
        return OperatorType_Identity
    if op == "LogSoftmax":
        return OperatorType_LogSoftmax
    if op == "Trilu":
        return OperatorType_Trilu
    if op == "TopK":
        return OperatorType_TopK
    if op == "QuantizeLinear":
        return OperatorType_QuantizeLinear
    if op == "DequantizeLinear":
        return OperatorType_DequantizeLinear
    if op == "QLinearMatMul":
        return OperatorType_QLinearMatMul
    if op == "GatherND":
        return OperatorType_GatherND
    if op == "ScatterElements":
        return OperatorType_ScatterElements
    if op == "Range":
        return OperatorType_Range
    if op == "EyeLike":
        return OperatorType_EyeLike
    if op == "ConstantOfShape":
        return OperatorType_ConstantOfShape
    if op == "CumSum":
        return OperatorType_CumSum
    if op == "InstanceNormalization":
        return OperatorType_InstanceNormalization
    if op == "Mish":
        return OperatorType_Mish
    if op == "PRelu":
        return OperatorType_PRelu
    if op == "Resize" or op == "Upsample":
        return OperatorType_Resize
    if op == "Einsum":
        return OperatorType_Einsum
    if op == "QLinearConv":
        return OperatorType_QLinearConv
    if op == "MatMulInteger":
        return OperatorType_MatMulInteger
    if op == "DynamicQuantizeLinear":
        return OperatorType_DynamicQuantizeLinear
    if op == "StringConcat":
        return OperatorType_StringConcat
    if op == "StringEqual":
        return OperatorType_StringEqual
    if op == "StringLength":
        return OperatorType_StringLength
    if op == "Scan":
        return OperatorType_Custom
    raise UnsupportedOp("ONNX op '" + str(op) + "' is not supported by tv.runtime")

def _fold_constant(g: 'ExecutionGraph', on: 'OnnxNode', idx: 'i64') -> 'i32':
    if len(on.outputs) == 0:
        return 0
    name = on.outputs[0]
    if "value" in on.attrs:
        _av2 = on.attrs["value"]
        if _av2.t is not None:
            t = _av2.t
            shape = []
            for d in t.dims:
                shape.append(int(d))
            if len(shape) == 0:
                shape = [1]
            nd = _nd_f32(calc_element_count(shape))
            src = t.extract_float_array()
            n = min(len(src), len(nd))
            for i in range(n):
                nd[i] = src[i]
            g.initializers[name] = nd
            g.get_or_create_tensor(name, shape, t.dtype)
            return 0
    if "value_float" in on.attrs:
        v = _nd_f32(1)
        _af = on.attrs["value_float"]
        v[0] = _af.f
        g.initializers[name] = v
        g.get_or_create_tensor(name, [1])
        return 0
    if "value_floats" in on.attrs:
        _afs = on.attrs["value_floats"]
        if len(_afs.floats) > 0:
            fs = _afs.floats
            v = _nd_f32(len(fs))
            for i in range(len(fs)):
                v[i] = fs[i]
            g.initializers[name] = v
            g.get_or_create_tensor(name, [len(fs)])
            return 0
    if "value_int" in on.attrs:
        v = _nd_f32(1)
        _ai = on.attrs["value_int"]
