# G4 TRAINER (ROADMAP_TRAIN) — AdamW + warmup/cosine + clip norm +
# grad accumulation + checkpoint bit-exact + vong train/eval.
#
# Reference: tools\gen_trainer_fixture.py (PyTorch) — cung cong thuc, cung
# thu tu tinh, cung hang so. Fixture: tv/tests/fixtures/train_cases.txt
#
# Model demo (dung cho gate G4): MLP 4 -> 8 (ReLU) -> 3, cross-entropy mean.
# Tham so nam PHANG trong MOT list[f32] (67 phan tu) — workaround bug compiler
# "list phang thu 2" (xem HANDOFF muc 0.2):
#    [0..31]   W1  row-major [hid][in]
#    [32..39]  b1
#    [40..63]  W2  row-major [out][hid]
#    [64..66]  b2
#
# Cong thuc (khop torch.optim.AdamW + clip_grad_norm_ + LambdaLR):
#   lr(s): s < warmup -> lr_max*(s+1)/warmup
#          nguoc lai  -> lr_min + (lr_max-lr_min)*0.5*(1+cos(pi*prog))
#                        prog = (s-warmup)/(total-warmup)
#   clip:  norm = L2(L2 tung tham so...); coef = clip/(norm+1e-6), chi nhan <1
#   AdamW: p *= (1 - lr*wd)
#          m = b1*m + (1-b1)*g ; v = b2*v + (1-b2)*g*g
#          step_size = lr/(1 - b1^t) ; denom = sqrt(v)/sqrt(1-b2^t) + eps
#          p = p - step_size*m/denom
#
# Checkpoint: text, tham so/m/v ghi bang BIT IEEE-754 binary32 (khong phai so
# thap phan) nen save -> load la bit-exact tuyet doi.

import tv.numerics.tensor
import tv.runtime.f32_bits

IN_D = 4
HID = 8
OUT_D = 3
W1_N = 32
B1_OFF = 32
W2_OFF = 40
B2_OFF = 64
N_PARAM = 67

def _zeros(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        # M5 (2026-10-24): append BIEU THUC -> compiler ep List[Single] (f32 THUC).
        # append(0.0) thuan tao List[Double] -> f32_copy_to_buf/adamw_step nem
        # (native doc `_items` cua List[Single]) — xem HANDOFF §0.46.
        out.append((float(0) - 0.0) / 1.0)
    return out

def _absf(v: 'f32') -> 'f32':
    if v < 0.0:
        return 0.0 - v
    return v

def _bp(b: 'f32', e: 'i64') -> 'f32':
    r = 1.0
    for i in range(e):
        r = r * b
    return r

def lr_at(s: 'i64', warmup: 'i64', total: 'i64', lr_max: 'f32', lr_min: 'f32') -> 'f32':
    if s < warmup:
        return lr_max * float(s + 1) / float(warmup)
    if total <= warmup:
        return lr_max
    prog = float(s - warmup) / float(total - warmup)
    return lr_min + (lr_max - lr_min) * 0.5 * (1.0 + cos(3.141592653589793 * prog))

# ============================================================================
#  Bo toi uu
# ============================================================================

class AdamW:
    _ok: 'i64'
    n: 'i64'
    p: 'list[f32]'
    g: 'list[f32]'
    m: 'list[f32]'
    v: 'list[f32]'
    t: 'i64'
    warmup: 'i64'
    total: 'i64'
    lr_max: 'f32'
    lr_min: 'f32'
    b1: 'f32'
    b2: 'f32'
    eps: 'f32'
    wd: 'f32'
    clip: 'f32'
    groups: 'list[i64]'
    # ==== M5 (2026-10-24, SPEC M4-M7 §2): buffer native ====================
    # p/m/v/g state chinh thuc cho adamw_step o day (native, khong boxing);
    # p van SYNC ve list moi buoc (trainer/bench doc opt.p), g doc tu list moi
    # buoc (backward ghi vao opt.g), m/v sync ve list truoc ckpt_save.
    pp: 'i64'
    pm: 'i64'
    pv: 'i64'
    pg: 'i64'
    pt: 'i64'
    pone: 'i64'
    # M5-opt: 1 = p list da sua ngoai (setup) — buoc sau se day list->buf.
    pdirty: 'i32'

    def __init__(self, n: 'i64', warmup: 'i64', total: 'i64',
                 lr_max: 'f32', lr_min: 'f32',
                 b1: 'f32', b2: 'f32', eps: 'f32', wd: 'f32', clip: 'f32'):
        self.n = n
        self.p = _zeros(n)
        self.g = _zeros(n)
        # M5-opt (2026-10-25): m/v LAZY — khong alloc list o day (@124M thi
        # ~1GB RAM); sync_mv() cap phat + doc tu buffer khi ckpt/test can doc.
        self.m = _zeros(0)
        self.v = _zeros(0)
        self.t = 0
        self.warmup = warmup
        self.total = total
        self.lr_max = lr_max
        self.lr_min = lr_min
        self.b1 = b1
        self.b2 = b2
        self.eps = eps
        self.wd = wd
        self.clip = clip
        # groups = kich thuoc tung nhom tham so de tinh grad norm giong
        # PyTorch clip_grad_norm_ (L2 tung tensor roi L2 cac norm). Rong =
        # layout MLP 4-8-3 (mac dinh cua trainer demo).
        self.groups = []
        # cap phat buffer native (M5) — m/v song song (state chinh o buf);
        # pt/pone = scratch cho truong hop clip (coef != 1.0).
        self.pp = alloc_bytes(n * 4)
        self.pm = alloc_bytes(n * 4)
        self.pv = alloc_bytes(n * 4)
        self.pg = alloc_bytes(n * 4)
        self.pt = alloc_bytes(n * 4)
        self.pone = alloc_bytes(n * 4)
        self.pdirty = 1
        p0 = self.pp
        m0 = self.pm
        v0 = self.pv
        g0 = self.pg
        rz1 = f32_zero(p0, n)
        rz2 = f32_zero(m0, n)
        rz3 = f32_zero(v0, n)
        rz4 = f32_zero(g0, n)
        o0 = self.pone
        onb = f32buf_wrap(o0, n)
        i = 0
        while i < n:
            onb[i] = 1.0
            i = i + 1

    def zero_grad(self) -> 'i32':
        for i in range(self.n):
            self.g[i] = 0.0
        return 0

    def lr_now(self) -> 'f32':
        return lr_at(self.t, self.warmup, self.total, self.lr_max, self.lr_min)

    def grad_norm(self) -> 'f32':
        if len(self.groups) > 0:
            return _norm_groups(self.g, self.groups)
        return self._norm_mlp()

    def _norm_mlp(self) -> 'f32':
        # khop PyTorch clip_grad_norm_: L2 tung tham so, roi L2 tren cac norm
        s1 = 0.0
        i = 0
        while i < W1_N:
            s1 = s1 + self.g[i] * self.g[i]
            i = i + 1
        s2 = 0.0
        i = B1_OFF
        while i < W2_OFF:
            s2 = s2 + self.g[i] * self.g[i]
            i = i + 1
        s3 = 0.0
        i = W2_OFF
        while i < B2_OFF:
            s3 = s3 + self.g[i] * self.g[i]
            i = i + 1
        s4 = 0.0
        i = B2_OFF
        while i < N_PARAM:
            s4 = s4 + self.g[i] * self.g[i]
            i = i + 1
        n1 = sqrt(s1)
        n2 = sqrt(s2)
        n3 = sqrt(s3)
        n4 = sqrt(s4)
        return sqrt(n1 * n1 + n2 * n2 + n3 * n3 + n4 * n4)

    def step(self) -> 'f32':
        lr = lr_at(self.t, self.warmup, self.total, self.lr_max, self.lr_min)
        gn = self.grad_norm()
        coef = 1.0
        if gn > 0.0:
            coef = self.clip / (gn + 0.000001)
            if coef > 1.0:
                coef = 1.0
        t1 = self.t + 1
        bc1 = 1.0 - _bp(self.b1, t1)
        bc2 = 1.0 - _bp(self.b2, t1)
        step_size = lr / bc1
        bc2s = sqrt(bc2)
        wdf = 1.0 - lr * self.wd
        # ==== P6 GĐ10 (2026-10-22, probe CB): GỘP 2 DIV THÀNH 1 ====
        # Cong thuc dai so (chinh xac): m / (sqrt(v)/bc2s + eps)
        #   == (m*bc2s) / (sqrt(v) + eps*bc2s)
        # PyTorch (torch/optim/adamw.py) cung chi co 1 div/ptu.
        # Do (probe CB, N=124M): 30.7 -> 28.8 ns/ptu = 1.07x; maxdiff voi
        # duong cu = 1.19e-07 sau 1 buoc. Hoist (1-b1)/(1-b2) + gop p: do
        # lai khong anh huong (V1 0.93x, V2 0.92x) -> giu nguyen.
        epss = self.eps * bc2s
        ks = step_size * bc2s
        # ==== M5 (2026-10-24): fused AdamW NATIVE (builtin adamw_step) =======
        # Vong interpreted ~3930 ms/buoc @124M (boxing list[f64]) thay bang
        # kernel AVX2+FMA. Cong thuc GĐ10 giu nguyen; doi so:
        #   lr_native = step_size (= lr/bc1), wd_native = wd*bc1
        #   -> native tinh (lr/bc1)*(m*bc2s)/(sqrt(v)+eps*bc2s) + (lr/bc1)*(wd*bc1)*p
        #   = step_size*bc2s*m/(...) + lr*wd*p  — DUNG gia tri vong cu.
        # Lech ulp (thu tu nhan/phep tru ~1e-7) — trong TOL 1e-5 trainer_tests.
        # coef != 1.0 (clip hoat dong): toan tu g bang f32_addcmul scratch
        # (pt = coef*g*1) vi kernel khong co tham so coef.
        gl = self.g
        pl = self.p
        pgl = self.pg
        ppl = self.pp
        pml = self.pm
        pvl = self.pv
        ptl = self.pt
        ponl = self.pone
        # Phase B2 (2026-10-27): thu adamw_step_glm (bo copy r1, doc gl list
        # truc tiep) — bench A/B tu choi: +3.2s/buoc @seq1024 (n=124M, cong
        # them alloc/marshal 496MB duoi ap luc RAM) → giu nguyen duong copy + adamw_step.
        r1 = f32_copy_to_buf(gl, pgl, self.n)
        gsrc: "i64" = pgl
        if coef != 1.0:
            rzp = f32_zero(ptl, self.n)
            rax = f32_addcmul(ptl, pgl, ponl, coef, self.n)
            gsrc = ptl
        # M5-opt (probe CJ7 bit-exact): BO r2 moi buoc — p day 1 lan luc setup
        # (pdirty=1 tu __init__; site ghi opt.p ngoai setup thi push_p()).
        # r3 van giu p list = anh chinh doc boi unflatten/bench/ckpt.
        if self.pdirty != 0:
            r2 = f32_copy_to_buf(pl, ppl, self.n)
            self.pdirty = 0
        wde = self.wd * bc1
        stw = adamw_step(ppl, pml, pvl, gsrc, self.n,
                         step_size, self.b1, self.b2, self.eps, wde, bc1, bc2s)
        r3 = f32_copy_from_buf(ppl, pl, self.n)
        # M5-opt: BO r4/r5 (+188ms/buoc @124M — do _cj8) — m/v song TRUC TIEP
        # o buffer; ckpt_save/test doc qua sync_mv() (lazy cap phat list).
        self.t = self.t + 1
        return lr

    # ==== M5-opt (2026-10-25): push_p + sync_mv ================================
    def push_p(self) -> 'i64':
        # Danh dau p list da duoc sua NGOAI setup — buoc sau se day list->buf
        # (thay cho r2 moi buoc). Goi NGAY SAU moi lan ghi vao opt.p khi do.
        self.pdirty = 1
        return 0

    def sync_mv(self) -> 'i64':
        # Doc state m/v tu buffer ve list (lazy: chua co list thi cap phat n).
        # Goi truoc ckpt_save serialize va truoc khi test doc opt.m/opt.v.
        if len(self.m) != self.n:
            self.m = _zeros(self.n)
        if len(self.v) != self.n:
            self.v = _zeros(self.n)
        ml: "list[f32]" = self.m
        vl: "list[f32]" = self.v
        rs1 = f32_copy_from_buf(self.pm, ml, self.n)
        rs2 = f32_copy_from_buf(self.pv, vl, self.n)
        return 0

# ============================================================================
#  Sampler: xao tron moi epoch bang LCG 31-bit (Fisher-Yates), giong fixture
# ============================================================================

class Sampler:
    _ok: 'i64'
    n: 'i64'
    perm: 'list[i64]'
    state: 'i64'
    draws: 'i64'

    def __init__(self, n: 'i64', seed: 'i64'):
        self.n = n
        self.state = seed % 2147483648
        self.draws = 0
        self.perm = []
        for i in range(n):
            self.perm.append(i)
        self.shuffle()

    def shuffle(self) -> 'i32':
        # reset ve identity TRUOC moi lan xao (giong fixture: perm = range(n)).
        # SUA TAI CHO, KHONG gan lai field: sau khi goi ham con, compiler co
        # the dung tham chieu field CU (index dau tien doc perm cu).
        for k in range(self.n):
            self.perm[k] = k
        i = self.n - 1
        while i > 0:
            self.state = (self.state * 1103515245 + 12345) % 2147483648
            j = self.state % (i + 1)
            t = self.perm[i]
            self.perm[i] = self.perm[j]
            self.perm[j] = t
            i = i - 1
        return 0

    def next_idx(self) -> 'i64':
        if self.draws > 0 and self.draws % self.n == 0:
            self.shuffle()
        idx = self.perm[self.draws % self.n]
        self.draws = self.draws + 1
        return idx

# ==== P6 GĐ4 (2026-10-21): _norm_groups PARALLEL 12 WORKER =================
# Dong bo voi canonical trainer.tkv (gpt2 124M). Do probe BM[1] (layout 148
# nhom that, 124.4M ptu): serial 984-1141ms -> PAR12 375-406ms (2.5-2.9x),
# BIT=0.0 — worker tinh s tung nhom dung thu tu phan tu, main gop DUNG thu tu
# nhom. Guard tong < 4M ptu -> serial nguyen ban (demo/gate nho khong doi
# hanh vi). CHU Y compiler (probe BM): KHONG dung nested list (list cua list)
# — append list[f32] vao list nem ArrayTypeMismatchException.

class _TnJob:
    gl: "list[f32]"
    grl: "list[i64]"
    ssl: "list[f64]"
    glo: 'i64'
    ghi: 'i64'
    def __init__(self, gl: "list[f32]", grl: "list[i64]", ssl: "list[f64]",
                  glo: 'i64', ghi: 'i64'):
        self.gl = gl
        self.grl = grl
        self.ssl = ssl
        self.glo = glo
        self.ghi = ghi

def _tn_div(a: 'i64', b: 'i64') -> 'i64':
    # chia nhi phan (khong dung '/' cua i64)
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _tn_zeros(n: 'i64') -> 'list[f64]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _tn_one(j: "_TnJob") -> 'i64':
    # worker norm: tinh s moi nhom [glo, ghi) dung thu tu phan tu
    off = 0
    k = 0
    while k < j.glo:
        off = off + j.grl[k]
        k = k + 1
    kk = j.glo
    while kk < j.ghi:
        cnt = j.grl[kk]
        s = 0.0
        i = 0
        while i < cnt:
            s = s + j.gl[off + i] * j.gl[off + i]
            i = i + 1
        j.ssl[kk] = s
        off = off + cnt
        kk = kk + 1
    return 0

def _norm_groups(g: 'list[f32]', groups: 'list[i64]') -> 'f32':
    # PyTorch clip_grad_norm_: norm = L2( norm(g1), norm(g2), ... )
    # P6 GĐ4: parallel 12 worker + main gop DUNG thu tu nhom (BIT=0.0).
    ng = len(groups)
    tot_elem = 0
    for k in range(ng):
        tot_elem = tot_elem + groups[k]
    if tot_elem >= 4000000:
        ssl = _tn_zeros(ng)
        b0 = _tn_div(0 * ng, 12)
        b1 = _tn_div(1 * ng, 12)
        b2 = _tn_div(2 * ng, 12)
        b3 = _tn_div(3 * ng, 12)
        b4 = _tn_div(4 * ng, 12)
        b5 = _tn_div(5 * ng, 12)
        b6 = _tn_div(6 * ng, 12)
        b7 = _tn_div(7 * ng, 12)
        b8 = _tn_div(8 * ng, 12)
        b9 = _tn_div(9 * ng, 12)
        b10 = _tn_div(10 * ng, 12)
        b11 = _tn_div(11 * ng, 12)
        h0 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b0, b1))
        h1 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b1, b2))
        h2 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b2, b3))
        h3 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b3, b4))
        h4 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b4, b5))
        h5 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b5, b6))
        h6 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b6, b7))
        h7 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b7, b8))
        h8 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b8, b9))
        h9 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b9, b10))
        h10 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b10, b11))
        h11 = thread_spawn(_tn_one, _TnJob(g, groups, ssl, b11, ng))
        j0 = thread_join(h0)
        j1 = thread_join(h1)
        j2 = thread_join(h2)
        j3 = thread_join(h3)
        j4 = thread_join(h4)
        j5 = thread_join(h5)
        j6 = thread_join(h6)
        j7 = thread_join(h7)
        j8 = thread_join(h8)
        j9 = thread_join(h9)
        j10 = thread_join(h10)
        j11 = thread_join(h11)
        # main gop DUNG thu tu nhom (giong serial: tot += nrm*nrm)
        tot = 0.0
        for k in range(ng):
            nrm = sqrt(ssl[k])
            tot = tot + nrm * nrm
        return sqrt(tot)
    tot = 0.0
    off = 0
    for k in range(ng):
        cnt = groups[k]
        s = 0.0
        for i in range(cnt):
            s = s + g[off + i] * g[off + i]
        nrm = sqrt(s)
        tot = tot + nrm * nrm
        off = off + cnt
    return sqrt(tot)

# Factory (constructor KHONG export qua module — quy tac compiler)
def new_adamw(n: 'i64', warmup: 'i64', total: 'i64',
              lr_max: 'f32', lr_min: 'f32',
              b1: 'f32', b2: 'f32', eps: 'f32', wd: 'f32', clip: 'f32') -> "AdamW":
    return AdamW(n, warmup, total, lr_max, lr_min, b1, b2, eps, wd, clip)

def new_sampler(n: 'i64', seed: 'i64') -> "Sampler":
    return Sampler(n, seed)

def new_adamw_g(n: 'i64', groups: 'list[i64]', warmup: 'i64', total: 'i64',
                lr_max: 'f32', lr_min: 'f32',
                b1: 'f32', b2: 'f32', eps: 'f32', wd: 'f32', clip: 'f32') -> "AdamW":
    o = AdamW(n, warmup, total, lr_max, lr_min, b1, b2, eps, wd, clip)
    o.groups = groups
    return o

# ============================================================================
#  Model MLP tren vector tham so PHANG
# ============================================================================

def mlp_init(seed: 'i64') -> 'list[f32]':
    # khoi tao nho, tat dinh (LCG 31-bit, deu trong [-0.5, 0.5)) — dung cho
    # demo CLI; fixture G4 dung trong so do PyTorch sinh san.
    out = []
    s = seed % 2147483648
    for i in range(N_PARAM):
        s = (s * 1103515245 + 12345) % 2147483648
        out.append(float(s) / 2147483648.0 - 0.5)
    return out

def mlp_logits(p: 'list[f32]', x: 'list[f32]') -> 'list[f32]':
    # h = relu(W1 x + b1); z = W2 h + b2
    h = _zeros(HID)
    for o in range(HID):
        acc = p[B1_OFF + o]
        for i in range(IN_D):
            acc = acc + p[o * IN_D + i] * x[i]
        if acc < 0.0:
            acc = 0.0
        h[o] = acc
    z = _zeros(OUT_D)
    for o in range(OUT_D):
        acc = p[B2_OFF + o]
        for k in range(HID):
            acc = acc + p[W2_OFF + o * HID + k] * h[k]
        z[o] = acc
    return z

def mlp_loss(p: 'list[f32]', x: 'list[f32]', y: 'i64') -> 'f32':
    z = mlp_logits(p, x)
    mx = z[0]
    for o in range(1, OUT_D):
        if z[o] > mx:
            mx = z[o]
    s = 0.0
    for o in range(OUT_D):
        s = s + exp(z[o] - mx)
    lse = mx + log(s)
    return lse - z[y]

def mlp_loss_grad(p: 'list[f32]', x: 'list[f32]', y: 'i64',
                  gacc: 'list[f32]', scale: 'f32') -> 'f32':
    # forward (recompute — giong G2), CE mean tren OUT_D lop, roi backward
    hpre = _zeros(HID)
    h = _zeros(HID)
    for o in range(HID):
        acc = p[B1_OFF + o]
        for i in range(IN_D):
            acc = acc + p[o * IN_D + i] * x[i]
        hpre[o] = acc
        if acc > 0.0:
            h[o] = acc
    z = _zeros(OUT_D)
    for o in range(OUT_D):
        acc = p[B2_OFF + o]
        for k in range(HID):
            acc = acc + p[W2_OFF + o * HID + k] * h[k]
        z[o] = acc
    mx = z[0]
    for o in range(1, OUT_D):
        if z[o] > mx:
            mx = z[o]
    e = _zeros(OUT_D)
    s = 0.0
    for o in range(OUT_D):
        e[o] = exp(z[o] - mx)
        s = s + e[o]
    loss = mx + log(s) - z[y]
    dz = _zeros(OUT_D)
    for o in range(OUT_D):
        dz[o] = e[o] / s
    dz[y] = dz[y] - 1.0
    # LUU Y: cross_entropy mean cua PyTorch trung binh theo BATCH (1 mau),
    # KHONG chia cho so lop -> dz = softmax - onehot, khong chia OUT_D.
    # grad W2, b2
    for o in range(OUT_D):
        gacc[B2_OFF + o] = gacc[B2_OFF + o] + scale * dz[o]
        for k in range(HID):
            gacc[W2_OFF + o * HID + k] = gacc[W2_OFF + o * HID + k] + scale * dz[o] * h[k]
    # dh -> grad W1, b1 (ReLU mask theo hpre)
    for k in range(HID):
        acc = 0.0
        for o in range(OUT_D):
            acc = acc + dz[o] * p[W2_OFF + o * HID + k]
        if hpre[k] <= 0.0:
            acc = 0.0
        gacc[B1_OFF + k] = gacc[B1_OFF + k] + scale * acc
        for i in range(IN_D):
            gacc[k * IN_D + i] = gacc[k * IN_D + i] + scale * acc * x[i]
    return loss

def mlp_eval_loss(p: 'list[f32]', xs: 'list[f32]', ys: 'list[i64]', n_samples: 'i64') -> 'f32':
    tot = 0.0
    for s in range(n_samples):
        x = []
        for i in range(IN_D):
            x.append(xs[s * IN_D + i])
        tot = tot + mlp_loss(p, x, ys[s])
    return tot / float(n_samples)

def mlp_eval_acc(p: 'list[f32]', xs: 'list[f32]', ys: 'list[i64]', n_samples: 'i64') -> 'f32':
    ok = 0
    for s in range(n_samples):
        x = []
        for i in range(IN_D):
            x.append(xs[s * IN_D + i])
        z = mlp_logits(p, x)
        best = 0
        for o in range(1, OUT_D):
            if z[o] > z[best]:
                best = o
        if best == ys[s]:
            ok = ok + 1
    return float(ok) / float(n_samples)

# ============================================================================
#  Vong train: n_steps buoc, moi buoc accum mau, loss mean; tra loss tung buoc
# ============================================================================

def run_steps(opt: "AdamW", xs: 'list[f32]', ys: 'list[i64]',
              n_samples: 'i64', accum: 'i64', n_steps: 'i64',
              smp: "Sampler") -> 'list[f32]':
    losses = []
    scale = 1.0 / float(accum)
    for s in range(n_steps):
        opt.zero_grad()
        step_loss = 0.0
        j = 0
        while j < accum:
            idx = smp.next_idx()
            x = []
            for i in range(IN_D):
                x.append(xs[idx * IN_D + i])
            l = mlp_loss_grad(opt.p, x, ys[idx], opt.g, scale)
            step_loss = step_loss + l
            j = j + 1
        opt.step()
        losses.append(step_loss / float(accum))
    return losses

def ppl(loss: 'f32') -> 'f32':
    return exp(loss)

# ============================================================================
#  Checkpoint: text, so thuc ghi bang BIT f32 -> save/load bit-exact
# ============================================================================

def _bits_line(vals: 'list[f32]') -> 'str':
    parts = []
    for i in range(len(vals)):
        parts.append(str(f64_to_f32_bits(float(vals[i]))))
    return " ".join(parts)

def _ints_line(vals: 'list[i64]') -> 'str':
    parts = []
    for i in range(len(vals)):
        parts.append(str(vals[i]))
    return " ".join(parts)

def _mk_file(dir: 'str', name: 'str') -> 'str':
    return dir + "/" + name

def ckpt_save(path: 'str', opt: "AdamW", smp: "Sampler") -> 'i32':
    # M5-opt: m/v LAZY — sync_mv() cap phat list (neu chua co) + doc tu buffer
    rs1 = opt.sync_mv()
    lines = []
    lines.append("# TVTRAIN1")
    lines.append("n=" + str(opt.n) + " t=" + str(opt.t)
                 + " warmup=" + str(opt.warmup) + " total=" + str(opt.total))
    lines.append("lr_max=" + str(opt.lr_max) + " lr_min=" + str(opt.lr_min)
                 + " b1=" + str(opt.b1) + " b2=" + str(opt.b2)
                 + " eps=" + str(opt.eps) + " wd=" + str(opt.wd)
                 + " clip=" + str(opt.clip))
    lines.append("draws=" + str(smp.draws) + " state=" + str(smp.state))
    lines.append("#sec perm")
    lines.append(_ints_line(smp.perm))
    lines.append("#sec p")
    lines.append(_bits_line(opt.p))
    lines.append("#sec m")
    lines.append(_bits_line(opt.m))
    lines.append("#sec v")
    lines.append(_bits_line(opt.v))
    _w = path_write_text(path, "\n".join(lines) + "\n")
    return 1

def _line_kv(line: 'str', key: 'str') -> 'str':
    parts = line.split(" ")
    for i in range(len(parts)):
        kv = parts[i].split("=")
        if len(kv) == 2:
            if kv[0] == key:
                return kv[1]
    return ""

def _floats_of(ln: 'str') -> 'list[f32]':
    out = []
    toks = ln.split(" ")
    for i in range(len(toks)):
        if len(toks[i]) > 0:
            out.append((float(toks[i]) - 0.0) / 1.0)
    return out

def _bits_of(ln: 'str') -> 'list[f32]':
    out = []
    toks = ln.split(" ")
    for i in range(len(toks)):
        if len(toks[i]) > 0:
            out.append((f32_bits_to_f64(_i64tok(toks[i])) - 0.0) / 1.0)
    return out

def _i64tok(t: 'str') -> 'i64':
    v = 0
    neg = 0
    start = 0
    if len(t) > 0 and t[0] == "-":
        neg = 1
        start = 1
    for i in range(start, len(t)):
        v = v * 10 + (ord(t[i]) - 48)
    if neg == 1:
        return 0 - v
    return v

def _ints_of(ln: 'str') -> 'list[i64]':
    out = []
    toks = ln.split(" ")
    for i in range(len(toks)):
        if len(toks[i]) > 0:
            out.append(_i64tok(toks[i]))
    return out

def _sec_after(lines: 'list[str]', name: 'str') -> 'str':
    on = 0
    for i in range(len(lines)):
        ln = lines[i]
        if len(ln) >= 5 and ln[0:5] == "#sec ":
            if ln[5:] == name:
                on = 1
            else:
                on = 0
        elif on == 1:
            return ln
    return ""

def ckpt_load(path: 'str', opt: "AdamW", smp: "Sampler") -> 'i32':
    txt = path_read_text(path)
    lines = txt.split("\n")
    if len(lines) < 5:
        return 0
    hdr = lines[1]
    t2 = lines[2]
    t3 = lines[3]
    opt.n = _i64tok(_line_kv(hdr, "n"))
    opt.t = _i64tok(_line_kv(hdr, "t"))
    opt.warmup = _i64tok(_line_kv(hdr, "warmup"))
    opt.total = _i64tok(_line_kv(hdr, "total"))
    opt.lr_max = float(_line_kv(t2, "lr_max"))
    opt.lr_min = float(_line_kv(t2, "lr_min"))
    opt.b1 = float(_line_kv(t2, "b1"))
    opt.b2 = float(_line_kv(t2, "b2"))
    opt.eps = float(_line_kv(t2, "eps"))
    opt.wd = float(_line_kv(t2, "wd"))
    opt.clip = float(_line_kv(t2, "clip"))
    smp.draws = _i64tok(_line_kv(t3, "draws"))
    smp.state = _i64tok(_line_kv(t3, "state"))
    smp.perm = _ints_of(_sec_after(lines, "perm"))
    opt.p = _bits_of(_sec_after(lines, "p"))
    opt.m = _bits_of(_sec_after(lines, "m"))
    opt.v = _bits_of(_sec_after(lines, "v"))
    if len(opt.p) != opt.n or len(opt.m) != opt.n or len(opt.v) != opt.n:
        return 0
    # M5: day lai p/m/v vao buffer native (copy bit-exact List[Single] -> buf)
    pll = opt.p
    mll = opt.m
    vll = opt.v
    ppl = opt.pp
    pml = opt.pm
    pvl = opt.pv
    rs3 = f32_copy_to_buf(pll, ppl, opt.n)
    rs4 = f32_copy_to_buf(mll, pml, opt.n)
    rs5 = f32_copy_to_buf(vll, pvl, opt.n)
    return 1
