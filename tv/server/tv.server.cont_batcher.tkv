# TokenVector Module: Server — Continuous batcher for LLM decoding
# Slot-based iteration scheduling (llama.cpp parallel-slots semantics at the # .tkv level): waiting -> running admission controlled by PagedKVPool capacity,
# each step advances every running sequence by one token (prefill once, then # decode), finished/evicted sequences free their pages. One forward per active
# sequence per step, executed over the DynamicBatcher session pool.

import tv.runtime.session
import tv.runtime.paged_kv
import tv.runtime.kv_cache
import tv.server.batcher
import tv.text.sampling
import tv.numerics.tensor

class GenRequest:
    _ok: "i64"
    prompt: "list[i64]"
    max_tokens: "i64"
    tokens: "list[i64]"
    done: "i32"
    error: "str"
    cache: "inferred"
    paged: "inferred"
    seq_id: "i64"
    def __init__(self, max_tokens: "i64", done: "i32", error: "str", cache: "AttentionKvCache", paged: "PagedSequence", seq_id: "i64"):
        self.max_tokens = max_tokens
        self.done = done
        self.error = error
        self.cache = cache
        self.paged = paged
        self.seq_id = seq_id

def _new_gen_request(prompt: "list[i64]", max_tokens: "i64", max_seq: "i64", hidden_dim: "i64") -> "GenRequest":
    _c = create_kv_cache(max_seq, hidden_dim)
    _p = PagedSequence(1, -1, 0)
    req = GenRequest(1, max_tokens, 0, "", _c, _p, -1)
    req.prompt = prompt
    _toks = []
    for _t in prompt:
        _toks.append(_t)
    req.tokens = _toks
    return req

class ContBatcher:
    _ok: "i64"
    session: "inferred"
    hidden_dim: "i64"
    max_seq: "i64"
    max_running: "i64"
    batcher: "inferred"
    pool: "inferred"
    waiting: "list[GenRequest]"
    running: "list[GenRequest]"
    next_seq: "i64"
    params: "inferred"
    _closed: "i32"
    def __init__(self, session: "InferenceSession", hidden_dim: "i64", max_seq: "i64" = 2048, max_running: "i64" = 4, pool_pages: "i64" = 256, page_len: "i64" = 16, workers: "i64" = 4):
        self.session = session
        self.hidden_dim = hidden_dim
        self.max_seq = max_seq
        self.max_running = max(1, max_running)
        _mr = self.max_running
        _wk = workers
        if _wk < 1:
            _wk = 1
        _db = DynamicBatcher(1, _mr, 200, 10000)
        _pl = _db.pool
        _pl.append(session)
        self.batcher = _db
        self.pool = PagedKVPool(1, pool_pages, page_len, hidden_dim)
        self.next_seq = 1
        self.params = default_sample_params()
        self._closed = 0

    def submit(self, prompt: "list[i64]", max_tokens: "i64" = 128) -> "GenRequest":
        req = _new_gen_request(prompt, max_tokens, self.max_seq, self.hidden_dim)
        _ah46_8 = self.waiting
        _ah46_8.append(req)
        return req

    # advance the world by one decode step; call in a driver loop or via spawn
    def step(self) -> 'i32':
        self._admit()
        finished = []
        for req in self.running:
            try:
                self._decode_one(req)
                if len(req.tokens) - len(req.prompt) >= req.max_tokens:
                    req.done = 1
                    finished.append(req)
            except Exception as e:
                req.error = "decode failed"
                req.done = 1
                finished.append(req)
        for req in finished:
            _ah64_12 = self.running
            _r2 = []
            for _x in _ah64_12:
                if _x.seq_id != req.seq_id:
                    _r2.append(_x)
            self.running = _r2
            _ah65_12 = self.pool
            _ah65_12.release_seq(req.seq_id)
        return 0

    def _admit(self) -> 'i32':
        while len(self.running) < self.max_running and len(self.waiting) > 0:
            req = self.waiting[0]
            _ah70_59 = self.pool
            _ah70_86 = self.pool
            need_pages = (len(req.prompt) + self.max_seq + _ah70_59.page_len - 1) // _ah70_86.page_len
            _ah71_15 = self.pool
            if _ah71_15.free_count() < need_pages:
                # try LRU eviction of a running victim to make room
                _ah73_33 = self.pool
                _packed = _ah73_33.evict_lru(-1)
                victim = _packed >> 32
                if victim < 0:
                    break
                self._evict_seq(victim)
                continue
            _ah78_12 = self.waiting
            _ah78_12.pop(0)
            req.seq_id = self.next_seq
            self.next_seq = self.next_seq + 1
            req.cache = create_kv_cache(self.max_seq, self.hidden_dim)
            req.paged = PagedSequence(1, req.seq_id, 0)
            _ah83_12 = req.paged
            _ah83_12.ensure_capacity(self.pool, len(req.prompt) + req.max_tokens)
            _ah84_12 = self.running
            _ah84_12.append(req)
        return 0

    def _evict_seq(self, seq_id: "i64") -> 'i32':
        for req in self.running:
            if req.seq_id == seq_id and not req.done:
                req.error = "evicted: KV pool exhausted"
                req.done = 1
                _ah92_16 = self.pool
                _ah92_16.release_seq(seq_id)
                _r2 = []
                for _x in self.running:
                    if _x.seq_id != seq_id:
                        _r2.append(_x)
                self.running = _r2
                break
        return 0

    def _decode_one(self, req: "GenRequest") -> 'i32':
        # single-token step: embed last token, run graph, sample, append to cache + pages
        last = req.tokens[len(req.tokens) - 1]
        emb = _one_hot(last, self.hidden_dim)
        out = self.batcher.enqueue(emb)
        nxt = sample_token(out, self.params, req.tokens)
        _ah102_8 = req.tokens
        _ah102_8.append(nxt)
        krow = out
        vrow = out
        _ah105_8 = req.cache
        _appr = _ah105_8.append(krow, vrow)
        _ah106_16 = req.cache
        total = _ah106_16.length
        _ah107_8 = req.paged
        _ah107_8.ensure_capacity(self.pool, len(req.prompt) + total)
        _pg = _ah107_8.pages
        for p in _pg:
            _ah109_12 = self.pool
            _ah109_12.touch(p)
        return 0

    def pending(self) -> "i64":
        return len(self.waiting) + len(self.running)

    def dispose(self) -> 'i32':
        self._closed = 1
        _ah116_8 = self.batcher
        _ah116_8.dispose()
        return 0

def _one_hot(tok: "i64", dim: "i64") -> "list[f32]":
    v = _nd_f32(dim)
    for i in range(dim):
        v[i] = 0.0
    if tok >= 0 and tok < dim:
        v[tok] = 1.0
    return v


def _tv_server_cont_batcher_probe() -> "i32":
    return 0
