# TokenVector Module: Runtime — Append-only KV-cache for autoregressive decoding
# Pre-allocates once (construction time); Append copies rows with no hot-path allocation.
# Caller feeds cache contents back as the Attention node's K/V inputs each decode step.


import tv.runtime.session
import tv.numerics.tensor


class Full(Exception):
    msg: "str"


class AttentionKvCache:
    _ok: "i64"
    max_seq: 'i64'
    hidden_dim: 'i64'
    length: 'i64'
    _kbuf: 'list[f32]'
    _vbuf: 'list[f32]'
    def __init__(self, max_seq: "i64", hidden_dim: "i64"):
        if max_seq <= 0:
            raise Arg("max_seq must be > 0")
        if hidden_dim <= 0:
            raise Arg("hidden_dim must be > 0")
        self.max_seq = max_seq
        self.hidden_dim = hidden_dim
        self.length = 0
        self._kbuf = _nd_f32(max_seq * hidden_dim)
        self._vbuf = _nd_f32(max_seq * hidden_dim)
        for i in range(max_seq * hidden_dim):
            self._kbuf[i] = 0.0
            self._vbuf[i] = 0.0

    def append(self, k_row: "list[f32]", v_row: "list[f32]") -> 'i32':
        if len(k_row) != self.hidden_dim:
            raise Arg("k_row length " + str(len(k_row)) + " != hidden_dim " + str(self.hidden_dim) + "")
        if len(v_row) != self.hidden_dim:
            raise Arg("v_row length " + str(len(v_row)) + " != hidden_dim " + str(self.hidden_dim) + "")
        if self.length >= self.max_seq:
            raise Full("KV-cache full (" + str(self.max_seq) + " tokens). Call reset() or grow max_seq.")
        base = self.length * self.hidden_dim
        for d in range(self.hidden_dim):
            self._kbuf[base + d] = k_row[d]
            self._vbuf[base + d] = v_row[d]
        self.length = self.length + 1
        return 0

    # Zero-copy window views over cached prefix [0, length)
    def get_k(self) -> "list[f32]":
        return self._kbuf[0:self.length * self.hidden_dim]

    def get_v(self) -> "list[f32]":
        return self._vbuf[0:self.length * self.hidden_dim]

    def reset(self) -> 'i32':
        self.length = 0
        return 0


def create_kv_cache(max_seq: 'i64', hidden_dim: 'i64') -> 'AttentionKvCache':
    if max_seq <= 0:
        raise Arg("max_seq must be > 0")
    if hidden_dim <= 0:
        raise Arg("hidden_dim must be > 0")
    c = AttentionKvCache(1, max_seq, hidden_dim, 0)
    c._kbuf = _nd_f32(max_seq * hidden_dim)
    c._vbuf = _nd_f32(max_seq * hidden_dim)
    for i in range(max_seq * hidden_dim):
        c._kbuf[i] = 0.0
        c._vbuf[i] = 0.0
    return c
