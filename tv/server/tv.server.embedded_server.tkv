# TokenVector Module: Server — Embedded micro-server, OpenAI-compatible
# Endpoints: /health, /metrics (Prometheus), /predict (legacy),
#   /v1/models, /v1/embeddings, /v1/completions + /v1/chat/completions (JSON + SSE).
# Guards: optional API key, per-IP token-bucket rate limit, max body size.

import tv.runtime.session
import tv.server.batcher
import tv.text.tokenizer
import tv.text.sampling
import tv.text.chat_template
import tv.text.generate
import tv.numerics.tensor


class HttpRequest:
    _ok: "i64"
    method: "str"
    path: "str"
    body: "str"
    def __init__(self, method: "str", path: "str", body: "str"):
        self.method = method
        self.path = path
        self.body = body
    def header(self, name: "str") -> "str":
        return ""
    def remote_ip(self) -> "str":
        return "127.0.0.1"


class HttpResponse:
    _ok: "i64"
    status: "i64"
    body: "str"
    content_type: "str"
    def __init__(self, status: "i64", body: "str", content_type: "str"):
        self.status = status
        self.body = body
        self.content_type = content_type


def http_listen(port: "i64") -> "i32":
    return 0


def http_close(port: "i64") -> "i32":
    return 0


def _srv_now_us() -> "i64":
    return 0


def _es_find_from(s: 'str', sub: 'str', start: 'i64') -> 'i64':
    tail = s[start:]
    r = tail.find(sub)
    if r < 0:
        return -1
    return start + r


def _es_skip_spaces(s: 'str', at: 'i64') -> 'i64':
    while at < len(s) and s[at:at + 1] == " ":
        at = at + 1
    return at


def _es_quoted_at(s: 'str', at: 'i64') -> 'str':
    out = ""
    i = at + 1
    while i < len(s):
        c = s[i:i + 1]
        if c == "\"":
            return out
        if c == "\\":
            i = i + 1
            if i < len(s):
                out = out + s[i:i + 1]
                i = i + 1
                continue
            return out
        out = out + c
        i = i + 1
    return out


def _es_raw_value_at(s: 'str', at: 'i64') -> 'str':
    at = _es_skip_spaces(s, at)
    if at >= len(s):
        return ""
    first = s[at:at + 1]
    if first == "\"":
        v = _es_quoted_at(s, at)
        return "\"" + v + "\""
    if first == "[" or first == "{":
        depth = 0
        i = at
        instr = 0
        while i < len(s):
            c = s[i:i + 1]
            if instr == 1:
                if c == "\\":
                    i = i + 2
                    continue
                if c == "\"":
                    instr = 0
            else:
                if c == "\"":
                    instr = 1
                elif c == "[" or c == "{":
                    depth = depth + 1
                elif c == "]" or c == "}":
                    depth = depth - 1
                    if depth == 0:
                        return s[at:i + 1]
            i = i + 1
        return s[at:]
    i = at
    while i < len(s):
        c = s[i:i + 1]
        if c == "," or c == "}" or c == "]":
            break
        i = i + 1
    return s[at:i].strip()


def json_field(body: 'str', name: 'str') -> 'str':
    key = "\"" + name + "\""
    pos = body.find(key)
    if pos < 0:
        return ""
    tail = body[pos + len(key):]
    ci = tail.find(":")
    if ci < 0:
        return ""
    return _es_raw_value_at(body, pos + len(key) + ci + 1)


def json_string_field(body: 'str', name: 'str', default: 'str') -> 'str':
    raw = json_field(body, name)
    if len(raw) < 2:
        return default
    if raw[0:1] != "\"":
        return default
    return _es_quoted_at(raw, 0)


def _es_parse_num_at(s: 'str', at: 'i64') -> 'f32':
    _digits = "0123456789.+-eE"
    j = at
    while j < len(s):
        c = s[j:j + 1]
        if c in _digits:
            j = j + 1
        else:
            break
    if j <= at:
        return 0.0
    return float(s[at:j])


def json_float_field(body: 'str', name: 'str', default: 'f32') -> 'f32':
    key = "\"" + name + "\""
    pos = body.find(key)
    if pos < 0:
        return default
    tail = body[pos + len(key):]
    ci = tail.find(":")
    if ci < 0:
        return default
    at = _es_skip_spaces(body, pos + len(key) + ci + 1)
    if body[at:at + 1] == "\"":
        return default
    return _es_parse_num_at(body, at)


def json_int_field(body: 'str', name: 'str', default: 'i64') -> 'i64':
    return int(json_float_field(body, name, float(default)))


def json_bool(body: 'str', name: 'str', default: 'i32') -> 'i32':
    raw = json_field(body, name)
    if raw == "true" or raw == "1":
        return 1
    if raw == "false" or raw == "0":
        return 0
    return default


def json_to_float_array(s: 'str') -> 'list[f32]':
    out = []
    out.append(0.0)
    out.pop()
    t = s.strip()
    if len(t) < 2:
        return out
    if t[0:1] != "[":
        return out
    inner = t[1:len(t) - 1]
    parts = inner.split(",")
    for p in parts:
        q = p.strip()
        if len(q) > 0:
            out.append(float(q))
    return out


def json_parse_float_array(body: 'str') -> 'list[f32]':
    out = []
    out.append(0.0)
    out.pop()
    start = body.find("[")
    if start < 0:
        return out
    depth = 0
    i = start
    instr = 0
    while i < len(body):
        c = body[i:i + 1]
        if instr == 1:
            if c == "\\":
                i = i + 2
                continue
            if c == "\"":
                instr = 0
        else:
            if c == "\"":
                instr = 1
            elif c == "[":
                depth = depth + 1
            elif c == "]":
                depth = depth - 1
                if depth == 0:
                    return json_to_float_array(body[start:i + 1])
        i = i + 1
    return out


def json_stringify_float_array(arr: 'list[f32]') -> 'str':
    out = "["
    for i in range(len(arr)):
        if i > 0:
            out = out + ","
        out = out + str(arr[i])
    return out + "]"


def json_quote(s: 'str') -> 'str':
    out = "\""
    for i in range(len(s)):
        c = s[i:i + 1]
        if c == "\"" or c == "\\":
            out = out + "\\"
        out = out + c
    return out + "\""


def json_chat_messages(body: 'str') -> 'list[str]':
    flat = []
    flat.append("")
    flat.pop()
    raw = json_field(body, "messages")
    pos = 0
    while pos < len(raw):
        rp = _es_find_from(raw, "\"role\"", pos)
        if rp < 0:
            return flat
        rtail = raw[rp + 6:]
        rci = rtail.find(":")
        if rci < 0:
            return flat
        rat = _es_skip_spaces(raw, rp + 6 + rci + 1)
        role = _es_quoted_at(raw, rat)
        ctail = raw[rat + len(role) + 2:]
        cp = ctail.find("\"content\"")
        if cp < 0:
            return flat
        cbase = rat + len(role) + 2 + cp + 9
        cci = raw[cbase:].find(":")
        if cci < 0:
            return flat
        cat = _es_skip_spaces(raw, cbase + cci + 1)
        content = _es_quoted_at(raw, cat)
        flat.append(role)
        flat.append(content)
        pos = cat + len(content) + 2
    return flat


def _es_str_array_text(s: 'str') -> 'list[str]':
    out = []
    out.append("")
    out.pop()
    t = s.strip()
    if len(t) < 2:
        return out
    if t[0:1] != "[":
        return out
    i = 1
    while i < len(t):
        c = t[i:i + 1]
        if c == "]":
            return out
        if c == "\"":
            v = _es_quoted_at(t, i)
            out.append(v)
            i = i + len(v) + 2
            continue
        i = i + 1
    return out


def json_str_list_field(body: 'str', name: 'str') -> 'list[str]':
    return _es_str_array_text(json_field(body, name))


def json_str_array_field(body: 'str', name: 'str') -> 'list[str]':
    return _es_str_array_text(json_field(body, name))


def json_is_str_array(body: 'str', name: 'str') -> 'i32':
    raw = json_field(body, name).strip()
    if len(raw) < 2:
        return 0
    if raw[0:1] != "[":
        return 0
    if raw.find("\"") < 0:
        return 0
    return 1


def json_nested_array_field(body: 'str', name: 'str') -> 'list[str]':
    out = []
    out.append("")
    out.pop()
    raw = json_field(body, name).strip()
    if len(raw) < 2:
        return out
    if raw[0:1] != "[":
        return out
    depth = 0
    cur = ""
    instr = 0
    i = 1
    while i < len(raw):
        c = raw[i:i + 1]
        if instr == 1:
            cur = cur + c
            if c == "\\":
                i = i + 1
                if i < len(raw):
                    cur = cur + raw[i:i + 1]
            elif c == "\"":
                instr = 0
        else:
            if c == "\"":
                instr = 1
                cur = cur + c
            elif c == "[" or c == "{":
                depth = depth + 1
                cur = cur + c
            elif c == "]" or c == "}":
                if depth == 0:
                    if len(cur.strip()) > 0:
                        out.append(cur.strip())
                    return out
                depth = depth - 1
                cur = cur + c
            elif c == "," and depth == 0:
                if len(cur.strip()) > 0:
                    out.append(cur.strip())
                cur = ""
            else:
                cur = cur + c
        i = i + 1
    return out


def json_messages_to_float_array(msgs: 'str') -> 'list[f32]':
    _digits = "0123456789.+-eE"
    out = []
    out.append(0.0)
    out.pop()
    i = 0
    while i < len(msgs):
        c = msgs[i:i + 1]
        if c in _digits:
            j = i + 1
            while j < len(msgs):
                d = msgs[j:j + 1]
                if d in _digits:
                    j = j + 1
                else:
                    break
            out.append(float(msgs[i:j]))
            i = j
            continue
        i = i + 1
    return out


class ServerOptions:
    _ok: "i64"
    api_key: "str"
    rate_limit_rps: "i64"
    max_body_bytes: "i64"
    model_id: "str"
    tokenizer_kind: "str"
    tokenizer_vocab: "str"
    tokenizer_merges: "str"
    chat_format: "str"
    eos_token: "i64"
    max_new_tokens: "i64"
    def __init__(self):
        self.api_key = ""
        self.rate_limit_rps = 200
        self.max_body_bytes = 1048576
        self.model_id = "tokenvector"
        self.tokenizer_kind = ""
        self.tokenizer_vocab = ""
        self.tokenizer_merges = ""
        self.chat_format = "chatml"
        self.eos_token = -1
        self.max_new_tokens = 128


def default_server_options() -> 'ServerOptions':
    return ServerOptions(1, "", 200, 1048576, "tokenvector", "", "", "", "chatml", -1, 128)


# 2026-09-25: factory khoi tao EmbeddedServer.
# '.ctor' cua record nhan DUNG 1 tham so cho MOI field (khong container),
# theo THU TU FIELD - nen goi thang 'EmbeddedServer(session, port, opts)'
# (theo thu tu tham so cua __init__) se khong bien dich duoc. Day la
# wrapper giong het default_server_options() o tren, va NOI la noi giu phan
# 'khoi tao' ma __init__ (tao DynamicBatcher, append session vao pool,
# http_listen) - vi __init__ bi bo qua luc bien dich.
def new_embedded_server(session: 'InferenceSession', port: 'i64',
                        opts: 'ServerOptions') -> 'EmbeddedServer':
    _db = new_dynamic_batcher(1, 32, 200, 10000)
    _pl = _db.pool
    _pl.append(session)
    _srv = EmbeddedServer(1, session, _db, port, opts, 0, 0, 0, 0, _db, 0, 0)
    http_listen(port)
    return _srv


class TokenBucket:
    _ok: "i64"
    rps: "i64"
    tokens: "f32"
    last_us: "i64"
    def __init__(self, rps: "i64"):
        self.rps = rps
        self.tokens = 0.0
        self.last_us = 0
    def allow(self) -> 'i32':
        t = _srv_now_us()
        dt = float(t - self.last_us) / 1000000.0
        self.last_us = t
        self.tokens = min(float(self.rps), self.tokens + dt * self.rps)
        if self.tokens >= 1.0:
            self.tokens = self.tokens - 1.0
            return 1
        return 0


class EmbeddedServer:
    _ok: "i64"
    session: "inferred"
    batcher: "inferred"
    port: "i64"
    opts: "ServerOptions"
    total_requests: "i64"
    total_lat_us: "i64"
    errors_total: "i64"
    dropped_total: "i64"
    buckets: "dict[str,TokenBucket]"
    _tok: "inferred"
    has_tok: "i32"
    _closed: "i32"
    def __init__(self, session: "InferenceSession", port: "i64", opts: "ServerOptions"):
        self.session = session
        _db = DynamicBatcher(1, 32, 200, 10000)
        _pl = _db.pool
        _pl.append(session)
        self.batcher = _db
        self.port = port
        self.opts = opts
        self.total_requests = 0
        self.total_lat_us = 0
        self.errors_total = 0
        self.dropped_total = 0
        self.has_tok = 0
        self._closed = 0
        http_listen(port)

    def _tokenizer(self) -> 'Tokenizer':
        if self.has_tok:
            return self._tok
        _o = self.opts
        if _o.tokenizer_kind == "bpe" and _o.tokenizer_vocab != "":
            _bt = BPETokenizer(1, 0)
            self._tok = _bt
            self.has_tok = 1
            return self._tok
        if _o.tokenizer_kind == "wordpiece" and _o.tokenizer_vocab != "":
            _wt = WordPieceTokenizer(1, _o.tokenizer_vocab, 0, "[UNK]")
            self._tok = _wt
            self.has_tok = 1
            return self._tok
        return self._tok

    def _check_auth(self, req: 'HttpRequest') -> 'i32':
        _o = self.opts
        if _o.api_key == "":
            return 1
        if req.header("x-api-key") == _o.api_key:
            return 1
        auth = req.header("authorization")
        return auth == "Bearer " + _o.api_key

    def _check_rate(self, req: 'HttpRequest') -> 'i32':
        _o = self.opts
        if _o.rate_limit_rps <= 0:
            return 1
        ip = req.remote_ip()
        _bk = self.buckets
        if ip not in _bk:
            _bk[ip] = TokenBucket(1, _o.rate_limit_rps, 0.0, 0)
        _tb = _bk[ip]
        return _tb.allow()

    def _on_request(self, req: 'HttpRequest') -> 'HttpResponse':
        t0 = _srv_now_us()
        self.total_requests = self.total_requests + 1
        try:
            if req.method == "GET" and req.path == "/":
                return HttpResponse(1, 200, _web_ui(), "text/html")
            if req.method == "GET" and req.path == "/health":
                return HttpResponse(1, 200, "{\"status\":\"healthy\",\"engine\":\"TokenVector.Inference\"}", "application/json")
            if req.method == "GET" and req.path == "/metrics":
                return HttpResponse(1, 200, self._prometheus(), "text/plain")
            if not self._check_auth(req):
                return HttpResponse(1, 401, "{\"error\":\"unauthorized\"}", "application/json")
            if not self._check_rate(req):
                self.dropped_total = self.dropped_total + 1
                return HttpResponse(1, 429, "{\"error\":\"rate limit exceeded\"}", "application/json")
            _o = self.opts
            if len(req.body) > _o.max_body_bytes:
                return HttpResponse(1, 413, "{\"error\":\"payload too large\"}", "application/json")
            if req.method == "GET" and req.path == "/v1/models":
                _mid = _o.model_id
                body = "{\"object\":\"list\",\"data\":[{\"id\":\"" + _mid + "\",\"object\":\"model\"}]}"
                return HttpResponse(1, 200, body, "application/json")
            if req.method == "POST" and req.path == "/predict":
                return self._predict(req)
            if req.method == "POST" and req.path == "/v1/embeddings":
                return self._embeddings(req)
            if req.method == "POST" and (req.path == "/v1/completions" or req.path == "/v1/chat/completions"):
                return self._completions(req)
            if req.method == "POST" and req.path == "/v1/rerank":
                return self._rerank(req)
            return HttpResponse(1, 404, "{\"error\":\"not found\"}", "application/json")
        except Exception as e:
            self.errors_total = self.errors_total + 1
            return HttpResponse(1, 500, "{\"error\":\"internal error\"}", "application/json")
        self.total_lat_us = self.total_lat_us + (_srv_now_us() - t0)
        return HttpResponse(1, 500, "{\"error\":\"unreachable\"}", "application/json")

    def _predict(self, req: 'HttpRequest') -> 'HttpResponse':
        arr = json_parse_float_array(req.body)
        if len(arr) == 0:
            return HttpResponse(1, 400, "{\"error\":\"empty input\"}", "application/json")
        out = self._infer(arr)
        return HttpResponse(1, 200, json_stringify_float_array(out), "application/json")

    def _embeddings(self, req: 'HttpRequest') -> 'HttpResponse':
        inp = json_field(req.body, "input")
        arr = json_to_float_array(inp)
        if len(arr) == 0:
            return HttpResponse(1, 400, "{\"error\":\"input must be a numeric array\"}", "application/json")
        out = self._infer(arr)
        _o = self.opts
        _mid = _o.model_id
        body = "{\"object\":\"list\",\"model\":\"" + _mid + "\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":" + json_stringify_float_array(out) + "}]}"
        return HttpResponse(1, 200, body, "application/json")

    def _completions(self, req: 'HttpRequest') -> 'HttpResponse':
        text_in = self._completion_text(req.body, req.path)
        _tok = self._tokenizer()
        if text_in != "" and self.has_tok:
            return self._generate(req, text_in)
        arr = self._completion_input(req.body)
        if len(arr) == 0:
            return HttpResponse(1, 400, "{\"error\":\"no text prompt (tokenizer not configured?) and no numeric input found\"}", "application/json")
        out = self._infer(arr)
        if json_bool(req.body, "stream", 0):
            return self._stream_chunks(out)
        _o = self.opts
        _mid = _o.model_id
        _rid = str(self.total_requests)
        if req.path == "/v1/chat/completions":
            body = "{\"id\":\"tv-" + _rid + "\",\"object\":\"chat.completion\",\"model\":\"" + _mid + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":" + json_quote(json_stringify_float_array(out)) + "},\"finish_reason\":\"stop\"}]}"
        else:
            body = "{\"id\":\"tv-" + _rid + "\",\"object\":\"text_completion\",\"model\":\"" + _mid + "\",\"choices\":[{\"index\":0,\"text\":" + json_quote(json_stringify_float_array(out)) + ",\"finish_reason\":\"stop\"}]}"
        return HttpResponse(1, 200, body, "application/json")

    def _completion_text(self, body: 'str', path: 'str') -> 'str':
        if path == "/v1/chat/completions":
            flat = json_chat_messages(body)
            if len(flat) >= 2:
                msgs = []
                msgs.append(ChatMessage(1, "", ""))
                msgs.pop()
                i = 0
                while i + 1 < len(flat):
                    msgs.append(ChatMessage(1, flat[i], flat[i + 1]))
                    i = i + 2
                _o = self.opts
                return apply_template(msgs, _o.chat_format)
            return ""
        s = json_string_field(body, "prompt", "")
        if s != "":
            return s
        return ""

    def _gen_config(self, body: 'str') -> 'GenConfig':
        _o = self.opts
        _mnt = json_int_field(body, "max_tokens", _o.max_new_tokens)
        if _mnt < 1:
            _mnt = 1
        _sp = default_sample_params()
        _sp.temperature = json_float_field(body, "temperature", 1.0)
        _sp.top_k = json_int_field(body, "top_k", 0)
        _sp.top_p = json_float_field(body, "top_p", 1.0)
        _sp.seed = json_int_field(body, "seed", 42)
        cfg = GenConfig(1, _mnt, _o.eos_token, _o.chat_format, _sp)
        stops = json_str_list_field(body, "stop")
        if len(stops) > 0:
            cfg.stop_strings = stops
        return cfg

    def _generate(self, req: 'HttpRequest', prompt_text: 'str') -> 'HttpResponse':
        cfg = self._gen_config(req.body)
        res = generate_text(self.session, self._tokenizer(), prompt_text, cfg)
        usage = "\"usage\":{\"prompt_tokens\":" + str(res.prompt_tokens) + ",\"completion_tokens\":" + str(res.completion_tokens) + ",\"total_tokens\":" + str(res.prompt_tokens + res.completion_tokens) + "}"
        if json_bool(req.body, "stream", 0):
            return self._stream_text(res.text, usage)
        content = json_quote(res.text)
        _rid = str(self.total_requests)
        _o = self.opts
        _mid = _o.model_id
        if req.path == "/v1/chat/completions":
            body = "{\"id\":\"tv-" + _rid + "\",\"object\":\"chat.completion\",\"model\":\"" + _mid + "\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":" + content + "},\"finish_reason\":\"stop\"}]," + usage + "}"
        else:
            body = "{\"id\":\"tv-" + _rid + "\",\"object\":\"text_completion\",\"model\":\"" + _mid + "\",\"choices\":[{\"index\":0,\"text\":" + content + ",\"finish_reason\":\"stop\"}]," + usage + "}"
        return HttpResponse(1, 200, body, "application/json")

    def _stream_text(self, text: 'str', usage: 'str') -> 'HttpResponse':
        chunks = []
        chunks.append("")
        chunks.pop()
        step = 16
        i = 0
        _rid = str(self.total_requests)
        _o = self.opts
        _mid = _o.model_id
        while i < len(text):
            _end = i + step
            if _end > len(text):
                _end = len(text)
            piece = text[i:_end]
            payload = "{\"id\":\"tv-" + _rid + "\",\"object\":\"chat.completion.chunk\",\"model\":\"" + _mid + "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":" + json_quote(piece) + "},\"finish_reason\":null}]}"
            chunks.append("data: " + payload + "\n\n")
            i = i + step
        chunks.append("data: [DONE]\n\n")
        sep = ""
        return HttpResponse(1, 200, sep.join(chunks), "text/event-stream")

    def _completion_input(self, body: 'str') -> 'list[f32]':
        fields = []
        fields.append("input")
        fields.append("prompt")
        for field in fields:
            v = json_field(body, field)
            arr = json_to_float_array(v)
            if len(arr) > 0:
                return arr
        msgs = json_field(body, "messages")
        return json_messages_to_float_array(msgs)

    def _rerank(self, req: 'HttpRequest') -> 'HttpResponse':
        _sidx = []
        _sidx.append(0)
        _sidx.pop()
        _sval = []
        _sval.append(0.0)
        _sval.pop()
        top_n = json_int_field(req.body, "top_n", 0)
        _tok = self._tokenizer()
        if self.has_tok and json_is_str_array(req.body, "documents"):
            docs = json_str_array_field(req.body, "documents")
            if len(docs) == 0:
                return HttpResponse(1, 400, "{\"error\":\"documents must be a non-empty array\"}", "application/json")
            q = json_string_field(req.body, "query", "")
            for i in range(len(docs)):
                pair = _tok.encode(q + " " + docs[i])
                _sidx.append(i)
                _sval.append(self._score_ids(pair))
        else:
            raws = json_nested_array_field(req.body, "documents")
            if len(raws) == 0:
                return HttpResponse(1, 400, "{\"error\":\"documents must be a non-empty array\"}", "application/json")
            q = json_to_float_array(json_field(req.body, "query"))
            for i in range(len(raws)):
                d = json_to_float_array(raws[i])
                _sidx.append(i)
                _sval.append(self._score_vec(q, d))
        order = []
        order.append(0)
        order.pop()
        used = {}
        for _ in range(len(_sidx)):
            best = -1
            for k in range(len(_sidx)):
                if k not in used and (best < 0 or _sval[k] > _sval[best]):
                    best = k
            used[best] = 1
            order.append(best)
        if top_n > 0:
            n = min(top_n, len(order))
        else:
            n = len(order)
        parts = []
        parts.append("")
        parts.pop()
        _rid = str(self.total_requests)
        _o = self.opts
        _mid = _o.model_id
        for r in range(n):
            k = order[r]
            parts.append("{\"index\":" + str(_sidx[k]) + ",\"relevance_score\":" + str(_sval[k]) + "}")
        sep = ","
        body = "{\"id\":\"tv-" + _rid + "\",\"object\":\"list\",\"model\":\"" + _mid + "\",\"results\":[" + sep.join(parts) + "]}"
        return HttpResponse(1, 200, body, "application/json")

    def _score_ids(self, ids: 'list[i64]') -> 'f32':
        _sess = self.session
        _gr = _sess.graph
        _in0 = _gr.inputs[0]
        _desc = _gr.tensors[_in0]
        in_dim = _desc.element_count
        inp = _nd_f32(in_dim)
        for i in range(in_dim):
            inp[i] = 0.0
        nids = len(ids)
        if nids > in_dim:
            tail = ids[nids - in_dim:]
        else:
            tail = ids
        base = in_dim - len(tail)
        for i in range(len(tail)):
            inp[base + i] = float(tail[i])
        return self.batcher.enqueue(inp)[0]

    def _score_vec(self, q: 'list[f32]', d: 'list[f32]') -> 'f32':
        arr = []
        arr.append(0.0)
        arr.pop()
        for v in q:
            arr.append(v)
        for v in d:
            arr.append(v)
        _sess = self.session
        _gr = _sess.graph
        _in0 = _gr.inputs[0]
        _desc = _gr.tensors[_in0]
        in_dim = _desc.element_count
        inp = _nd_f32(in_dim)
        for i in range(in_dim):
            if i < len(arr):
                inp[i] = arr[i]
            else:
                inp[i] = 0.0
        return self.batcher.enqueue(inp)[0]

    def _infer(self, arr: 'list[f32]') -> 'list[f32]':
        inp = _nd_f32(len(arr))
        for i in range(len(arr)):
            inp[i] = arr[i]
        return self.batcher.enqueue(inp)

    def _stream_chunks(self, out: 'list[f32]') -> 'HttpResponse':
        chunks = []
        chunks.append("")
        chunks.pop()
        step = 64
        i = 0
        _rid = str(self.total_requests)
        _o = self.opts
        _mid = _o.model_id
        while i < len(out):
            _j = i + step
            if _j > len(out):
                _j = len(out)
            payload = "{\"id\":\"tv-" + _rid + "\",\"object\":\"chat.completion.chunk\",\"model\":\"" + _mid + "\",\"choices\":[{\"index\":0,\"delta\":{\"content\":" + json_quote(_slice_to_json(out, i, _j)) + "},\"finish_reason\":null}]}"
            chunks.append("data: " + payload + "\n\n")
            i = _j
        chunks.append("data: [DONE]\n\n")
        sep = ""
        return HttpResponse(1, 200, sep.join(chunks), "text/event-stream")

    def _prometheus(self) -> 'str':
        _bt = self.batcher
        out = "tokenvector_requests_total " + str(self.total_requests) + "\n"
        out = out + "tokenvector_latency_us_avg " + str(self.avg_latency_us()) + "\n"
        out = out + "tokenvector_errors_total " + str(self.errors_total) + "\n"
        out = out + "tokenvector_dropped_total " + str(self.dropped_total + _bt.dropped_total) + "\n"
        out = out + "tokenvector_queue_depth " + str(_bt.queue_depth()) + "\n"
        return out

    def avg_latency_us(self) -> 'f32':
        if self.total_requests == 0:
            return 0.0
        return float(self.total_lat_us) / self.total_requests

    def dispose(self) -> 'i32':
        if not self._closed:
            self.batcher.dispose()
            http_close(self.port)
            self._closed = 1
        return 0


def _web_ui() -> 'str':
    out = "<!DOCTYPE html><html><head><meta charset='utf-8'><title>TokenVector</title>"
    out = out + "<style>body{font-family:sans-serif;max-width:720px;margin:2em auto}#log{border:1px solid #ccc;height:320px;overflow:auto;padding:8px;white-space:pre-wrap}</style>"
    out = out + "</head><body><h3>TokenVector.Inference</h3><div id='log'></div>"
    out = out + "<input id='q' style='width:80%' placeholder='message'><button onclick='send()'>Send</button>"
    out = out + "<script>async function send(){const q=document.getElementById('q').value;"
    out = out + "const r=await fetch('/v1/chat/completions',{method:'POST',headers:{'Content-Type':'application/json'},"
    out = out + "body:JSON.stringify({messages:[{role:'user',content:q}]})});"
    out = out + "document.getElementById('log').textContent+=q+'|'+await r.text()+'|';}</script>"
    out = out + "</body></html>"
    return out


def _slice_to_json(out: 'list[f32]', lo: 'i64', hi: 'i64') -> 'str':
    parts = []
    parts.append("")
    parts.pop()
    for i in range(lo, hi):
        parts.append(str(out[i]))
    sep = ","
    return "[" + sep.join(parts) + "]"
