# Stub module: tv.numerics.tensor (auto-generated for tkvc import resolution)
# Real tensor helpers live with callers.

def tensor_zeros(n: "i64") -> "list[f32]":
    out = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out

def tensor_fill(n: "i64", v: "f32") -> "list[f32]":
    out = []
    i = 0
    while i < n:
        out.append(v)
        i = i + 1
    return out

def _tv_probe() -> "i32":
