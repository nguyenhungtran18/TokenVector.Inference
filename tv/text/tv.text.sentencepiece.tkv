class SPUnigramTokenizer:
    _ok: 'i64'
    pieces: 'list[str]'
    scores: 'list[f32]'
    unk_id: 'i64'
    by_first: 'dict[str,list[i64]]'

    def __init__(self, vocab_path: 'str', scores_path: 'str', unk_id: 'i64'=0):
        self.pieces = []
        raw_scores = []
        self.scores = []
        for i in range(len(raw_scores)):
            _ah9_12 = self.scores
            _ah9_12.append(float(raw_scores[i]))
        self.unk_id = unk_id
        self.by_first = {}
        for i in range(len(self.pieces)):
            p = self.pieces[i]
            first = p[0:1]
            if first not in self.by_first:
                self.by_first[first] = []
            _ah17_12 = self.by_first[first]
            _ah17_12.append(i)

    def vocab_size(self) -> 'i64':
        return len(self.pieces)

    def encode(self, text: 'str') -> 'list[i64]':
        s = text.replace(" ", "▁")
        n = len(s)
        best = []
        _zf107 = 0
        while _zf107 < (n + 1):
            best.append(-1000000000000000000000000000000.0)
            _zf107 = _zf107 + 1
        nxt = []
        _zf108 = 0
        while _zf108 < (n + 1):
            nxt.append(1)
            _zf108 = _zf108 + 1
        best[n] = 0.0
        i = n - 1
        while i > -1:
            if s[i:i + 1] in self.by_first:
                _c1 = self.by_first[s[i:i + 1]]
            else:
                _c1 = []
            cands = _c1
            for pid in cands:
                p = self.pieces[pid]
                L = len(p)
                if i + L <= n and s[i:i + L] == p:
                    sc = self.scores[pid] + best[i + L]
                    if sc > best[i]:
                        best[i] = sc
                        nxt[i] = L
            if best[i] <= -100000000000000000000000000000.0:
                best[i] = -10.0 + best[i + 1]
                nxt[i] = 1
            i = i + -1
        ids = []
        i = 0
        while i < n:
            L = nxt[i]
            piece = s[i:i + L]
            ids.append(self._piece_id(piece))
            i = i + L
        return ids

    def decode(self, ids: 'list[i64]') -> 'str':
        out = ""
        for i in ids:
            if i >= 0 and i < len(self.pieces):
                out = out + self.pieces[i]
        return out.replace("▁", " ")

    def _piece_id(self, piece: 'str') -> 'i64':
        if piece[0:1] in self.by_first:
            _c2 = self.by_first[piece[0:1]]
        else:
            _c2 = []
        cands = _c2
        for pid in cands:
            if self.pieces[pid] == piece:
                return pid
        return self.unk_id

