# PROBE P6A - DO THOI GIAN OP_EMBED_BWD OVERLAP (gwte_e || gwpe)
# ---------------------------------------------------------------------------
# Do toc do va xac minh bit-exact:
#   Sequential: gwte_e -> gwpe
#   Parallel: thread_spawn(gwte_worker) dong thoi main chay gwpe
# So sanh maxdiff va latency o cac seq: 8, 256, 1024.

import tv.training.tensor
import tv.training.ops

class _EmbJob:
    w_data: "list[f32]"
    idx: "list[i64]"
    d: 'i64'
    gy_data: "list[f32]"
    out_data: "list[f32]"
    rows: 'i64'
    def __init__(self, w_data: "list[f32]", idx: "list[i64]", d: 'i64', gy_data: "list[f32]", out_data: "list[f32]", rows: 'i64'):
        self.w_data = w_data
        self.idx = idx
        self.d = d
        self.gy_data = gy_data
        self.out_data = out_data
        self.rows = rows

def _emb_bwd_worker(j: "_EmbJob") -> 'i64':
    n = len(j.idx)
    d = j.d
    pos = []
    for t in range(n):
        pos.append(t)
    for a in range(n):
        for b in range(a + 1, n):
            if j.idx[pos[b]] < j.idx[pos[a]]:
                tmp = pos[a]
                pos[a] = pos[b]
                pos[b] = tmp
    for q in range(n):
        t = pos[q]
        r = j.idx[t]
        for c in range(d):
            j.out_data[r * d + c] = j.out_data[r * d + c] + j.gy_data[t * d + c]
    return 0

def _run_test_seq(n: 'i64') -> 'i32':
    h = 768
    v = 50257
    maxpos = 1024
    wte = t_zeros([v, h])
    wpe = t_zeros([maxpos, h])
    gx = t_zeros([n, h])
    for i in range(n * h):
        gx.data[i] = float((i * 17 + 5) % 100) / 100.0
    ids = []
    pos = []
    for i in range(n):
        ids.append((i * 37 + 11) % v)
        pos.append(i)

    # --- 1. Sequential ---
    t0 = now_ms()
    gwte_seq = op_embed_bwd(wte, ids, h, gx)
    gwpe_seq = op_embed_bwd(wpe, pos, h, gx)
    t1 = now_ms()
    t_seq = t1 - t0

    # --- 2. Parallel ---
    gwte_par = t_zeros([v * h])
    t2 = now_ms()
    job = _EmbJob(wte.data, ids, h, gx.data, gwte_par.data, v)
    handle = thread_spawn(_emb_bwd_worker, job)
    gwpe_par = op_embed_bwd(wpe, pos, h, gx)
    res = thread_join(handle)
    t3 = now_ms()
    t_par = t3 - t2

    # --- 3. Parity check ---
    diff_wte = 0.0
    for i in range(v * h):
        d = gwte_seq.data[i] - gwte_par.data[i]
        if d < 0.0:
            d = 0.0 - d
        if d > diff_wte:
            diff_wte = d

    diff_wpe = 0.0
    for i in range(maxpos * h):
        d = gwpe_seq.data[i] - gwpe_par.data[i]
        if d < 0.0:
            d = 0.0 - d
        if d > diff_wpe:
            diff_wpe = d

    print("SEQ=" + str(n) + " | t_seq=" + str(t_seq) + " ms | t_par=" + str(t_par) + " ms | diff_wte=" + str(diff_wte) + " diff_wpe=" + str(diff_wpe))
    return 0

def main() -> 'i32':
    print("PROBE P6A: EMBED_BWD OVERLAP TEST")
    _run_test_seq(8)
    _run_test_seq(256)
    _run_test_seq(1024)
    print("PROBE P6A DONE")
    return 0
