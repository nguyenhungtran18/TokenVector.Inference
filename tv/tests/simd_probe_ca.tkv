# PROBE CA — vong lap NGOAI GEMM bi BOX TkvInt (GĐ8 ung dung cho plumbing)
#
# Canh cu the (doc .locals cua out/bseq_new.il, ham co bien nguon TkvInt):
#   _step124   : 'off'          — unflatten: d[j] = opt.p[off + j]  (124M ptu/buoc, SERIAL)
#   _tn_one    : 'off'          — norm worker: gl[off + i]          (124M ptu/buoc)
#   _norm_groups: 'off' (duong serial <4M) + 'tot_elem'
#   _ls_one    : 'k'            — chi 1 lan/row (khong hot)
#   step (AdamW) + zero_grad    — int32 'i' → KHONG bi box (khong doi)
#
# Do A/B (dong ho time_perf) voi dung mau 124M:
#   [1] unflatten: W (off = off + len(d), off + j) vs F (off = off + 1, p[off])
#   [2] norm      : W (off = off + cnt, g[off+i]*g[off+i]) vs F (off = off + 1)
#   [3] in ket qua + maxdiff
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_ca.tkv out/ca.exe main
#   ./out/ca.exe
import tv.training.trainer

def _ca_zeros(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append((float(0) - 0.0) / 1.0)
    return out

def _ca_fz(n: 'i64') -> 'list[f64]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _ca_time() -> 'f64':
    return time_perf()

# ---- [1] unflatten ------------------------------------------------------
# W: giong _step124 nguyen ban (off = 0; for j: d[j] = p[off + j]; off += len(d))
def _ca_unflat_w(p: "list[f32]", d: "list[f32]", start: 'i64') -> 'i64':
    off = start
    n = len(d)
    j = 0
    while j < n:
        d[j] = p[off + j]
        j = j + 1
    return off + n

# F: off += 1 moi phan tu (off = off + 1 → giu native int64, xem probe t11)
def _ca_unflat_f(p: "list[f32]", d: "list[f32]", start: 'i64') -> 'i64':
    off = start
    n = len(d)
    j = 0
    while j < n:
        d[j] = p[off]
        off = off + 1
        j = j + 1
    return off

# ---- [2] norm (tong binh phuong tung nhom, kieu _tn_one) -----------------
def _ca_norm_w(g: "list[f32]", lo: 'i64', hi: 'i64', groups: 'list[i64]',
               goff: 'i64') -> 'f64':
    off = goff
    k = 0
    while k < lo:
        off = off + groups[k]
        k = k + 1
    kk = lo
    s = 0.0
    while kk < hi:
        cnt = groups[kk]
        i = 0
        while i < cnt:
            s = s + g[off + i] * g[off + i]
            i = i + 1
        off = off + cnt
        kk = kk + 1
    return s

def _ca_norm_f(g: "list[f32]", lo: 'i64', hi: 'i64', groups: 'list[i64]',
               goff: 'i64') -> 'f64':
    off = goff
    k = 0
    while k < lo:
        c = groups[k]
        m = 0
        while m < c:
            off = off + 1
            m = m + 1
        k = k + 1
    kk = lo
    s = 0.0
    while kk < hi:
        cnt = groups[kk]
        i = 0
        while i < cnt:
            s = s + g[off] * g[off]
            off = off + 1
            i = i + 1
        kk = kk + 1
    return s

def main() -> 'i32':
    N = 124000000
    print("CA start N=" + str(N))
    p = _ca_zeros(N)
    # data giong khong trau de doc (gia tri khong dyadic)
    i = 0
    while i < N:
        p[i] = float((i % 97) + 1) * 0.001
        i = i + 1
    d = _ca_zeros(N)
    g = p

    # ---- [1] unflatten A/B ----
    tA = 1.0e18
    tB = 1.0e18
    r1 = 0
    r2 = 0
    for rep in range(2):
        t0 = _ca_time()
        r1 = _ca_unflat_w(p, d, 0)
        t1 = _ca_time()
        if (t1 - t0) < tA:
            tA = t1 - t0
        t0 = _ca_time()
        r2 = _ca_unflat_f(p, d, 0)
        t1 = _ca_time()
        if (t1 - t0) < tB:
            tB = t1 - t0
    print("CA[1] unflatten W=" + str(tA) + "s F=" + str(tB) + "s speedup="
          + str(tA / tB) + " ns/ptu W=" + str(tA * 1000000000.0 / float(N))
          + " F=" + str(tB * 1000000000.0 / float(N)) + " off=" + str(r1)
          + "/" + str(r2))

    # ---- [2] norm A/B (chia 12 nhom giong _norm_groups) ----
    ng = 12
    per = int(float(N) / float(ng))
    groups = []
    k = 0
    while k < ng:
        lo2 = per * k
        hi2 = per * (k + 1)
        if k == ng - 1:
            hi2 = N
        groups.append(hi2 - lo2)
        k = k + 1
    total = 0
    k = 0
    while k < ng:
        total = total + groups[k]
        k = k + 1
    print("CA[2] groups total=" + str(total) + " (phai = " + str(N) + ")")

    s1 = 0.0
    s2 = 0.0
    tC = 1.0e18
    tD = 1.0e18
    for rep in range(2):
        t0 = _ca_time()
        s1 = _ca_norm_w(g, 0, ng, groups, 0)
        t1 = _ca_time()
        if (t1 - t0) < tC:
            tC = t1 - t0
        t0 = _ca_time()
        s2 = _ca_norm_f(g, 0, ng, groups, 0)
        t1 = _ca_time()
        if (t1 - t0) < tD:
            tD = t1 - t0
    print("CA[2] norm W=" + str(tC) + "s F=" + str(tD) + "s speedup="
          + str(tC / tD) + " ns/ptu W=" + str(tC * 1000000000.0 / float(N))
          + " F=" + str(tD * 1000000000.0 / float(N)))
    print("CA[2b] s W=" + str(s1) + " F=" + str(s2) + " chenh="
          + str(abs(s1 - s2)))

    # ---- [3] khong ghi de file quan trong; in ket qua ----
    print("CA done")
    return 0
