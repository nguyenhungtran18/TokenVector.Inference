# PROBE P6B - ATTENTION BWD PROJECTION DW OVERLAP / TRANSPOSE REMOVAL
# ---------------------------------------------------------------------------
# So sanh 2 phuong an tinh dw_proj = ctxT^T @ gout trong gpt2_attention_bwd:
#   A (Hien tai): ctxTt = smm_transpose(ctxT, n, h) -> dwG = smm_fwd(ctxTt, gout, h, h, n)
#   B (Moi):      dwG = smm_fwd_at(ctxT, gout, h, h, n) (bo smm_transpose nho trans_a=1)
# Do sai so maxdiff va latency o cac seq: 8, 256, 1024.

import tv.training.tensor
import tv.training.simd_matmul

def _run_test(n: 'i64') -> 'i32':
    h = 768
    ctxT = t_zeros([n, h])
    gout = t_zeros([n, h])
    for i in range(n * h):
        ctxT.data[i] = float((i * 13 + 7) % 89) / 89.0
        gout.data[i] = float((i * 19 + 3) % 97) / 97.0

    # Phuong an A: smm_transpose + smm_fwd
    t0 = now_ms()
    ctxTt = smm_transpose(ctxT, n, h)
    dwA = smm_fwd(ctxTt, gout, h, h, n)
    t1 = now_ms()
    t_A = t1 - t0

    # Phuong an B: smm_fwd_at (trans_a=1)
    t2 = now_ms()
    dwB = smm_fwd_at(ctxT, gout, h, h, n)
    t3 = now_ms()
    t_B = t3 - t2

    max_diff = 0.0
    for i in range(h * h):
        d = dwA.data[i] - dwB.data[i]
        if d < 0.0:
            d = 0.0 - d
        if d > max_diff:
            max_diff = d

    print("SEQ=" + str(n) + " | t_A (transpose+fwd)=" + str(t_A) + " ms | t_B (fwd_at)=" + str(t_B) + " ms | maxdiff=" + str(max_diff))
    return 0

def main() -> 'i32':
    print("PROBE P6B: DW_PROJ TRANSPOSE AVOIDANCE")
    _run_test(8)
    _run_test(256)
    _run_test(1024)
    print("PROBE P6B DONE")
    return 0
