# PROBE 14 — do chi phi: (a) rc/time onednn_linear_bias_gelu (ATen fused),
# (b) _gelu_fwd_par (12 buffer + copy) vs gelu_erf_fwd native don thuan.
import tv.training.gpt2_ref124
import tv.training.tensor

def main() -> 'i32':
    h = 768
    ih = 3072
    n = 1024
    x = t_zeros([n, h])
    w = t_zeros([h, ih])
    b = t_zeros([ih])
    y = t_zeros([n, ih])
    xd = x.data
    wd = w.data
    bd = b.data
    yd = y.data
    t0 = now_ms()
    rc = onednn_linear_bias_gelu(xd, wd, bd, yd, n, h, ih)
    t1 = now_ms()
    rc2 = onednn_linear_bias_gelu(xd, wd, bd, yd, n, h, ih)
    t2 = now_ms()
    print("ODG rc=" + str(rc) + "/" + str(rc2) + " ms=" + str(t1 - t0) + "/" + str(t2 - t1))

    cnt = n * ih
    xs = t_zeros([cnt])
    ys = t_zeros([cnt])
    # native only (single thread), 3 reps
    a0 = now_ms()
    xsd = xs.data
    ysd = ys.data
    r1 = gelu_erf_fwd(xsd, ysd, 0, cnt)
    r2 = gelu_erf_fwd(xsd, ysd, 0, cnt)
    r3 = gelu_erf_fwd(xsd, ysd, 0, cnt)
    a1 = now_ms()
    print("GELU_NATIVE rc=" + str(r1) + str(r2) + str(r3) + " 3x ms=" + str(a1 - a0))

    # _gelu_fwd_par (12 buffer + interpreted copy back), 3 reps
    c0 = now_ms()
    g1 = _gelu_fwd_par(xsd, ysd, cnt, 1)
    g2 = _gelu_fwd_par(xsd, ysd, cnt, 1)
    g3 = _gelu_fwd_par(xsd, ysd, cnt, 1)
    c1 = now_ms()
    print("GELU_PAR rc=" + str(g1) + str(g2) + str(g3) + " 3x ms=" + str(c1 - c0))
    return 0
