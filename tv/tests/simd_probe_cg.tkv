# PROBE CG — M3: PHAN RACH WRAPPER 4 SHAPE P7b + TY SO THREAD TUNG PHA
#
# Boi canh (§14.4 buoc 0 — muc M3 "lam truoc tien, dan bay cao nhat"):
#   - P7b (probe CD) chot wrapper 4 shape that = 45-82 GFLOPS vs torch
#     319-741 GFLOPS (6-14x) -> "khoang cach nam trong kernel".
#   - NHUNG P3 (probe AO) do PURE simd_gemm 768^3 x 800 = 539 GFLOPS,
#     cpu/wall = 21.20 (~21 luong that).
#   - Mau thuan: T cua CA 4 shape P7b deu = 768 (tinh duoi) -> neu kernel
#     tai T=768 dam ~539 thi wrapper 6-14x phai co phan lon nam NGOAI
#     kernel (ALLOC/BUILD/ACC + hieu ung in-context). Chua ai do phan rach
#     truc tiep — day la muc M3.
#
# Tinh T/ng (giong _smm_core: T = min(tilek(k), roundup64(min(m,n)))):
#   S1 dx1   smm_dot (m=nq=1024, n=h=768, k=4h=3072): T=768 ng=2*4*1=8    pad=2.41x
#   S3 dxf   smm_fwd (m=nq, n=h, k=V=50257):           T=768 ng=2*66*1=132 pad=1.52x
#   S4 dwte  fwd_at  (m=V,  n=h, k=nq):                T=768 ng=66*2*1=132 pad=1.52x
#   S5 logits smm_dot (m=nq, n=V, k=h):                T=768 ng=2*1*66=132 pad=1.52x
#
# Cac gia thuyet M3 kiem (§14.4):
#   (a) T/k-tiling: T = 768 cho ca 4 shape, ng = 8/132/132/132 — in ro.
#   (b) ACC per k-tile don luong (.tkv scalar) — do rieng ACC.
#   (c) GEMM back-to-back giua wrapper (pool co spin-up khi co khoang
#       cach build/acc giua 2 goi?) — do GEMM rieng + so sanh FULL.
#   (d) TKV_GEMM_MIN_N=96: T=768 >= 96 -> khong bi chan.
#   (e) RE-ENTRANCY: worker co goi simd_gemm dong thoi duoc khong?
#       (BH header ca noi "g_job global khong co lock = race" — mode 4
#       chinh nghia lai: bit-exact vs serial -> SAFE; khac -> RACE).
#
# Che do (doc tv/tests/_cg_cfg.txt — so dau tien):
#   0 = BREAKDOWN: 4 shape, moi shape in ALLOC/BUILD/GEMM/ACC/FULL/RESID (ms)
#                   + GFLOPS (real + padded) + so build/gemm/acc goi
#   1 = GEMM-ONLY back-to-back (>=400 goi/shape, tile dung truoc)
#                   -> chay qua tools/probe_threads.py lay cpu/wall (ky vong ~21)
#   2 = BUILD-ONLY 4 shape                -> probe_threads (ky vong ~1, don luong)
#   3 = FULL wrapper x2 (best-of) 4 shape -> probe_threads (ty so THAT cua wrapper)
#   4 = RE-ENTRANCY: 12 worker x 8 gemm T=768 DONG THOI vs serial + BIT check
#
# Ghi chu:
#   - Input = 0 (gia tri khong anh huong timing — FMA khong skip zero);
#     chi mode 4 fill du lieu vi CAN phat hien race.
#   - Tat ca now_ms() o MAIN (bug #8); vong nong (build/gemm/acc) nam trong
#     helper co tham so 'i64' typed -> khong bi boxing (GĐ8).
#   - RESID = FULL - (ALLOC+BUILD+GEMM+ACC) = loop overhead + hieu ung
#     in-context (pool spin-up/ cache) giua cac pha.
#
# Chay (tu goc repo):
#   printf "0\n" > tv/tests/_cg_cfg.txt
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cg.tkv out/cg.exe main
#   out/cg.exe
#   printf "1\n" > tv/tests/_cg_cfg.txt && python tools/probe_threads.py out/cg.exe 3
#   printf "2\n" > tv/tests/_cg_cfg.txt && python tools/probe_threads.py out/cg.exe 3
#   printf "3\n" > tv/tests/_cg_cfg.txt && python tools/probe_threads.py out/cg.exe 3
#   printf "4\n" > tv/tests/_cg_cfg.txt && out/cg.exe

import tv.training.tensor
import tv.training.simd_matmul
import tv.training.gpt2_ref124

CFG = "tv/tests/_cg_cfg.txt"

# ---- nho giong simd_matmul (copy — flatten import khong xuat ham private) ----

def _cg_imin(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return a
    return b

def _cg_ru64(x: 'i64') -> 'i64':
    r = 64
    while r < x:
        r = r + 64
    return r

def _cg_tilek(k: 'i64') -> 'i64':
    r = _cg_ru64(k)
    if r > 1024:
        r = 1024
    return r

def _cg_ceil(x: 'i64', T: 'i64') -> 'i64':
    q = 0
    r = 0
    while r < x:
        r = r + T
        q = q + 1
    return q

# list[f32] qua append bieu thuc (quy uoc compiler — xem simd_matmul)
def _cg_zeros(n: 'i64') -> 'list[f32]':
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    return out

def _cg_min2(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

# tile 768x768 gia tri khac nhau theo seed (mode 4 — phat hien race)
def _cg_tile(seed: 'i64') -> 'list[f32]':
    out = []
    d = float(seed) * 0.01 + 0.001
    i = 0
    while i < 768 * 768:
        out.append((d - 0.0) / 1.0)
        d = d + 0.0000001
        i = i + 1
    return out

def _cg_fill_list(d: "list[f32]", seed: 'i64') -> 'i64':
    n = len(d)
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _cg_maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        e = a[i] - b[i]
        if e < 0.0:
            e = -e
        if e > dmax:
            dmax = e
        i = i + 1
    return dmax

def _cg_verdict(d: 'f64') -> 'str':
    if d > 0.0:
        return "RACE CONFIRMED — worker dong thoi sai ket qua"
    return "SAFE — bit-exact vs serial"

def _cg_is_cmt(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_ints(path: 'str') -> 'list[i64]':
    txt = read_file(path)
    lines = txt.split("\n")
    out = []
    for i in range(len(lines)):
        if _cg_is_cmt(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                out.append(int(float(toks[j])))
    return out

# ---- tile writers + acc (copy y hinh tu simd_matmul — GĐ8 index chay) -------

def _cg_tile_a_w(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
                 ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z = 0.0
    i = 0
    dst = 0
    j = 0
    src = i0 * kdim + p0
    while i < ib:
        j = 0
        while j < pw:
            out[dst] = d[src + j]
            dst = dst + 1
            j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        src = src + kdim
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

def _cg_tile_b_w(out: "list[f32]", d: "list[f32]", ndim: 'i64', p0: 'i64',
                 pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'i64':
    z = 0.0
    i = 0
    dst = 0
    j = 0
    row = p0 * ndim + r0
    idx = r0 * ndim + p0
    while i < pw:
        if trans_b == 1:
            idx = r0 * ndim + p0 + i
            j = 0
            while j < br:
                out[dst] = d[idx]
                dst = dst + 1
                idx = idx + ndim
                j = j + 1
        else:
            row = (p0 + i) * ndim + r0
            j = 0
            while j < br:
                out[dst] = d[row + j]
                dst = dst + 1
                j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

def _cg_tile_a_at_w(out: "list[f32]", d: "list[f32]", mdim: 'i64', i0: 'i64',
                    ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z = 0.0
    r = 0
    t = 0
    dst = 0
    src = p0 * mdim + i0
    while r < ib:
        t = 0
        src = p0 * mdim + i0 + r
        while t < pw:
            out[dst] = d[src]
            dst = dst + 1
            src = src + mdim
            t = t + 1
        while t < T:
            out[dst] = z
            dst = dst + 1
            t = t + 1
        r = r + 1
    while r < T:
        t = 0
        while t < T:
            out[dst] = z
            dst = dst + 1
            t = t + 1
        r = r + 1
    return 0

# acc vung that vao C — index chay (copy _acc_f tu simd_matmul)
def _cg_acc_f(cd: "list[f32]", Ct: "list[f32]", n: 'i64', i0: 'i64',
              ib: 'i64', j0: 'i64', jb: 'i64', T: 'i64') -> 'i64':
    r = 0
    bc = i0 * n + j0
    bt = T * 0
    c = 0
    while r < ib:
        bc = i0 * n + j0 + r * n
        bt = r * T
        c = 0
        while c < jb:
            cd[bc] = cd[bc] + Ct[bt]
            bc = bc + 1
            bt = bt + 1
            c = c + 1
        r = r + 1
    return 0

# ---- cac pha (vong nong typed params -> native i64, khong boxing) ----------

# BUILD: lap lai dung cau truc _smm_core (A 1 lan/(i0,p0); B moi (i0,p0,j0))
# — KHONG gemm, KHONG acc. Return so lan build B (= ng).
def _cg_build_pass(ad: "list[f32]", bd: "list[f32]", m: 'i64', n: 'i64',
                   k: 'i64', ndim: 'i64', trans_b: 'i32', trans_a: 'i32',
                   ta: "list[f32]", tb: "list[f32]", T: 'i64') -> 'i64':
    w = 0
    i0 = 0
    while i0 < m:
        ib = _cg_imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _cg_imin(T, k - p0)
            if trans_a == 1:
                r1 = _cg_tile_a_at_w(ta, ad, m, i0, ib, p0, pw, T)
            else:
                r1 = _cg_tile_a_w(ta, ad, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _cg_imin(T, n - j0)
                r2 = _cg_tile_b_w(tb, bd, ndim, p0, pw, j0, jb, T, trans_b)
                w = w + 1
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return w

# GEMM back-to-back: reps*ng goi simd_gemm lien tuc tren dung 3 buffer
def _cg_gemm_pass(ng: 'i64', reps: 'i64', ta: "list[f32]", tb: "list[f32]",
                  ct: "list[f32]", T: 'i64') -> 'i64':
    r = 0
    while r < reps:
        i = 0
        while i < ng:
            simd_gemm(ta, tb, ct, T)
            i = i + 1
        r = r + 1
    return ng * reps

# ACC: moi (i0,p0,j0) tich luy vung that — giong vong _smm_core. Return so lan acc (= ng)
def _cg_acc_pass(cd: "list[f32]", ct: "list[f32]", m: 'i64', n: 'i64',
                 k: 'i64', T: 'i64') -> 'i64':
    w = 0
    i0 = 0
    while i0 < m:
        ib = _cg_imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _cg_imin(T, k - p0)
            j0 = 0
            while j0 < n:
                jb = _cg_imin(T, n - j0)
                r1 = _cg_acc_f(cd, ct, n, i0, ib, j0, jb, T)
                w = w + 1
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return w

# ---- mode 4: worker 1 goi simd_gemm T=768 tren buffer RIENG ----------------

class _CgJob:
    ta: "list[f32]"
    tb: "list[f32]"
    tc: "list[f32]"
    T: 'i64'
    reps: 'i64'
    def __init__(self, ta: "list[f32]", tb: "list[f32]", tc: "list[f32]",
                 T: 'i64', reps: 'i64'):
        self.ta = ta
        self.tb = tb
        self.tc = tc
        self.T = T
        self.reps = reps

def _cg_wr(j: "_CgJob") -> 'i64':
    # quirk: simd_gemm can BIEN mang rank 1 — truy cap field (j.ta) la bieu thuc
    # -> copy vao bien cuc bo truoc (giong _pd_do goi bang bien slot)
    ta = j.ta
    tb = j.tb
    tc = j.tc
    T = j.T
    reps = j.reps
    i = 0
    while i < reps:
        simd_gemm(ta, tb, tc, T)
        i = i + 1
    return 0

def main() -> 'i32':
    cfg = load_ints(CFG)
    mode = 0
    if len(cfg) > 0:
        mode = cfg[0]
    print("CG mode=" + str(mode))

    nq = 1024
    h = 768
    V = 50257
    four = 3072

    # 4 shape P7b: m, n, k, ndim, trans_b, trans_a + label
    ms = []
    ns = []
    ks = []
    nds = []
    tbs = []
    tas = []
    nms = []
    ms.append(nq)
    ns.append(h)
    ks.append(four)
    nds.append(four)
    tbs.append(1)
    tas.append(0)
    nms.append("S1 dx1  [1024x768x3072]")
    ms.append(nq)
    ns.append(h)
    ks.append(V)
    nds.append(h)
    tbs.append(0)
    tas.append(0)
    nms.append("S3 dxf  [1024x768x50257]")
    ms.append(V)
    ns.append(h)
    ks.append(nq)
    nds.append(h)
    tbs.append(0)
    tas.append(1)
    nms.append("S4 dwte [50257x768x1024]")
    ms.append(nq)
    ns.append(V)
    ks.append(h)
    nds.append(h)
    tbs.append(1)
    tas.append(0)
    nms.append("S5 lgts [1024x50257x768]")

    # ---- mode 1: GEMM-ONLY back-to-back (probe_threads) --------------------
    if mode == 1:
        T = 768
        At = _cg_zeros(T * T)
        Bt = _cg_zeros(T * T)
        Ct = _cg_zeros(T * T)
        idx = 0
        while idx < 4:
            m = ms[idx]
            n = ns[idx]
            k = ks[idx]
            nm = nms[idx]
            ng = _cg_ceil(m, T) * _cg_ceil(k, T) * _cg_ceil(n, T)
            rep = 1
            while rep * ng < 400:
                rep = rep + 1
            t0 = now_ms()
            rg = _cg_gemm_pass(ng, rep, At, Bt, Ct, T)
            t1 = now_ms()
            print("CG1 " + nm + " ng=" + str(ng) + " x" + str(rep)
                  + " = " + str(t1 - t0) + " ms  per_pass=" + str((t1 - t0) / float(rep))
                  + " ms  GFLOPS_pad=" + str(2.0 * float(ng) * float(rep) * float(T) * float(T) * float(T) / ((t1 - t0) * 1000000.0))
                  + "  calls=" + str(rg))
            idx = idx + 1
        print("CG1 done")
        return 0

    # ---- mode 2: BUILD-ONLY 4 shape (probe_threads) ------------------------
    if mode == 2:
        A1 = t_zeros([nq, four])
        B1 = t_zeros([h, four])
        A34 = t_zeros([nq, V])
        B35 = t_zeros([V, h])
        D45 = t_zeros([nq, h])
        aas = []
        bas = []
        aas.append(A1)
        aas.append(A34)
        aas.append(A34)
        aas.append(D45)
        bas.append(B1)
        bas.append(B35)
        bas.append(D45)
        bas.append(B35)
        tot = 0.0
        idx = 0
        while idx < 4:
            m = ms[idx]
            n = ns[idx]
            k = ks[idx]
            ndim = nds[idx]
            tb = tbs[idx]
            ta = tas[idx]
            nm = nms[idx]
            T = _cg_imin(_cg_tilek(k), _cg_ru64(_cg_imin(m, n)))
            At = _cg_zeros(T * T)
            Bt = _cg_zeros(T * T)
            t0 = now_ms()
            rb = _cg_build_pass(aas[idx].data, bas[idx].data, m, n, k, ndim,
                                tb, ta, At, Bt, T)
            t1 = now_ms()
            tot = tot + (t1 - t0)
            print("CG2 " + nm + " T=" + str(T) + " BUILD=" + str(t1 - t0)
                  + " ms  builds=" + str(rb))
            idx = idx + 1
        print("CG2 TOTAL BUILD=" + str(tot) + " ms")
        print("CG2 done")
        return 0

    # ---- mode 3: FULL wrapper x2 best-of 4 shape (probe_threads) -----------
    if mode == 3:
        A1 = t_zeros([nq, four])
        B1 = t_zeros([h, four])
        A34 = t_zeros([nq, V])
        B35 = t_zeros([V, h])
        D45 = t_zeros([nq, h])
        aas = []
        bas = []
        aas.append(A1)
        aas.append(A34)
        aas.append(A34)
        aas.append(D45)
        bas.append(B1)
        bas.append(B35)
        bas.append(D45)
        bas.append(B35)
        tot = 0.0
        idx = 0
        while idx < 4:
            m = ms[idx]
            n = ns[idx]
            k = ks[idx]
            tb = tbs[idx]
            ta = tas[idx]
            nm = nms[idx]
            t0 = now_ms()
            if ta == 1:
                cF = smm_fwd_at(aas[idx], bas[idx], m, n, k)
            else:
                if tb == 1:
                    cF = smm_dot(aas[idx], bas[idx], m, n, k)
                else:
                    cF = smm_fwd(aas[idx], bas[idx], m, n, k)
            t1 = now_ms()
            v_fv = t1 - t0
            t0 = now_ms()
            if ta == 1:
                cF = smm_fwd_at(aas[idx], bas[idx], m, n, k)
            else:
                if tb == 1:
                    cF = smm_dot(aas[idx], bas[idx], m, n, k)
                else:
                    cF = smm_fwd(aas[idx], bas[idx], m, n, k)
            t1 = now_ms()
            v_fv = _cg_min2(v_fv, t1 - t0)
            tot = tot + v_fv
            print("CG3 " + nm + " FULL=" + str(v_fv)
                  + " ms  GFLOPS=" + str(2.0 * float(m) * float(n) * float(k) / (v_fv * 1000000.0)))
            idx = idx + 1
        print("CG3 TOTAL FULL=" + str(tot) + " ms")
        print("CG3 done")
        return 0

    # ---- mode 4: RE-ENTRANCY — 12 worker x 8 gemm T=768 dong thoi ----------
    if mode == 4:
        T4 = 768
        R4 = 8
        # 12 cap tile doc doc theo seed (phat hien cross-contamination)
        ta0 = _cg_tile(1)
        tb0 = _cg_tile(2)
        ta1 = _cg_tile(8)
        tb1 = _cg_tile(9)
        ta2 = _cg_tile(15)
        tb2 = _cg_tile(16)
        ta3 = _cg_tile(22)
        tb3 = _cg_tile(23)
        ta4 = _cg_tile(29)
        tb4 = _cg_tile(30)
        ta5 = _cg_tile(36)
        tb5 = _cg_tile(37)
        ta6 = _cg_tile(43)
        tb6 = _cg_tile(44)
        ta7 = _cg_tile(50)
        tb7 = _cg_tile(51)
        ta8 = _cg_tile(57)
        tb8 = _cg_tile(58)
        ta9 = _cg_tile(64)
        tb9 = _cg_tile(65)
        ta10 = _cg_tile(71)
        tb10 = _cg_tile(72)
        ta11 = _cg_tile(78)
        tb11 = _cg_tile(79)
        ref0 = _cg_zeros(T4 * T4)
        ref1 = _cg_zeros(T4 * T4)
        ref2 = _cg_zeros(T4 * T4)
        ref3 = _cg_zeros(T4 * T4)
        ref4 = _cg_zeros(T4 * T4)
        ref5 = _cg_zeros(T4 * T4)
        ref6 = _cg_zeros(T4 * T4)
        ref7 = _cg_zeros(T4 * T4)
        ref8 = _cg_zeros(T4 * T4)
        ref9 = _cg_zeros(T4 * T4)
        ref10 = _cg_zeros(T4 * T4)
        ref11 = _cg_zeros(T4 * T4)
        tc0 = _cg_zeros(T4 * T4)
        tc1 = _cg_zeros(T4 * T4)
        tc2 = _cg_zeros(T4 * T4)
        tc3 = _cg_zeros(T4 * T4)
        tc4 = _cg_zeros(T4 * T4)
        tc5 = _cg_zeros(T4 * T4)
        tc6 = _cg_zeros(T4 * T4)
        tc7 = _cg_zeros(T4 * T4)
        tc8 = _cg_zeros(T4 * T4)
        tc9 = _cg_zeros(T4 * T4)
        tc10 = _cg_zeros(T4 * T4)
        tc11 = _cg_zeros(T4 * T4)
        print("CG4 stage=setup done (48 tile + 24 buffer)")
        # serial: 12 x R4 gemm lien tuc tren main
        t0 = now_ms()
        k4 = 0
        while k4 < R4:
            simd_gemm(ta0, tb0, ref0, T4)
            simd_gemm(ta1, tb1, ref1, T4)
            simd_gemm(ta2, tb2, ref2, T4)
            simd_gemm(ta3, tb3, ref3, T4)
            simd_gemm(ta4, tb4, ref4, T4)
            simd_gemm(ta5, tb5, ref5, T4)
            simd_gemm(ta6, tb6, ref6, T4)
            simd_gemm(ta7, tb7, ref7, T4)
            simd_gemm(ta8, tb8, ref8, T4)
            simd_gemm(ta9, tb9, ref9, T4)
            simd_gemm(ta10, tb10, ref10, T4)
            simd_gemm(ta11, tb11, ref11, T4)
            k4 = k4 + 1
        t1 = now_ms()
        v_ser = t1 - t0
        print("CG4 stage=serial done ms=" + str(v_ser))
        # dong thoi: 12 worker, moi worker R4 gemm tren buffer RIENG
        t0 = now_ms()
        hb0 = thread_spawn(_cg_wr, _CgJob(ta0, tb0, tc0, T4, R4))
        hb1 = thread_spawn(_cg_wr, _CgJob(ta1, tb1, tc1, T4, R4))
        hb2 = thread_spawn(_cg_wr, _CgJob(ta2, tb2, tc2, T4, R4))
        hb3 = thread_spawn(_cg_wr, _CgJob(ta3, tb3, tc3, T4, R4))
        hb4 = thread_spawn(_cg_wr, _CgJob(ta4, tb4, tc4, T4, R4))
        hb5 = thread_spawn(_cg_wr, _CgJob(ta5, tb5, tc5, T4, R4))
        hb6 = thread_spawn(_cg_wr, _CgJob(ta6, tb6, tc6, T4, R4))
        hb7 = thread_spawn(_cg_wr, _CgJob(ta7, tb7, tc7, T4, R4))
        hb8 = thread_spawn(_cg_wr, _CgJob(ta8, tb8, tc8, T4, R4))
        hb9 = thread_spawn(_cg_wr, _CgJob(ta9, tb9, tc9, T4, R4))
        hb10 = thread_spawn(_cg_wr, _CgJob(ta10, tb10, tc10, T4, R4))
        hb11 = thread_spawn(_cg_wr, _CgJob(ta11, tb11, tc11, T4, R4))
        rj0 = thread_join(hb0)
        rj1 = thread_join(hb1)
        rj2 = thread_join(hb2)
        rj3 = thread_join(hb3)
        rj4 = thread_join(hb4)
        rj5 = thread_join(hb5)
        rj6 = thread_join(hb6)
        rj7 = thread_join(hb7)
        rj8 = thread_join(hb8)
        rj9 = thread_join(hb9)
        rj10 = thread_join(hb10)
        rj11 = thread_join(hb11)
        t1 = now_ms()
        v_par = t1 - t0
        print("CG4 stage=concurrent done ms=" + str(v_par))
        # BIT: moi tc vs ref cua NO
        dmax = 0.0
        d0 = _cg_maxdiff(tc0, ref0, T4 * T4)
        if d0 > dmax:
            dmax = d0
        d1 = _cg_maxdiff(tc1, ref1, T4 * T4)
        if d1 > dmax:
            dmax = d1
        d2 = _cg_maxdiff(tc2, ref2, T4 * T4)
        if d2 > dmax:
            dmax = d2
        d3 = _cg_maxdiff(tc3, ref3, T4 * T4)
        if d3 > dmax:
            dmax = d3
        d4 = _cg_maxdiff(tc4, ref4, T4 * T4)
        if d4 > dmax:
            dmax = d4
        d5 = _cg_maxdiff(tc5, ref5, T4 * T4)
        if d5 > dmax:
            dmax = d5
        d6 = _cg_maxdiff(tc6, ref6, T4 * T4)
        if d6 > dmax:
            dmax = d6
        d7 = _cg_maxdiff(tc7, ref7, T4 * T4)
        if d7 > dmax:
            dmax = d7
        d8 = _cg_maxdiff(tc8, ref8, T4 * T4)
        if d8 > dmax:
            dmax = d8
        d9 = _cg_maxdiff(tc9, ref9, T4 * T4)
        if d9 > dmax:
            dmax = d9
        d10 = _cg_maxdiff(tc10, ref10, T4 * T4)
        if d10 > dmax:
            dmax = d10
        d11 = _cg_maxdiff(tc11, ref11, T4 * T4)
        if d11 > dmax:
            dmax = d11
        print("CG4 serial=" + str(v_ser) + " ms  dong_thoi=" + str(v_par)
              + " ms  speedup=" + str(v_ser / v_par) + "x  MAXDIFF=" + str(dmax)
              + "  " + _cg_verdict(dmax))
        print("CG4 done")
        return 0

    # ---- mode 0 (mac dinh): BREAKDOWN 4 shape ------------------------------
    A1 = t_zeros([nq, four])
    B1 = t_zeros([h, four])
    A34 = t_zeros([nq, V])
    B35 = t_zeros([V, h])
    D45 = t_zeros([nq, h])
    aas = []
    bas = []
    aas.append(A1)
    aas.append(A34)
    aas.append(A34)
    aas.append(D45)
    bas.append(B1)
    bas.append(B35)
    bas.append(D45)
    bas.append(B35)

    idx = 0
    while idx < 4:
        m = ms[idx]
        n = ns[idx]
        k = ks[idx]
        ndim = nds[idx]
        tb = tbs[idx]
        ta = tas[idx]
        nm = nms[idx]
        T = _cg_imin(_cg_tilek(k), _cg_ru64(_cg_imin(m, n)))
        ng = _cg_ceil(m, T) * _cg_ceil(k, T) * _cg_ceil(n, T)
        pad = float(ng) * float(T) * float(T) * float(T) / (float(m) * float(n) * float(k))
        print("CG0 " + nm + " T=" + str(T) + " ng=" + str(ng) + " pad=" + str(pad) + "x")

        # ALLOC: giong _smm_core (C = t_zeros + 3 buffer T^2 append)
        t0 = now_ms()
        C = t_zeros([m, n])
        cd = C.data
        Ct = _cg_zeros(T * T)
        At = _cg_zeros(T * T)
        Bt = _cg_zeros(T * T)
        t1 = now_ms()
        v_al = t1 - t0

        # BUILD: chi tile build (A moi (i0,p0), B moi (i0,p0,j0))
        t0 = now_ms()
        rb = _cg_build_pass(aas[idx].data, bas[idx].data, m, n, k, ndim,
                            tb, ta, At, Bt, T)
        t1 = now_ms()
        v_bd = t1 - t0

        # GEMM back-to-back: >=400 goi, tinh lai per-pass
        rep = 1
        while rep * ng < 400:
            rep = rep + 1
        t0 = now_ms()
        rg = _cg_gemm_pass(ng, rep, At, Bt, Ct, T)
        t1 = now_ms()
        v_gm = (t1 - t0) / float(rep)

        # ACC: moi (i0,p0,j0) acc vung that
        t0 = now_ms()
        ra = _cg_acc_pass(cd, Ct, m, n, k, T)
        t1 = now_ms()
        v_ac = t1 - t0

        # FULL: wrapper that, best-of-2
        t0 = now_ms()
        if ta == 1:
            cF = smm_fwd_at(aas[idx], bas[idx], m, n, k)
        else:
            if tb == 1:
                cF = smm_dot(aas[idx], bas[idx], m, n, k)
            else:
                cF = smm_fwd(aas[idx], bas[idx], m, n, k)
        t1 = now_ms()
        v_fv = t1 - t0
        t0 = now_ms()
        if ta == 1:
            cF = smm_fwd_at(aas[idx], bas[idx], m, n, k)
        else:
            if tb == 1:
                cF = smm_dot(aas[idx], bas[idx], m, n, k)
            else:
                cF = smm_fwd(aas[idx], bas[idx], m, n, k)
        t1 = now_ms()
        v_fv = _cg_min2(v_fv, t1 - t0)

        v_sum = v_al + v_bd + v_gm + v_ac
        v_rs = v_fv - v_sum
        print("CG0   ALLOC=" + str(v_al) + " BUILD=" + str(v_bd)
              + " GEMM=" + str(v_gm) + " ACC=" + str(v_ac)
              + " SUM=" + str(v_sum) + " FULL=" + str(v_fv)
              + " RESID=" + str(v_rs) + " ms")
        print("CG0   GEMM_GF=" + str(2.0 * float(m) * float(n) * float(k) / (v_gm * 1000000.0))
              + "  GEMM_GFP=" + str(2.0 * float(ng) * float(T) * float(T) * float(T) / (v_gm * 1000000.0))
              + "  FULL_GF=" + str(2.0 * float(m) * float(n) * float(k) / (v_fv * 1000000.0))
              + "  calls(build=" + str(rb) + " gemm=" + str(rg) + " acc=" + str(ra) + ")")
        idx = idx + 1

    print("CG0 done")
    return 0
