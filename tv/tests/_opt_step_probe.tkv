# PROBE OPT STEP (2026-11-11) â€” 781 ms cua opt.step() nam o dau?
#
# BPHASE cho thay opt=781 ms va copyback=125 ms GIONG HET nhau o seq8/256/1024
# -> chi phi CO DINH, khong co gian theo seq. torch cung pha: opt.step=655.2 ms.
#
# _norm_groups da co fast path f32_grad_norm (trainer.tkv L470) nen grad_norm
# khong the la 781 ms. Nghi pham con lai, moi cai do rieng:
#   P3: f32_grad_norm    (de loai tru)
#   P4: vong .tkv ghi p  (copyback hien tai)
#   P5: f32_copy_from_buf (builtin native â€” ung vien thay the copyback)
#   P2: f32_copy_to_buf  (r2: p list -> buf)
#   P1: adamw_step_glm   (kernel native, n=124,439,808)
#
# LUU Y KIEU: zeros_list tra dtype 'i32' nen bien KHONG mang kieu list[f32].
# Moi thao tac tren list[f32] phai di qua THAM SO HAM.
import tv.training.gpt2_ref124
import tv.training.trainer


def touch_list(z: "list[f32]", n: "i32") -> "f64":
    """Doc vai diem rai deu â€” chung minh du lieu that, khong bi DCE."""
    s: "f64" = 0.0
    i: "i32" = 0
    step: "i32" = n // 1000
    if step < 1:
        step = 1
    while i < n:
        s = s + float(z[i])
        i = i + step
    return s


def p3_grad_norm(g: "list[f32]", n: "i32") -> "f64":
    t0 = now_ms()
    gn: "f32" = f32(f32_grad_norm(g, n))
    t1 = now_ms()
    print("P3 f32_grad_norm        : " + str(t1 - t0) + " ms   gn=" + str(gn))
    return float(gn)


def p4_vong_tkv(p: "list[f32]", n: "i32") -> "f64":
    t0 = now_ms()
    i: "i32" = 0
    while i < n:
        p[i] = 1.0
        i = i + 1
    t1 = now_ms()
    print("P4 vong .tkv ghi p      : " + str(t1 - t0) + " ms")
    return float(p[n - 1])


def p5_copy_from_buf(p: "list[f32]", n: "i32") -> "i64":
    buf = alloc_bytes(n * 4)
    f32_zero(buf, n)
    t0 = now_ms()
    rc: "i64" = f32_copy_from_buf(buf, p, n)
    t1 = now_ms()
    print("P5 f32_copy_from_buf    : " + str(t1 - t0) + " ms   rc=" + str(rc))
    return rc


def p2_copy_to_buf(p: "list[f32]", n: "i32") -> "i64":
    buf = alloc_bytes(n * 4)
    t0 = now_ms()
    rc: "i64" = f32_copy_to_buf(p, buf, n)
    t1 = now_ms()
    print("P2 f32_copy_to_buf      : " + str(t1 - t0) + " ms   rc=" + str(rc))
    return rc


def p1_adamw(g: "list[f32]", n: "i32") -> "i64":
    buf = alloc_bytes(n * 4)
    f32_zero(buf, n)
    t0 = now_ms()
    stw: "i64" = adamw_step_glm(buf, buf, buf, g, n,
                                0.0001, 0.9, 0.999, 0.00000001, 0.01, 0.1, 0.9995)
    t1 = now_ms()
    print("P1 adamw_step_glm       : " + str(t1 - t0) + " ms   stw=" + str(stw))
    return stw


def main() -> 'i32':
    print("=== PROBE OPT STEP â€” 781 ms nam o dau? ===")

    n: "i32" = 124439808
    mb: "f64" = float(n * 4) / 1048576.0
    print("n = " + str(n) + "  (" + str(mb) + " MB)")
    print("")

    r3: "f64" = p3_grad_norm(zeros_list(n), n)
    print("")
    r4: "f64" = p4_vong_tkv(zeros_list(n), n)
    print("")
    r5: "i64" = p5_copy_from_buf(zeros_list(n), n)
    print("")
    r2: "i64" = p2_copy_to_buf(zeros_list(n), n)
    print("")
    r1: "i64" = p1_adamw(zeros_list(n), n)
    print("")

    print("--- kiem chung (phai khac 0 neu du lieu that) ---")
    print("P4 cuoi = " + str(r4))
    print("P3 gn   = " + str(r3))
    print("")
    print("--- doc ---")
    print("So P1/P2/P4/P5 voi 781 ms cua BPHASE opt va 125 ms cua copyback.")
    return 0

