# PROBE AV — P5.7 tach LHEAD (lm-head bwd) theo THANH PHAN
# Parts: (1) softmax-grad scalar, (2) smm_transpose gg^T (n x V),
#        (3) dxf = gg x wte, (4) dwte = ggT x xf.
# So sanh SUM(parts) voi AQ LHEAD (~11.5s @1024 sau P5.6).
# Cau hinh: tv/tests/_seq_cfg.txt DONG 1 = seq (dong 2/3 khong dung).
# Chay (tu goc repo):
#   printf "1024\n0\n1\n" > tv/tests/_seq_cfg.txt
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_av.tkv out/av.exe main
#   ./out/av.exe
import tv.training.gpt2_ref124
import tv.training.simd_matmul

CFG = "tv/tests/_seq_cfg.txt"

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> 'list[f32]':
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def main() -> 'i32':
    cfg = load_ints(CFG)
    n = cfg[0]
    print("AV seq=" + str(n))
    ids = _mk_ids(n)
    pos = []
    for i in range(n):
        pos.append(i)
    ps = gpt2_init(7)
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    sv = gpt2_forward_saved(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                            ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], 1)
    z = sv[0]
    xf = sv[1]
    V = VocabSize
    h = HiddenSize
    print("AV n=" + str(n) + " V=" + str(V) + " h=" + str(h))

    rs = 3
    gg = t_zeros([n, V])
    ggT = t_zeros([V, n])
    dxf = t_zeros([n, h])
    dwte = t_zeros([V, h])

    # ---- (1) softmax-grad scalar (copy nhanh simd=1 cua gpt2_backward) ------
    v_soft = 1.0e18
    k1 = 0
    while k1 < rs:
        t0 = now_ms()
        for i in range(n):
            base = i * V
            mxf = z.data[base]
            for o in range(1, V):
                if z.data[base + o] > mxf:
                    mxf = z.data[base + o]
            tot = 0.0
            for o in range(V):
                e = exp(z.data[base + o] - mxf)
                gg.data[base + o] = e
                tot = tot + e
            it = 1.0 / tot
            ivn = 1.0 / float(n)
            for o in range(V):
                ggv = gg.data[base + o] * it * ivn
                if o == ids[i]:
                    ggv = ggv - ivn
                gg.data[base + o] = ggv
        t1 = now_ms()
        v_soft = _mn(v_soft, t1 - t0)
        k1 = k1 + 1

    # ---- (2) transpose gg^T [n,V] -> [V,n] ---------------------------------
    v_tr = 1.0e18
    k2 = 0
    while k2 < rs:
        t0 = now_ms()
        ggT = smm_transpose(gg, n, V)
        t1 = now_ms()
        v_tr = _mn(v_tr, t1 - t0)
        k2 = k2 + 1

    # ---- (3) dxf = gg [n,V] x wte [V,h] ------------------------------------
    v_dxf = 1.0e18
    k3 = 0
    while k3 < rs:
        t0 = now_ms()
        dxf = smm_fwd(gg, ps[0], n, h, V)
        t1 = now_ms()
        v_dxf = _mn(v_dxf, t1 - t0)
        k3 = k3 + 1

    # ---- (4) dwte = ggT [V,n] x xf [n,h] -----------------------------------
    v_dwte = 1.0e18
    k4 = 0
    while k4 < rs:
        t0 = now_ms()
        dwte = smm_fwd(ggT, xf, V, h, n)
        t1 = now_ms()
        v_dwte = _mn(v_dwte, t1 - t0)
        k4 = k4 + 1

    # ---- (5) duong THAY THE cho (2)+(4): xfT [h,n] -> dwteT [h,V] ---------
    # dwte[o,k] = sum_t gg[t,o]*xf[t,k]; dwteT[k,o] = (xfT x gg)[k,o]
    # -> chi transpose xf (n*h = 0.79M @1024, thay vi n*V = 51.5M)
    v_alt_tr = 1.0e18
    v_alt = 1.0e18
    xfT = t_zeros([h, n])
    dwteT = t_zeros([h, V])
    k5 = 0
    while k5 < rs:
        t0 = now_ms()
        xfT = smm_transpose(xf, n, h)
        t1 = now_ms()
        v_alt_tr = _mn(v_alt_tr, t1 - t0)
        t0 = now_ms()
        dwteT = smm_fwd(xfT, gg, h, V, n)
        t1 = now_ms()
        v_alt = _mn(v_alt, t1 - t0)
        k5 = k5 + 1

    sum_cur = v_soft + v_tr + v_dxf + v_dwte
    sum_alt = v_soft + v_alt_tr + v_dxf + v_alt
    print("AV SOFTMAX_GRAD   = " + str(v_soft) + " ms")
    print("AV TRANSPOSE_ggT  = " + str(v_tr) + " ms   (n x V)")
    print("AV GEMM_dxf       = " + str(v_dxf) + " ms   (gg x wte)")
    print("AV GEMM_dwte      = " + str(v_dwte) + " ms   (ggT x xf)")
    print("AV SUM_duong_cu   = " + str(sum_cur) + " ms")
    print("AV ALT transpose_xf = " + str(v_alt_tr) + " ms   (n x h — re)")
    print("AV ALT GEMM_dwteT   = " + str(v_alt) + " ms   (xfT x gg)")
    print("AV SUM_duong_alt  = " + str(sum_alt) + " ms")
    print("AV done")
    return 0
