def _arm(flat: "list[f32]", dz: "list[f32]", sz: "i64", off: "i64") -> "i64":
    o = off
    jj = 0
    while jj < sz:
        t: "f32" = flat[o + jj]
        dz[jj] = t
        jj = jj + 1
    return 0

def main() -> "i32":
    a: "list[f32]" = []
    b: "list[f32]" = []
    return _arm(a, b, 0, 0)
