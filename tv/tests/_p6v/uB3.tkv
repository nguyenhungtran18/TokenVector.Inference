def _arm(gflat: "list[f32]", db: "list[f32]", gy: "list[f32]", z: "list[f32]", dboff: "i64", out_d: "i64", q: "i64") -> "i64":
    o = 0
    for o in range(out_d):
        gflat[dboff + o] = gflat[dboff + o] + gy[o]
    return 0

def main() -> "i32":
    a: "list[f32]" = []
    b: "list[f32]" = []
    c: "list[f32]" = []
    d: "list[f32]" = []
    return _arm(a, b, c, d, 0, 0, 0)
