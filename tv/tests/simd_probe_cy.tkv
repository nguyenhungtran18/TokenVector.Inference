# PROBE CY — M4 `simd_gemm_packed` GOI TU REPO NAY (smoke + A/B 4 shape P7b)
# ---------------------------------------------------------------------------
# Muc do: sau khi compiler team giao M4/M5/M6/M7 (HANDOFF §0.45), chua ai goi
# builtin tu repo nay. Probe nay do TRUC TIEP:
#   (A) packed vs production tren DUNG 4 shape P7b, best-of-3, doi maxdiff
#   (B) 2 thread goi packed cung luc (re-entrancy §3.1 — M4 test cua compiler
#       cho phep, nhung phai xac nhan tu repo nay vi attention worker dang
#       goi simd_gemm dong song)
#   (C) mini tol 256^3 packed vs scalar
#
# LAM LUONG (da chot bang probe _cy0/_cy1/_cy2, xem HANDOFF §0.46):
#   - Tensor.data (t_zeros / append 0.0 trong ham `-> "Tensor"`) = List[DOUBLE]
#     -> `simd_gemm_packed_create` nem ArgumentException (chi nhan List[Single]).
#   - Tao list bang `out: "list[f32]" = []` (khai ro kieu local) hoac bang ham
#     `-> "list[f32]"` -> List[Single] -> packed chap nhan. Probe nay dung
#     builder `_cy_z` (Single) cho CA 2 arm nen du lieu GIONG NHAU.
#
# Cach dung (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cy.tkv out/cy.exe main
#   ./out/cy.exe
import tv.training.tensor
import tv.training.simd_matmul

def _cy_z(n: 'i64') -> "list[f32]":
    out = []
    for i in range(n):
        out.append((float(0) - 0.0) / 1.0)
    return out

def _cy_fill(d: "list[f32]", seed: 'i64') -> 'i64':
    n = len(d)
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _cy_zero(d: "list[f32]", cnt: 'i64') -> 'i64':
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < cnt:
        d[i] = z
        i = i + 1
    return 0

def _cy_maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

# ---- arm B: packed ----------------------------------------------------------
# cd = A(m x k) x B(k x n) voi A/B dang LUU (ra x ca / rb x cb), trans = 1 khi
# matran nguon da luu chuyen vi. T = tile (khop production T de so sanh duoc).
def _cy_pack(ad: "list[f32]", bd: "list[f32]", cd: "list[f32]",
             m: 'i64', n: 'i64', k: 'i64',
             ra: 'i64', ca: 'i64', sa: 'i64', ta: 'i32',
             rb: 'i64', cb: 'i64', sb: 'i64', tb: 'i32',
             T: 'i64') -> 'i64':
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(ad, ra, ca, sa, T, ta)
    hB = simd_gemm_packed_create(bd, rb, cb, sb, T, tb)
    st = simd_gemm_packed(hA, hB, cd, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    return st

# ---- (B) job cho 2 thread ---------------------------------------------------
class _CyJob:
    ad: "list[f32]"
    bd: "list[f32]"
    cd: "list[f32]"
    m: 'i64'
    n: 'i64'
    k: 'i64'
    T: 'i64'
    seed: 'i64'

    def __init__(self, ad: "list[f32]", bd: "list[f32]", cd: "list[f32]",
                 m: 'i64', n: 'i64', k: 'i64', T: 'i64', seed: 'i64'):
        self.ad = ad
        self.bd = bd
        self.cd = cd
        self.m = m
        self.n = n
        self.k = k
        self.T = T
        self.seed = seed

def _cy_one(j: "_CyJob") -> 'i64':
    rv = _cy_fill(j.ad, j.seed)
    rv2 = _cy_fill(j.bd, j.seed + 1)
    st = _cy_pack(j.ad, j.bd, j.cd, j.m, j.n, j.k,
                  j.m, j.k, j.k, 0, j.k, j.n, j.n, 0, j.T)
    return st

# ---- (C) reference scalar ---------------------------------------------------
def _cy_ref(a: "list[f32]", b: "list[f32]", c: "list[f32]",
            m: 'i64', n: 'i64', k: 'i64') -> 'i64':
    i = 0
    while i < m:
        j = 0
        while j < n:
            s = 0.0
            p = 0
            while p < k:
                s = s + a[i * k + p] * b[p * n + j]
                p = p + 1
            c[i * n + j] = s
            j = j + 1
        i = i + 1
    return 0

def main() -> 'i32':
    print("CY: M4 packed vs production — 4 shape P7b, best-of-3, T=768")
    rs = 3
    nq = 1024
    h = 768
    V = 50257
    four = 3072
    T: "i64" = 768

    # ---- S1 dx1 [1024 x 768] = A[1024,3072] x B^T[768,3072] : smm_dot (serial)
    a1 = _cy_z(nq * four)
    b1 = _cy_z(h * four)
    rv1 = _cy_fill(a1, 1)
    rv2 = _cy_fill(b1, 2)
    c1 = _cy_z(nq * h)
    ta1 = Tensor(a1, [nq, four], 0)
    tb1 = Tensor(b1, [h, four], 0)
    v1b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c1b = smm_dot(ta1, tb1, nq, h, four)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < v1b:
            v1b = d1
        kk = kk + 1
    v1t = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        rz = _cy_zero(c1, nq * h)
        st1 = _cy_pack(a1, b1, c1, nq, h, four, nq, four, four, 0, h, four, four, 1, T)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < v1t:
            v1t = d1
        kk = kk + 1
    md1 = _cy_maxdiff(c1b.data, c1, nq * h)
    print("CY S1 dx1  serial   base=" + str(v1b) + " pack=" + str(v1t)
          + " sp=" + str(v1b / v1t) + "x  maxdiff=" + str(md1) + " st=" + str(st1))

    # ---- S3 dxf [1024 x 768] = A[1024,50257] x B[50257,768] : smm_fwd_pd ----
    a3 = _cy_z(nq * V)
    b3 = _cy_z(V * h)
    rv3 = _cy_fill(a3, 3)
    rv4 = _cy_fill(b3, 4)
    sc3 = _cy_z(nq * h)
    c3 = _cy_z(nq * h)
    ta3 = Tensor(a3, [nq, V], 0)
    tb3 = Tensor(b3, [V, h], 0)
    v3b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3b = smm_fwd_pd(ta3, tb3, nq, h, V, sc3)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3b:
            v3b = d3
        kk = kk + 1
    v3t = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        rz = _cy_zero(c3, nq * h)
        st3 = _cy_pack(a3, b3, c3, nq, h, V, nq, V, V, 0, V, h, h, 0, T)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3t:
            v3t = d3
        kk = kk + 1
    md3 = _cy_maxdiff(c3b.data, c3, nq * h)
    print("CY S3 dxf  wave-12  base=" + str(v3b) + " pack=" + str(v3t)
          + " sp=" + str(v3b / v3t) + "x  maxdiff=" + str(md3) + " st=" + str(st3))

    # ---- S4 dwte [50257 x 768] = A^T[1024,50257] x B[1024,768] : smm_fwd_at_pd
    a4 = _cy_z(nq * V)
    b4 = _cy_z(nq * h)
    rv5 = _cy_fill(a4, 5)
    rv6 = _cy_fill(b4, 6)
    sc4 = _cy_z(V * h)
    c4 = _cy_z(V * h)
    ta4 = Tensor(a4, [nq, V], 0)
    tb4 = Tensor(b4, [nq, h], 0)
    v4b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4b = smm_fwd_at_pd(ta4, tb4, V, h, nq, sc4)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4b:
            v4b = d4
        kk = kk + 1
    v4t = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        rz = _cy_zero(c4, V * h)
        st4 = _cy_pack(a4, b4, c4, V, h, nq, nq, V, V, 1, nq, h, h, 0, T)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4t:
            v4t = d4
        kk = kk + 1
    md4 = _cy_maxdiff(c4b.data, c4, V * h)
    print("CY S4 dwte wave-12  base=" + str(v4b) + " pack=" + str(v4t)
          + " sp=" + str(v4b / v4t) + "x  maxdiff=" + str(md4) + " st=" + str(st4))

    # ---- S5 lgts [1024 x 50257] = A[1024,768] x B^T[50257,768] : smm_dot_pd --
    a5 = _cy_z(nq * h)
    b5 = _cy_z(V * h)
    rv7 = _cy_fill(a5, 7)
    rv8 = _cy_fill(b5, 8)
    sc5 = _cy_z(nq * V)
    c5 = _cy_z(nq * V)
    ta5 = Tensor(a5, [nq, h], 0)
    tb5 = Tensor(b5, [V, h], 0)
    v5b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5b = smm_dot_pd(ta5, tb5, nq, V, h, sc5)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5b:
            v5b = d5
        kk = kk + 1
    v5t = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        rz = _cy_zero(c5, nq * V)
        st5 = _cy_pack(a5, b5, c5, nq, V, h, nq, h, h, 0, V, h, h, 1, T)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5t:
            v5t = d5
        kk = kk + 1
    md5 = _cy_maxdiff(c5b.data, c5, nq * V)
    print("CY S5 lgts wave-12  base=" + str(v5b) + " pack=" + str(v5t)
          + " sp=" + str(v5b / v5t) + "x  maxdiff=" + str(md5) + " st=" + str(st5))

    # ---- (B) 2 thread packed cung luc (re-entrancy) -------------------------
    tm: "i64" = 256
    tk: "i64" = 320
    j1ad = _cy_z(tm * tk)
    j1bd = _cy_z(tk * tm)
    j1cd = _cy_z(tm * tm)
    j2ad = _cy_z(tm * tk)
    j2bd = _cy_z(tk * tm)
    j2cd = _cy_z(tm * tm)
    h1 = thread_spawn(_cy_one, _CyJob(j1ad, j1bd, j1cd, tm, tm, tk, 256, 11))
    h2 = thread_spawn(_cy_one, _CyJob(j2ad, j2bd, j2cd, tm, tm, tk, 256, 22))
    r1 = thread_join(h1)
    r2 = thread_join(h2)
    ref1 = _cy_z(tm * tm)
    ref2 = _cy_z(tm * tm)
    _r1 = _cy_ref(j1ad, j1bd, ref1, tm, tm, tk)
    _r2 = _cy_ref(j2ad, j2bd, ref2, tm, tm, tk)
    mdt1 = _cy_maxdiff(j1cd, ref1, tm * tm)
    mdt2 = _cy_maxdiff(j2cd, ref2, tm * tm)
    print("CY(B) 2-thread packed st=" + str(r1) + "/" + str(r2)
          + " maxdiff=" + str(mdt1) + "/" + str(mdt2) + " (khong hang = PASS)")

    # ---- (C) mini tol 256^3 packed vs scalar --------------------------------
    am = _cy_z(256 * 256)
    bm = _cy_z(256 * 256)
    rvm = _cy_fill(am, 9)
    rvm2 = _cy_fill(bm, 10)
    cmr = _cy_z(256 * 256)
    cmp_ = _cy_z(256 * 256)
    _rm = _cy_ref(am, bm, cmr, 256, 256, 256)
    stc = _cy_pack(am, bm, cmp_, 256, 256, 256, 256, 256, 256, 0, 256, 256, 256, 0, 256)
    mdc = _cy_maxdiff(cmr, cmp_, 256 * 256)
    okc = 0
    if mdc <= 0.0001:
        okc = 1
    print("CY(C) mini tol 256^3 packed vs scalar: maxdiff=" + str(mdc)
          + " tol=0.0001 -> " + str(okc))
    print("CY done")
    return 0