# PROBE CI — M3c: KIEM DINH ALLOC (t_zeros) VA ZERO-FILL CHO C LON
#
# Boi canh (§14.6 M3b ket, M3c con lai cua menu `.tkv`):
#   - CB do ALLOC S4/S5 ~375-422 ms/call (vs S1/S3 ~15 ms) -> gia thuyet:
#     C = t_zeros([m,n]) interpreted append-0.0, chi phi ~ m*n ptu.
#   - M3c de nghi: tai su dung C da cap phat de bo ALLOC. NGHEN TRUOC (khong
#     wire) bang kha nang:
#       (1) chi phi ALLOC that cua C (t_zeros) theo kich thuoc;
#       (2) chi phi ZERO-FILL C (re-use bat buoc phai xoa C truoc moi goi);
#       (3) neu (2) ~ (1) -> re-use an het loi the -> M3c BUST.
#
# Gate (§13.2 — do truoc khi ket luan): neu ZERO_FILL >= 0.7 * ALLOC thi
#   re-use khong an toi -> M3c khong wire. Neu ZERO_FILL << ALLOC (< 0.3)
#   -> re-use con loi the -> xem lai (phai sua module-var state, vi
#   simd_matmul.tkv:430 cam gan bien module).
#
# Chu y ky thuat (bug P7 — converter list[f32]->list[f64 SAI IM LAM):
#   - Khong ep list[f64] bang float() copy (maxdiff=813056 loi). Day chong
#     chi DO THOI GIAN (now_ms), khong check gia tri -> khong can ep.
#   - now_ms() chi o main (bug #8). Vong nong typed 'i64' -> native (GĐ8).
#   - Input = 0 (FMA khong skip zero) — giong CG/CB.
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_ci.tkv out/ci.exe main
#   out/ci.exe

import tv.training.tensor
import tv.training.simd_matmul
import tv.training.gpt2_ref124

def _ci_min2(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

# zero-fill vung that cua C (mimic viec xoa truoc moi goi khi re-use)
def _ci_zero_f(cd: "list[f32]", tot: 'i64') -> 'i64':
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < tot:
        cd[i] = z
        i = i + 1
    return tot

def main() -> 'i32':
    # 2 shape lon (m*n ~ 51.5M / 38.6M) — giong S5 logits / S4 dwte C
    m1 = 1024
    n1 = 50257
    m2 = 50257
    n2 = 768
    rs = 3
    tot1 = m1 * n1
    tot2 = m2 * n2

    # ---- (1) ALLOC: t_zeros([m,n]) — best-of rs ---------------------------
    t0 = now_ms()
    C1 = t_zeros([m1, n1])
    t1 = now_ms()
    v1 = t1 - t0
    r = 1
    while r < rs:
        t0 = now_ms()
        C1 = t_zeros([m1, n1])
        t1 = now_ms()
        v1 = _ci_min2(v1, t1 - t0)
        r = r + 1

    t0 = now_ms()
    C2 = t_zeros([m2, n2])
    t1 = now_ms()
    v2 = t1 - t0
    r = 1
    while r < rs:
        t0 = now_ms()
        C2 = t_zeros([m2, n2])
        t1 = now_ms()
        v2 = _ci_min2(v2, t1 - t0)
        r = r + 1

    # ---- (2) ZERO-FILL: _ci_zero_f tren C da cap phat — best-of rs --------
    cd1 = C1.data
    z1 = 0
    t0 = now_ms()
    z1 = _ci_zero_f(cd1, tot1)
    t1 = now_ms()
    w1 = t1 - t0
    r = 1
    while r < rs:
        t0 = now_ms()
        z1 = _ci_zero_f(cd1, tot1)
        t1 = now_ms()
        w1 = _ci_min2(w1, t1 - t0)
        r = r + 1

    cd2 = C2.data
    z2 = 0
    t0 = now_ms()
    z2 = _ci_zero_f(cd2, tot2)
    t1 = now_ms()
    w2 = t1 - t0
    r = 1
    while r < rs:
        t0 = now_ms()
        z2 = _ci_zero_f(cd2, tot2)
        t1 = now_ms()
        w2 = _ci_min2(w2, t1 - t0)
        r = r + 1

    print("CI S5 logits [1024x50257] ptu=" + str(z1) + " ALLOC=" + str(v1)
          + " ms  ZERO_FILL=" + str(w1) + " ms  ratio(zero/alloc)=" + str(w1 / v1))
    print("CI S4 dwte  [50257x768] ptu=" + str(z2) + " ALLOC=" + str(v2)
          + " ms  ZERO_FILL=" + str(w2) + " ms  ratio(zero/alloc)=" + str(w2 / v2))
    print("CI done")
    return 0
