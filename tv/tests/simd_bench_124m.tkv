# BENCH 124M — GPT-2 that (12/12/768, vocab50257), seq8 cung fixture g2
# Import CHI ref124 + trainer: KHONG import gpt2_ref/gpt2_train (mirror nho 256/64).
# Flatten/unflatten/group inline (ps-driven) vi gpt2_train gan voi ban nho.
# In so lieu tong ms + so buoc (chia tay ngoai):
#   tkvc tv/tests/simd_bench_124m.tkv %TEMP%/b124.exe main && %TEMP%/b124.exe
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> "list[f32]":
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

# ---- forward + loss (ban sao gpt2_fwd_ps, ten rieng de tranh clash) --------
def _f124_loss(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'f32':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    z = gpt2_forward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                     ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd)
    return gpt2_loss(z, ids)

# ---- backward (ban sao gpt2_bwd_ps) ----------------------------------------
def _f124_bwd(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32',
              gflat: 'list[f32]' = None) -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_backward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                         ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd, gflat)

# ---- 1 buoc train day du (ban sao gpt2_train_step, flatten inline) ----------
# (P1.2 fused da REVERT sau probe simd_probe_ah: fused cham hon — giu 2 vong.)
def _step124(opt: "AdamW", ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'f32':
    loss = _f124_loss(ps, ids, pos, simd)
    # P1.1: bwd ghi THANG param grads vao opt.g (da zero) — bo mat grads +
    # GRAD_ACC (probe AL: bit-exact vs duong cu, maxdiff=0.0/28 nhom).
    opt.zero_grad()
    grads = _f124_bwd(ps, ids, pos, simd, opt.g)
    opt.step()
    # ghi trong so da cap nhat tro lai tensor (unflatten inline)
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)
    return loss

# ---- chuan bi: nhom + copy ps vao opt.p (inline) ---------------------------
def _prepare(opt: "AdamW", ps: 'list[Tensor]') -> 'i32':
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            opt.p[off + j] = d[j]
        off = off + len(d)
    return 0

def _n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def _groups(ps: 'list[Tensor]') -> 'list[i64]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def _mk_opt(n: 'i64', groups: 'list[i64]', total: 'i64') -> "AdamW":
    return new_adamw_g(n, groups, 2, total, 0.05, 0.0025, 0.9, 0.999,
                       0.00000001, 0.0, 1.0)

def main() -> 'i32':
    print("BENCH 124M sanity: VocabSize=" + str(VocabSize) + " NLayers=" + str(NLayers))
    FIX = "tv/tests/fixtures/"
    ids = load_ints(FIX + "g2_ids.txt")
    pos = load_ints(FIX + "g2_pos.txt")
    print("BENCH 124M seq n=" + str(len(ids)))

    # ---- pha SIMD: warmup 1 + 3 buoc do ------------------------------------
    ps = gpt2_init(7)
    n = _n_param(ps)
    print("BENCH 124M n_param=" + str(n) + " tensors=" + str(len(ps)))
    groups = _groups(ps)
    opt = _mk_opt(n, groups, 4)
    _prepare(opt, ps)
    lw = _step124(opt, ps, ids, pos, 1)
    t0 = now_ms()
    l1 = _step124(opt, ps, ids, pos, 1)
    l2 = _step124(opt, ps, ids, pos, 1)
    l3 = _step124(opt, ps, ids, pos, 1)
    dt_v = now_ms() - t0
    print("BENCH C tkv-simd   train step seq8: total=" + str(dt_v) + " ms steps=3 (warmup=1) losses="
          + str(lw) + " -> " + str(l1) + " -> " + str(l3))

    # ---- pha SCALAR: 1 buoc (khong warmup — bao cao la cold) --------------
    ps = gpt2_init(7)
    groups = _groups(ps)
    opt = _mk_opt(n, groups, 2)
    _prepare(opt, ps)
    t0 = now_ms()
    l0s = _step124(opt, ps, ids, pos, 0)
    dt_s = now_ms() - t0
    print("BENCH C tkv-scalar train step seq8: total=" + str(dt_s) + " ms steps=1 (no warmup) loss="
          + str(l0s))
    print("BENCH done")
    return 0
