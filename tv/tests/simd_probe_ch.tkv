                pw = _ch_imin(T, k - p0)
                j0 = _ch_j0(g11, stride, n_j, T)
                jb = _ch_imin(T, n - j0)
                _ch_do(Ct, ta1_11, tb1_11, T, cd, i0, ib, j0, jb, n)
        wave = wave + 1
    return C

# ---- main: do baseline PD vs pipeline + BIT + alloc, 4 shape P7b ---------
# Moi shape: baseline smm_*_pd best-of-2, pipeline best-of-2, BIT maxdiff,
# in speedup. S3/S4/S5 la shape WAVE (vol > 40M) — gat wire >= 1.3x + BIT=0.
# S1 di serial (vol 4.7M < 40M) — pipeline khong nham, ghi nhan suy nghi.

def main() -> 'i64':
    rs = 2
    nq = 1024
    h = 768
    V = 50257
    four = 3072

    print("CH M3a: pipeline build(w+1)||replay(w) vs baseline PD")

    # ---- S3 dxf [nq, V] x [V, h] = smm_fwd_pd --------------------------------
    a3 = t_zeros([nq, V])
    b3 = t_zeros([V, h])
    _ch_fill(a3, 3)
    _ch_fill(b3, 4)
    v3b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3b = smm_fwd_pd(a3, b3, nq, h, V)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3b:
            v3b = d3
        kk = kk + 1
    v3p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3p = _ch_core_pipe(a3, b3, nq, h, V, h, 0, 0)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3p:
            v3p = d3
        kk = kk + 1
    bit3 = _ch_maxdiff(c3b, c3p, nq * h)
    print("S3 dxf    base=" + str(v3b) + " pipe=" + str(v3p) + " sp=" + str(v3b / v3p) + "x BIT=" + str(bit3))

    # ---- S4 dwte [nq, V] x [nq, h] = smm_fwd_at_pd (trans_a=1) --------------
    a4 = t_zeros([nq, V])
    b4 = t_zeros([nq, h])
    _ch_fill(a4, 5)
    _ch_fill(b4, 6)
    v4b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4b = smm_fwd_at_pd(a4, b4, V, h, nq)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4b:
            v4b = d4
        kk = kk + 1
    v4p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4p = _ch_core_pipe(a4, b4, V, h, nq, h, 0, 1)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4p:
            v4p = d4
        kk = kk + 1
    bit4 = _ch_maxdiff(c4b, c4p, V * h)
    print("S4 dwte   base=" + str(v4b) + " pipe=" + str(v4p) + " sp=" + str(v4b / v4p) + "x BIT=" + str(bit4))

    # ---- S5 logits [nq, h] x [V, h] = smm_dot_pd (trans_b=1) ----------------
    a5 = t_zeros([nq, h])
    b5 = t_zeros([V, h])
    _ch_fill(a5, 7)
    _ch_fill(b5, 8)
    v5b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5b = smm_dot_pd(a5, b5, nq, V, h)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5b:
            v5b = d5
        kk = kk + 1
    v5p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5p = _ch_core_pipe(a5, b5, nq, V, h, h, 1, 0)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5p:
            v5p = d5
        kk = kk + 1
    bit5 = _ch_maxdiff(c5b, c5p, nq * V)
    print("S5 logits base=" + str(v5b) + " pipe=" + str(v5p) + " sp=" + str(v5b / v5p) + "x BIT=" + str(bit5))

    # ---- S1 dx1 [nq, four] x [h, four] = smm_dot_pd (SERIAL — vol < 40M) ----
    a1 = t_zeros([nq, four])
    b1 = t_zeros([h, four])
    _ch_fill(a1, 1)
    _ch_fill(b1, 2)
    v1b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c1b = smm_dot_pd(a1, b1, nq, h, four)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < v1b:
            v1b = d1
        kk = kk + 1
    v1p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c1p = _ch_core_pipe(a1, b1, nq, h, four, four, 1, 0)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < v1p:
            v1p = d1
        kk = kk + 1
    bit1 = _ch_maxdiff(c1b, c1p, nq * h)
    print("S1 dx1    base=" + str(v1b) + " pipe=" + str(v1p) + " sp=" + str(v1b / v1p) + "x BIT=" + str(bit1) + " (serial route, pipeline khong nham)")

    # ---- chi phi alloc 48 buffer (T=768) -------------------------------------
    T7 = 768
    t0 = now_ms()
    ba0 = _ch_zeros(T7 * T7)
    ba1 = _ch_zeros(T7 * T7)
    ba2 = _ch_zeros(T7 * T7)
    ba3 = _ch_zeros(T7 * T7)
    ba4 = _ch_zeros(T7 * T7)
    ba5 = _ch_zeros(T7 * T7)
    ba6 = _ch_zeros(T7 * T7)
    ba7 = _ch_zeros(T7 * T7)
    ba8 = _ch_zeros(T7 * T7)
    ba9 = _ch_zeros(T7 * T7)
    ba10 = _ch_zeros(T7 * T7)
    ba11 = _ch_zeros(T7 * T7)
    bb0 = _ch_zeros(T7 * T7)
    bb1 = _ch_zeros(T7 * T7)
    bb2 = _ch_zeros(T7 * T7)
    bb3 = _ch_zeros(T7 * T7)
    bb4 = _ch_zeros(T7 * T7)
    bb5 = _ch_zeros(T7 * T7)
    bb6 = _ch_zeros(T7 * T7)
    bb7 = _ch_zeros(T7 * T7)
    bb8 = _ch_zeros(T7 * T7)
    bb9 = _ch_zeros(T7 * T7)
    bb10 = _ch_zeros(T7 * T7)
    bb11 = _ch_zeros(T7 * T7)
    bc0 = _ch_zeros(T7 * T7)
    bc1 = _ch_zeros(T7 * T7)
    bc2 = _ch_zeros(T7 * T7)
    bc3 = _ch_zeros(T7 * T7)
    bc4 = _ch_zeros(T7 * T7)
    bc5 = _ch_zeros(T7 * T7)
    bc6 = _ch_zeros(T7 * T7)
    bc7 = _ch_zeros(T7 * T7)
    bc8 = _ch_zeros(T7 * T7)
    bc9 = _ch_zeros(T7 * T7)
    bc10 = _ch_zeros(T7 * T7)
    bc11 = _ch_zeros(T7 * T7)
    bd0 = _ch_zeros(T7 * T7)
    bd1 = _ch_zeros(T7 * T7)
    bd2 = _ch_zeros(T7 * T7)
    bd3 = _ch_zeros(T7 * T7)
    bd4 = _ch_zeros(T7 * T7)
    bd5 = _ch_zeros(T7 * T7)
    bd6 = _ch_zeros(T7 * T7)
    bd7 = _ch_zeros(T7 * T7)
    bd8 = _ch_zeros(T7 * T7)
    bd9 = _ch_zeros(T7 * T7)
    bd10 = _ch_zeros(T7 * T7)
    bd11 = _ch_zeros(T7 * T7)
    t1 = now_ms()
    print("alloc 48 buffer (T=768): " + str(t1 - t0) + " ms")

    print("CH done")
    return 0