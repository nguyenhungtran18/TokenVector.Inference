# PROBE CJ7 — M5-OPT A/B BIT-EXACT (khong doi code train)
# ---------------------------------------------------------------------------
# Muc do: step() hien tai goi 5 copy/buoc (CY3: 78ms/124M moi copy):
#   r1 g list->buf | r2 p list->buf | adamw | r3 p buf->list | r4 m buf->list | r5 v buf->list
# M5-opt bo r2/r4/r5 (state m/v chi o buffer, p push 1 lan luc setup),
# giam 234ms/buoc @124M + ~1GB RAM (lazy m/v list). Kiem chung BIT-EXACT:
#   arm A = goi truc tiep method step() cu (5 copy)
#   arm B = vong step thay the (chi r1 + adamw + r3), p da push luc init
#   3 buoc, clip ON (g lon) va OFF (g nho), so p list A/B + m/v (A list vs B buf).
# RAM: n=3M (12MB/ban) -> an toan tuyet doi, khong dung 124M.
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj7.tkv out/cj7.exe main
import tv.training.tensor
import tv.training.trainer

def _zl(n: 'i64') -> "list[f32]":
    out = []
    for i in range(n):
        out.append((float(0) - 0.0) / 1.0)
    return out

def _maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def _fill(v: "list[f32]", n: 'i64', seed: 'i64', amp: 'f32') -> 'i64':
    i = 0
    while i < n:
        v[i] = float(((i * 131 + seed) % 97) - 48) * amp
        i = i + 1
    return n

def _step_b(opt: "AdamW") -> 'f32':
    # Ban sao step() — M5-opt: BO r2 (p list->buf) va r4/r5 (m/v buf->list).
    # P van sync ve list qua r3 (doc boi unflatten/bench); m/v chi o buffer
    # (ckpt_save tu sync, test doc read_f32(pm)). Cong thuc giu nguyen GĐ10.
    lr = lr_at(opt.t, opt.warmup, opt.total, opt.lr_max, opt.lr_min)
    gn = opt.grad_norm()
    coef = 1.0
    if gn > 0.0:
        coef = opt.clip / (gn + 0.000001)
        if coef > 1.0:
            coef = 1.0
    t1 = opt.t + 1
    bc1 = 1.0 - _bp(opt.b1, t1)
    bc2 = 1.0 - _bp(opt.b2, t1)
    step_size = lr / bc1
    bc2s = sqrt(bc2)
    epss = opt.eps * bc2s
    ks = step_size * bc2s
    gl: "list[f32]" = opt.g
    pl: "list[f32]" = opt.p
    pgl: "i64" = opt.pg
    ppl: "i64" = opt.pp
    pml: "i64" = opt.pm
    pvl: "i64" = opt.pv
    ptl: "i64" = opt.pt
    ponl: "i64" = opt.pone
    r1 = f32_copy_to_buf(gl, pgl, opt.n)
    gsrc: "i64" = pgl
    if coef != 1.0:
        rzp = f32_zero(ptl, opt.n)
        rax = f32_addcmul(ptl, pgl, ponl, coef, opt.n)
        gsrc = ptl
    wde = opt.wd * bc1
    stw = adamw_step(ppl, pml, pvl, gsrc, opt.n,
                     step_size, opt.b1, opt.b2, opt.eps, wde, bc1, bc2s)
    r3 = f32_copy_from_buf(ppl, pl, opt.n)
    opt.t = opt.t + 1
    return lr

def _report(tag: 'str', d: 'f64', tol: 'f64') -> 'i64':
    if d <= tol:
        print("  [PASS] " + tag + " md=" + str(d))
        return 0
    print("  [FAIL] " + tag + " md=" + str(d) + " > tol " + str(tol))
    return 1

def _arm_pair(n: 'i64', amp: 'f32', tag: 'str') -> 'i64':
    # 2 AdamW cung init p/g, 3 buoc: A = step() goc (5 copy), B = _step_b (3 pha)
    grp: "list[i64]" = []
    grp.append(n)
    oa = new_adamw_g(n, grp, 2, 10, 0.05, 0.0025, 0.9, 0.999,
                     0.00000001, 0.0, 1.0)
    ob = new_adamw_g(n, grp, 2, 10, 0.05, 0.0025, 0.9, 0.999,
                     0.00000001, 0.0, 1.0)
    _fill(oa.p, n, 7, 0.001)
    _fill(ob.p, n, 7, 0.001)
    _fill(oa.g, n, 13, amp)
    _fill(ob.g, n, 13, amp)
    # arm B: push p list -> buf 1 lan luc setup (thay r2 moi buoc)
    pbl: "list[f32]" = ob.p
    pbp: "i64" = ob.pp
    rpush = f32_copy_to_buf(pbl, pbp, n)
    fails = 0
    for s in range(3):
        la = oa.step()
        lb = _step_b(ob)
    # p: ca 2 deu r3 buf->list -> so truc tiep
    dp = _maxdiff(oa.p, ob.p, n)
    fails = fails + _report(tag + " p sau 3 buoc", dp, 0.0)
    # m/v: A list (r4/r5), B chi o buffer -> copy B ra tmp de so
    tm: "list[f32]" = _zl(n)
    tvv: "list[f32]" = _zl(n)
    bpm: "i64" = ob.pm
    bpv: "i64" = ob.pv
    cm = f32_copy_from_buf(bpm, tm, n)
    cv = f32_copy_from_buf(bpv, tvv, n)
    dm = _maxdiff(oa.m, tm, n)
    dv = _maxdiff(oa.v, tvv, n)
    fails = fails + _report(tag + " m (A list vs B buf)", dm, 0.0)
    fails = fails + _report(tag + " v (A list vs B buf)", dv, 0.0)
    # t + lr deu
    if oa.t != ob.t:
        print("  [FAIL] " + tag + " t " + str(oa.t) + " != " + str(ob.t))
        fails = fails + 1
    return fails

def main() -> 'i32':
    n: "i64" = 3000000
    print("CJ7 M5-opt A/B n=" + str(n))
    fails = 0
    # clip ON: g amp lon -> gn >> 1 -> coef < 1
    fails = fails + _arm_pair(n, 0.01, "clipON")
    # clip OFF: g rat nho -> gn < 1... khang dinh bang amp nho
    fails = fails + _arm_pair(n, 0.0000001, "clipOFF")
    if fails == 0:
        print("CJ7 ALL PASS (bit-exact 0.0)")
    else:
        print("CJ7 FAILS=" + str(fails))
    return fails
