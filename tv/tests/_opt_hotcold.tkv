# PROBE OPT HOT vs COLD (2026-11-11) — 532 ms (probe) vs 781 ms (BPHASE)
#
# Cau hoi: vi sao opt.step() do rieng = 532 ms, nhung trong production = 781 ms?
#
# Gia thuyet H2 (cache eviction): giua hai lan opt.step() trong production co
# fwd+bwd quet vai GB, day opt.p/m/v (1.42 GB) ra khoi L3 (35 MB tren Xeon nay).
# Lan goi ke tiep phai stream tu DRAM -> cham hon.
# Probe cu goi 3 lan LIEN TIEP nen opt.p con nong -> 532 ms.
#
# Thi nghiem:
#   A: opt.step() 3 lan LIEN TIEP (nong)        -> in tung lan
#   B: quet 474 MB roi opt.step(), 3 lan (nguoi) -> in tung lan
#
# Neu A ~ 532 va B ~ 781 -> H2 DUNG (cache eviction, khong phai page fault).
# Neu ca hai ~ 781        -> khong phai nhiet do, ma la chi phi that.
# Neu ca hai ~ 532        -> 781 den tu cho khac trong BPHASE.
import tv.training.gpt2_ref124
import tv.training.trainer


def _mk_groups(n: "i32") -> "list[i64]":
    """148 group nhu production (_groups(ps): moi tensor 1 group)."""
    out: "list[i64]" = []
    k: "i32" = 0
    while k < 147:
        out.append(768)
        k = k + 1
    out.append(n - 147 * 768)
    return out


def mk_opt(n: "i64", groups: "list[i64]") -> "AdamW":
    return new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999,
                       0.00000001, 0.0, 1.0)


def step_once(opt: "AdamW") -> "f64":
    t0 = now_ms()
    lr = opt.step()
    t1 = now_ms()
    return float(t1 - t0)


def sweep(z: "list[f32]", n: "i32") -> "f64":
    """Quet toan bo 474 MB de day cache ra — mo phong fwd+bwd xen giua."""
    t0 = now_ms()
    s: "f32" = f32(f32_grad_norm(z, n))
    t1 = now_ms()
    return float(t1 - t0)


def run_hot(opt: "AdamW") -> "f64":
    print("--- A: opt.step() 3 lan LIEN TIEP (nong) ---")
    best: "f64" = 1.0e9
    k: "i32" = 0
    while k < 3:
        d: "f64" = step_once(opt)
        print("  lan " + str(k + 1) + " : " + str(d) + " ms")
        if d < best:
            best = d
        k = k + 1
    print("  min = " + str(best) + " ms")
    return best


def run_cold(opt: "AdamW", z: "list[f32]", n: "i32") -> "f64":
    print("--- B: quet 474 MB roi opt.step(), 3 lan (nguoi) ---")
    best: "f64" = 1.0e9
    k: "i32" = 0
    while k < 3:
        sw: "f64" = sweep(z, n)
        d: "f64" = step_once(opt)
        print("  lan " + str(k + 1) + " : quet=" + str(sw) + " ms  step=" + str(d) + " ms")
        if d < best:
            best = d
        k = k + 1
    print("  min step = " + str(best) + " ms")
    return best


def report(ha: "f64", hb: "f64") -> "i32":
    print("")
    print("--- tong hop ---")
    print("A nong = " + str(ha) + " ms")
    print("B nguoi= " + str(hb) + " ms")
    print("chenh  = " + str(hb - ha) + " ms")
    print("")
    print("--- doc ---")
    print("A~532, B~781 -> H2 DUNG: cache eviction, khong phai page fault.")
    print("Ca hai ~781  -> chi phi that, khong co gi de tiet kiem bang cach giu nong.")
    print("Ca hai ~532  -> 781 den tu cho khac trong BPHASE, phai do lai mode 2.")
    return 0


def main() -> 'i32':
    print("=== PROBE OPT HOT vs COLD ===")
    n: "i32" = 124439808
    print("n = " + str(n) + "  (" + str(float(n * 4) / 1048576.0) + " MB)")
    print("")
    groups: "list[i64]" = _mk_groups(n)
    opt = mk_opt(n, groups)
    # warm: mot lan de trang da map va kernel da JIT
    w: "f64" = step_once(opt)
    print("warm = " + str(w) + " ms")
    print("")
    ha: "f64" = run_hot(opt)
    print("")
    hb: "f64" = run_cold(opt, zeros_list(n), n)
    print("")
    return report(ha, hb)
