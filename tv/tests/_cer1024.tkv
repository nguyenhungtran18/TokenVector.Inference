# PROBE CER — do 3 vong "ceremony" trong gpt2_block_bwd (HANDOFF §0.66 muc C)
# -------------------------------------------------------------------------
# Ceremony do duoc = 156 ms/block = 1.9 s/buoc (11%), gom:
#   1  dr  = t_zeros([n,h]); dr[i] = gout[i]                 (copy n*h)
#   2  dr[i] = dr[i] + drl2[i]                               (add n*h)
#   3  dx  = t_zeros([n,h]); dx[i] = drl1[i] + dr[i]         (2 add n*h)
# va 1 vong tuong tu o gpt2_backward (gwpe -> gflat, MaxPos*h).
#
# Probe nay so vong .tkv tay voi builtin f32_list_add (native) de biet win that
# truoc khi sua production. LUU Y: t_zeros da zero san nen `0 + x` = `x` chinh xac
# -> thay copy bang f32_list_add la BIT-EXACT, khong phai "gan dung".
#
# Chay: dotnet out/cer1024.exe   (khong can seq)
import tv.training.gpt2_ref124

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    nh = n * h
    print("CR n*h = " + str(nh))

    a = t_zeros([n, h])
    b = t_zeros([n, h])
    c = t_zeros([n, h])
    ad = a.data
    i = 0
    while i < nh:
        ad[i] = 0.1
        i = i + 1
    bd = b.data
    i = 0
    while i < nh:
        bd[i] = 0.2
        i = i + 1

    b_alloc = 1.0e9
    b_loop = 1.0e9
    b_builtin = 1.0e9
    k = 0
    while k < 3:
        t0 = now_ms()
        d1 = t_zeros([n, h])
        d2 = t_zeros([n, h])
        t1 = now_ms()
        dd = d1.data
        i = 0
        while i < nh:
            dd[i] = ad[i]
            i = i + 1
        dd = d2.data
        i = 0
        while i < nh:
            dd[i] = dd[i] + bd[i]
            i = i + 1
        t2 = now_ms()
        e1 = t_zeros([n, h])
        e2 = t_zeros([n, h])
        ed1: "list[f32]" = e1.data
        ed2: "list[f32]" = e2.data
        r1 = f32_list_add(ed1, ad, nh)
        r2 = f32_list_add(ed2, bd, nh)
        r3 = f32_list_add(ed2, ad, nh)
        t3 = now_ms()
        if t1 - t0 < b_alloc:
            b_alloc = t1 - t0
        if t2 - t1 < b_loop:
            b_loop = t2 - t1
        if t3 - t2 < b_builtin:
            b_builtin = t3 - t2
        k = k + 1

    print("CR 2x t_zeros      = " + str(b_alloc) + " ms")
    print("CR loop copy+add   = " + str(b_loop) + " ms  (2 vong n*h)")
    print("CR 3x f32_list_add = " + str(b_builtin) + " ms")
    return 0
