# PROBE 20 — torch_gelu_bwd: rc + thoi gian (3.1M phan tu).
import tv.training.tensor

def main() -> 'i32':
    n = 1024 * 3072
    x = t_zeros([n])
    gy = t_zeros([n])
    y = t_zeros([n])
    xd = x.data
    gyd = gy.data
    yd = y.data
    r0 = torch_gelu_bwd(gyd, xd, yd, n)
    print("TGB rc=" + str(r0))
    t0 = now_ms()
    r1 = torch_gelu_bwd(gyd, xd, yd, n)
    r2 = torch_gelu_bwd(gyd, xd, yd, n)
    r3 = torch_gelu_bwd(gyd, xd, yd, n)
    r4 = torch_gelu_bwd(gyd, xd, yd, n)
    r5 = torch_gelu_bwd(gyd, xd, yd, n)
    t1 = now_ms()
    print("TGB rc=" + str(r1) + str(r2) + str(r3) + str(r4) + str(r5) + " 5x=" + str(t1 - t0) + " ms")
    return 0
