# PROBE FIELD READ (HANDOFF §0.132 - uu tien (c), buoc 3)
# Phat hien: chep than opt.step() ra main = 484 ms, nhung goi opt.step() = 1157 ms.
# Cung phep tinh, ho 673 ms. Nghi: doc field `list[f32]` tren class instance
# (self.g, self.p) COPY ca list 124M phan tu, con bien local thi khong.
#
# Probe nay do truc tiep chi phi doc tung field.
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_field_read.tkv out/frd.exe main
#   copy -> out/frd_n10.dll + runtimeconfig ; dotnet out/frd_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.trainer

def main() -> 'i32':
    n = 124439808
    print("=== FIELD READ n=" + str(n) + " ===")

    groups: "list[i64]" = [n]
    opt = new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999, 1.0e-8, 0.0, 1.0)

    # ---- 1) doc field list self.g ----
    best1 = 1.0e9
    kk = 0
    while kk < 3:
        t0 = now_ms()
        for i in range(5):
            _x = opt.g
        dt = now_ms() - t0
        if dt < best1:
            best1 = dt
        kk = kk + 1
    print("1) 5x doc opt.g (list)        best-of-3 ms=" + str(best1) + "  -> per-read " + str(best1 / 5.0))

    # ---- 2) doc field list self.p ----
    best2 = 1.0e9
    kk = 0
    while kk < 3:
        t0 = now_ms()
        for i in range(5):
            _x = opt.p
        dt = now_ms() - t0
        if dt < best2:
            best2 = dt
        kk = kk + 1
    print("2) 5x doc opt.p (list)        best-of-3 ms=" + str(best2) + "  -> per-read " + str(best2 / 5.0))

    # ---- 3) doc field scalar i64 (buffer handle) ----
    best3 = 1.0e9
    kk = 0
    while kk < 3:
        t0 = now_ms()
        for i in range(5):
            _x = opt.pp
            _y = opt.pm
            _z = opt.pv
            _w = opt.pg
        dt = now_ms() - t0
        if dt < best3:
            best3 = dt
        kk = kk + 1
    print("3) 5x doc 4 field i64         best-of-3 ms=" + str(best3) + "  -> per-read " + str(best3 / 5.0))

    # ---- 4) doc field qua bien local trung gian (duong step() dang lam) ----
    best4 = 1.0e9
    kk = 0
    while kk < 3:
        t0 = now_ms()
        for i in range(5):
            _g = opt.g
            _p = opt.p
            _pg = opt.pg
            _pp = opt.pp
            _pm = opt.pm
            _pv = opt.pv
            _pt = opt.pt
            _po = opt.pone
        dt = now_ms() - t0
        if dt < best4:
            best4 = dt
        kk = kk + 1
    print("4) 5x doc 8 field (nhu step)  best-of-3 ms=" + str(best4) + "  -> per-read " + str(best4 / 5.0))

    # ---- 5) so sanh: doc bien local list (khong qua field) ----
    lg = opt.g
    lp = opt.p
    best5 = 1.0e9
    kk = 0
    while kk < 3:
        t0 = now_ms()
        for i in range(5):
            _x = lg
            _y = lp
        dt = now_ms() - t0
        if dt < best5:
            best5 = dt
        kk = kk + 1
    print("5) 5x doc bien local (2 list) best-of-3 ms=" + str(best5) + "  -> per-read " + str(best5 / 5.0))

    # ---- 6) len() de chac chan list that su 124M ----
    print("6) len(opt.g)=" + str(len(opt.g)) + "  len(opt.p)=" + str(len(opt.p)))
    return 0
