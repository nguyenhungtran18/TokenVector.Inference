# PROBE NT5 — chot hanh vi runtime voi `erf(v/s)` (arg div f64 -> param f32)
# va toan bo dgelu cua op_gelu_erf_bwd. C doc file nay, doi 2 kieu:
#   A: ep f32 truoc khi vao erf (JIT truncate)   B: giu f64
# Chi kieu nao khop 100% moi duoc di native.
# Chay: D:\TokenVector\Release\dist\tkvc-tv.exe tv/tests/_nt5.tkv out/nt5.exe main
#       cmd /c "dotnet out\nt5_n10.dll > out\nt5_tkv.txt"
#       build tools/simd_native/test_nt5b.c -> test_nt5b.exe out\nt5_tkv.txt
import tv.training.tensor

def _bi(v: 'f32') -> 'i32':
    p = alloc_bytes(4)
    write_f32(p, 0, v)
    b = read_i32(p, 0)
    free_bytes(p)
    return b

def _e(v: 'f32') -> 'f32':
    s = 1.4142135623730951
    return erf(v / s)

def _dg(v: 'f32', gy: 'f32') -> 'f32':
    s = 1.4142135623730951
    dgelu = 0.5 * (1.0 + erf(v / s)) + v * 0.3989422804014327 * exp(-0.5 * v * v)
    out = t_zeros([1])
    out.data[0] = gy * dgelu
    return out.data[0]

def main() -> 'i32':
    tv = t_zeros([401])
    k = 0
    while k < 401:
        tv.data[k] = float(k) * 0.04 - 8.0
        k = k + 1
    k = 0
    while k < 401:
        print("NT5 v=" + hex(_bi(tv.data[k])) + " e=" + hex(_bi(_e(tv.data[k]))) + " g=" + hex(_bi(_dg(tv.data[k], 0.75))))
        k = k + 1
    return 0
