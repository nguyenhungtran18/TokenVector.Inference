# PROBE BP — P6 GĐ6: (A) smm_fwd_at THAY transpose+smm_fwd ; (B) overlap
# geluB worker voi dw2 GEMM main (2026-10-21)
#
# Nen (probe BO @1024, 1 layer, whole mlp_bwd = 1000ms):
#   xT2 94ms + xT1 15ms (r2) + r1 co xT (15ms) = ~109ms/layer phi transpose
#   geluB = 62ms (chay serial sau r2, truoc r1)
#
# BP[1] smm_fwd_at: production hien tai:
#     xT = smm_transpose(x, n, in_d); dw = smm_fwd(xT, gy, in_d, out_d, n)
#   -> de nghi: dw = smm_fwd_at(x, gy, in_d, out_d, n)
#   a = x da luu [k=n_tok hang][m=in_d cot] (trans-A doc truc tiep, khong
#   materialize). P5.8 da chung minh BIT-EXACT voi smm_fwd (probe AX),
#   thu tu tich luy p0 tang dan giu nguyen. Probe KIEM TRA LAI maxdiff=0.0
#   tren 2 shape r2 (in=4h,out=h) + r1 (in=h,out=4h) + do timing.
#
# BP[2] overlap: worker chay op_gelu_erf_bwd(inner, dx2) (doc dx2 da xong,
#   ghi d_inner RIENG) DONG THOI main chay dw2 GEMM. An toan: gelu khong goi
#   simd_gemm (khong chia se g_job); main doc x/gout (khong doc d_inner).
#   Risk: op_gelu_erf_bwd NOI BO spawn 12 worker -> nested spawn tu worker
#   thread — chua ai test -> day la lan dau. Neu crash => bo dieng.
#   Do: t_par = spawn geluB + dw2 (main) + join vs t_ser = geluB + dw2 serial;
#   maxdiff d_inner giua 2 duong = 0.0.
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bp.tkv out/bp.exe main
#   ./out/bp.exe

import tv.training.gpt2_ref124
import tv.training.simd_matmul
import tv.training.ops

def _bp_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _bp_md(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    m = 0.0
    for i in range(cnt):
        d = a[i] - b[i]
        if d < 0.0:
            d = -d
        if d > m:
            m = d
    return m

# ---- fill (moi ham MOT list phang) ----------------------------------------
def _bp_fx(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 131) % 97) - 48) * 0.011)
    return out

def _bp_fw1(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 77) % 89) - 44) * 0.0091)
    return out

def _bp_fw2(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 149) % 101) - 50) * 0.0083)
    return out

def _bp_fg(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 173) % 103) - 51) * 0.013)
    return out

# ---- worker: gelu bwd (copy call production — op_gelu_erf_bwd) -----------
class _BpGJob:
    xd: "list[f32]"
    gyd: "list[f32]"
    n: 'i64'
    def __init__(self, xd: "list[f32]", gyd: "list[f32]", n: 'i64'):
        self.xd = xd
        self.gyd = gyd
        self.n = n

def _bp_gelu_one(j: "_BpGJob") -> 'i64':
    # 1 worker goi op_gelu_erf_bwd (NOI BO spawn 12 nua — nested spawn),
    # copy ket qua ve list RIENG cua record (record khong nhan Tensor)
    xt2 = t_new(j.xd, [j.n])
    gt2 = t_new(j.gyd, [j.n])
    r = op_gelu_erf_bwd(xt2, gt2)
    for i in range(j.n):
        j.gyd[i] = r.data[i]
    return 0

def main() -> 'i64':
    n = 1024
    h = HiddenSize
    ih = 4 * h

    xt = t_new(_bp_fx(n * h), [n, h])
    w1t = t_new(_bp_fw1(h * ih), [h, ih])
    w2t = t_new(_bp_fw2(ih * h), [ih, h])
    goutt = t_new(_bp_fg(n * h), [n, h])
    at = t_new(_bp_fx(n * ih), [n, ih])

    # ---- BP[1a] r2 shape: xT + smm_fwd  VS  smm_fwd_at --------------------
    v1a = 1.0e18
    v1b = 1.0e18
    krep = 0
    dw2ser = None
    dw2at = None
    while krep < 2:
        t0 = now_ms()
        xT2 = smm_transpose(at, n, ih)
        dw2ser = smm_fwd(xT2, goutt, ih, h, n)
        d1a = now_ms() - t0
        v1a = _bp_smt(v1a, d1a)
        t0 = now_ms()
        dw2at = smm_fwd_at(at, goutt, ih, h, n)
        d1b = now_ms() - t0
        v1b = _bp_smt(v1b, d1b)
        krep = krep + 1
    m1 = _bp_md(dw2ser.data, dw2at.data, ih * h)
    print("BP[1a] r2 dw: xT+smm_fwd = " + str(v1a) + " ms  smm_fwd_at = "
          + str(v1b) + " ms  maxdiff = " + str(m1))

    # ---- BP[1b] r1 shape: xT + smm_fwd  VS  smm_fwd_at --------------------
    v2a = 1.0e18
    v2b = 1.0e18
    krep = 0
    dw1ser = None
    dw1at = None
    gyt = t_new(_bp_fg(n * ih), [n, ih])
    while krep < 2:
        t0 = now_ms()
        xT1 = smm_transpose(xt, n, h)
        dw1ser = smm_fwd(xT1, gyt, h, ih, n)
        d2a = now_ms() - t0
        v2a = _bp_smt(v2a, d2a)
        t0 = now_ms()
        dw1at = smm_fwd_at(xt, gyt, h, ih, n)
        d2b = now_ms() - t0
        v2b = _bp_smt(v2b, d2b)
        krep = krep + 1
    m2 = _bp_md(dw1ser.data, dw1at.data, h * ih)
    print("BP[1b] r1 dw: xT+smm_fwd = " + str(v2a) + " ms  smm_fwd_at = "
          + str(v2b) + " ms  maxdiff = " + str(m2))

    # ---- BP[2] overlap geluB (worker) voi dw2 (main) ----------------------
    # du lieu: inner = at (x cua gelu), dx2 = smm_dot(gout, w2)
    dx2t = smm_dot(goutt, w2t, n, ih, h)
    xd = []
    for i in range(n * ih):
        xd.append(at.data[i])
    gyd = []
    for i in range(n * ih):
        gyd.append(dx2t.data[i])
    # serial reference
    t0 = now_ms()
    gser = op_gelu_erf_bwd(t_new(xd, [n, ih]), t_new(gyd, [n, ih]))
    dw2s = smm_fwd_at(at, goutt, ih, h, n)
    t_ser = now_ms() - t0
    # parallel: worker geluB + main dw2
    v3 = 1.0e18
    krep = 0
    gpar = None
    while krep < 2:
        gxd = []
        for i in range(n * ih):
            gxd.append(xd[i])
        ggy = []
        for i in range(n * ih):
            ggy.append(gyd[i])
        t0 = now_ms()
        hb = thread_spawn(_bp_gelu_one, _BpGJob(gxd, ggy, n * ih))
        dw2p = smm_fwd_at(at, goutt, ih, h, n)
        rj = thread_join(hb)
        d3 = now_ms() - t0
        v3 = _bp_smt(v3, d3)
        gpar = t_new(ggy, [n, ih])
        krep = krep + 1
    m3 = _bp_md(gser.data, gpar.data, n * ih)
    print("BP[2] serial geluB+dw2 = " + str(t_ser) + " ms  PAR(geluB worker + dw2 main) = "
          + str(v3) + " ms  maxdiff = " + str(m3))
    print("BP done")
    return 0
