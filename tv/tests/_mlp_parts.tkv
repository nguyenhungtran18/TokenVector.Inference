import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    ih = 4 * h
    print("=== mlp_bwd: 4 manh, do rieng (loop) ===")
    a = t_zeros([n, ih])
    gout = t_zeros([n, h])
    w2 = t_zeros([ih, h])
    w1 = t_zeros([h, ih])
    x = t_zeros([n, h])
    dxs2 = t_zeros([n, ih])
    dxs1 = t_zeros([n, h])
    inner = t_zeros([n, ih])
    dbuf = t_zeros([n, ih])
    gt = t_zeros([h * ih * 2 + ih * 2 + h * 2 + 64])
    gflat = gt.data
    ad = a.data
    gd = gout.data
    w2d = w2.data
    w1d = w1.data
    xd = x.data
    d2d = dxs2.data
    d1d = dxs1.data
    ind = inner.data
    dbd = dbuf.data
    o_w2: "i64" = 0
    o_b2: "i64" = ih * h
    o_w1: "i64" = ih * h + ih
    o_b1: "i64" = ih * h + ih + h * ih

    # A) r2 = onednn_linear_bwd_off(a[n,ih] -> dxs2[n,ih], w2[ih,h])
    r = onednn_linear_bwd_off(ad, gd, w2d, d2d, gflat, n, ih, h, o_w2, o_b2)
    t0 = now_ms()
    i = 0
    while i < 5:
        r = onednn_linear_bwd_off(ad, gd, w2d, d2d, gflat, n, ih, h, o_w2, o_b2)
        i = i + 1
    dA = (now_ms() - t0) / 5.0
    print("A) r2  ATen [n,ih]x[ih,h]  = " + str(dA) + " ms  rc=" + str(r))

    # B) gelu_bwd
    rg = torch_gelu_bwd(d2d, ind, dbd, n * ih)
    t0 = now_ms()
    i = 0
    while i < 5:
        rg = torch_gelu_bwd(d2d, ind, dbd, n * ih)
        i = i + 1
    dB = (now_ms() - t0) / 5.0
    print("B) gelu_bwd  torch          = " + str(dB) + " ms  rc=" + str(rg))

    # C) r1 = onednn_linear_bwd_off(x[n,h] -> dxs1[n,h], w1[h,ih])
    r = onednn_linear_bwd_off(xd, dbd, w1d, d1d, gflat, n, h, ih, o_w1, o_b1)
    t0 = now_ms()
    i = 0
    while i < 5:
        r = onednn_linear_bwd_off(xd, dbd, w1d, d1d, gflat, n, h, ih, o_w1, o_b1)
        i = i + 1
    dC = (now_ms() - t0) / 5.0
    print("C) r1  ATen [n,h]x[h,ih]   = " + str(dC) + " ms  rc=" + str(r))

    print("---")
    print("SUM A+B+C = " + str(dA + dB + dC))
    print("mlp_bwd do duoc trong block = 90 ms/layer")
    print("con lai (pool, glue) = " + str(90.0 - (dA + dB + dC)))
    return 0
