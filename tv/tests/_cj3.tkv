# PROBE _cj3 — cô lập lỗi M4 f64: f32 path (Single) vs f64 path (Double)
# Contract packed (từ CJ/SPEC): create(b, rows, cols, stride, T, trans)
#   trans=0 -> B luu k×n (rows=k, cols=n)      : C = A[m,k] @ B[k,n]
#   trans=1 -> B luu n×k (rows=n, cols=k)      : C = A[m,k] @ B^T
# Arms:
#   f64: pack từ Tensor Double (t_zeros) + target Double
#   f32: pack từ list Single (return-annotation coerce) + target Single
# Base (ta=tb=0): smm_fwd_pd production.
# In: st, maxdiff vs base, so ptu > 1e18 (rác), 4 ptu dau.
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj3.tkv out/cj3.exe main
import tv.training.tensor
import tv.training.simd_matmul

def _f64view(d: "list[f32]") -> "list[f64]":
    return d

# builder ép Single (return-annotation coerce) — cho arm f32
def _f32list(n: 'i64') -> "list[f32]":
    out = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out

def _fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

# style 2 = gia tri test cua compiler (0..6) — boc thu gia tri co phai la nguon loi khong
def _fill2(d: "list[f32]", n: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(i % 7)
        i = i + 1
    return n

def _copy(dst: "list[f32]", src: "list[f32]", n: 'i64') -> 'i64':
    i = 0
    while i < n:
        dst[i] = src[i]
        i = i + 1
    return n

def _maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def _ngarbage(a: "list[f32]", cnt: 'i64') -> 'i64':
    g = 0
    i = 0
    while i < cnt:
        if a[i] > 1.0e18 or a[i] < -1.0e18:
            g = g + 1
        i = i + 1
    return g

def _p4(a: "list[f32]") -> 'str':
    return str(a[0]) + "," + str(a[1]) + "," + str(a[2]) + "," + str(a[3])

# arm f64: pack tu Tensor Double (t_zeros), ghi vao tgt Double
# a: A[m,k] luon trans=0; b: neu tb=0 thi b la k×n (rows=k,cols=n), neu tb=1 thi b la n×k
def _m64(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
         tb: 'i32', T: 'i64', tgt: "list[f32]") -> 'i32':
    ad = _f64view(a.data)
    bd = _f64view(b.data)
    tv = _f64view(tgt)
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(ad, m, k, k, T, 0)
    if tb == 0:
        hB = simd_gemm_packed_create(bd, k, n, n, T, 0)
    else:
        hB = simd_gemm_packed_create(bd, n, k, k, T, 1)
    st = simd_gemm_packed(hA, hB, tv, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    return st

# arm f32: list Single
def _m32(a: "list[f32]", b: "list[f32]", m: 'i64', n: 'i64', k: 'i64',
         tb: 'i32', T: 'i64', tgt: "list[f32]") -> 'i32':
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(a, m, k, k, T, 0)
    if tb == 0:
        hB = simd_gemm_packed_create(b, k, n, n, T, 0)
    else:
        hB = simd_gemm_packed_create(b, n, k, k, T, 1)
    st = simd_gemm_packed(hA, hB, tgt, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    return st

def _case(tag: 'str', m: 'i64', n: 'i64', k: 'i64', tb: 'i32', T: 'i64', seed: 'i64', style: 'i64' = 1) -> 'i32':
    A = t_zeros([m, k])
    if style == 1:
        _fill(A.data, m * k, seed)
    else:
        _fill2(A.data, m * k)
    if tb == 0:
        B = t_zeros([k, n])
        if style == 1:
            _fill(B.data, k * n, seed + 1)
        else:
            _fill2(B.data, k * n)
    else:
        B = t_zeros([n, k])
        if style == 1:
            _fill(B.data, n * k, seed + 1)
        else:
            _fill2(B.data, n * k)
    T64 = t_zeros([m, n])
    st64 = _m64(A, B, m, n, k, tb, T, T64.data)
    t32 = _f32list(m * n)
    A32 = _f32list(m * k)
    B32n = n * k
    if tb == 0:
        B32n = k * n
    B32 = _f32list(B32n)
    _copy(A32, A.data, m * k)
    _copy(B32, B.data, B32n)
    st32 = _m32(A32, B32, m, n, k, tb, T, t32)
    md3264 = _maxdiff(t32, T64.data, m * n)
    g64 = _ngarbage(T64.data, m * n)
    g32 = _ngarbage(t32, m * n)
    mdb64 = -1.0
    mdb32 = -1.0
    hasbase = 0
    if tb == 0:
        tgt = t_zeros([m, n])
        base = smm_fwd_pd(A, B, m, n, k, tgt.data)
        mdb64 = _maxdiff(base.data, T64.data, m * n)
        mdb32 = _maxdiff(base.data, t32, m * n)
        hasbase = 1
    print(tag + " " + str(m) + "x" + str(n) + "x" + str(k) + " tb=" + str(tb)
          + " T=" + str(T) + " st64=" + str(st64) + " st32=" + str(st32))
    print("  md(base,t64)=" + str(mdb64) + " md(base,t32)=" + str(mdb32)
          + " md(t32,t64)=" + str(md3264) + " g64=" + str(g64) + " g32=" + str(g32))
    print("  t64[0..3]=" + _p4(T64.data) + " | t32[0..3]=" + _p4(t32))
    if hasbase == 1:
        print("  base[0..3]=" + _p4(base.data))
    return 0

def main() -> 'i32':
    print("CJ3: M4 f64 vs f32 path isolation")
    _case("(a) aligned-sm  ", 64, 64, 64, 0, 64, 5)
    _case("(b) aligned-768 ", 768, 768, 768, 0, 768, 9)
    _case("(c) S1 trans_b=1", 1024, 768, 3072, 1, 768, 1)
    _case("(d) S3 rect     ", 1024, 768, 50257, 0, 768, 3)
    _case("(e) 32 T=32 mine", 32, 32, 32, 0, 32, 5)
    _case("(f) 64 T=32 mine", 64, 64, 64, 0, 32, 5)
    _case("(g) 64 T=64 val32", 64, 64, 64, 0, 64, 5, 2)
    _case("(h) 32 T=32 val32", 32, 32, 32, 0, 32, 5, 2)
    print("CJ3 done")
    return 0
