import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    hd = HeadDim
    V = VocabSize
    NL = NLayers
    print("=== ATen attention_bwd: fwd portion ben trong chiem bao nhieu? ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    wqkv = t_zeros([h, 3 * h])
    wproj = t_zeros([h, h])
    bqkv = t_zeros([3 * h])
    bproj = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    dx = t_zeros([n, h])
    qkv = t_zeros([n, 3 * h])
    ctxT = t_zeros([n, h])
    out = t_zeros([n, h])
    xd = x.data
    gd = gout.data
    dxd = dx.data
    qkvd = qkv.data
    ctd = ctxT.data
    outd = out.data
    wqd = wqkv.data
    wpd = wproj.data
    bqd = bqkv.data
    bpd = bproj.data
    base = V * h + MaxPos * h + h + h
    oq = base + h + h
    obq = oq + 3 * h * h
    op = obq + 3 * h
    obp = op + h * h

    s = torch_sdpa_fwd(qkvd, ctd, n, NHeads, hd)
    q = gpt2_linear(x, wqkv, bqkv, n, h, 3 * h, 1, qkv)
    p = onednn_linear_bias(ctd, wpd, bpd, outd, n, h, h)
    r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat, n, h, NHeads, hd, oq, obq, op, obp)

    t0 = now_ms()
    i = 0
    while i < 10:
        s = torch_sdpa_fwd(qkvd, ctd, n, NHeads, hd)
        i = i + 1
    tsdpa = (now_ms() - t0) / 10.0
    t0 = now_ms()
    i = 0
    while i < 10:
        q = gpt2_linear(x, wqkv, bqkv, n, h, 3 * h, 1, qkv)
        i = i + 1
    tqkv = (now_ms() - t0) / 10.0
    t0 = now_ms()
    i = 0
    while i < 10:
        p = onednn_linear_bias(ctd, wpd, bpd, outd, n, h, h)
        i = i + 1
    tproj = (now_ms() - t0) / 10.0
    t0 = now_ms()
    i = 0
    while i < 10:
        r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat, n, h, NHeads, hd, oq, obq, op, obp)
        i = i + 1
    tbwd = (now_ms() - t0) / 10.0
    print("torch_sdpa_fwd (fwd sdpa)        = " + str(tsdpa) + " ms  rc=" + str(s))
    print("gpt2_linear qkv (fwd addmm)      = " + str(tqkv) + " ms")
    print("onednn_linear_bias proj (fwd)    = " + str(tproj) + " ms  rc=" + str(p))
    print("torch_attention_bwd (FULL)       = " + str(tbwd) + " ms  rc=" + str(r))
    print("---")
    print("fwd portion = sdpa + qkv + proj  = " + str(tsdpa + tqkv + tproj) + " ms")
    print("=> bwd-only uoc tinh             = " + str(tbwd - (tsdpa + tqkv + tproj)) + " ms")
    return 0
