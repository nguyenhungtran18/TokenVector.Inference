# PROBE NT4 — so bit exp() .NET tren DUNG input v (bit giong production)
# v duoc tinh cong thuc giong chinh (float(k) * 0.04 - 20.0), doc bang
# write_f32/read_i32 -> in ra hex khong dau; C doc cung file nay.
# Chay: D:\TokenVector\Release\dist\tkvc-tv.exe tv/tests/_nt4.tkv out/nt4.exe main
#       dotnet out/nt4_n10.dll > out/nt4_tkv.txt
#       build tools/simd_native/test_nt4b.c -> test_nt4b.exe out/nt4_tkv.txt
import tv.training.tensor

def _bits(v: 'f32') -> 'i32':
    p = alloc_bytes(4)
    write_f32(p, 0, v)
    b = read_i32(p, 0)
    free_bytes(p)
    return b

def main() -> 'i32':
    tv = t_zeros([3001])
    k = 0
    while k < 3001:
        tv.data[k] = float(k) * 0.04 - 100.0
        k = k + 1
    k = 0
    while k < 3001:
        print("NT4 v=" + hex(_bits(tv.data[k])) + " e=" + hex(_bits(exp(tv.data[k]))))
        k = k + 1
    return 0
