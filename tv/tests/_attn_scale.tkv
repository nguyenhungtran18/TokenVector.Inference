import tv.training.gpt2_ref124

def main() -> 'i32':
    h = HiddenSize
    hd = HeadDim
    print("=== attention_bwd_merge_multi: tach overhead co dinh vs scaling ===")
    qkv = t_zeros([1024, 3 * h])
    dctxT = t_zeros([1024, h])
    ctxT = t_zeros([1024, h])
    dqkv = t_zeros([1024, 3 * h])
    qkvd = qkv.data
    dcd = dctxT.data
    ctd = ctxT.data
    dqd = dqkv.data
    inv = 1.0 / sqrt(float(hd))

    # warm
    r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, 1024, h, hd, inv, NHeads)
    r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, 256, h, hd, inv, NHeads)
    r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, 512, h, hd, inv, NHeads)

    # n=256
    t0 = now_ms()
    i = 0
    while i < 10:
        r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, 256, h, hd, inv, NHeads)
        i = i + 1
    t256 = (now_ms() - t0) / 10.0
    # n=512
    t0 = now_ms()
    i = 0
    while i < 10:
        r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, 512, h, hd, inv, NHeads)
        i = i + 1
    t512 = (now_ms() - t0) / 10.0
    # n=1024
    t0 = now_ms()
    i = 0
    while i < 10:
        r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, 1024, h, hd, inv, NHeads)
        i = i + 1
    t1024 = (now_ms() - t0) / 10.0
    print("n=256  = " + str(t256) + " ms")
    print("n=512  = " + str(t512) + " ms")
    print("n=1024 = " + str(t1024) + " ms   rc=" + str(r))
    print("---")
    print("512/256 = " + str(t512 / t256) + "  (work 4x neu thuan O(n^2))")
    print("1024/512 = " + str(t1024 / t512))
    print("1024/256 = " + str(t1024 / t256) + "  (work 16x neu thuan O(n^2))")
    print("=> overhead co dinh uoc tinh = " + str((t1024 - 16.0 * t256) / -15.0) + " ms")
    return 0
