# PROBE 16 — kiem tra torch_sdpa_fwd (ATen) co thuc su chay khong.
import tv.training.gpt2_ref124
import tv.training.tensor

def main() -> 'i32':
    n = 1024
    h = 768
    hd = 64
    qkv = t_zeros([n, 3 * h])
    ctx = t_zeros([n, h])
    qd = qkv.data
    cd = ctx.data
    r0 = torch_sdpa_fwd(qd, cd, n, 12, hd)
    t0 = now_ms()
    r1 = torch_sdpa_fwd(qd, cd, n, 12, hd)
    r2 = torch_sdpa_fwd(qd, cd, n, 12, hd)
    r3 = torch_sdpa_fwd(qd, cd, n, 12, hd)
    r4 = torch_sdpa_fwd(qd, cd, n, 12, hd)
    t1 = now_ms()
    print("SDPA rc=" + str(r0) + "/" + str(r1) + "/" + str(r2) + "/" + str(r3) + "/" + str(r4) + " 4x=" + str(t1 - t0) + " ms")
    return 0
