# PROBE _p6ms (2026-10-28) — ACCEPTANCE #8: than N cau + branch invariant
#
# 3 shape that the request #8 names (§2.2), moi shape 2 arm CUNG so hoc:
#   V : than N cau (co/m khong branch loop-invariant) -> #8 Y1 + Y2 phai nhan
#   S : cung phep toan nhung chen mot goi `f32()` (call) -> matcher PHAI tu choi
#       -> duong scalar = proxy "codegen cu" de do speedup
# moi arm deu kiem bit-giong voi arm doi dien.
#
#   A (LN_BWD)   : for j in range(h): lane + lane + idx + 2 branch invariant
#   B (linear_db): for o in range(off_d): 1 branch invariant, idx RMW 2 canh
#   C (BUILD-ACC): for k in range(n): 2 lane + 1 idx (khong reduction)
#
# Chay:
#   /d/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_p6ms.tkv out/_p6ms.exe main
#   ./out/_p6ms.exe


# ---- A: LN_BWD (gpt2_layernorm_bwd vong ghi cuoi) --------------------------
def _ln_v(x: "list[f32]", gy: "list[f32]", g: "list[f32]",
          dx: "list[f32]", dg: "list[f32]", h: "i64", off_dg: "i64") -> "i64":
    mu = 0.0
    k = 0
    while k < h:
        mu = mu + x[k]
        k = k + 1
    mu = mu / float(h)
    rstd = 1.5
    m1 = 0.25
    m2 = 0.5
    j = 0
    for j in range(h):
        xh = (x[j] - mu) * rstd
        gg = gy[j] * g[j]
        dx[j] = rstd * (gg - m1 - xh * m2)
        if off_dg >= 0:
            dg[off_dg + j] = dg[off_dg + j] + gy[j] * xh
        else:
            dg[j] = dg[j] + gy[j] * xh
    return 0


def _ln_s(x: "list[f32]", gy: "list[f32]", g: "list[f32]",
          dx: "list[f32]", dg: "list[f32]", h: "i64", off_dg: "i64") -> "i64":
    mu = 0.0
    k = 0
    while k < h:
        mu = mu + x[k]
        k = k + 1
    mu = mu / float(h)
    rstd = 1.5
    m1 = 0.25
    m2 = 0.5
    j = 0
    for j in range(h):
        xh = (x[j] - mu) * rstd
        gg = f32(gy[j]) * g[j]
        dx[j] = rstd * (gg - m1 - xh * m2)
        if off_dg >= 0:
            dg[off_dg + j] = dg[off_dg + j] + f32(gy[j]) * xh
        else:
            dg[j] = dg[j] + f32(gy[j]) * xh
    return 0


# ---- B: linear_db (gpt2_linear_bwd vong db) --------------------------------
def _db_v(gflat: "list[f32]", db: "list[f32]", gy: "list[f32]",
          off: "i64", dboff: "i64", n: "i64", out_d: "i64") -> "i64":
    i = 0
    for i in range(n):
        base = i * out_d
        o = 0
        for o in range(out_d):
            if dboff >= 0:
                gflat[dboff + o] = gflat[dboff + o] + gy[base + o]
            else:
                db[o] = db[o] + gy[base + o]
    return 0


def _db_s(gflat: "list[f32]", db: "list[f32]", gy: "list[f32]",
          off: "i64", dboff: "i64", n: "i64", out_d: "i64") -> "i64":
    i = 0
    for i in range(n):
        base = i * out_d
        o = 0
        for o in range(out_d):
            if dboff >= 0:
                gflat[dboff + o] = gflat[dboff + o] + f32(gy[base + o])
            else:
                db[o] = db[o] + f32(gy[base + o])
    return 0


# ---- C: BUILD-ACC (3 cau, khong branch) ------------------------------------
def _ac_v(a: "list[f32]", b: "list[f32]", out: "list[f32]",
          n: "i64", src: "i64", dst: "i64") -> "i64":
    k = 0
    for k in range(n):
        t = a[src + k] * 1.5
        u = b[src + k] + t
        out[dst + k] = u * 0.5
    return 0


def _ac_s(a: "list[f32]", b: "list[f32]", out: "list[f32]",
          n: "i64", src: "i64", dst: "i64") -> "i64":
    k = 0
    for k in range(n):
        t = a[src + k] * 1.5
        u = f32(b[src + k]) + t
        out[dst + k] = u * 0.5
    return 0


def _mk(n: "i64", seed: "i32") -> "list[f32]":
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append(f32(((i * 7 + seed) % 51) * 0.0625 - 1.5625))
        i = i + 1
    return out


def _maxdiff(a: "list[f32]", b: "list[f32]") -> "f32":
    m = 0.0
    i = 0
    n = len(a)
    while i < n:
        d = a[i] - b[i]
        if d < 0.0:
            d = -d
        if d > m:
            m = d
        i = i + 1
    return f32(m)


def main() -> "i32":
    H = 16384
    ROWS = 64
    NN = 1024
    SZ = 70000
    x = _mk(SZ, 1)
    gy = _mk(SZ, 2)
    g = _mk(SZ, 3)
    reps = 3
    # 2026-10-29: 400 -> 6000. now_ms() lay ~15.6 ms/quantum nen 31/78/93 ms
    # truoc do bi luong tu hoa (31.25/78.125/93.75) -> ty so 3.0x/2.5x la
    # SO MO PHONG, khong phai do that. 6000 chay cho arm cham ~1.4 s ->
    # granularity ~1%.
    runs = 6000
    fails = 0

    # ---- A: LN_BWD (co branch invariant) ----
    dxV: "list[f32]" = []
    dxS: "list[f32]" = []
    dgV: "list[f32]" = []
    dgS: "list[f32]" = []
    i = 0
    while i < H * 4:
        dxV.append(0.0)
        dxS.append(0.0)
        dgV.append(0.0)
        dgS.append(0.0)
        i = i + 1
    while i < SZ:
        dxV.append(0.0)
        dxS.append(0.0)
        dgV.append(0.0)
        dgS.append(0.0)
        i = i + 1
    bestAV = 999999999.0
    bestAS = 999999999.0
    r = 0
    while r < reps:
        if r % 2 == 0:
            t0 = now_ms()
            q = 0
            while q < runs:
                z = _ln_s(x, gy, g, dxS, dgS, H, -1)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                z = _ln_v(x, gy, g, dxV, dgV, H, -1)
                q = q + 1
            t2 = now_ms()
            dS = t1 - t0
            dV = t2 - t1
        else:
            t0 = now_ms()
            q = 0
            while q < runs:
                z = _ln_v(x, gy, g, dxV, dgV, H, -1)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                z = _ln_s(x, gy, g, dxS, dgS, H, -1)
                q = q + 1
            t2 = now_ms()
            dV = t1 - t0
            dS = t2 - t1
        if dV < bestAV:
            bestAV = dV
        if dS < bestAS:
            bestAS = dS
        r = r + 1
    badA = _maxdiff(dxV, dxS) + _maxdiff(dgV, dgS)
    if badA != 0.0:
        fails = fails + 1
    print("A LN_BWD   V=" + str(bestAV) + " ms  S=" + str(bestAS) +
          " ms  speedup=" + str(bestAS / bestAV) + "x  bit_bad=" + str(badA))

    # ---- B: linear_db (branch invariant, 2 canh) ----
    gfV: "list[f32]" = []
    gfS: "list[f32]" = []
    dbV: "list[f32]" = []
    dbS: "list[f32]" = []
    i = 0
    while i < NN * 4:
        gfV.append(0.0)
        gfS.append(0.0)
        dbV.append(0.0)
        dbS.append(0.0)
        i = i + 1
    bestBV = 999999999.0
    bestBS = 999999999.0
    r = 0
    while r < reps:
        if r % 2 == 0:
            t0 = now_ms()
            q = 0
            while q < runs:
                z = _db_s(gfS, dbS, gy, 0, -1, ROWS, NN)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                z = _db_v(gfV, dbV, gy, 0, -1, ROWS, NN)
                q = q + 1
            t2 = now_ms()
            dS = t1 - t0
            dV = t2 - t1
        else:
            t0 = now_ms()
            q = 0
            while q < runs:
                z = _db_v(gfV, dbV, gy, 0, -1, ROWS, NN)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                z = _db_s(gfS, dbS, gy, 0, -1, ROWS, NN)
                q = q + 1
            t2 = now_ms()
            dV = t1 - t0
            dS = t2 - t1
        if dV < bestBV:
            bestBV = dV
        if dS < bestBS:
            bestBS = dS
        r = r + 1
    badB = _maxdiff(gfV, gfS) + _maxdiff(dbV, dbS)
    if badB != 0.0:
        fails = fails + 1
    print("B linear_db V=" + str(bestBV) + " ms  S=" + str(bestBS) +
          " ms  speedup=" + str(bestBS / bestBV) + "x  bit_bad=" + str(badB))

    # ---- C: BUILD-ACC (3 cau, khong branch) ----
    a = _mk(NN * 64, 4)
    b = _mk(NN * 64, 5)
    oV: "list[f32]" = []
    oS: "list[f32]" = []
    i = 0
    while i < NN * 64:
        oV.append(0.0)
        oS.append(0.0)
        i = i + 1
    bestCV = 999999999.0
    bestCS = 999999999.0
    r = 0
    while r < reps:
        if r % 2 == 0:
            t0 = now_ms()
            q = 0
            while q < runs:
                z = _ac_s(a, b, oS, NN * 64, 0, 0)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                z = _ac_v(a, b, oV, NN * 64, 0, 0)
                q = q + 1
            t2 = now_ms()
            dS = t1 - t0
            dV = t2 - t1
        else:
            t0 = now_ms()
            q = 0
            while q < runs:
                z = _ac_v(a, b, oV, NN * 64, 0, 0)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                z = _ac_s(a, b, oS, NN * 64, 0, 0)
                q = q + 1
            t2 = now_ms()
            dV = t1 - t0
            dS = t2 - t1
        if dV < bestCV:
            bestCV = dV
        if dS < bestCS:
            bestCS = dS
        r = r + 1
    badC = _maxdiff(oV, oS)
    if badC != 0.0:
        fails = fails + 1
    print("C BUILDACC V=" + str(bestCV) + " ms  S=" + str(bestCS) +
          " ms  speedup=" + str(bestCS / bestCV) + "x  bit_bad=" + str(badC))

    print("_p6ms done fails=" + str(fails))
    return 0
