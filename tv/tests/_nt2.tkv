# PROBE NT2 — doi bit exp() .NET vs MSVC CRT tren hang muc day
# Chay: D:\TokenVector\Release\dist\tkvc-tv.exe tv/tests/_nt2.tkv out/nt2.exe main
#       dotnet out/nt2_n10.dll > out/nt2_tkv.txt
#       build tools/simd_native/test_nt2.c -> out/nt2_native.txt; so file
import tv.training.tensor

def _one(v: 'f32') -> 'i32':
    p = alloc_bytes(4)
    e = exp(v)
    write_f32(p, 0, e)
    b = read_i32(p, 0)
    free_bytes(p)
    return b

def main() -> 'i32':
    tv = t_zeros([1001])
    k = 0
    while k < 1001:
        tv.data[k] = float(k) * 0.04 - 20.0
        k = k + 1
    k = 0
    while k < 1001:
        print("NT2 bits=" + hex(_one(tv.data[k])))
        k = k + 1
    return 0
