# PROBE BL — P6 GĐ4: ADAMW/PLUMBING PARALLEL PROTOTYPE (2026-10-21)
#
# Thuc te tu probe BK (full step @1024): adamw_loop 3906ms + grad_norm 1047ms
# + unflatten 782ms + loss 671ms + zero 266ms = ~6.6s, KHONG phu thuoc seq
# (seq8 no ~30% buoc — uoc tu profile 0.20). GĐ4 tan cong vung nay.
#
# Cau hoi quyet dinh (BG2 chua tra loi du o quy moi lon): worker ghi DISJOINT
# vao CUNG list co scale khong? -> BL do TRUC TIPE 3 bien tren mang 124.4M:
#   BL[1] SERIAL  — copy vong AdamW trainer (tham so fixed, khong norm)
#   BL[2] SHARED  — 12 worker ghi TRUC TIEP vao p/m/v/v g cung (disjoint range)
#   BL[3] OWN+MERGE — 12 worker ghi vao segment RIENG, main merge (372M copy)
#   BL[bit] subset 12M: SERIAL vs SHARED cung dau vao -> maxdiff phai 0.0
#             (phan tu doc lap, phep giong het -> bit-exact toan phan)
#   BL[4] grad_norm: serial _norm_groups copy vs 12 worker (worker/list chunk
#             tinh s moi NHOM theo dung thu tu phan tu, main gop DUNG thu tu
#             nhom -> BIT-EXACT) — field list[f64] la CHUA CO tien le -> compile
#             loi thi bo di.
#
# Bo qua ghi them: value khong anh huong toc do (khong co denormal), toan bo
# timing o MAIN (bug #8), best-of 2.
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bl.tkv out/bl.exe main
#   ./out/bl.exe

N_ALL = 124439808

def _bl_zeros(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _bl_div(a: 'i64', b: 'i64') -> 'i64':
    # floor(a/b) bang chia nhi phan (khong dung '/' cua i64, khong while-tru cham)
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

# ---- fill (moi ham MOT list phang — quy tac bug compiler #2) ---------------
def _bl_fill_p(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 131) % 97) - 48) * 0.00043)
    return out

def _bl_fill_m(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 77) % 89) - 44) * 0.00031)
    return out

def _bl_fill_v(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 53) % 83) + 1) * 0.0000071)
    return out

def _bl_fill_g(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 149) % 101) - 50) * 0.0021)
    return out

def _bl_fill_g2(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 149) % 101) - 50) * 0.0021)
    return out

def _bl_maxdiff(a: 'list[f32]', b: 'list[f32]', cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        e = a[i] - b[i]
        if e < 0.0:
            e = -e
        if e > dmax:
            dmax = e
        i = i + 1
    return dmax

def _bl_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

# ---- AdamW element (copy NGUYEN cong thuc trainer.step, khong norm) -------
# gi = g*coef; p *= wdf; m = b1*m+(1-b1)*gi; v = b2*v+(1-b2)*gi*gi;
# denom = sqrt(v)/bc2s + eps; p -= step_size*m/denom
def _bl_aw_ser(p: 'list[f32]', m: 'list[f32]', v: 'list[f32]', g: 'list[f32]',
               n: 'i64', coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
               step_size: 'f64', bc2s: 'f64', eps: 'f64') -> 'i64':
    i = 0
    while i < n:
        gi = g[i] * coef
        p[i] = p[i] * wdf
        m[i] = b1 * m[i] + (1.0 - b1) * gi
        v[i] = b2 * v[i] + (1.0 - b2) * gi * gi
        denom = sqrt(v[i]) / bc2s + eps
        p[i] = p[i] - step_size * m[i] / denom
        i = i + 1
    return 0

class _BlJob:
    pl: "list[f32]"
    ml: "list[f32]"
    vl: "list[f32]"
    gl: "list[f32]"
    pseg: "list[f32]"
    mseg: "list[f32]"
    vseg: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    coef: 'f64'
    wdf: 'f64'
    b1: 'f64'
    b2: 'f64'
    step_size: 'f64'
    bc2s: 'f64'
    eps: 'f64'
    def __init__(self, pl: "list[f32]", ml: "list[f32]", vl: "list[f32]",
                  gl: "list[f32]", pseg: "list[f32]", mseg: "list[f32]",
                  vseg: "list[f32]", lo: 'i64', hi: 'i64',
                  coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
                  step_size: 'f64', bc2s: 'f64', eps: 'f64'):
        self.pl = pl
        self.ml = ml
        self.vl = vl
        self.gl = gl
        self.pseg = pseg
        self.mseg = mseg
        self.vseg = vseg
        self.lo = lo
        self.hi = hi
        self.coef = coef
        self.wdf = wdf
        self.b1 = b1
        self.b2 = b2
        self.step_size = step_size
        self.bc2s = bc2s
        self.eps = eps

# BIEN THE 1 — ghi TRUC TIEP vao list chung (disjoint [lo,hi)) — pseg = None
def _bl_aw_shared(j: "_BlJob") -> 'i64':
    i = j.lo
    while i < j.hi:
        gi = j.gl[i] * j.coef
        j.pl[i] = j.pl[i] * j.wdf
        j.ml[i] = j.b1 * j.ml[i] + (1.0 - j.b1) * gi
        j.vl[i] = j.b2 * j.vl[i] + (1.0 - j.b2) * gi * gi
        denom = sqrt(j.vl[i]) / j.bc2s + j.eps
        j.pl[i] = j.pl[i] - j.step_size * j.ml[i] / denom
        i = i + 1
    return 0

# BIEN THE 2 — ghi vao segment RIENG (pseg/mseg/vseg da pre-alloc), main merge
def _bl_aw_own(j: "_BlJob") -> 'i64':
    ps = j.pseg
    ms = j.mseg
    vs = j.vseg
    k = 0
    i = j.lo
    while i < j.hi:
        gi = j.gl[i] * j.coef
        pv = j.pl[i] * j.wdf
        mv = j.b1 * j.ml[i] + (1.0 - j.b1) * gi
        vv = j.b2 * j.vl[i] + (1.0 - j.b2) * gi * gi
        denom = sqrt(vv) / j.bc2s + j.eps
        pv = pv - j.step_size * mv / denom
        ps[k] = pv
        ms[k] = mv
        vs[k] = vv
        k = k + 1
        i = i + 1
    return 0

# ---- grad_norm: copy _norm_groups (serial reference) -----------------------
def _bl_norm_ser(g: 'list[f32]', groups: 'list[i64]') -> 'f64':
    tot = 0.0
    off = 0
    for k in range(len(groups)):
        cnt = groups[k]
        s = 0.0
        for i in range(cnt):
            s = s + g[off + i] * g[off + i]
        nrm = sqrt(s)
        tot = tot + nrm * nrm
        off = off + cnt
    return sqrt(tot)

# worker norm: tinh s tung nhom [glo,ghi) dung thu tu phan tu, ghi vao
# buffer f64 RIENG (main pre-alloc) tai vi tri nhom chinh xac -> main gop
# DUNG thu tu nhom -> bit-exact voi serial.
class _BnJob:
    gl: "list[f32]"
    grl: "list[i64]"
    ssl: "list[f64]"
    glo: 'i64'
    ghi: 'i64'
    def __init__(self, gl: "list[f32]", grl: "list[i64]", ssl: "list[f64]",
                  glo: 'i64', ghi: 'i64'):
        self.gl = gl
        self.grl = grl
        self.ssl = ssl
        self.glo = glo
        self.ghi = ghi

def _bl_bn_one(j: "_BnJob") -> 'i64':
    off = 0
    k = 0
    while k < j.glo:
        off = off + j.grl[k]
        k = k + 1
    kk = j.glo
    while kk < j.ghi:
        cnt = j.grl[kk]
        s = 0.0
        i = 0
        while i < cnt:
            s = s + j.gl[off + i] * j.gl[off + i]
            i = i + 1
        j.ssl[kk] = s
        off = off + cnt
        kk = kk + 1
    return 0

def _bl_zd(n: 'i64') -> 'list[f64]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def main() -> 'i32':
    n = N_ALL
    coef = 1.0
    wdf = 1.0
    b1 = 0.9
    b2 = 0.999
    step_size = 0.0025 / (1.0 - 0.81)
    bc2s = sqrt(1.0 - 0.998001)
    eps = 0.00000001

    # ---- setup mang 124.4M (fill 1 lan — gia tri khong denormal) ----------
    t0 = now_ms()
    p = _bl_fill_p(n)
    m = _bl_fill_m(n)
    v = _bl_fill_v(n)
    g = _bl_fill_g(n)
    print("BL setup 4 mang x124.4M = " + str(now_ms() - t0) + " ms")

    # ---- BL[1] SERIAL ------------------------------------------------------
    v1 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        r1 = _bl_aw_ser(p, m, v, g, n, coef, wdf, b1, b2, step_size, bc2s, eps)
        d1 = now_ms() - t0
        v1 = _bl_smt(v1, d1)
        krep = krep + 1
    print("BL[1] SERIAL adamw = " + str(v1) + " ms")

    # ---- BL[2] SHARED — 12 worker ghi truc tiep list chung -----------------
    # boundary: lo_k = _bl_div(k*n, 12) (chia nhi phan — nhanh)
    lo0 = 0
    lo1 = _bl_div(1 * n, 12)
    lo2 = _bl_div(2 * n, 12)
    lo3 = _bl_div(3 * n, 12)
    lo4 = _bl_div(4 * n, 12)
    lo5 = _bl_div(5 * n, 12)
    lo6 = _bl_div(6 * n, 12)
    lo7 = _bl_div(7 * n, 12)
    lo8 = _bl_div(8 * n, 12)
    lo9 = _bl_div(9 * n, 12)
    lo10 = _bl_div(10 * n, 12)
    lo11 = _bl_div(11 * n, 12)
    emp = _bl_zeros(0)

    v2 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        h0 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo0, lo1, coef, wdf, b1, b2, step_size, bc2s, eps))
        h1 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo1, lo2, coef, wdf, b1, b2, step_size, bc2s, eps))
        h2 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo2, lo3, coef, wdf, b1, b2, step_size, bc2s, eps))
        h3 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo3, lo4, coef, wdf, b1, b2, step_size, bc2s, eps))
        h4 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo4, lo5, coef, wdf, b1, b2, step_size, bc2s, eps))
        h5 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo5, lo6, coef, wdf, b1, b2, step_size, bc2s, eps))
        h6 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo6, lo7, coef, wdf, b1, b2, step_size, bc2s, eps))
        h7 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo7, lo8, coef, wdf, b1, b2, step_size, bc2s, eps))
        h8 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo8, lo9, coef, wdf, b1, b2, step_size, bc2s, eps))
        h9 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo9, lo10, coef, wdf, b1, b2, step_size, bc2s, eps))
        h10 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo10, lo11, coef, wdf, b1, b2, step_size, bc2s, eps))
        h11 = thread_spawn(_bl_aw_shared, _BlJob(p, m, v, g, emp, emp, emp, lo11, n, coef, wdf, b1, b2, step_size, bc2s, eps))
        rj0 = thread_join(h0)
        rj1 = thread_join(h1)
        rj2 = thread_join(h2)
        rj3 = thread_join(h3)
        rj4 = thread_join(h4)
        rj5 = thread_join(h5)
        rj6 = thread_join(h6)
        rj7 = thread_join(h7)
        rj8 = thread_join(h8)
        rj9 = thread_join(h9)
        rj10 = thread_join(h10)
        rj11 = thread_join(h11)
        d2 = now_ms() - t0
        v2 = _bl_smt(v2, d2)
        krep = krep + 1
    print("BL[2] SHARED-12 adamw = " + str(v2) + " ms  (speedup " + str(v1 / v2) + ")")

    # ---- BL[bit] SUBSET 12M: serial vs shared, cung dau vao ----------------
    S = 12000000
    pa = _bl_fill_p(S)
    ma = _bl_fill_m(S)
    va = _bl_fill_v(S)
    ga = _bl_fill_g(S)
    pb = _bl_fill_g2(S)
    mb = _bl_zeros(S)
    vb = _bl_zeros(S)
    gb = _bl_fill_g2(S)
    # copy pa/ma/va -> pb/mb/vb (pb da co fill giong — copy p/m/v)
    i = 0
    while i < S:
        pb[i] = pa[i]
        mb[i] = ma[i]
        vb[i] = va[i]
        i = i + 1
    rser = _bl_aw_ser(pa, ma, va, ga, S, coef, wdf, b1, b2, step_size, bc2s, eps)
    # shared-12 tren subset (gio han tu 12 segment nho)
    s0 = _bl_div(0 * S, 12)
    s1 = _bl_div(1 * S, 12)
    s2 = _bl_div(2 * S, 12)
    s3 = _bl_div(3 * S, 12)
    s4 = _bl_div(4 * S, 12)
    s5 = _bl_div(5 * S, 12)
    s6 = _bl_div(6 * S, 12)
    s7 = _bl_div(7 * S, 12)
    s8 = _bl_div(8 * S, 12)
    s9 = _bl_div(9 * S, 12)
    s10 = _bl_div(10 * S, 12)
    s11 = _bl_div(11 * S, 12)
    hs0 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s0, s1, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs1 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s1, s2, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs2 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s2, s3, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs3 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s3, s4, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs4 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s4, s5, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs5 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s5, s6, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs6 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s6, s7, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs7 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s7, s8, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs8 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s8, s9, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs9 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s9, s10, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs10 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s10, s11, coef, wdf, b1, b2, step_size, bc2s, eps))
    hs11 = thread_spawn(_bl_aw_shared, _BlJob(pb, mb, vb, gb, emp, emp, emp, s11, S, coef, wdf, b1, b2, step_size, bc2s, eps))
    rs0 = thread_join(hs0)
    rs1 = thread_join(hs1)
    rs2 = thread_join(hs2)
    rs3 = thread_join(hs3)
    rs4 = thread_join(hs4)
    rs5 = thread_join(hs5)
    rs6 = thread_join(hs6)
    rs7 = thread_join(hs7)
    rs8 = thread_join(hs8)
    rs9 = thread_join(hs9)
    rs10 = thread_join(hs10)
    rs11 = thread_join(hs11)
    dbp = _bl_maxdiff(pa, pb, S)
    dbm = _bl_maxdiff(ma, mb, S)
    dbv = _bl_maxdiff(va, vb, S)
    print("BL[bit] subset12M SERIAL-vs-SHARED: dp=" + str(dbp) + " dm=" + str(dbm) + " dv=" + str(dbv))
    fails = 0
    if dbp > 0.0:
        fails = fails + 1
    if dbm > 0.0:
        fails = fails + 1
    if dbv > 0.0:
        fails = fails + 1

    # ---- BL[3] OWN+MERGE — segment rieng + main merge ----------------------
    sz0 = lo1 - lo0
    sz1 = lo2 - lo1
    sz2 = lo3 - lo2
    sz3 = lo4 - lo3
    sz4 = lo5 - lo4
    sz5 = lo6 - lo5
    sz6 = lo7 - lo6
    sz7 = lo8 - lo7
    sz8 = lo9 - lo8
    sz9 = lo10 - lo9
    sz10 = lo11 - lo10
    sz11 = n - lo11
    v3 = 1.0e18
    krep = 0
    while krep < 2:
        # segment pre-alloc (12 x 3) — moi loi goi 1 list rieng
        t0 = now_ms()
        ps0 = _bl_zeros(sz0)
        ps1 = _bl_zeros(sz1)
        ps2 = _bl_zeros(sz2)
        ps3 = _bl_zeros(sz3)
        ps4 = _bl_zeros(sz4)
        ps5 = _bl_zeros(sz5)
        ps6 = _bl_zeros(sz6)
        ps7 = _bl_zeros(sz7)
        ps8 = _bl_zeros(sz8)
        ps9 = _bl_zeros(sz9)
        ps10 = _bl_zeros(sz10)
        ps11 = _bl_zeros(sz11)
        ms0 = _bl_zeros(sz0)
        ms1 = _bl_zeros(sz1)
        ms2 = _bl_zeros(sz2)
        ms3 = _bl_zeros(sz3)
        ms4 = _bl_zeros(sz4)
        ms5 = _bl_zeros(sz5)
        ms6 = _bl_zeros(sz6)
        ms7 = _bl_zeros(sz7)
        ms8 = _bl_zeros(sz8)
        ms9 = _bl_zeros(sz9)
        ms10 = _bl_zeros(sz10)
        ms11 = _bl_zeros(sz11)
        vs0 = _bl_zeros(sz0)
        vs1 = _bl_zeros(sz1)
        vs2 = _bl_zeros(sz2)
        vs3 = _bl_zeros(sz3)
        vs4 = _bl_zeros(sz4)
        vs5 = _bl_zeros(sz5)
        vs6 = _bl_zeros(sz6)
        vs7 = _bl_zeros(sz7)
        vs8 = _bl_zeros(sz8)
        vs9 = _bl_zeros(sz9)
        vs10 = _bl_zeros(sz10)
        vs11 = _bl_zeros(sz11)
        t_alloc = now_ms() - t0

        t0 = now_ms()
        h0 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps0, ms0, vs0, lo0, lo1, coef, wdf, b1, b2, step_size, bc2s, eps))
        h1 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps1, ms1, vs1, lo1, lo2, coef, wdf, b1, b2, step_size, bc2s, eps))
        h2 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps2, ms2, vs2, lo2, lo3, coef, wdf, b1, b2, step_size, bc2s, eps))
        h3 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps3, ms3, vs3, lo3, lo4, coef, wdf, b1, b2, step_size, bc2s, eps))
        h4 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps4, ms4, vs4, lo4, lo5, coef, wdf, b1, b2, step_size, bc2s, eps))
        h5 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps5, ms5, vs5, lo5, lo6, coef, wdf, b1, b2, step_size, bc2s, eps))
        h6 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps6, ms6, vs6, lo6, lo7, coef, wdf, b1, b2, step_size, bc2s, eps))
        h7 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps7, ms7, vs7, lo7, lo8, coef, wdf, b1, b2, step_size, bc2s, eps))
        h8 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps8, ms8, vs8, lo8, lo9, coef, wdf, b1, b2, step_size, bc2s, eps))
        h9 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps9, ms9, vs9, lo9, lo10, coef, wdf, b1, b2, step_size, bc2s, eps))
        h10 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps10, ms10, vs10, lo10, lo11, coef, wdf, b1, b2, step_size, bc2s, eps))
        h11 = thread_spawn(_bl_aw_own, _BlJob(p, m, v, g, ps11, ms11, vs11, lo11, n, coef, wdf, b1, b2, step_size, bc2s, eps))
        rj0 = thread_join(h0)
        rj1 = thread_join(h1)
        rj2 = thread_join(h2)
        rj3 = thread_join(h3)
        rj4 = thread_join(h4)
        rj5 = thread_join(h5)
        rj6 = thread_join(h6)
        rj7 = thread_join(h7)
        rj8 = thread_join(h8)
        rj9 = thread_join(h9)
        rj10 = thread_join(h10)
        rj11 = thread_join(h11)
        t_worker = now_ms() - t0

        # merge — container nested LOCAL (list cua list) = hop luat bug #1;
        # KHONG dung list i64 phang cho lo (bug #2) -> tinh lai bang _bl_div
        t0 = now_ms()
        plst = []
        plst.append(ps0)
        plst.append(ps1)
        plst.append(ps2)
        plst.append(ps3)
        plst.append(ps4)
        plst.append(ps5)
        plst.append(ps6)
        plst.append(ps7)
        plst.append(ps8)
        plst.append(ps9)
        plst.append(ps10)
        plst.append(ps11)
        mlst = []
        mlst.append(ms0)
        mlst.append(ms1)
        mlst.append(ms2)
        mlst.append(ms3)
        mlst.append(ms4)
        mlst.append(ms5)
        mlst.append(ms6)
        mlst.append(ms7)
        mlst.append(ms8)
        mlst.append(ms9)
        mlst.append(ms10)
        mlst.append(ms11)
        vlst = []
        vlst.append(vs0)
        vlst.append(vs1)
        vlst.append(vs2)
        vlst.append(vs3)
        vlst.append(vs4)
        vlst.append(vs5)
        vlst.append(vs6)
        vlst.append(vs7)
        vlst.append(vs8)
        vlst.append(vs9)
        vlst.append(vs10)
        vlst.append(vs11)
        for t in range(12):
            lo = _bl_div(t * n, 12)
            sg = plst[t]
            for i in range(len(sg)):
                p[lo + i] = sg[i]
        for t in range(12):
            lo = _bl_div(t * n, 12)
            sg = mlst[t]
            for i in range(len(sg)):
                m[lo + i] = sg[i]
        for t in range(12):
            lo = _bl_div(t * n, 12)
            sg = vlst[t]
            for i in range(len(sg)):
                v[lo + i] = sg[i]
        t_merge = now_ms() - t0
        d3 = t_alloc + t_worker + t_merge
        v3 = _bl_smt(v3, d3)
        krep = krep + 1
        print("  BL[3] lan do: alloc=" + str(t_alloc) + " worker=" + str(t_worker)
              + " merge=" + str(t_merge) + " ms")
    print("BL[3] OWN+MERGE tong = " + str(v3) + " ms  (speedup " + str(v1 / v3) + ")")

    # ---- BL[4] GRAD_NORM serial vs 12 worker (bit-exact neu compile duoc) --
    # groups tong quyt: wte 38.6M + 27 nhom deu ~3.18M (hinh dang that wpe 0.79M
    # + w1/w2 2.36M + qkv 1.77M — chinh xac khong can, do toc do va imbalance)
    g2 = _bl_fill_g2(n)
    groups = []
    groups.append(38597376)
    rest = n - 38597376
    per = _bl_div(rest, 27)
    for k in range(27):
        groups.append(per)
    t0 = now_ms()
    ns = _bl_norm_ser(g2, groups)
    v_nser = now_ms() - t0

    ssl = _bl_zd(28)
    # 12 worker — 28 nhom: worker t phan [t*3, min(28, t*3+3)) — UNROLLED
    g0a = 0
    g0b = 3
    g1a = 3
    g1b = 6
    g2a = 6
    g2b = 9
    g3a = 9
    g3b = 12
    g4a = 12
    g4b = 15
    g5a = 15
    g5b = 18
    g6a = 18
    g6b = 21
    g7a = 21
    g7b = 24
    g8a = 24
    g8b = 27
    g9a = 27
    g9b = 28
    g10a = 28
    g10b = 28
    g11a = 28
    g11b = 28
    t0 = now_ms()
    nh0 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g0a, g0b))
    nh1 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g1a, g1b))
    nh2 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g2a, g2b))
    nh3 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g3a, g3b))
    nh4 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g4a, g4b))
    nh5 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g5a, g5b))
    nh6 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g6a, g6b))
    nh7 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g7a, g7b))
    nh8 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g8a, g8b))
    nh9 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g9a, g9b))
    nh10 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g10a, g10b))
    nh11 = thread_spawn(_bl_bn_one, _BnJob(g2, groups, ssl, g11a, g11b))
    nr0 = thread_join(nh0)
    nr1 = thread_join(nh1)
    nr2 = thread_join(nh2)
    nr3 = thread_join(nh3)
    nr4 = thread_join(nh4)
    nr5 = thread_join(nh5)
    nr6 = thread_join(nh6)
    nr7 = thread_join(nh7)
    nr8 = thread_join(nh8)
    nr9 = thread_join(nh9)
    nr10 = thread_join(nh10)
    nr11 = thread_join(nh11)
    # main gop DUNG thu tu nhom (giong serial: tot += nrm*nrm tung nhom)
    tot = 0.0
    for k in range(28):
        nrm = sqrt(ssl[k])
        tot = tot + nrm * nrm
    np_ = sqrt(tot)
    v_npar = now_ms() - t0
    dn = np_ - ns
    if dn < 0.0:
        dn = -dn
    print("BL[4] grad_norm SERIAL = " + str(v_nser) + " ms  PAR12 = " + str(v_npar)
          + " ms  speedup " + str(v_nser / v_npar) + "  BIT=" + str(dn))
    if dn > 0.0:
        fails = fails + 1

    if fails == 0:
        print("BL RESULT: ALL BIT-EXACT (fails=0)")
    else:
        print("BL RESULT: FAILS=" + str(fails))
    print("BL done")
    return 0
