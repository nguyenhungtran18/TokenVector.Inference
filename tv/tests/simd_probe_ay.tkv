# PROBE AY — P5.8 chuan doan: vi sao v2 cham hon v1 khi cau truc giong nhau?
# In TUNG rep (khong chi best) + dao thu tu (v2 truoc, v1 sau) de bo qua
# GC/warmup. Shape nho: m=256, n=2304, kk=768 (qkv-like, T=256, p0t=3, j0t=9).
# Chay: tkvc tv/tests/simd_probe_ay.tkv out/ay.exe main; ./out/ay.exe
import tv.training.ops
import tv.training.simd_matmul

def _fill(rows: 'i64', cols: 'i64', seed: 'i64') -> "Tensor":
    out = t_zeros([rows, cols])
    d = out.data
    for i in range(rows * cols):
        d[i] = (float((i * 13 + seed) % 211) - 105.0) / 105.0
    return out

def main() -> 'i32':
    m = 256
    n = 2304
    kk = 768
    a = _fill(m, kk, 3)
    b = _fill(kk, n, 7)
    c1 = smm_dot(a, b, m, n, kk)
    c2 = smm_dot_v2(a, b, m, n, kk)
    print("AY interleaved smm_dot vs smm_dot_v2  m=" + str(m) + " n=" + str(n) + " k=" + str(kk) + " bit0=" + str(c2.data[0] - c1.data[0]))
    i = 0
    while i < 5:
        t0 = now_ms()
        c1 = smm_dot(a, b, m, n, kk)
        t1 = now_ms()
        dv1 = t1 - t0
        t2 = now_ms()
        c2 = smm_dot_v2(a, b, m, n, kk)
        t3 = now_ms()
        dv2 = t3 - t2
        print("AY rep" + str(i) + " v1=" + str(dv1) + " ms  v2=" + str(dv2) + " ms")
        i = i + 1
    print("AY reversed order (v2 first):")
    i = 0
    while i < 3:
        t2 = now_ms()
        c2 = smm_dot_v2(a, b, m, n, kk)
        t3 = now_ms()
        dv2 = t3 - t2
        t0 = now_ms()
        c1 = smm_dot(a, b, m, n, kk)
        t1 = now_ms()
        dv1 = t1 - t0
        print("AY rrep" + str(i) + " v2=" + str(dv2) + " ms  v1=" + str(dv1) + " ms")
        i = i + 1
    print("AY done")
    return 0
