# PROBE GFF9 — BIT-CHECK GeluErfFwd (YEU CAU #19, native `gelu_erf_fwd`)
#
#  native gelu_erf_fwd vs `gelu_erf(v)` interpreted — bit-exact required.
#  Chay:
#    D:\TokenVector\Release\dist\tkvc-tv.exe tv/tests/_gff9.tkv out/gff9.exe main
#    copy out/gff9.exe -> out/gff9_n10.dll + runtimeconfig
#    dotnet out/gff9_n10.dll
import tv.training.tensor


def _seed(xs: 'list[f32]', n: 'i64', s: 'i64', amp: 'f32') -> 'i64':
    st = s
    i = 0
    while i < n:
        st = (st * 1103515245 + 12345) % 2147483648
        v = float((st / 256) % 65536) / 65536.0
        xs[i] = (v * 2.0 - 1.0) * amp
        i = i + 1
    return st


def _t(n: 'i64', amp: 'f32', tag: 'str') -> 'i64':
    x = t_zeros([n])
    _s = _seed(x.data, n, 111 + n, amp)
    y = t_zeros([n])
    xl = x.data
    yl = y.data
    rc = gelu_erf_fwd(xl, yl, 0, n)
    if rc != 0:
        print("GFF9 " + tag + " rc=" + str(rc))
        return 0
    bad = 0
    first = -1
    i = 0
    while i < n:
        ref = gelu_erf(x.data[i])
        if ref != y.data[i]:
            bad = bad + 1
            if first < 0:
                first = i
        i = i + 1
    print("GFF9 " + tag + " n=" + str(n) + " rc=" + str(rc) + " bit_bad=" + str(bad) + " first=" + str(first))
    return bad


def _seg(n: 'i64', lo: 'i64', hi: 'i64', tag: 'str') -> 'i64':
    x = t_zeros([n])
    _s = _seed(x.data, n, 777 + n, 6.0)
    y = t_zeros([hi - lo])
    xl = x.data
    yl = y.data
    rc = gelu_erf_fwd(xl, yl, lo, hi)
    if rc != 0:
        print("GFF9 " + tag + " rc=" + str(rc))
        return 0
    bad = 0
    first = -1
    i = lo
    while i < hi:
        ref = gelu_erf(x.data[i])
        if ref != y.data[i - lo]:
            bad = bad + 1
            if first < 0:
                first = i
        i = i + 1
    print("GFF9 " + tag + " n=" + str(n) + " lo=" + str(lo) + " hi=" + str(hi) + " rc=" + str(rc) + " bit_bad=" + str(bad) + " first=" + str(first))
    return bad


def main() -> 'i32':
    print("GFF9 — bit-check gelu_erf_fwd")
    bad = 0
    bad = bad + _t(1024 * 3072, 1.0, "prod3.1M")
    bad = bad + _t(1024 * 3072, 12.0, "prod3.1M_wide")
    bad = bad + _t(8, 1.0, "n8")
    bad = bad + _t(1, 9.0, "n1")
    bad = bad + _t(7, 3.0, "n7")
    bad = bad + _t(100000, 20.0, "n100k_wide")
    bad = bad + _seg(1024, 100, 1000, "seg")
    bad = bad + _seg(1024, 0, 1024, "seg_full")
    print("GFF9 TOTAL bit_bad=" + str(bad) + " (0 = BIT-EXACT)")
    return 0
