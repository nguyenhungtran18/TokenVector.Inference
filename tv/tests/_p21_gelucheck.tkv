# PROBE 21 — so torch_gelu_bwd voi cong thuc .tkv (max_abs_diff).
import tv.training.tensor

def main() -> 'i32':
    n = 257
    x = t_zeros([n])
    gy = t_zeros([n])
    i = 0
    while i < n:
        v = float(i - 128) * 0.037
        x.data[i] = v
        gy.data[i] = 0.5 + float(i % 7) * 0.11
        i = i + 1
    y = t_zeros([n])
    xd = x.data
    gyd = gy.data
    yd = y.data
    rc = torch_gelu_bwd(gyd, xd, yd, n)
    s = 1.4142135623730951
    mx = 0.0
    worst = 0.0
    k = 0
    i2 = 0
    while i2 < n:
        v2 = x.data[i2]
        dg = 0.5 * (1.0 + erf(v2 / s)) + v2 * 0.3989422804014327 * exp(-0.5 * v2 * v2)
        want = gy.data[i2] * dg
        d = y.data[i2] - want
        if d < 0.0:
            d = 0.0 - d
        if d > mx:
            mx = d
            k = i2
            worst = want
        i2 = i2 + 1
    print("TGB rc=" + str(rc) + " n=" + str(n) + " max_abs_diff=" + str(mx) + " at=" + str(k) + " want=" + str(worst))
    return 0
