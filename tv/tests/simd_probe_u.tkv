# PROBE U — head bwd trung gian: gg / dxf / dwte, simd vs scalar
import tv.training.tensor
import tv.training.gpt2_ref
import tv.training.gpt2_train
import tv.training.trainer
import tv.training.simd_matmul

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> "list[f32]":
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

def _tmd(a: "Tensor", b: "Tensor") -> 'f32':
    da = a.data
    db = b.data
    m = 0.0
    for i in range(len(da)):
        d = float(da[i]) - float(db[i])
        if d < 0.0:
            d = -d
        if d > m:
            m = d
    return m

def main() -> 'i32':
    FIX = "tv/tests/fixtures/"
    ps = gpt2_init(7)
    ids = load_ints(FIX + "g2_ids.txt")
    pos = load_ints(FIX + "g2_pos.txt")
    wte = ps[0]
    wpe = ps[1]
    lnf_g = ps[2]
    lnf_b = ps[3]
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    n = len(ids)
    h = HiddenSize
    print("U n=" + str(n) + " Vocab=" + str(VocabSize) + " h=" + str(h))

    x = gpt2_embed(ids, pos, wte, wpe)
    for li in range(NLayers):
        x = gpt2_block(x, ln1_g[li], ln1_b[li], wq[li], bq[li], wp[li], bp[li],
                       ln2_g[li], ln2_b[li], w1[li], b1[li], w2[li], b2[li])
    xf = gpt2_layernorm(x, lnf_g, lnf_b)

    # ---- scalar branch (ban sao gpt2_backward simd==0) ----
    dxf_sc = t_zeros([n, h])
    dwte_sc = t_zeros([VocabSize, h])
    gg_sc = t_zeros([n, VocabSize])
    for i in range(n):
        row = []
        mxf = 0.0
        for o in range(VocabSize):
            acc = 0.0
            for k in range(h):
                acc = acc + xf.data[i * h + k] * wte.data[o * h + k]
            row.append(acc)
            if o == 0:
                mxf = acc
            if acc > mxf:
                mxf = acc
        tot = 0.0
        for o in range(VocabSize):
            e = exp(row[o] - mxf)
            row[o] = e
            tot = tot + e
        inv_tot = 1.0 / tot
        inv_n = 1.0 / float(n)
        for o in range(VocabSize):
            gg = row[o] * inv_tot * inv_n
            if o == ids[i]:
                gg = gg - inv_n
            gg_sc.data[i * VocabSize + o] = gg
            for k in range(h):
                dxf_sc.data[i * h + k] = dxf_sc.data[i * h + k] + gg * wte.data[o * h + k]
                dwte_sc.data[o * h + k] = dwte_sc.data[o * h + k] + gg * xf.data[i * h + k]

    # ---- simd branch (ban sao gpt2_backward simd==1) ----
    logits_t = smm_dot(xf, wte, n, VocabSize, h)
    gg_s = t_zeros([n, VocabSize])
    for i in range(n):
        base = i * VocabSize
        mxf = logits_t.data[base]
        for o in range(1, VocabSize):
            if logits_t.data[base + o] > mxf:
                mxf = logits_t.data[base + o]
        tot = 0.0
        for o in range(VocabSize):
            e = exp(logits_t.data[base + o] - mxf)
            gg_s.data[base + o] = e
            tot = tot + e
        inv_tot = 1.0 / tot
        inv_n = 1.0 / float(n)
        for o in range(VocabSize):
            ggv = gg_s.data[base + o] * inv_tot * inv_n
            if o == ids[i]:
                ggv = ggv - inv_n
            gg_s.data[base + o] = ggv
    dxf_s = smm_fwd(gg_s, wte, n, h, VocabSize)
    ggT = smm_transpose(gg_s, n, VocabSize)
    dwte_s = smm_fwd(ggT, xf, VocabSize, h, n)

    print("U gg diff = " + str(_tmd(gg_s, gg_sc)))
    print("U dxf diff = " + str(_tmd(dxf_s, dxf_sc)))
    print("U dwte diff = " + str(_tmd(dwte_s, dwte_sc)))
    print("U dxf_sc[0..5] = " + str(dxf_sc.data[0]) + " " + str(dxf_sc.data[1]) + " " + str(dxf_sc.data[2]) + " " + str(dxf_sc.data[3]) + " " + str(dxf_sc.data[4]) + " " + str(dxf_sc.data[5]))
    print("U dxf_s [0..5] = " + str(dxf_s.data[0]) + " " + str(dxf_s.data[1]) + " " + str(dxf_s.data[2]) + " " + str(dxf_s.data[3]) + " " + str(dxf_s.data[4]) + " " + str(dxf_s.data[5]))
    print("U dwte_sc[0..3] = " + str(dwte_sc.data[0]) + " " + str(dwte_sc.data[1]) + " " + str(dwte_sc.data[2]) + " " + str(dwte_sc.data[3]))
    print("U dwte_s [0..3] = " + str(dwte_s.data[0]) + " " + str(dwte_s.data[1]) + " " + str(dwte_s.data[2]) + " " + str(dwte_s.data[3]))
    return 0
