# PROBE AM6 — BIT-CHECK native `linear_dx_fused` vs `smm_dot` (YEU CAU #10 Ask B)
#
# duong production (gpt2_linear_bwd):  dx = smm_dot(gy, w, n, in_d, out_d)
#   -> dx[m][n] = sum_{p<k} gy[m][p] * w[n][p]   (trans_b=1)
# native LinearDxFused (tkv_simd_native.c, CUNG TU voi static helper) goi
#   full_tile_a/full_tile_b/tkv_k_eff/gemm_rect_f32/gemm_rows_f32 voi i1 = m
#   -> bo 248/256 hang thua cua SgemmFull (32x phep nhan), van CUNG chuoi FMA.
#
# Kiem:
#   (a) bit-identical tren shape that + shape le (native PHAI tu choi rc != 0
#       de caller fallback `smm_dot` nguyen ven -> loss EXACT khong phu thuoc native);
#   (b) thoi gian best-of-3 cho 3 shape that.
#
# Chay:
#   tkvc tv/tests/_am6.tkv out/am6.exe main
#   cp out/am6.exe out/am6_n10.dll; cp out/_am.runtimeconfig.json out/am6_n10.runtimeconfig.json
#   dotnet out/am6_n10.dll
import tv.training.simd_matmul
import tv.training.ops


def _seed(xs: 'list[f32]', n: 'i64', s: 'i64') -> 'i64':
    # LCG 1103515245 + 12345 (giong test_dx.c cua native) -> f32 trong [-1,1)
    st = s
    i = 0
    while i < n:
        st = (st * 1103515245 + 12345) % 2147483648
        v = float((st / 256) % 65536) / 65536.0
        xs[i] = (v * 2.0 - 1.0) / 1.0
        i = i + 1
    return st


def _check(m: 'i64', n: 'i64', k: 'i64', tag: 'str') -> 'i64':
    # gy [m][k], w [n][k], dx [m][n]
    ng = m * k
    nw = n * k
    nd = m * n
    gy = t_zeros([m, k])
    w = t_zeros([n, k])
    s = _seed(gy.data, ng, 12345 + m)
    s = _seed(w.data, nw, 777 + n)

    # ---- ref: duong production hien tai ----
    ref = smm_dot(gy, w, m, n, k)

    # ---- new: 1 entry native (bien list[f32] — builtin doi tham so la BIEN) ----
    got = t_zeros([m, n])
    gyd = gy.data
    wd = w.data
    gd = got.data
    rc = linear_dx_fused(gyd, wd, gd, m, n, k)

    if rc != 0:
        # native tu choi (k<256 / m>256 / m le 4 / list qua ngan) -> caller PHAI
        # fallback smm_dot. Dem la 0 (dung hop dong), nhung in ro rc.
        print("AM6 " + tag + " m=" + str(m) + " n=" + str(n) + " k=" + str(k) + " rc=" + str(rc) + " -> NATIVE TU CHOI (caller fallback smm_dot)")
        return 0

    bad = 0
    first = -1
    i = 0
    while i < nd:
        if ref.data[i] != got.data[i]:
            bad = bad + 1
            if first < 0:
                first = i
        i = i + 1
    print("AM6 " + tag + " m=" + str(m) + " n=" + str(n) + " k=" + str(k) + " rc=" + str(rc) + " bit_bad=" + str(bad) + " first=" + str(first))
    return bad


def _time(m: 'i64', n: 'i64', k: 'i64') -> 'i32':
    ng = m * k
    nw = n * k
    nd = m * n
    gy = t_zeros([m, k])
    w = t_zeros([n, k])
    s = _seed(gy.data, ng, 12345 + m)
    s = _seed(w.data, nw, 777 + n)

    bestR = 1000000.0
    bestN = 1000000.0
    it = 0
    while it < 3:
        t0 = now_ms()
        ref = smm_dot(gy, w, m, n, k)
        t1 = now_ms()
        got = t_zeros([m, n])
        gyd = gy.data
        wd = w.data
        gd = got.data
        rc = linear_dx_fused(gyd, wd, gd, m, n, k)
        t2 = now_ms()
        dR = t1 - t0
        dN = t2 - t1
        if dR < bestR:
            bestR = dR
        if dN < bestN:
            bestN = dN
        it = it + 1
    print("AM6 time m=" + str(m) + " n=" + str(n) + " k=" + str(k) + " smm_dot=" + str(bestR) + " ms  native=" + str(bestN) + " ms  x=" + str(bestR / bestN))
    return 0


def main() -> 'i32':
    print("AM6 — bit-check linear_dx_fused vs smm_dot (YEU CAU #10 Ask B)")
    bad = 0
    # ---- shape THAT: gpt2_linear_bwd(x, w, gy, n_tok, in_d, out_d)
    #      -> smm_dot(gy, w, n_tok, in_d, out_d)  => m=n_tok, n=in_d, k=out_d
    bad = bad + _check(8, 768, 3072, "dx1-mlp")       # mlp linear1
    bad = bad + _check(8, 3072, 768, "dx2-mlp")       # mlp linear2
    bad = bad + _check(8, 768, 2304, "dxqkv-attn")    # qkv
    bad = bad + _check(8, 2304, 768, "dxproj-attn")   # proj
    bad = bad + _check(12, 768, 768, "m12")           # m le 4 khac -> van chia het 4
    bad = bad + _check(256, 768, 3072, "seq256")      # m = T (gioi han tren)
    # -- TACH 2 YEU TO (2026-11-01): k300 that bai 1264 ptu, co 2 yeu to confound:
    #    (A) p-tile LE (k % 256 != 0 -> pw < T o p0 cuoi)
    #    (B) nhieu block mc (m > GEMM_MC=64 -> ic += 64 nhieu lan)
    bad = bad + _check(200, 96, 300, "k300-both")      # (A)+(B) - that bai
    bad = bad + _check(8, 96, 300, "k300-onlyA")       # chi (A): p le, 1 block mc
    bad = bad + _check(200, 768, 768, "m200-onlyB")    # chi (B): nhieu block mc, p day
    bad = bad + _check(4, 64, 256, "k256-min")        # k = 256 dung nguong
    # ---- shape LE: native PHAI tu choi (rc != 0) -> fallback ----
    bad = bad + _check(1024, 768, 3072, "seq1024-m>256")
    bad = bad + _check(8, 768, 128, "k128-le-256")
    bad = bad + _check(100, 768, 3072, "m100-le-4")
    print("AM6 TOTAL bit_bad=" + str(bad) + " (0 = BIT-EXACT)")
    print("")
    _t = _time(8, 768, 3072)
    _t = _time(8, 3072, 768)
    _t = _time(8, 768, 2304)
    return 0
