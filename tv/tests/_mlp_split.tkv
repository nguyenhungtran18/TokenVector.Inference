# PROBE MLP-BWD SPLIT (HANDOFF §0.131 muc 5 - uu tien (a))
# Muc dich: gpt2_mlp_bwd = 82 ms/layer = 984 ms/step (19% full step), lon hon
# attention (65 ms/layer). Boc ben trong no:
#   1) onednn_linear_bwd_off shape w2  (a[n,4h] -> gout[n,h], w2[4h,h])
#   2) _mlp_gelu_bwd -> torch_gelu_bwd tren n*4h = 3.15M phan tu
#   3) onednn_linear_bwd_off shape w1  (x[n,h] -> d_inner[n,4h], w1[h,4h])
#   4) t_zeros dxs2 [n,4h] + dxs1 [n,h] moi call
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_mlp_split.tkv out/msp.exe main
#   copy -> out/msp_n10.dll + runtimeconfig ; dotnet out/msp_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    ih = 4 * h

    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    w1 = t_zeros([h, ih])
    b1 = t_zeros([ih])
    w2 = t_zeros([ih, h])
    b2 = t_zeros([h])
    sav_in = t_zeros([n, ih])
    sav_ag = t_zeros([n, ih])
    ibuf = t_zeros([n, ih])
    dbuf = t_zeros([n, ih])

    # gflat: du cho w1 (h*ih) + b1 (ih) + w2 (ih*h) + b2 (h)
    o_w1 = 0
    o_b1 = o_w1 + h * ih
    o_w2 = o_b1 + ih
    o_b2 = o_w2 + ih * h
    hold = t_zeros([o_b2 + h])
    gf = hold.data

    print("=== MLP BWD SPLIT seq=" + str(n) + " h=" + str(h) + " 4h=" + str(ih) + " ===")

    # ---- A) toan bo gpt2_mlp_bwd (production, ATen path) ----
    for i in range(1):
        rm = gpt2_mlp_bwd(x, w1, b1, w2, b2, n, gout, 1, gf, o_w1, o_b1, o_w2, o_b2,
                          sav_in, sav_ag, ibuf, dbuf)
    best = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        rm = gpt2_mlp_bwd(x, w1, b1, w2, b2, n, gout, 1, gf, o_w1, o_b1, o_w2, o_b2,
                          sav_in, sav_ag, ibuf, dbuf)
        dt = now_ms() - t0
        if dt < best:
            best = dt
        kk = kk + 1
    print("A) gpt2_mlp_bwd FULL        best-of-5 ms=" + str(best))

    # ---- 1) onednn_linear_bwd_off shape w2: a[n,4h] gout[n,h] w2[4h,h] ----
    dxs2 = t_zeros([n, ih])
    _ad = sav_ag.data
    _gd = gout.data
    _w2 = w2.data
    _dx2 = dxs2.data
    r2w = onednn_linear_bwd_off(_ad, _gd, _w2, _dx2, gf, n, ih, h, o_w2, o_b2)
    best1 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        r2w = onednn_linear_bwd_off(_ad, _gd, _w2, _dx2, gf, n, ih, h, o_w2, o_b2)
        dt = now_ms() - t0
        if dt < best1:
            best1 = dt
        kk = kk + 1
    print("1) onednn_bwd_off w2 shape  best-of-5 ms=" + str(best1) + "  rc=" + str(r2w))

    # ---- 2) gelu bwd: torch_gelu_bwd tren n*4h ----
    nn = n * ih
    _in = sav_in.data
    _gy = dxs2.data
    _out = dbuf.data
    rg = torch_gelu_bwd(_gy, _in, _out, nn)
    best2 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        rg = torch_gelu_bwd(_gy, _in, _out, nn)
        dt = now_ms() - t0
        if dt < best2:
            best2 = dt
        kk = kk + 1
    print("2) torch_gelu_bwd n*4h      best-of-5 ms=" + str(best2) + "  rc=" + str(rg) + "  nn=" + str(nn))

    # ---- 3) onednn_linear_bwd_off shape w1: x[n,h] d_inner[n,4h] w1[h,4h] ----
    dxs1 = t_zeros([n, h])
    _x4 = x.data
    _did = dbuf.data
    _w1 = w1.data
    _dx1 = dxs1.data
    r1w = onednn_linear_bwd_off(_x4, _did, _w1, _dx1, gf, n, h, ih, o_w1, o_b1)
    best3 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        r1w = onednn_linear_bwd_off(_x4, _did, _w1, _dx1, gf, n, h, ih, o_w1, o_b1)
        dt = now_ms() - t0
        if dt < best3:
            best3 = dt
        kk = kk + 1
    print("3) onednn_bwd_off w1 shape  best-of-5 ms=" + str(best3) + "  rc=" + str(r1w))

    # ---- 4) cap phat dxs2 [n,4h] + dxs1 [n,h] moi call ----
    best4 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        for i in range(5):
            z2 = t_zeros([n, ih])
            z1 = t_zeros([n, h])
        dt = now_ms() - t0
        if dt < best4:
            best4 = dt
        kk = kk + 1
    print("4) t_zeros dxs2+dxs1 x5     best-of-5 ms=" + str(best4) + "  -> per-call " + str(best4 / 5.0))

    # ---- tong ----
    tot = best1 + best2 + best3 + best4 / 5.0
    print("SUM 1+2+3+4 = " + str(tot) + "   (full = " + str(best) + ")")
    print("chenh (glue + _mlp_gelu_bwd wrapper + return list) = " + str(best - tot))

    # ---- 5) _mlp_gelu_bwd day du (wrapper + torch_gelu_bwd) ----
    best5 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        _gt = _mlp_gelu_bwd(sav_in, dxs2, dbuf)
        dt = now_ms() - t0
        if dt < best5:
            best5 = dt
        kk = kk + 1
    print("5) _mlp_gelu_bwd (wrapper)  best-of-5 ms=" + str(best5))

    # ---- 6) chi 2 len() check + return list (glue floor cua ham nay) ----
    best6 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        for i in range(10):
            _g1 = len(gf)
            _g2 = len(sav_in.data)
        dt = now_ms() - t0
        if dt < best6:
            best6 = dt
        kk = kk + 1
    print("6) 2x len() x10             best-of-5 ms=" + str(best6) + "  -> per-call " + str(best6 / 10.0))

    # ---- 7) t_zeros rieng le ----
    best7a = 1.0e9
    best7b = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        for i in range(5):
            z2 = t_zeros([n, ih])
        dt = now_ms() - t0
        if dt < best7a:
            best7a = dt
        t0 = now_ms()
        for i in range(5):
            z1 = t_zeros([n, h])
        dt = now_ms() - t0
        if dt < best7b:
            best7b = dt
        kk = kk + 1
    print("7a) t_zeros [n,4h] x5       best-of-5 ms=" + str(best7a) + "  -> per-call " + str(best7a / 5.0))
    print("7b) t_zeros [n,h]  x5       best-of-5 ms=" + str(best7b) + "  -> per-call " + str(best7b / 5.0))
    return 0
