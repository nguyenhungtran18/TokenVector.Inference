# PROBE TAM _cy6 — grad_norm vs step() tai 124M (method public)
import tv.training.tensor
import tv.training.trainer

def main() -> 'i32':
    n: "i64" = 124239616
    groups: "list[i64]" = []
    tot: "i64" = 0
    i = 0
    while i < 27:
        groups.append(4096)
        tot = tot + 4096
        i = i + 1
    groups.append(n - tot)
    o = new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999,
                    0.00000001, 0.0, 1.0)
    g = o.g
    i = 0
    while i < n:
        g[i] = float((i % 17) - 8) * 0.001
        i = i + 1
    print("CY6 init done")

    best = 1.0e18
    q = 0
    gn = 0.0
    while q < 3:
        t0 = now_ms()
        gn = o.grad_norm()
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY6 grad_norm best=" + str(best) + " ms gn=" + str(gn))

    best = 1.0e18
    q = 0
    while q < 3:
        t0 = now_ms()
        lr2 = o.step()
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY6 step() best=" + str(best) + " ms lr=" + str(lr2))
    print("CY6 done")
    return 0