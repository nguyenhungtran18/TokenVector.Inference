import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    hd = HeadDim
    V = VocabSize
    NL = NLayers
    print("=== cung ham, gflat TO vs NHO: chi phi pin co ti le kich thuoc khong? ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gto = t_zeros([npar])
    gflat_to = gto.data
    base = V * h + MaxPos * h + h + h
    oa = base + h + h
    oba = oa + 3 * h * h
    opa = oba + 3 * h
    obpa = opa + h * h
    nho = obpa + h + 1024
    gnh = t_zeros([nho])
    gflat_nho = gnh.data
    print("gflat TO  = " + str(len(gflat_to) * 4 / 1048576.0) + " MB")
    print("gflat NHO = " + str(len(gflat_nho) * 4 / 1048576.0) + " MB")

    wq = t_zeros([h, 3 * h])
    wp = t_zeros([h, h])
    bqkv = t_zeros([3 * h])
    bproj = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    dx = t_zeros([n, h])
    xd = x.data
    gd = gout.data
    dxd = dx.data
    wqd = wq.data
    wpd = wp.data
    bqd = bqkv.data
    bpd = bproj.data

    r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat_to, n, h, NHeads, hd, oa, oba, opa, obpa)
    r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat_nho, n, h, NHeads, hd, oa, oba, opa, obpa)
    print("warm rc = " + str(r))

    k = 0
    while k < 6:
        t0 = now_ms()
        r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat_to, n, h, NHeads, hd, oa, oba, opa, obpa)
        t_to = now_ms() - t0
        t0 = now_ms()
        r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat_nho, n, h, NHeads, hd, oa, oba, opa, obpa)
        t_nho = now_ms() - t0
        print("lan " + str(k + 1) + ": TO = " + str(t_to) + "  NHO = " + str(t_nho) + "  chenh = " + str(t_to - t_nho))
        k = k + 1
    return 0
