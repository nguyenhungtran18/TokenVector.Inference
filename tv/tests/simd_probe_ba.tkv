# PROBE BA — P5.8 chuan doan pha: build tile vs gemm vs tich luy
# 2 clone cai dat trong probe: BA-v1 (giong _smm_core) vs BA-v2 (giong _p58_core,
# trans_a param + use_acc/acc + ceildiv). Do tung pha bang now_ms.
# Chay: tkvc tv/tests/simd_probe_ba.tkv out/ba.exe main; ./out/ba.exe
import tv.training.ops
import tv.training.simd_matmul

def _fill(rows: 'i64', cols: 'i64', seed: 'i64') -> "Tensor":
    out = t_zeros([rows, cols])
    d = out.data
    for i in range(rows * cols):
        d[i] = (float((i * 13 + seed) % 211) - 105.0) / 105.0
    return out

def _ba_ceildiv(a: 'i64', b: 'i64') -> 'i64':
    r = 0
    s = 0
    while s < a:
        s = s + b
        r = r + 1
    return r

# ---- BA-v1: giong _smm_core (khong trans_a, khong use_acc) ---------------------
def _ba_v1(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32') -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Ct = _zeros_list(T * T)
    ph_tile = 0.0
    ph_gemm = 0.0
    ph_acc = 0.0
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            t0 = now_ms()
            At = _tile_a(a, k, i0, ib, p0, pw, T)
            t1 = now_ms()
            ph_tile = ph_tile + (t1 - t0)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                t0 = now_ms()
                Bt = _tile_b(b, ndim, p0, pw, j0, jb, T, trans_b)
                t1 = now_ms()
                ph_tile = ph_tile + (t1 - t0)
                t0 = now_ms()
                simd_gemm(At, Bt, Ct, T)
                t1 = now_ms()
                ph_gemm = ph_gemm + (t1 - t0)
                t0 = now_ms()
                r = 0
                while r < ib:
                    bc = (i0 + r) * n + j0
                    bt = r * T
                    c = 0
                    while c < jb:
                        cd[bc + c] = cd[bc + c] + Ct[bt + c]
                        c = c + 1
                    r = r + 1
                t1 = now_ms()
                ph_acc = ph_acc + (t1 - t0)
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    print("BA-v1 tile=" + str(ph_tile) + " gemm=" + str(ph_gemm) + " acc=" + str(ph_acc))
    return C

# ---- BA-v2: giong _p58_core (trans_a + use_acc dispatch, khong nhan trans_a=1) --
def _ba_v2(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32', trans_a: 'i32') -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Rt = _zeros_list(T * T)
    p0t = _ba_ceildiv(k, T)
    j0t = _ba_ceildiv(n, T)
    use_acc = 0
    if p0t >= 2:
        if j0t == 1:
            if m * n >= T * T:
                use_acc = 1
    acc = _zeros_list(1)
    if use_acc == 1:
        acc = _zeros_list(T * T)
    ph_tile = 0.0
    ph_gemm = 0.0
    ph_acc = 0.0
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            t0 = now_ms()
            At = _tile_a(a, k, i0, ib, p0, pw, T)
            t1 = now_ms()
            ph_tile = ph_tile + (t1 - t0)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                t0 = now_ms()
                Bt = _tile_b(b, ndim, p0, pw, j0, jb, T, trans_b)
                t1 = now_ms()
                ph_tile = ph_tile + (t1 - t0)
                t0 = now_ms()
                simd_gemm(At, Bt, Rt, T)
                t1 = now_ms()
                ph_gemm = ph_gemm + (t1 - t0)
                t0 = now_ms()
                if use_acc == 1:
                    simd_add(acc, Rt, acc)
                else:
                    r = 0
                    while r < ib:
                        bc = (i0 + r) * n + j0
                        bt = r * T
                        c = 0
                        while c < jb:
                            cd[bc + c] = cd[bc + c] + Rt[bt + c]
                            c = c + 1
                        r = r + 1
                t1 = now_ms()
                ph_acc = ph_acc + (t1 - t0)
                j0 = j0 + jb
            p0 = p0 + pw
        if use_acc == 1:
            r = 0
            while r < ib:
                bc = (i0 + r) * n
                bt = r * T
                c = 0
                while c < n:
                    cd[bc + c] = cd[bc + c] + acc[bt + c]
                    c = c + 1
                r = r + 1
            simd_sub(acc, acc, acc)
        i0 = i0 + ib
    print("BA-v2 tile=" + str(ph_tile) + " gemm=" + str(ph_gemm) + " acc=" + str(ph_acc))
    return C

def main() -> 'i32':
    m = 256
    n = 2304
    kk = 768
    a = _fill(m, kk, 3)
    b = _fill(kk, n, 7)
    print("BA m=" + str(m) + " n=" + str(n) + " k=" + str(kk))
    c1 = _ba_v1(a, b, m, n, kk, kk, 1)
    c2 = _ba_v2(a, b, m, n, kk, kk, 1, 0)
    d0 = c2.data[0] - c1.data[0]
    print("BA bit0=" + str(d0))
    print("BA done")
    return 0
