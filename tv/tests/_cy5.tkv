# PROBE TAM _cy5 — boc tach tung statement trong step() M5 tai 124M
import tv.training.tensor
import tv.training.trainer

def main() -> 'i32':
    n: "i64" = 124239616
    groups: "list[i64]" = []
    tot: "i64" = 0
    i = 0
    while i < 27:
        groups.append(4096)
        tot = tot + 4096
        i = i + 1
    groups.append(n - tot)
    o = new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999,
                    0.00000001, 0.0, 1.0)
    g = o.g
    i = 0
    while i < n:
        g[i] = float((i % 17) - 8) * 0.001
        i = i + 1
    print("CY5 init done")

    t0 = now_ms()
    gn = o.grad_norm()
    t1 = now_ms()
    print("CY5 grad_norm = " + str(t1 - t0) + " ms gn=" + str(gn))

    pl = o.p
    pgl = o.pg
    ppl = o.pp
    pml = o.pm
    pvl = o.pv
    ptl = o.pt
    ponl = o.pone

    t0 = now_ms()
    r1 = f32_copy_to_buf(g, pgl, n)
    t1 = now_ms()
    print("CY5 copy_g = " + str(t1 - t0) + " ms r=" + str(r1))

    coef: "f32" = 1.0 / (gn + 0.000001)
    if coef > 1.0:
        coef = 1.0
    t0 = now_ms()
    rzp = f32_zero(ptl, n)
    rax = f32_addcmul(ptl, pgl, ponl, coef, n)
    t1 = now_ms()
    print("CY5 coef-branch(zero+addcmul) = " + str(t1 - t0) + " ms coef=" + str(coef))

    t0 = now_ms()
    r2 = f32_copy_to_buf(pl, ppl, n)
    t1 = now_ms()
    print("CY5 copy_p = " + str(t1 - t0) + " ms")

    t0 = now_ms()
    stw = adamw_step(ppl, pml, pvl, ptl, n, 0.001, 0.9, 0.999, 0.00000001, 0.0, 0.9, 0.031)
    t1 = now_ms()
    print("CY5 adamw_step = " + str(t1 - t0) + " ms st=" + str(stw))

    t0 = now_ms()
    r3 = f32_copy_from_buf(ppl, pl, n)
    t1 = now_ms()
    print("CY5 copy_back = " + str(t1 - t0) + " ms")

    t0 = now_ms()
    lr2 = o.step()
    t1 = now_ms()
    print("CY5 step() toan bo = " + str(t1 - t0) + " ms (gn nho -> coef=1, bo qua addcmul)")
    print("CY5 done")
    return 0