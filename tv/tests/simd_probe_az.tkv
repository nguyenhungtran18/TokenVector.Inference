# PROBE AZ — p5.8 chuan doan tiep: co phai do loop nest lap lai / param i32?
# v1 = smm_dot (goc), v2 = smm_dot_v2 (dang cham), v3 = clone v2 bo p0t==1
# early-return (chi 1 loop nest) — neu v3 == v1 thi nguyen nhan la codegen.
# Chay: tkvc tv/tests/simd_probe_az.tkv out/az.exe main; ./out/az.exe
import tv.training.ops
import tv.training.simd_matmul

def _fill(rows: 'i64', cols: 'i64', seed: 'i64') -> "Tensor":
    out = t_zeros([rows, cols])
    d = out.data
    for i in range(rows * cols):
        d[i] = (float((i * 13 + seed) % 211) - 105.0) / 105.0
    return out

def _az_ceildiv(a: 'i64', b: 'i64') -> 'i64':
    r = 0
    s = 0
    while s < a:
        s = s + b
        r = r + 1
    return r

# clone _smm_core v1 dung ten rieng (khong trung ten module)
def _az_core(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32') -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Rt = _zeros_list(T * T)
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            At = _tile_a(a, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                Bt = _tile_b(b, ndim, p0, pw, j0, jb, T, trans_b)
                simd_gemm(At, Bt, Rt, T)
                r = 0
                while r < ib:
                    bc = (i0 + r) * n + j0
                    bt = r * T
                    c = 0
                    while c < jb:
                        cd[bc + c] = cd[bc + c] + Rt[bt + c]
                        c = c + 1
                    r = r + 1
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return C

def _az_dot(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64') -> "Tensor":
    return _az_core(a, b, m, n, k, k, 1)

def main() -> 'i32':
    m = 256
    n = 2304
    kk = 768
    a = _fill(m, kk, 3)
    b = _fill(kk, n, 7)
    print("AZ m=" + str(m) + " n=" + str(n) + " k=" + str(kk))
    i = 0
    while i < 4:
        t0 = now_ms()
        c1 = smm_dot(a, b, m, n, kk)
        t1 = now_ms()
        dv1 = t1 - t0
        t0 = now_ms()
        c3 = _az_dot(a, b, m, n, kk)
        t1 = now_ms()
        dv3 = t1 - t0
        t0 = now_ms()
        c2 = smm_dot_v2(a, b, m, n, kk)
        t1 = now_ms()
        dv2 = t1 - t0
        d31 = c3.data[0] - c1.data[0]
        d21 = c2.data[0] - c1.data[0]
        print("AZ rep" + str(i) + " v1=" + str(dv1) + " ms  clone=" + str(dv3) + " ms  v2=" + str(dv2) + " ms  d_clone=" + str(d31) + " d_v2=" + str(d21))
        i = i + 1
    print("AZ done")
    return 0
