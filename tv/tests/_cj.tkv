# PROBE CJ — M4 wire A/B PRODUCTION-REAL (Tensor.data = List[Double])
# ---------------------------------------------------------------------------
# CY (simd_probe_cy) đo cả 2 arm trên list[Single] -> pack arm KHÔNG chịu chi phí
# convert Double->Single/Single->Double của production. Probe này đo đúng
# pipeline wire sẽ dùng:
#   BASE : production smm_dot / smm_fwd_pd / smm_dot_pd (Tensor Double)
#   M4   : conv d2s (2-pass pattern chuẩn) + packed_create + packed_run
#          + copy C ra target (sc nếu có, ngược lại Tensor Double mới)
#   + pha breakdown: convA / convB / packrun / copyC (ms)
# Quyết định wire: M4 <= BASE (best-of-3) và maxdiff <= 1e-4 (f32 ulp).
# Routing: chỉ trans_a=0 (S4 trans-A lớn đã đo 0.6x ở CY -> loại).
#
# Gọi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj.tkv out/cj.exe main
#      ./out/cj.exe
import tv.training.tensor
import tv.training.simd_matmul

def _cj_sz(n: 'i64') -> "list[f32]":
    # Single zeros (forcing pattern) — giống _zeros_list production
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    return out

def _cj_dz(n: 'i64') -> "list[f32]":
    # Double zeros (literal 0.0) — giống t_zeros
    out = []
    i = 0
    while i < n:
        out.append(0.0)
        i = i + 1
    return out

def _cj_fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _cj_d2s(d: "list[f32]") -> "list[f32]":
    # Double -> Single: append forcing (ép Single tại return) + assign (ép f64->f32)
    n = len(d)
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    i = 0
    while i < n:
        out[i] = d[i]
        i = i + 1
    return out

def _cj_maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

# Pipeline M4 wire: conv + pack + run + copy C ra target.
# sc = None -> C là Tensor Double mới; sc khác None -> copy vào sc (giống production).
def _cj_m4(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
           ra: 'i64', ca: 'i64', sa: 'i64', ta: 'i32',
           rb: 'i64', cb: 'i64', sb: 'i64', tb: 'i32',
           T: 'i64', sc: "list[f32]" = None, ph: "list[f64]" = None) -> "Tensor":
    t0 = now_ms()
    ad = _cj_d2s(a.data)
    t1 = now_ms()
    bd = _cj_d2s(b.data)
    t2 = now_ms()
    cs = _cj_sz(m * n)
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(ad, ra, ca, sa, T, ta)
    hB = simd_gemm_packed_create(bd, rb, cb, sb, T, tb)
    st = simd_gemm_packed(hA, hB, cs, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    t3 = now_ms()
    if sc != None:
        tgt = sc
    else:
        tgt = _cj_dz(m * n)
    i = 0
    while i < m * n:
        tgt[i] = cs[i]
        i = i + 1
    t4 = now_ms()
    if ph != None:
        ph.append(t1 - t0)
        ph.append(t2 - t1)
        ph.append(t3 - t2)
        ph.append(t4 - t3)
    return Tensor(tgt, [m, n], 0)

def _cj_phstr(ph: "list[f64]") -> 'str':
    if len(ph) < 4:
        return ""
    return ("convA=" + str(ph[0]) + " convB=" + str(ph[1])
            + " packrun=" + str(ph[2]) + " copyC=" + str(ph[3]))

def main() -> 'i32':
    print("CJ: M4 wire A/B production-real (Double Tensor), best-of-3, T=768")
    rs = 3
    nq = 1024
    h = 768
    V = 50257
    four = 3072
    T: "i64" = 768

    # ---- S1 dx1 [1024x768] = A[1024,3072] x B^T[768,3072] : smm_dot (serial, trans_b=1)
    a1 = _cj_dz(nq * four)
    b1 = _cj_dz(h * four)
    _f1 = _cj_fill(a1, nq * four, 1)
    _f2 = _cj_fill(b1, h * four, 2)
    ta1 = Tensor(a1, [nq, four], 0)
    tb1 = Tensor(b1, [h, four], 0)
    v1b = 1.0e18
    res1 = ta1
    i = 0
    while i < rs:
        t0 = now_ms()
        res1 = smm_dot(ta1, tb1, nq, h, four)
        t1 = now_ms()
        if t1 - t0 < v1b:
            v1b = t1 - t0
        i = i + 1
    ref1 = _cj_dz(nq * h)
    i = 0
    while i < nq * h:
        ref1[i] = res1.data[i]
        i = i + 1
    v1t = 1.0e18
    ph1: "list[f64]" = None
    i = 0
    while i < rs:
        ph1 = []
        t0 = now_ms()
        res1m = _cj_m4(ta1, tb1, nq, h, four, nq, four, four, 0, h, four, four, 1, T, None, ph1)
        t1 = now_ms()
        if t1 - t0 < v1t:
            v1t = t1 - t0
        i = i + 1
    md1 = _cj_maxdiff(ref1, res1m.data, nq * h)
    print("CJ S1 dx1  serial  base=" + str(v1b) + " m4=" + str(v1t)
          + " sp=" + str(v1b / v1t) + "x maxdiff=" + str(md1)
          + " | " + _cj_phstr(ph1))

    # ---- S3 dxf [1024x768] = A[1024,50257] x B[50257,768] : smm_fwd_pd (sc)
    a3 = _cj_dz(nq * V)
    b3 = _cj_dz(V * h)
    _f3 = _cj_fill(a3, nq * V, 3)
    _f4 = _cj_fill(b3, V * h, 4)
    sc3 = _cj_dz(nq * h)
    ta3 = Tensor(a3, [nq, V], 0)
    tb3 = Tensor(b3, [V, h], 0)
    v3b = 1.0e18
    res3 = ta3
    i = 0
    while i < rs:
        t0 = now_ms()
        res3 = smm_fwd_pd(ta3, tb3, nq, h, V, sc3)
        t1 = now_ms()
        if t1 - t0 < v3b:
            v3b = t1 - t0
        i = i + 1
    ref3 = _cj_dz(nq * h)
    i = 0
    while i < nq * h:
        ref3[i] = res3.data[i]
        i = i + 1
    v3t = 1.0e18
    ph3: "list[f64]" = None
    i = 0
    while i < rs:
        ph3 = []
        t0 = now_ms()
        res3m = _cj_m4(ta3, tb3, nq, h, V, nq, V, V, 0, V, h, h, 0, T, sc3, ph3)
        t1 = now_ms()
        if t1 - t0 < v3t:
            v3t = t1 - t0
        i = i + 1
    md3 = _cj_maxdiff(ref3, res3m.data, nq * h)
    print("CJ S3 dxf  wave-12 base=" + str(v3b) + " m4=" + str(v3t)
          + " sp=" + str(v3b / v3t) + "x maxdiff=" + str(md3)
          + " | " + _cj_phstr(ph3))

    # ---- S5 lgts [1024x50257] = A[1024,768] x B^T[50257,768] : smm_dot_pd (sc)
    a5 = _cj_dz(nq * h)
    b5 = _cj_dz(V * h)
    _f5 = _cj_fill(a5, nq * h, 7)
    _f6 = _cj_fill(b5, V * h, 8)
    sc5 = _cj_dz(nq * V)
    ta5 = Tensor(a5, [nq, h], 0)
    tb5 = Tensor(b5, [V, h], 0)
    v5b = 1.0e18
    res5 = ta5
    i = 0
    while i < rs:
        t0 = now_ms()
        res5 = smm_dot_pd(ta5, tb5, nq, V, h, sc5)
        t1 = now_ms()
        if t1 - t0 < v5b:
            v5b = t1 - t0
        i = i + 1
    ref5 = _cj_dz(nq * V)
    i = 0
    while i < nq * V:
        ref5[i] = res5.data[i]
        i = i + 1
    v5t = 1.0e18
    ph5: "list[f64]" = None
    i = 0
    while i < rs:
        ph5 = []
        t0 = now_ms()
        res5m = _cj_m4(ta5, tb5, nq, V, h, nq, h, h, 0, V, h, h, 1, T, sc5, ph5)
        t1 = now_ms()
        if t1 - t0 < v5t:
            v5t = t1 - t0
        i = i + 1
    md5 = _cj_maxdiff(ref5, res5m.data, nq * V)
    print("CJ S5 lgts wave-12 base=" + str(v5b) + " m4=" + str(v5t)
          + " sp=" + str(v5b / v5t) + "x maxdiff=" + str(md5)
          + " | " + _cj_phstr(ph5))

    # ---- S6 nhỏ kiểu attention: [1024x64] x B^T[1024,64] : smm_dot (serial)
    s6 = 1024
    hd = 64
    a6 = _cj_dz(s6 * hd)
    b6 = _cj_dz(s6 * hd)
    _f7 = _cj_fill(a6, s6 * hd, 11)
    _f8 = _cj_fill(b6, s6 * hd, 12)
    ta6 = Tensor(a6, [s6, hd], 0)
    tb6 = Tensor(b6, [s6, hd], 0)
    v6b = 1.0e18
    res6 = ta6
    i = 0
    while i < rs:
        t0 = now_ms()
        res6 = smm_dot(ta6, tb6, s6, s6, hd)
        t1 = now_ms()
        if t1 - t0 < v6b:
            v6b = t1 - t0
        i = i + 1
    ref6 = _cj_dz(s6 * s6)
    i = 0
    while i < s6 * s6:
        ref6[i] = res6.data[i]
        i = i + 1
    v6t = 1.0e18
    ph6: "list[f64]" = None
    i = 0
    while i < rs:
        ph6 = []
        t0 = now_ms()
        res6m = _cj_m4(ta6, tb6, s6, s6, hd, s6, hd, hd, 0, s6, hd, hd, 1, T, None, ph6)
        t1 = now_ms()
        if t1 - t0 < v6t:
            v6t = t1 - t0
        i = i + 1
    md6 = _cj_maxdiff(ref6, res6m.data, s6 * s6)
    print("CJ S6 att  small   base=" + str(v6b) + " m4=" + str(v6t)
          + " sp=" + str(v6b / v6t) + "x maxdiff=" + str(md6)
          + " | " + _cj_phstr(ph6))

    print("CJ done")
    return 0
