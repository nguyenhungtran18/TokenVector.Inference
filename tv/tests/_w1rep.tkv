# PROBE _w1rep (2026-10-28): reproduce vong fill f32buf `onb[i] = 1.0`
# (dang vong da bi P6 vectorize thanh __init___W1 trong trainer).
# Neu BUF[k] chi co 1.0 o k % 4 == 0 -> stobj Vector4 ghi SAI (chi 4 byte).

def main() -> 'i32':
    n = 8
    p = alloc_bytes(n * 4)
    onb = f32buf_wrap(p, n)
    i = 0
    while i < n:
        onb[i] = 1.0
        i = i + 1
    s = ""
    for k in range(n):
        s = s + str(onb[k]) + " "
    print("BUF=" + s)

    # control 1: list[f32] const-fill (duong ldelema - da co probe _p6x chung minh)
    out: "list[f32]" = []
    j = 0
    while j < n:
        out.append(9.0)
        j = j + 1
    j = 0
    while j < n:
        out[j] = 1.0
        j = j + 1
    s2 = ""
    for k in range(n):
        s2 = s2 + str(out[k]) + " "
    print("LIST=" + s2)
    return 0