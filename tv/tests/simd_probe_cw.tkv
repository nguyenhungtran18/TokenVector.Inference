# PROBE CW — M3a BIEN THE GOC: SONG SONG ACC TILE ROI RAC CHO `_smm_core_pd`
#
# Y TUONG (roadmap §14.5, HANDOFF §0.41 menu con lai): `_smm_core_pd` hien tai
# replay TUYEN TU main: gemm(0)->acc(0)->gemm(1)->acc(1)... voi `_acc_f`
# interpreted (ACC 234-359 ms/call = 1.1-1.7× GEMM, §0.36 CG). Bien the goc:
# main van goi simd_gemm TUYEN TU (ton re-entrancy, CG mode 4: 2 thread
# simd_gemm T>=96 -> HANG) NHUNG moi slot xong gemm la SPAWN worker ACC ngay ->
# acc(0..11) chay SONG SONG voi cac gemm sau do va voi cac acc CUNG KHUC
# (tile roi rac).
#
# DUNG BIT (kỷ luật §13.2 — chay truoc khi noi gi):
# - Gia tri: cung builder, cung ta/tb, cung simd_gemm -> cung Ct.
# - Thu tu tich luy THEO KHUC: acc(t) chi spawn SAU khi join acc(t-1) neu
#   cung (i0,j0) (p-reduction — S3 12 p-tile cung 1 block, S4 2 p-tile/cung
#   i0). Cung khuc -> tung byte giong production (i0->p0->j0).
# - Khuc KHAC nhau -> hinh chu nhat C RIENG (i0 hang, j0 cot) -> ghi doc lap,
#   thu tu khong anh huong.
# - Ct 12 buffer rieng/slot (khong ghi de len Ct dang doc) + join toan bo acc
#   cuoi wave truoc khi wave sau dung lai cung Ct -> khong race.
#
# CAC BIEN THE DA DO (cung kinh nghiem): M3a-pipeline (probe CH) BIT=0.0 nhung
# 0.94-1.10× BUST (§0.38); M3b (CB) bust; M3c (CI) DA WIRE (§0.41).
#
# CHAY (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cw.tkv out/cw.exe main
#   ./out/cw.exe | tee out/cw_run.log
#   python tools/probe_threads.py out/cw.exe 2
#
# GATE wire: >=1.3x tren S4/S5 (S3 bi p-reduction chan — nhan so trung thuc)
# + BIT=0.0 -> thiety `simd_matmul._smm_core_pd`
# -> gate 84/84 + trainer_tests + bench 3 seq (ky luat §13.2).

import tv.training.tensor
import tv.training.simd_matmul

# ---- helpers copy tu simd_matmul (khong dua vao flatten import) ----------

def _cw_imin(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return a
    return b

def _cw_ru64(x: 'i64') -> 'i64':
    r = 64
    while r < x:
        r = r + 64
    return r

def _cw_tilek(k: 'i64') -> 'i64':
    r = _cw_ru64(k)
    if r > 1024:
        r = 1024
    return r

def _cw_ceil(x: 'i64', T: 'i64') -> 'i64':
    q = 0
    r = 0
    while r < x:
        r = r + T
        q = q + 1
    return q

# chia nguyen — g < 0 -> 0 (slot kem gidx = -1 van tinh duoc an toan)
def _cw_gq(g: 'i64', stride: 'i64') -> 'i64':
    if g < 0:
        return 0
    q = 0
    s = g
    while s >= stride:
        s = s - stride
        q = q + 1
    return q

# gidx -> i0/p0/j0 theo thu tu i0 ngoai, p0, j0
# (gidx = i0idx*(n_p*n_j) + p0idx*n_j + j0idx)
def _cw_i0(g: 'i64', stride: 'i64', T: 'i64') -> 'i64':
    return _cw_gq(g, stride) * T

def _cw_p0(g: 'i64', stride: 'i64', n_j: 'i64', T: 'i64') -> 'i64':
    i0idx = _cw_gq(g, stride)
    rem = g - i0idx * stride
    return _cw_gq(rem, n_j) * T

def _cw_j0(g: 'i64', stride: 'i64', n_j: 'i64', T: 'i64') -> 'i64':
    i0idx = _cw_gq(g, stride)
    rem = g - i0idx * stride
    p0idx = _cw_gq(rem, n_j)
    return (rem - p0idx * n_j) * T

# list[f32] zeros — quy uoc append bieu thuc (x - 0.0)/1.0 cho simd_gemm
def _cw_zeros(n: 'i64') -> 'list[f32]':
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    return out

# ---- tile builders (copy nguyen van tu simd_matmul — BIT-EXACT) ----------

def _cw_tile_a_w(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
                 ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z = 0.0
    i = 0
    dst = 0
    j = 0
    src = i0 * kdim + p0
    while i < ib:
        j = 0
        while j < pw:
            out[dst] = d[src + j]
            dst = dst + 1
            j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        src = src + kdim
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

def _cw_tile_b_w(out: "list[f32]", d: "list[f32]", ndim: 'i64', p0: 'i64',
                 pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'i64':
    z = 0.0
    i = 0
    dst = 0
    j = 0
    row = p0 * ndim + r0
    idx = r0 * ndim + p0
    while i < pw:
        if trans_b == 1:
            idx = r0 * ndim + p0 + i
            j = 0
            while j < br:
                out[dst] = d[idx]
                dst = dst + 1
                idx = idx + ndim
                j = j + 1
        else:
            row = (p0 + i) * ndim + r0
            j = 0
            while j < br:
                out[dst] = d[row + j]
                dst = dst + 1
                j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

def _cw_tile_a_at_w(out: "list[f32]", d: "list[f32]", mdim: 'i64', i0: 'i64',
                    ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z = 0.0
    r = 0
    t = 0
    dst = 0
    src = p0 * mdim + i0
    while r < ib:
        t = 0
        src = p0 * mdim + i0 + r
        while t < pw:
            out[dst] = d[src]
            dst = dst + 1
            src = src + mdim
            t = t + 1
        while t < T:
            out[dst] = z
            dst = dst + 1
            t = t + 1
        r = r + 1
    while r < T:
        t = 0
        while t < T:
            out[dst] = z
            dst = dst + 1
            t = t + 1
        r = r + 1
    return 0

def _cw_maxdiff(a: "Tensor", b: "Tensor", cnt: 'i64') -> 'f64':
    dmax = 0.0
    ad = a.data
    bd = b.data
    i = 0
    while i < cnt:
        e = ad[i] - bd[i]
        if e < 0.0:
            e = -e
        if e > dmax:
            dmax = e
        i = i + 1
    return dmax

def _cw_fill(t: "Tensor", seed: 'i64') -> 'i64':
    d = t.data
    m = len(d)
    i = 0
    while i < m:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return m

# ---- workers -------------------------------------------------------------

# builder job — giong _PdJob (simd_matmul): worker chi DUNG TILE, khong simd_gemm
class _CwBJ:
    gidx: 'i64'
    ad: "list[f32]"
    bd: "list[f32]"
    kdim: 'i64'
    mdim: 'i64'
    ndim: 'i64'
    T: 'i64'
    trans_a: 'i32'
    trans_b: 'i32'
    i0: 'i64'
    ib: 'i64'
    p0: 'i64'
    pw: 'i64'
    j0: 'i64'
    jb: 'i64'
    ta: "list[f32]"
    tb: "list[f32]"
    def __init__(self, gidx: 'i64', ad: "list[f32]", bd: "list[f32]",
                  kdim: 'i64', mdim: 'i64', ndim: 'i64', T: 'i64',
                  trans_a: 'i32', trans_b: 'i32',
                  i0: 'i64', ib: 'i64', p0: 'i64', pw: 'i64',
                  j0: 'i64', jb: 'i64', ta: "list[f32]", tb: "list[f32]"):
        self.gidx = gidx
        self.ad = ad
        self.bd = bd
        self.kdim = kdim
        self.mdim = mdim
        self.ndim = ndim
        self.T = T
        self.trans_a = trans_a
        self.trans_b = trans_b
        self.i0 = i0
        self.ib = ib
        self.p0 = p0
        self.pw = pw
        self.j0 = j0
        self.jb = jb
        self.ta = ta
        self.tb = tb

def _cw_one(j: "_CwBJ") -> 'i64':
    # worker: build 1 cap tile (At + Bt) — KHONG simd_gemm (re-entrancy),
    # KHONG append (buffer main pre-alloc) -> an toan concurrent
    if j.gidx < 0:
        return 0
    rv = 0
    if j.trans_a == 1:
        rv = _cw_tile_a_at_w(j.ta, j.ad, j.mdim, j.i0, j.ib, j.p0, j.pw, j.T)
    else:
        rv = _cw_tile_a_w(j.ta, j.ad, j.kdim, j.i0, j.ib, j.p0, j.pw, j.T)
    rv2 = _cw_tile_b_w(j.tb, j.bd, j.ndim, j.p0, j.pw, j.j0, j.jb, j.T, j.trans_b)
    return rv + rv2

# acc job — 1 slot: tich lu Ct vao C[i0:i0+ib, j0:j0+jb]
# (giong _acc_f; field list element write = pattern da chung minh, probe CV)
class _CwAJ:
    cd: "list[f32]"
    ct: "list[f32]"
    i0: 'i64'
    ib: 'i64'
    j0: 'i64'
    jb: 'i64'
    n: 'i64'
    T: 'i64'
    def __init__(self, cd: "list[f32]", ct: "list[f32]", i0: 'i64',
                  ib: 'i64', j0: 'i64', jb: 'i64', n: 'i64', T: 'i64'):
        self.cd = cd
        self.ct = ct
        self.i0 = i0
        self.ib = ib
        self.j0 = j0
        self.jb = jb
        self.n = n
        self.T = T

def _cw_acc(j: "_CwAJ") -> 'i64':
    # worker acc: ghi vao hinh chu nhat C RIENG cua khuc — khong cham vao
    # khuc khac -> concurrent an toan. Copy body _acc_f (simd_matmul) nguyen van.
    cd = j.cd
    ct = j.ct
    n = j.n
    i0 = j.i0
    j0 = j.j0
    r = 0
    bc = i0 * n + j0
    bt = j.T * 0
    c = 0
    while r < j.ib:
        bc = i0 * n + j0 + r * n
        bt = r * j.T
        c = 0
        while c < j.jb:
            cd[bc] = cd[bc] + ct[bt]
            bc = bc + 1
            bt = bt + 1
            c = c + 1
        r = r + 1
    return 0

# ---- CORE: song song ACC tile roi rac -------------------------------------
# Cau truc wave giong production (derive main -> spawn 12 builder -> join),
# nhung replay doi thanh:
#   gemm(t) (main, tuyen tu) -> neu cung khuc voi t-1: join(acc(t-1))
#   -> spawn acc(t)
# cuoi wave: join moi acc CHUA duoc join o tren (nguoc dieu kien khuc).
# Dieu kien khuc: g{t}>=0 and g{t-1}>=0 and i0 chung and j0 chung.
# Hau hop: hA{t} join dung 1 lan (tai spawn t+1 neu khuc, nguoc lai cuoi wave).

def _cw_core(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
             ndim: 'i64', trans_b: 'i32', trans_a: 'i32',
             hoist: 'i32') -> "Tensor":
    T = _cw_imin(_cw_tilek(k), _cw_ru64(_cw_imin(m, n)))
    n_i = _cw_ceil(m, T)
    n_p = _cw_ceil(k, T)
    n_j = _cw_ceil(n, T)
    C = t_zeros([m, n])
    cd = C.data
    # 12 Ct rieng/slot — gemm(t+1) khong ghi de Ct dang duoc acc doc
    c0 = _cw_zeros(T * T)
    c1 = _cw_zeros(T * T)
    c2 = _cw_zeros(T * T)
    c3 = _cw_zeros(T * T)
    c4 = _cw_zeros(T * T)
    c5 = _cw_zeros(T * T)
    c6 = _cw_zeros(T * T)
    c7 = _cw_zeros(T * T)
    c8 = _cw_zeros(T * T)
    c9 = _cw_zeros(T * T)
    c10 = _cw_zeros(T * T)
    c11 = _cw_zeros(T * T)
    ta0 = _cw_zeros(T * T)
    ta1 = _cw_zeros(T * T)
    ta2 = _cw_zeros(T * T)
    ta3 = _cw_zeros(T * T)
    ta4 = _cw_zeros(T * T)
    ta5 = _cw_zeros(T * T)
    ta6 = _cw_zeros(T * T)
    ta7 = _cw_zeros(T * T)
    ta8 = _cw_zeros(T * T)
    ta9 = _cw_zeros(T * T)
    ta10 = _cw_zeros(T * T)
    ta11 = _cw_zeros(T * T)
    tb0 = _cw_zeros(T * T)
    tb1 = _cw_zeros(T * T)
    tb2 = _cw_zeros(T * T)
    tb3 = _cw_zeros(T * T)
    tb4 = _cw_zeros(T * T)
    tb5 = _cw_zeros(T * T)
    tb6 = _cw_zeros(T * T)
    tb7 = _cw_zeros(T * T)
    tb8 = _cw_zeros(T * T)
    tb9 = _cw_zeros(T * T)
    tb10 = _cw_zeros(T * T)
    tb11 = _cw_zeros(T * T)
    stride = n_p * n_j
    ng = n_i * stride
    wave = 0
    while wave * 12 < ng:
        # ---- derive guse + spec slot 0..11 (production pattern) ----------
        g0 = -1
        if wave * 12 + 0 < ng:
            g0 = wave * 12 + 0
        i0_0 = _cw_i0(g0, stride, T)
        ib_0 = _cw_imin(T, m - i0_0)
        p0_0 = _cw_p0(g0, stride, n_j, T)
        pw_0 = _cw_imin(T, k - p0_0)
        j0_0 = _cw_j0(g0, stride, n_j, T)
        jb_0 = _cw_imin(T, n - j0_0)

        g1 = -1
        if wave * 12 + 1 < ng:
            g1 = wave * 12 + 1
        i0_1 = _cw_i0(g1, stride, T)
        ib_1 = _cw_imin(T, m - i0_1)
        p0_1 = _cw_p0(g1, stride, n_j, T)
        pw_1 = _cw_imin(T, k - p0_1)
        j0_1 = _cw_j0(g1, stride, n_j, T)
        jb_1 = _cw_imin(T, n - j0_1)

        g2 = -1
        if wave * 12 + 2 < ng:
            g2 = wave * 12 + 2
        i0_2 = _cw_i0(g2, stride, T)
        ib_2 = _cw_imin(T, m - i0_2)
        p0_2 = _cw_p0(g2, stride, n_j, T)
        pw_2 = _cw_imin(T, k - p0_2)
        j0_2 = _cw_j0(g2, stride, n_j, T)
        jb_2 = _cw_imin(T, n - j0_2)

        g3 = -1
        if wave * 12 + 3 < ng:
            g3 = wave * 12 + 3
        i0_3 = _cw_i0(g3, stride, T)
        ib_3 = _cw_imin(T, m - i0_3)
        p0_3 = _cw_p0(g3, stride, n_j, T)
        pw_3 = _cw_imin(T, k - p0_3)
        j0_3 = _cw_j0(g3, stride, n_j, T)
        jb_3 = _cw_imin(T, n - j0_3)

        g4 = -1
        if wave * 12 + 4 < ng:
            g4 = wave * 12 + 4
        i0_4 = _cw_i0(g4, stride, T)
        ib_4 = _cw_imin(T, m - i0_4)
        p0_4 = _cw_p0(g4, stride, n_j, T)
        pw_4 = _cw_imin(T, k - p0_4)
        j0_4 = _cw_j0(g4, stride, n_j, T)
        jb_4 = _cw_imin(T, n - j0_4)

        g5 = -1
        if wave * 12 + 5 < ng:
            g5 = wave * 12 + 5
        i0_5 = _cw_i0(g5, stride, T)
        ib_5 = _cw_imin(T, m - i0_5)
        p0_5 = _cw_p0(g5, stride, n_j, T)
        pw_5 = _cw_imin(T, k - p0_5)
        j0_5 = _cw_j0(g5, stride, n_j, T)
        jb_5 = _cw_imin(T, n - j0_5)

        g6 = -1
        if wave * 12 + 6 < ng:
            g6 = wave * 12 + 6
        i0_6 = _cw_i0(g6, stride, T)
        ib_6 = _cw_imin(T, m - i0_6)
        p0_6 = _cw_p0(g6, stride, n_j, T)
        pw_6 = _cw_imin(T, k - p0_6)
        j0_6 = _cw_j0(g6, stride, n_j, T)
        jb_6 = _cw_imin(T, n - j0_6)

        g7 = -1
        if wave * 12 + 7 < ng:
            g7 = wave * 12 + 7
        i0_7 = _cw_i0(g7, stride, T)
        ib_7 = _cw_imin(T, m - i0_7)
        p0_7 = _cw_p0(g7, stride, n_j, T)
        pw_7 = _cw_imin(T, k - p0_7)
        j0_7 = _cw_j0(g7, stride, n_j, T)
        jb_7 = _cw_imin(T, n - j0_7)

        g8 = -1
        if wave * 12 + 8 < ng:
            g8 = wave * 12 + 8
        i0_8 = _cw_i0(g8, stride, T)
        ib_8 = _cw_imin(T, m - i0_8)
        p0_8 = _cw_p0(g8, stride, n_j, T)
        pw_8 = _cw_imin(T, k - p0_8)
        j0_8 = _cw_j0(g8, stride, n_j, T)
        jb_8 = _cw_imin(T, n - j0_8)

        g9 = -1
        if wave * 12 + 9 < ng:
            g9 = wave * 12 + 9
        i0_9 = _cw_i0(g9, stride, T)
        ib_9 = _cw_imin(T, m - i0_9)
        p0_9 = _cw_p0(g9, stride, n_j, T)
        pw_9 = _cw_imin(T, k - p0_9)
        j0_9 = _cw_j0(g9, stride, n_j, T)
        jb_9 = _cw_imin(T, n - j0_9)

        g10 = -1
        if wave * 12 + 10 < ng:
            g10 = wave * 12 + 10
        i0_10 = _cw_i0(g10, stride, T)
        ib_10 = _cw_imin(T, m - i0_10)
        p0_10 = _cw_p0(g10, stride, n_j, T)
        pw_10 = _cw_imin(T, k - p0_10)
        j0_10 = _cw_j0(g10, stride, n_j, T)
        jb_10 = _cw_imin(T, n - j0_10)

        g11 = -1
        if wave * 12 + 11 < ng:
            g11 = wave * 12 + 11
        i0_11 = _cw_i0(g11, stride, T)
        ib_11 = _cw_imin(T, m - i0_11)
        p0_11 = _cw_p0(g11, stride, n_j, T)
        pw_11 = _cw_imin(T, k - p0_11)
        j0_11 = _cw_j0(g11, stride, n_j, T)
        jb_11 = _cw_imin(T, n - j0_11)

        # ---- spawn 12 builder (khong simd_gemm — giong production) -------
        hb0 = thread_spawn(_cw_one, _CwBJ(g0, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_0, ib_0, p0_0, pw_0, j0_0, jb_0, ta0, tb0))
        hb1 = thread_spawn(_cw_one, _CwBJ(g1, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_1, ib_1, p0_1, pw_1, j0_1, jb_1, ta1, tb1))
        hb2 = thread_spawn(_cw_one, _CwBJ(g2, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_2, ib_2, p0_2, pw_2, j0_2, jb_2, ta2, tb2))
        hb3 = thread_spawn(_cw_one, _CwBJ(g3, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_3, ib_3, p0_3, pw_3, j0_3, jb_3, ta3, tb3))
        hb4 = thread_spawn(_cw_one, _CwBJ(g4, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_4, ib_4, p0_4, pw_4, j0_4, jb_4, ta4, tb4))
        hb5 = thread_spawn(_cw_one, _CwBJ(g5, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_5, ib_5, p0_5, pw_5, j0_5, jb_5, ta5, tb5))
        hb6 = thread_spawn(_cw_one, _CwBJ(g6, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_6, ib_6, p0_6, pw_6, j0_6, jb_6, ta6, tb6))
        hb7 = thread_spawn(_cw_one, _CwBJ(g7, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_7, ib_7, p0_7, pw_7, j0_7, jb_7, ta7, tb7))
        hb8 = thread_spawn(_cw_one, _CwBJ(g8, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_8, ib_8, p0_8, pw_8, j0_8, jb_8, ta8, tb8))
        hb9 = thread_spawn(_cw_one, _CwBJ(g9, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_9, ib_9, p0_9, pw_9, j0_9, jb_9, ta9, tb9))
        hb10 = thread_spawn(_cw_one, _CwBJ(g10, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_10, ib_10, p0_10, pw_10, j0_10, jb_10, ta10, tb10))
        hb11 = thread_spawn(_cw_one, _CwBJ(g11, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_11, ib_11, p0_11, pw_11, j0_11, jb_11, ta11, tb11))

        # ---- join builder (phai gan bien — quirk P6 GĐ1) ------------------
        rj0 = thread_join(hb0)
        rj1 = thread_join(hb1)
        rj2 = thread_join(hb2)
        rj3 = thread_join(hb3)
        rj4 = thread_join(hb4)
        rj5 = thread_join(hb5)
        rj6 = thread_join(hb6)
        rj7 = thread_join(hb7)
        rj8 = thread_join(hb8)
        rj9 = thread_join(hb9)
        rj10 = thread_join(hb10)
        rj11 = thread_join(hb11)

        # ---- hoist=1 (thiet ke A — §0.36 "ACC theo wave 12"): xong 12
        # gemm TRUOC, roi moi spawn acc -> acc khong cung tai voi simd_gemm
        # (simd_gemm da dung ~22 thread, CG mode 1) -> khong tranh ghi
        if hoist == 1:
            if g0 >= 0:
                simd_gemm(ta0, tb0, c0, T)
            if g1 >= 0:
                simd_gemm(ta1, tb1, c1, T)
            if g2 >= 0:
                simd_gemm(ta2, tb2, c2, T)
            if g3 >= 0:
                simd_gemm(ta3, tb3, c3, T)
            if g4 >= 0:
                simd_gemm(ta4, tb4, c4, T)
            if g5 >= 0:
                simd_gemm(ta5, tb5, c5, T)
            if g6 >= 0:
                simd_gemm(ta6, tb6, c6, T)
            if g7 >= 0:
                simd_gemm(ta7, tb7, c7, T)
            if g8 >= 0:
                simd_gemm(ta8, tb8, c8, T)
            if g9 >= 0:
                simd_gemm(ta9, tb9, c9, T)
            if g10 >= 0:
                simd_gemm(ta10, tb10, c10, T)
            if g11 >= 0:
                simd_gemm(ta11, tb11, c11, T)

        # ---- replay: gemm tuyen tu main + ACC worker song song -----------
        if g0 >= 0:
            if hoist == 0:
                simd_gemm(ta0, tb0, c0, T)
            hA0 = thread_spawn(_cw_acc, _CwAJ(cd, c0, i0_0, ib_0, j0_0, jb_0, n, T))
        if g1 >= 0:
            if hoist == 0:
                simd_gemm(ta1, tb1, c1, T)
            if g0 >= 0 and i0_1 == i0_0 and j0_1 == j0_0:
                rjc1 = thread_join(hA0)
            hA1 = thread_spawn(_cw_acc, _CwAJ(cd, c1, i0_1, ib_1, j0_1, jb_1, n, T))
        if g2 >= 0:
            if hoist == 0:
                simd_gemm(ta2, tb2, c2, T)
            if g1 >= 0 and i0_2 == i0_1 and j0_2 == j0_1:
                rjc2 = thread_join(hA1)
            hA2 = thread_spawn(_cw_acc, _CwAJ(cd, c2, i0_2, ib_2, j0_2, jb_2, n, T))
        if g3 >= 0:
            if hoist == 0:
                simd_gemm(ta3, tb3, c3, T)
            if g2 >= 0 and i0_3 == i0_2 and j0_3 == j0_2:
                rjc3 = thread_join(hA2)
            hA3 = thread_spawn(_cw_acc, _CwAJ(cd, c3, i0_3, ib_3, j0_3, jb_3, n, T))
        if g4 >= 0:
            if hoist == 0:
                simd_gemm(ta4, tb4, c4, T)
            if g3 >= 0 and i0_4 == i0_3 and j0_4 == j0_3:
                rjc4 = thread_join(hA3)
            hA4 = thread_spawn(_cw_acc, _CwAJ(cd, c4, i0_4, ib_4, j0_4, jb_4, n, T))
        if g5 >= 0:
            if hoist == 0:
                simd_gemm(ta5, tb5, c5, T)
            if g4 >= 0 and i0_5 == i0_4 and j0_5 == j0_4:
                rjc5 = thread_join(hA4)
            hA5 = thread_spawn(_cw_acc, _CwAJ(cd, c5, i0_5, ib_5, j0_5, jb_5, n, T))
        if g6 >= 0:
            if hoist == 0:
                simd_gemm(ta6, tb6, c6, T)
            if g5 >= 0 and i0_6 == i0_5 and j0_6 == j0_5:
                rjc6 = thread_join(hA5)
            hA6 = thread_spawn(_cw_acc, _CwAJ(cd, c6, i0_6, ib_6, j0_6, jb_6, n, T))
        if g7 >= 0:
            if hoist == 0:
                simd_gemm(ta7, tb7, c7, T)
            if g6 >= 0 and i0_7 == i0_6 and j0_7 == j0_6:
                rjc7 = thread_join(hA6)
            hA7 = thread_spawn(_cw_acc, _CwAJ(cd, c7, i0_7, ib_7, j0_7, jb_7, n, T))
        if g8 >= 0:
            if hoist == 0:
                simd_gemm(ta8, tb8, c8, T)
            if g7 >= 0 and i0_8 == i0_7 and j0_8 == j0_7:
                rjc8 = thread_join(hA7)
            hA8 = thread_spawn(_cw_acc, _CwAJ(cd, c8, i0_8, ib_8, j0_8, jb_8, n, T))
        if g9 >= 0:
            if hoist == 0:
                simd_gemm(ta9, tb9, c9, T)
            if g8 >= 0 and i0_9 == i0_8 and j0_9 == j0_8:
                rjc9 = thread_join(hA8)
            hA9 = thread_spawn(_cw_acc, _CwAJ(cd, c9, i0_9, ib_9, j0_9, jb_9, n, T))
        if g10 >= 0:
            if hoist == 0:
                simd_gemm(ta10, tb10, c10, T)
            if g9 >= 0 and i0_10 == i0_9 and j0_10 == j0_9:
                rjc10 = thread_join(hA9)
            hA10 = thread_spawn(_cw_acc, _CwAJ(cd, c10, i0_10, ib_10, j0_10, jb_10, n, T))
        if g11 >= 0:
            if hoist == 0:
                simd_gemm(ta11, tb11, c11, T)
            if g10 >= 0 and i0_11 == i0_10 and j0_11 == j0_10:
                rjc11 = thread_join(hA10)
            hA11 = thread_spawn(_cw_acc, _CwAJ(cd, c11, i0_11, ib_11, j0_11, jb_11, n, T))

        # ---- cuoi wave: join cac acc CHUA duoc join o tren ----------------
        # (nguoc dieu kien khuc cua slot t+1 — trung hop VIET MUT: moi handle
        #  dung dung 1 lan)
        if g0 >= 0 and (g1 < 0 or i0_0 != i0_1 or j0_0 != j0_1):
            rje0 = thread_join(hA0)
        if g1 >= 0 and (g2 < 0 or i0_1 != i0_2 or j0_1 != j0_2):
            rje1 = thread_join(hA1)
        if g2 >= 0 and (g3 < 0 or i0_2 != i0_3 or j0_2 != j0_3):
            rje2 = thread_join(hA2)
        if g3 >= 0 and (g4 < 0 or i0_3 != i0_4 or j0_3 != j0_4):
            rje3 = thread_join(hA3)
        if g4 >= 0 and (g5 < 0 or i0_4 != i0_5 or j0_4 != j0_5):
            rje4 = thread_join(hA4)
        if g5 >= 0 and (g6 < 0 or i0_5 != i0_6 or j0_5 != j0_6):
            rje5 = thread_join(hA5)
        if g6 >= 0 and (g7 < 0 or i0_6 != i0_7 or j0_6 != j0_7):
            rje6 = thread_join(hA6)
        if g7 >= 0 and (g8 < 0 or i0_7 != i0_8 or j0_7 != j0_8):
            rje7 = thread_join(hA7)
        if g8 >= 0 and (g9 < 0 or i0_8 != i0_9 or j0_8 != j0_9):
            rje8 = thread_join(hA8)
        if g9 >= 0 and (g10 < 0 or i0_9 != i0_10 or j0_9 != j0_10):
            rje9 = thread_join(hA9)
        if g10 >= 0 and (g11 < 0 or i0_10 != i0_11 or j0_10 != j0_11):
            rje10 = thread_join(hA10)
        if g11 >= 0:
            rje11 = thread_join(hA11)

        wave = wave + 1
    return C

# ---- main: baseline PD vs 2 bien the ACC + BIT + alloc, 3 shape wave ----
# Moi shape: baseline smm_*_pd best-of-3, bien the E (hoist=0, acc ∥ gemm)
# best-of-3, bien the A (hoist=1, 12 gemm truoc -> ACC wave-12 song song,
# khong cung tai gemm — §0.36), BIT ca 2. S1 (vol 4.7M) di serial production
# -> KHONG do (khong relevant).

def main() -> 'i64':
    rs = 3
    nq = 1024
    h = 768
    V = 50257

    print("CW M3a-goc: song song ACC tile roi rac vs baseline PD (best-of " + str(rs) + ")")

    # ---- S3 dxf [nq, h] x [h, ...] = smm_fwd_pd (n_p=66 -> 12 p-tile cung 1 khuc) ----
    a3 = t_zeros([nq, V])
    b3 = t_zeros([V, h])
    _cw_fill(a3, 3)
    _cw_fill(b3, 4)
    v3b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3b = smm_fwd_pd(a3, b3, nq, h, V)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3b:
            v3b = d3
        kk = kk + 1
    v3p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3p = _cw_core(a3, b3, nq, h, V, h, 0, 0, 0)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3p:
            v3p = d3
        kk = kk + 1
    bit3 = _cw_maxdiff(c3b, c3p, nq * h)
    print("S3 dxf    base=" + str(v3b) + " par=" + str(v3p) + " sp=" + str(v3b / v3p) + "x BIT=" + str(bit3) + " (E: acc ∥ gemm; p-reduction 12 p-tile/1 khuc)")
    v3h = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3h = _cw_core(a3, b3, nq, h, V, h, 0, 0, 1)
        t1 = now_ms()
        d3 = t1 - t0
        if d3 < v3h:
            v3h = d3
        kk = kk + 1
    bit3h = _cw_maxdiff(c3b, c3h, nq * h)
    print("S3 dxf    A-hoist=" + str(v3h) + " sp=" + str(v3b / v3h) + "x BIT=" + str(bit3h) + " (A: gemm truoc, ACC wave-12 sau)")

    # ---- S4 dwte [V, h] = smm_fwd_at_pd (n_p=2 -> 2 p-tile/cung i0) ------
    a4 = t_zeros([nq, V])
    b4 = t_zeros([nq, h])
    _cw_fill(a4, 5)
    _cw_fill(b4, 6)
    v4b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4b = smm_fwd_at_pd(a4, b4, V, h, nq)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4b:
            v4b = d4
        kk = kk + 1
    v4p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4p = _cw_core(a4, b4, V, h, nq, h, 0, 1, 0)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4p:
            v4p = d4
        kk = kk + 1
    bit4 = _cw_maxdiff(c4b, c4p, V * h)
    print("S4 dwte   base=" + str(v4b) + " par=" + str(v4p) + " sp=" + str(v4b / v4p) + "x BIT=" + str(bit4) + " (E: acc ∥ gemm)")
    v4h = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4h = _cw_core(a4, b4, V, h, nq, h, 0, 1, 1)
        t1 = now_ms()
        d4 = t1 - t0
        if d4 < v4h:
            v4h = d4
        kk = kk + 1
    bit4h = _cw_maxdiff(c4b, c4h, V * h)
    print("S4 dwte   A-hoist=" + str(v4h) + " sp=" + str(v4b / v4h) + "x BIT=" + str(bit4h) + " (A: gemm truoc, ACC wave-12 sau)")

    # ---- S5 logits [nq, h] x [V, h] = smm_dot_pd (n_p=1 -> moi slot 1 khuc) ----
    a5 = t_zeros([nq, h])
    b5 = t_zeros([V, h])
    _cw_fill(a5, 7)
    _cw_fill(b5, 8)
    v5b = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5b = smm_dot_pd(a5, b5, nq, V, h)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5b:
            v5b = d5
        kk = kk + 1
    v5p = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5p = _cw_core(a5, b5, nq, V, h, h, 1, 0, 0)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5p:
            v5p = d5
        kk = kk + 1
    bit5 = _cw_maxdiff(c5b, c5p, nq * V)
    print("S5 logits base=" + str(v5b) + " par=" + str(v5p) + " sp=" + str(v5b / v5p) + "x BIT=" + str(bit5) + " (E: acc ∥ gemm)")
    v5h = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5h = _cw_core(a5, b5, nq, V, h, h, 1, 0, 1)
        t1 = now_ms()
        d5 = t1 - t0
        if d5 < v5h:
            v5h = d5
        kk = kk + 1
    bit5h = _cw_maxdiff(c5b, c5h, nq * V)
    print("S5 logits A-hoist=" + str(v5h) + " sp=" + str(v5b / v5h) + "x BIT=" + str(bit5h) + " (A: gemm truoc, ACC wave-12 sau)")

    # ---- chi phi alloc 12 Ct buffer (T=768) — bien the +12 list/call ------
    T7 = 768
    t0 = now_ms()
    bc0 = _cw_zeros(T7 * T7)
    bc1 = _cw_zeros(T7 * T7)
    bc2 = _cw_zeros(T7 * T7)
    bc3 = _cw_zeros(T7 * T7)
    bc4 = _cw_zeros(T7 * T7)
    bc5 = _cw_zeros(T7 * T7)
    bc6 = _cw_zeros(T7 * T7)
    bc7 = _cw_zeros(T7 * T7)
    bc8 = _cw_zeros(T7 * T7)
    bc9 = _cw_zeros(T7 * T7)
    bc10 = _cw_zeros(T7 * T7)
    bc11 = _cw_zeros(T7 * T7)
    t1 = now_ms()
    print("alloc 12 Ct buffer (T=768): " + str(t1 - t0) + " ms (co trong so par)")

    print("CW done")
    return 0
