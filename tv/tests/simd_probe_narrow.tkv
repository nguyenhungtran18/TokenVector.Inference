# PROBE NARROW — xac dinh quy tac: bien cuc bo nao duoc khai native i64
# (int64) va bien nao bi boxed thanh TkvInt. Doc .locals trong out/nar.il.
#
#   t1: vong lap don gian (i = 0; i = i + 1)
#   t2: them mot gan KHONG chung minh duoc (s = i * 3) — co lan nguon cho
#       bien dem khong?
#   t3: giu trong khoi `if` (co return) — pham vi khoi anh huong?
#   t4: nhanh kieu P: src = (i0 + i) * kdim + p0  +  dst = dst + 1
#   t5: giu thu tu gan (i = 0 TRUOC, gan "khong chung minh" SAU) — thu tu co
#       quan trong khong?
#   t6: bien dem `for` (range) — co la i64 native?
#   t7: chi `i = i + 1` (khong co i = 0) — bien dem khong khoi tao?
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_narrow.tkv out/nar.exe main
#   grep ".locals" out/nar.il

def t1() -> 'i64':
    i = 0
    while i < 10:
        i = i + 1
    return i

def t2() -> 'i64':
    i = 0
    s = 0
    while i < 10:
        s = i * 3
        i = i + 1
    return s + i

def t3() -> 'i64':
    if 1 == 1:
        i = 0
        while i < 10:
            i = i + 1
        return i
    return 0

def t4(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64', T: 'i64') -> 'i64':
    i = 0
    dst = 0
    while i < T:
        src = (i0 + i) * kdim + 3
        j = 0
        while j < T:
            out[dst] = d[src + j]
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

def t5() -> 'i64':
    i = 0
    while i < 10:
        i = i + 1
    s = 0
    s = s + 1
    return s + i

def t6() -> 'i64':
    s = 0
    for i in range(10):
        s = s + i
    return s

def t7() -> 'i64':
    i = 0
    while i < 10:
        i = i + 1
    j = 5
    while j < 10:
        j = j + 1
    return i + j

def main() -> 'i32':
    print("NAR t1=" + str(t1()) + " t2=" + str(t2()) + " t3=" + str(t3()))
    print("NAR t5=" + str(t5()) + " t6=" + str(t6()) + " t7=" + str(t7()))
    return 0
