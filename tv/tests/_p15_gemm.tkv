# PROBE 15 — GEMM backend head-to-head (seq1024 shapes):
#   A) ATen oneDNN addmm        (onednn_linear_bias)     1024x768 @ 768x3072
#   B) scipy-openblas smm_fwd   (same shape, TV fallback)
#   C) attention head GEMM      smm_dot 1024x1024x64, x12 (1 head per call)
#   D) lm_head                  torch_mm_t 1024x768 @ 768x50257
import tv.training.gpt2_ref124
import tv.training.tensor
import tv.training.simd_matmul

def main() -> 'i32':
    h = 768
    ih = 3072
    n = 1024
    x = t_zeros([n, h])
    w = t_zeros([h, ih])
    b = t_zeros([ih])
    y = t_zeros([n, ih])
    xd = x.data
    wd = w.data
    bd = b.data
    yd = y.data
    # warm both backends
    rcw = onednn_linear_bias(xd, wd, bd, yd, n, h, ih)
    t0 = now_ms()
    rc1 = onednn_linear_bias(xd, wd, bd, yd, n, h, ih)
    rc2 = onednn_linear_bias(xd, wd, bd, yd, n, h, ih)
    rc3 = onednn_linear_bias(xd, wd, bd, yd, n, h, ih)
    rc4 = onednn_linear_bias(xd, wd, bd, yd, n, h, ih)
    rc5 = onednn_linear_bias(xd, wd, bd, yd, n, h, ih)
    t1 = now_ms()
    print("ATEN_ADDMM rc=" + str(rcw) + " 5x=" + str(t1 - t0) + " ms  (" + str((t1 - t0) / 5.0) + "/call)")

    t2 = now_ms()
    a1 = smm_fwd(x, w, n, ih, h)
    a2 = smm_fwd(x, w, n, ih, h)
    a3 = smm_fwd(x, w, n, ih, h)
    a4 = smm_fwd(x, w, n, ih, h)
    a5 = smm_fwd(x, w, n, ih, h)
    t3 = now_ms()
    print("SCIPY_SMM 5x=" + str(t3 - t2) + " ms  (" + str((t3 - t2) / 5.0) + "/call)")

    # attention head GEMM: q[1024,64] @ k^T[64,1024]
    q = t_zeros([n, 64])
    kk = t_zeros([n, 64])
    t4 = now_ms()
    m0 = smm_dot(q, kk, n, n, 64)
    m1 = smm_dot(q, kk, n, n, 64)
    m2 = smm_dot(q, kk, n, n, 64)
    m3 = smm_dot(q, kk, n, n, 64)
    m4 = smm_dot(q, kk, n, n, 64)
    m5 = smm_dot(q, kk, n, n, 64)
    m6 = smm_dot(q, kk, n, n, 64)
    m7 = smm_dot(q, kk, n, n, 64)
    m8 = smm_dot(q, kk, n, n, 64)
    m9 = smm_dot(q, kk, n, n, 64)
    m10 = smm_dot(q, kk, n, n, 64)
    m11 = smm_dot(q, kk, n, n, 64)
    t5 = now_ms()
    print("ATTN 12head(x1)=" + str(t5 - t4) + " ms")

    # lm head
    lg = t_zeros([n, 50257])
    wt = t_zeros([50257, h])
    lg2 = lg.data
    wt2 = wt.data
    t6 = now_ms()
    l0 = torch_mm_t(xd, wt2, lg2, n, h, 50257)
    l1 = torch_mm_t(xd, wt2, lg2, n, h, 50257)
    t7 = now_ms()
    print("LMHEAD rc=" + str(l0) + str(l1) + " 2x=" + str(t7 - t6) + " ms")
    return 0
