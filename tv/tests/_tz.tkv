# _tz — do chi phí t_zeros (vong append) va phep toan elementwise nho
# Chay: tkvc tv/tests/_tz.tkv out/tz.exe main  -> dotnet out/tz_n10.dll
import tv.training.tensor

def main() -> "i32":
    k = 0
    best = 1.0e9
    while k < 5:
        t0 = now_ms()
        q = 0
        acc = 0
        while q < 12:
            a = t_zeros([768, 3072])
            acc = acc + len(a.data)
            q = q + 1
        t1 = now_ms()
        if t1 - t0 < best:
            best = t1 - t0
        k = k + 1
    print("t_zeros([768,3072]) x12 batch: " + str(best) + " ms  (acc=" + str(acc) + ")")

    # gelu-like elementwise tren [8,3072]
    x: "list[f32]" = []
    i = 0
    while i < 8 * 3072:
        x.append(0.3)
        i = i + 1
    y: "list[f32]" = []
    i = 0
    while i < 8 * 3072:
        y.append(0.0)
        i = i + 1
    best2 = 1.0e9
    k = 0
    while k < 5:
        t0 = now_ms()
        q = 0
        while q < 200:
            j = 0
            while j < 8 * 3072:
                v = x[j]
                if v > 0.0:
                    y[j] = v
                else:
                    y[j] = v * 0.5
                j = j + 1
            q = q + 1
        t1 = now_ms()
        if t1 - t0 < best2:
            best2 = t1 - t0
        k = k + 1
    print("elementwise 24576 ptu x200 batch: " + str(best2) + " ms")
    return 0
