# PROBE DWTE ZERO v3 (2026-11-10) — GHI DE hay CONG DON? (input KHAC 0)
# v2 that bai vi wte/xf = 0 -> grad = 0, khong phan biet duoc.
# Lan nay nap xf = 1.0, wte = 1.0 -> grad KHAC 0.
#   - dwte cuoi ~ grad (nho)      -> GHI DE
#   - dwte cuoi ~ 1.0 + grad      -> CONG DON
import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize
    print("=== DWTE ZERO v3 V=" + str(V) + " ===")

    xf = t_zeros([n, h])
    wte = t_zeros([V, h])
    dxf = t_zeros([n, h])
    dwte = t_zeros([V, h])
    logits = t_zeros([n, V])
    pids = alloc_bytes(n * 4)
    j = 0
    while j < n:
        w = write_i32(pids, j * 4, (j * 37 + 11) % 50257)
        j = j + 1

    _lgd = logits.data
    _wtd = wte.data
    _xfd = xf.data
    _dd = dxf.data
    _dw = dwte.data
    sc = 1.0 / float(n)

    # xf = 1.0, wte = 1.0 -> grad khac 0
    k = 0
    while k < n * h:
        _xfd[k] = 1.0
        k = k + 1
    k = 0
    while k < V * h:
        _wtd[k] = 1.0
        k = k + 1

    # nap san dwte = 1.0
    k = 0
    while k < V * h:
        _dw[k] = 1.0
        k = k + 1

    st = lmhead_bwd_fused_list(_lgd, pids, _wtd, _xfd, _dd, _dw, n, 1, h, V, sc)

    # lay 3 phan tu mau
    print("A) dwte[0]    = " + str(_dw[0]))
    print("B) dwte[1000] = " + str(_dw[1000]))
    print("C) dwte[last] = " + str(_dw[V * h - 1]))
    print("D) st=" + str(st))
    if _dw[0] > 0.5:
        print("E) KET LUAN: CONG DON (gia tri ~1.0 con nguyen) -> phai zero, KHONG bo duoc")
    else:
        print("E) KET LUAN: GHI DE -> t_zeros 154MB truoc do VO ICH (tiet kiem ~125 ms)")
    return 0
