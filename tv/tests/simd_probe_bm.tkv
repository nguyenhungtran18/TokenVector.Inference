# PROBE BM — P6 GĐ4: NORM/LOSS/GELU PARALLEL PROTOTYPE (2026-10-21)
#
# So do BL (124.4M) da chot: worker compute scale tuyet voi (3.9s->0.5s) nhung
# GHI DISJOINT vao CUNG list = 0.36x (11.9s) — CHET; own+merge chi thang khi
# merge RE (attention 9.4M copy OK; AdamW 372M copy chet 11.7s).
# BM do TRUC TIPE 4 ung vien GĐ4 + 1 test nguyen nhan (BM[5]):
#   BM[1] norm   — _norm_groups serial vs 12 worker (148 nhom THAT tu ps) +
#                  main gop DUNG thu tu nhom -> BIT-EXACT. BL[4] da do 2.24x
#                  tren 28 nhom synthetic; day do lai tren layout that.
#   BM[2] loss   — gpt2_loss copy serial vs 12 worker row-chunk (own seg f64)
#                  + main gop DUNG thu tu row -> BIT-EXACT (cung phep + thu tu).
#                  Do 3 size: n=1024 (51.5M phan tu), n=256, n=8 (chon guard).
#   BM[3] gfwd   — gelu erf in-place copy serial vs 12 worker own-seg + merge
#                  (maxdiff phai 0.0). Do size 3.14M (n=1024) + 786K (n=256).
#   BM[4] gbwd   — op_gelu_erf_bwd copy serial vs 12 worker own-seg + merge.
#   BM[5] copy   — NGUYEN NHAN ghi chung: copy THUAN 12M (khong boxing phep toan)
#                  serial vs shared-12 vs own+merge — neu shared cung cham ->
#                  container-lock la nguyen nhan BL[2] (bai hoc cho
#                  zero_grad/unflatten sau).
# Bo qua ghi them: value khong denormal; toan bo timing o MAIN (bug #8);
# best-of-2. Chenh lech BIT lay maxdiff/so sanh f64 truc tiep.
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bm.tkv out/bm.exe main
#   ./out/bm.exe

import tv.training.gpt2_ref124
import tv.training.trainer

def _bm_div(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _bm_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _bm_zeros_f32(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _bm_zeros_f64(n: 'i64') -> 'list[f64]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _bm_fill(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 131) % 97) - 48) * 0.07)
    return out

def _bm_fill2(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 77) % 89) - 44) * 0.061)
    return out

def _bm_mcopy(dst: 'list[f32]', sg: 'list[f32]', lo: 'i64', cnt: 'i64') -> 'i32':
    # merge 1 phan vung: dst[lo+i] = sg[i] — goi UNROLLED (khong nested list)
    for i in range(cnt):
        dst[lo + i] = sg[i]
    return 0

def _bm_maxdiff(a: 'list[f32]', b: 'list[f32]', cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        e = a[i] - b[i]
        if e < 0.0:
            e = -e
        if e > dmax:
            dmax = e
        i = i + 1
    return dmax

# ---- gelu erf copy NGUYEN tu tensor.tkv (cung formula -> cung codegen) ----
def _bm_gelu(v: 'f32') -> 'f32':
    return 0.5 * v * (1.0 + erf(v / 1.4142135623730951))

# ---- gpt2_loss copy NGUYEN tu trainer.tkv (list phang thay Tensor.data) ----
def _bm_loss_ser(x: 'list[f32]', ids: 'list[i64]', n: 'i64', V: 'i64') -> 'f64':
    tot = 0.0
    for i in range(n):
        base = i * V
        mx = x[base]
        for o in range(1, V):
            if x[base + o] > mx:
                mx = x[base + o]
        s = 0.0
        for o in range(V):
            s = s + exp(x[base + o] - mx)
        lse = mx + log(s)
        tot = tot + (lse - x[base + ids[i]])
    return tot / float(n)

# ---- _norm_groups copy NGUYEN tu trainer.tkv -------------------------------
def _bm_norm_ser(g: 'list[f32]', groups: 'list[i64]') -> 'f64':
    tot = 0.0
    off = 0
    for k in range(len(groups)):
        cnt = groups[k]
        s = 0.0
        for i in range(cnt):
            s = s + g[off + i] * g[off + i]
        nrm = sqrt(s)
        tot = tot + nrm * nrm
        off = off + cnt
    return sqrt(tot)

# ==== BM[1] NORM worker (giong BL[4]: tinh s nhom, main gop thu tu) ========
class _BmNJob:
    gl: "list[f32]"
    grl: "list[i64]"
    ssl: "list[f64]"
    glo: 'i64'
    ghi: 'i64'
    def __init__(self, gl: "list[f32]", grl: "list[i64]", ssl: "list[f64]",
                  glo: 'i64', ghi: 'i64'):
        self.gl = gl
        self.grl = grl
        self.ssl = ssl
        self.glo = glo
        self.ghi = ghi

def _bm_norm_one(j: "_BmNJob") -> 'i64':
    off = 0
    k = 0
    while k < j.glo:
        off = off + j.grl[k]
        k = k + 1
    kk = j.glo
    while kk < j.ghi:
        cnt = j.grl[kk]
        s = 0.0
        i = 0
        while i < cnt:
            s = s + j.gl[off + i] * j.gl[off + i]
            i = i + 1
        j.ssl[kk] = s
        off = off + cnt
        kk = kk + 1
    return 0

# ==== BM[2] LOSS worker (row-chunk, own seg f64) ============================
class _BmLJob:
    xl: "list[f32]"
    idl: "list[i64]"
    seg: "list[f64]"
    rlo: 'i64'
    rhi: 'i64'
    V: 'i64'
    def __init__(self, xl: "list[f32]", idl: "list[i64]", seg: "list[f64]",
                  rlo: 'i64', rhi: 'i64', V: 'i64'):
        self.xl = xl
        self.idl = idl
        self.seg = seg
        self.rlo = rlo
        self.rhi = rhi
        self.V = V

def _bm_loss_one(j: "_BmLJob") -> 'i64':
    V = j.V
    k = 0
    i = j.rlo
    while i < j.rhi:
        base = i * V
        mx = j.xl[base]
        o = 1
        while o < V:
            if j.xl[base + o] > mx:
                mx = j.xl[base + o]
            o = o + 1
        s = 0.0
        o = 0
        while o < V:
            s = s + exp(j.xl[base + o] - mx)
            o = o + 1
        lse = mx + log(s)
        j.seg[k] = lse - j.xl[base + j.idl[i]]
        k = k + 1
        i = i + 1
    return 0

# ==== BM[3] GELU FWD worker (src -> own seg; main merge vao dst) ============
class _BmGfJob:
    sl: "list[f32]"
    seg: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    def __init__(self, sl: "list[f32]", seg: "list[f32]", lo: 'i64', hi: 'i64'):
        self.sl = sl
        self.seg = seg
        self.lo = lo
        self.hi = hi

def _bm_gf_one(j: "_BmGfJob") -> 'i64':
    k = 0
    i = j.lo
    while i < j.hi:
        j.seg[k] = _bm_gelu(j.sl[i])
        k = k + 1
        i = i + 1
    return 0

# ==== BM[4] GELU BWD worker (x, gy -> own seg; main merge vao g) ============
class _BmGbJob:
    xl: "list[f32]"
    gyl: "list[f32]"
    seg: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    def __init__(self, xl: "list[f32]", gyl: "list[f32]", seg: "list[f32]",
                  lo: 'i64', hi: 'i64'):
        self.xl = xl
        self.gyl = gyl
        self.seg = seg
        self.lo = lo
        self.hi = hi

def _bm_gb_one(j: "_BmGbJob") -> 'i64':
    s = 1.4142135623730951
    k = 0
    i = j.lo
    while i < j.hi:
        v = j.xl[i]
        dgelu = 0.5 * (1.0 + erf(v / s)) + v * 0.3989422804014327 * exp(-0.5 * v * v)
        j.seg[k] = j.gyl[i] * dgelu
        k = k + 1
        i = i + 1
    return 0

# ==== BM[5] COPY worker (thuan copy, khong boxing phep toan) ================
class _BmCJob:
    al: "list[f32]"
    seg: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    def __init__(self, al: "list[f32]", seg: "list[f32]", lo: 'i64', hi: 'i64'):
        self.al = al
        self.seg = seg
        self.lo = lo
        self.hi = hi

def _bm_copy_seg(j: "_BmCJob") -> 'i64':
    k = 0
    i = j.lo
    while i < j.hi:
        j.seg[k] = j.al[i]
        k = k + 1
        i = i + 1
    return 0

class _BmCShJob:
    al: "list[f32]"
    bl: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    def __init__(self, al: "list[f32]", bl: "list[f32]", lo: 'i64', hi: 'i64'):
        self.al = al
        self.bl = bl
        self.lo = lo
        self.hi = hi

def _bm_copy_shared(j: "_BmCShJob") -> 'i64':
    i = j.lo
    while i < j.hi:
        j.bl[i] = j.al[i]
        i = i + 1
    return 0

def main() -> 'i32':
    fails = 0
    ps = gpt2_init(7)
    # groups + flat: flatten ps (124.4M) — g/hop bang gia tri MODEL that
    ng = len(ps)
    groups = []
    noff = []
    tot = 0
    for i in range(ng):
        t = ps[i]
        d = t.data
        groups.append(len(d))
        noff.append(tot)
        tot = tot + len(d)
    N = tot
    print("BM setup: ng=" + str(ng) + " groups  N=" + str(N) + " params")
    flat = _bm_zeros_f32(N)
    for i in range(ng):
        t = ps[i]
        d = t.data
        off = noff[i]
        for j in range(len(d)):
            flat[off + j] = d[j]
    print("BM flat ready")

    # ==== BM[1] NORM — serial vs 12 worker, layout 148 nhom THAT ============
    t0 = now_ms()
    ns = _bm_norm_ser(flat, groups)
    v1s = now_ms() - t0
    v1best = 1.0e18
    krep = 0
    while krep < 2:
        ssl = _bm_zeros_f64(ng)
        # 12 worker — ng nhom: worker t = [t*ng/12, (t+1)*ng/12), UNROLLED
        b0 = _bm_div(0 * ng, 12)
        b1 = _bm_div(1 * ng, 12)
        b2 = _bm_div(2 * ng, 12)
        b3 = _bm_div(3 * ng, 12)
        b4 = _bm_div(4 * ng, 12)
        b5 = _bm_div(5 * ng, 12)
        b6 = _bm_div(6 * ng, 12)
        b7 = _bm_div(7 * ng, 12)
        b8 = _bm_div(8 * ng, 12)
        b9 = _bm_div(9 * ng, 12)
        b10 = _bm_div(10 * ng, 12)
        b11 = _bm_div(11 * ng, 12)
        t0 = now_ms()
        h0 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b0, b1))
        h1 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b1, b2))
        h2 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b2, b3))
        h3 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b3, b4))
        h4 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b4, b5))
        h5 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b5, b6))
        h6 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b6, b7))
        h7 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b7, b8))
        h8 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b8, b9))
        h9 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b9, b10))
        h10 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b10, b11))
        h11 = thread_spawn(_bm_norm_one, _BmNJob(flat, groups, ssl, b11, ng))
        r0 = thread_join(h0)
        r1 = thread_join(h1)
        r2 = thread_join(h2)
        r3 = thread_join(h3)
        r4 = thread_join(h4)
        r5 = thread_join(h5)
        r6 = thread_join(h6)
        r7 = thread_join(h7)
        r8 = thread_join(h8)
        r9 = thread_join(h9)
        r10 = thread_join(h10)
        r11 = thread_join(h11)
        # main gop DUNG thu tu nhom (giong serial: tot += nrm*nrm)
        tot2 = 0.0
        for k in range(ng):
            nrm = sqrt(ssl[k])
            tot2 = tot2 + nrm * nrm
        np_ = sqrt(tot2)
        d1 = now_ms() - t0
        v1best = _bm_smt(v1best, d1)
        krep = krep + 1
    dn = np_ - ns
    if dn < 0.0:
        dn = -dn
    print("BM[1] norm SERIAL=" + str(v1s) + " ms  PAR12=" + str(v1best)
          + " ms  speedup " + str(v1s / v1best) + "  BIT=" + str(dn))
    if dn > 0.0:
        fails = fails + 1

    # ==== BM[2] LOSS — n=1024 / 256 / 8, serial vs 12 worker row-chunk ======
    V = 50257
    L = 1024 * V
    logits = _bm_fill(L)
    ids1024 = []
    i = 0
    while i < 1024:
        ids1024.append((i * 37 + 11) % 50257)
        i = i + 1
    # n=1024
    t0 = now_ms()
    ls = _bm_loss_ser(logits, ids1024, 1024, V)
    v2s = now_ms() - t0
    v2best = 1.0e18
    krep = 0
    while krep < 2:
        seg0 = _bm_zeros_f64(86)
        seg1 = _bm_zeros_f64(86)
        seg2 = _bm_zeros_f64(86)
        seg3 = _bm_zeros_f64(86)
        seg4 = _bm_zeros_f64(86)
        seg5 = _bm_zeros_f64(86)
        seg6 = _bm_zeros_f64(86)
        seg7 = _bm_zeros_f64(86)
        seg8 = _bm_zeros_f64(86)
        seg9 = _bm_zeros_f64(86)
        seg10 = _bm_zeros_f64(85)
        seg11 = _bm_zeros_f64(79)
        t0 = now_ms()
        h0 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg0, 0, 86, V))
        h1 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg1, 86, 172, V))
        h2 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg2, 172, 258, V))
        h3 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg3, 258, 344, V))
        h4 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg4, 344, 430, V))
        h5 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg5, 430, 516, V))
        h6 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg6, 516, 602, V))
        h7 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg7, 602, 688, V))
        h8 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg8, 688, 774, V))
        h9 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg9, 774, 860, V))
        h10 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg10, 860, 945, V))
        h11 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids1024, seg11, 945, 1024, V))
        r0 = thread_join(h0)
        r1 = thread_join(h1)
        r2 = thread_join(h2)
        r3 = thread_join(h3)
        r4 = thread_join(h4)
        r5 = thread_join(h5)
        r6 = thread_join(h6)
        r7 = thread_join(h7)
        r8 = thread_join(h8)
        r9 = thread_join(h9)
        r10 = thread_join(h10)
        r11 = thread_join(h11)
        # main gop DUNG thu tu row
        tot3 = 0.0
        for k in range(86):
            tot3 = tot3 + seg0[k]
        for k in range(86):
            tot3 = tot3 + seg1[k]
        for k in range(86):
            tot3 = tot3 + seg2[k]
        for k in range(86):
            tot3 = tot3 + seg3[k]
        for k in range(86):
            tot3 = tot3 + seg4[k]
        for k in range(86):
            tot3 = tot3 + seg5[k]
        for k in range(86):
            tot3 = tot3 + seg6[k]
        for k in range(86):
            tot3 = tot3 + seg7[k]
        for k in range(86):
            tot3 = tot3 + seg8[k]
        for k in range(86):
            tot3 = tot3 + seg9[k]
        for k in range(85):
            tot3 = tot3 + seg10[k]
        for k in range(79):
            tot3 = tot3 + seg11[k]
        lp = tot3 / float(1024)
        d2 = now_ms() - t0
        v2best = _bm_smt(v2best, d2)
        krep = krep + 1
    dl = lp - ls
    if dl < 0.0:
        dl = -dl
    print("BM[2a] loss n=1024 SERIAL=" + str(v2s) + " ms  PAR12=" + str(v2best)
          + " ms  speedup " + str(v2s / v2best) + "  BIT=" + str(dl))
    if dl > 0.0:
        fails = fails + 1
    # n=256 (guard check) — 256 row, 12 worker lech: 22/21...
    ids256 = []
    i = 0
    while i < 256:
        ids256.append((i * 37 + 11) % 50257)
        i = i + 1
    t0 = now_ms()
    ls2 = _bm_loss_ser(logits, ids256, 256, V)
    v2s2 = now_ms() - t0
    t0 = now_ms()
    segA = _bm_zeros_f64(22)
    segB = _bm_zeros_f64(21)
    segC = _bm_zeros_f64(22)
    segD = _bm_zeros_f64(21)
    segE = _bm_zeros_f64(22)
    segF = _bm_zeros_f64(21)
    segG = _bm_zeros_f64(22)
    segH = _bm_zeros_f64(21)
    segI = _bm_zeros_f64(22)
    segJ = _bm_zeros_f64(21)
    segK = _bm_zeros_f64(22)
    segL = _bm_zeros_f64(19)
    h0 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segA, 0, 22, V))
    h1 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segB, 22, 43, V))
    h2 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segC, 43, 65, V))
    h3 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segD, 65, 86, V))
    h4 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segE, 86, 108, V))
    h5 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segF, 108, 129, V))
    h6 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segG, 129, 151, V))
    h7 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segH, 151, 172, V))
    h8 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segI, 172, 194, V))
    h9 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segJ, 194, 215, V))
    h10 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segK, 215, 237, V))
    h11 = thread_spawn(_bm_loss_one, _BmLJob(logits, ids256, segL, 237, 256, V))
    r0 = thread_join(h0)
    r1 = thread_join(h1)
    r2 = thread_join(h2)
    r3 = thread_join(h3)
    r4 = thread_join(h4)
    r5 = thread_join(h5)
    r6 = thread_join(h6)
    r7 = thread_join(h7)
    r8 = thread_join(h8)
    r9 = thread_join(h9)
    r10 = thread_join(h10)
    r11 = thread_join(h11)
    # merge UNROLLED (khong nested list — bug compiler: list[list] chi 1 loai/main)
    tot4 = 0.0
    for i2 in range(len(segA)):
        tot4 = tot4 + segA[i2]
    for i2 in range(len(segB)):
        tot4 = tot4 + segB[i2]
    for i2 in range(len(segC)):
        tot4 = tot4 + segC[i2]
    for i2 in range(len(segD)):
        tot4 = tot4 + segD[i2]
    for i2 in range(len(segE)):
        tot4 = tot4 + segE[i2]
    for i2 in range(len(segF)):
        tot4 = tot4 + segF[i2]
    for i2 in range(len(segG)):
        tot4 = tot4 + segG[i2]
    for i2 in range(len(segH)):
        tot4 = tot4 + segH[i2]
    for i2 in range(len(segI)):
        tot4 = tot4 + segI[i2]
    for i2 in range(len(segJ)):
        tot4 = tot4 + segJ[i2]
    for i2 in range(len(segK)):
        tot4 = tot4 + segK[i2]
    for i2 in range(len(segL)):
        tot4 = tot4 + segL[i2]
    lp2 = tot4 / float(256)
    v2p2 = now_ms() - t0
    dl2 = lp2 - ls2
    if dl2 < 0.0:
        dl2 = -dl2
    print("BM[2b] loss n=256 SERIAL=" + str(v2s2) + " ms  PAR12=" + str(v2p2)
          + " ms  BIT=" + str(dl2) + " (guard: n*V=" + str(256 * V) + ")")
    if dl2 > 0.0:
        fails = fails + 1
    # n=8 (seq8 — guard nho)
    ids8 = []
    i = 0
    while i < 8:
        ids8.append((i * 37 + 11) % 50257)
        i = i + 1
    t0 = now_ms()
    ls3 = _bm_loss_ser(logits, ids8, 8, V)
    v2s3 = now_ms() - t0
    print("BM[2c] loss n=8 SERIAL=" + str(v2s3) + " ms (guard: n*V=" + str(8 * V) + ")")

    fails = _bm_gelu_fwd() + _bm_gelu_bwd() + _bm_copy_patho()
    if fails == 0:
        print("BM RESULT: ALL BIT-EXACT (fails=0)")
    else:
        print("BM RESULT: FAILS=" + str(fails))
    print("BM done")
    return 0

def _bm_gelu_fwd() -> 'i64':
    # tach thanh ham rieng (bug compiler: main qua lon -> BadImageFormat)
    fails = 0
    # ==== BM[3] GELU FWD — size 3.14M (n=1024) + 786K (n=256) ==============
    G3 = 1024 * 3072
    print("BM[3] G3=" + str(G3))
    gx = _bm_fill2(G3)
    print("BM[3] gx ready")
    t0 = now_ms()
    yser = _bm_zeros_f32(G3)
    print("BM[3] yser alloc ok")
    for i in range(G3):
        yser[i] = _bm_gelu(gx[i])
    v3s = now_ms() - t0
    print("BM[3] yser serial ok")
    v3best = 1.0e18
    sz = _bm_div(G3, 12)
    # alloc TRUOC vong do (bug compiler: khong xay list trong while-loop)
    yp = _bm_zeros_f32(G3)
    print("dbg yp ok")
    seg0 = _bm_zeros_f32(sz)
    seg1 = _bm_zeros_f32(sz)
    seg2 = _bm_zeros_f32(sz)
    seg3 = _bm_zeros_f32(sz)
    seg4 = _bm_zeros_f32(sz)
    seg5 = _bm_zeros_f32(sz)
    seg6 = _bm_zeros_f32(sz)
    seg7 = _bm_zeros_f32(sz)
    seg8 = _bm_zeros_f32(sz)
    seg9 = _bm_zeros_f32(sz)
    seg10 = _bm_zeros_f32(sz)
    seg11 = _bm_zeros_f32(sz)
    print("dbg segs ok")
    krep = 0
    while krep < 2:
        t0 = now_ms()
        h0 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg0, 0, sz))
        print("dbg spawn0 ok")
        h1 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg1, sz, 2 * sz))
        h2 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg2, 2 * sz, 3 * sz))
        h3 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg3, 3 * sz, 4 * sz))
        h4 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg4, 4 * sz, 5 * sz))
        h5 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg5, 5 * sz, 6 * sz))
        h6 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg6, 6 * sz, 7 * sz))
        h7 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg7, 7 * sz, 8 * sz))
        h8 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg8, 8 * sz, 9 * sz))
        h9 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg9, 9 * sz, 10 * sz))
        h10 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg10, 10 * sz, 11 * sz))
        h11 = thread_spawn(_bm_gf_one, _BmGfJob(gx, seg11, 11 * sz, G3))
        r0 = thread_join(h0)
        r1 = thread_join(h1)
        r2 = thread_join(h2)
        r3 = thread_join(h3)
        r4 = thread_join(h4)
        r5 = thread_join(h5)
        r6 = thread_join(h6)
        r7 = thread_join(h7)
        r8 = thread_join(h8)
        r9 = thread_join(h9)
        r10 = thread_join(h10)
        r11 = thread_join(h11)
        print("dbg joins ok")
        t_worker = now_ms() - t0
        t0 = now_ms()
        m0 = _bm_mcopy(yp, seg0, 0, sz)
        m1 = _bm_mcopy(yp, seg1, sz, sz)
        m2 = _bm_mcopy(yp, seg2, 2 * sz, sz)
        m3 = _bm_mcopy(yp, seg3, 3 * sz, sz)
        m4 = _bm_mcopy(yp, seg4, 4 * sz, sz)
        m5 = _bm_mcopy(yp, seg5, 5 * sz, sz)
        m6 = _bm_mcopy(yp, seg6, 6 * sz, sz)
        m7 = _bm_mcopy(yp, seg7, 7 * sz, sz)
        m8 = _bm_mcopy(yp, seg8, 8 * sz, sz)
        m9 = _bm_mcopy(yp, seg9, 9 * sz, sz)
        m10 = _bm_mcopy(yp, seg10, 10 * sz, sz)
        m11 = _bm_mcopy(yp, seg11, 11 * sz, G3 - 11 * sz)
        t_merge = now_ms() - t0
        d3 = t_worker + t_merge
        v3best = _bm_smt(v3best, d3)
        krep = krep + 1
        print("  BM[3] lan do: worker=" + str(t_worker)
              + " merge=" + str(t_merge) + " ms")
    d3b = _bm_maxdiff(yser, yp, G3)
    print("BM[3] gelu_fwd 3.14M SERIAL=" + str(v3s) + " ms  PAR12=" + str(v3best)
          + " ms  speedup " + str(v3s / v3best) + "  BIT=" + str(d3b))
    if d3b > 0.0:
        fails = fails + 1
    # size 786K (n=256) — guard check
    G2 = 256 * 3072
    t0 = now_ms()
    yser2 = _bm_zeros_f32(G2)
    for i in range(G2):
        yser2[i] = _bm_gelu(gx[i])
    v3s2 = now_ms() - t0
    sz2 = _bm_div(G2, 12)
    t0 = now_ms()
    yp2 = _bm_zeros_f32(G2)
    s0 = _bm_zeros_f32(sz2)
    s1 = _bm_zeros_f32(sz2)
    s2 = _bm_zeros_f32(sz2)
    s3 = _bm_zeros_f32(sz2)
    s4 = _bm_zeros_f32(sz2)
    s5 = _bm_zeros_f32(sz2)
    s6 = _bm_zeros_f32(sz2)
    s7 = _bm_zeros_f32(sz2)
    s8 = _bm_zeros_f32(sz2)
    s9 = _bm_zeros_f32(sz2)
    s10 = _bm_zeros_f32(sz2)
    s11 = _bm_zeros_f32(sz2)
    t_alloc2 = now_ms() - t0
    # (merge 3b dung _bm_mcopy unrolled — khong nested list)
    t0 = now_ms()
    w0 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s0, 0, sz2))
    w1 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s1, sz2, 2 * sz2))
    w2 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s2, 2 * sz2, 3 * sz2))
    w3 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s3, 3 * sz2, 4 * sz2))
    w4 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s4, 4 * sz2, 5 * sz2))
    w5 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s5, 5 * sz2, 6 * sz2))
    w6 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s6, 6 * sz2, 7 * sz2))
    w7 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s7, 7 * sz2, 8 * sz2))
    w8 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s8, 8 * sz2, 9 * sz2))
    w9 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s9, 9 * sz2, 10 * sz2))
    w10 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s10, 10 * sz2, 11 * sz2))
    w11 = thread_spawn(_bm_gf_one, _BmGfJob(gx, s11, 11 * sz2, G2))
    x0 = thread_join(w0)
    x1 = thread_join(w1)
    x2 = thread_join(w2)
    x3 = thread_join(w3)
    x4 = thread_join(w4)
    x5 = thread_join(w5)
    x6 = thread_join(w6)
    x7 = thread_join(w7)
    x8 = thread_join(w8)
    x9 = thread_join(w9)
    x10 = thread_join(w10)
    x11 = thread_join(w11)
    t_worker2 = now_ms() - t0
    t0 = now_ms()
    z0 = _bm_mcopy(yp2, s0, 0, sz2)
    z1 = _bm_mcopy(yp2, s1, sz2, sz2)
    z2 = _bm_mcopy(yp2, s2, 2 * sz2, sz2)
    z3 = _bm_mcopy(yp2, s3, 3 * sz2, sz2)
    z4 = _bm_mcopy(yp2, s4, 4 * sz2, sz2)
    z5 = _bm_mcopy(yp2, s5, 5 * sz2, sz2)
    z6 = _bm_mcopy(yp2, s6, 6 * sz2, sz2)
    z7 = _bm_mcopy(yp2, s7, 7 * sz2, sz2)
    z8 = _bm_mcopy(yp2, s8, 8 * sz2, sz2)
    z9 = _bm_mcopy(yp2, s9, 9 * sz2, sz2)
    z10 = _bm_mcopy(yp2, s10, 10 * sz2, sz2)
    z11 = _bm_mcopy(yp2, s11, 11 * sz2, G2 - 11 * sz2)
    t_merge2 = now_ms() - t0
    v3p2 = t_alloc2 + t_worker2 + t_merge2
    # (merge 3b van dung nested lst3 — neu crash tai day thi chi 1 loai/main)
    d3c = _bm_maxdiff(yser2, yp2, G2)
    print("BM[3b] gelu_fwd 786K SERIAL=" + str(v3s2) + " ms  PAR12="
          + str(v3p2) + " ms  BIT=" + str(d3c) + " (alloc=" + str(t_alloc2)
          + " worker=" + str(t_worker2) + " merge=" + str(t_merge2) + ")")
    if d3c > 0.0:
        fails = fails + 1

    return fails

def _bm_gelu_bwd() -> 'i64':
    fails = 0
    # ==== BM[4] GELU BWD — 3.14M ===========================================
    G3 = 1024 * 3072
    sz = _bm_div(G3, 12)
    gx = _bm_fill2(G3)
    gy = _bm_fill(G3)
    t0 = now_ms()
    gser = _bm_zeros_f32(G3)
    s = 1.4142135623730951
    for i in range(G3):
        v = gx[i]
        dgelu = 0.5 * (1.0 + erf(v / s)) + v * 0.3989422804014327 * exp(-0.5 * v * v)
        gser[i] = gy[i] * dgelu
    v4s = now_ms() - t0
    v4best = 1.0e18
    # alloc TRUOC vong do (bug compiler: khong xay list trong while-loop)
    gp = _bm_zeros_f32(G3)
    hseg0 = _bm_zeros_f32(sz)
    hseg1 = _bm_zeros_f32(sz)
    hseg2 = _bm_zeros_f32(sz)
    hseg3 = _bm_zeros_f32(sz)
    hseg4 = _bm_zeros_f32(sz)
    hseg5 = _bm_zeros_f32(sz)
    hseg6 = _bm_zeros_f32(sz)
    hseg7 = _bm_zeros_f32(sz)
    hseg8 = _bm_zeros_f32(sz)
    hseg9 = _bm_zeros_f32(sz)
    hseg10 = _bm_zeros_f32(sz)
    hseg11 = _bm_zeros_f32(sz)
    krep = 0
    while krep < 2:
        t0 = now_ms()
        h0 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg0, 0, sz))
        h1 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg1, sz, 2 * sz))
        h2 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg2, 2 * sz, 3 * sz))
        h3 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg3, 3 * sz, 4 * sz))
        h4 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg4, 4 * sz, 5 * sz))
        h5 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg5, 5 * sz, 6 * sz))
        h6 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg6, 6 * sz, 7 * sz))
        h7 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg7, 7 * sz, 8 * sz))
        h8 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg8, 8 * sz, 9 * sz))
        h9 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg9, 9 * sz, 10 * sz))
        h10 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg10, 10 * sz, 11 * sz))
        h11 = thread_spawn(_bm_gb_one, _BmGbJob(gx, gy, hseg11, 11 * sz, G3))
        r0 = thread_join(h0)
        r1 = thread_join(h1)
        r2 = thread_join(h2)
        r3 = thread_join(h3)
        r4 = thread_join(h4)
        r5 = thread_join(h5)
        r6 = thread_join(h6)
        r7 = thread_join(h7)
        r8 = thread_join(h8)
        r9 = thread_join(h9)
        r10 = thread_join(h10)
        r11 = thread_join(h11)
        t_worker4 = now_ms() - t0
        t0 = now_ms()
        m0 = _bm_mcopy(gp, hseg0, 0, sz)
        m1 = _bm_mcopy(gp, hseg1, sz, sz)
        m2 = _bm_mcopy(gp, hseg2, 2 * sz, sz)
        m3 = _bm_mcopy(gp, hseg3, 3 * sz, sz)
        m4 = _bm_mcopy(gp, hseg4, 4 * sz, sz)
        m5 = _bm_mcopy(gp, hseg5, 5 * sz, sz)
        m6 = _bm_mcopy(gp, hseg6, 6 * sz, sz)
        m7 = _bm_mcopy(gp, hseg7, 7 * sz, sz)
        m8 = _bm_mcopy(gp, hseg8, 8 * sz, sz)
        m9 = _bm_mcopy(gp, hseg9, 9 * sz, sz)
        m10 = _bm_mcopy(gp, hseg10, 10 * sz, sz)
        m11 = _bm_mcopy(gp, hseg11, 11 * sz, G3 - 11 * sz)
        t_merge4 = now_ms() - t0
        d4 = t_worker4 + t_merge4
        v4best = _bm_smt(v4best, d4)
        krep = krep + 1
    d4b = _bm_maxdiff(gser, gp, G3)
    print("BM[4] gelu_bwd 3.14M SERIAL=" + str(v4s) + " ms  PAR12=" + str(v4best)
          + " ms  speedup " + str(v4s / v4best) + "  BIT=" + str(d4b))
    if d4b > 0.0:
        fails = fails + 1

    return fails

def _bm_copy_patho() -> 'i64':
    fails = 0
    # ==== BM[5] COPY PATHOLOGY — copy thuan 12M: serial vs shared vs own ====
    C = 12000000
    ca = _bm_fill(C)
    cb = _bm_zeros_f32(C)
    t0 = now_ms()
    i = 0
    while i < C:
        cb[i] = ca[i]
        i = i + 1
    v5s = now_ms() - t0
    c0 = _bm_div(C, 12)
    c1 = _bm_div(2 * C, 12)
    c2 = _bm_div(3 * C, 12)
    c3 = _bm_div(4 * C, 12)
    c4 = _bm_div(5 * C, 12)
    c5 = _bm_div(6 * C, 12)
    c6 = _bm_div(7 * C, 12)
    c7 = _bm_div(8 * C, 12)
    c8 = _bm_div(9 * C, 12)
    c9 = _bm_div(10 * C, 12)
    c10 = _bm_div(11 * C, 12)
    # shared-12 (ghi truc tiep cb, disjoint)
    v5sh = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        h0 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, 0, c0))
        h1 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c0, c1))
        h2 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c1, c2))
        h3 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c2, c3))
        h4 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c3, c4))
        h5 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c4, c5))
        h6 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c5, c6))
        h7 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c6, c7))
        h8 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c7, c8))
        h9 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c8, c9))
        h10 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c9, c10))
        h11 = thread_spawn(_bm_copy_shared, _BmCShJob(ca, cb, c10, C))
        r0 = thread_join(h0)
        r1 = thread_join(h1)
        r2 = thread_join(h2)
        r3 = thread_join(h3)
        r4 = thread_join(h4)
        r5 = thread_join(h5)
        r6 = thread_join(h6)
        r7 = thread_join(h7)
        r8 = thread_join(h8)
        r9 = thread_join(h9)
        r10 = thread_join(h10)
        r11 = thread_join(h11)
        d5 = now_ms() - t0
        v5sh = _bm_smt(v5sh, d5)
        krep = krep + 1
    # own+merge — alloc TRUOC vong do (bug compiler: khong xay list trong loop)
    cb2 = _bm_zeros_f32(C)
    t1 = _bm_zeros_f32(c0)
    t2 = _bm_zeros_f32(c1 - c0)
    t3 = _bm_zeros_f32(c2 - c1)
    t4 = _bm_zeros_f32(c3 - c2)
    t5 = _bm_zeros_f32(c4 - c3)
    t6 = _bm_zeros_f32(c5 - c4)
    t7 = _bm_zeros_f32(c6 - c5)
    t8 = _bm_zeros_f32(c7 - c6)
    t9 = _bm_zeros_f32(c8 - c7)
    t10 = _bm_zeros_f32(c9 - c8)
    t11 = _bm_zeros_f32(c10 - c9)
    t12 = _bm_zeros_f32(C - c10)
    v5o = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        h0 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t1, 0, c0))
        h1 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t2, c0, c1))
        h2 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t3, c1, c2))
        h3 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t4, c2, c3))
        h4 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t5, c3, c4))
        h5 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t6, c4, c5))
        h6 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t7, c5, c6))
        h7 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t8, c6, c7))
        h8 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t9, c7, c8))
        h9 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t10, c8, c9))
        h10 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t11, c9, c10))
        h11 = thread_spawn(_bm_copy_seg, _BmCJob(ca, t12, c10, C))
        r0 = thread_join(h0)
        r1 = thread_join(h1)
        r2 = thread_join(h2)
        r3 = thread_join(h3)
        r4 = thread_join(h4)
        r5 = thread_join(h5)
        r6 = thread_join(h6)
        r7 = thread_join(h7)
        r8 = thread_join(h8)
        r9 = thread_join(h9)
        r10 = thread_join(h10)
        r11 = thread_join(h11)
        t_worker5 = now_ms() - t0
        t0 = now_ms()
        n0 = _bm_mcopy(cb2, t1, 0, c0)
        n1 = _bm_mcopy(cb2, t2, c0, c1 - c0)
        n2 = _bm_mcopy(cb2, t3, c1, c2 - c1)
        n3 = _bm_mcopy(cb2, t4, c2, c3 - c2)
        n4 = _bm_mcopy(cb2, t5, c3, c4 - c3)
        n5 = _bm_mcopy(cb2, t6, c4, c5 - c4)
        n6 = _bm_mcopy(cb2, t7, c5, c6 - c5)
        n7 = _bm_mcopy(cb2, t8, c6, c7 - c6)
        n8 = _bm_mcopy(cb2, t9, c7, c8 - c7)
        n9 = _bm_mcopy(cb2, t10, c8, c9 - c8)
        n10 = _bm_mcopy(cb2, t11, c9, c10 - c9)
        n11 = _bm_mcopy(cb2, t12, c10, C - c10)
        t_merge5 = now_ms() - t0
        d5o = t_worker5 + t_merge5
        v5o = _bm_smt(v5o, d5o)
        krep = krep + 1
    d5bit = _bm_maxdiff(cb, cb2, C)
    print("BM[5] copy 12M SERIAL=" + str(v5s) + " ms  SHARED12=" + str(v5sh)
          + " ms  OWN+MERGE=" + str(v5o) + " ms (worker=" + str(t_worker5)
          + " merge=" + str(t_merge5) + ")  BIT=" + str(d5bit))
    if d5bit > 0.0:
        fails = fails + 1
    return fails
