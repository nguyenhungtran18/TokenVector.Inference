# PROBE _GM — throughput GEMM tho tai dung 3 shape cua BWD mlp (seq 1024)
# ----------------------------------------------------------------------
# So apple-to-apple voi torch.matmul cung shape (tools/probe_gemm_shape.py).
# Tat ca deu di qua duong production (smm_dot / smm_fwd / smm_fwd_at).
#   seq = dong 1 cua tv/tests/_seq_cfg.txt (mac dinh 1024 neu file khong co)
# Chay: tkvc tv/tests/_gm.tkv out/gm.exe main; ./out/gm.exe
import tv.training.gpt2_ref124
import tv.training.simd_matmul

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_ints(path: 'str') -> 'list[i64]':
    txt = read_file(path)
    lines = txt.split("\n")
    out = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                out.append(int(float(toks[j])))
    return out

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _fill(t: "Tensor", seed: 'i32') -> 'i32':
    d = t.data
    i = 0
    while i < len(d):
        d[i] = float((i * 7 + seed) % 13) * 0.01 - 0.06
        i = i + 1
    return 0

def _gfl(sec: 'f64', m: 'i64', n: 'i64', k: 'i64') -> 'f64':
    return (2.0 * float(m) * float(n) * float(k)) / (sec * 1000000000.0)

def main() -> 'i32':
    cfg = load_ints("tv/tests/_seq_cfg.txt")
    n = 1024
    if len(cfg) > 0:
        n = cfg[0]
    h = HiddenSize
    ih = 4 * h
    print("GM seq=" + str(n) + " h=" + str(h) + " ih=" + str(ih))

    # A: y = x @ w1^T  (m=n, nn=ih, k=h)  -> gpt2_linear fwd trong mlp_bwd
    x = t_zeros([n * h])
    w1 = t_zeros([ih * h])
    f1 = _fill(x, 3)
    f2 = _fill(w1, 5)

    # B: dx2 = gout @ w2^T (m=n, nn=h, k=ih) -> smm_dot trong mlp_bwd
    go = t_zeros([n * ih])
    w2 = t_zeros([h * ih])
    f3 = _fill(go, 7)
    f4 = _fill(w2, 11)

    # C: dw2 = a^T @ gout (m=ih, nn=h, k=n) -> smm_fwd_at
    a2 = t_zeros([n * ih])
    f5 = _fill(a2, 13)

    bA = 1.0e18
    bB = 1.0e18
    bC = 1.0e18
    r = 0
    while r < 3:
        t0 = now_ms()
        yA = smm_fwd(x, w1, n, ih, h)
        t1 = now_ms()
        yB = smm_dot(go, w2, n, h, ih)
        t2 = now_ms()
        yC = smm_fwd_at(a2, go, ih, h, n)
        t3 = now_ms()
        bA = _mn(bA, t1 - t0)
        bB = _mn(bB, t2 - t1)
        bC = _mn(bC, t3 - t2)
        r = r + 1

    sA = bA / 1000.0
    sB = bB / 1000.0
    sC = bC / 1000.0
    print("GM A x@w1T   m=" + str(n) + " n=" + str(ih) + " k=" + str(h) + " = " + str(bA) + " ms  " + str(_gfl(sA, n, ih, h)) + " GFLOP/s")
    print("GM B gout@w2T m=" + str(n) + " n=" + str(h) + " k=" + str(ih) + " = " + str(bB) + " ms  " + str(_gfl(sB, n, h, ih)) + " GFLOP/s")
    print("GM C aT@gout  m=" + str(ih) + " n=" + str(h) + " k=" + str(n) + " = " + str(bC) + " ms  " + str(_gfl(sC, ih, h, n)) + " GFLOP/s")
    print("GM GM_TOTAL_mlp3 = " + str(bA + bB + bC) + " ms")
    print("GM done")
    return 0
