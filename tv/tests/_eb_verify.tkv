# PROBE embed_bwd_fused: native scatter-add vs duong interpreted
#
# Boi canh: tv/tests/tv.training.ops.tkv dang co thay doi CHUA COMMIT them
# native embed_bwd_fused vao op_embed_bwd (tv/training/ da co tu §0.77).
# Truoc khi commit phai chung minh bit-exact.
#
# Hop dong: EmbedBwdFused (tkv_bwd_ops.c, /fp:precise) scatter-add theo idx,
# counts/starts/pos/cursor + main loop q->t->r, gw[r*d+j] += gy[t*d+j],
# zero-fill gw. Moi ptu cong don doc lap, thu tu cong giong .tkv -> bit-exact.
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_eb_verify.tkv out\ebv.exe main
#   copy -> out\ebv_n10.dll + runtimeconfig ; dotnet out\ebv_n10.dll
import tv.training.ops

def _embed_bwd_ref(w: "Tensor", idx: 'list[i64]', d: 'i64', gy: "Tensor") -> "Tensor":
    # ban interpreted NGUYEN VAN (chep tu ops.tkv truoc khi wire native)
    n = len(idx)
    rows = len(w.data) // d
    gw = t_zeros([rows * d])
    counts = []
    for r in range(rows):
        counts.append(0)
    for t in range(n):
        counts[idx[t]] = counts[idx[t]] + 1
    starts = []
    s = 0
    for r in range(rows):
        starts.append(s)
        s = s + counts[r]
    pos = []
    for t in range(n):
        pos.append(0)
    cursor = []
    for r in range(rows):
        cursor.append(starts[r])
    for t in range(n):
        r = idx[t]
        pos[cursor[r]] = t
        cursor[r] = cursor[r] + 1
    for q in range(n):
        t = pos[q]
        r = idx[t]
        for j in range(d):
            gw.data[r * d + j] = gw.data[r * d + j] + gy.data[t * d + j]
    return gw

def _one(rows: 'i64', d: 'i64', n: 'i64', seed: 'i64') -> 'i32':
    # w gia (chi can shape), gy gia tri xac dinh, idx co lap
    w = t_zeros([rows * d])
    gy = t_zeros([n * d])
    i = 0
    while i < n * d:
        gy.data[i] = 0.5 + 0.001 * float(i % 97)
        i = i + 1
    idx: "list[i64]" = []
    i = 0
    st = seed % 2147483648
    while i < n:
        st = (st * 1103515245 + 12345) % 2147483648
        idx.append(st % rows)
        i = i + 1

    a = _embed_bwd_ref(w, idx, d, gy)
    b = op_embed_bwd(w, idx, d, gy)

    bad = 0
    md = 0.0
    i = 0
    while i < rows * d:
        df = a.data[i] - b.data[i]
        if df < 0.0:
            df = 0.0 - df
        if df > md:
            md = df
        if df != 0.0:
            bad = bad + 1
        i = i + 1
    ok = "PASS"
    if bad != 0:
        ok = "FAIL"
    print("  rows=" + str(rows) + " d=" + str(d) + " n=" + str(n)
          + "  bit_bad=" + str(bad) + " max_abs=" + str(md) + "  " + ok)
    if bad != 0:
        return 1
    return 0

def main() -> 'i32':
    print("=== EMBED_BWD_FUSED VERIFY ===")
    f = 0
    f = f + _one(5, 1, 7, 11)
    f = f + _one(5, 3, 7, 12)
    f = f + _one(100, 16, 1024, 13)
    f = f + _one(1000, 64, 1024, 14)
    f = f + _one(50257, 768, 1024, 15)
    f = f + _one(100, 16, 1, 16)
    f = f + _one(7, 1, 1, 17)
    print("=== fails=" + str(f) + " ===")
    return f
