# PROBE _f32p — A/B f32 LOCALS tren hot loop BUILD/ACC (0 thay doi code train)
# Nguon y cau: compiler reply 2026-10-26 (f32() builtin + local f32 khong widen)
#   D:\TokenVector\Release\docs\e_handoff\2026-10-26-f32-builtin-compiler-reply.md
# Ly do: HANDOFF do "wrapper BUILD+ACC+ALLOC = 76-89% FULL" (§0.35/CG) — neu
#   phep toan trong BUILD/ACC dang widen f32->f64->f32 thi local f32 se giam
#   duoc; neu khong -> KHONG wire (§13.2: do truoc, quyet sau).
#
# 2 duong A/B (moi cap cung chinh logic, chi khac kieu local):
#   [1] BUILD: _b64 = dung hien tai (z: f64) vs _b32 (z: "f32")
#       — tile PARTIAL (ib=pw=512 < T=768) de nhanh zero-fill (z) CHAY THAT
#   [2] ACC: _a64 = dung production (cd[bc] = cd[bc] + Ct[bt], khong local)
#       vs _a32 (f32 local trung gian) — neu production dang widen qua f64
#       thi BIT_MAXDIFF != 0 -> that la THONG TIN quyet dinh (numerics contract)
# Do toan bo trong main (bug #8: now_ms() trong local ham doc SAI).
# Phan giai now_ms ~15.6 ms (probe AP/AT) trong khi 1 lan goi ~3 ms -> BATCH
#   120 lan/goi > 300 ms, best-of-3.
#
# Chay:
#   /d/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_f32p.tkv /tmp/_f32p.exe main
#   /tmp/_f32p.exe

# ---- BUILD: ghi day du T^2 (ban copy _tile_a_w, chi khac kieu z) ----
def _b64(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
         ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z = 0.0                    # f64 (hien tai)
    i = 0
    dst = 0
    j = 0
    src = i0 * kdim + p0
    while i < ib:
        j = 0
        while j < pw:
            out[dst] = d[src + j]
            dst = dst + 1
            j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        src = src + kdim
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

def _b32(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
         ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z: "f32" = 0.0             # f32 (moi)
    i = 0
    dst = 0
    j = 0
    src = i0 * kdim + p0
    while i < ib:
        j = 0
        while j < pw:
            out[dst] = d[src + j]
            dst = dst + 1
            j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        src = src + kdim
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

# ---- ACC: cd[bc] += Ct[bt] ----
def _a64(cd: "list[f32]", Ct: "list[f32]", n: 'i64', i0: 'i64',
         ib: 'i64', j0: 'i64', jb: 'i64', T: 'i64') -> 'i64':
    # dung NGUYEN form production (_acc_f khong co local trung gian)
    r = 0
    bc = i0 * n + j0
    bt = 0
    c = 0
    while r < ib:
        bc = i0 * n + j0 + r * n
        bt = r * T
        c = 0
        while c < jb:
            cd[bc] = cd[bc] + Ct[bt]
            bc = bc + 1
            bt = bt + 1
            c = c + 1
        r = r + 1
    return 0

def _a32(cd: "list[f32]", Ct: "list[f32]", n: 'i64', i0: 'i64',
         ib: 'i64', j0: 'i64', jb: 'i64', T: 'i64') -> 'i64':
    # f32 local trung gian — khai o TOP-LEVEL (quy tac native local, BY2)
    v: "f32" = 0.0
    r = 0
    bc = i0 * n + j0
    bt = 0
    c = 0
    while r < ib:
        bc = i0 * n + j0 + r * n
        bt = r * T
        c = 0
        while c < jb:
            v = cd[bc] + Ct[bt]
            cd[bc] = v
            bc = bc + 1
            bt = bt + 1
            c = c + 1
        r = r + 1
    return 0

# ---- so sanh 2 list f32 ----
def _md(a: "list[f32]", b: "list[f32]", n: 'i64') -> 'f64':
    m = 0.0
    i = 0
    while i < n:
        d = float(a[i]) - float(b[i])
        if d < 0.0:
            d = -d
        if d > m:
            m = d
        i = i + 1
    return m

def _f32p_zs(n: 'i64') -> 'list[f32]':
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append((0.0) / 1.0)   # append bieu thuc -> List[Single] (giao cu)
        i = i + 1
    return out

def main() -> 'i32':
    print("=== PROBE _f32p — A/B f32 locals BUILD/ACC (tkvc f32 builtin) ===")

    T = 768
    n = 1536
    runs = 120        # lan goi moi khung do (de vuot phan giai now_ms 15.6ms)
    reps = 3          # best-of-3 khung

    d = _f32p_zs(T * T)
    Ct = _f32p_zs(T * T)
    i = 0
    while i < T * T:
        d[i] = f32(float(i % 97) * 0.001)
        Ct[i] = f32(float(i % 89) * 0.002)
        i = i + 1

    o64 = _f32p_zs(T * T)
    o32 = _f32p_zs(T * T)

    # ---- [1] BUILD A/B: tile PARTIAL 512x512 trong T=768 (zero-fill chay) ----
    best64 = 99999999.0
    best32 = 99999999.0
    k = 0
    while k < reps:
        t0 = now_ms()
        q = 0
        while q < runs:
            _b64(o64, d, T, 0, 512, 0, 512, T)
            q = q + 1
        t1 = now_ms()
        q = 0
        while q < runs:
            _b32(o32, d, T, 0, 512, 0, 512, T)
            q = q + 1
        t2 = now_ms()
        if t1 - t0 < best64:
            best64 = t1 - t0
        if t2 - t1 < best32:
            best32 = t2 - t1
        k = k + 1
    md_b = _md(o64, o32, T * T)
    print("[1] BUILD tile512/768 x" + str(runs) + " batch, best-of-" + str(reps) +
          ": f64=" + str(best64) + " ms  f32=" + str(best32) + " ms  speedup=" +
          str(best64 / best32) + "x  BIT_MAXDIFF=" + str(md_b))

    # ---- [2] ACC A/B ----
    cd64 = _f32p_zs(n * T)
    cd32 = _f32p_zs(n * T)
    best64a = 99999999.0
    best32a = 99999999.0
    k = 0
    while k < reps:
        t0 = now_ms()
        q = 0
        while q < runs:
            _a64(cd64, Ct, n, 0, T, 0, T, T)
            q = q + 1
        t1 = now_ms()
        q = 0
        while q < runs:
            _a32(cd32, Ct, n, 0, T, 0, T, T)
            q = q + 1
        t2 = now_ms()
        if t1 - t0 < best64a:
            best64a = t1 - t0
        if t2 - t1 < best32a:
            best32a = t2 - t1
        k = k + 1
    md_a = _md(cd64, cd32, n * T)
    print("[2] ACC  T=768 x" + str(runs) + " batch, best-of-" + str(reps) +
          ": production=" + str(best64a) + " ms  f32local=" + str(best32a) +
          " ms  speedup=" + str(best64a / best32a) + "x  BIT_MAXDIFF=" + str(md_a))

    # ---- [3] ARITH thuần (khong list access trong vong) — f32 vs f64 local ----
    best64r = 99999999.0
    best32r = 99999999.0
    k = 0
    while k < reps:
        t0 = now_ms()
        acc64 = 1.0
        q = 0
        while q < runs * 100000:
            acc64 = acc64 * 1.000001 + 0.5
            q = q + 1
        t1 = now_ms()
        acc32: "f32" = 1.0
        q = 0
        while q < runs * 100000:
            acc32 = acc32 * 1.000001 + 0.5
            q = q + 1
        t2 = now_ms()
        if t1 - t0 < best64r:
            best64r = t1 - t0
        if t2 - t1 < best32r:
            best32r = t2 - t1
        k = k + 1
    print("[3] ARITH x" + str(runs * 100000) + " batch, best-of" + str(reps) +
          ": f64=" + str(best64r) + " ms  f32=" + str(best32r) + " ms  speedup=" +
          str(best64r / best32r) + "x  (chk acc=" + str(acc64 > 0.0) + ")")

    fails = 0
    if md_b != 0.0:
        print("  [FAIL] BUILD f64 vs f32 khong bit-exact")
        fails = fails + 1
    if md_a != 0.0:
        print("  [FAIL] ACC production vs f32local khong bit-exact (numerics doi!)")
        fails = fails + 1
    print("=== _f32p done fails=" + str(fails) + " ===")
    return fails
