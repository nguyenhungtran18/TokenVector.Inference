# PROBE ZERO COST (2026-11-10) — t_zeros 154 MB that su ton bao nhieu?
# §8 ghi t_zeros([V,h]) = 125 ms va t_zeros([V*h]) = 130 ms cho 154 MB
# => 1.2 GB/s. Memset 154 MB phai ~10-20 ms. Nghi ngo: do interpreted overhead.
import tv.training.gpt2_ref124

def main() -> 'i32':
    h = HiddenSize
    V = VocabSize
    nv: "i64" = V * h
    mb = float(nv * 4) / 1048576.0
    print("=== ZERO COST  V*h=" + str(nv) + "  (" + str(mb) + " MB) ===")

    # --- A) t_zeros 2D [V,h] ---
    _a = t_zeros([V, h])
    t0 = now_ms()
    _b = t_zeros([V, h])
    t1 = now_ms()
    _c = t_zeros([V, h])
    t2 = now_ms()
    _d = t_zeros([V, h])
    t3 = now_ms()
    print("A) t_zeros([V,h])      = " + str(t1 - t0) + " / " + str(t2 - t1) + " / " + str(t3 - t2) + " ms")

    # --- B) t_zeros 1D [V*h] ---
    _e = t_zeros([nv])
    t4 = now_ms()
    _f = t_zeros([nv])
    t5 = now_ms()
    _g = t_zeros([nv])
    t6 = now_ms()
    print("B) t_zeros([V*h])      = " + str(t5 - t4) + " / " + str(t6 - t5) + " ms")

    # --- C) f32_zero tren buffer native (khong alloc) ---
    np = alloc_bytes(nv * 4)
    r1 = f32_zero(np, nv)
    t7 = now_ms()
    r2 = f32_zero(np, nv)
    t8 = now_ms()
    r3 = f32_zero(np, nv)
    t9 = now_ms()
    print("C) f32_zero(buffer)    = " + str(t8 - t7) + " / " + str(t9 - t8) + " ms  r=" + str(r3))
    fz = free_bytes(np)

    # --- D) alloc_bytes(154MB) ---
    t10 = now_ms()
    p = alloc_bytes(nv * 4)
    t11 = now_ms()
    print("D) alloc_bytes(154MB)  = " + str(t11 - t10) + " ms")
    f1 = free_bytes(p)

    # --- E) f32_list_add 154 MB (doc+ghi 308 MB) ---
    buf = t_zeros([nv])
    bl: "list[f32]" = buf.data
    t12 = now_ms()
    ra = f32_list_add(bl, bl, nv)
    t13 = now_ms()
    print("E) f32_list_add 154MB  = " + str(t13 - t12) + " ms  r=" + str(ra))

    print("")
    print("--- ket luan ---")
    print("Neu t_zeros ~125 ms cho 154 MB thi do la 1.2 GB/s = bat thuong.")
    print("So C (memset thuan) va E (doc+ghi 308 MB) de biet tran thuc.")
    return 0
