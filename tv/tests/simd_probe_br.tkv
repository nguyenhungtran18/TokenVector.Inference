# PROBE BR — P6 GĐ7: PHAN RAC FORWARD-SIDE + PLUMBING (2026-10-21)
#
# So do hien tai (AQ GĐ6 @1024): bwd 28.8s; bench full-step 45.0s ->
# ~16s con lai = fwd body 8.0 + LOGITS FWD (chua ai do!) + loss + plumbing.
# Uc vien chua do:
#   BR[1] logits GEMM fwd = smm_dot_pd(xf, wte, n, V, h) — neu cham (vi
#         smm_dot_PD khac smm_fwd_pd — xem smm_fwd_pd do 765ms cung vol)
#   BR[2] gpt2_forward_saved whole (doi chieu)
#   BR[3] LN fwd recompute 24 goi (trong block_bwd) — cache duoc khong
#   BR[4] LN bwd 25 goi (stats recompute tu x)
#   BR[5] zero_grad (124M set)
#   BR[6] AdamW step (124M — BL da do serial 4.2s, xac nhan lai)
#   BR[7] unflatten (124M copy)
#   chk: sum vs whole
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_br.tkv out/br.exe main
#   ./out/br.exe

import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def _br_div(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _br_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _br_fx(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 131) % 97) - 48) * 0.031)
    return out

def _br_ids(n: 'i64') -> 'list[i64]':
    out = []
    i = 0
    while i < n:
        out.append((i * 37 + 11) % 50257)
        i = i + 1
    return out

def _br_pos(n: 'i64') -> 'list[i64]':
    out = []
    i = 0
    while i < n:
        out.append(i)
        i = i + 1
    return out

def main() -> 'i32':
    h = HiddenSize
    n = 1024
    print("BR seq=" + str(n))

    ps = gpt2_init(7)
    ids = _br_ids(n)
    pos = _br_pos(n)

    # xins + xf (1 lan forward, KHONG do)
    x = gpt2_embed(ids, pos, ps[0], ps[1])
    xins = []
    for li in range(NLayers):
        xins.append(x)
        b = 4 + li * 12
        x = gpt2_block(x, ps[b + 0], ps[b + 1], ps[b + 2], ps[b + 3],
                       ps[b + 4], ps[b + 5], ps[b + 6], ps[b + 7],
                       ps[b + 8], ps[b + 9], ps[b + 10], ps[b + 11], 1)
    xf_in = x
    xf = gpt2_layernorm(xf_in, ps[2], ps[3])

    # ---- BR[1] logits GEMM fwd: smm_dot_pd vs smm_fwd_pd (cung vol) -------
    v1a = 1.0e18
    k1 = 0
    while k1 < 2:
        t0 = now_ms()
        logits = smm_dot_pd(xf, ps[0], n, VocabSize, h)
        d1a = now_ms() - t0
        v1a = _br_smt(v1a, d1a)
        k1 = k1 + 1
    print("BR[1a] logits smm_dot_pd = " + str(v1a) + " ms")
    # ---- BR[2] forward_saved whole -----------------------------------------
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        b = 4 + li * 12
        ln1_g.append(ps[b + 0])
        ln1_b.append(ps[b + 1])
        wq.append(ps[b + 2])
        bq.append(ps[b + 3])
        wp.append(ps[b + 4])
        bp.append(ps[b + 5])
        ln2_g.append(ps[b + 6])
        ln2_b.append(ps[b + 7])
        w1.append(ps[b + 8])
        b1.append(ps[b + 9])
        w2.append(ps[b + 10])
        b2.append(ps[b + 11])
    v2 = 1.0e18
    k2 = 0
    while k2 < 2:
        t0 = now_ms()
        sv = gpt2_forward_saved(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq,
                                wp, bp, ln2_g, ln2_b, w1, b1, w2, b2,
                                ps[2], ps[3], 1)
        d2 = now_ms() - t0
        v2 = _br_smt(v2, d2)
        k2 = k2 + 1
    print("BR[2] gpt2_forward_saved whole (embed+12blk+lnf+logits) = " + str(v2) + " ms")

    # ---- BR[3] LN fwd recompute 24 goi -------------------------------------
    v3 = 1.0e18
    k3 = 0
    while k3 < 3:
        t0 = now_ms()
        for li in range(NLayers):
            b = 4 + li * 12
            aa = gpt2_layernorm(xins[li], ps[b + 0], ps[b + 1])
            mm = gpt2_layernorm(xins[li], ps[b + 6], ps[b + 7])
        d3 = now_ms() - t0
        v3 = _br_smt(v3, d3)
        k3 = k3 + 1
    print("BR[3] LN fwd recompute x24 = " + str(v3) + " ms")

    # ---- BR[4] LN bwd x25 (stats tu x) -------------------------------------
    gy = t_new(_br_fx(n * h), [n, h])
    v4 = 1.0e18
    k4 = 0
    while k4 < 2:
        t0 = now_ms()
        for li in range(NLayers):
            b = 4 + li * 12
            rl1 = gpt2_layernorm_bwd(xins[li], ps[b + 0], ps[b + 1], gy)
            rl2 = gpt2_layernorm_bwd(xins[li], ps[b + 6], ps[b + 7], gy)
        rlf = gpt2_layernorm_bwd(xf_in, ps[2], ps[3], gy)
        d4 = now_ms() - t0
        v4 = _br_smt(v4, d4)
        k4 = k4 + 1
    print("BR[4] LN bwd x25 = " + str(v4) + " ms")

    # ---- BR[5-7] plumbing 124M ---------------------------------------------
    npar = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        npar = npar + len(d)
    print("BR n_param = " + str(npar))
    groups = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        groups.append(len(d))
    opt = new_adamw_g(npar, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999,
                      0.00000001, 0.0, 1.0)
    v5 = 1.0e18
    k5 = 0
    while k5 < 2:
        t0 = now_ms()
        opt.zero_grad()
        d5 = now_ms() - t0
        v5 = _br_smt(v5, d5)
        k5 = k5 + 1
    print("BR[5] zero_grad (" + str(npar) + ") = " + str(v5) + " ms")
    # gradient giong shape de step that
    gv = opt.g
    gfill = _br_fx(npar)
    for i in range(npar):
        gv[i] = gfill[i]
    v6 = 1.0e18
    k6 = 0
    while k6 < 2:
        t0 = now_ms()
        opt.step()
        d6 = now_ms() - t0
        v6 = _br_smt(v6, d6)
        k6 = k6 + 1
    print("BR[6] AdamW step = " + str(v6) + " ms")
    v7 = 1.0e18
    k7 = 0
    while k7 < 2:
        t0 = now_ms()
        off = 0
        for i in range(len(ps)):
            t = ps[i]
            d = t.data
            for j in range(len(d)):
                d[j] = opt.p[off + j]
            off = off + len(d)
        d7 = now_ms() - t0
        v7 = _br_smt(v7, d7)
        k7 = k7 + 1
    print("BR[7] unflatten = " + str(v7) + " ms")

    # ---- chk ----------------------------------------------------------------
    sum7 = v1a + v3 + v5 + v6 + v7
    print("BR sum(logits+lnf+lnb+zero+step+unflat) = " + str(sum7)
          + "  forward_saved whole = " + str(v2))
    print("BR done")
    return 0
