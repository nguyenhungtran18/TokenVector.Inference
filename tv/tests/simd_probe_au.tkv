# PROBE AU — test ngon ngu: so sanh `<=` va if/else lon co bi compiler hong khong
def _au_cmp(m: 'i64', n: 'i64') -> 'i32':
    if m <= n:
        return 1
    return 0

def _au_max(m: 'i64', n: 'i64') -> 'i64':
    if m <= n:
        return n
    return m

def main() -> 'i32':
    print("AU fn 256<=2304 -> " + str(_au_cmp(256, 2304)) + " (muon 1)")
    print("AU fn 1024<=64 -> " + str(_au_cmp(1024, 64)) + " (muon 0)")
    print("AU fn 64<=64 -> " + str(_au_cmp(64, 64)) + " (muon 1)")
    print("AU max(256,2304) -> " + str(_au_max(256, 2304)) + " (muon 2304)")
    m2 = 256
    n2 = 2304
    if m2 <= n2:
        print("AU local LE ok")
    else:
        print("AU local LE -> else (SAI)")
    # if/else lon co vong lap trong else — dem xong dung khong
    acc = 0
    if m2 <= n2:
        i = 0
        while i < 100:
            acc = acc + 1
            i = i + 1
    else:
        i = 0
        while i < 1000:
            acc = acc + 10
            i = i + 1
    print("AU if/else loop acc=" + str(acc) + " (muon 100)")
    return 0
