import tv.training.trainer

def _gn32(g: "list[f32]", n: 'i64') -> 'f32':
    return f32(f32_grad_norm(g, n))

def main() -> 'i32':
    n = 124439808
    print("=== GN FINAL n=" + str(n) + " ===")
    g: "list[f32]" = []
    i = 0
    while i < n:
        g.append(0.001)
        i = i + 1
    groups: "list[i64]" = [n]

    bestA = 1.0e9
    rA = 0.0
    kk = 0
    while kk < 3:
        t0 = now_ms()
        rA = _norm_groups(g, groups)
        dt = now_ms() - t0
        if dt < bestA:
            bestA = dt
        kk = kk + 1
    print("A) _norm_groups      ms=" + str(bestA) + "  r=" + str(rA))

    bestB = 1.0e9
    rB = 0.0
    kk = 0
    while kk < 3:
        t0 = now_ms()
        rB = _gn32(g, n)
        dt = now_ms() - t0
        if dt < bestB:
            bestB = dt
        kk = kk + 1
    print("B) f32(native)       ms=" + str(bestB) + "  r=" + str(rB))

    d = rA - rB
    if d < 0.0:
        d = 0.0 - d
    print("max_abs_diff = " + str(d) + "   BIT-IDENTICAL: " + str(d == 0.0))
    print("speedup = " + str(bestA / bestB) + "x   tiet kiem = " + str(bestA - bestB) + " ms")
    return 0
