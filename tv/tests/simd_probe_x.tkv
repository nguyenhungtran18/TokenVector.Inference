# PROBE X — phan ra tier A (fwd 256x768x2304, simd): build tile vs simd_gemm vs full
# Cau tra loi: tile COPY hay GEMM phan dinh toc?
import tv.training.tensor
import tv.training.gpt2_ref
import tv.training.simd_matmul

def _fill(m: 'i64', n: 'i64', kind: 'i64') -> "Tensor":
    out = t_zeros([m, n])
    d = out.data
    for i in range(m * n):
        if kind == 7:
            d[i] = (float((i * 3 + 97) % 101) - 50.0) / 50.0
        if kind == 8:
            d[i] = (float((i * 19 + 3) % 73) - 36.0) / 36.0
    return out

def main() -> 'i32':
    m = 256
    n = 2304
    k = 768
    xb = _fill(256, 768, 7)
    wb = _fill(768, 2304, 8)
    bb = _fill(2304, 1, 12)
    T = _tilek(k)
    print("X T = " + str(T))

    # ---- setup 1 lan cho pha GEMM-only (khong cham vao do) -----------------
    at = _tile_a(xb, k, 0, 256, 0, 768, T)
    bt = _tile_b(wb, n, 0, 768, 0, 768, T, 0)
    ct = _zeros_list(T * T)
    simd_gemm(at, bt, ct, T)

    # ---- PHA 1: GEMM thuan — 3 gemm = 1 fwd (tuong duong flop) ------------
    g0 = now_ms()
    for r in range(10):
        simd_gemm(at, bt, ct, T)
        simd_gemm(at, bt, ct, T)
        simd_gemm(at, bt, ct, T)
    g1 = now_ms()
    print("X gemm-only: total=" + str(g1 - g0) + " ms / 10 fwd-equivalent (3 gemm 768^3 moi phan)")

    # ---- PHA 2: BUILD tile thuan — lap lai dung cong viec cua _smm_core ----
    b0 = now_ms()
    for r in range(5):
        for jj in range(3):
            a1 = _tile_a(xb, k, 0, 256, 0, 768, T)
            b1 = _tile_b(wb, n, 0, 768, jj * 768, 768, T, 0)
            c1 = _zeros_list(T * T)
    b1x = now_ms()
    print("X build-only: total=" + str(b1x - b0) + " ms / 5 fwd-equivalent (A+B+Ct 3 combo)")

    # ---- PHA 3: FULL gpt2_linear fwd (giong gate [9]) ----------------------
    f0 = now_ms()
    for r in range(5):
        y = gpt2_linear(xb, wb, bb, 256, 768, 2304, 1)
    f1 = now_ms()
    print("X full fwd simd: total=" + str(f1 - f0) + " ms / 5 rounds")

    # ---- PHA 4: FULL fwd+bwd (giong bench tier A) --------------------------
    gy = _fill(256, 2304, 9)
    h0 = now_ms()
    for r in range(5):
        y2 = gpt2_linear(xb, wb, bb, 256, 768, 2304, 1)
        g2 = gpt2_linear_bwd(xb, wb, gy, 256, 768, 2304, 1)
    h1 = now_ms()
    print("X full fwd+bwd simd: total=" + str(h1 - h0) + " ms / 5 rounds")
    print("X done")
    return 0
