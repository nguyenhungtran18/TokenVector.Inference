# PROBE BK — P6 GĐ4: PHAN RAC FULL STEP 124M (AdamW + plumbing) (2026-10-21)
#
# Muc dich: chot "khoang thua" con lai = full_step - (fwd + bwd) bang do TUNG
# pha cua _step124 (bench simd_bench_124m_seq) — chon dich GĐ4 theo so do,
# khong doan. Cac pha (theo thu tu goi that):
#   fwd_saved | loss | zero_grad | bwd | grad_norm (rieng) | step (norm+adamw)
#   | unflatten
# GHI CHU: grad_norm tinh RIENG de tach adamw (adamw = step - norm); nhung
# step BEN TRONG van tinh norm 1 lan -> sum7 KHONG gom v_norm (no da nam
# trong v_step).
#
# Cau hinh: tv/tests/_seq_cfg.txt DONG 1 = seq (dong 2/3 khong dung).
# Chay (tu goc repo):
#   printf "1024\n1\n1\n" > tv/tests/_seq_cfg.txt
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bk.tkv out/bk.exe main
#   ./out/bk.exe
# Tat ca timing o MAIN (bug #8). Setup/step copy NGUYEN tu bench (cung
# gpt2_init(7), opt = new_adamw_g(..., total=1000), warmup 1 buoc).

import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

CFG = "tv/tests/_seq_cfg.txt"

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> "list[f32]":
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

def _mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def _mk_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

# ---- forward + LUU activations (copy tu bench — P5.5 saves) ---------------
def _f124_fwd2(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_forward_saved(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                              ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd)

# ---- backward (copy tu bench + saves P5.5) --------------------------------
def _f124_bwd(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32',
              gflat: 'list[f32]' = None, saves: 'list[Tensor]' = None) -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_backward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                         ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd, gflat, saves)

# ---- setup/copy tu bench --------------------------------------------------
def _prepare(opt: "AdamW", ps: 'list[Tensor]') -> 'i32':
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            opt.p[off + j] = d[j]
        off = off + len(d)
    return 0

def _n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def _groups(ps: 'list[Tensor]') -> 'list[i64]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def _mk_opt(n: 'i64', groups: 'list[i64]', total: 'i64') -> "AdamW":
    return new_adamw_g(n, groups, 2, total, 0.05, 0.0025, 0.9, 0.999,
                       0.00000001, 0.0, 1.0)

# ---- 1 buoc train day du (copy tu bench _step124) -------------------------
def _step124(opt: "AdamW", ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'f32':
    sv = _f124_fwd2(ps, ids, pos, simd)
    loss = gpt2_loss(sv[0], ids)
    opt.zero_grad()
    grads = _f124_bwd(ps, ids, pos, simd, opt.g, sv)
    opt.step()
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)
    return loss

def main() -> 'i32':
    cfg = load_ints(CFG)
    seq = cfg[0]
    print("BK seq=" + str(seq))
    ids = _mk_ids(seq)
    pos = _mk_pos(seq)
    ps = gpt2_init(7)
    n = _n_param(ps)
    groups = _groups(ps)
    opt = _mk_opt(n, groups, 1000)
    _prepare(opt, ps)

    # warmup 1 buoc (giong bench — JIT/GC on dinh truoc khi do)
    lw = _step124(opt, ps, ids, pos, 1)

    # ---- PHA theo THU TU goi that cua _step124 ---------------------------
    t0 = now_ms()
    sv = _f124_fwd2(ps, ids, pos, 1)
    v_fwd = now_ms() - t0

    t0 = now_ms()
    loss = gpt2_loss(sv[0], ids)
    v_loss = now_ms() - t0

    t0 = now_ms()
    opt.zero_grad()
    v_zero = now_ms() - t0

    t0 = now_ms()
    grads = _f124_bwd(ps, ids, pos, 1, opt.g, sv)
    v_bwd = now_ms() - t0

    # doc RIENG de tach adamw (pure read, khong thay doi trang thai)
    t0 = now_ms()
    gn = opt.grad_norm()
    v_norm = now_ms() - t0

    t0 = now_ms()
    lr = opt.step()
    v_step = now_ms() - t0

    t0 = now_ms()
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)
    v_unfl = now_ms() - t0

    # sum7 KHONG gom v_norm (norm da nam trong v_step)
    sum7 = v_fwd + v_loss + v_zero + v_bwd + v_step + v_unfl

    # ---- CHK: 1 full step do that + gc delta -----------------------------
    g0 = gc_allocated_bytes()
    t0 = now_ms()
    lchk = _step124(opt, ps, ids, pos, 1)
    v_full = now_ms() - t0
    g1 = gc_allocated_bytes()

    print("BK fwd_saved   = " + str(v_fwd) + " ms")
    print("BK loss        = " + str(v_loss) + " ms  (softmax+ce, n*V)")
    print("BK zero_grad   = " + str(v_zero) + " ms  (124M g = 0)")
    print("BK bwd         = " + str(v_bwd) + " ms  (doi chieu AQ TOTAL_bwd)")
    print("BK grad_norm   = " + str(v_norm) + " ms  (28 nhom, doc rieng)")
    print("BK step        = " + str(v_step) + " ms  (norm + AdamW loop)")
    print("BK   adamw_loop = " + str(v_step - v_norm) + " ms  (step - norm)")
    print("BK unflatten   = " + str(v_unfl) + " ms  (opt.p -> 28 tensor)")
    print("BK SUM7 (khong gom norm rieng) = " + str(sum7) + " ms")
    print("BK FULL_STEP (do that)         = " + str(v_full) + " ms")
    print("BK chk = " + str(sum7 - v_full) + " ms")
    print("BK gc_allocated delta qua 1 buoc = " + str(g1 - g0))
    print("BK loss warm=" + str(lw) + " phase=" + str(loss) + " chk=" + str(lchk))
    print("BK done")
    return 0
