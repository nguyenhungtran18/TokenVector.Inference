# _split — ty trong TUNG PHAN cua shape A (LN_BWD) dung DUNG cau truc _ln_v:
#   _red : chi vong mu (reduction, khong duoc re-order)
#   _wrt : vong ghi (5 cau + 2 branch invariant) - phan bi reject
# CEILING = toan ham nhanh nhat khi vong ghi = 0 ms

def _red(x: "list[f32]", h: "i64") -> "f32":
    mu = 0.0
    k = 0
    while k < h:
        mu = mu + x[k]
        k = k + 1
    mu = mu / float(h)
    return f32(mu)


def _wrt(x: "list[f32]", gy: "list[f32]", g: "list[f32]",
         dx: "list[f32]", dg: "list[f32]", h: "i64", off_dg: "i64") -> "i64":
    mu = 0.0
    rstd = 1.5
    m1 = 0.25
    m2 = 0.5
    j = 0
    for j in range(h):
        xh = (x[j] - mu) * rstd
        gg = gy[j] * g[j]
        dx[j] = rstd * (gg - m1 - xh * m2)
        if off_dg >= 0:
            dg[off_dg + j] = dg[off_dg + j] + gy[j] * xh
        else:
            dg[j] = dg[j] + gy[j] * xh
    return 0


def main() -> "i32":
    h = 16384
    n = 40000
    x: "list[f32]" = []
    gy: "list[f32]" = []
    g: "list[f32]" = []
    i = 0
    while i < n:
        x.append(f32(((i * 7 + 1) % 51) * 0.0625 - 1.5625))
        gy.append(f32(((i * 13 + 3) % 47) * 0.0625 - 1.5625))
        g.append(f32(((i * 29 + 5) % 53) * 0.0625 - 1.5625))
        i = i + 1
    dx: "list[f32]" = []
    dg: "list[f32]" = []
    i = 0
    while i < h:
        dx.append(0.0)
        dg.append(0.0)
        i = i + 1
    runs = 6000
    bestR = 999999999.0
    bestW = 999999999.0
    acc = 0.0
    r = 0
    while r < 3:
        t0 = now_ms()
        q = 0
        while q < runs:
            acc = acc + _red(x, h)
            q = q + 1
        t1 = now_ms()
        q = 0
        while q < runs:
            z = _wrt(x, gy, g, dx, dg, h, -1)
            q = q + 1
        t2 = now_ms()
        if t1 - t0 < bestR:
            bestR = t1 - t0
        if t2 - t1 < bestW:
            bestW = t2 - t1
        r = r + 1
    tot = bestR + bestW
    print("red (vong mu, khong re-order) = " + str(bestR) + " ms (" + str(100.0 * bestR / tot) + "%)")
    print("write (bi reject)             = " + str(bestW) + " ms (" + str(100.0 * bestW / tot) + "%)")
    print("tong = " + str(tot) + " ms   acc=" + str(acc))
    k = 2
    while k <= 8:
        nt = bestR + bestW / float(k)
        print("  write nhanh " + str(k) + "x -> toan ham = " + str(tot / nt) + "x")
        k = k + 1
    print("  CEILING (write = 0) = " + str(tot / bestR) + "x")
    return 0
