# PROBE LCN CHECK — hex bit f32 cua _gi_noise dau tien de so voi Python
import tv.training.gpt2_ref124
import tv.training.tensor

def main() -> 'i32':
    ns = _gi_noise(64, 8)
    p = alloc_bytes(4)
    k = 0
    while k < len(ns):
        write_f32(p, 0, ns[k])
        b = read_i32(p, 0) & 4294967295
        print("LCN " + str(k) + " 0x" + hex(b)[2:].rjust(8, "0"))
        k = k + 1
    free_bytes(p)
    return 0
