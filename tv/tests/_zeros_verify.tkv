# PROBE ZEROS VERIFY (2026-11-10) — 0.0 ms la THAT hay la DCE?
#
# QUAN TRONG VE CACH GOI: `zeros_list` khai return dtype 'i32' (xem
# compile_zeros_list), nen:
#   a = zeros_list(n)          -> a mang kieu i32, truyen cho list[f32] se SAI
#   f(zeros_list(n), n)        -> dung, day la cach production lam (t_zeros)
# Vi vay moi loi goi duoi day deu TRUYEN TRUC TIEP lam doi so.
#
# Cau hoi: sau khi compiler team doi sang `List<T>(TkvZeroSrc(n))`, zeros_list
# do duoc 0.0 ms cho 147 MB. That hay gia?
#
# Gia thuyet: `new T[38597376]` tren LOH chi la buoc con tro; CLR khong zero
# ngay ma dua vao page zero cua OS. Chi phi that bi HOAN sang lan CHAM dau tien.
# Neu dung vay thi:
#   - tao            ~ 0 ms
#   - doc toan bo    ~ 30-60 ms  (page fault cho 147 MB)
#   - tong           ~ 30-60 ms  (truoc day 125-172 ms)
#
# Cach do: tao va doc trong CUNG mot lan goi ham, tach bang now_ms() ben trong.
import tv.training.gpt2_ref124


def alloc_only(z: "list[f32]", n: "i32") -> "f64":
    """Nhan buffer da tao, chi kiem count — khong cham vao du lieu."""
    return float(len(z))


def alloc_then_read(z: "list[f32]", n: "i32") -> "f64":
    """Nhan buffer da tao, doc TUNG phan tu — buoc phai fault het 147 MB."""
    s: "f64" = 0.0
    i: "i32" = 0
    while i < n:
        s = s + float(z[i])
        i = i + 1
    return s


def alloc_then_write(z: "list[f32]", n: "i32") -> "f64":
    """Nhan buffer da tao, GHI tung phan tu — cung buoc fault het 147 MB."""
    i: "i32" = 0
    while i < n:
        z[i] = 1.0
        i = i + 1
    return float(z[n - 1])


def main() -> 'i32':
    print("=== ZEROS VERIFY — 0.0 ms la that hay chi la hoan chi phi? ===")
    n: "i32" = 38597376
    mb: "f64" = float(n * 4) / 1048576.0
    print("n = " + str(n) + "  (" + str(mb) + " MB)")
    print("")

    # ---- A: chi tao, khong cham du lieu ----
    t0 = now_ms()
    rA: "f64" = alloc_only(zeros_list(n), n)
    t1 = now_ms()
    print("A tao, khong cham du lieu : " + str(t1 - t0) + " ms   count=" + str(rA))
    print("")

    # ---- B: tao + doc toan bo (fault het trang) ----
    t2 = now_ms()
    rB: "f64" = alloc_then_read(zeros_list(n), n)
    t3 = now_ms()
    print("B tao + doc toan bo      : " + str(t3 - t2) + " ms   (" + str(mb / (t3 - t2) / 1000.0) + " GB/s)  tong=" + str(rB))
    print("")

    # ---- C: tao + ghi toan bo ----
    t4 = now_ms()
    rC: "f64" = alloc_then_write(zeros_list(n), n)
    t5 = now_ms()
    print("C tao + ghi toan bo      : " + str(t5 - t4) + " ms   (" + str(mb / (t5 - t4) / 1000.0) + " GB/s)  cuoi=" + str(rC))
    print("")

    # ---- D: lan 2 cua B (trang da fault, GC chua thu hoi) ----
    t6 = now_ms()
    rD: "f64" = alloc_then_read(zeros_list(n), n)
    t7 = now_ms()
    print("D tao + doc lan 2        : " + str(t7 - t6) + " ms   (" + str(mb / (t7 - t6) / 1000.0) + " GB/s)  tong=" + str(rD))
    print("")

    # ---- E: kich thuoc nho de so sanh ----
    print("--- kich thuoc nho ---")
    t8 = now_ms()
    rE: "f64" = alloc_then_read(zeros_list(1000000), 1000000)
    t9 = now_ms()
    print("E 1M (3.8 MB) tao + doc  : " + str(t9 - t8) + " ms   tong=" + str(rE))
    print("")

    print("--- doc ---")
    print("A ~ 0 ms va B ~ 30-60 ms  -> chi phi bi HOAN sang lan cham dau (page fault).")
    print("A ~ B ~ 15 ms             -> mang duoc zero ngay luc tao.")
    print("Ca hai deu ~ 0 ms         -> compiler xoa loi goi (DCE), so vo nghia.")
    return 0
