# PROBE BZ — xac dinh quy tac boxing bien cuc bo (int64 native vs TkvInt)
#
# VI SAO: probe BY v1 do bang now_us() (luong tu 15.6 ms) + bien P bi
# compiler ha xuong TkvInt (16 byte) => do sai. BZ nay:
#   [0] do co kieu: vong lap voi kieu bien khac nhau -> so sanh toc do
#       (dung time_perf() = Stopwatch, do phan giay)
#   [1] in ra so phan tu gia de kiem tra ket qua co dung khong
#
# Chung ta CHI can biet: bien nao giu int64 native (nhanh), bien nao
# bi boxing thanh TkvInt (cham).

def _bz_plain(out: "list[f32]", d: "list[f32]", T: 'i64') -> 'i64':
    # bien cuc bo KHONG khai bao kieu (narrow tu suy luon)
    i = 0
    j = 0
    s = 0.0
    while j < T:
        s = s + d[i + j]
        j = j + 1
    out[0] = s
    i = i + 1
    return 0


def _bz_typed(out: "list[f32]", d: "list[f32]", T: 'i64') -> 'i64':
    # bien cuc bo KHAI BAO kieu i64 -> native int64 theo khai bao
    j: 'i64' = 0
    s = 0.0
    while j < T:
        s = s + d[j]
        j = j + 1
    out[1] = s
    return 0


def _bz_typed_multi(out: "list[f32]", d: "list[f32]", T: 'i64') -> 'i64':
    # 2 bien khai bao kieu + 1 bien chua khai bao
    j: 'i64' = 0
    k: 'i64' = 0
    u = 0
    s = 0.0
    while j < T:
        k = k + 1
        s = s + d[j] + d[k]
        j = j + 1
    out[2] = s
    out[3] = float(u)
    return 0


def _bz_star(out: "list[f32]", d: "list[f32]", T: 'i64', kdim: 'i64') -> 'i64':
    # bien 'src' gan bieu thuc co '*' -> co the lam ha bien khac xuong TkvInt
    i = 0
    j = 0
    s = 0.0
    while j < T:
        src = (i + 1) * kdim + j
        s = s + d[src]
        j = j + 1
    out[4] = s
    i = i + 1
    return 0


def main() -> 'i32':
    N = 262144
    d = []
    i = 0
    while i < N:
        d.append(float(i % 1000) / 1000.0)
        i = i + 1
    out = []
    i = 0
    while i < 8:
        out.append(0.0)
        i = i + 1

    R = 20
    t0 = time_perf()
    r = 0
    while r < R:
        rv = _bz_plain(out, d, 4096)
        r = r + 1
    t1 = time_perf()
    tA = t1 - t0

    t0 = time_perf()
    r = 0
    while r < R:
        rv = _bz_typed(out, d, 4096)
        r = r + 1
    t1 = time_perf()
    tB = t1 - t0

    t0 = time_perf()
    r = 0
    while r < R:
        rv = _bz_typed_multi(out, d, 4096)
        r = r + 1
    t1 = time_perf()
    tC = t1 - t0

    t0 = time_perf()
    r = 0
    while r < R:
        rv = _bz_star(out, d, 4096, 64)
        r = r + 1
    t1 = time_perf()
    tD = t1 - t0

    npt = float(R * 4096)
    print("BZ[0] plain  = " + str(tA) + "s  ns/ptu=" + str(tA * 1000000000.0 / npt))
    print("BZ[1] typed  = " + str(tB) + "s  ns/ptu=" + str(tB * 1000000000.0 / npt))
    print("BZ[2] typed2 = " + str(tC) + "s  ns/ptu=" + str(tC * 1000000000.0 / npt))
    print("BZ[3] star   = " + str(tD) + "s  ns/ptu=" + str(tD * 1000000000.0 / npt))
    print("BZ vals=" + str(out[0]) + "," + str(out[1]) + "," + str(out[2]) + "," + str(out[3]) + "," + str(out[4]))
    print("BZ done")
    return 0
