# PROBE BW — P6 GĐ7: MAIN-THREAD + 11 WORKER (2026-10-21)
#
# So do: BN[5] spawn+join 12 worker ATTN_BWD = 516ms wall, serial ref 4468
# (eff 8.66x — worker da toi han 12 luong nhung KHONG hoan hao). Gia thuyet:
# trong luc 11 worker chay, MAIN TINH DUOC 1 HEAD (main dang trong join — rong).
# Uc vien:
#   BW[1] spawn 12 + join (hien tai, P6 GĐ5 packed) — wall
#   BW[2] spawn 11 (head 1..11) + main tinh head 0 bang CUNG worker fn
#         -> maxdiff vs BW[1] output (ky vong 0.0 — cung phep)
#   BW[3] serial 12 head (ref)
# Worker copy NGUYEN VAN tu gpt2_ref (_attn_hb_one packed + _attn_hb_merge).
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bw.tkv out/bw.exe main
#   ./out/bw.exe

import tv.training.gpt2_ref124
import tv.training.simd_matmul

def _bw_div(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _bw_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _bw_fx(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 131) % 97) - 48) * 0.011)
    return out

def _bw_zlist(sz: 'i64') -> 'list[f32]':
    tt = t_zeros([sz])
    return tt.data

class _BwAJob:
    qkvl: "list[f32]"
    dctxl: "list[f32]"
    ctx_out: "list[f32]"
    dq_out: "list[f32]"
    n: 'i64'
    hlo: 'i64'
    hhi: 'i64'
    inv: 'f32'
    def __init__(self, qkvl: "list[f32]", dctxl: "list[f32]",
                  ctx_out: "list[f32]", dq_out: "list[f32]",
                  n: 'i64', hlo: 'i64', hhi: 'i64', inv: 'f32'):
        self.qkvl = qkvl
        self.dctxl = dctxl
        self.ctx_out = ctx_out
        self.dq_out = dq_out
        self.n = n
        self.hlo = hlo
        self.hhi = hhi
        self.inv = inv

# ---- worker copy NGUYEN VAN _attn_hb_one (packed P6 GĐ5 + smm_fwd_at GĐ6) --
def _bw_attn_one(j: "_BwAJob") -> 'i64':
    if j.hlo >= NHeads:
        return 0
    h = HiddenSize
    hd = HeadDim
    n = j.n
    inv = j.inv
    for head in range(j.hlo, j.hhi):
        ho = head * hd
        gQ = t_zeros([n, hd])
        gK = t_zeros([n, hd])
        gV = t_zeros([n, hd])
        gDc = t_zeros([n, hd])
        for t2 in range(n):
            s0 = t2 * 3 * h + ho
            c0 = t2 * h + ho
            for d in range(hd):
                gQ.data[t2 * hd + d] = j.qkvl[s0 + d]
                gK.data[t2 * hd + d] = j.qkvl[s0 + h + d]
                gV.data[t2 * hd + d] = j.qkvl[s0 + 2 * h + d]
                gDc.data[t2 * hd + d] = j.dctxl[c0 + d]
        Smat = smm_dot(gQ, gK, n, n, hd)
        for t2 in range(n):
            b0 = t2 * n
            m0 = Smat.data[b0] * inv
            Smat.data[b0] = m0
            mxv = m0
            for u in range(1, t2 + 1):
                m0 = Smat.data[b0 + u] * inv
                Smat.data[b0 + u] = m0
                if m0 > mxv:
                    mxv = m0
            totv = 0.0
            for u in range(t2 + 1):
                e = exp(Smat.data[b0 + u] - mxv)
                Smat.data[b0 + u] = e
                totv = totv + e
            ivv = 1.0 / totv
            for u in range(t2 + 1):
                Smat.data[b0 + u] = Smat.data[b0 + u] * ivv
            for u in range(t2 + 1, n):
                Smat.data[b0 + u] = 0.0
        gCtx = smm_fwd(Smat, gV, n, hd, n)
        for t2 in range(n):
            d0 = t2 * hd
            for d in range(hd):
                j.ctx_out[d0 + d] = gCtx.data[d0 + d]
        gDp = smm_dot(gDc, gV, n, n, hd)
        gDs = t_zeros([n, n])
        for t2 in range(n):
            b0 = t2 * n
            d0 = t2 * hd
            dotv = 0.0
            for d in range(hd):
                dotv = dotv + gDc.data[d0 + d] * gCtx.data[d0 + d]
            for u in range(t2 + 1):
                gDs.data[b0 + u] = Smat.data[b0 + u] * (gDp.data[b0 + u] - dotv)
            for u in range(t2 + 1, n):
                gDs.data[b0 + u] = 0.0
        gDq = smm_fwd(gDs, gK, n, hd, n)
        gDkT = smm_fwd_at(gQ, gDs, hd, n, n)
        gDvT = smm_fwd_at(gDc, Smat, hd, n, n)
        for t2 in range(n):
            d0 = t2 * hd
            p0 = t2 * 3 * hd
            for d in range(hd):
                j.dq_out[p0 + d] = gDq.data[d0 + d] * inv
                j.dq_out[p0 + hd + d] = gDkT.data[d * n + t2] * inv
                j.dq_out[p0 + 2 * hd + d] = gDvT.data[d * n + t2]
    return j.hhi - j.hlo

def _bw_merge(co: "list[f32]", qo: "list[f32]", ct: "list[f32]", dq: "list[f32]",
              n: 'i64', h: 'i64', hd: 'i64', hlo: 'i64', hhi: 'i64') -> 'i64':
    if hlo >= NHeads:
        return 0
    for head in range(hlo, hhi):
        ho = head * hd
        for t2 in range(n):
            c0 = t2 * h + ho
            p0 = t2 * 3 * hd
            r0 = t2 * 3 * h + ho
            for d in range(hd):
                ct[c0 + d] = co[t2 * hd + d]
                dq[r0 + d] = qo[p0 + d]
                dq[r0 + h + d] = qo[p0 + hd + d]
                dq[r0 + 2 * h + d] = qo[p0 + 2 * hd + d]
    return hhi - hlo

def _bw_run12(qkvl: "list[f32]", dctxl: "list[f32]", n: 'i64', inv: 'f32',
              ct: "list[f32]", dq: "list[f32]") -> 'i64':
    # hien tai: spawn 12 + join + merge
    c0 = _bw_zlist(n * HeadDim)
    c1 = _bw_zlist(n * HeadDim)
    c2 = _bw_zlist(n * HeadDim)
    c3 = _bw_zlist(n * HeadDim)
    c4 = _bw_zlist(n * HeadDim)
    c5 = _bw_zlist(n * HeadDim)
    c6 = _bw_zlist(n * HeadDim)
    c7 = _bw_zlist(n * HeadDim)
    c8 = _bw_zlist(n * HeadDim)
    c9 = _bw_zlist(n * HeadDim)
    c10 = _bw_zlist(n * HeadDim)
    c11 = _bw_zlist(n * HeadDim)
    d0 = _bw_zlist(n * 3 * HeadDim)
    d1 = _bw_zlist(n * 3 * HeadDim)
    d2 = _bw_zlist(n * 3 * HeadDim)
    d3 = _bw_zlist(n * 3 * HeadDim)
    d4 = _bw_zlist(n * 3 * HeadDim)
    d5 = _bw_zlist(n * 3 * HeadDim)
    d6 = _bw_zlist(n * 3 * HeadDim)
    d7 = _bw_zlist(n * 3 * HeadDim)
    d8 = _bw_zlist(n * 3 * HeadDim)
    d9 = _bw_zlist(n * 3 * HeadDim)
    d10 = _bw_zlist(n * 3 * HeadDim)
    d11 = _bw_zlist(n * 3 * HeadDim)
    h0 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c0, d0, n, 0, 1, inv))
    h1 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c1, d1, n, 1, 2, inv))
    h2 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c2, d2, n, 2, 3, inv))
    h3 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c3, d3, n, 3, 4, inv))
    h4 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c4, d4, n, 4, 5, inv))
    h5 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c5, d5, n, 5, 6, inv))
    h6 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c6, d6, n, 6, 7, inv))
    h7 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c7, d7, n, 7, 8, inv))
    h8 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c8, d8, n, 8, 9, inv))
    h9 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c9, d9, n, 9, 10, inv))
    h10 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c10, d10, n, 10, 11, inv))
    h11 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c11, d11, n, 11, 12, inv))
    j0 = thread_join(h0)
    j1 = thread_join(h1)
    j2 = thread_join(h2)
    j3 = thread_join(h3)
    j4 = thread_join(h4)
    j5 = thread_join(h5)
    j6 = thread_join(h6)
    j7 = thread_join(h7)
    j8 = thread_join(h8)
    j9 = thread_join(h9)
    j10 = thread_join(h10)
    j11 = thread_join(h11)
    _bw_merge(c0, d0, ct, dq, n, HiddenSize, HeadDim, 0, 1)
    _bw_merge(c1, d1, ct, dq, n, HiddenSize, HeadDim, 1, 2)
    _bw_merge(c2, d2, ct, dq, n, HiddenSize, HeadDim, 2, 3)
    _bw_merge(c3, d3, ct, dq, n, HiddenSize, HeadDim, 3, 4)
    _bw_merge(c4, d4, ct, dq, n, HiddenSize, HeadDim, 4, 5)
    _bw_merge(c5, d5, ct, dq, n, HiddenSize, HeadDim, 5, 6)
    _bw_merge(c6, d6, ct, dq, n, HiddenSize, HeadDim, 6, 7)
    _bw_merge(c7, d7, ct, dq, n, HiddenSize, HeadDim, 7, 8)
    _bw_merge(c8, d8, ct, dq, n, HiddenSize, HeadDim, 8, 9)
    _bw_merge(c9, d9, ct, dq, n, HiddenSize, HeadDim, 9, 10)
    _bw_merge(c10, d10, ct, dq, n, HiddenSize, HeadDim, 10, 11)
    _bw_merge(c11, d11, ct, dq, n, HiddenSize, HeadDim, 11, 12)
    return 0

def _bw_run11m(qkvl: "list[f32]", dctxl: "list[f32]", n: 'i64', inv: 'f32',
               ct: "list[f32]", dq: "list[f32]") -> 'i64':
    # GĐ7: spawn 11 (head 1..11) + main tinh head 0 TRONG LUC join
    c0 = _bw_zlist(n * HeadDim)
    c1 = _bw_zlist(n * HeadDim)
    c2 = _bw_zlist(n * HeadDim)
    c3 = _bw_zlist(n * HeadDim)
    c4 = _bw_zlist(n * HeadDim)
    c5 = _bw_zlist(n * HeadDim)
    c6 = _bw_zlist(n * HeadDim)
    c7 = _bw_zlist(n * HeadDim)
    c8 = _bw_zlist(n * HeadDim)
    c9 = _bw_zlist(n * HeadDim)
    c10 = _bw_zlist(n * HeadDim)
    c11 = _bw_zlist(n * HeadDim)
    d0 = _bw_zlist(n * 3 * HeadDim)
    d1 = _bw_zlist(n * 3 * HeadDim)
    d2 = _bw_zlist(n * 3 * HeadDim)
    d3 = _bw_zlist(n * 3 * HeadDim)
    d4 = _bw_zlist(n * 3 * HeadDim)
    d5 = _bw_zlist(n * 3 * HeadDim)
    d6 = _bw_zlist(n * 3 * HeadDim)
    d7 = _bw_zlist(n * 3 * HeadDim)
    d8 = _bw_zlist(n * 3 * HeadDim)
    d9 = _bw_zlist(n * 3 * HeadDim)
    d10 = _bw_zlist(n * 3 * HeadDim)
    d11 = _bw_zlist(n * 3 * HeadDim)
    h1 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c1, d1, n, 1, 2, inv))
    h2 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c2, d2, n, 2, 3, inv))
    h3 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c3, d3, n, 3, 4, inv))
    h4 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c4, d4, n, 4, 5, inv))
    h5 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c5, d5, n, 5, 6, inv))
    h6 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c6, d6, n, 6, 7, inv))
    h7 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c7, d7, n, 7, 8, inv))
    h8 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c8, d8, n, 8, 9, inv))
    h9 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c9, d9, n, 9, 10, inv))
    h10 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c10, d10, n, 10, 11, inv))
    h11 = thread_spawn(_bw_attn_one, _BwAJob(qkvl, dctxl, c11, d11, n, 11, 12, inv))
    # main tinh head 0 TRONG LUC 11 worker chay
    _bw_attn_one(_BwAJob(qkvl, dctxl, c0, d0, n, 0, 1, inv))
    j1 = thread_join(h1)
    j2 = thread_join(h2)
    j3 = thread_join(h3)
    j4 = thread_join(h4)
    j5 = thread_join(h5)
    j6 = thread_join(h6)
    j7 = thread_join(h7)
    j8 = thread_join(h8)
    j9 = thread_join(h9)
    j10 = thread_join(h10)
    j11 = thread_join(h11)
    _bw_merge(c0, d0, ct, dq, n, HiddenSize, HeadDim, 0, 1)
    _bw_merge(c1, d1, ct, dq, n, HiddenSize, HeadDim, 1, 2)
    _bw_merge(c2, d2, ct, dq, n, HiddenSize, HeadDim, 2, 3)
    _bw_merge(c3, d3, ct, dq, n, HiddenSize, HeadDim, 3, 4)
    _bw_merge(c4, d4, ct, dq, n, HiddenSize, HeadDim, 4, 5)
    _bw_merge(c5, d5, ct, dq, n, HiddenSize, HeadDim, 5, 6)
    _bw_merge(c6, d6, ct, dq, n, HiddenSize, HeadDim, 6, 7)
    _bw_merge(c7, d7, ct, dq, n, HiddenSize, HeadDim, 7, 8)
    _bw_merge(c8, d8, ct, dq, n, HiddenSize, HeadDim, 8, 9)
    _bw_merge(c9, d9, ct, dq, n, HiddenSize, HeadDim, 9, 10)
    _bw_merge(c10, d10, ct, dq, n, HiddenSize, HeadDim, 10, 11)
    _bw_merge(c11, d11, ct, dq, n, HiddenSize, HeadDim, 11, 12)
    return 0

def main() -> 'i32':
    h = HiddenSize
    hd = HeadDim
    n = 1024
    inv = 1.0 / sqrt(float(hd))
    print("BW seq=" + str(n) + " h=" + str(h) + " hd=" + str(hd))

    qkvl = _bw_fx(n * 3 * h)
    dctxl = _bw_fx(n * h)

    v1 = 1.0e18
    ct1 = _bw_zlist(n * h)
    dq1 = _bw_zlist(n * 3 * h)
    k1 = 0
    while k1 < 2:
        t0 = now_ms()
        _bw_run12(qkvl, dctxl, n, inv, ct1, dq1)
        d1 = now_ms() - t0
        v1 = _bw_smt(v1, d1)
        k1 = k1 + 1
    print("BW[1] spawn 12 + join + merge = " + str(v1) + " ms")

    v2 = 1.0e18
    md2 = 0.0
    k2 = 0
    while k2 < 2:
        ct2 = _bw_zlist(n * h)
        dq2 = _bw_zlist(n * 3 * h)
        t0 = now_ms()
        _bw_run11m(qkvl, dctxl, n, inv, ct2, dq2)
        d2 = now_ms() - t0
        v2 = _bw_smt(v2, d2)
        if k2 == 1:
            md2 = 0.0
            for k in range(n * h):
                dv = ct1[k] - ct2[k]
                if dv < 0.0:
                    dv = -dv
                if dv > md2:
                    md2 = dv
            for k in range(n * 3 * h):
                dv = dq1[k] - dq2[k]
                if dv < 0.0:
                    dv = -dv
                if dv > md2:
                    md2 = dv
        k2 = k2 + 1
    print("BW[2] spawn 11 + main head0 + join + merge = " + str(v2)
          + " ms  maxdiff=" + str(md2))

    v3 = 1.0e18
    k3 = 0
    while k3 < 1:
        ct3 = _bw_zlist(n * h)
        dq3 = _bw_zlist(n * 3 * h)
        t0 = now_ms()
        for kk in range(12):
            _bw_attn_one(_BwAJob(qkvl, dctxl,
                                 _bw_zlist(n * hd), _bw_zlist(n * 3 * hd),
                                 n, kk, kk + 1, inv))
        d3 = now_ms() - t0
        v3 = _bw_smt(v3, d3)
        k3 = k3 + 1
    print("BW[3] serial 12 head = " + str(v3) + " ms  eff12=" + str(v3 / v1)
          + "  eff(main+11)=" + str(v3 / v2))
    print("BW done")
    return 0
