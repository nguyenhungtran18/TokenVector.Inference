# PROBE CD — P7b: DO KHOANG CACH GEMM NATIVE vs TORCH (2026-10-22)
#
# Boi canh (§13.1): ATTN+MLP+LHEAD = 24.1s = 66% buoc @seq1024 — ghi la
# "near-peak AVX2" NHUNG torch chay ca buoc trong 3.542s -> mau thuan: neu
# GEMM that near torch thi full step phai << 36.7s. Phai kiem lai "near-peak"
# o muc HE THONG.
#
# tkv KHONG import torch duoc -> 2 nua cung phien: probe nay do WRAPPER
# (smm_fwd/smm_dot/smm_fwd_at = tile-build + simd_gemm + accumulate) tren
# 4 shape dai dien, in ms + GFLOPS; chay them tools/p7b_gemm_torch.py cung
# shape lay so torch. Do cung phien, cung may.
#
# 4 shape that cua buoc 124M (giong probe BH S1/S3/S4/S5, wrapper cung hop dong):
#   S1 dx1      [1024 x 768 x 3072]   smm_dot    m=nq n=h  k=4h
#   S3 dxf      [1024 x 768 x 50257]  smm_fwd    m=nq n=h  k=V
#   S4 dwte     [50257 x 768 x 1024]  smm_fwd_at m=V  n=h  k=nq
#   S5 logits   [1024 x 50257 x 768]  smm_dot    m=nq n=V  k=h
#
# Cau hinh: khong can _seq_cfg.txt (4 shape hard-code theo seq1024).
# Chay (tu goc repo) — giong probe AV:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cd.tkv out/cd.exe main
#   out/cd.exe
#   python tools/p7b_gemm_torch.py
import tv.training.tensor
import tv.training.simd_matmul
import tv.training.gpt2_ref124

def _cd_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _cd_fill(t: "Tensor", seed: 'i64') -> 'i64':
    d = t.data
    m = len(d)
    i = 0
    while i < m:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return m

def _cd_gflops(m: 'i64', n: 'i64', k: 'i64', ms: 'f64') -> 'f64':
    return 2.0 * float(m) * float(n) * float(k) / (ms * 1000000.0)

# ---- 4 shape: best-of (rs lan), in ms + GFLOPS -----------------------------
def main() -> 'i32':
    nq = 1024
    h = 768
    V = 50257
    four = 3072
    rs = 3

    # S1 dx1 = gy[nq,four] x w1[h,four] -> smm_dot(a,b,m,n,k) = a[m,k] x b[n,k]^T
    a1 = t_zeros([nq, four])
    b1 = t_zeros([h, four])
    _cd_fill(a1, 1)
    _cd_fill(b1, 2)
    v1 = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c1 = smm_dot(a1, b1, nq, h, four)
        t1 = now_ms()
        v1 = _cd_smt(v1, t1 - t0)
        kk = kk + 1

    # S3 dxf = gg[nq,V] x wte[V,h] -> smm_fwd = a[m,k] x b[k,n]
    a3 = t_zeros([nq, V])
    b3 = t_zeros([V, h])
    _cd_fill(a3, 3)
    _cd_fill(b3, 4)
    v3 = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c3 = smm_fwd(a3, b3, nq, h, V)
        t1 = now_ms()
        v3 = _cd_smt(v3, t1 - t0)
        kk = kk + 1

    # S4 dwte = gg[nq,V] x xf[nq,h] -> smm_fwd_at: transpose A, m=V n=h k=nq
    a4 = t_zeros([nq, V])
    b4 = t_zeros([nq, h])
    _cd_fill(a4, 5)
    _cd_fill(b4, 6)
    v4 = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c4 = smm_fwd_at(a4, b4, V, h, nq)
        t1 = now_ms()
        v4 = _cd_smt(v4, t1 - t0)
        kk = kk + 1

    # S5 logits = xf[nq,h] x wte[V,h] -> smm_dot = a[m,k] x b[n,k]^T
    a5 = t_zeros([nq, h])
    b5 = t_zeros([V, h])
    _cd_fill(a5, 7)
    _cd_fill(b5, 8)
    v5 = 1.0e18
    kk = 0
    while kk < rs:
        t0 = now_ms()
        c5 = smm_dot(a5, b5, nq, V, h)
        t1 = now_ms()
        v5 = _cd_smt(v5, t1 - t0)
        kk = kk + 1

    print("CD tkv S1 dx1    [1024x768x3072]  dot    = " + str(v1) + " ms  " + str(_cd_gflops(nq, h, four, v1)) + " GFLOPS")
    print("CD tkv S3 dxf    [1024x768x50257] fwd    = " + str(v3) + " ms  " + str(_cd_gflops(nq, h, V, v3)) + " GFLOPS")
    print("CD tkv S4 dwte   [50257x768x1024] fwd_at = " + str(v4) + " ms  " + str(_cd_gflops(V, h, nq, v4)) + " GFLOPS")
    print("CD tkv S5 logits [1024x50257x768] dot    = " + str(v5) + " ms  " + str(_cd_gflops(nq, V, h, v5)) + " GFLOPS")
    print("CD done")
    return 0
