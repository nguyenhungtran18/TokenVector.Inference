# PROBE BWD OUTER SPLIT - phan NGOAI 12 layer trong gpt2_backward
# Muc dich: BPHASE seq1024 cho bwd=3156 ms. 12 layer x ~149 ms = 1788.
# Con ~1368 ms chua biet o dau: lm-head (dwte 38.6M) / embed bwd / lnf.
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_bwd_outer.tkv out/bouter.exe main
#   copy -> out/bouter_n10.dll + runtimeconfig ; dotnet out/bouter_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def _mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def _mk_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

def _n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def _groups(ps: 'list[Tensor]') -> 'list[i64]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def _mk_opt(n: 'i64', groups: 'list[i64]', total: 'i64') -> "AdamW":
    return new_adamw_g(n, groups, 2, total, 0.05, 0.0025, 0.9, 0.999,
                       0.00000001, 0.0, 1.0)

def _prepare(opt: "AdamW", ps: 'list[Tensor]') -> 'i32':
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            opt.p[off + j] = d[j]
        off = off + len(d)
    return 0

def _mk_sa_bufs(seq: 'i64') -> 'list[Tensor]':
    out = []
    for i in range(NLayers):
        out.append(t_zeros([seq, 4 * HiddenSize]))
    return out

def _mk_hpool(seq: 'i64') -> 'list[Tensor]':
    out = []
    for i in range(4 * NLayers):
        out.append(t_zeros([seq, HiddenSize]))
    return out

def _mk_abuf(seq: 'i64') -> 'list[Tensor]':
    out = []
    for i in range(5):
        out.append(t_zeros([seq, HiddenSize]))
    for i in range(3):
        out.append(t_zeros([seq, 3 * HiddenSize]))
    return out

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize
    ids = _mk_ids(n)
    pos = _mk_pos(n)
    ps = gpt2_init(7)
    npar = _n_param(ps)
    groups = _groups(ps)
    opt = _mk_opt(npar, groups, 1000)
    _prepare(opt, ps)

    sc5t = t_zeros([n * V])
    sc5 = sc5t.data
    sc4t = t_zeros([V * h])
    sc4 = sc4t.data
    sab = _mk_sa_bufs(n)
    ib = t_zeros([n, 4 * h])
    db = t_zeros([n, 4 * h])
    abp = _mk_abuf(n)
    hpl = _mk_hpool(n)
    m6_plg = alloc_bytes(n * V * 4)
    m6_pids = alloc_bytes(n * 4)
    m6_pwte = alloc_bytes(V * h * 4)
    m6_pxf = alloc_bytes(n * h * 4)
    m6_pdxf = alloc_bytes(n * h * 4)
    m6_pdwe = alloc_bytes(V * h * 4)

    # gom list tham so theo layer (giong _f124_bwd)
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])

    print("=== BWD OUTER SPLIT seq=" + str(n) + " V=" + str(V) + " ===")

    # warm: 1 forward_saved + 1 backward
    svw = gpt2_forward_saved(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                             ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], 1, sc5, sab, abp, hpl)
    lw0 = gpt2_loss(svw[0], ids)
    grw = gpt2_backward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                        ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], 1, opt.g, svw, sc4,
                        m6_plg, m6_pids, m6_pwte, m6_pxf, m6_pdxf, m6_pdwe, ib, db, abp)

    # ---- A) toan bo gpt2_backward (production) ----
    best = 1.0e9
    kk = 0
    while kk < 3:
        t0 = now_ms()
        grd = gpt2_backward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                            ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], 1, opt.g, svw, sc4,
                            m6_plg, m6_pids, m6_pwte, m6_pxf, m6_pdxf, m6_pdwe, ib, db, abp)
        dt = now_ms() - t0
        if dt < best:
            best = dt
        kk = kk + 1
    print("A) gpt2_backward FULL      best-of-3 ms=" + str(best))

    # ---- B) 1 layer block_bwd (co save_*, pool) ----
    # saves layout: [0]=logits [1]=xf [2]=xf_in [3..14]=xins [15..26]=rs
    #               [27..38]=ains [39..50]=msins [51..62]=adIns
    xl = svw[3]
    gout = t_zeros([n, h])
    sav_r = svw[15]
    sav_a = svw[27]
    sav_m = svw[39]
    sav_in = svw[51]
    sav_ag = sab[0]
    bestb = 1.0e9
    kk = 0
    while kk < 4:
        t0 = now_ms()
        rb = gpt2_block_bwd(xl, ln1_g[0], ln1_b[0], wq[0], bq[0], wp[0], bp[0],
                            ln2_g[0], ln2_b[0], w1[0], b1[0], w2[0], b2[0], gout, 1, None, None,
                            sav_r, sav_a, sav_m, sav_in, sav_ag, ib, db, abp)
        dt = now_ms() - t0
        if dt < bestb:
            bestb = dt
        kk = kk + 1
    print("B) 1 block_bwd (gflat=None -> NATIVE attn) best-of-4 ms=" + str(bestb) + "  x12 = " + str(bestb * 12.0))

    # ---- C) 1 layer block_bwd tren DUONG PRODUCTION (gflat co data -> ATen attn) ----
    # Day moi la so that cua production: gpt2_backward luon truyen opt.g (co data)
    # -> gpt2_attention_bwd di torch_attention_bwd (ATen), KHONG phai native.
    gf = opt.g
    bestc = 1.0e9
    kk = 0
    while kk < 4:
        t0 = now_ms()
        rc = gpt2_block_bwd(xl, ln1_g[0], ln1_b[0], wq[0], bq[0], wp[0], bp[0],
                            ln2_g[0], ln2_b[0], w1[0], b1[0], w2[0], b2[0], gout, 1, gf, None,
                            sav_r, sav_a, sav_m, sav_in, sav_ag, ib, db, abp)
        dt = now_ms() - t0
        if dt < bestc:
            bestc = dt
        kk = kk + 1
    print("C) 1 block_bwd (gflat -> ATen attn) best-of-4 ms=" + str(bestc) + "  x12 = " + str(bestc * 12.0))
    print("   -> PHAN NGOAI 12 LAYER = " + str(best - bestc * 12.0) + " ms")
    return 0
