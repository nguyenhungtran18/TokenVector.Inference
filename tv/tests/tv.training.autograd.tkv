# TokenVector Training bundle: autograd + lora + pretrain (merged:
# record fields must reference same-file records).

import tv.runtime.session
import tv.numerics.tensor

# ===== autograd =====
import tv.numerics.tensor

class LinHead:
    _ok: 'i64'
    w: 'list[f32]'
    b: 'list[f32]'
    m: 'i64'
    n: 'i64'
    k: 'i64'
    gw: 'list[f32]'
    gb: 'list[f32]'
    _x: 'list[f32]'

    def __init__(self, w: 'list[f32]', b: 'list[f32]', m: 'i64', n: 'i64', k: 'i64'):
        self.w = w
        self.b = b
        self.m = m
        self.n = n
        self.k = k
        self.gw = _nd_f32(n * k)
        self.gb = _nd_f32(n)
        self._x = None
        self.zero_grad()

    def zero_grad(self) -> 'i32':
        for i in range(len(self.gw)):
            self.gw[i] = 0.0
        for i in range(len(self.gb)):
            self.gb[i] = 0.0
        return 0

    def forward(self, x: 'list[f32]') -> 'list[f32]':
        self._x = x
        y = _nd_f32(self.m * self.n)
        for mm in range(self.m):
            for nn in range(self.n):
                acc = self.b[nn]
                kk = 0
                while kk + 32 <= self.k:
                    for l in range(32):
                        acc = acc + x[mm * self.k + kk + l] * self.w[nn * self.k + kk + l]
                    kk = kk + 32
                while kk < self.k:
                    acc = acc + x[mm * self.k + kk] * self.w[nn * self.k + kk]
                    kk = kk + 1
                y[mm * self.n + nn] = acc
        return y

    def backward(self, dy: 'list[f32]') -> 'list[f32]':
        dx = _nd_f32(self.m * self.k)
        for i in range(len(dx)):
            dx[i] = 0.0
        for mm in range(self.m):
            for nn in range(self.n):
                g = dy[mm * self.n + nn]
                self.gb[nn] = self.gb[nn] + g
                for p in range(self.k):
                    self.gw[nn * self.k + p] = self.gw[nn * self.k + p] + g * self._x[mm * self.k + p]
                    dx[mm * self.k + p] = dx[mm * self.k + p] + g * self.w[nn * self.k + p]
        return dx

    def sgd_step(self, lr: 'f32') -> 'i32':
        for i in range(len(self.w)):
            self.w[i] = self.w[i] - lr * self.gw[i]
        for i in range(len(self.b)):
            self.b[i] = self.b[i] - lr * self.gb[i]
        return 0

def mse_forward(y: 'list[f32]', t: 'list[f32]') -> 'f32':
    s = 0.0
    for i in range(len(y)):
        d = y[i] - t[i]
        s = s + d * d
    return s / len(y)

def mse_backward(y: 'list[f32]', t: 'list[f32]', dy: 'list[f32]') -> 'i32':
    n = len(y)
    for i in range(n):
        dy[i] = 2.0 * (y[i] - t[i]) / n
    return 0

def train_step(head: 'LinHead', x: 'list[f32]', t: 'list[f32]', lr: 'f32') -> 'f32':
    y = head.forward(x)
    loss = mse_forward(y, t)
    dy = _nd_f32(len(y))
    mse_backward(y, t, dy)
    head.backward(dy)
    head.sgd_step(lr)
    head.zero_grad()
    return loss

def relu_forward(x: 'list[f32]') -> 'list[f32]':
    y = _nd_f32(len(x))
    for i in range(len(x)):
        if x[i] > 0.0:
            _c1 = x[i]
        else:
            _c1 = 0.0
        y[i] = _c1
    return y

def relu_backward(x: 'list[f32]', dy: 'list[f32]') -> 'list[f32]':
    dx = _nd_f32(len(x))
    for i in range(len(x)):
        if x[i] > 0.0:
            _c2 = dy[i]
        else:
            _c2 = 0.0
        dx[i] = _c2
    return dx

def softmax_ce_loss(logits: 'list[f32]', target: 'i64') -> 'f32':
    mx = logits[0]
    for i in range(1, len(logits)):
        if logits[i] > mx:
            mx = logits[i]
    s = 0.0
    for i in range(len(logits)):
        s = s + exp(logits[i] - mx)
    return log(s) + mx - logits[target]

def softmax_ce_grad(logits: 'list[f32]', target: 'i64') -> 'list[f32]':
    mx = logits[0]
    for i in range(1, len(logits)):
        if logits[i] > mx:
            mx = logits[i]
    s = 0.0
    for i in range(len(logits)):
        s = s + exp(logits[i] - mx)
    dy = _nd_f32(len(logits))
    for i in range(len(logits)):
        p = exp(logits[i] - mx) / s
        if i == target:
            _c3 = 1.0
        else:
            _c3 = 0.0
        dy[i] = p - _c3
    return dy

class AdamState:
    _ok: 'i64'
    m: 'list[f32]'
    v: 'list[f32]'
    t: 'i64'
    lr: 'f32'
    b1: 'f32'
    b2: 'f32'
    eps: 'f32'

    def __init__(self, size: 'i64', lr: 'f32', b1: 'f32', b2: 'f32', eps: 'f32'):
        self.m = _nd_f32(size)
        self.v = _nd_f32(size)
        for i in range(size):
            self.m[i] = 0.0
            self.v[i] = 0.0
        self.t = 0
        self.lr = lr
        self.b1 = b1
        self.b2 = b2
        self.eps = eps

    def step(self, p: 'list[f32]', g: 'list[f32]') -> 'i32':
        self.t = self.t + 1
        for i in range(len(p)):
            self.m[i] = self.b1 * self.m[i] + (1.0 - self.b1) * g[i]
            self.v[i] = self.v[i] * self.b2 + (1.0 - self.b2) * g[i] * g[i]
            mh = self.m[i] / (1.0 - _pow(self.b1, self.t))
            vh = self.v[i] / (1.0 - _pow(self.b2, self.t))
            p[i] = p[i] - self.lr * mh / (sqrt(vh) + self.eps)
        return 0

def _pow(b: 'f32', e: 'i64') -> 'f32':
    r = 1.0
    for _ in range(e):
        r = r * b
    return r

class MLPClassifier:
    _ok: 'i64'
    l1: 'LinHead'
    l2: 'LinHead'

    def __init__(self, in_dim: 'i64', hidden: 'i64', classes: 'i64', seed: 'i64'=7):
        w1 = _nd_f32(hidden * in_dim)
        b1 = _nd_f32(hidden)
        w2 = _nd_f32(classes * hidden)
        b2 = _nd_f32(classes)
        s = seed
        for i in range(len(w1)):
            s = s * 6364136223846793005 + 1442695040888963407 & 18446744073709551615
            w1[i] = (float(s % 1000) / 1000.0 - 0.5) * 2.0
        for i in range(len(w2)):
            s = s * 6364136223846793005 + 1442695040888963407 & 18446744073709551615
            w2[i] = (float(s % 1000) / 1000.0 - 0.5) * 2.0
        self.l1 = LinHead(w1, b1, 1, hidden, in_dim)
        self.l2 = LinHead(w2, b2, 1, classes, hidden)

    def zero_grad(self) -> 'i32':
        _ah205_8 = self.l1
        _ah205_8.zero_grad()
        _ah206_8 = self.l2
        _ah206_8.zero_grad()
        return 0

    def predict(self, x: 'list[f32]') -> 'i64':
        _ah210_25 = self.l1
        h = relu_forward(_ah210_25.forward(x))
        _ah211_12 = self.l2
        y = _ah211_12.forward(h)
        best = 0
        for i in range(1, len(y)):
            if y[i] > y[best]:
                best = i
        return best

    def train_row(self, x: 'list[f32]', target: 'i64') -> 'f32':
        _ah219_25 = self.l1
        h = relu_forward(_ah219_25.forward(x))
        _ah220_12 = self.l2
        y = _ah220_12.forward(h)
        loss = softmax_ce_loss(y, target)
        dy = softmax_ce_grad(y, target)
        _ah223_13 = self.l2
        dh = _ah223_13.backward(dy)
        _ah224_8 = self.l1
        _ah224_8.backward(relu_backward(h, dh))
        return loss


def lin_head(w: 'list[f32]', b: 'list[f32]', m: 'i64', n: 'i64', k: 'i64') -> 'LinHead':
    o = LinHead(1, m, n, k)
    o.w = w
    o.b = b
    o.gw = _nd_f32(n * k)
    o.gb = _nd_f32(n)
    o._x = []
    return o

def adam_state(size: 'i64', lr: 'f32') -> 'AdamState':
    o = AdamState(1, 0, lr, 0.9, 0.999, 0.00001)
    o.m = _nd_f32(size)
    o.v = _nd_f32(size)
    for i in range(size):
        o.m[i] = 0.0
        o.v[i] = 0.0
    return o

# ===== lora (merged) =====
# TokenVector Module: Training — LoRA adapters + checkpoint activation arena
# TRIZ group 1 (pretrain/fine-tune): shrink trainable state (LoRA rank-r) and
# resolve the arena-vs-backward contradiction with a second allocation policy
# (Checkpoints pin buffers until backward finishes; scratchpad still recycles).
# Full-model pretraining remains out of scope (needs GPU — see runtime.hal).



# LoRA: y = x @ W^T + b + (alpha/r) * (x @ A^T) @ D^T
# W,b frozen; A [r,k], D [n,r] trainable. K-blocked base path reuses LinHead.

class LoRALinear:
    _ok: "i64"
    base: 'LinHead'
    m: 'i64'
    n: 'i64'
    k: 'i64'
    rank: 'i64'
    scale: 'f32'
    a: 'list[f32]'
    d: 'list[f32]'
    ga: 'list[f32]'
    gd: 'list[f32]'
    _x: 'list[f32]'
    _h: 'list[f32]'
    def __init__(self, w: "list[f32]", b: "list[f32]", m: "i64", n: "i64", k: "i64", rank: "i64", alpha: "f32" = 1.0, seed: "i64" = 13):
        if rank <= 0 or rank > min(n, k):
            raise Arg("rank must be in [1, min(n,k)]")
        self.base = lin_head(w, b, m, n, k)
        self.m = m
        self.n = n
        self.k = k
        self.rank = rank
        self.scale = alpha / float(rank)
        self.a = _nd_f32(rank * k)
        self.d = _nd_f32(n * rank)
        s = seed
        inv = 1.0 / sqrt(float(k))
        for i in range(len(self.a)):
            s = (s * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
            self.a[i] = (float(s % 2000) / 1000.0 - 1.0) * inv
        for i in range(len(self.d)):
            self.d[i] = 0.0
        self.ga = _nd_f32(rank * k)
        self.gd = _nd_f32(n * rank)
        self._x = None
        self._h = None
        self.zero_grad()

    def zero_grad(self) -> 'i32':
        for i in range(len(self.ga)):
            self.ga[i] = 0.0
        for i in range(len(self.gd)):
            self.gd[i] = 0.0
        _ah333_8 = self.base
        _ah333_8.zero_grad()
        return 0

    # adapter path only: h = x @ A^T [m,r] ; y = base(x) + scale * h @ D^T
    def forward(self, x: "list[f32]") -> "list[f32]":
        self._x = x
        _ah339_12 = self.base
        y = _ah339_12.forward(x)
        h = _nd_f32(self.m * self.rank)
        for mm in range(self.m):
            for r in range(self.rank):
                acc = 0.0
                kk = 0
                while kk + 32 <= self.k:
                    for l in range(32):
                        acc = acc + x[mm * self.k + kk + l] * self.a[r * self.k + kk + l]
                    kk = kk + 32
                while kk < self.k:
                    acc = acc + x[mm * self.k + kk] * self.a[r * self.k + kk]
                    kk = kk + 1
                h[mm * self.rank + r] = acc
        self._h = h
        for mm in range(self.m):
            for nn in range(self.n):
                acc = 0.0
                for r in range(self.rank):
                    acc = acc + h[mm * self.rank + r] * self.d[nn * self.rank + r]
                y[mm * self.n + nn] = y[mm * self.n + nn] + self.scale * acc
        return y

    # dy [m,n] -> accumulate ga, gd only (base frozen); returns dx [m,k]
    def backward(self, dy: "list[f32]") -> "list[f32]":
        _ah364_13 = self.base
        dx = _ah364_13.backward(dy)
        for mm in range(self.m):
            for nn in range(self.n):
                g = dy[mm * self.n + nn] * self.scale
                for r in range(self.rank):
                    self.gd[nn * self.rank + r] = self.gd[nn * self.rank + r] + g * self._h[mm * self.rank + r]
                    gh = g * self.d[nn * self.rank + r]
                    for p in range(self.k):
                        self.ga[r * self.k + p] = self.ga[r * self.k + p] + gh * self._x[mm * self.k + p]
                        dx[mm * self.k + p] = dx[mm * self.k + p] + gh * self.a[r * self.k + p]
        return dx

    def adapter_step(self, lr: "f32") -> 'i32':
        for i in range(len(self.a)):
            self.a[i] = self.a[i] - lr * self.ga[i]
        for i in range(len(self.d)):
            self.d[i] = self.d[i] - lr * self.gd[i]
        return 0

    # merged W' = W + scale * D @ A  (still [n,k]) — export/inference path
    def merged_weight(self) -> "list[f32]":
        out = _nd_f32(self.n * self.k)
        bs = self.base
        bw = bs.w
        for i in range(len(bw)):
            out[i] = bw[i]
        for nn in range(self.n):
            for kk in range(self.k):
                acc = 0.0
                for r in range(self.rank):
                    acc = acc + self.d[nn * self.rank + r] * self.a[r * self.k + kk]
                out[nn * self.k + kk] = out[nn * self.k + kk] + self.scale * acc
        return out

def lora_linear_create(w: "list[f32]", b: "list[f32]", m: "i64", n: "i64", k: "i64", rank: "i64", alpha: "f32") -> "LoRALinear":
    # KHOI TAO DAY DAY, KHONG dua vao __init__ (2026-09-26).
    #
    # Compiler KHONG phat ra than `__init__` cua record class: constructor
    # duoc sinh tu DANH SACH FIELD, chi nhan 7 tham so
    # (_ok, base, m, n, k, rank, scale). `LoRALinear.__init__` co 8 tham so
    # (w, b, m, n, k, rank, alpha, seed) nen:
    #   - Loi truyen 8 tham so: "record 'LoRALinear' can 7 tham so".
    #   - Loi truyen 7 tham so: `a`, `d`, `ga`, `gd`, `_x`, `_h` KHONG BAO
    #     GIO duoc khoi tao (chi la List rong) -> forward() doc
    #     self.a[r * self.k + kk] vuot do dai ->
    #     ArgumentOutOfRangeException ("Index was out of range").
    #
    # Vi vay phai khoi tao day cac field adapter, dung LCG 31-bit (an toan
    # trong int64 - xem ghi chu o vit.tkv::_vit_rnd) va zero_grad().
    if rank <= 0 or rank > min(n, k):
        raise Arg("rank must be in [1, min(n,k)]")
    l = LoRALinear(1, lin_head(w, b, m, n, k), m, n, k, rank, alpha)
    l.a = _nd_f32(rank * k)
    l.d = _nd_f32(n * rank)
    l.ga = _nd_f32(rank * k)
    l.gd = _nd_f32(n * rank)
    l._x = None
    l._h = None
    s = 13
    inv = 1.0 / pow(float(k), 0.5)
    for i in range(len(l.a)):
        s = (s * 1103515245 + 12345) % 2147483648
        l.a[i] = (float(s % 2000) / 1000.0 - 1.0) * inv
    for i in range(len(l.d)):
        l.d[i] = 0.0
    l.base.zero_grad()
    return l

def lora_train_row(l: "LoRALinear", x: "list[f32]", t: "list[f32]", lr: "f32") -> "f32":
    y = l.forward(x)
    loss = mse_forward(y, t)
    dy = _nd_f32(len(y))
    mse_backward(y, t, dy)
    l.backward(dy)
    l.adapter_step(lr)
    l.zero_grad()
    return loss

# Second allocation policy: named activation checkpoints pinned until release().
# Contrasts with ExecutionMemoryArena scratch reuse — training marks buffers
# that backward still needs so liveness does not recycle them early.
class CheckpointArena:
    _ok: "i64"
    capacity: 'i64'
    hits: 'i64'
    misses: 'i64'
    _buf: 'dict[str,list[f32]]'
    _pinned: 'dict[str,i32]'
    _order: 'list[str]'
    def __init__(self, capacity: "i64" = 64):
        self.capacity = capacity
        self._buf = {}
        self._pinned = {}
        self._order = []
        self.hits = 0
        self.misses = 0

    def save(self, name: "str", src: "list[f32]", pin: "i32" = 1) -> 'i32':
        if name not in self._buf:
            if len(self._order) >= self.capacity:
                raise Arg("checkpoint arena full — release() before save")
            _ah431_12 = self._order
            _ah431_12.append(name)
            self._buf[name] = _nd_f32(len(src))
        dst = self._buf[name]
        for i in range(len(src)):
            dst[i] = src[i]
        self._pinned[name] = pin
        return 0

    def get(self, name: "str") -> "list[f32]":
        if name not in self._buf:
            self.misses = self.misses + 1
            raise NotFound("checkpoint '" + str(name) + "' not found")
        self.hits = self.hits + 1
        return self._buf[name]

    def has(self, name: "str") -> "i32":
        return name in self._buf

    def release(self, name: "str") -> 'i32':
        if name in self._pinned:
            self._pinned[name] = 0
        return 0

    # drop unpinned entries (scratch may recycle); pinned survive for backward
    def reclaim(self) -> 'i32':
        keep = []
        for nm in self._order:
            if nm in self._pinned:
                if self._pinned[nm]:
                    keep.append(nm)
                    continue
            if nm in self._buf:
                self._buf.pop(nm)
            if nm in self._pinned:
                self._pinned.pop(nm)
        self._order = keep
        return 0

    def pinned_count(self) -> "i64":
        c = 0
        _keys = self._pinned.keys()
        for nm in _keys:
            if self._pinned[nm]:
                c = c + 1
        return c

    def release_all(self) -> 'i32':
        _keys = self._pinned.keys()
        for nm in _keys:
            self._pinned[nm] = 0
        return 0





# ===== pretrain (merged) =====

class PretrainArg(Exception):
    msg: 'str'

def gelu_forward(x: 'list[f32]') -> 'list[f32]':
    y = []
    _zf81 = 0
    while _zf81 < len(x):
        y.append(0.0)
        _zf81 = _zf81 + 1
    for i in range(len(x)):
        v = x[i]
        y[i] = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v)))
    return y

def gelu_backward(x: 'list[f32]', dy: 'list[f32]') -> 'list[f32]':
    dx = []
    _zf82 = 0
    while _zf82 < len(x):
        dx.append(0.0)
        _zf82 = _zf82 + 1
    for i in range(len(x)):
        v = x[i]
        u = 0.044715 * v * v * v
        t = tanh(0.7978845608 * (v + u))
        dt = (1.0 - t * t) * 0.7978845608 * (1.0 + 3.0 * 0.044715 * v * v)
        dx[i] = dy[i] * (0.5 * (1.0 + t) + 0.5 * v * dt)
    return dx

def silu_forward(x: 'list[f32]') -> 'list[f32]':
    y = []
    _zf83 = 0
    while _zf83 < len(x):
        y.append(0.0)
        _zf83 = _zf83 + 1
    for i in range(len(x)):
        v = x[i]
        y[i] = v / (1.0 + exp(-v))
    return y

def silu_backward(x: 'list[f32]', dy: 'list[f32]') -> 'list[f32]':
    dx = []
    _zf84 = 0
    while _zf84 < len(x):
        dx.append(0.0)
        _zf84 = _zf84 + 1
    for i in range(len(x)):
        v = x[i]
        s = 1.0 / (1.0 + exp(-v))
        dx[i] = dy[i] * (s + v * s * (1.0 - s))
    return dx

class LayerNorm:
    dim: 'i64'
    eps: 'f32'
    g: 'list[f32]'
    b: 'list[f32]'
    gg: 'list[f32]'
    gb: 'list[f32]'
    _adam_g: 'str'
    _adam_b: 'str'
    _opt_g: 'AdamState'
    _opt_b: 'AdamState'
    _x: 'list[f32]'
    _xhat: 'list[f32]'
    _inv: 'list[f32]'

    def __init__(self, dim: 'i64', eps: 'f32'):
        self.dim = dim
        self.eps = eps
        self.g = []
        _zf85 = 0
        while _zf85 < dim:
            _ah556_12 = self.g
            _ah556_12.append(0.0)
            _zf85 = _zf85 + 1
        self.b = []
        _zf86 = 0
        while _zf86 < dim:
            _ah561_12 = self.b
            _ah561_12.append(0.0)
            _zf86 = _zf86 + 1
        for i in range(dim):
            self.g[i] = 1.0
            self.b[i] = 0.0
        self.gg = []
        _zf87 = 0
        while _zf87 < dim:
            _ah569_12 = self.gg
            _ah569_12.append(0.0)
            _zf87 = _zf87 + 1
        self.gb = []
        _zf88 = 0
        while _zf88 < dim:
            _ah574_12 = self.gb
            _ah574_12.append(0.0)
            _zf88 = _zf88 + 1
        self._adam_g = ""
        self._adam_b = ""
        self._x = ""
        self._xhat = ""
        self._inv = ""
        self.zero_grad()

    def zero_grad(self) -> 'i32':
        for i in range(len(self.gg)):
            self.gg[i] = 0.0
            self.gb[i] = 0.0
        return 0

    def forward(self, x: 'list[f32]') -> 'list[f32]':
        rows = len(x) // self.dim
        self._x = x
        n = rows * self.dim
        self._xhat = []
        _zf89 = 0
        while _zf89 < n:
            _ah596_12 = self._xhat
            _ah596_12.append(0.0)
            _zf89 = _zf89 + 1
        self._inv = []
        _zf90 = 0
        while _zf90 < rows:
            _ah601_12 = self._inv
            _ah601_12.append(0.0)
            _zf90 = _zf90 + 1
        y = []
        _zf91 = 0
        while _zf91 < n:
            y.append(0.0)
            _zf91 = _zf91 + 1
        for r in range(rows):
            base = r * self.dim
            mean = 0.0
            for j in range(self.dim):
                mean = mean + x[base + j]
            mean = mean / self.dim
            var = 0.0
            for j in range(self.dim):
                d = x[base + j] - mean
                var = var + d * d
            var = var / self.dim
            inv = 1.0 / sqrt(var + self.eps)
            self._inv[r] = inv
            for j in range(self.dim):
                xh = (x[base + j] - mean) * inv
                self._xhat[base + j] = xh
                y[base + j] = self.g[j] * xh + self.b[j]
        return y

    def backward(self, dy: 'list[f32]') -> 'list[f32]':
        rows = len(dy) // self.dim
        n = rows * self.dim
        dx = []
        _zf92 = 0
        while _zf92 < n:
            dx.append(0.0)
            _zf92 = _zf92 + 1
        for r in range(rows):
            base = r * self.dim
            inv = self._inv[r]
            for j in range(self.dim):
                self.gg[j] = self.gg[j] + dy[base + j] * self._xhat[base + j]
                self.gb[j] = self.gb[j] + dy[base + j]
            s1 = 0.0
            s2 = 0.0
            for j in range(self.dim):
                gx = dy[base + j] * self.g[j]
                s1 = s1 + gx
                s2 = s2 + gx * self._xhat[base + j]
            cnt = self.dim
            for j in range(self.dim):
                gx = dy[base + j] * self.g[j]
                dx[base + j] = inv * (gx - s1 / cnt - self._xhat[base + j] * s2 / cnt)
        return dx

    def sgd_step(self, lr: 'f32') -> 'i32':
        for i in range(len(self.g)):
            self.g[i] = self.g[i] - lr * self.gg[i]
            self.b[i] = self.b[i] - lr * self.gb[i]
        return 0

    def ensure_adam(self, lr: 'f32'=0.001) -> 'i32':
        if self._adam_g == "":
            self._opt_g = adam_state(self.dim, lr)
            self._opt_b = adam_state(self.dim, lr)
            self._adam_g = "adam"
            self._adam_b = "adam"
        return 0

    def adam_step(self, lr: 'f32'=0.001) -> 'i32':
        self.ensure_adam(lr)
        _ah669_8 = self._opt_g
        _ah669_8.step(self.g, self.gg)
        _ah670_8 = self._opt_b
        _ah670_8.step(self.b, self.gb)
        return 0

def add_inplace(a: 'list[f32]', b: 'list[f32]') -> 'i32':
    for i in range(len(a)):
        a[i] = a[i] + b[i]
    return 0

class PretrainMLP:
    in_dim: 'i64'
    hidden: 'i64'
    depth: 'i64'
    classes: 'i64'
    lns: 'list[LayerNorm]'
    blocks: 'list[i64]'
    head_ln: 'LayerNorm'
    head: 'i64'
    ckpt: 'i64'
    _acts: 'list[i64]'
    _x: 'str'
    _blk_adam_g: 'list[i64]'
    _blk_adam_b: 'list[i64]'
    _head_adam_g: 'str'
    _head_adam_b: 'str'

    def __init__(self, in_dim: 'i64', hidden: 'i64', depth: 'i64', classes: 'i64', seed: 'i64'=11):
        if depth < 1:
            raise PretrainArg("depth must be >= 1")
        self.in_dim = in_dim
        self.hidden = hidden
        self.depth = depth
        self.classes = classes
        self.lns = []
        self.blocks = []
        self._blk_adam_g = []
        self._blk_adam_b = []
        self._acts = []
        self._x = ""
        self._head_adam_g = ""
        self._head_adam_b = ""
        for layer in range(depth):
            if layer == 0:
                _c1 = in_dim
            else:
                _c1 = hidden
            d_in = _c1
            ln = LayerNorm(d_in)
            _ah717_12 = self.lns
            _ah717_12.append(ln)
        self.head_ln = LayerNorm(hidden)
        self.head = classes
        self.ckpt = 0

    def zero_grad(self) -> 'i32':
        for ln in self.lns:
            ln.zero_grad()
        _ah725_8 = self.head_ln
        _ah725_8.zero_grad()
        return 0

    def forward(self, x: 'list[f32]') -> 'list[f32]':
        h = x[:]
        for li in range(self.depth):
            ln = self.lns[li]
            h = ln.forward(h)
            i = 0
            n = len(h)
            while i < n:
                v = h[i]
                h[i] = 0.5 * v * (1.0 + tanh(0.7978845608 * (v + 0.044715 * v * v * v)))
                i = i + 1
        _ah739_12 = self.head_ln
        h = _ah739_12.forward(h)
        out = []
        _zf93 = 0
        while _zf93 < self.classes:
            out.append(0.0)
            _zf93 = _zf93 + 1
        return out

    def backward(self, dy: 'list[f32]') -> 'list[f32]':
        dx = dy
        _ah749_8 = self.head_ln
        _ah749_8.backward(dx)
        li = self.depth - 1
        while li > -1:
            lnb = self.lns[li]
            lnb.backward(dx)
            li = li + -1
        return dx

    def sgd_step(self, lr: 'f32') -> 'i32':
        for ln in self.lns:
            ln.sgd_step(lr)
        _ah760_8 = self.head_ln
        _ah760_8.sgd_step(lr)
        return 0

    def ensure_adam(self, lr: 'f32'=0.001) -> 'i32':
        for ln in self.lns:
            ln.ensure_adam(lr)
        _ah766_8 = self.head_ln
        _ah766_8.ensure_adam(lr)
        return 0

    def adam_step(self, lr: 'f32'=0.001) -> 'i32':
        for ln in self.lns:
            ln.adam_step(lr)
        _ah772_8 = self.head_ln
        _ah772_8.adam_step(lr)
        return 0

def save_checkpoint(path: 'str', tensors: 'dict[str,list[f32]]', meta: 'str') -> 'i32':
    payload = tv_encode_ckpt(tensors, meta)
    file_write_bytes(path, payload)
    return 0

def load_checkpoint(path: 'str') -> 'dict[str,list[f32]]':
    raw = ckpt_file_read_all_bytes(path)
    return tv_decode_ckpt(raw)

def _w_u32(buf: 'list[i64]', v: 'i64') -> 'i32':
    buf.append(v & 255)
    buf.append(v >> 8 & 255)
    buf.append(v >> 16 & 255)
    buf.append(v >> 24 & 255)
    return 0

def _w_f32(buf: 'list[i64]', x: 'f32') -> 'i32':
    bits = ckpt_float_to_bits(x)
    buf.append(bits & 255)
    buf.append(bits >> 8 & 255)
    buf.append(bits >> 16 & 255)
    buf.append(bits >> 24 & 255)
    return 0

def tv_encode_ckpt(tensors: 'dict[str,list[f32]]', meta: 'str') -> 'str':
    buf = []
    buf.append(84)
    buf.append(86)
    buf.append(67)
    buf.append(75)
    _w_u32(buf, len(tensors))
    mb = ckpt_utf8_encode(meta)
    _w_u32(buf, len(mb))
    for b in mb:
        buf.append(b)
    for nm in tensors:
        arr = tensors[nm]
        nb = ckpt_utf8_encode(nm)
        _w_u32(buf, len(nb))
        for b in nb:
            buf.append(b)
        _w_u32(buf, len(arr))
        for i in range(len(arr)):
            _w_f32(buf, arr[i])
    return ckpt_bytes_from_list(buf)

def tv_decode_ckpt(raw: 'str') -> 'dict[str,list[f32]]':
    if len(raw) < 12:
        raise PretrainArg("checkpoint truncated")
    if ord(raw[0]) != 84 or ord(raw[1]) != 86 or ord(raw[2]) != 67 or (ord(raw[3]) != 75):
        raise PretrainArg("bad checkpoint magic")
    pos = 4
    count = ckpt_native_read_u32(raw, pos)
    pos = pos + 4
    meta_len = ckpt_native_read_u32(raw, pos)
    pos = pos + 4
    pos = pos + meta_len
    out = {}
    for _ in range(count):
        nlen = ckpt_native_read_u32(raw, pos)
        pos = pos + 4
        nm = ckpt_st_bytes_to_str(raw, pos, nlen)
        pos = pos + nlen
        n = ckpt_native_read_u32(raw, pos)
        pos = pos + 4
        arr = []
        _zf94 = 0
        while _zf94 < n:
            arr.append(0.0)
            _zf94 = _zf94 + 1
        for k in range(n):
            arr[k] = ckpt_native_read_f32(raw, pos)
            pos = pos + 4
        out[nm] = arr
    return out

def pretrain_loop(model: 'PretrainMLP', xs: 'list[list[f32]]', ys: 'list[list[f32]]', epochs: 'i64', lr: 'f32', ckpt_path: 'str', ckpt_every: 'i64') -> 'list[f32]':
    losses = []
    for ep in range(epochs):
        s = 0.0
        for i in range(len(xs)):
            y = model.forward(xs[i])
            loss = 0.0
            for j in range(len(y)):
                d = y[j] - ys[i][j]
                loss = loss + d * d
            s = s + loss
            dy = []
            _zf95 = 0
            while _zf95 < len(y):
                dy.append(0.0)
                _zf95 = _zf95 + 1
            for j in range(len(y)):
                dy[j] = 2.0 * (y[j] - ys[i][j]) / len(y)
            model.backward(dy)
            model.adam_step(lr)
            model.zero_grad()
        losses.append(s / float(len(xs)))
        if ckpt_path != "" and ckpt_every > 0 and ((ep + 1) % ckpt_every == 0):
            td = {}
            save_checkpoint(ckpt_path + ".ep" + str(ep + 1), td, "epoch" + str(ep + 1))
    return losses

def clip_grads(arrays: 'list[list[f32]]', max_norm: 'f32') -> 'f32':
    total = 0.0
    for a in arrays:
        for i in range(len(a)):
            total = total + a[i] * a[i]
    nrm = sqrt(total)
    if nrm <= max_norm or nrm == 0.0:
        return nrm
    scale = max_norm / nrm
    for a in arrays:
        for i in range(len(a)):
            a[i] = a[i] * scale
    return nrm

def file_write_bytes(path: 'str', data: 'str') -> 'i32':
    return 0

def ckpt_file_read_all_bytes(path: 'str') -> 'str':
    return ""

def ckpt_bytes_from_list(xs: 'list[i64]') -> 'str':
    return ""

def ckpt_utf8_encode(s: 'str') -> 'list[i64]':
    return []

def ckpt_st_bytes_to_str(raw: 'str', pos: 'i64', ln: 'i64') -> 'str':
    return ""

def ckpt_float_to_bits(x: 'f32') -> 'i64':
    return 0

def ckpt_native_read_u32(raw: 'str', pos: 'i64') -> 'i64':
    return 0

def ckpt_native_read_f32(raw: 'str', pos: 'i64') -> 'f32':
    return 0.0


def layernorm_create(dim: 'i64', eps: 'f32') -> 'LayerNorm':
    o = LayerNorm(dim, eps, "", "", adam_state(dim, 0.001), adam_state(dim, 0.001))
    o.g = []
    o.b = []
    o.gg = []
    o.gb = []
    i = 0
    while i < dim:
        _ah925_8 = o.g
        _ah925_8.append(1.0)
        _ah926_8 = o.b
        _ah926_8.append(0.0)
        _ah927_8 = o.gg
        _ah927_8.append(0.0)
        _ah928_8 = o.gb
        _ah928_8.append(0.0)
        i = i + 1
    o._x = []
    o._xhat = []
    o._inv = []
    o._adam_g = ""
    o._adam_b = ""
    return o

def pretrain_mlp_create(in_dim: 'i64', hidden: 'i64', depth: 'i64', classes: 'i64', seed: 'i64') -> 'PretrainMLP':
    o = PretrainMLP(in_dim, hidden, depth, classes, layernorm_create(hidden, 0.00001), classes, 0, "", "", "")
    o.lns = []
    o.blocks = []
    o._blk_adam_g = []
    o._blk_adam_b = []
    o._acts = []
    layer = 0
    while layer < depth:
        if layer == 0:
            d_in = in_dim
        else:
            d_in = hidden
        _ah950_8 = o.lns
        _ah950_8.append(layernorm_create(d_in, 0.00001))
        layer = layer + 1
    o._x = ""
    o._head_adam_g = ""
    o._head_adam_b = ""
    return o
