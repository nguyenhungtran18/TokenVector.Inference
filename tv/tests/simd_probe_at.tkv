# PROBE AT (v3) — do granularity that cua now_us/now_ms (vong JIT dai ~0.5-2s)
def main() -> 'i32':
    u0 = now_us()
    m0 = now_ms()
    s = 0.0
    i = 0
    while i < 50000000:
        s = s + 1.5
        i = i + 1
    m1 = now_ms()
    u1 = now_us()
    print("AT busy50m us_delta=" + str(u1 - u0) + " ms_delta=" + str(m1 - m0)
          + " s=" + str(s))
    # nhieu lan doc lien tiep (xem nhay bao nhieu us)
    a = now_us()
    b = now_us()
    c = now_us()
    d = now_us()
    e = now_us()
    print("AT ticks " + str(b - a) + " " + str(c - b) + " " + str(d - c) + " " + str(e - d))
    return 0
