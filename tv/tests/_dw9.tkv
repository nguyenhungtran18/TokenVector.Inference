# PROBE DW9 — BIT-CHECK linear_dw_at_fused (YEU CAU #15)
#
#  Mode 0: tai hien smm_fwd_at (_p58_core_simple) + vong copy gflat
#  Mode 1: tai hien smm_transpose + smm_fwd + vong copy gflat
#  Yeu cau: rc == 0 va bit_bad == 0 (gflat pre-fill gia tri phu — khong de 0).
#
#  Chay:
#    D:\TokenVector\Release\dist\tkvc-tv.exe tv/tests/_dw9.tkv out/dw9.exe main
#    copy out/dw9.exe -> out/dw9_n10.dll + runtimeconfig
#    dotnet out/dw9_n10.dll
import tv.training.tensor
import tv.training.simd_matmul


def _seed(xs: 'list[f32]', n: 'i64', s: 'i64') -> 'i64':
    st = s
    i = 0
    while i < n:
        st = (st * 1103515245 + 12345) % 2147483648
        v = float((st / 256) % 65536) / 65536.0
        xs[i] = v * 2.0 - 1.0
        i = i + 1
    return st


def _fill(xs: 'list[f32]', n: 'i64', s: 'i64') -> 'i64':
    # gia tri tuy y nhung KHAC 0 (tranh 0+0 mask loi) — float khac nhau
    return _seed(xs, n, s)


def _gflat(hw: 'i64') -> 'Tensor':
    g = t_zeros([hw])
    _s = _seed(g.data, hw, 987654)
    return g


# ---------- mode 0 vs smm_fwd_at + copy ----------
def _t0(n: 'i64', in_d: 'i64', out_d: 'i64', off: 'i64', tag: 'str') -> 'i64':
    x = t_zeros([n, in_d])
    gy = t_zeros([n, out_d])
    _s = _seed(x.data, n * in_d, 111 + n)
    _s = _seed(gy.data, n * out_d, 222 + out_d)
    hw = off + in_d * out_d + off
    g1 = _gflat(hw)
    g2 = t_zeros([hw])
    i = 0
    while i < hw:
        g2.data[i] = g1.data[i]
        i = i + 1

    dw = smm_fwd_at(x, gy, in_d, out_d, n)
    for k in range(in_d * out_d):
        g1.data[off + k] = g1.data[off + k] + dw.data[k]

    xl = x.data
    gl2 = gy.data
    glf = g2.data
    rc = linear_dw_at_fused(xl, gl2, glf, off, n, in_d, out_d, 0)
    if rc != 0:
        print("DW9 " + tag + " rc=" + str(rc))
        return 0
    bad = 0
    first = -1
    k = 0
    while k < in_d * out_d:
        if g1.data[off + k] != g2.data[off + k]:
            bad = bad + 1
            if first < 0:
                first = k
        k = k + 1
    print("DW9 " + tag + " n=" + str(n) + " in=" + str(in_d) + " out=" + str(out_d) + " rc=" + str(rc) + " bit_bad=" + str(bad) + " first=" + str(first))
    return bad


# ---------- mode 1 vs transpose + packed fwd + copy ----------
def _t1(n: 'i64', h: 'i64', off: 'i64', tag: 'str') -> 'i64':
    x = t_zeros([n, h])
    gy = t_zeros([n, h])
    _s = _seed(x.data, n * h, 333 + n)
    _s = _seed(gy.data, n * h, 444 + h)
    hw = off + h * h + off
    g1 = _gflat(hw)
    g2 = t_zeros([hw])
    i = 0
    while i < hw:
        g2.data[i] = g1.data[i]
        i = i + 1

    ctxTt = smm_transpose(x, n, h)
    dwG = smm_fwd(ctxTt, gy, h, h, n)
    for r in range(h):
        for o in range(h):
            g1.data[off + r * h + o] = g1.data[off + r * h + o] + dwG.data[r * h + o]

    xl = x.data
    gl2 = gy.data
    glf = g2.data
    rc = linear_dw_at_fused(xl, gl2, glf, off, n, h, h, 1)
    if rc != 0:
        print("DW9 " + tag + " rc=" + str(rc))
        return 0
    bad = 0
    first = -1
    r = 0
    while r < h * h:
        if g1.data[off + r] != g2.data[off + r]:
            bad = bad + 1
            if first < 0:
                first = r
        r = r + 1
    print("DW9 " + tag + " n=" + str(n) + " h=" + str(h) + " off=" + str(off) + " rc=" + str(rc) + " bit_bad=" + str(bad) + " first=" + str(first))
    return bad


def main() -> 'i32':
    print("DW9 — bit-check linear_dw_at_fused (mode 0 P58 / mode 1 packed)")
    bad = 0
    # mode 0: production shapes + edge/tail
    bad = bad + _t0(8, 768, 768, 0, "m8-proj")
    bad = bad + _t0(256, 768, 768, 5, "m256-proj-off5")
    bad = bad + _t0(1024, 768, 2304, 100, "m1024-qkv-off100")
    bad = bad + _t0(1, 1, 1, 0, "min")
    bad = bad + _t0(100, 320, 132, 7, "le-320-132-off7")
    bad = bad + _t0(300, 768, 512, 13, "m300-out512-off13")
    bad = bad + _t0(1024, 3072, 768, 17, "m1024-w2-off17")
    bad = bad + _t0(64, 768, 3072, 0, "m64-w1")
    # mode 1: proj-like
    bad = bad + _t1(8, 768, 0, "p8")
    bad = bad + _t1(1024, 768, 100, "p1024-off100")
    bad = bad + _t1(100, 100, 7, "p100-off7")
    print("DW9 TOTAL bit_bad=" + str(bad) + " (0 = BIT-EXACT)")
    return 0
