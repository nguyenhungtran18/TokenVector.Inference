# PROBE _AMN — phan rach block_bwd 124M theo VUNG tai seq TUY Y (256/1024)
# -------------------------------------------------------------------------
# Ban mo rong cua `simd_probe_am.tkv` (chi seq8, doc fixture). File nay tao ids
# theo cung cong thuc `_mk_ids` cua `simd_bench_124m_seq.tkv` de so duoc voi
# mode 0 (`BSEQ fwd=/bwd=`) tai cung seq.
#   dong 1 = seq, batch goi block_bwd = dong 2 (mac dinh 2 — moi lan goi dat)
# Chay: tkvc tv/tests/_amN.tkv out/amN.exe main; ./out/amN.exe
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

CFG = "tv/tests/_seq_cfg.txt"

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_ints(path: 'str') -> 'list[i64]':
    txt = read_file(path)
    lines = txt.split("\n")
    out = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                out.append(int(float(toks[j])))
    return out

def _mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def _mk_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def main() -> 'i32':
    cfg = load_ints(CFG)
    n = cfg[0]
    nb = 2
    if len(cfg) > 1:
        nb = cfg[1]
    if nb < 1:
        nb = 1
    ids = _mk_ids(n)
    pos = _mk_pos(n)
    ps = gpt2_init(7)
    h = HiddenSize
    print("AMN n=" + str(n) + " h=" + str(h) + " NLayers=" + str(NLayers) + " nb=" + str(nb))

    # forward giu xins (giong backward that)
    x = gpt2_embed(ids, pos, ps[0], ps[1])
    xins = []
    for i in range(NLayers):
        xins.append(x)
        b = 4 + i * 12
        x = gpt2_block(x, ps[b + 0], ps[b + 1], ps[b + 2], ps[b + 3],
                       ps[b + 4], ps[b + 5], ps[b + 6], ps[b + 7],
                       ps[b + 8], ps[b + 9], ps[b + 10], ps[b + 11], 1)
    print("AMN fwd-setup done")

    li = 6
    base = 4 + li * 12
    xi = xins[li]
    gy = t_zeros([n, h])
    for i in range(n * h):
        gy.data[i] = 0.1
    a = gpt2_layernorm(xi, ps[base + 0], ps[base + 1])

    b_ln = 1.0e9
    b_att = 1.0e9
    b_mlp = 1.0e9
    b_blk = 1.0e9
    k = 0
    while k < 3:
        t0 = now_ms()
        rl1 = gpt2_layernorm_bwd(xi, ps[base + 0], ps[base + 1], gy)
        rl2 = gpt2_layernorm_bwd(xi, ps[base + 6], ps[base + 7], gy)
        t1 = now_ms()
        rb = gpt2_attention_bwd(a, ps[base + 2], ps[base + 3],
                                ps[base + 4], ps[base + 5], n, gy, 1)
        t2 = now_ms()
        rm = gpt2_mlp_bwd(a, ps[base + 8], ps[base + 9],
                          ps[base + 10], ps[base + 11], n, gy, 1)
        t3 = now_ms()
        qi = 0
        while qi < nb:
            blk = gpt2_block_bwd(xi, ps[base + 0], ps[base + 1], ps[base + 2],
                                 ps[base + 3], ps[base + 4], ps[base + 5],
                                 ps[base + 6], ps[base + 7], ps[base + 8],
                                 ps[base + 9], ps[base + 10], ps[base + 11],
                                 gy, 1)
            qi = qi + 1
        t4 = now_ms()
        b_ln = _mn(b_ln, t1 - t0)
        b_att = _mn(b_att, t2 - t1)
        b_mlp = _mn(b_mlp, t3 - t2)
        b_blk = _mn(b_blk, (t4 - t3) / nb)
        k = k + 1

    print("AMN LN_BWD_x2      = " + str(b_ln) + " ms")
    print("AMN ATTENTION_BWD  = " + str(b_att) + " ms")
    print("AMN MLP_BWD        = " + str(b_mlp) + " ms")
    print("AMN SUM_cac_vung   = " + str(b_ln + b_att + b_mlp) + " ms")
    print("AMN BLOCK_BWD      = " + str(b_blk) + " ms (batch " + str(nb) + ")")
    print("AMN BUCKET 12x     = " + str(b_blk * 12.0) + " ms")
    print("AMN done")
    return 0
