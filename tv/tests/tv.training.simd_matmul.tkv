# SIMD MATMUL — dua SIMD vao duong train (ROADMAP: "dung SIMD de tang toc")
# ----------------------------------------------------------------------------
# Nguon toc: simd_gemm(a, b, r, n) — builtin native AVX2+FMA (tkv_simd_native.dll,
# nap canh .exe), nhan ma TRAN VUONG n x n, r = a x b (row-major), khong copy
# vao/ra, da luong. Bo nho cua tile duoc cap phai nho hon 1024 x 1024 x 4B = 4 MB.
#
# Ky luat tu do (do THAT bang simd_probe, 2026-10-19):
#   - simd_gemm chi nhan MA TRAN VUONG -> chia thanh o T x T, bo sung 0 o le.
#   - Khong bit-exact vs scalar: dung FMA + thu tu tich luy khac. Do lech do duoc
#     ~2e-6 (128^2) .. 3.4e-6 (512^2) voi gia tri +-1. Cua so dung sai chot
#     1e-4 (cung nguong parity 124M). Vi the SIMD la duong OPT-IN, mac dinh
#     van scalar (xem gpt2_ref: tham so `simd = 0`).
#   - simd_gemm ghi r = a x b (GAN, khong tich luy) -> moi o tich luy vao C
#     ngay sau moi goi (neu k > T thi phai cong tung p-tile).
#
# 2 kieu (cung bo tri hang):
#   smm_fwd(a, b, m, n, k):  C[m,n] = A[m,k] x B[k,n]   (B luu [k hang][n cot])
#   smm_dot(a, b, m, n, k):  C[i,j] = dot(A[i,:], B[j,:]) (B luu [n hang][k cot])
# smm_transpose(t, rows, cols): chuyen vi (dung cho dw = (dwT)^T).

def _imin(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return a
    return b

def _roundup64(x: 'i64') -> 'i64':
    r = 64
    while r < x:
        r = r + 64
    return r

def _tilek(k: 'i64') -> 'i64':
    # kich thuoc o giam (reduce) — toi da 1024 de giu tile <= 4 MB
    r = _roundup64(k)
    if r > 1024:
        r = 1024
    return r

# ---- tile builder (moi ham return MOT list phang theo quy uoc compiler) ----

# Quy tac kieu (do THAT bang probe 2026-0-19): list can truyen vao simd_gemm
# phai la list[f32] THUC (List[Single]). Tensor.data (t_zeros) KHONG dung duoc
# (native GemmF32L doc _items cua List[Single>, gap List[Double] -> crash).
# Cach dung: ham tra 'list[f32]' + append BIEU THUC (d[i] - 0.0)/1.0 — compiler
# ep ve List[Single] tai return. Append 0.0/float() thuan tao List[Double].
def _zeros_list(n: 'i64') -> 'list[f32]':
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    return out

# A[i0:i0+ib, p0:p0+pw] bo sung 0 thanh o T x T (A luu [m hang][k cot])
def _tile_a(a: "Tensor", kdim: 'i64', i0: 'i64', ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'list[f32]':
    out = []
    d = a.data
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < ib:
                if j < pw:
                    out.append((d[(i0 + i) * kdim + (p0 + j)] - 0.0) / 1.0)
                else:
                    out.append(z)
            else:
                out.append(z)
            j = j + 1
        i = i + 1
    return out

# B tile thanh T x T voi HANG = chi so giam (p), COT = chi so dau ra (j):
#   trans_b == 0: B luu [k hang][n cot] -> tile[i,j] = B[p0+i, r0+j]
#   trans_b == 1: B luu [n hang][k cot] -> tile[i,j] = B[r0+j, p0+i]
def _tile_b(b: "Tensor", ndim: 'i64', p0: 'i64', pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'list[f32]':
    out = []
    d = b.data
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < pw:
                if j < br:
                    if trans_b == 1:
                        out.append((d[(r0 + j) * ndim + (p0 + i)] - 0.0) / 1.0)
                    else:
                        out.append((d[(p0 + i) * ndim + (r0 + j)] - 0.0) / 1.0)
                else:
                    out.append(z)
            else:
                out.append(z)
            j = j + 1
        i = i + 1
    return out

# ==== P6 GĐ3 (2026-10-21, probe BH): tile builder VIET TRUC TIEP vao buffer
# tai su dung — bo append (List capacity-doubling ton ~23ns/ptu).
# Do A/B probe BH (ALL BIT-EXACT 0.0 — day du ghi de T^2 moi tile -> noi dung
# tile GIONG HET ban append cu):
#   [1024x768x50257] append 2468 -> buffer 1203 ms; [50257x768x1024]
#   3813 -> 1984 ms; [1024x50257x768] 2469 -> 1781 ms.
# Buffer do GOI CHU tao (locals), moi luong/worker so huu buffer RIENG ->
# khong chia se, an toan khi attention worker goi smm_* binh thuong.

def _tile_a_w(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
              ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    # A luu [m hang][k cot]: tile[i,j] = A[i0+i, p0+j] khi i<ib, j<pw — nguoc
    # lai = 0 (buffer bi tai su dung -> PHAI ghi day du T^2 moi tile)
    #
    # P6 GĐ8 (2026-10-22, probe BY2): viet theo INDEX CHAY + bien dem khai
    # o TOP-LEVEL cua ham. Quy tac compiler (probe `simd_probe_narrow2`, doc
    # `.locals` trong out/*.il): mot bien cuc bo chi duoc khai NATIVE int64
    # khi phep gan DAU TI cua no o top-level cua ham la mot bieu thuc int64
    # (vd `x = 0`, `src = i0 * kdim + p0`) VA cac phep gan sau deu "chung minh
    # duoc" (x = x + 1, x = y). Neu co mot phep gan khong chung minh duoc o
    # top-level (vd gan lai bang bieu thuc co `*`) ⇒ bien bi BOX thanh TkvInt
    # (struct 16B) ⇒ moi phep cong chi so cham ~2x. Do do: A-tile 1.49x,
    # B-tile 1.43x. Doc truc tiep d[i] (bo ep kieu (d[i]-0.0)/1.0 — chi can
    # cho `append`). BIT-EXACT 0.0: thu tu ghi vao out giong han W
    # (row-major), gia tri giong.
    z = 0.0
    i = 0
    dst = 0
    j = 0
    src = i0 * kdim + p0
    while i < ib:
        j = 0
        while j < pw:
            out[dst] = d[src + j]
            dst = dst + 1
            j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        src = src + kdim
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

# B: trans_b=0 -> B luu [k hang][n cot]; trans_b=1 -> B luu [n hang][k cot]
def _tile_b_w(out: "list[f32]", d: "list[f32]", ndim: 'i64', p0: 'i64',
              pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'i64':
    # P6 GĐ8 (probe BY2): index chay + bien dem native i64 — xem ghi chu
    # _tile_a_w. trans_b=1 -> doc DOC (stride ndim); trans_b=0 -> doc HANG.
    z = 0.0
    i = 0
    dst = 0
    j = 0
    row = p0 * ndim + r0
    idx = r0 * ndim + p0
    while i < pw:
        if trans_b == 1:
            idx = r0 * ndim + p0 + i
            j = 0
            while j < br:
                out[dst] = d[idx]
                dst = dst + 1
                idx = idx + ndim
                j = j + 1
        else:
            row = (p0 + i) * ndim + r0
            j = 0
            while j < br:
                out[dst] = d[row + j]
                dst = dst + 1
                j = j + 1
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    while i < T:
        j = 0
        while j < T:
            out[dst] = z
            dst = dst + 1
            j = j + 1
        i = i + 1
    return 0

# trans-A: a luu [k hang][m cot] (=A^T) — giong _p58_tile_a_at nhung viet
# vao buffer co san (At[r][t] = A_stored[(p0+t)*mdim + (i0+r)])
def _tile_a_at_w(out: "list[f32]", d: "list[f32]", mdim: 'i64', i0: 'i64',
                 ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    # P6 GĐ8 (probe BY2): index chay + bien dem native i64 — xem ghi chu
    # _tile_a_w. GHI out[r*T+t] theo thu tu row-major (giong ban W) nen
    # gia tri out giong het; doc d[(p0+t)*mdim + (i0+r)] tang dan mdim.
    z = 0.0
    r = 0
    t = 0
    dst = 0
    src = p0 * mdim + i0
    while r < ib:
        t = 0
        src = p0 * mdim + i0 + r
        while t < pw:
            out[dst] = d[src]
            dst = dst + 1
            src = src + mdim
            t = t + 1
        while t < T:
            out[dst] = z
            dst = dst + 1
            t = t + 1
        r = r + 1
    while r < T:
        t = 0
        while t < T:
            out[dst] = z
            dst = dst + 1
            t = t + 1
        r = r + 1
    return 0


# P6 GĐ8 (probe BY2): tich luy Ct vao C — index chay (bc/bt tang dan 1).
# W (inline trong ham co simd_gemm): bc = (i0+r)*n + j0, bt = r*T roi
# cd[bc+c] = cd[bc+c] + Ct[bt+c] -> moi phep cong lai 2 phep + 2 phep.
# F: bc/bt chay -> moi phep cong chi 2 phep cong don. Do do acc 1.08x
# (BY2[2]: W 4.79 ns/ptu -> F 4.44 ns/ptu). BIT-EXACT 0.0: thu tu cong
# tung p-tile tang dan p0 giong han (khong dung bien "copy p-tile dau" cua
# probe vi do CHAM hon cong don va doi dau dau so 0).
def _acc_f(cd: "list[f32]", Ct: "list[f32]", n: 'i64', i0: 'i64',
           ib: 'i64', j0: 'i64', jb: 'i64', T: 'i64') -> 'i64':
    r = 0
    bc = i0 * n + j0
    bt = T * 0
    c = 0
    while r < ib:
        bc = i0 * n + j0 + r * n
        bt = r * T
        c = 0
        while c < jb:
            cd[bc] = cd[bc] + Ct[bt]
            bc = bc + 1
            bt = bt + 1
            c = c + 1
        r = r + 1
    return 0

# ---- M3c (2026-10-23, probe CI/CQ/CR/CT): C-data tu scratch -------------
# t_zeros du`ng append-0.0 interpreted (capacity-doubling) — ALLOC C S4/S5
# = 359-421 ms/call; zero-fill indexed chi 63-94 ms (ratio 0.18-0.22, CI).
# _smm_cd: neu sc du` do (len >= m*n) -> zero-fill + muon (thang List[Single]
# cua t_zeros — CR chot kieu); khong thi t_zeros nhu cu (fallback nguyen ven).
# sc annotation PHAI la "list[f32]" — P7 silent conv (CR: ->list[f64] doc
# = 0.0). Caller chu dong trach nghiem: muon xong PHAI copy ra neu giu lau
# (3 call site hien tai deu copy/dua vao opt.g truoc khi goi lai goi sau).

def _smm_cd(m: 'i64', n: 'i64', sc: "list[f32]" = None) -> "list[f32]":
    tot = m * n
    if sc != None:
        if len(sc) >= tot:
            z = (float(0) - 0.0) / 1.0
            i = 0
            while i < tot:
                sc[i] = z
                i = i + 1
            return sc
    C0 = t_zeros([m, n])
    return C0.data

# ---- M4 WIRED (2026-10-25, probe CJ2/CJ5 @ out/cj2_run.log, out/cj5_run.log) ----
# Packed native TRUC TIEP tu Tensor.data, khong convert:
#   So do best-of-3 T=256: S3 m=1024 1.69x / m=256 3.21x / m=8 2.58x;
#   S5 m=1024 2.43x / m=256 2.0x / m=8 1.22x; S1 m=1024 2.04x / m=256 1.48x,
#   S1 m=8 1.0x — KHONG case nao regress (CJ5). Numerics: md <= 4e-5 (f32 ulp,
#   thu tu KC khac wave-12), S5/S6 bit-exact 0.0, diag vs scalar khop.
# Dieu kien routing:
#   - trans_a = 0 (S4 trans-A lon do 0.6x tai CY -> LOAI, giu duong cu);
#   - k >= 256 (attention head k=64 khong pack — pad T=256 lang phi 4x).
# Tensor.data GIO la list[f32] THAT (fix t_zeros 2026-10-25) -> packed_create
# nhan truc tiep; convert interpreted truoc do (CJ cu) nuot het gain -> khong dung.
# C: packed ghi de DAY DU m*n (da chot m=8 vs C len=m*n khong tran) -> khong can
# zero-fill khi muon sc (tiet 63-94ms/40M ptu theo M3c).

def _smm_pk_c(m: 'i64', n: 'i64', sc: "list[f32]" = None) -> "list[f32]":
    if sc != None:
        if len(sc) >= m * n:
            return sc
    C0 = t_zeros([m, n])
    return C0.data

# ---- M6b WIRED (2026-10-26, probe GF1 @ tv/tests/_gf1.tkv) -----------------
# simd_gemm_full = 1 ABI goi toan bo BUILD tile + GEMM + ACC trong DLL
# (compiler reply 2026-10-26, Yeu cau #2 Uu tien A). A/B vs _smm_pk M4
# best-of-5 T=256, 4 shape + guard:
#   m=8:   S5 2.01x, S1 thang (16ms -> ~0), S3 ~hoa
#   m=256: S5 1.63x, S3 1.26x, S1 2.07x
#   m=1024: S5 0.57x (422->735ms), S3 0.83x, S1 1.0x — THUA
# NGUYEN NHAN: full avoid pack nguyen ma tran (thang m nho) nhung build lai
# B-tile moi (i0,p0,j0) — so lan nhan voi ceil(m/T) (m lon -> thua packed
# pack 1 lan). Compiler bao chua lam B-tile cache theo i0 (huong toi uu 2
# cua ho). ROUTING: m <= 256 -> full (so do thang), m > 256 -> _smm_pk
# NGUYEN CON (seq1024 numerics giu nguyen bit). BIT full vs packed <= 3.6e-5
# (f32 ulp, khac thu tu tile — trong tol gate 1e-4).
# S4 trans_a=1: full khong co trans_a -> van di smm_fwd_at/_p58 (khong doi).
def _smm_full(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
              ndim: 'i64', trans_b: 'i32', sc: "list[f32]" = None) -> "Tensor":
    cd = _smm_pk_c(m, n, sc)
    ad = a.data
    bd = b.data
    rv = simd_gemm_full(ad, bd, cd, m, n, k, ndim, trans_b, 256, 0)
    return Tensor(cd, [m, n], 0)

def _smm_pk(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
            ndim: 'i64', trans_b: 'i32', sc: "list[f32]" = None) -> "Tensor":
    T = 256
    cd = _smm_pk_c(m, n, sc)
    ad = a.data
    bd = b.data
    hA = 0
    hB = 0
    hA = simd_gemm_packed_create(ad, m, k, k, T, 0)
    if trans_b == 0:
        # B luu [k][ndim] (ndim = n): rows=k, cols=n, stride=n
        hB = simd_gemm_packed_create(bd, k, ndim, ndim, T, 0)
    else:
        # B luu [n][k] (ndim = k): rows=n, cols=k, stride=k — KHONG dung ndim lam rows
        hB = simd_gemm_packed_create(bd, n, k, k, T, 1)
    st = simd_gemm_packed(hA, hB, cd, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    return Tensor(cd, [m, n], 0)

# ---- core: C = A x B (trans_b=0) hoac A x B^T (trans_b=1), tiled -----------
def _smm_core(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32', sc: "list[f32]" = None) -> "Tensor":
    # M4 wire: k du lon -> packed native (xem ghi chu M4 WIRED ben tren)
    # M6b wire: packed + m nho -> simd_gemm_full (xem ghi chu M6b WIRED)
    if k >= 256:
        if m <= 256:
            return _smm_full(a, b, m, n, k, ndim, trans_b, sc)
        return _smm_pk(a, b, m, n, k, ndim, trans_b, sc)
    # P0.4 (perf-plan): T = min(_tilek(k), roundup64(min(m,n))) — truoc do T
    # chi theo k -> o gian (m=8, k=50257) dan len T=1024, A-tile dung 8/1024
    # hang (0.8% huu dung). Cong thuc chon: V(T) = (ceil(m/T)+ceil(n/T))*ceil(k/T)*T^2
    # — T nho dan luon giam/the tich dung (do duoc, khong can chia: dung min/roundup).
    # Do lan cuoi: gate 20/20, probe X, bench A/B/C.
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    cd = _smm_cd(m, n, sc)
    # P0.1 (perf-plan): Ct DUY NHAT 1 lan/call — simd_gemm ghi de toan bo
    # (r = a x b, GAN khong tich luy) nen khong can sinh/dung lai moi combo.
    Ct = _zeros_list(T * T)
    # P6 GĐ3: At/Bt cung dung 1 buffer tai su dung (viet day du T^2 moi tile)
    AtB = _zeros_list(T * T)
    BtB = _zeros_list(T * T)
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        # P0.2: vong i -> p -> j: At xay dung 1 lan cho toan bo j (truoc la
        # i -> j -> p, At sua lai moi combo -> ~2/3 luong append la dung lai).
        # Thu tu p van tang dan cho tung (i,j) -> ket qua GIONG BIT ban cu.
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            rva = _tile_a_w(AtB, a.data, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                rvb = _tile_b_w(BtB, b.data, ndim, p0, pw, j0, jb, T, trans_b)
                # quirk: simd_gemm can 3 BIEN mang rank 1 (khong nhan bieu thuc)
                simd_gemm(AtB, BtB, Ct, T)
                # tich luy vung that cua Ct vao C ngay sau moi goi
                rvc = _acc_f(cd, Ct, n, i0, ib, j0, jb, T)
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return Tensor(cd, [m, n], 0)

# C[m,n] = A[m,k] x B[k,n] — cung y nghia layout voi gpt2_linear (w [in_d][out_d])
def smm_fwd(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64') -> "Tensor":
    return _smm_core(a, b, m, n, k, n, 0)

# C[i,j] = dot(A[i,:], B[j,:]) — cung y nghia voi op_matmul_fwd (B [n hang][k cot])
def smm_dot(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', sc: "list[f32]" = None) -> "Tensor":
    return _smm_core(a, b, m, n, k, k, 1, sc)

def smm_transpose(t: "Tensor", rows: 'i64', cols: 'i64') -> "Tensor":
    out = t_zeros([cols, rows])
    od = out.data
    d = t.data
    # P5.7 (2026-10-20, probe AW): DA THU blocked 64x64 — CHAM HON 2.7x
    # ([1024,50257]: 4375ms vs 1625ms; vong 4 tang thong dich dat hon loi
    # cache) -> REVERT ve ban vong 2 tang. Bai hoc: chi do moi chot.
    i = 0
    while i < rows:
        j = 0
        while j < cols:
            od[j * rows + i] = d[i * cols + j]
            j = j + 1
        i = i + 1
    return out


# ==== P5.8 (2026-10-21): KERNEL GEMM v2 — trans-A + tich luy NATIVE + dispatch ====
# Yeu cau do duoc tu P5.7 (roadmap TRIZ §12):
#   (a) trans-A: nhan C = A^T x B TRUC TIEP tu A dang luu [k hang][m cot] —
#       bo 1.56s transpose ggT @1024 (probe AW: PLAIN [1024,50257] = 1500ms).
#   (b) tich luy in-place (simd_add native): DA DO VA BO — cham hon simple
#       (dxf @1024: 3000 vs 2703ms; simd_add allocate 16B/element) — xem ghi
#       chu duong ACC ben duoi.
#   (c) dispatch: TOAN BO -> _p58_core_simple (v1 + trans_a).
#
# BAI HOC PROBE BC (2026-10-21) — NGUYEN NHAN v2 cham 2.5x da CHOT:
#   Call site simd_add/simd_sub (System.Numerics) trong CUNG function voi vong
#   lap scalar lam compiler codegen vong do cham 2.5-4x — DU khi khong chay
#   (use_acc=0). Da chot bang 2/2 gia thuyet: BC-v5 (chi nhanh + goi
#   simd_add/sub, use_acc=0) = 156-172ms vs v1 = 63ms; BC-v6 (copy nguyen van
#   vao probe) cung cham -> noi dung function, khong phai vi tri module.
#   -> TACH 2 HAM: _p58_core_simple KHONG co call site simd_add/sub.
#   Ket qua do tiep (AX @1024): _p58_core_acc (simd_add native) CHAM HON
#   simple (dxf 3000 vs 2703ms, simd_add allocate 16B/element) -> XOA acc,
#   dispatch toan bo vao simple. Con lai loi do duoc: trans-A (dwte 4875 vs
#   5140 cu). Determinism: thu tu tich luy p0 tang dan GIU NGUYEN (cung gia
#   tri p-tile) -> BIT-EXACT voi v1 (kiem chung bang probe AX 256 + 1024).
# v1 NGUYEN KHONG DOI; v2 = v1 + trans-A, BIT-EXACT, DA DO A/B (AX ALL PASS).

# At[r][t] = A_stored[(p0+t)*mdim + (i0+r)] — A_stored luu [k hang][m cot] (= A^T).
# Nguon row-major doc lienh tuc; ghi scatter vao o nho T x T (L2/L1) — khong
# can materialize A^T toan phan (transpose ggT [n][V] = 51.5M ptu @1024).
def _p58_tile_a_at(a: "Tensor", mdim: 'i64', i0: 'i64', ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'list[f32]':
    out = _zeros_list(T * T)
    d = a.data
    t = 0
    while t < pw:
        src = (p0 + t) * mdim + i0
        off = t
        r = 0
        while r < ib:
            out[r * T + off] = (d[src + r] - 0.0) / 1.0
            r = r + 1
        t = t + 1
    return out

# DUONG AN TOAN (v1 + trans_a): KHONG simd_add/simd_sub call site (probe BC:
# chi su hien tai call do trong function cung vong scalar da lam cham 2.5x).
def _p58_core_simple(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32', trans_a: 'i32', sc: "list[f32]" = None) -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    cd = _smm_cd(m, n, sc)
    Ct = _zeros_list(T * T)
    # P6 GĐ3: buffer tai su dung (xem ghi chu _tile_a_w o tren)
    AtB = _zeros_list(T * T)
    BtB = _zeros_list(T * T)
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            if trans_a == 1:
                rva = _tile_a_at_w(AtB, a.data, m, i0, ib, p0, pw, T)
            else:
                rva = _tile_a_w(AtB, a.data, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                rvb = _tile_b_w(BtB, b.data, ndim, p0, pw, j0, jb, T, trans_b)
                simd_gemm(AtB, BtB, Ct, T)
                rvc = _acc_f(cd, Ct, n, i0, ib, j0, jb, T)
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return Tensor(cd, [m, n], 0)

# P5.8 ACC PATH DA DO VA BO (2026-10-21, AX @1024): _p58_core_acc tich luy bang
# simd_add native — DO DUOC CHAM HON duong simple: dxf [1024,50257] 3000ms vs
# 2703ms (v1/simple), va simd_add 3-arg allocate ~16B/element (SIMD_NOTES P2-2)
# -> 66 p-tile x 768^2 alloc/lan. ctx/score nho: 31 = 31 (khong do duoc lech).
# Khong co shape nao acc nhanh hon -> dispatch TOAN BO ve simple; chi giu lai
# trans-A (dwte @1024: 4875 vs 5140 cu — LOI RO RET). Acc path xoa (git luu).

# dispatch: TOAN BO duong simple (v1 + trans_a) — xem ghi chu P5.8 ACC o tren.
def _p58_core(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32', trans_a: 'i32', sc: "list[f32]" = None) -> "Tensor":
    return _p58_core_simple(a, b, m, n, k, ndim, trans_b, trans_a, sc)

# C[m,n] = A x B — v2 (bit-exact voi smm_fwd)
def smm_fwd_v2(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64') -> "Tensor":
    return _p58_core(a, b, m, n, k, n, 0, 0)

# C[i,j] = dot(A[i,:], B[j,:]) — v2 (bit-exact voi smm_dot)
def smm_dot_v2(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64') -> "Tensor":
    return _p58_core(a, b, m, n, k, k, 1, 0)

# (a) trans-A: a luu [k hang][m cot] (= A^T), b luu [k hang][n cot]
#     -> C[m,n] = A^T x B, khong materialize A^T.
# Vi du lm-head: dwte[V,h] = ggT[V,n] x xf[n,h] voi gg luu [n][V]
#   -> smm_fwd_at(gg, xf, V, h, n) — chi transpose theo o T x T khi build.
def smm_fwd_at(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', sc: "list[f32]" = None) -> "Tensor":
    return _p58_core(a, b, m, n, k, n, 0, 1, sc)

# ==== P6 GĐ3 (2026-10-21, probe BH): smm_*_pd — WAVE PARALLEL TILE-BUILD ====
# Do duoc probe BH (ALL BIT-EXACT 0.0): build tile interpreted la phan lon chi
# phi cua GEMM lon (append ~23ns/ptu do List capacity-doubling):
#   [1024x768x50257] LIB 2468 -> serial+buffer 1203 -> PAR 766 ms (3.2x)
#   [50257x768x1024] LIB 3813 -> 1984 -> 1187 ms (3.2x)
#   [1024x50257x768] LIB 2469 -> 1781 -> 1156 ms (2.1x)
# Co che: 12 worker build tile RIENG (indexed write vao buffer main pre-alloc,
# KHONG append, KHONG goi simd_gemm — T>=96 ma goi dong thieu se cham vao
# g_job global KHONG CO LOCK), MAIN replay gemm + accumulate theo DUNG thu tu
# i0 -> p0 -> j0 -> cung tile, cung thu tu tich lu -> BIT-EXACT.
# Do BH[0]: spawn+join x100 < 15.6ms -> overhead spawn negligible.
#
# Route theo kich thuoc: vol = n_i*n_p*n_j*T*T < 40M -> SERIAL (da fix builder;
# 24 buffer78ms + spawn lam cham shape nho — BH S1/S2: PAR 140/172 vs SER
# 109/78). Lon hon -> wave 12 (chi shape vocab 50257 cua lm-head dat nguong).
# CHI GOI TU MAIN THREAD (attention worker chi goi smm_fwd/smm_dot thuong —
# gpt2_linear/gpt2_linear_bwd/duong lm-head deu nam tren main).
#
# Quy uoc ghi ma: 1 list phang/ham, khong gan lai bien module, timing o main.

def _pd_ceil(x: 'i64', T: 'i64') -> 'i64':
    q = 0
    r = 0
    while r < x:
        r = r + T
        q = q + 1
    return q

# chia nguyen — tranh phu thuoc semanrics '/' cua i64; g < 0 -> 0
# (slot kem truyen gidx = -1 de worker no-op van tinh duoc params an toan)
def _pd_gq(g: 'i64', stride: 'i64') -> 'i64':
    if g < 0:
        return 0
    q = 0
    s = g
    while s >= stride:
        s = s - stride
        q = q + 1
    return q

# gidx -> i0/p0/j0 theo thu tu i0 ngoai, p0, j0 — khop vong _smm_core
# (gidx = i0idx*(n_p*n_j) + p0idx*n_j + j0idx)
def _pd_i0(g: 'i64', stride: 'i64', T: 'i64') -> 'i64':
    return _pd_gq(g, stride) * T

def _pd_p0(g: 'i64', stride: 'i64', n_j: 'i64', T: 'i64') -> 'i64':
    i0idx = _pd_gq(g, stride)
    rem = g - i0idx * stride
    return _pd_gq(rem, n_j) * T

def _pd_j0(g: 'i64', stride: 'i64', n_j: 'i64', T: 'i64') -> 'i64':
    i0idx = _pd_gq(g, stride)
    rem = g - i0idx * stride
    p0idx = _pd_gq(rem, n_j)
    return (rem - p0idx * n_j) * T

# worker spec — record field chi nhan scalar/container/class-cung-file;
# Tensor KHONG truyen duoc -> day data list + dims

class _PdJob:
    gidx: 'i64'
    ad: "list[f32]"
    bd: "list[f32]"
    kdim: 'i64'
    mdim: 'i64'
    ndim: 'i64'
    T: 'i64'
    trans_a: 'i32'
    trans_b: 'i32'
    i0: 'i64'
    ib: 'i64'
    p0: 'i64'
    pw: 'i64'
    j0: 'i64'
    jb: 'i64'
    ta: "list[f32]"
    tb: "list[f32]"
    def __init__(self, gidx: 'i64', ad: "list[f32]", bd: "list[f32]",
                  kdim: 'i64', mdim: 'i64', ndim: 'i64', T: 'i64',
                  trans_a: 'i32', trans_b: 'i32',
                  i0: 'i64', ib: 'i64', p0: 'i64', pw: 'i64',
                  j0: 'i64', jb: 'i64', ta: "list[f32]", tb: "list[f32]"):
        self.gidx = gidx
        self.ad = ad
        self.bd = bd
        self.kdim = kdim
        self.mdim = mdim
        self.ndim = ndim
        self.T = T
        self.trans_a = trans_a
        self.trans_b = trans_b
        self.i0 = i0
        self.ib = ib
        self.p0 = p0
        self.pw = pw
        self.j0 = j0
        self.jb = jb
        self.ta = ta
        self.tb = tb

def _pd_one(j: "_PdJob") -> 'i64':
    # worker: build 1 cap tile (At + Bt) cho 1 gemm-call — KHONG simd_gemm,
    # KHONG append (buffer main pre-alloc) -> an toan concurrent
    if j.gidx < 0:
        return 0
    rv = 0
    if j.trans_a == 1:
        rv = _tile_a_at_w(j.ta, j.ad, j.mdim, j.i0, j.ib, j.p0, j.pw, j.T)
    else:
        rv = _tile_a_w(j.ta, j.ad, j.kdim, j.i0, j.ib, j.p0, j.pw, j.T)
    rv2 = _tile_b_w(j.tb, j.bd, j.ndim, j.p0, j.pw, j.j0, j.jb, j.T, j.trans_b)
    return rv + rv2

# gemm 1 goi + accumulate vung that vao C — thu tu goi = thu tu tich lu

def _pd_do(Ct: "list[f32]", ta: "list[f32]", tb: "list[f32]", T: 'i64',
           cd: "list[f32]", i0: 'i64', ib: 'i64', j0: 'i64', jb: 'i64',
           n: 'i64') -> 'i64':
    simd_gemm(ta, tb, Ct, T)
    rvc = _acc_f(cd, Ct, n, i0, ib, j0, jb, T)
    return 0

def _smm_core_pd(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
                 ndim: 'i64', trans_b: 'i32', trans_a: 'i32', sc: "list[f32]" = None) -> "Tensor":
    # M4 wire: trans_a=0 + k du lon -> packed native (S4 trans-A giu duong cu)
    # M6b wire: packed + m nho -> simd_gemm_full (xem ghi chu M6b WIRED)
    if trans_a == 0:
        if k >= 256:
            if m <= 256:
                return _smm_full(a, b, m, n, k, ndim, trans_b, sc)
            return _smm_pk(a, b, m, n, k, ndim, trans_b, sc)
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    n_i = _pd_ceil(m, T)
    n_p = _pd_ceil(k, T)
    n_j = _pd_ceil(n, T)
    if n_i * n_p * n_j * T * T < 40000000:
        # shape nho (MLP/attention/gate): serial da fix builder — overhead
        # 24 buffer (BH[2] 78ms) + spawn lam cham (BH S1/S2)
        if trans_a == 1:
            return _p58_core_simple(a, b, m, n, k, ndim, trans_b, 1, sc)
        return _smm_core(a, b, m, n, k, ndim, trans_b, sc)
    cd = _smm_cd(m, n, sc)
    Ct = _zeros_list(T * T)
    ta0 = _zeros_list(T * T)
    ta1 = _zeros_list(T * T)
    ta2 = _zeros_list(T * T)
    ta3 = _zeros_list(T * T)
    ta4 = _zeros_list(T * T)
    ta5 = _zeros_list(T * T)
    ta6 = _zeros_list(T * T)
    ta7 = _zeros_list(T * T)
    ta8 = _zeros_list(T * T)
    ta9 = _zeros_list(T * T)
    ta10 = _zeros_list(T * T)
    ta11 = _zeros_list(T * T)
    tb0 = _zeros_list(T * T)
    tb1 = _zeros_list(T * T)
    tb2 = _zeros_list(T * T)
    tb3 = _zeros_list(T * T)
    tb4 = _zeros_list(T * T)
    tb5 = _zeros_list(T * T)
    tb6 = _zeros_list(T * T)
    tb7 = _zeros_list(T * T)
    tb8 = _zeros_list(T * T)
    tb9 = _zeros_list(T * T)
    tb10 = _zeros_list(T * T)
    tb11 = _zeros_list(T * T)
    stride = n_p * n_j
    ng = n_i * stride
    wave = 0
    while wave * 12 < ng:
        # ---- derive guse + spec slot 0..11 --------------------------------
        g0 = -1
        if wave * 12 + 0 < ng:
            g0 = wave * 12 + 0
        i0_0 = _pd_i0(g0, stride, T)
        ib_0 = _imin(T, m - i0_0)
        p0_0 = _pd_p0(g0, stride, n_j, T)
        pw_0 = _imin(T, k - p0_0)
        j0_0 = _pd_j0(g0, stride, n_j, T)
        jb_0 = _imin(T, n - j0_0)

        g1 = -1
        if wave * 12 + 1 < ng:
            g1 = wave * 12 + 1
        i0_1 = _pd_i0(g1, stride, T)
        ib_1 = _imin(T, m - i0_1)
        p0_1 = _pd_p0(g1, stride, n_j, T)
        pw_1 = _imin(T, k - p0_1)
        j0_1 = _pd_j0(g1, stride, n_j, T)
        jb_1 = _imin(T, n - j0_1)

        g2 = -1
        if wave * 12 + 2 < ng:
            g2 = wave * 12 + 2
        i0_2 = _pd_i0(g2, stride, T)
        ib_2 = _imin(T, m - i0_2)
        p0_2 = _pd_p0(g2, stride, n_j, T)
        pw_2 = _imin(T, k - p0_2)
        j0_2 = _pd_j0(g2, stride, n_j, T)
        jb_2 = _imin(T, n - j0_2)

        g3 = -1
        if wave * 12 + 3 < ng:
            g3 = wave * 12 + 3
        i0_3 = _pd_i0(g3, stride, T)
        ib_3 = _imin(T, m - i0_3)
        p0_3 = _pd_p0(g3, stride, n_j, T)
        pw_3 = _imin(T, k - p0_3)
        j0_3 = _pd_j0(g3, stride, n_j, T)
        jb_3 = _imin(T, n - j0_3)

        g4 = -1
        if wave * 12 + 4 < ng:
            g4 = wave * 12 + 4
        i0_4 = _pd_i0(g4, stride, T)
        ib_4 = _imin(T, m - i0_4)
        p0_4 = _pd_p0(g4, stride, n_j, T)
        pw_4 = _imin(T, k - p0_4)
        j0_4 = _pd_j0(g4, stride, n_j, T)
        jb_4 = _imin(T, n - j0_4)

        g5 = -1
        if wave * 12 + 5 < ng:
            g5 = wave * 12 + 5
        i0_5 = _pd_i0(g5, stride, T)
        ib_5 = _imin(T, m - i0_5)
        p0_5 = _pd_p0(g5, stride, n_j, T)
        pw_5 = _imin(T, k - p0_5)
        j0_5 = _pd_j0(g5, stride, n_j, T)
        jb_5 = _imin(T, n - j0_5)

        g6 = -1
        if wave * 12 + 6 < ng:
            g6 = wave * 12 + 6
        i0_6 = _pd_i0(g6, stride, T)
        ib_6 = _imin(T, m - i0_6)
        p0_6 = _pd_p0(g6, stride, n_j, T)
        pw_6 = _imin(T, k - p0_6)
        j0_6 = _pd_j0(g6, stride, n_j, T)
        jb_6 = _imin(T, n - j0_6)

        g7 = -1
        if wave * 12 + 7 < ng:
            g7 = wave * 12 + 7
        i0_7 = _pd_i0(g7, stride, T)
        ib_7 = _imin(T, m - i0_7)
        p0_7 = _pd_p0(g7, stride, n_j, T)
        pw_7 = _imin(T, k - p0_7)
        j0_7 = _pd_j0(g7, stride, n_j, T)
        jb_7 = _imin(T, n - j0_7)

        g8 = -1
        if wave * 12 + 8 < ng:
            g8 = wave * 12 + 8
        i0_8 = _pd_i0(g8, stride, T)
        ib_8 = _imin(T, m - i0_8)
        p0_8 = _pd_p0(g8, stride, n_j, T)
        pw_8 = _imin(T, k - p0_8)
        j0_8 = _pd_j0(g8, stride, n_j, T)
        jb_8 = _imin(T, n - j0_8)

        g9 = -1
        if wave * 12 + 9 < ng:
            g9 = wave * 12 + 9
        i0_9 = _pd_i0(g9, stride, T)
        ib_9 = _imin(T, m - i0_9)
        p0_9 = _pd_p0(g9, stride, n_j, T)
        pw_9 = _imin(T, k - p0_9)
        j0_9 = _pd_j0(g9, stride, n_j, T)
        jb_9 = _imin(T, n - j0_9)

        g10 = -1
        if wave * 12 + 10 < ng:
            g10 = wave * 12 + 10
        i0_10 = _pd_i0(g10, stride, T)
        ib_10 = _imin(T, m - i0_10)
        p0_10 = _pd_p0(g10, stride, n_j, T)
        pw_10 = _imin(T, k - p0_10)
        j0_10 = _pd_j0(g10, stride, n_j, T)
        jb_10 = _imin(T, n - j0_10)

        g11 = -1
        if wave * 12 + 11 < ng:
            g11 = wave * 12 + 11
        i0_11 = _pd_i0(g11, stride, T)
        ib_11 = _imin(T, m - i0_11)
        p0_11 = _pd_p0(g11, stride, n_j, T)
        pw_11 = _imin(T, k - p0_11)
        j0_11 = _pd_j0(g11, stride, n_j, T)
        jb_11 = _imin(T, n - j0_11)

        # ---- spawn 12 worker (unrolled — chung minh tu P6 GĐ1/GĐ2) --------
        hb0 = thread_spawn(_pd_one, _PdJob(g0, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_0, ib_0, p0_0, pw_0, j0_0, jb_0, ta0, tb0))
        hb1 = thread_spawn(_pd_one, _PdJob(g1, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_1, ib_1, p0_1, pw_1, j0_1, jb_1, ta1, tb1))
        hb2 = thread_spawn(_pd_one, _PdJob(g2, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_2, ib_2, p0_2, pw_2, j0_2, jb_2, ta2, tb2))
        hb3 = thread_spawn(_pd_one, _PdJob(g3, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_3, ib_3, p0_3, pw_3, j0_3, jb_3, ta3, tb3))
        hb4 = thread_spawn(_pd_one, _PdJob(g4, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_4, ib_4, p0_4, pw_4, j0_4, jb_4, ta4, tb4))
        hb5 = thread_spawn(_pd_one, _PdJob(g5, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_5, ib_5, p0_5, pw_5, j0_5, jb_5, ta5, tb5))
        hb6 = thread_spawn(_pd_one, _PdJob(g6, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_6, ib_6, p0_6, pw_6, j0_6, jb_6, ta6, tb6))
        hb7 = thread_spawn(_pd_one, _PdJob(g7, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_7, ib_7, p0_7, pw_7, j0_7, jb_7, ta7, tb7))
        hb8 = thread_spawn(_pd_one, _PdJob(g8, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_8, ib_8, p0_8, pw_8, j0_8, jb_8, ta8, tb8))
        hb9 = thread_spawn(_pd_one, _PdJob(g9, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_9, ib_9, p0_9, pw_9, j0_9, jb_9, ta9, tb9))
        hb10 = thread_spawn(_pd_one, _PdJob(g10, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_10, ib_10, p0_10, pw_10, j0_10, jb_10, ta10, tb10))
        hb11 = thread_spawn(_pd_one, _PdJob(g11, a.data, b.data, k, m, ndim, T, trans_a, trans_b, i0_11, ib_11, p0_11, pw_11, j0_11, jb_11, ta11, tb11))

        # ---- join (phai gan bien — quirk P6 GĐ1) ---------------------------
        rj0 = thread_join(hb0)
        rj1 = thread_join(hb1)
        rj2 = thread_join(hb2)
        rj3 = thread_join(hb3)
        rj4 = thread_join(hb4)
        rj5 = thread_join(hb5)
        rj6 = thread_join(hb6)
        rj7 = thread_join(hb7)
        rj8 = thread_join(hb8)
        rj9 = thread_join(hb9)
        rj10 = thread_join(hb10)
        rj11 = thread_join(hb11)

        # ---- replay gemm DUNG thu tu i0 -> p0 -> j0 (bit-exact) -----------
        if g0 >= 0:
            rrp0 = _pd_do(Ct, ta0, tb0, T, cd, i0_0, ib_0, j0_0, jb_0, n)
        if g1 >= 0:
            rrp1 = _pd_do(Ct, ta1, tb1, T, cd, i0_1, ib_1, j0_1, jb_1, n)
        if g2 >= 0:
            rrp2 = _pd_do(Ct, ta2, tb2, T, cd, i0_2, ib_2, j0_2, jb_2, n)
        if g3 >= 0:
            rrp3 = _pd_do(Ct, ta3, tb3, T, cd, i0_3, ib_3, j0_3, jb_3, n)
        if g4 >= 0:
            rrp4 = _pd_do(Ct, ta4, tb4, T, cd, i0_4, ib_4, j0_4, jb_4, n)
        if g5 >= 0:
            rrp5 = _pd_do(Ct, ta5, tb5, T, cd, i0_5, ib_5, j0_5, jb_5, n)
        if g6 >= 0:
            rrp6 = _pd_do(Ct, ta6, tb6, T, cd, i0_6, ib_6, j0_6, jb_6, n)
        if g7 >= 0:
            rrp7 = _pd_do(Ct, ta7, tb7, T, cd, i0_7, ib_7, j0_7, jb_7, n)
        if g8 >= 0:
            rrp8 = _pd_do(Ct, ta8, tb8, T, cd, i0_8, ib_8, j0_8, jb_8, n)
        if g9 >= 0:
            rrp9 = _pd_do(Ct, ta9, tb9, T, cd, i0_9, ib_9, j0_9, jb_9, n)
        if g10 >= 0:
            rrp10 = _pd_do(Ct, ta10, tb10, T, cd, i0_10, ib_10, j0_10, jb_10, n)
        if g11 >= 0:
            rrp11 = _pd_do(Ct, ta11, tb11, T, cd, i0_11, ib_11, j0_11, jb_11, n)

        wave = wave + 1
    return Tensor(cd, [m, n], 0)

# export: duong PD (route tu dong serial<->wave theo nguong 40M)
def smm_fwd_pd(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', sc: "list[f32]" = None) -> "Tensor":
    return _smm_core_pd(a, b, m, n, k, n, 0, 0, sc)

def smm_dot_pd(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', sc: "list[f32]" = None) -> "Tensor":
    return _smm_core_pd(a, b, m, n, k, k, 1, 0, sc)

def smm_fwd_at_pd(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', sc: "list[f32]" = None) -> "Tensor":
    return _smm_core_pd(a, b, m, n, k, n, 0, 1, sc)
