# BENCH P6 list[f32] (YEU CAU #5, Phase C1) — A/B 2 ham CUNG phep toan
#
#   _vec : `r[i] = a[i] + b[i]` + `i = i + 1`  -> DUNG 2 cau, bi P6 khop
#          -> vong vector buoc 4 (v_load4a/v_store4a) + duoi scalar
#   _scl : 3 cau (them buoc trung gian `t = a[i] + b[i]`) -> P6 TU CHOI
#          -> duong scalar get_Item/set_Item cu
#
# Cung so luong phep toan, cung kieu du lieu, cung ket qua (bit-giong) -
# chi khac O P6. Best-of-N xen kẽ nhu kieu `_f32p`.
#
# Chay:
#   /d/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_p6_bench.tkv out/_p6b.exe main
#   ./out/_p6b.exe


def _vec(a: "list[f32]", b: "list[f32]", r: "list[f32]", n: "i32") -> "i32":
    i = 0
    while i < n:
        r[i] = a[i] + b[i]
        i = i + 1
    return 0


def _scl(a: "list[f32]", b: "list[f32]", r: "list[f32]", n: "i32") -> "i32":
    t: "f32" = 0.0
    i = 0
    while i < n:
        t = a[i] + b[i]
        r[i] = t
        i = i + 1
    return 0


def _mk(n: "i32", v: "f32") -> "list[f32]":
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append(v)
        i = i + 1
    return out


def main() -> "i32":
    n = 4000003           # so le, khong chia 4 -> co ca duoi scalar chay
    a = _mk(n, 1.5)
    b = _mk(n, 2.25)
    rv: "list[f32]" = []
    rs: "list[f32]" = []
    i = 0
    while i < n:
        rv.append(0.0)
        rs.append(0.0)
        i = i + 1

    # warmup
    w1 = _vec(a, b, rv, n)
    w2 = _scl(a, b, rs, n)

    # `now_ms()` tren .NET co do phan giai ~15.6 ms - 1 lan goi (~5 ms cho
    # n=4M) nam duoi do nen phai chay theo batch nhu `_f32p` (runs = 120).
    reps = 5
    runs = 40
    bestV = 999999999.0
    bestS = 999999999.0
    k = 0
    while k < reps:
        # xen ke thu tu: le -> scalar truoc, le -> vector truoc de phat hien
        # neu ket qua chi la do THU TU do (cache/freq ramp)
        if k % 2 == 0:
            t0 = now_ms()
            q = 0
            while q < runs:
                x2 = _scl(a, b, rs, n)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                x1 = _vec(a, b, rv, n)
                q = q + 1
            t2 = now_ms()
        else:
            t0 = now_ms()
            q = 0
            while q < runs:
                x1 = _vec(a, b, rv, n)
                q = q + 1
            t1 = now_ms()
            q = 0
            while q < runs:
                x2 = _scl(a, b, rs, n)
                q = q + 1
            t2 = now_ms()
        if k % 2 == 0:
            dV = t2 - t1
            dS = t1 - t0
        else:
            dV = t1 - t0
            dS = t2 - t1
        if dV < bestV:
            bestV = dV
        if dS < bestS:
            bestS = dS
        k = k + 1

    # kiem ket qua bit-giong
    bad = 0
    i = 0
    while i < n:
        if rv[i] != rs[i]:
            bad = bad + 1
        if rv[i] != 3.75:
            bad = bad + 1
        i = i + 1

    print("P6B n=" + str(n) + " reps=" + str(reps) + " runs=" + str(runs))
    print("P6B vector=" + str(bestV) + " ms   scalar=" + str(bestS) + " ms")
    print("P6B speedup=" + str(bestS / bestV) + "x")
    print("P6B bit_bad=" + str(bad) + " (0 = 2 duong ra cung ket qua)")
    return 0