# PROBE AQ — phan rach BACKWARD 124M theo PHA (2026-10-20, sau P5.3)
# GHI CHU P5.5 (2026-10-20): TOTAL_bwd tu dong nay la duong SAVES (forward
# tinh trong loss pass, khong forward recompute). So TRUOC P5.5 @1024
# (recompute, sau P5.4): TOTAL_bwd = 103.2 s (FWD_BODY 19.7 s trong do) —
# xem HANDOFF 0.14/0.15.
# Muc dich: chot so phan bo "attention vs KHONG-attention" ma roadmap TRIZ
# (docs/perf-plan-triz-roadmap.md muc 1) ghi la "CHUA DO DUOC".
# Cau hinh: tv/tests/_seq_cfg.txt DONG 1 = seq (dong 2/3 khong dung).
# Chay (tu goc repo):
#   printf "1024\n0\n1\n" > tv/tests/_seq_cfg.txt
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_aq.tkv out/aq.exe main
#   ./out/aq.exe
# GHI CHU:
#   - Moi pha goi TRUC TIEP ham library (khong sao copy code) — chi LHEAD va
#     EMBED_BWD sao tu gpt2_backward vi no nam NGAY trong do (inline).
#   - Tat ca timing o MAIN (bug #8). Best-of reps; reps = 20/3/1 theo seq.
#   - Khong dung gflat (duong library thuan) — chi phi ghi flatten (~1-2s
#     @1024) nam trong do lech "bench bwd vs AQ TOTAL".
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.ops
import tv.training.simd_matmul

CFG = "tv/tests/_seq_cfg.txt"

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> 'list[f32]':
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

def _mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def _mk_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

# ---- LHEAD: sao NGUYEN nhanh simd=1 cua gpt2_backward (lm head bwd) -------
# (logits smm_dot + softmax grad n*50257 + dxf + ggT + dwte GEMM)
def _aq_lhead(xf: "Tensor", wte: "Tensor", ids: 'list[i64]') -> 'f32':
    sx = xf.shape
    n = sx[0]
    logits_t = smm_dot(xf, wte, n, VocabSize, HiddenSize)
    gg = t_zeros([n, VocabSize])
    for i in range(n):
        base = i * VocabSize
        mxf = logits_t.data[base]
        for o in range(1, VocabSize):
            if logits_t.data[base + o] > mxf:
                mxf = logits_t.data[base + o]
        tot = 0.0
        for o in range(VocabSize):
            e = exp(logits_t.data[base + o] - mxf)
            gg.data[base + o] = e
            tot = tot + e
        inv_tot = 1.0 / tot
        inv_n = 1.0 / float(n)
        for o in range(VocabSize):
            ggv = gg.data[base + o] * inv_tot * inv_n
            if o == ids[i]:
                ggv = ggv - inv_n
            gg.data[base + o] = ggv
    dxf = smm_fwd(gg, wte, n, HiddenSize, VocabSize)
    ggT = smm_transpose(gg, n, VocabSize)
    dwte = smm_fwd(ggT, xf, VocabSize, HiddenSize, n)
    chk = 0.0
    for k in range(8):
        chk = chk + dwte.data[k] + dxf.data[k]
    return chk

# ---- EMBED_BWD: 2 op_embed_bwd + cong vao dwte (copy tu gpt2_backward) -----
def _aq_embed_bwd(wte: "Tensor", wpe: "Tensor", ids: 'list[i64]', pos: 'list[i64]',
                  gx: "Tensor") -> 'f32':
    gwte_e = op_embed_bwd(wte, ids, HiddenSize, gx)
    gwpe = op_embed_bwd(wpe, pos, HiddenSize, gx)
    dw2 = t_zeros([VocabSize * HiddenSize])
    for k in range(VocabSize * HiddenSize):
        dw2.data[k] = dw2.data[k] + gwte_e.data[k]
    chk = 0.0
    for k in range(8):
        chk = chk + dw2.data[k] + gwpe.data[k]
    return chk

def main() -> 'i32':
    cfg = load_ints(CFG)
    n = cfg[0]
    ids = _mk_ids(n)
    pos = _mk_pos(n)
    h = HiddenSize
    print("AQ seq=" + str(n) + " layers=" + str(NLayers) + " hidden=" + str(h))

    rf = 1
    if n <= 8:
        rf = 20
    if n > 8:
        if n <= 256:
            rf = 3
    rs = 1
    if n <= 8:
        rs = 3

    ps = gpt2_init(7)

    # ---- tham so 12 tang (ban sao gpt2_backward) ---------------------------
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        b = 4 + li * 12
        ln1_g.append(ps[b + 0])
        ln1_b.append(ps[b + 1])
        wq.append(ps[b + 2])
        bq.append(ps[b + 3])
        wp.append(ps[b + 4])
        bp.append(ps[b + 5])
        ln2_g.append(ps[b + 6])
        ln2_b.append(ps[b + 7])
        w1.append(ps[b + 8])
        b1.append(ps[b + 9])
        w2.append(ps[b + 10])
        b2.append(ps[b + 11])

    # ---- fake grad theo shape (gia tri khong anh huong thoi gian) ----------
    gy = t_zeros([n, h])
    for i in range(n * h):
        gy.data[i] = 0.1
    inner = t_zeros([n * 4 * h])
    for i in range(n * 4 * h):
        inner.data[i] = 0.01 * float(i % 97)
    gyi = t_zeros([n * 4 * h])
    for i in range(n * 4 * h):
        gyi.data[i] = 0.1
    gfw = t_zeros([n * 4 * h])

    # ---- xins (can cho pha block) — KHONG do --------------------------------
    x = gpt2_embed(ids, pos, ps[0], ps[1])
    xins = []
    for li in range(NLayers):
        xins.append(x)
        b = 4 + li * 12
        x = gpt2_block(x, ps[b + 0], ps[b + 1], ps[b + 2], ps[b + 3],
                       ps[b + 4], ps[b + 5], ps[b + 6], ps[b + 7],
                       ps[b + 8], ps[b + 9], ps[b + 10], ps[b + 11], 1)
    xf = x

    # ---- PHA 1: FWD_BODY = embed + 12 block + lnf (khong logits) ----------
    v_fwd = 1.0e18
    k1 = 0
    while k1 < rs:
        t0 = now_ms()
        x2 = gpt2_embed(ids, pos, ps[0], ps[1])
        for li in range(NLayers):
            b = 4 + li * 12
            x2 = gpt2_block(x2, ps[b + 0], ps[b + 1], ps[b + 2], ps[b + 3],
                            ps[b + 4], ps[b + 5], ps[b + 6], ps[b + 7],
                            ps[b + 8], ps[b + 9], ps[b + 10], ps[b + 11], 1)
        xf2 = gpt2_layernorm(x2, ps[2], ps[3])
        t1 = now_ms()
        v_fwd = _mn(v_fwd, t1 - t0)
        k1 = k1 + 1

    # ---- PHA 2: LN_FWD trong block_bwd (24 goi recompute) -----------------
    v_lnf = 1.0e18
    k2 = 0
    while k2 < rf:
        t0 = now_ms()
        for li in range(NLayers):
            b = 4 + li * 12
            aa = gpt2_layernorm(xins[li], ps[b + 0], ps[b + 1])
            mm = gpt2_layernorm(xins[li], ps[b + 6], ps[b + 7])
        t1 = now_ms()
        v_lnf = _mn(v_lnf, t1 - t0)
        k2 = k2 + 1

    # ---- PHA 3: LN_BWD x25 (24 block + lnf) --------------------------------
    v_lnb = 1.0e18
    k3 = 0
    while k3 < rf:
        t0 = now_ms()
        for li in range(NLayers):
            b = 4 + li * 12
            rl1 = gpt2_layernorm_bwd(xins[li], ps[b + 0], ps[b + 1], gy)
            rl2 = gpt2_layernorm_bwd(xins[li], ps[b + 6], ps[b + 7], gy)
        rlf = gpt2_layernorm_bwd(xf, ps[2], ps[3], gy)
        t1 = now_ms()
        v_lnb = _mn(v_lnb, t1 - t0)
        k3 = k3 + 1

    # ---- PHA 4: ATTN_BWD x12 (goin gpt2_attention_bwd, simd=1) -------------
    v_att = 1.0e18
    k4 = 0
    while k4 < rs:
        t0 = now_ms()
        for li in range(NLayers):
            b = 4 + li * 12
            rab = gpt2_attention_bwd(xins[li], ps[b + 2], ps[b + 3],
                                    ps[b + 4], ps[b + 5], n, gy, 1)
        t1 = now_ms()
        v_att = _mn(v_att, t1 - t0)
        k4 = k4 + 1

    # ---- PHA 5: MLP_BWD x12 (goin gpt2_mlp_bwd, simd=1) --------------------
    v_mlp = 1.0e18
    k5 = 0
    while k5 < rs:
        t0 = now_ms()
        for li in range(NLayers):
            b = 4 + li * 12
            rmb = gpt2_mlp_bwd(xins[li], ps[b + 8], ps[b + 9],
                               ps[b + 10], ps[b + 11], n, gy, 1)
        t1 = now_ms()
        v_mlp = _mn(v_mlp, t1 - t0)
        k5 = k5 + 1

    # ---- PHA 6: GELU fwd/bwd rieng (chi ANH HUONG, nam TRONG MLP_BWD) ------
    v_gf = 1.0e18
    k6 = 0
    while k6 < rf:
        t0 = now_ms()
        for li in range(NLayers):
            for i in range(n * 4 * h):
                gfw.data[i] = gelu_erf(inner.data[i])
        t1 = now_ms()
        v_gf = _mn(v_gf, t1 - t0)
        k6 = k6 + 1
    v_gb = 1.0e18
    k6b = 0
    while k6b < rf:
        t0 = now_ms()
        for li in range(NLayers):
            gb = op_gelu_erf_bwd(inner, gyi)
        t1 = now_ms()
        v_gb = _mn(v_gb, t1 - t0)
        k6b = k6b + 1

    # ---- PHA 7: LHEAD (logits + softmax grad + dxf + dwte) ------------------
    v_lh = 1.0e18
    k7 = 0
    while k7 < rs:
        t0 = now_ms()
        chk1 = _aq_lhead(xf, ps[0], ids)
        t1 = now_ms()
        v_lh = _mn(v_lh, t1 - t0)
        k7 = k7 + 1

    # ---- PHA 8: EMBED_BWD --------------------------------------------------
    v_emb = 1.0e18
    k8 = 0
    while k8 < rf:
        t0 = now_ms()
        chk2 = _aq_embed_bwd(ps[0], ps[1], ids, pos, gy)
        t1 = now_ms()
        v_emb = _mn(v_emb, t1 - t0)
        k8 = k8 + 1

    # ---- PHA 9: TOAN BO backward library (gpt2_backward, simd=1) -----------
    # P5.5 (2026-10-20): TRUOC do total do duong RECOMPUTE (backward tinh lai
    # forward). Sau P5.5 duong that = saves (forward tinh trong loss pass,
    # gpt2_forward_saved) -> truyen saves vao day. FWD_BODY van do rieng de
    # doi chieu (gia tri forward_saved = forward + copy activations).
    sv9 = gpt2_forward_saved(ids, pos, ps[0], ps[1],
                             ln1_g, ln1_b, wq, bq, wp, bp,
                             ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], 1)
    v_tot = 1.0e18
    k9 = 0
    while k9 < rs:
        t0 = now_ms()
        tot = gpt2_backward(ids, pos, ps[0], ps[1],
                            ln1_g, ln1_b, wq, bq, wp, bp,
                            ln2_g, ln2_b, w1, b1, w2, b2,
                            ps[2], ps[3], 1, [], sv9)
        t1 = now_ms()
        v_tot = _mn(v_tot, t1 - t0)
        k9 = k9 + 1

    sum_parts = v_fwd + v_lnf + v_lnb + v_att + v_mlp + v_lh + v_emb
    print("AQ FWD_BODY      = " + str(v_fwd) + " ms  (embed+12 block+lnf, khong logits)")
    print("AQ LN_FWD_blk    = " + str(v_lnf) + " ms  (24 goi recompute, nam trong block)")
    print("AQ LN_BWD_x25    = " + str(v_lnb) + " ms")
    print("AQ ATTN_BWD_x12  = " + str(v_att) + " ms")
    print("AQ MLP_BWD_x12   = " + str(v_mlp) + " ms   (gom 4 linear fwd/bwd + gelu fwd/bwd)")
    print("AQ GELU annotation: fwd_x12 = " + str(v_gf) + " ms   bwd_x12 = " + str(v_gb)
          + " ms   (nam TRONG MLP_BWD + FWD_BODY)")
    print("AQ LHEAD_BWD     = " + str(v_lh) + " ms   (logits GEMM + softmax grad + dxf + dwte)")
    print("AQ EMBED_BWD     = " + str(v_emb) + " ms")
    print("AQ SUM_cac_phan  = " + str(sum_parts) + " ms")
    print("AQ TOTAL_bwd     = " + str(v_tot) + " ms   (gpt2_backward library)")
    print("AQ RESIDUAL      = " + str(v_tot - sum_parts)
          + " ms   (block residual adds + grad packing; am = do loi do)")
    print("AQ chk=" + str(chk1) + " " + str(chk2))
    print("AQ done")
    return 0
