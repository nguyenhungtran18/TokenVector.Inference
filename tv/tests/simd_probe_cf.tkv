# PROBE CF — GĐ12 (2026-10-22): LUU MU/RSTD TU FORWARD CHO LN_BWD
# KET LUAN — DO BÁC BỎ, KHÔNG WIRE (2 lam chay, wire thu vao 5 mirror roi revert):
#   - LN_BWD x25: 656-703 (khong saves) -> 578-594 (co saves) = chi 1.10-1.22x
#     (−62..−125ms) — thap hon ke hoach (−215ms, 765-><=550): 2 pass bi bo la
#     2 pass RE (chi doc x, cache-hot); 2 pass con lai (s1/s2 + dx) nang hon nhieu.
#   - SO HOC: saves Tensor chi chua f32 trong khi mu/rstd tinh f64 -> luu vao
#     saves bi lam tron: mu lech 6.79e-10, rstd 2.52e-08 -> MAXDIFF toan bo grad
#     = 3.17e-08 (KHONG phai 0.0 — dieu kien §13.2 bi vo hieu) -> loss in ra
#     doi chu so cuoi: 13.442912 -> 13.442913 (bench A/B 2 binary, deterministic).
#   - Vi dieu kien §13.2 (maxdiff 0.0 HOAC loss khop exact) deu khong dat va loi ich
#     qua nho so voi rui ro format saves -> KHONG WIRE. Duong cu (recompute f64)
#     giu nguyen. PROBE GIU LAI lam bang chung.
#   - DIEU KIEN SONG LAI: compiler ho tro f64 container hoac typed f32 locals
#     (tinh LN toan bo f32 nhu torch -> saved bitwise bang ban recompute) — gan
#     voi huong P7b/native.
# Probe nay TU CHU (copy code LN/bwd can thiet vao trong probe) — chay duoc tren
# ban HEAD da revert (khong goi API saves da bo). Pha 3/4 (maxdiff 148 grad +
# TOTAL_bwd saves-vs-recompute) chi chay duoc KHI wire con tai cho — so do da ghi
# trong HANDOFF §0.33.
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cf.tkv out/cf.exe main
#   ./out/cf.exe
import tv.training.gpt2_ref124
import tv.training.ops
import tv.training.simd_matmul

def _cf_mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _cf_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def _cf_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

# ---- LN fwd + luu mu/rstd (copy NGUYEN VAN gpt2_layernorm + 2 ghi mu/rstd) --
def _cf_ln_saved(x: "Tensor", g: "Tensor", b: "Tensor") -> 'list[Tensor]':
    n = _sh0(x)
    h = _sh1(x)
    out = t_zeros([n, h])
    mus = t_zeros([n])
    rss = t_zeros([n])
    for i in range(n):
        base = i * h
        mu = 0.0
        for j in range(h):
            mu = mu + x.data[base + j]
        mu = mu / float(h)
        v = 0.0
        for j in range(h):
            d = x.data[base + j] - mu
            v = v + d * d
        v = v / float(h)
        rstd = 1.0 / sqrt(v + EPS)
        mus.data[i] = mu
        rss.data[i] = rstd
        for j in range(h):
            out.data[base + j] = (x.data[base + j] - mu) * rstd * g.data[j] + b.data[j]
    return [out, mus, rss]

# ---- LN bwd KHONG saves (copy NGUYEN VAN gpt2_layernorm_bwd) ----------------
def _cf_lnb_none(x: "Tensor", g: "Tensor", b: "Tensor", gy: "Tensor") -> 'list[Tensor]':
    n = _sh0(x)
    h = _sh1(x)
    dx = t_zeros([n, h])
    dg = t_zeros([h])
    db = t_zeros([h])
    for i in range(n):
        base = i * h
        mu = 0.0
        for j in range(h):
            mu = mu + x.data[base + j]
        mu = mu / float(h)
        v = 0.0
        for j in range(h):
            d = x.data[base + j] - mu
            v = v + d * d
        v = v / float(h)
        rstd = 1.0 / sqrt(v + EPS)
        s1 = 0.0
        s2 = 0.0
        for j in range(h):
            xh = (x.data[base + j] - mu) * rstd
            gg = gy.data[base + j] * g.data[j]
            s1 = s1 + gg
            s2 = s2 + gg * xh
        m1 = s1 / float(h)
        m2 = s2 / float(h)
        for j in range(h):
            xh = (x.data[base + j] - mu) * rstd
            gg = gy.data[base + j] * g.data[j]
            dx.data[base + j] = rstd * (gg - m1 - xh * m2)
            dg.data[j] = dg.data[j] + gy.data[base + j] * xh
            db.data[j] = db.data[j] + gy.data[base + j]
    return [dx, dg, db]

# ---- LN bwd CO saves mu/rstd (ban wire GĐ12 — copy NGUYEN VAN) --------------
def _cf_lnb_sav(x: "Tensor", g: "Tensor", b: "Tensor", gy: "Tensor",
                save_mu: "Tensor", save_rs: "Tensor") -> 'list[Tensor]':
    n = _sh0(x)
    h = _sh1(x)
    dx = t_zeros([n, h])
    dg = t_zeros([h])
    db = t_zeros([h])
    for i in range(n):
        base = i * h
        mu = save_mu.data[i]
        rstd = save_rs.data[i]
        s1 = 0.0
        s2 = 0.0
        for j in range(h):
            xh = (x.data[base + j] - mu) * rstd
            gg = gy.data[base + j] * g.data[j]
            s1 = s1 + gg
            s2 = s2 + gg * xh
        m1 = s1 / float(h)
        m2 = s2 / float(h)
        for j in range(h):
            xh = (x.data[base + j] - mu) * rstd
            gg = gy.data[base + j] * g.data[j]
            dx.data[base + j] = rstd * (gg - m1 - xh * m2)
            dg.data[j] = dg.data[j] + gy.data[base + j] * xh
            db.data[j] = db.data[j] + gy.data[base + j]
    return [dx, dg, db]

def main() -> 'i32':
    n = 1024
    ids = _cf_ids(n)
    pos = _cf_pos(n)
    h = HiddenSize
    print("CF seq=" + str(n) + " layers=" + str(NLayers) + " hidden=" + str(h))
    ps = gpt2_init(7)
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        b = 4 + li * 12
        ln1_g.append(ps[b + 0])
        ln1_b.append(ps[b + 1])
        wq.append(ps[b + 2])
        bq.append(ps[b + 3])
        wp.append(ps[b + 4])
        bp.append(ps[b + 5])
        ln2_g.append(ps[b + 6])
        ln2_b.append(ps[b + 7])
        w1.append(ps[b + 8])
        b1.append(ps[b + 9])
        w2.append(ps[b + 10])
        b2.append(ps[b + 11])

    # ---- xins/xf (duong recompute binh thuong) -------------------------------
    x = gpt2_embed(ids, pos, ps[0], ps[1])
    xins = []
    for li in range(NLayers):
        xins.append(x)
        b = 4 + li * 12
        x = gpt2_block(x, ln1_g[li], ln1_b[li], wq[li], bq[li], wp[li], bp[li],
                       ln2_g[li], ln2_b[li], w1[li], b1[li], w2[li], b2[li], 1)
    xf_in = x
    xf = gpt2_layernorm(xf_in, ps[2], ps[3])
    gy = t_zeros([n, h])
    for i in range(n * h):
        gy.data[i] = 0.1 + 0.0001 * float(i % 89)

    # ---- tinh truoc mu/rstd ( nhu forward_saved ) — NGOAI VONG DO -----------
    mu1s = []
    rs1s = []
    mu2s = []
    rs2s = []
    for li in range(NLayers):
        r1 = _cf_ln_saved(xins[li], ln1_g[li], ln1_b[li])
        mu1s.append(r1[1])
        rs1s.append(r1[2])
        # gia tri mu2 chi de DO THOI GIAN (khong can dung luong) -> tinh tu
        # cung dau vao xins cung du; khong anh huong ket qua do luong.
        r2 = _cf_ln_saved(xins[li], ln2_g[li], ln2_b[li])
        mu2s.append(r2[1])
        rs2s.append(r2[2])
    rlf = _cf_ln_saved(xf_in, ps[2], ps[3])
    print("CF precomputed mu/rstd ok")

    # ---- PHA 1: LN_BWD x25 — khong saves vs co saves (2 lan, best) ----------
    v_none = 1.0e18
    k = 0
    while k < 2:
        t0 = now_ms()
        for li in range(NLayers):
            _cf_lnb_none(xins[li], ln1_g[li], ln1_b[li], gy)
            _cf_lnb_none(xins[li], ln2_g[li], ln2_b[li], gy)
        _cf_lnb_none(xf_in, ps[2], ps[3], gy)
        v_none = _cf_mn(v_none, now_ms() - t0)
        k = k + 1
    v_sav = 1.0e18
    k = 0
    while k < 2:
        t0 = now_ms()
        for li in range(NLayers):
            _cf_lnb_sav(xins[li], ln1_g[li], ln1_b[li], gy, mu1s[li], rs1s[li])
            _cf_lnb_sav(xins[li], ln2_g[li], ln2_b[li], gy, mu2s[li], rs2s[li])
        _cf_lnb_sav(xf_in, ps[2], ps[3], gy, rlf[1], rlf[2])
        v_sav = _cf_mn(v_sav, now_ms() - t0)
        k = k + 1
    print("CF LN_BWD x25 khong saves = " + str(v_none) + " ms")
    print("CF LN_BWD x25 co saves    = " + str(v_sav) + " ms  (speed "
          + str(v_none / v_sav) + "x)")

    # ---- PHA 2: maxdiff mu/rstd f64 vs ban luu vao Tensor f32 (lnf, 8 row) --
    # luu truc tiep vao Tensor [n] roi doc lai — cung co dich voi viec append
    # vao saves (Tensor.data = list[f32]).
    mu_max = 0.0
    rs_max = 0.0
    slm = rlf[1]
    slr = rlf[2]
    i = 0
    while i < 8:
        base = i * h
        mu = 0.0
        for j in range(h):
            mu = mu + xf_in.data[base + j]
        mu = mu / float(h)
        v = 0.0
        for j in range(h):
            d = xf_in.data[base + j] - mu
            v = v + d * d
        v = v / float(h)
        rstd = 1.0 / sqrt(v + EPS)
        e1 = slm.data[i] - mu
        if e1 < 0.0:
            e1 = -e1
        e2 = slr.data[i] - rstd
        if e2 < 0.0:
            e2 = -e2
        if e1 > mu_max:
            mu_max = e1
        if e2 > rs_max:
            rs_max = e2
        i = i + 1
    print("CF maxdiff mu_f32_vs_f64 (lnf, 8 row) = " + str(mu_max)
          + "  rstd = " + str(rs_max))
    print("CF done")
    return 0
