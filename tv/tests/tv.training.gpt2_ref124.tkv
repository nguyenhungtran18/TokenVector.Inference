# GPT-2 reference — G2 (ROADMAP_TRAIN.md)
# ---------------------------------------------------
# Kien truc GIONG HF `gpt2`, 124M tham so (de chinh minh thuat toan va train):
#   vocab 50257, n_embd 768, n_head 12, n_layer 12, max_pos 1024
#
# Moi block: ln -> attn(QKV + causal mask + softmax) -> residual
#            -> ln -> mlp(linear -> gelu erf -> linear) -> residual
# Sau block: ln_f -> LM head TIE weight voi wte
#
# LUU Y (numerics-contract.md da duyet):
#   - fp32, GELU erf, dropout = 0 (parity ban dau)
#   - HF dung Conv1D: weight [in, out] (nguoc chieu Linear)
#   - scale attention = 1/sqrt(head_dim), KHONG scale theo tang
#   - softmax attention tinh o fp32
#   - LayerNorm theo MOI ROW (dim = -1), co gain/bias; op core
#     op_layernorm_fwd chi normalize KHONG co g/b nen phai dung
#     gpt2_layernorm rieng duoi day.
#   - QKV layout cua HF: cot [0,h) = Q, [h,2h) = K, [2h,3h) = V;
#     ben trong moi chuong la cac head lien tiep (head*HeadDim).
#
# Cac op deu goi ten PHANG (import da nhap vao pham vi).
# `t.shape[0]` phai qua bien trung gian (quirk cua TokenVector).
# ---------------------------------------------------

import tv.training.ops
import tv.training.simd_matmul

# ---- thong so (khop fixture g2_*) -----------------------------------------
VocabSize = 50257
HiddenSize = 768
NHeads = 12
HeadDim = 64
NLayers = 12
MaxPos = 1024
EPS = 1e-6

# ---- helpers --------------------------------------------------------------
def _sh0(t: "Tensor") -> 'i64':
    s = t.shape
    return s[0]

def _sh1(t: "Tensor") -> 'i64':
    s = t.shape
    return s[1]

def _zeros2(n: 'i64', d: 'i64') -> "Tensor":
    return t_zeros([n, d])

# ---- LayerNorm theo row, co gain/bias (giong nn.LayerNorm cua HF) ---------
def gpt2_layernorm(x: "Tensor", g: "Tensor", b: "Tensor") -> "Tensor":
    n = _sh0(x)
    h = _sh1(x)
    out = t_zeros([n, h])
    # YEU CAU #19 (2026-11-06): native layernorm_fwd — mu/v acc f64,
    # rstd f64, scale f32; rc != 0 -> fallback duong interpreted cu.
    xl = x.data
    gl = g.data
    bl = b.data
    ol = out.data
    rc = layernorm_fwd(xl, gl, bl, ol, n, h)
    if rc == 0:
        return out
    for i in range(n):
        base = i * h
        mu = 0.0
        for j in range(h):
            mu = mu + x.data[base + j]
        mu = mu / float(h)
        v = 0.0
        for j in range(h):
            d = x.data[base + j] - mu
            v = v + d * d
        v = v / float(h)
        rstd = 1.0 / sqrt(v + EPS)
        for j in range(h):
            out.data[base + j] = (x.data[base + j] - mu) * rstd * g.data[j] + b.data[j]
    return out

# ---- Embedding: wte + wpe -------------------------------------------------
def gpt2_embed(ids: 'list[i64]', pos: 'list[i64]', wte: "Tensor", wpe: "Tensor") -> "Tensor":
    n = len(ids)
    tok = op_embed_fwd(wte, ids, HiddenSize)
    p = op_embed_fwd(wpe, pos, HiddenSize)
    out = t_zeros([n, HiddenSize])
    for i in range(n):
        for j in range(HiddenSize):
            out.data[i * HiddenSize + j] = tok.data[i * HiddenSize + j] + p.data[i * HiddenSize + j]
    return out

# ---- Linear (HF Conv1D: weight [in, out]) ---------------------------------
def gpt2_linear(x: "Tensor", w: "Tensor", b: "Tensor", n: 'i64', in_d: 'i64', out_d: 'i64', simd: 'i32' = 0) -> "Tensor":
    if simd == 1:
        # duong SIMD: y[i,o] = sum_k x[i,k]*w[k,o] — smm_fwd chuan
        # (w [in_d hang][out_d cot] dung ngay layout B [k][n]), roi cong bias
        ql2 = x.data
        wl2 = w.data
        bl2 = b.data
        y2 = t_zeros([n, out_d])
        yd2 = y2.data
        il2 = onednn_linear_bias(ql2, wl2, bl2, yd2, n, in_d, out_d)
        if il2 == 0:
            y = y2
            return y
        y = smm_fwd(x, w, n, out_d, in_d)
        yd = y.data
        lbd = b.data
        brc = bias_add_rows(yd, lbd, n, out_d)
        if brc != 0:
            for i in range(n):
                base = i * out_d
                for o in range(out_d):
                    yd[base + o] = yd[base + o] + lbd[o]
        return y
    y = t_zeros([n, out_d])
    for i in range(n):
        for o in range(out_d):
            acc = b.data[o]
            for k in range(in_d):
                acc = acc + x.data[i * in_d + k] * w.data[k * out_d + o]
            y.data[i * out_d + o] = acc
    return y

# ==== P6 GĐ2 (2026-10-21): SONG SONG THEO HEAD — attention FWD simd==1 ====
# Giong P6 GĐ1 (_attn_hb_*): worker tu tinh vao output RIENG, MAIN merge
# (probe BG2: ghi disjoint vao list chung chi 1.24x, list rieng 5.2x).
# Doc qkv read-only; moi head ghi vi tri (t, head, d) duy nhat -> khong
# phu thuoc thu tu -> BIT-EXACT. Worker gemm T=64 < 96 (ghi chu trong
# gpt2_attention) -> gemm_rows_f32 thread-local, khong dung g_job khong lock.
# `hlo >= NHeads` cham nhat cho ban nho (NHeads=4, driver van spawn 12) —
# moi nhom worker la [k, k+1) nen kiem tra hlo la du.
class _AtnFJob:
    qkvl: "list[f32]"
    ctx_out: "list[f32]"
    n: 'i64'
    hlo: 'i64'
    hhi: 'i64'
    inv: 'f64'
    def __init__(self, qkvl: "list[f32]", ctx_out: "list[f32]", n: 'i64', hlo: 'i64', hhi: 'i64', inv: 'f64'):
        self.qkvl = qkvl
        self.ctx_out = ctx_out
        self.n = n
        self.hlo = hlo
        self.hhi = hhi
        self.inv = inv

def _attn_f_one(j: "_AtnFJob") -> 'i64':
    # worker: attention fwd cua head-range [hlo, hhi), doc qkv read-only
    if j.hlo >= NHeads:
        return 0
    h = HiddenSize
    hd = HeadDim
    n = j.n
    inv = j.inv
    for head in range(j.hlo, j.hhi):
        # flash attention fwd (online-softmax, fp32 causal; port thuat toan tu C++
        # kernel ATen BSD-3, KHONG phai PyTorch binary):
        # 1 lenh native thay block smm_dot+softmax_causal_fwd+smm_fwd.
        # rc != 0 -> duong cu NGUYEN VAN ben duoi (fallback).
        ql = j.qkvl
        cel = j.ctx_out
        rc_f = attention_fwd_fused(ql, cel, n, h, hd, head, inv)
        if rc_f == 0:
            continue
        ho = head * hd
        gQ = t_zeros([n, hd])
        gK = t_zeros([n, hd])
        gV = t_zeros([n, hd])
        for t2 in range(n):
            s0 = t2 * 3 * h + ho
            for d in range(hd):
                gQ.data[t2 * hd + d] = j.qkvl[s0 + d]
                gK.data[t2 * hd + d] = j.qkvl[s0 + h + d]
                gV.data[t2 * hd + d] = j.qkvl[s0 + 2 * h + d]
        # Smat[t,u] = dot(Q[t,:], K[u,:]) — giong duong sequential
        Smat = smm_dot(gQ, gK, n, n, hd)
        # scale 1/sqrt(hd) + mask causal + softmax theo hang
        # YEU CAU #13 (2026-11-06): native `softmax_causal_fwd` gop 4 vong
        # (scale+max / exp+tong / normalize / zero-fill) — _am8 bit_bad=0.
        # rc != 0 -> 4 vong interpreted NGUYEN VAN ben duoi (fallback).
        slf = Smat.data
        l13 = softmax_causal_fwd(slf, n, inv)
        if l13 != 0:
            for t2 in range(n):
                b0 = t2 * n
                m0 = Smat.data[b0] * inv
                Smat.data[b0] = m0
                mxv = m0
                for u in range(1, t2 + 1):
                    m0 = Smat.data[b0 + u] * inv
                    Smat.data[b0 + u] = m0
                    if m0 > mxv:
                        mxv = m0
                totv = 0.0
                for u in range(t2 + 1):
                    e = exp(Smat.data[b0 + u] - mxv)
                    Smat.data[b0 + u] = e
                    totv = totv + e
                ivv = 1.0 / totv
                for u in range(t2 + 1):
                    Smat.data[b0 + u] = Smat.data[b0 + u] * ivv
                for u in range(t2 + 1, n):
                    Smat.data[b0 + u] = 0.0
        # ctx[t,:] = sum_u Smat[t,u] * V[u,:]
        gCtx = smm_fwd(Smat, gV, n, hd, n)
        # P6 GĐ5 (probe BN): ghi PACKED [t2*hd+d] — bo 11/12 zero-fill
        for t2 in range(n):
            d0 = t2 * hd
            for d in range(hd):
                j.ctx_out[d0 + d] = gCtx.data[d0 + d]
    return j.hhi - j.hlo

def _attn_f_merge(co: "list[f32]", ct: "list[f32]", n: 'i64', h: 'i64', hd: 'i64', hlo: 'i64', hhi: 'i64') -> 'i64':
    # gop output rieng PACKED (P6 GĐ5: co/[t2*hd]) vao ctxT — gia tri khong
    # doi -> BIT-EXACT. cham NHeads (giong worker).
    if hlo >= NHeads:
        return 0
    for head in range(hlo, hhi):
        ho = head * hd
        for t2 in range(n):
            c0 = t2 * h + ho
            d0 = t2 * hd
            for d in range(hd):
                ct[c0 + d] = co[d0 + d]
    return hhi - hlo

# ---- Attention: multi-head, causal mask, softmax fp32, proj ---------------
# QKV layout: qkv[t, 0:h)=Q, [h,2h)=K, [2h,3h)=V; moi head lien tiep HeadDim.
def gpt2_attention(x: "Tensor", w_qkv: "Tensor", b_qkv: "Tensor",
                   w_proj: "Tensor", b_proj: "Tensor", n: 'i64', simd: 'i32' = 0) -> "Tensor":
    h = HiddenSize
    hd = HeadDim
    qkv = gpt2_linear(x, w_qkv, b_qkv, n, h, 3 * h, simd)
    out = t_zeros([n, h])
    # P5.1 (perf-plan): ctx theo hang [n, h] — duong SIMD lam proj bang GEMM
    # (smm_fwd) thay vong scalar n*h^2 (do: 3970 ms/layer @seq1024). Duong
    # scalar van giu list cuc bo `ctx` => BIT-EXACT nhu truoc.
    ctxT = t_zeros([n, h])
    inv = 1.0 / sqrt(float(hd))
    if simd == 1:
        # P6 GĐ2 (2026-10-21): SONG SONG THEO HEAD — attention FWD.
        # Giong P6 GĐ1 (gpt2_attention_bwd): worker rieng + main merge (BG2:
        # ghi list RIENG 5.2x vs list CHUNG 1.24x); moi head ghi vi tri
        # (t, head, d) doc lap -> khong phu thuoc thu tu -> BIT-EXACT.
        # An toan gemm: Smat = smm_dot(n,n,hd) -> T = min(64, roundup64(n))
        # = 64; gCtx = smm_fwd(n,hd,n) -> T = min(_tilek(n), roundup64(hd))
        # = 64 — ca hai T=64 < 96 -> simd_gemm di gemm_rows_f32 thread-local
        # (bp __declspec(thread)), KHONG dung g_job global khong lock.
        # Proj T >= 96 (g_job) van chay main thread sau join.
        # n < 128: roi vong sequential duoi day — duong cu NGUYEN.
        if n >= 128:
            # P6 GĐ5: buffer PACKED n*hd/worker (bo 11/12 zero-fill)
            co0 = t_zeros([n, hd])
            co1 = t_zeros([n, hd])
            co2 = t_zeros([n, hd])
            co3 = t_zeros([n, hd])
            co4 = t_zeros([n, hd])
            co5 = t_zeros([n, hd])
            co6 = t_zeros([n, hd])
            co7 = t_zeros([n, hd])
            co8 = t_zeros([n, hd])
            co9 = t_zeros([n, hd])
            co10 = t_zeros([n, hd])
            co11 = t_zeros([n, hd])
            hb0 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co0.data, n, 0, 1, inv))
            hb1 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co1.data, n, 1, 2, inv))
            hb2 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co2.data, n, 2, 3, inv))
            hb3 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co3.data, n, 3, 4, inv))
            hb4 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co4.data, n, 4, 5, inv))
            hb5 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co5.data, n, 5, 6, inv))
            hb6 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co6.data, n, 6, 7, inv))
            hb7 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co7.data, n, 7, 8, inv))
            hb8 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co8.data, n, 8, 9, inv))
            hb9 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co9.data, n, 9, 10, inv))
            hb10 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co10.data, n, 10, 11, inv))
            hb11 = thread_spawn(_attn_f_one, _AtnFJob(qkv.data, co11.data, n, 11, 12, inv))
            rb0 = thread_join(hb0)
            rb1 = thread_join(hb1)
            rb2 = thread_join(hb2)
            rb3 = thread_join(hb3)
            rb4 = thread_join(hb4)
            rb5 = thread_join(hb5)
            rb6 = thread_join(hb6)
            rb7 = thread_join(hb7)
            rb8 = thread_join(hb8)
            rb9 = thread_join(hb9)
            rb10 = thread_join(hb10)
            rb11 = thread_join(hb11)
            _attn_f_merge(co0.data, ctxT.data, n, h, hd, 0, 1)
            _attn_f_merge(co1.data, ctxT.data, n, h, hd, 1, 2)
            _attn_f_merge(co2.data, ctxT.data, n, h, hd, 2, 3)
            _attn_f_merge(co3.data, ctxT.data, n, h, hd, 3, 4)
            _attn_f_merge(co4.data, ctxT.data, n, h, hd, 4, 5)
            _attn_f_merge(co5.data, ctxT.data, n, h, hd, 5, 6)
            _attn_f_merge(co6.data, ctxT.data, n, h, hd, 6, 7)
            _attn_f_merge(co7.data, ctxT.data, n, h, hd, 7, 8)
            _attn_f_merge(co8.data, ctxT.data, n, h, hd, 8, 9)
            _attn_f_merge(co9.data, ctxT.data, n, h, hd, 9, 10)
            _attn_f_merge(co10.data, ctxT.data, n, h, hd, 10, 11)
            _attn_f_merge(co11.data, ctxT.data, n, h, hd, 11, 12)
            # P5.1: proj = ctxT @ Wproj (GEMM) + bproj — giong duong sequential
            outg = smm_fwd(ctxT, w_proj, n, h, h)
            ogd = outg.data
            od = out.data
            for i in range(n):
                base = i * h
                for o in range(h):
                    od[base + o] = ogd[base + o] + b_proj.data[o]
            return out
        # ---- P5.2 (perf-plan): score/ctx theo TUNG HEAD bang GEMM --------
        # VONG HEAD PHAI LA NGOAI vong token: moi head tinh DUY NHAT mot lan
        # ma tran n x n -> O(n^2*hd). (Ban draft 2026-10-20 chen no TRONG vong
        # token: moi (t, head) tinh ca ma tran -> O(n^3) va con sai mask.
        # Ban do cung thieu scale 1/sqrt(hd), thieu mask causal, va dung
        # `import math` long trong vong lap.)
        for head in range(NHeads):
            ho = head * hd
            # Q/K/V cua head nay: n x hd (Q [0,h), K [h,2h), V [2h,3h))
            gQ = t_zeros([n, hd])
            gK = t_zeros([n, hd])
            gV = t_zeros([n, hd])
            for t2 in range(n):
                s0 = t2 * 3 * h + ho
                for d in range(hd):
                    gQ.data[t2 * hd + d] = qkv.data[s0 + d]
                    gK.data[t2 * hd + d] = qkv.data[s0 + h + d]
                    gV.data[t2 * hd + d] = qkv.data[s0 + 2 * h + d]
            # Smat[t,u] = dot(Q[t,:], K[u,:]) — ma tran n x n, chua scale
            Smat = smm_dot(gQ, gK, n, n, hd)
            # scale 1/sqrt(hd) + mask causal (u > t) + softmax theo hang.
            # Duong tam giac duoi dat 0 (khong dung -inf): GEMM ctx sau tinh
            # sum_u deu, vi tri u > t co he so 0 -> giong mask.
            # YEU CAU #13 (2026-11-06): native `softmax_causal_fwd` gop 4 vong
            # (scale+max / exp+tong / normalize / zero-fill) — _am8 bit_bad=0.
            # rc != 0 -> 4 vong interpreted NGUYEN VAN ben duoi (fallback).
            slf = Smat.data
            l13 = softmax_causal_fwd(slf, n, inv)
            if l13 != 0:
                for t2 in range(n):
                    b0 = t2 * n
                    m0 = Smat.data[b0] * inv
                    Smat.data[b0] = m0
                    mxv = m0
                    for u in range(1, t2 + 1):
                        m0 = Smat.data[b0 + u] * inv
                        Smat.data[b0 + u] = m0
                        if m0 > mxv:
                            mxv = m0
                    totv = 0.0
                    for u in range(t2 + 1):
                        e = exp(Smat.data[b0 + u] - mxv)
                        Smat.data[b0 + u] = e
                        totv = totv + e
                    ivv = 1.0 / totv
                    for u in range(t2 + 1):
                        Smat.data[b0 + u] = Smat.data[b0 + u] * ivv
                    for u in range(t2 + 1, n):
                        Smat.data[b0 + u] = 0.0
            # ctx[t,:] = sum_u Smat[t,u] * V[u,:]  (n x hd)
            gCtx = smm_fwd(Smat, gV, n, hd, n)
            for t2 in range(n):
                d0 = t2 * hd
                c0 = t2 * h + ho
                for d in range(hd):
                    ctxT.data[c0 + d] = gCtx.data[d0 + d]
        # P5.1: proj = ctxT @ Wproj (GEMM) + bproj
        outg = smm_fwd(ctxT, w_proj, n, h, h)
        ogd = outg.data
        od = out.data
        for i in range(n):
            base = i * h
            for o in range(h):
                od[base + o] = ogd[base + o] + b_proj.data[o]
        return out
    # ---- duong scalar (mac dinh): nguyen ven, BIT-EXACT nhu truoc --------
    for t in range(n):
        # ctx luu ket qua attention cua TAT CA head truoc khi proj
        ctx = []
        for d in range(h):
            ctx.append(0.0)
        for head in range(NHeads):
            ho = head * hd
            # q cua token t tren head nay
            qv = []
            for d in range(hd):
                qv.append(qkv.data[t * 3 * h + ho + d])
            # causal: token t chi thay token u <= t; score theo head_dim
            scores = []
            for u in range(t + 1):
                s = 0.0
                for d in range(hd):
                    s = s + qv[d] * qkv.data[u * 3 * h + h + ho + d]
                scores.append(s * inv)
            mx = scores[0]
            for u in range(1, t + 1):
                if scores[u] > mx:
                    mx = scores[u]
            tot = 0.0
            for u in range(t + 1):
                e = exp(scores[u] - mx)
                scores[u] = e
                tot = tot + e
            inv_tot = 1.0 / tot
            # context = sum_u p[t,u] * v_u (V cua token u, khong phai token t)
            for d in range(hd):
                acc = 0.0
                for u in range(t + 1):
                    acc = acc + scores[u] * qkv.data[u * 3 * h + 2 * h + ho + d]
                ctx[ho + d] = acc * inv_tot
                ctxT.data[t * h + ho + d] = acc * inv_tot
        # project: ctx @ Wproj + bproj (Wproj [h, h])
        for o in range(h):
            acc = b_proj.data[o]
            for r in range(h):
                acc = acc + ctx[r] * w_proj.data[r * h + o]
            out.data[t * h + o] = acc
    return out

# ==== P6 GĐ4 (2026-10-21): GELU erf PARALLEL 12 WORKER (own-seg + merge) ===
# Do probe BM[3]/[4] (BIT=0.0): 3.14M (n=1024) fwd 110 -> 15ms (7.3x),
# bwd 156 -> 31ms (5.0x); 786K (n=256) break-even (15 vs 16ms) -> guard 2M,
# duoi do dung vong serial nguyen ban (gate nho khong doi hanh vi).
# Worker: doc src [lo,hi), ghi vao seg RIENG; main merge vao dst DUNG thu tu
# ptu (dst co the == src: in-place, worker doc xong join moi merge -> an toan).
# KHONG dung nested list (bug compiler — probe BM): merge = _gf_mcopy phang.
class _GfJob:
    sl: "list[f32]"
    seg: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    def __init__(self, sl: "list[f32]", seg: "list[f32]", lo: 'i64', hi: 'i64'):
        self.sl = sl
        self.seg = seg
        self.lo = lo
        self.hi = hi

def _gf_div(a: 'i64', b: 'i64') -> 'i64':
    # chia nhi phan (khong dung '/' cua i64)
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _gf_zeros(n: 'i64') -> 'list[f32]':
    # P9-c style (giong t_zeros): list[f32] * n -> List<f32> native (Array.Copy),
    # thay vong append(0.0) interpreted 3.1M lan/call.
    seed: "list[f32]" = []
    seed.append(0.0)
    return seed * n

def _gf_one(j: "_GfJob") -> 'i64':
    # YEU CAU #19: moi worker 1 doan [lo, hi) -> native gelu_erf_fwd (bit-exact,
    # probe _gff9 bit_bad=0). rc != 0 -> fallback interpreted dung doan nay.
    sl = j.sl
    sg = j.seg
    rc = gelu_erf_fwd(sl, sg, j.lo, j.hi)
    if rc == 0:
        return 0
    k = 0
    i = j.lo
    while i < j.hi:
        j.seg[k] = gelu_erf(j.sl[i])
        k = k + 1
        i = i + 1
    return 0

def _gf_mcopy(dst: 'list[f32]', sg: 'list[f32]', lo: 'i64', cnt: 'i64') -> 'i32':
    for i in range(cnt):
        dst[lo + i] = sg[i]
    return 0

def _gelu_fwd_par(sl: 'list[f32]', dl: 'list[f32]', cnt: 'i64', simd: 'i32') -> 'i32':
    if simd == 0 or cnt < 2000000:
        for i in range(cnt):
            dl[i] = gelu_erf(sl[i])
        return 0
    sz = _gf_div(cnt, 12)
    t0 = _gf_zeros(sz)
    t1 = _gf_zeros(sz)
    t2 = _gf_zeros(sz)
    t3 = _gf_zeros(sz)
    t4 = _gf_zeros(sz)
    t5 = _gf_zeros(sz)
    t6 = _gf_zeros(sz)
    t7 = _gf_zeros(sz)
    t8 = _gf_zeros(sz)
    t9 = _gf_zeros(sz)
    t10 = _gf_zeros(sz)
    t11 = _gf_zeros(cnt - 11 * sz)
    h0 = thread_spawn(_gf_one, _GfJob(sl, t0, 0, sz))
    h1 = thread_spawn(_gf_one, _GfJob(sl, t1, sz, 2 * sz))
    h2 = thread_spawn(_gf_one, _GfJob(sl, t2, 2 * sz, 3 * sz))
    h3 = thread_spawn(_gf_one, _GfJob(sl, t3, 3 * sz, 4 * sz))
    h4 = thread_spawn(_gf_one, _GfJob(sl, t4, 4 * sz, 5 * sz))
    h5 = thread_spawn(_gf_one, _GfJob(sl, t5, 5 * sz, 6 * sz))
    h6 = thread_spawn(_gf_one, _GfJob(sl, t6, 6 * sz, 7 * sz))
    h7 = thread_spawn(_gf_one, _GfJob(sl, t7, 7 * sz, 8 * sz))
    h8 = thread_spawn(_gf_one, _GfJob(sl, t8, 8 * sz, 9 * sz))
    h9 = thread_spawn(_gf_one, _GfJob(sl, t9, 9 * sz, 10 * sz))
    h10 = thread_spawn(_gf_one, _GfJob(sl, t10, 10 * sz, 11 * sz))
    h11 = thread_spawn(_gf_one, _GfJob(sl, t11, 11 * sz, cnt))
    j0 = thread_join(h0)
    j1 = thread_join(h1)
    j2 = thread_join(h2)
    j3 = thread_join(h3)
    j4 = thread_join(h4)
    j5 = thread_join(h5)
    j6 = thread_join(h6)
    j7 = thread_join(h7)
    j8 = thread_join(h8)
    j9 = thread_join(h9)
    j10 = thread_join(h10)
    j11 = thread_join(h11)
    g0 = _gf_mcopy(dl, t0, 0, sz)
    g1 = _gf_mcopy(dl, t1, sz, sz)
    g2 = _gf_mcopy(dl, t2, 2 * sz, sz)
    g3 = _gf_mcopy(dl, t3, 3 * sz, sz)
    g4 = _gf_mcopy(dl, t4, 4 * sz, sz)
    g5 = _gf_mcopy(dl, t5, 5 * sz, sz)
    g6 = _gf_mcopy(dl, t6, 6 * sz, sz)
    g7 = _gf_mcopy(dl, t7, 7 * sz, sz)
    g8 = _gf_mcopy(dl, t8, 8 * sz, sz)
    g9 = _gf_mcopy(dl, t9, 9 * sz, sz)
    g10 = _gf_mcopy(dl, t10, 10 * sz, sz)
    g11 = _gf_mcopy(dl, t11, 11 * sz, cnt - 11 * sz)
    return 0

# ---- MLP: linear -> gelu(erf) -> linear ------------------------------------
def gpt2_mlp(x: "Tensor", w1: "Tensor", b1: "Tensor",
             w2: "Tensor", b2: "Tensor", n: 'i64', simd: 'i32' = 0) -> "Tensor":
    h = HiddenSize
    xd = x.data
    w1d = w1.data
    b1d = b1.data
    inn = t_zeros([n, 4 * h])
    ind = inn.data
    il = onednn_linear_bias_gelu(xd, w1d, b1d, ind, n, h, 4 * h)
    if il == 0:
        return gpt2_linear(inn, w2, b2, n, 4 * h, h, simd)
    inner = gpt2_linear(x, w1, b1, n, h, 4 * h, simd)
    # P6 GĐ4: gelu parallel (guard 2M + simd==1 — probe BM[3]: 7.3x @3.14M)
    gf = _gelu_fwd_par(inner.data, inner.data, n * 4 * h, simd)
    return gpt2_linear(inner, w2, b2, n, 4 * h, h, simd)

# ---- Block: ln -> attn -> add -> ln -> mlp -> add -------------------------
def gpt2_block(x: "Tensor", ln1_g: "Tensor", ln1_b: "Tensor",
               w_qkv: "Tensor", b_qkv: "Tensor", w_proj: "Tensor", b_proj: "Tensor",
               ln2_g: "Tensor", ln2_b: "Tensor",
               w1: "Tensor", b1: "Tensor", w2: "Tensor", b2: "Tensor", simd: 'i32' = 0) -> "Tensor":
    n = _sh0(x)
    h = _sh1(x)
    a = gpt2_layernorm(x, ln1_g, ln1_b)
    a = gpt2_attention(a, w_qkv, b_qkv, w_proj, b_proj, n, simd)
    r = t_zeros([n, h])
    _xl = x.data
    _al = a.data
    _rldc = r.data
    simd_add(_xl, _al, _rldc)
    m = gpt2_layernorm(r, ln2_g, ln2_b)
    m = gpt2_mlp(m, w1, b1, w2, b2, n, simd)
    out = t_zeros([n, h])
    _rl = r.data
    _ml = m.data
    _oldc = out.data
    simd_add(_rl, _ml, _oldc)
    return out

# ---- P5.6 (2026-10-20): block forward + tra them residual r ----------------
# Chi gpt2_forward_saved dung; gpt2_block giu nguyen -> moi caller cu khong doi.
# r = x + attn_out (residual sau attention) — block_bwd can NO de khoi recompute
# ca 1 lan gpt2_attention fwd (~15.4s @seq1024, probe AQ).
def gpt2_block_saved(x: "Tensor", ln1_g: "Tensor", ln1_b: "Tensor",
                     w_qkv: "Tensor", b_qkv: "Tensor", w_proj: "Tensor", b_proj: "Tensor",
                     ln2_g: "Tensor", ln2_b: "Tensor",
                     w1: "Tensor", b1: "Tensor", w2: "Tensor", b2: "Tensor",
                     simd: 'i32' = 0) -> 'list[Tensor]':
    n = _sh0(x)
    h = _sh1(x)
    a_ln = gpt2_layernorm(x, ln1_g, ln1_b)
    a = gpt2_attention(a_ln, w_qkv, b_qkv, w_proj, b_proj, n, simd)
    r = t_zeros([n, h])
    _xl = x.data
    _al = a.data
    _rldc = r.data
    simd_add(_xl, _al, _rldc)
    m_ln = gpt2_layernorm(r, ln2_g, ln2_b)
    # P6 GĐ8 (2026-11-08): dung fused addmm+gelu (1 ATen call, nhu
    # §0.103) thay chain tach roi (~+625ms @seq1024 regression);
    # LUU output gelu `_save_a` cho bwd. inner (pre-gelu) KHONG luu
    # trong saves; bwd recompute inner bang 1 GEMM BLAS.
    _save_a = t_zeros([n, 4 * h])
    _ad = _save_a.data
    _mld = m_ln.data
    _w1d = w1.data
    _b1d = b1.data
    _il = onednn_linear_bias_gelu(_mld, _w1d, _b1d, _ad, n, h, 4 * h)
    if _il == 0:
        m = gpt2_linear(_save_a, w2, b2, n, 4 * h, h, simd)
    else:
        # fallback: duong gpt2_linear + gelu nguyen van (bit giong fwd goc)
        _inn2 = gpt2_linear(m_ln, w1, b1, n, h, 4 * h, simd)
        _gf2 = _gelu_fwd_par(_inn2.data, _ad, n * 4 * h, simd)
        m = gpt2_linear(_save_a, w2, b2, n, 4 * h, h, simd)
    out = t_zeros([n, h])
    _rl = r.data
    _ml = m.data
    _oldc = out.data
    simd_add(_rl, _ml, _oldc)
    # P6 GĐ7 (do BR[3]: LN fwd recompute 24 goi = 359ms @1024 trong
    # block_bwd): LUU luon dau vao LN (a_ln, m_ln) — cung input cung phep
    # voi viec recompute -> BIT-EXACT, bo duoc 24 goi gpt2_layernorm.
    res = []
    res.append(out)
    res.append(r)
    res.append(a_ln)
    res.append(m_ln)
    res.append(_save_a)
    return res

# ---- Full forward: embed -> N block -> ln_f -> LM head (tie wte) ----------
def gpt2_forward(ids: 'list[i64]', pos: 'list[i64]',
                 wte: "Tensor", wpe: "Tensor",
                 ln1_g: 'list[Tensor]', ln1_b: 'list[Tensor]',
                 w_qkv: 'list[Tensor]', b_qkv: 'list[Tensor]',
                 w_proj: 'list[Tensor]', b_proj: 'list[Tensor]',
                 ln2_g: 'list[Tensor]', ln2_b: 'list[Tensor]',
                 w1: 'list[Tensor]', b1: 'list[Tensor]',
                 w2: 'list[Tensor]', b2: 'list[Tensor]',
                 lnf_g: "Tensor", lnf_b: "Tensor", simd: 'i32' = 0,
                 sc5: "list[f32]" = None) -> "Tensor":
    n = len(ids)
    h = HiddenSize
    x = gpt2_embed(ids, pos, wte, wpe)
    for i in range(NLayers):
        x = gpt2_block(x, ln1_g[i], ln1_b[i], w_qkv[i], b_qkv[i], w_proj[i], b_proj[i],
                       ln2_g[i], ln2_b[i], w1[i], b1[i], w2[i], b2[i], simd)
    x = gpt2_layernorm(x, lnf_g, lnf_b)
    # LM head: tie weight voi wte -> logits = x @ wte^T  (wte [vocab, h])
    if simd == 1:
        return smm_dot(x, wte, n, VocabSize, h, sc5)
    logits = t_zeros([n, VocabSize])
    for i in range(n):
        for o in range(VocabSize):
            acc = 0.0
            for k in range(h):
                acc = acc + x.data[i * h + k] * wte.data[o * h + k]
            logits.data[i * VocabSize + o] = acc
    return logits

# ---- P5.5 (2026-10-20): forward + LUU activations cho backward ------------
# Tra ve list[Tensor]:
#   [0] logits (z)  [1] xf (ln_f out)  [2] xf_in (out block cuoi)
#   [3 .. 3+NLayers-1] xins[i] (dau vao block i)
#   [3+NLayers .. 3+2NLayers-1] rs[i] (residual sau attention layer i)  # P5.6
# Dung kem gpt2_backward(..., saves=...) de bo forward recompute (~19.1s
# @seq1024 = 15% bwd, probe AQ) + bo attention fwd recompute trong block_bwd
# (P5.6, ~15.4s). Cung phep voi gpt2_forward -> cung BIT -> grad bit-exact.
def gpt2_forward_saved(ids: 'list[i64]', pos: 'list[i64]',
                       wte: "Tensor", wpe: "Tensor",
                       ln1_g: 'list[Tensor]', ln1_b: 'list[Tensor]',
                       w_qkv: 'list[Tensor]', b_qkv: 'list[Tensor]',
                       w_proj: 'list[Tensor]', b_proj: 'list[Tensor]',
                       ln2_g: 'list[Tensor]', ln2_b: 'list[Tensor]',
                       w1: 'list[Tensor]', b1: 'list[Tensor]',
                       w2: 'list[Tensor]', b2: 'list[Tensor]',
                       lnf_g: "Tensor", lnf_b: "Tensor", simd: 'i32' = 0,
                       sc5: "list[f32]" = None) -> 'list[Tensor]':
    n = len(ids)
    h = HiddenSize
    x = gpt2_embed(ids, pos, wte, wpe)
    xins = []
    rsin = []
    ains = []
    msin = []
    adIns = []
    for i in range(NLayers):
        xins.append(x)
        rb = gpt2_block_saved(x, ln1_g[i], ln1_b[i], w_qkv[i], b_qkv[i], w_proj[i], b_proj[i],
                              ln2_g[i], ln2_b[i], w1[i], b1[i], w2[i], b2[i], simd)
        x = rb[0]
        rsin.append(rb[1])
        ains.append(rb[2])
        msin.append(rb[3])
        adIns.append(rb[4])
    xf_in = x
    xf = gpt2_layernorm(x, lnf_g, lnf_b)
    if simd == 1:
        logits = smm_dot_pd(xf, wte, n, VocabSize, h, sc5)
    else:
        logits = t_zeros([n, VocabSize])
        for i in range(n):
            for o in range(VocabSize):
                acc = 0.0
                for k in range(h):
                    acc = acc + xf.data[i * h + k] * wte.data[o * h + k]
                logits.data[i * VocabSize + o] = acc
    out = []
    out.append(logits)
    out.append(xf)
    out.append(xf_in)
    for i in range(NLayers):
        out.append(xins[i])
    for i in range(NLayers):
        out.append(rsin[i])
    # P6 GĐ7: dau vao LN (a_ln, m_ln) — bo block_bwd phai recompute 24 goi
    # gpt2_layernorm (359ms @1024, do BR[3]). Vi tri CU (xins, rs) NGUYEN ->
    # saves format cu van doc duoc.
    for i in range(NLayers):
        out.append(ains[i])
    for i in range(NLayers):
        out.append(msin[i])
    for i in range(NLayers):
        out.append(adIns[i])
    return out

# ==== P6 GĐ4 (2026-10-21): gpt2_loss PARALLEL 12 WORKER theo ROW ===========
# Do probe BM[2a] (BIT=0.0): n=1024 (51.5M ptu) serial 703-766ms -> PAR12
# 109-187ms (3.9-6.7x); n=256 3-5.5x; n=8 ~ 0ms (guard bo qua).
# Worker: row doc-lap, ghi row-loss vao seg f64 RIENG; main gop DUNG thu tu
# row -> cung phep + thu tu voi serial -> BIT-EXACT. Guard n*V < 4M -> serial.
class _LsJob:
    xl: "list[f32]"
    idl: "list[i64]"
    seg: "list[f64]"
    rlo: 'i64'
    rhi: 'i64'
    def __init__(self, xl: "list[f32]", idl: "list[i64]", seg: "list[f64]",
                  rlo: 'i64', rhi: 'i64'):
        self.xl = xl
        self.idl = idl
        self.seg = seg
        self.rlo = rlo
        self.rhi = rhi

def _ls_div(a: 'i64', b: 'i64') -> 'i64':
    # chia nhi phan (khong dung '/' cua i64)
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _ls_zeros(n: 'i64') -> 'list[f64]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _ls_one(j: "_LsJob") -> 'i64':
    V = VocabSize
    k = 0
    i = j.rlo
    while i < j.rhi:
        base = i * V
        mx = j.xl[base]
        o = 1
        while o < V:
            if j.xl[base + o] > mx:
                mx = j.xl[base + o]
            o = o + 1
        s = 0.0
        o = 0
        while o < V:
            s = s + exp(j.xl[base + o] - mx)
            o = o + 1
        lse = mx + log(s)
        j.seg[k] = lse - j.xl[base + j.idl[i]]
        k = k + 1
        i = i + 1
    return 0

# ---- Cross entropy (F.cross_entropy mean = mean_i(lse_i - logit[i, y_i]))
# NOT op_ce_fwd: op do mask theo TRUC LOAI va chia /cnt — dung cho parity op,
# khong phai cong thuc mean toan bo token cua PyTorch.
def gpt2_loss(logits: "Tensor", ids: 'list[i64]') -> 'f32':
    # P6 GĐ4: parallel 12 worker theo row (probe BM[2a]: 3.9-6.7x, BIT=0.0)
    n = _sh0(logits)
    if n * VocabSize >= 4000000:
        xl = logits.data
        r0 = _ls_div(0 * n, 12)
        r1 = _ls_div(1 * n, 12)
        r2 = _ls_div(2 * n, 12)
        r3 = _ls_div(3 * n, 12)
        r4 = _ls_div(4 * n, 12)
        r5 = _ls_div(5 * n, 12)
        r6 = _ls_div(6 * n, 12)
        r7 = _ls_div(7 * n, 12)
        r8 = _ls_div(8 * n, 12)
        r9 = _ls_div(9 * n, 12)
        r10 = _ls_div(10 * n, 12)
        r11 = _ls_div(11 * n, 12)
        s0 = _ls_zeros(r1 - r0)
        s1 = _ls_zeros(r2 - r1)
        s2 = _ls_zeros(r3 - r2)
        s3 = _ls_zeros(r4 - r3)
        s4 = _ls_zeros(r5 - r4)
        s5 = _ls_zeros(r6 - r5)
        s6 = _ls_zeros(r7 - r6)
        s7 = _ls_zeros(r8 - r7)
        s8 = _ls_zeros(r9 - r8)
        s9 = _ls_zeros(r10 - r9)
        s10 = _ls_zeros(r11 - r10)
        s11 = _ls_zeros(n - r11)
        h0 = thread_spawn(_ls_one, _LsJob(xl, ids, s0, r0, r1))
        h1 = thread_spawn(_ls_one, _LsJob(xl, ids, s1, r1, r2))
        h2 = thread_spawn(_ls_one, _LsJob(xl, ids, s2, r2, r3))
        h3 = thread_spawn(_ls_one, _LsJob(xl, ids, s3, r3, r4))
        h4 = thread_spawn(_ls_one, _LsJob(xl, ids, s4, r4, r5))
        h5 = thread_spawn(_ls_one, _LsJob(xl, ids, s5, r5, r6))
        h6 = thread_spawn(_ls_one, _LsJob(xl, ids, s6, r6, r7))
        h7 = thread_spawn(_ls_one, _LsJob(xl, ids, s7, r7, r8))
        h8 = thread_spawn(_ls_one, _LsJob(xl, ids, s8, r8, r9))
        h9 = thread_spawn(_ls_one, _LsJob(xl, ids, s9, r9, r10))
        h10 = thread_spawn(_ls_one, _LsJob(xl, ids, s10, r10, r11))
        h11 = thread_spawn(_ls_one, _LsJob(xl, ids, s11, r11, n))
        j0 = thread_join(h0)
        j1 = thread_join(h1)
        j2 = thread_join(h2)
        j3 = thread_join(h3)
        j4 = thread_join(h4)
        j5 = thread_join(h5)
        j6 = thread_join(h6)
        j7 = thread_join(h7)
        j8 = thread_join(h8)
        j9 = thread_join(h9)
        j10 = thread_join(h10)
        j11 = thread_join(h11)
        # main gop DUNG thu tu row (cung phep + thu tu voi serial)
        tot = 0.0
        for i2 in range(r1 - r0):
            tot = tot + s0[i2]
        for i2 in range(r2 - r1):
            tot = tot + s1[i2]
        for i2 in range(r3 - r2):
            tot = tot + s2[i2]
        for i2 in range(r4 - r3):
            tot = tot + s3[i2]
        for i2 in range(r5 - r4):
            tot = tot + s4[i2]
        for i2 in range(r6 - r5):
            tot = tot + s5[i2]
        for i2 in range(r7 - r6):
            tot = tot + s6[i2]
        for i2 in range(r8 - r7):
            tot = tot + s7[i2]
        for i2 in range(r9 - r8):
            tot = tot + s8[i2]
        for i2 in range(r10 - r9):
            tot = tot + s9[i2]
        for i2 in range(r11 - r10):
            tot = tot + s10[i2]
        for i2 in range(n - r11):
            tot = tot + s11[i2]
        return tot / float(n)
    tot = 0.0
    for i in range(n):
        base = i * VocabSize
        mx = logits.data[base]
        for o in range(1, VocabSize):
            if logits.data[base + o] > mx:
                mx = logits.data[base + o]
        s = 0.0
        for o in range(VocabSize):
            s = s + exp(logits.data[base + o] - mx)
        lse = mx + log(s)
        tot = tot + (lse - logits.data[base + ids[i]])
    return tot / float(n)

# ============================================================================
#  BACKWARD (G2 gate 2: grad parity so voi torch.autograd)
# ----------------------------------------------------------------------------
#  Nguyen tac: moi ham *_bwd tu TINH LAI forward (recompute) tu dau vao de
#  khong phai luu trung gian — so nho (n=8), dung la quan trong, toc do khong.
#  Cong don gradient theo thu tu co dinh (numerics-contract).
# ----------------------------------------------------------------------------

# [dx, dg, db] — LayerNorm theo row co g/b
def gpt2_layernorm_bwd(x: "Tensor", g: "Tensor", b: "Tensor", gy: "Tensor",
                       gflat: 'list[f32]' = None, o_dg: 'i64' = -1, o_db: 'i64' = -1) -> 'list[Tensor]':
    n = _sh0(x)
    h = _sh1(x)
    dx = t_zeros([n, h])
    dg = t_zeros([h])
    db = t_zeros([h])
    # YEU CAU #12 Ask A1 (2026-11-05): native `layernorm_bwd_fused` — mu/v/
    # rstd/s1/s2 + dx + dg/db ghi thang gflat trong 1 entry (TU /fp:precise).
    # Bit-exact voi vong interpreted (probe _am7: bit_bad=0); rc != 0 -> fallback
    # duong cu NGUYEN VAN (nen gate/loss khong phu thuoc native).
    l12a = -1
    if o_dg >= 0 and o_db >= 0:
        xl = x.data
        gyl = gy.data
        gl = g.data
        dxl = dx.data
        gfl = gflat
        l12a = layernorm_bwd_fused(xl, gyl, gl, dxl, gfl, n, h, o_dg, o_db)
    if l12a != 0:
        for i in range(n):
            base = i * h
            mu = 0.0
            for j in range(h):
                mu = mu + x.data[base + j]
            mu = mu / float(h)
            v = 0.0
            for j in range(h):
                d = x.data[base + j] - mu
                v = v + d * d
            v = v / float(h)
            rstd = 1.0 / sqrt(v + EPS)
            s1 = 0.0
            s2 = 0.0
            for j in range(h):
                xh = (x.data[base + j] - mu) * rstd
                gg = gy.data[base + j] * g.data[j]
                s1 = s1 + gg
                s2 = s2 + gg * xh
            m1 = s1 / float(h)
            m2 = s2 / float(h)
            for j in range(h):
                xh = (x.data[base + j] - mu) * rstd
                gyv: "f32" = gy.data[base + j]
                gg = gyv * g.data[j]
                dx.data[base + j] = rstd * (gg - m1 - xh * m2)
                if o_dg >= 0:
                    gflat[o_dg + j] = gflat[o_dg + j] + gyv * xh
                else:
                    dg.data[j] = dg.data[j] + gyv * xh
                if o_db >= 0:
                    gflat[o_db + j] = gflat[o_db + j] + gyv
                else:
                    db.data[j] = db.data[j] + gyv
    if o_dg >= 0:
        dg = t_zeros([0])
    if o_db >= 0:
        db = t_zeros([0])
    return [dx, dg, db]

# [dx, dw, db] — linear Conv1D: w[in, out]
# P1.1 (perf-plan): gflat/goff — neu goff >= 0 thi dw ghi THANG vao
# gflat[goff + k*out_d + o] (gflat da duoc zero boi caller) thay vi t_zeros +
# acc. Bit-exact: cung phep cong, cung thu tu; gflat = 0 nen 0 + a + b = a + b.
# Khi ghi thang thi tra ve dw placeholder (t_zeros([0])) — chi dung cho
# gpt2_train_step (acc loop len 0 = nop).
def gpt2_linear_bwd(x: "Tensor", w: "Tensor", gy: "Tensor", n: 'i64', in_d: 'i64', out_d: 'i64',
                    simd: 'i32' = 0, gflat: 'list[f32]' = None, goff: 'i64' = -1,
                    dboff: 'i64' = -1) -> 'list[Tensor]':
    if simd == 1:
        # oneDNN bridge (rc==0 -> fallback duong duoi day)
        _xd_x = x.data
        _xd_w = w.data
        _xd_gy = gy.data
        xd_dx = t_zeros([n, in_d])
        xd_dw = t_zeros([in_d, out_d])
        xd_db = t_zeros([out_d])
        _dxdp = xd_dx.data
        _dwdp = xd_dw.data
        _dbdp = xd_db.data
        rlo = onednn_linear_bwd(_xd_x, _xd_gy, _xd_w, _dxdp, _dwdp, _dbdp, n, in_d, out_d)
        if rlo == 0:
            if goff >= 0:
                wl4 = xd_dw.data
                for k in range(in_d * out_d):
                    gflat[goff + k] = gflat[goff + k] + wl4[k]
            if dboff >= 0:
                bl4 = xd_db.data
                for o in range(out_d):
                    gflat[dboff + o] = gflat[dboff + o] + bl4[o]
            if goff < 0:
                dw = xd_dw
            else:
                dw = t_zeros([0])
            if dboff < 0:
                db = xd_db
            else:
                db = t_zeros([0])
            return [xd_dx, dw, db]
        # Fallback duong cu NGUYEN VAN duoi day.
        dx = t_zeros([n, in_d])
        # YEU CAU #10 Ask B (2026-11-01): native `linear_dx_fused` (1 entry) thay
        # `smm_dot` — SgemmFull tinh DAY DU 256 hang nhung chi hang < m duoc cong
        # vao dx -> 248/256 hang thua = 32x phep nhan. Probe _am6: bit_bad=0 tren
        # shape that; k<256 / m>256 / m le 4 / k le 256 -> rc != 0 -> fallback
        # `smm_dot` NGUYEN VAN (loss EXACT khong phu thuoc native).
        dx = t_zeros([n, in_d])
        l10b = -1
        _gy10 = gy.data
        _w10 = w.data
        _dx10 = dx.data
        l10b = linear_dx_fused(_gy10, _w10, _dx10, n, in_d, out_d)
        if l10b != 0:
            dx = smm_dot(gy, w, n, in_d, out_d)
        # P5.4 (2026-10-20): dw = x^T . gy TRUC TIEP [in_d][out_d].
        # P6 GĐ6 (2026-10-21, probe BP[1a/b] maxdiff 0.0): smm_fwd_at doc x
        # truc tiep (x luu [k=n hang][m=in_d cot] = dang A^T cho trans-A) —
        # bo luon phep smm_transpose (BO: xT2 94 + xT1 15 ms/layer MLP +
        # xT h*n trong attn): dw 234 -> 157 ms (r2 shape), 141 -> 125 (r1).
        # Thu tu tich luy p0 tang dan NGUYEN -> BIT-EXACT (P5.8 AX + BP).
        # YEU CAU #10 Ask A (2026-11-01): native `linear_dw_fused` (true-k, ghi
        # thang gflat) thay `smm_fwd_at` + vong copy dw -> gflat. Probe _am5:
        # bit_bad=0 tren 4 shape that; k>64 / out_d le -> rc != 0 -> fallback
        # duong cu NGUYEN VAN (nen loss EXACT khong phu thuoc native).
        dw = t_zeros([0])
        l10 = -1
        if goff >= 0:
            _x10 = x.data
            _y10 = gy.data
            _g10 = gflat
            l10 = linear_dw_fused(_x10, _y10, _g10, goff, n, in_d, out_d)
            if l10 != 0:
                l10 = linear_dw_at_fused(_x10, _y10, _g10, goff, n, in_d, out_d, 0)
        if l10 != 0:
            dw = smm_fwd_at(x, gy, in_d, out_d, n)
        db = t_zeros([out_d])
        # YEU CAU #12 Ask A4: native `bias_grad` — gflat[dboff + o] (hoac
        # db.data) += sum_i gy[i,o] theo thu tu i NGUYEN (AVX2 8 lane moi
        # lane = 1 cot) -> bit-exact. rc != 0 -> fallback vong cu NGUYEN VAN.
        l10c = -1

        if dboff >= 0:

            gyl = gy.data

            gfl = gflat

            l10c = bias_grad(gyl, gfl, dboff, n, out_d)

        else:

            gyl = gy.data

            gfl = db.data

            l10c = bias_grad(gyl, gfl, 0, n, out_d)
        if l10c != 0:
            for i in range(n):
                base = i * out_d
                for o in range(out_d):
                    if dboff >= 0:
                        gflat[dboff + o] = gflat[dboff + o] + gy.data[base + o]
                    else:
                        db.data[o] = db.data[o] + gy.data[base + o]
        r = []
        r.append(dx)
        if goff >= 0:
            if l10 != 0:
                for k in range(in_d * out_d):
                    gflat[goff + k] = gflat[goff + k] + dw.data[k]
            r.append(t_zeros([0]))
        else:
            r.append(dw)
        if dboff >= 0:
            r.append(t_zeros([0]))
        else:
            r.append(db)
        return r
    dx = t_zeros([n, in_d])
    dw = t_zeros([in_d, out_d])
    db = t_zeros([out_d])
    if goff >= 0 or dboff >= 0:
        # vong ghi thang (copy tu vong cu — chi doi cho dw/db)
        # YEU CAU #12 Ask A4: bias tinh truoc bang native `bias_grad` (thu tu
        # i nguyen moi cot -> bit-exact); rc != 0 -> tinh trong vong nhu cu.
        l10d = -1

        if dboff >= 0:

            gyl = gy.data

            gfl = gflat

            l10d = bias_grad(gyl, gfl, dboff, n, out_d)

        else:

            gyl = gy.data

            gfl = db.data

            l10d = bias_grad(gyl, gfl, 0, n, out_d)
        for i in range(n):
            for o in range(out_d):
                gg = gy.data[i * out_d + o]
                if l10d != 0:
                    if dboff >= 0:
                        gflat[dboff + o] = gflat[dboff + o] + gg
                    else:
                        db.data[o] = db.data[o] + gg
                for k in range(in_d):
                    if goff >= 0:
                        gflat[goff + k * out_d + o] = gflat[goff + k * out_d + o] + x.data[i * in_d + k] * gg
                    else:
                        dw.data[k * out_d + o] = dw.data[k * out_d + o] + x.data[i * in_d + k] * gg
                    dx.data[i * in_d + k] = dx.data[i * in_d + k] + gg * w.data[k * out_d + o]
        rdw = t_zeros([0])
        if goff < 0:
            rdw = dw
        rdb = t_zeros([0])
        if dboff < 0:
            rdb = db
        return [dx, rdw, rdb]
    for i in range(n):
        for o in range(out_d):
            gg = gy.data[i * out_d + o]
            db.data[o] = db.data[o] + gg
            for k in range(in_d):
                dw.data[k * out_d + o] = dw.data[k * out_d + o] + x.data[i * in_d + k] * gg
                dx.data[i * in_d + k] = dx.data[i * in_d + k] + gg * w.data[k * out_d + o]
    return [dx, dw, db]

# [dx, dw_qkv, db_qkv, dw_proj, db_proj] — MHA causal (recompute softmax)
# P1.1: gflat + o_qkv/o_proj — ghi thang dw_qkv (qua linear_bwd) + dw_proj.
# ==== P6 (2026-10-21): SONG SONG THEO HEAD — attention_bwd simd==1 ====
# Boi toan (probe BF/BG/BG2): thread_spawn/join qua record (field list[f32])
# bit-exact; NHUNG ghi vao list CHUNG tu nhieu worker chi 1.24x (chanh ghi),
# moi worker list RIENG = 5.2x -> worker tu tinh vao output rieng, MAIN gop.
# An toan: moi head ghi vi tri (t, head, d) DUY NHAT, khong tich luy chéo
# -> ket qua khong phu thuoc thu tu head -> BIT-EXACT. Worker gemm deu
# T=64 < 96 -> simd_gemm di truc tiep gemm_rows_f32 (bp __declspec(thread))
#, KHONG dung g_job global (khong co lock) -> an toan khi goi dong thieu.
class _AtnJob:
    qkvl: "list[f32]"
    dctxl: "list[f32]"
    ctx_out: "list[f32]"
    dq_out: "list[f32]"
    n: 'i64'
    hlo: 'i64'
    hhi: 'i64'
    inv: 'f64'
    def __init__(self, qkvl: "list[f32]", dctxl: "list[f32]", ctx_out: "list[f32]", dq_out: "list[f32]", n: 'i64', hlo: 'i64', hhi: 'i64', inv: 'f64'):
        self.qkvl = qkvl
        self.dctxl = dctxl
        self.ctx_out = ctx_out
        self.dq_out = dq_out
        self.n = n
        self.hlo = hlo
        self.hhi = hhi
        self.inv = inv

def _attn_hb_zlist(sz: 'i64') -> "list[f32]":
    tt = t_zeros([sz])
    return tt.data

def _attn_hb_one_ref(j: "_AtnJob", head: 'i64') -> 'i64':
    # FALLBACK NGUYEN VAN (YEU CAU #14): moi head = mot lan goi, giu nguyen
    # tung vong / tung GEMM / thu tu tich luy nhu truoc (BIT-EXACT).
    h = HiddenSize
    hd = HeadDim
    n = j.n
    inv = j.inv
    ho = head * hd
    gQ = t_zeros([n, hd])
    gK = t_zeros([n, hd])
    gV = t_zeros([n, hd])
    gDc = t_zeros([n, hd])
    for t2 in range(n):
        s0 = t2 * 3 * h + ho
        c0 = t2 * h + ho
        for d in range(hd):
            gQ.data[t2 * hd + d] = j.qkvl[s0 + d]
            gK.data[t2 * hd + d] = j.qkvl[s0 + h + d]
            gV.data[t2 * hd + d] = j.qkvl[s0 + 2 * h + d]
            gDc.data[t2 * hd + d] = j.dctxl[c0 + d]
    # P = softmax causal (cach tinh giong draft forward)
    Smat = smm_dot(gQ, gK, n, n, hd)
    # YEU CAU #13 (2026-11-06): native `softmax_causal_fwd` gop 4 vong
    # (scale+max / exp+tong / normalize / zero-fill) — _am8 bit_bad=0.
    # rc != 0 -> 4 vong interpreted NGUYEN VAN ben duoi (fallback).
    slf = Smat.data
    l13 = softmax_causal_fwd(slf, n, inv)
    if l13 != 0:
        for t2 in range(n):
            b0 = t2 * n
            m0 = Smat.data[b0] * inv
            Smat.data[b0] = m0
            mxv = m0
            for u in range(1, t2 + 1):
                m0 = Smat.data[b0 + u] * inv
                Smat.data[b0 + u] = m0
                if m0 > mxv:
                    mxv = m0
            totv = 0.0
            for u in range(t2 + 1):
                e = exp(Smat.data[b0 + u] - mxv)
                Smat.data[b0 + u] = e
                totv = totv + e
            ivv = 1.0 / totv
            for u in range(t2 + 1):
                Smat.data[b0 + u] = Smat.data[b0 + u] * ivv
            for u in range(t2 + 1, n):
                Smat.data[b0 + u] = 0.0
            
# ctx_head[t,:] = sum_u P[t,u]*V[u,:] — can cho dot + dw_proj
    gCtx = smm_fwd(Smat, gV, n, hd, n)
    # P6 GĐ5 (probe BN): ghi PACKED theo head [t2*hd+d] — buffer rieng
    # n*hd/worker (truoc do n*h voi 11/12 phan bi zero-fill lan merge)
    for t2 in range(n):
        d0 = t2 * hd
        for d in range(hd):
            j.ctx_out[d0 + d] = gCtx.data[d0 + d]
    # dp[t,u] = sum_d dctx[t,d] * V[u,d]  -> smm_dot
    gDp = smm_dot(gDc, gV, n, n, hd)
    # ds[t,u] = P[t,u] * (dp[t,u] - dot[t]); u > t = 0
    # YEU CAU #12 Ask A3 (2026-11-05): native `softmax_causal_bwd` ghi
    # IN-PLACE vao gDp (dotv tich f64, causal mask giu nguyen) -> bo cap
    # phat gDs n*n + vong interpreted. rc != 0 -> duong cu NGUYEN VAN.
    dpl = gDp.data

    pl = Smat.data

    dcl = gDc.data

    cl = gCtx.data

    l12b = softmax_causal_bwd(dpl, pl, dcl, cl, n, hd)
    gDs = gDp
    if l12b != 0:
        gDs = t_zeros([n, n])
        for t2 in range(n):
            b0 = t2 * n
            d0 = t2 * hd
            dotv = 0.0
            for d in range(hd):
                dotv = dotv + gDc.data[d0 + d] * gCtx.data[d0 + d]
            for u in range(t2 + 1):
                gDs.data[b0 + u] = Smat.data[b0 + u] * (gDp.data[b0 + u] - dotv)
            for u in range(t2 + 1, n):
                gDs.data[b0 + u] = 0.0
    # dq[t,d] = inv * sum_u ds[t,u] * K[u,d]
    gDq = smm_fwd(gDs, gK, n, hd, n)
    # P5.4 (2026-10-20, do PROBE AR): BO 2 transpose n x n (1M phan
    # tu/head — 672 ms/layer @seq1024 = 16% attention_bwd). Tinh dk/dv
    # bang chuyen vi NHO cua Q/dctx (n x hd = 65K) roi doc STRIDED khi
    # writeback:
    #   dkT[d,u] = sum_t Q[t,d] * ds[t,u]    = (Q^T . ds)[d,u]
    #   dvT[d,u] = sum_t dctx[t,d] * P[t,u]  = (dctx^T . P)[d,u]
    # Cung tich lep theo t TANG DAN (p-tile ascending) -> BIT-EXACT.
    # P6 GĐ6: smm_fwd_at (T=64<96 — worker van an toan nhu smm_fwd
    # truoc do; bit-exact nhu linear_bwd) — bo 2 transpose nho
    gDkT = smm_fwd_at(gQ, gDs, hd, n, n)
    gDvT = smm_fwd_at(gDc, Smat, hd, n, n)
    # dong bo vao dqkv — vi tri (t, head, d) la duy nhat -> '=' duoc
    for t2 in range(n):
        d0 = t2 * hd
        p0 = t2 * 3 * hd
        for d in range(hd):
            j.dq_out[p0 + d] = gDq.data[d0 + d] * inv
            # gDkT/gDvT luu [d hang][t cot] -> doc strided [d*n + t2]
            j.dq_out[p0 + hd + d] = gDkT.data[d * n + t2] * inv
            j.dq_out[p0 + 2 * hd + d] = gDvT.data[d * n + t2]
    return 0


def _attn_hb_one(j: "_AtnJob") -> 'i64':
    # worker: head-range [hlo, hhi) doc qkv/dctx read-only, ghi rieng
    # YEU CAU #14 (2026-11-06): attention_bwd_fused gop 6 GEMM + softmax
    # fwd/bwd + writeback packed thanh 1 lenh goi native; rc != 0 ->
    # fallback _attn_hb_one_ref (kernel tu choi shape / list thieu).
    if j.hlo >= NHeads:
        return 0
    h = HiddenSize
    hd = HeadDim
    n = j.n
    inv = j.inv
    for head in range(j.hlo, j.hhi):
        ql = j.qkvl
        dcl = j.dctxl
        cel = j.ctx_out
        dql = j.dq_out
        rc14 = attention_bwd_fused(ql, dcl, cel, dql, n, h, hd, head, inv)
        if rc14 != 0:
            _attn_hb_one_ref(j, head)
    return j.hhi - j.hlo


def _attn_hb_merge(co: "list[f32]", qo: "list[f32]", ct: "list[f32]", dq: "list[f32]", n: 'i64', h: 'i64', hd: 'i64', hlo: 'i64', hhi: 'i64') -> 'i64':
    # gop output rieng PACKED (P6 GĐ5: co/[t2*hd], qo/[t2*3*hd]) vao
    # ctxT/dqkv theo vi tri (t, head, d) — gia tri khong doi -> BIT-EXACT.
    # P6 GĐ2: cham NHeads (giong _attn_hb_one) — doc/ghi ngoai hang ban nho.
    if hlo >= NHeads:
        return 0
    for head in range(hlo, hhi):
        ho = head * hd
        for t2 in range(n):
            c0 = t2 * h + ho
            p0 = t2 * 3 * hd
            r0 = t2 * 3 * h + ho
            for d in range(hd):
                ct[c0 + d] = co[t2 * hd + d]
                dq[r0 + d] = qo[p0 + d]
                dq[r0 + h + d] = qo[p0 + hd + d]
                dq[r0 + 2 * h + d] = qo[p0 + 2 * hd + d]
    return hhi - hlo
def gpt2_attention_bwd(x: "Tensor", w_qkv: "Tensor", b_qkv: "Tensor",
                       w_proj: "Tensor", b_proj: "Tensor", n: 'i64', gout: "Tensor", simd: 'i32' = 0,
                       gflat: 'list[f32]' = None, o_qkv: "i64" = -1, o_bqkv: "i64" = -1,
                       o_proj: "i64" = -1, o_bproj: "i64" = -1) -> 'list[Tensor]':
    h = HiddenSize
    hd = HeadDim
    qkv = gpt2_linear(x, w_qkv, b_qkv, n, h, 3 * h, simd)
    inv = 1.0 / sqrt(float(hd))
    dqkv = t_zeros([n, 3 * h])
    dw_proj = t_zeros([h, h])
    db_proj = t_zeros([h])
    # P5.1 (perf-plan): dctx theo hang [n, h] + ctx theo hang [n, h] (cho
    # dw_proj GEMM). Duong scalar van giu list cuc bo => BIT-EXACT nhu truoc.
    ctxT = t_zeros([n, h])
    dctxT = t_zeros([n, h])
    if simd == 1:
        # dctx[t,r] = sum_o gout[t,o]*w_proj[r,o] -> smm_dot (thay vong n*h^2)
        dctxT = smm_dot(gout, w_proj, n, h, h)
        # ---- P5.3 (perf-plan): dp/ds/dqkv theo TUNG HEAD bang GEMM -------
        # Cong thuc (identical vs duong scalar, chi thu tu tich luy khac):
        #   P[t,u]   = softmax causal cua inv * Q[t].K[u]      (u > t -> 0)
        #   dp[t,u]  = sum_d dctx[t,d] * V[u,d]
        #   dot[t]   = sum_u P[t,u]*dp[t,u] = sum_d dctx[t,d]*ctx[t,d]
        #   ds[t,u]  = P[t,u] * (dp[t,u] - dot[t])
        #   dq = inv * ds . K  |  dk = inv * ds^T . Q  |  dv = P^T . dctx
        # Ban draft 2026-10-20 khong chay duoc: doc `sc.data` tren mot list
        # cuc bo (list khong co .data), truyen dctxT [n,h] vao smm_dot voi
        # k = hd (sai bo tri), dao chu/dk, va khong tinh dw_proj/db_proj nua.
        # Vong head LA NGOAI vong token -> moi head mot lan n x n, O(n^2*hd).
        # P6 (2026-10-21): SONG SONG 12 HEAD — worker rieng, main gop (xem
        # ghi chu P6 truoc gpt2_attention_bwd). n nho (<128) giu duong cu.
        if n < 128:
            # YEU CAU #10 Ask C.2 (2026-11-01): cache 5 scratch cua 12 head —
            # truoc do 5 t_zeros/head = 60 cap phat/moi goi (4.39 ms bucket).
            # Moi head GHI DAY DU truoc khi doc -> hoist ra ngoai vong khong doi
            # 1 phep tinh nao -> BIT-EXACT.
            gQ = t_zeros([n, hd])
            gK = t_zeros([n, hd])
            gV = t_zeros([n, hd])
            gDc = t_zeros([n, hd])
            gDs = t_zeros([n, n])
            for head in range(NHeads):
                ho = head * hd
                for t2 in range(n):
                    s0 = t2 * 3 * h + ho
                    c0 = t2 * h + ho
                    for d in range(hd):
                        gQ.data[t2 * hd + d] = qkv.data[s0 + d]
                        gK.data[t2 * hd + d] = qkv.data[s0 + h + d]
                        gV.data[t2 * hd + d] = qkv.data[s0 + 2 * h + d]
                        gDc.data[t2 * hd + d] = dctxT.data[c0 + d]
                # P = softmax causal (cach tinh giong draft forward)
                Smat = smm_dot(gQ, gK, n, n, hd)
                # YEU CAU #13 (2026-11-06): native `softmax_causal_fwd` gop 4 vong
                # (scale+max / exp+tong / normalize / zero-fill) — _am8 bit_bad=0.
                # rc != 0 -> 4 vong interpreted NGUYEN VAN ben duoi (fallback).
                slf = Smat.data
                l13 = softmax_causal_fwd(slf, n, inv)
                if l13 != 0:
                    for t2 in range(n):
                        b0 = t2 * n
                        m0 = Smat.data[b0] * inv
                        Smat.data[b0] = m0
                        mxv = m0
                        for u in range(1, t2 + 1):
                            m0 = Smat.data[b0 + u] * inv
                            Smat.data[b0 + u] = m0
                            if m0 > mxv:
                                mxv = m0
                        totv = 0.0
                        for u in range(t2 + 1):
                            e = exp(Smat.data[b0 + u] - mxv)
                            Smat.data[b0 + u] = e
                            totv = totv + e
                        ivv = 1.0 / totv
                        for u in range(t2 + 1):
                            Smat.data[b0 + u] = Smat.data[b0 + u] * ivv
                        for u in range(t2 + 1, n):
                            Smat.data[b0 + u] = 0.0
                    
# ctx_head[t,:] = sum_u P[t,u]*V[u,:] — can cho dot + dw_proj
                gCtx = smm_fwd(Smat, gV, n, hd, n)
                for t2 in range(n):
                    d0 = t2 * hd
                    c0 = t2 * h + ho
                    for d in range(hd):
                        ctxT.data[c0 + d] = gCtx.data[d0 + d]
                # dp[t,u] = sum_d dctx[t,d] * V[u,d]  -> smm_dot
                gDp = smm_dot(gDc, gV, n, n, hd)
                # ds[t,u] = P[t,u] * (dp[t,u] - dot[t]); u > t = 0
                # YEU CAU #12 Ask A3: native `softmax_causal_bwd` ghi IN-PLACE
                # vao gDp (gDs = gDp) — bo vong interpreted; rc != 0 -> vong cu.
                dpl = gDp.data

                pl = Smat.data

                dcl = gDc.data

                cl = gCtx.data

                l12c = softmax_causal_bwd(dpl, pl, dcl, cl, n, hd)
                gDs = gDp
                if l12c != 0:
                    gDs = t_zeros([n, n])
                    for t2 in range(n):
                        b0 = t2 * n
                        d0 = t2 * hd
                        dotv = 0.0
                        for d in range(hd):
                            dotv = dotv + gDc.data[d0 + d] * gCtx.data[d0 + d]
                        for u in range(t2 + 1):
                            gDs.data[b0 + u] = Smat.data[b0 + u] * (gDp.data[b0 + u] - dotv)
                        for u in range(t2 + 1, n):
                            gDs.data[b0 + u] = 0.0
                # dq[t,d] = inv * sum_u ds[t,u] * K[u,d]
                gDq = smm_fwd(gDs, gK, n, hd, n)
                # P5.4 (2026-10-20, do PROBE AR): BO 2 transpose n x n (1M phan
                # tu/head — 672 ms/layer @seq1024 = 16% attention_bwd). Tinh dk/dv
                # bang chuyen vi NHO cua Q/dctx (n x hd = 65K) roi doc STRIDED khi
                # writeback:
                #   dkT[d,u] = sum_t Q[t,d] * ds[t,u]    = (Q^T . ds)[d,u]
                #   dvT[d,u] = sum_t dctx[t,d] * P[t,u]  = (dctx^T . P)[d,u]
                # Cung tich lep theo t TANG DAN (p-tile ascending) -> BIT-EXACT.
                gQt = smm_transpose(gQ, n, hd)
                gDkT = smm_fwd(gQt, gDs, hd, n, n)
                gDcT = smm_transpose(gDc, n, hd)
                gDvT = smm_fwd(gDcT, Smat, hd, n, n)
                # dong bo vao dqkv — vi tri (t, head, d) la duy nhat -> '=' duoc
                for t2 in range(n):
                    d0 = t2 * hd
                    r0 = t2 * 3 * h + ho
                    for d in range(hd):
                        dqkv.data[r0 + d] = gDq.data[d0 + d] * inv
                        # gDkT/gDvT luu [d hang][t cot] -> doc strided [d*n + t2]
                        dqkv.data[r0 + h + d] = gDkT.data[d * n + t2] * inv
                        dqkv.data[r0 + 2 * h + d] = gDvT.data[d * n + t2]
        else:
            # P6 GĐ5 (probe BN): buffer PACKED n*hd (ctx) + n*3*hd (dq)
            # per worker — bo ~330ms/layer zero-fill (37.2M -> 3.15M ptu)
            ctxo0 = _attn_hb_zlist(n * hd)
            ctxo1 = _attn_hb_zlist(n * hd)
            ctxo2 = _attn_hb_zlist(n * hd)
            ctxo3 = _attn_hb_zlist(n * hd)
            ctxo4 = _attn_hb_zlist(n * hd)
            ctxo5 = _attn_hb_zlist(n * hd)
            ctxo6 = _attn_hb_zlist(n * hd)
            ctxo7 = _attn_hb_zlist(n * hd)
            ctxo8 = _attn_hb_zlist(n * hd)
            ctxo9 = _attn_hb_zlist(n * hd)
            ctxo10 = _attn_hb_zlist(n * hd)
            ctxo11 = _attn_hb_zlist(n * hd)
            dqo0 = _attn_hb_zlist(n * 3 * hd)
            dqo1 = _attn_hb_zlist(n * 3 * hd)
            dqo2 = _attn_hb_zlist(n * 3 * hd)
            dqo3 = _attn_hb_zlist(n * 3 * hd)
            dqo4 = _attn_hb_zlist(n * 3 * hd)
            dqo5 = _attn_hb_zlist(n * 3 * hd)
            dqo6 = _attn_hb_zlist(n * 3 * hd)
            dqo7 = _attn_hb_zlist(n * 3 * hd)
            dqo8 = _attn_hb_zlist(n * 3 * hd)
            dqo9 = _attn_hb_zlist(n * 3 * hd)
            dqo10 = _attn_hb_zlist(n * 3 * hd)
            dqo11 = _attn_hb_zlist(n * 3 * hd)
            hb0 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo0, dqo0, n, 0, 1, inv))
            hb1 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo1, dqo1, n, 1, 2, inv))
            hb2 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo2, dqo2, n, 2, 3, inv))
            hb3 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo3, dqo3, n, 3, 4, inv))
            hb4 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo4, dqo4, n, 4, 5, inv))
            hb5 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo5, dqo5, n, 5, 6, inv))
            hb6 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo6, dqo6, n, 6, 7, inv))
            hb7 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo7, dqo7, n, 7, 8, inv))
            hb8 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo8, dqo8, n, 8, 9, inv))
            hb9 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo9, dqo9, n, 9, 10, inv))
            hb10 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo10, dqo10, n, 10, 11, inv))
            hb11 = thread_spawn(_attn_hb_one, _AtnJob(qkv.data, dctxT.data, ctxo11, dqo11, n, 11, 12, inv))
            rb0 = thread_join(hb0)
            rb1 = thread_join(hb1)
            rb2 = thread_join(hb2)
            rb3 = thread_join(hb3)
            rb4 = thread_join(hb4)
            rb5 = thread_join(hb5)
            rb6 = thread_join(hb6)
            rb7 = thread_join(hb7)
            rb8 = thread_join(hb8)
            rb9 = thread_join(hb9)
            rb10 = thread_join(hb10)
            rb11 = thread_join(hb11)
            _attn_hb_merge(ctxo0, dqo0, ctxT.data, dqkv.data, n, h, hd, 0, 1)
            _attn_hb_merge(ctxo1, dqo1, ctxT.data, dqkv.data, n, h, hd, 1, 2)
            _attn_hb_merge(ctxo2, dqo2, ctxT.data, dqkv.data, n, h, hd, 2, 3)
            _attn_hb_merge(ctxo3, dqo3, ctxT.data, dqkv.data, n, h, hd, 3, 4)
            _attn_hb_merge(ctxo4, dqo4, ctxT.data, dqkv.data, n, h, hd, 4, 5)
            _attn_hb_merge(ctxo5, dqo5, ctxT.data, dqkv.data, n, h, hd, 5, 6)
            _attn_hb_merge(ctxo6, dqo6, ctxT.data, dqkv.data, n, h, hd, 6, 7)
            _attn_hb_merge(ctxo7, dqo7, ctxT.data, dqkv.data, n, h, hd, 7, 8)
            _attn_hb_merge(ctxo8, dqo8, ctxT.data, dqkv.data, n, h, hd, 8, 9)
            _attn_hb_merge(ctxo9, dqo9, ctxT.data, dqkv.data, n, h, hd, 9, 10)
            _attn_hb_merge(ctxo10, dqo10, ctxT.data, dqkv.data, n, h, hd, 10, 11)
            _attn_hb_merge(ctxo11, dqo11, ctxT.data, dqkv.data, n, h, hd, 11, 12)
        # P5.1: dw_proj[r,o] = sum_t ctxT[t,r]*gout[t,o] -> GEMM (ctxT^T @ gout)
        # + db_proj[o] = sum_t gout[t,o] (thay vong scalar n*h^2)
        dwG = t_zeros([0])
        l10p = -1
        if o_proj >= 0:
            _ct10 = ctxT.data
            _go10 = gout.data
            _gf10 = gflat
            l10p = linear_dw_fused(_ct10, _go10, _gf10, o_proj, n, h, h)
            if l10p != 0:
                l10p = linear_dw_at_fused(_ct10, _go10, _gf10, o_proj, n, h, h, 1)
        if l10p != 0:
            ctxTt = smm_transpose(ctxT, n, h)
            dwG = smm_fwd(ctxTt, gout, h, h, n)
        # db_proj via native bias_grad (gflat offset hoac db_proj tensor)
        _bproj_gy = gout.data
        _bproj_d = db_proj.data
        _bproj_rc = -1
        if o_bproj >= 0:
            _bproj_rc = bias_grad(_bproj_gy, gflat, o_bproj, n, h)
        else:
            _bproj_rc = bias_grad(_bproj_gy, _bproj_d, 0, n, h)
        if _bproj_rc != 0:
            for o in range(h):
                acc = 0.0
                for t2 in range(n):
                    acc = acc + gout.data[t2 * h + o]
                if o_bproj >= 0:
                    gflat[o_bproj + o] = gflat[o_bproj + o] + acc
                else:
                    db_proj.data[o] = db_proj.data[o] + acc
        if l10p != 0:
            for r in range(h):
                for o in range(h):
                    if o_proj >= 0:
                        gflat[o_proj + r * h + o] = gflat[o_proj + r * h + o] + dwG.data[r * h + o]
                    else:
                        dw_proj.data[r * h + o] = dw_proj.data[r * h + o] + dwG.data[r * h + o]
        rq = gpt2_linear_bwd(x, w_qkv, dqkv, n, h, 3 * h, simd, gflat, o_qkv, o_bqkv)
        # dw_proj / db_proj placeholder khi ghi thang
        if o_proj >= 0:
            dw_proj = t_zeros([0])
        if o_bproj >= 0:
            db_proj = t_zeros([0])
        return [rq[0], rq[1], rq[2], dw_proj, db_proj]
    # ---- duong scalar (mac dinh): nguyen ven, BIT-EXACT nhu truoc --------
    for t in range(n):
        # dctx[r] = sum_o gout[t,o] * w_proj[r,o]
        for r in range(h):
            acc = 0.0
            for o in range(h):
                acc = acc + gout.data[t * h + o] * w_proj.data[r * h + o]
            dctxT.data[t * h + r] = acc
        # tinh lai ctx (cung head) can cho dw_proj
        ctx = []
        for r in range(h):
            ctx.append(0.0)
        for head in range(NHeads):
            ho = head * hd
            qv = []
            for d in range(hd):
                qv.append(qkv.data[t * 3 * h + ho + d])
            sc = []
            for u in range(t + 1):
                s = 0.0
                for d in range(hd):
                    s = s + qv[d] * qkv.data[u * 3 * h + h + ho + d]
                sc.append(s * inv)
            mx = sc[0]
            for u in range(1, t + 1):
                if sc[u] > mx:
                    mx = sc[u]
            tot = 0.0
            for u in range(t + 1):
                e = exp(sc[u] - mx)
                sc[u] = e
                tot = tot + e
            inv_tot = 1.0 / tot
            for u in range(t + 1):
                sc[u] = sc[u] * inv_tot
            for d in range(hd):
                acc = 0.0
                for u in range(t + 1):
                    acc = acc + sc[u] * qkv.data[u * 3 * h + 2 * h + ho + d]
                ctx[ho + d] = acc
                ctxT.data[t * h + ho + d] = acc
            # dp[u] = sum_d dctx[ho+d] * v_u[d]
            dp = []
            for u in range(t + 1):
                acc = 0.0
                for d in range(hd):
                    acc = acc + dctxT.data[t * h + ho + d] * qkv.data[u * 3 * h + 2 * h + ho + d]
                dp.append(acc)
            dot = 0.0
            for u in range(t + 1):
                dot = dot + sc[u] * dp[u]
            for u in range(t + 1):
                ds = sc[u] * (dp[u] - dot)
                for d in range(hd):
                    dqkv.data[t * 3 * h + ho + d] = dqkv.data[t * 3 * h + ho + d] + ds * inv * qkv.data[u * 3 * h + h + ho + d]
                    dqkv.data[u * 3 * h + h + ho + d] = dqkv.data[u * 3 * h + h + ho + d] + ds * inv * qv[d]
                    dqkv.data[u * 3 * h + 2 * h + ho + d] = dqkv.data[u * 3 * h + 2 * h + ho + d] + sc[u] * dctxT.data[t * h + ho + d]
        # dw_proj / db_proj tu ctx va gout
        for o in range(h):
            gg = gout.data[t * h + o]
            if o_bproj >= 0:
                gflat[o_bproj + o] = gflat[o_bproj + o] + gg
            else:
                db_proj.data[o] = db_proj.data[o] + gg
            for r in range(h):
                if o_proj >= 0:
                    gflat[o_proj + r * h + o] = gflat[o_proj + r * h + o] + ctx[r] * gg
                else:
                    dw_proj.data[r * h + o] = dw_proj.data[r * h + o] + ctx[r] * gg
    rq = gpt2_linear_bwd(x, w_qkv, dqkv, n, h, 3 * h, simd, gflat, o_qkv, o_bqkv)
    # dw_proj / db_proj placeholder khi ghi thang
    if o_proj >= 0:
        dw_proj = t_zeros([0])
    if o_bproj >= 0:
        db_proj = t_zeros([0])
    return [rq[0], rq[1], rq[2], dw_proj, db_proj]

# [dx, dw1, db1, dw2, db2] — MLP gelu erf
# P1.1: gflat + o_w1/o_w2 — ghi thang dw1/dw2 qua linear_bwd.
# ==== P6 GĐ6 (2026-10-21, probe BO/BP): MLP_BWD split — geluB worker ===========
# BO @1024: whole mlp_bwd 1000ms/layer = r2 391 (dx2 140 + xT2 94 + dw2 156)
# + r1 313 (dx1 125 + xT1 15 + dw1 125) + geluB 62 + inner 94 + bias/alloc...
# BP: (a) smm_fwd_at thay xT+smm_fwd BIT-EXACT 0.0 (da wire trong
# gpt2_linear_bwd); (b) geluB chay worker DONG THOI main chay dw2 GEMM:
# 187 vs 266 ms serial (maxdiff 0.0 — nested spawn (op_gelu_erf_bwd noi bo
# spawn 12) an toan tu worker thread). An toan du lieu: worker doc inner/dx2
# read-only, ghi outd RIENG; gelu khong goi simd_gemm -> khong chia se
# g_job voi dw2 main. Thu tu tinh dx -> dw -> db -> pack NGUYEN (gflat cung
# thu tu, cung gia tri) -> BIT-EXACT. Chi simd==1; duong cu simd==0 nguyen ven.
class _MlpGJob:
    ind: "list[f32]"
    gyd: "list[f32]"
    outd: "list[f32]"
    nn: 'i64'
    def __init__(self, ind: "list[f32]", gyd: "list[f32]", outd: "list[f32]", nn: 'i64'):
        self.ind = ind
        self.gyd = gyd
        self.outd = outd
        self.nn = nn

# worker: dA = gelu'(inner) * dx2 — record khong nhan Tensor -> t_new tu
# list field, copy ket qua ve outd (3.15M copy ~15ms, an duoi dw2 GEMM)
def _mlp_gelu_one(j: "_MlpGJob") -> 'i64':
    xt2 = t_new(j.ind, [j.nn])
    gt2 = t_new(j.gyd, [j.nn])
    r = op_gelu_erf_bwd(xt2, gt2)
    for i in range(j.nn):
        j.outd[i] = r.data[i]
    return 0

# ==== P6 EMBED_BWD OVERLAP (gwte_e worker || gwpe main) =====================
class _EmbBwdJob:
    idx: "list[i64]"
    d: 'i64'
    gy_data: "list[f32]"
    out_data: "list[f32]"
    def __init__(self, idx: "list[i64]", d: 'i64', gy_data: "list[f32]", out_data: "list[f32]"):
        self.idx = idx
        self.d = d
        self.gy_data = gy_data
        self.out_data = out_data

def _emb_bwd_worker(j: "_EmbBwdJob") -> 'i64':
    n = len(j.idx)
    d = j.d
    pos = []
    for t in range(n):
        pos.append(t)
    for a in range(n):
        for b in range(a + 1, n):
            if j.idx[pos[b]] < j.idx[pos[a]]:
                tmp = pos[a]
                pos[a] = pos[b]
                pos[b] = tmp
    for q in range(n):
        t = pos[q]
        r = j.idx[t]
        for c in range(d):
            j.out_data[r * d + c] = j.out_data[r * d + c] + j.gy_data[t * d + c]
    return 0


def gpt2_mlp_bwd(x: "Tensor", w1: "Tensor", b1: "Tensor",
                 w2: "Tensor", b2: "Tensor", n: 'i64', gout: "Tensor", simd: 'i32' = 0,
                 gflat: 'list[f32]' = None, o_w1: "i64" = -1, o_b1: "i64" = -1,
                 o_w2: "i64" = -1, o_b2: "i64" = -1,
                 save_inner: "Tensor" = None, save_a: "Tensor" = None) -> 'list[Tensor]':
    h = HiddenSize
    ih = 4 * h
    if save_a != None:
        a = save_a
        if save_inner != None:
            inner = save_inner
        else:
            # only gelu output luu -> recompute inner (1 GEMM BLAS,
            # ~15ms @seq1024), KHONG recompute gelu (~47ms).
            inner = gpt2_linear(x, w1, b1, n, h, ih, simd)
    else:
        inner = gpt2_linear(x, w1, b1, n, h, ih, simd)
        a = t_zeros([n * ih])
        gf = _gelu_fwd_par(inner.data, a.data, n * ih, simd)
    r2 = gpt2_linear_bwd(a, w2, gout, n, ih, h, simd, gflat, o_w2, o_b2)
    d_inner = op_gelu_erf_bwd(inner, r2[0])
    r1 = gpt2_linear_bwd(x, w1, d_inner, n, h, ih, simd, gflat, o_w1, o_b1)
    return [r1[0], r1[1], r1[2], r2[1], r2[2]]

# [dx, dln1_g, dln1_b, dw_qkv, db_qkv, dw_proj, db_proj,
#  dln2_g, dln2_b, dw1, db1, dw2, db2]
def gpt2_block_bwd(x: "Tensor", ln1_g: "Tensor", ln1_b: "Tensor",
                   w_qkv: "Tensor", b_qkv: "Tensor", w_proj: "Tensor", b_proj: "Tensor",
                   ln2_g: "Tensor", ln2_b: "Tensor",
                   w1: "Tensor", b1: "Tensor", w2: "Tensor", b2: "Tensor",
                   gout: "Tensor", simd: 'i32' = 0,
                   gflat: 'list[f32]' = None, offs: 'list[i64]' = None,
                   save_r: "Tensor" = None, save_a: "Tensor" = None,
                   save_m: "Tensor" = None, save_inner: "Tensor" = None,
                   save_a_gelu: "Tensor" = None) -> 'list[Tensor]':
    # offs = 12 offset flat theo layout layer (0 ln1_g 1 ln1_b 2 w_qkv
    # 3 b_qkv 4 w_proj 5 b_proj 6 ln2_g 7 ln2_b 8 w1 9 b1 10 w2 11 b2);
    # rong = off (duong cu, parity nguyen ven).
    if offs == None:
        offs = []
    o_l1g: "i64" = -1
    o_l1b: "i64" = -1
    o_qkv: "i64" = -1
    o_bqkv: "i64" = -1
    o_proj: "i64" = -1
    o_bproj: "i64" = -1
    o_l2g: "i64" = -1
    o_l2b: "i64" = -1
    o_w1: "i64" = -1
    o_b1: "i64" = -1
    o_w2: "i64" = -1
    o_b2: "i64" = -1
    if len(offs) >= 12:
        o_l1g = offs[0]
        o_l1b = offs[1]
        o_qkv = offs[2]
        o_bqkv = offs[3]
        o_proj = offs[4]
        o_bproj = offs[5]
        o_l2g = offs[6]
        o_l2b = offs[7]
        o_w1 = offs[8]
        o_b1 = offs[9]
        o_w2 = offs[10]
        o_b2 = offs[11]
    n: "i64" = _sh0(x)
    h: "i64" = _sh1(x)
    # P6 GĐ7 (do BR[3]: 24 goi LN fwd recompute = 359ms @1024): save_a/save_m
    # tu forward_saved -> bo recompute. Cung input + cung phep -> BIT-EXACT.
    a = save_a
    if save_a == None:
        a = gpt2_layernorm(x, ln1_g, ln1_b)
    # P5.6 (2026-10-20): save_r != None -> lay r tu forward_saved, BO HAN
    # gpt2_attention fwd recompute (~15.4s @seq1024, probe AQ). save_r la
    # x + attn_out tinh trong forward — cung gia tri TUNG BIT -> grad bit-exact.
    if save_r == None:
        attn_out = gpt2_attention(a, w_qkv, b_qkv, w_proj, b_proj, n, simd)
        r = t_zeros([n, h])
        _xl2 = x.data
        _ao = attn_out.data
        _rldc2 = r.data
        simd_add(_xl2, _ao, _rldc2)
    else:
        r = save_r
    m = save_m
    if save_m == None:
        m = gpt2_layernorm(r, ln2_g, ln2_b)
    # out = r + mlp(m)
    rmlp = gpt2_mlp_bwd(m, w1, b1, w2, b2, n, gout, simd, gflat, o_w1, o_b1, o_w2, o_b2, save_inner, save_a_gelu)
    # P5.9 (2026-11-05): dr = gout + drl2 - mutate gout in-place, bo t_zeros +
    # copy loop. gout khong con duoc dung sau mlp_bwd -> an toan. dx = drl1 + gout
    # mutate drl1, bo t_zeros + copy loop. Cung thu tu cong -> bit-exact.
    rl2 = gpt2_layernorm_bwd(r, ln2_g, ln2_b, rmlp[0], gflat, o_l2g, o_l2b)
    # quirk: khong duoc `rl2[0].data[i]` - gan ra bien truoc
    drl2 = rl2[0]
    _gd = gout.data
    _dl2 = drl2.data
    simd_add(_gd, _dl2, _gd)
    # r = x + attn_out
    r_att = gpt2_attention_bwd(a, w_qkv, b_qkv, w_proj, b_proj, n, gout, simd,
                               gflat, o_qkv, o_bqkv, o_proj, o_bproj)
    rl1 = gpt2_layernorm_bwd(x, ln1_g, ln1_b, r_att[0], gflat, o_l1g, o_l1b)
    drl1 = rl1[0]
    _dl1 = drl1.data
    simd_add(_dl1, _gd, _dl1)
    dx = drl1
    return [dx, rl1[1], rl1[2],
            r_att[1], r_att[2], r_att[3], r_att[4],
            rl2[1], rl2[2],
            rmlp[1], rmlp[2], rmlp[3], rmlp[4]]

# Gradient ve TAT CA tham so — layout cua ket qua tra ve:
#   [0] dwte (gồm 2 duong: embedding + LM head TIE)
#   [1] dwpe
#   [2] dlnf_g   [3] dlnf_b
#   layer i (base = 4 + i*12):
#     0 ln1_g  1 ln1_b  2 w_qkv  3 b_qkv  4 w_proj  5 b_proj
#     6 ln2_g  7 ln2_b  8 w1     9 b1    10 w2     11 b2
#
# dLoss/dlogits = (softmax - onehot) / n (mean CE giong gpt2_loss).
def gpt2_backward(ids: 'list[i64]', pos: 'list[i64]',
                  wte: "Tensor", wpe: "Tensor",
                  ln1_g: 'list[Tensor]', ln1_b: 'list[Tensor]',
                  w_qkv: 'list[Tensor]', b_qkv: 'list[Tensor]',
                  w_proj: 'list[Tensor]', b_proj: 'list[Tensor]',
                  ln2_g: 'list[Tensor]', ln2_b: 'list[Tensor]',
                  w1: 'list[Tensor]', b1: 'list[Tensor]',
                  w2: 'list[Tensor]', b2: 'list[Tensor]',
                  lnf_g: "Tensor", lnf_b: "Tensor", simd: 'i32' = 0,
                  gflat: 'list[f32]' = None,
                  saves: 'list[Tensor]' = None,
                   sc4: "list[f32]" = None,
                   m6_plg: 'i64' = 0, m6_pids: 'i64' = 0, m6_pwte: 'i64' = 0,
                   m6_pxf: 'i64' = 0, m6_pdxf: 'i64' = 0, m6_pdwe: 'i64' = 0) -> 'list[Tensor]':
    n = len(ids)
    h = HiddenSize
    # P1.1: gflat = flat grads phang cua AdamW (da zero) — neu KHONG rong thi
    # ghi thang TAT CA param grads vao day theo layout flatten cua ps; out list
    # tra ve placeholder (len 0). LUU Y: thu tu accumulate doi (dwte/gwpe tinh
    # xong sau blocks) -> khong bit-exact vs duong cu, chi trong ULP — parity
    # torch tolerance 1e-4 an toan. Duong cu (gflat rong) giu nguyen 100%.
    if gflat == None:
        gflat = []
    use_flat = 0
    if len(gflat) > 0:
        use_flat = 1
    # P1.1: bang offset flat theo layout flatten cua ps (cumulative numel):
    #   [0] wte  [1] wpe  [2] lnf_g  [3] lnf_b
    #   layer li: base = 4 + li*12 (0 ln1_g 1 ln1_b 2 w_qkv 3 b_qkv
    #             4 w_proj 5 b_proj 6 ln2_g 7 ln2_b 8 w1 9 b1 10 w2 11 b2)
    # goff >= 0 thi ghi thang weights grads vao gflat (da zero); tensor nho
    # (bias/LN) van t_zeros + acc binh thuong.
    poff = []
    acc0 = 0
    poff.append(acc0)
    acc0 = acc0 + VocabSize * h
    poff.append(acc0)
    acc0 = acc0 + MaxPos * h
    poff.append(acc0)
    acc0 = acc0 + h
    poff.append(acc0)
    acc0 = acc0 + h
    for li in range(NLayers):
        poff.append(acc0)
        acc0 = acc0 + h
        poff.append(acc0)
        acc0 = acc0 + h
        poff.append(acc0)
        acc0 = acc0 + 3 * h * h
        poff.append(acc0)
        acc0 = acc0 + 3 * h
        poff.append(acc0)
        acc0 = acc0 + h * h
        poff.append(acc0)
        acc0 = acc0 + h
        poff.append(acc0)
        acc0 = acc0 + h
        poff.append(acc0)
        acc0 = acc0 + h
        poff.append(acc0)
        acc0 = acc0 + 4 * h * h
        poff.append(acc0)
        acc0 = acc0 + 4 * h
        poff.append(acc0)
        acc0 = acc0 + 4 * h * h
        poff.append(acc0)
        acc0 = acc0 + h
    o_wte = -1
    o_wpe = -1
    o_lnf_g = -1
    o_lnf_b = -1
    if use_flat == 1:
        o_wte = poff[0]
        o_wpe = poff[1]
        o_lnf_g = poff[2]
        o_lnf_b = poff[3]
    # P5.5 (2026-10-20, do bench A/B): saves != None thi dung LAI forward da
    # tinh trong loss pass (gpt2_forward_saved) — bo het forward recompute
    # (~19.1s @seq1024 = 15% bwd) + GEMM logits trong lm-head. saves =
    # [logits, xf, xf_in, xins[0..NLayers-1]] — cung gia tri TUNG BIT voi
    # duong recompute (cung phep, deterministic) -> grad BIT-EXACT.
    # saves == None: duong cu nguyen ven (parity/fixture khong doi).
    xins = []
    if saves == None:
        # forward (giu lai dau vao cua moi block)
        x = gpt2_embed(ids, pos, wte, wpe)
        for i in range(NLayers):
            xins.append(x)
            x = gpt2_block(x, ln1_g[i], ln1_b[i], w_qkv[i], b_qkv[i], w_proj[i], b_proj[i],
                           ln2_g[i], ln2_b[i], w1[i], b1[i], w2[i], b2[i], simd)
        xf_in = x
        xf = gpt2_layernorm(x, lnf_g, lnf_b)
    else:
        xf = saves[1]
        xf_in = saves[2]
        for i in range(NLayers):
            xins.append(saves[3 + i])
    # duong lm head (tie weight): g_logits = (p - onehot)/n
    dxf = t_zeros([n, h])
    dwte = t_zeros([VocabSize, h])
    if simd == 1:
        # duong SIMD: logits toan bo bang smm_dot (giong head fwd), xong
        # dxf = gg x wte va dwTte = gg x xf^T — 2 GEMM lon, khong lap manh vocab
        # P5.5: saves[0] = logits da tinh trong forward_saved -> bo lai GEMM nay.
        logits_t = xf
        if saves == None:
            logits_t = smm_dot_pd(xf, wte, n, VocabSize, h)
        else:
            logits_t = saves[0]
        # M6 WIRED (2026-10-25, probe CJ6 @ out/cj6_run.log): native fused
        # softmax-grad + dxf + dwte — BO toan bo gg (51.5M t_zeros interpreted)
        # + softmax loop interpreted. A/B seq1024 best-of-3: base 4844ms
        # (softmax 2735 + dxf 453 + dwte 1125) vs M6 1625ms = 2.98x;
        # maxdiff vs base: dxf 5.4e-9, dwte 7.0e-10; smoke vs scalar 3.6e-8 < 1e-5.
        # scale = 1/n theo hop dong (p - onehot)/n (compiler fix SPEC §6 ask 2).
        # Lich su duong cu: P5.7 revert (transpose nguoc REGRESSION seq8/256),
        # P5.8 smm_fwd_at_pd bit-exact — xem git.
        m6_lgd = logits_t.data
        m6_wtd = wte.data
        m6_xfd = xf.data
        m6_dd = dxf.data
        m6_dw = dwte.data
        m6_nlg = n * VocabSize
        m6_nwe = VocabSize * h
        m6_nxe = n * h
        m6_pids = alloc_bytes(n * 4)
        m6_i = 0
        while m6_i < n:
            m6_w = write_i32(m6_pids, m6_i * 4, ids[m6_i])
            m6_i = m6_i + 1
        m6_sc: "f32" = 1.0 / float(n)
        # H4b: zero-copy managed data - fused doc/ghi truc tiep .data (list[f32])
        m6_st = lmhead_bwd_fused_list(m6_lgd, m6_pids, m6_wtd, m6_xfd, m6_dd, m6_dw, n, 1, h, VocabSize, m6_sc)
        if m6_st != 0:
            raise ValueError("lmhead_bwd_fused loi st=" + str(m6_st))
        m6_f2 = free_bytes(m6_pids)
        # dxf/dwte van la Tensor t_zeros o tren — du lieu da dien day du
    if simd == 0:
        for i in range(n):
            row = []
            mxf = 0.0
            for o in range(VocabSize):
                acc = 0.0
                for k in range(h):
                    acc = acc + xf.data[i * h + k] * wte.data[o * h + k]
                row.append(acc)
                if o == 0:
                    mxf = acc
                if acc > mxf:
                    mxf = acc
            tot = 0.0
            for o in range(VocabSize):
                e = exp(row[o] - mxf)
                row[o] = e
                tot = tot + e
            inv_tot = 1.0 / tot
            inv_n = 1.0 / float(n)
            for o in range(VocabSize):
                # DAT TEN KHAC nhánh simd==1 (`gg` la Tensor o do) — compiler
                # gop bien cung ten/cung ham thanh mot slot, doc sai bo nho
                gsc = row[o] * inv_tot * inv_n
                if o == ids[i]:
                    gsc = gsc - inv_n
                for k in range(h):
                    dxf.data[i * h + k] = dxf.data[i * h + k] + gsc * wte.data[o * h + k]
                    dwte.data[o * h + k] = dwte.data[o * h + k] + gsc * xf.data[i * h + k]
    # ln_f
    rl = gpt2_layernorm_bwd(xf_in, lnf_g, lnf_b, dxf, gflat, o_lnf_g, o_lnf_b)
    # backward qua cac block (tu cuoi ve dau), luu phang theo thu tu backward
    rblocks = []
    gx = rl[0]
    for i in range(NLayers):
        li = NLayers - 1 - i
        lo = []
        if use_flat == 1:
            for j in range(12):
                lo.append(poff[4 + li * 12 + j])
        # P5.6: saves co rs[i] -> block_bwd dung lai r, khong recompute attn fwd.
        if saves == None:
            rb = gpt2_block_bwd(xins[li], ln1_g[li], ln1_b[li],
                                w_qkv[li], b_qkv[li], w_proj[li], b_proj[li],
                                ln2_g[li], ln2_b[li],
                                w1[li], b1[li], w2[li], b2[li], gx, simd, gflat, lo)
        else:
            # P6 GĐ8 (2026-11-08): saves format 3+5N (logits, xf, xf_in, xins, rs
            # + ains, msin + 1 gelu output `a` per layer) -> bo gelu recompute,
            # inner recompute 1 GEMM BLAS (~15ms/layer). Saves cu (3+4N) doc duoc.
            if len(saves) >= 3 + 5 * NLayers:
                rb = gpt2_block_bwd(xins[li], ln1_g[li], ln1_b[li],
                                    w_qkv[li], b_qkv[li], w_proj[li], b_proj[li],
                                    ln2_g[li], ln2_b[li],
                                    w1[li], b1[li], w2[li], b2[li], gx, simd, gflat, lo,
                                    saves[3 + NLayers + li],
                                    saves[3 + 2 * NLayers + li],
                                    saves[3 + 3 * NLayers + li],
                                    None,
                                    saves[3 + 4 * NLayers + li])
            elif len(saves) >= 3 + 4 * NLayers:
                rb = gpt2_block_bwd(xins[li], ln1_g[li], ln1_b[li],
                                    w_qkv[li], b_qkv[li], w_proj[li], b_proj[li],
                                    ln2_g[li], ln2_b[li],
                                    w1[li], b1[li], w2[li], b2[li], gx, simd, gflat, lo,
                                    saves[3 + NLayers + li],
                                    saves[3 + 2 * NLayers + li],
                                    saves[3 + 3 * NLayers + li])
            else:
                rb = gpt2_block_bwd(xins[li], ln1_g[li], ln1_b[li],
                                    w_qkv[li], b_qkv[li], w_proj[li], b_proj[li],
                                    ln2_g[li], ln2_b[li],
                                    w1[li], b1[li], w2[li], b2[li], gx, simd, gflat, lo,
                                    saves[3 + NLayers + li])
        gx = rb[0]
        for j in range(1, 13):
            rblocks.append(rb[j])
    # embedding bwd: wte nhan grad tu 2 duong (tie)
    # P6 EMBED_BWD OVERLAP (2026-10-25): gwte_e || gwpe song song khi simd==1
    if simd == 1:
        gwte_e = t_zeros([VocabSize * h])
        emb_job = _EmbBwdJob(ids, h, gx.data, gwte_e.data)
        emb_h = thread_spawn(_emb_bwd_worker, emb_job)
        gwpe = op_embed_bwd(wpe, pos, h, gx)
        emb_r = thread_join(emb_h)
    else:
        gwte_e = op_embed_bwd(wte, ids, h, gx)
        gwpe = op_embed_bwd(wpe, pos, h, gx)
    if len(dwte.data) > 0:
        dwl: "list[f32]" = dwte.data
        gwl: "list[f32]" = gwte_e.data
        nv1: "i64" = VocabSize * h
        rsd = f32_list_add(dwl, gwl, nv1)
    # xep theo layout: layer 0 truoc

    out = []
    if use_flat == 1:
        # ghi thang dwte/gwpe vao flat (dwte gom 2 duong da gop)
        if len(gflat) > 0:
            dwg: "list[f32]" = dwte.data
            nv2: "i64" = VocabSize * h
            rsg = f32_list_add(gflat, dwg, nv2)
        for k in range(MaxPos * h):
            gflat[o_wpe + k] = gflat[o_wpe + k] + gwpe.data[k]
        out.append(t_zeros([0]))
        out.append(t_zeros([0]))
    else:
        out.append(dwte)
        out.append(gwpe)
    out.append(rl[1])
    out.append(rl[2])
    for li in range(NLayers):
        base = (NLayers - 1 - li) * 12
        for j in range(12):
            out.append(rblocks[base + j])
    return out

# ============================================================================
#  G2 PHAM VI BO SUNG (2026-10-19): khoi tao trong so + padding mask
# ----------------------------------------------------------------------------
#  gpt2_init(seed): normal(0, 0.02) tat dinh (LCG 31-bit + Box-Muller), thu tu
#  phat sinh CO DINH: wte, wpe, lnf_g, lnf_b, roi tung layer 12 tham so.
#  Tra ve list[Tensor] theo DUNG layout dau ra cua gpt2_backward.
#
#  Mask path: giong HF `attention_mask` — chan KEY o vi tri pad trong attention
#  (causal + pad). Gate G2 chi doi forward/loss cho duong mask.
# ============================================================================

def _gi_uniform(state: 'i64') -> 'i64':
    return (state * 1103515245 + 12345) % 2147483648

def _gi_noise(n: 'i64', seed: 'i64') -> 'list[f32]':
    out = []
    s = seed % 2147483648
    i = 0
    while i < n:
        s = _gi_uniform(s)
        u1 = (float(s) + 0.5) / 2147483648.0
        s = _gi_uniform(s)
        u2 = float(s) / 2147483648.0
        out.append(sqrt(0.0 - 2.0 * log(u1)) * cos(6.283185307179586 * u2) * 0.02)
        i = i + 1
    return out

def _gi_ones(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(1.0)
    return out

def _gi_zeros(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def gpt2_init(seed: 'i64') -> 'list[Tensor]':
    ps = []
    ps.append(t_new(_gi_noise(VocabSize * HiddenSize, seed + 1), [VocabSize, HiddenSize]))
    ps.append(t_new(_gi_noise(MaxPos * HiddenSize, seed + 2), [MaxPos, HiddenSize]))
    ps.append(t_new(_gi_ones(HiddenSize), [HiddenSize]))
    ps.append(t_new(_gi_zeros(HiddenSize), [HiddenSize]))
    for li in range(NLayers):
        sd = seed + 10 + li * 100
        ps.append(t_new(_gi_ones(HiddenSize), [HiddenSize]))
        ps.append(t_new(_gi_zeros(HiddenSize), [HiddenSize]))
        ps.append(t_new(_gi_noise(HiddenSize * 3 * HiddenSize, sd + 1), [HiddenSize, 3 * HiddenSize]))
        ps.append(t_new(_gi_zeros(3 * HiddenSize), [3 * HiddenSize]))
        ps.append(t_new(_gi_noise(HiddenSize * HiddenSize, sd + 2), [HiddenSize, HiddenSize]))
        ps.append(t_new(_gi_zeros(HiddenSize), [HiddenSize]))
        ps.append(t_new(_gi_ones(HiddenSize), [HiddenSize]))
        ps.append(t_new(_gi_zeros(HiddenSize), [HiddenSize]))
        ps.append(t_new(_gi_noise(HiddenSize * 4 * HiddenSize, sd + 3), [HiddenSize, 4 * HiddenSize]))
        ps.append(t_new(_gi_zeros(4 * HiddenSize), [4 * HiddenSize]))
        ps.append(t_new(_gi_noise(4 * HiddenSize * HiddenSize, sd + 4), [4 * HiddenSize, HiddenSize]))
        ps.append(t_new(_gi_zeros(HiddenSize), [HiddenSize]))
    return ps

# ---- attention co padding mask (chan KEY) ----------------------------------
def gpt2_attention_m(x: "Tensor", w_qkv: "Tensor", b_qkv: "Tensor",
                     w_proj: "Tensor", b_proj: "Tensor", n: 'i64',
                     kmask: 'list[i64]', simd: 'i32' = 0) -> "Tensor":
    h = HiddenSize
    hd = HeadDim
    qkv = gpt2_linear(x, w_qkv, b_qkv, n, h, 3 * h, simd)
    out = t_zeros([n, h])
    inv = 1.0 / sqrt(float(hd))
    for t in range(n):
        ctx = []
        for d in range(h):
            ctx.append(0.0)
        for head in range(NHeads):
            ho = head * hd
            qv = []
            for d in range(hd):
                qv.append(qkv.data[t * 3 * h + ho + d])
            # chi giu key u <= t VA kmask[u] != 0
            scores = []
            vidx = []
            for u in range(t + 1):
                if kmask[u] != 0:
                    s = 0.0
                    for d in range(hd):
                        s = s + qv[d] * qkv.data[u * 3 * h + h + ho + d]
                    scores.append(s * inv)
                    vidx.append(u)
            nv = len(scores)
            if nv > 0:
                mx = scores[0]
                for k in range(1, nv):
                    if scores[k] > mx:
                        mx = scores[k]
                tot = 0.0
                for k in range(nv):
                    e = exp(scores[k] - mx)
                    scores[k] = e
                    tot = tot + e
                inv_tot = 1.0 / tot
                for d in range(hd):
                    acc = 0.0
                    for k in range(nv):
                        acc = acc + scores[k] * qkv.data[vidx[k] * 3 * h + 2 * h + ho + d]
                    ctx[ho + d] = acc * inv_tot
        for o in range(h):
            acc = b_proj.data[o]
            for r in range(h):
                acc = acc + ctx[r] * w_proj.data[r * h + o]
            out.data[t * h + o] = acc
    return out

def gpt2_block_m(x: "Tensor", ln1_g: "Tensor", ln1_b: "Tensor",
                 w_qkv: "Tensor", b_qkv: "Tensor", w_proj: "Tensor", b_proj: "Tensor",
                 ln2_g: "Tensor", ln2_b: "Tensor",
                 w1: "Tensor", b1: "Tensor", w2: "Tensor", b2: "Tensor",
                 kmask: 'list[i64]', simd: 'i32' = 0) -> "Tensor":
    n = _sh0(x)
    h = _sh1(x)
    a = gpt2_layernorm(x, ln1_g, ln1_b)
    a = gpt2_attention_m(a, w_qkv, b_qkv, w_proj, b_proj, n, kmask, simd)
    r = t_zeros([n, h])
    _xl = x.data
    _al = a.data
    _rldc = r.data
    simd_add(_xl, _al, _rldc)
    m = gpt2_layernorm(r, ln2_g, ln2_b)
    m = gpt2_mlp(m, w1, b1, w2, b2, n, simd)
    out = t_zeros([n, h])
    _rl = r.data
    _ml = m.data
    _oldc = out.data
    simd_add(_rl, _ml, _oldc)
    return out

def gpt2_forward_m(ids: 'list[i64]', pos: 'list[i64]', kmask: 'list[i64]',
                   wte: "Tensor", wpe: "Tensor",
                   ln1_g: 'list[Tensor]', ln1_b: 'list[Tensor]',
                   w_qkv: 'list[Tensor]', b_qkv: 'list[Tensor]',
                   w_proj: 'list[Tensor]', b_proj: 'list[Tensor]',
                   ln2_g: 'list[Tensor]', ln2_b: 'list[Tensor]',
                   w1: 'list[Tensor]', b1: 'list[Tensor]',
                   w2: 'list[Tensor]', b2: 'list[Tensor]',
                   lnf_g: "Tensor", lnf_b: "Tensor", simd: 'i32' = 0) -> "Tensor":
    n = len(ids)
    h = HiddenSize
    x = gpt2_embed(ids, pos, wte, wpe)
    for i in range(NLayers):
        x = gpt2_block_m(x, ln1_g[i], ln1_b[i], w_qkv[i], b_qkv[i], w_proj[i], b_proj[i],
                         ln2_g[i], ln2_b[i], w1[i], b1[i], w2[i], b2[i], kmask, simd)
    x = gpt2_layernorm(x, lnf_g, lnf_b)
    if simd == 1:
        return smm_dot(x, wte, n, VocabSize, h)
    logits = t_zeros([n, VocabSize])
    for i in range(n):
        for o in range(VocabSize):
            acc = 0.0
            for k in range(h):
                acc = acc + x.data[i * h + k] * wte.data[o * h + k]
            logits.data[i * VocabSize + o] = acc
    return logits

# Cross entropy CHI tren vi tri kmask != 0 (giong labels=-100 cua PyTorch).
def gpt2_loss_m(logits: "Tensor", ids: 'list[i64]', kmask: 'list[i64]') -> 'f32':
    n = _sh0(logits)
    tot = 0.0
    cnt = 0
    for i in range(n):
        if kmask[i] != 0:
            base = i * VocabSize
            mx = logits.data[base]
            for o in range(1, VocabSize):
                if logits.data[base + o] > mx:
                    mx = logits.data[base + o]
            s = 0.0
            for o in range(VocabSize):
                s = s + exp(logits.data[base + o] - mx)
            lse = mx + log(s)
            tot = tot + (lse - logits.data[base + ids[i]])
            cnt = cnt + 1
    if cnt == 0:
        return 0.0
    return tot / float(cnt)
