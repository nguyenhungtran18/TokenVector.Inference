# PROBE CLIP PATH THAT (2026-11-11) — test clip truoc do VO GIA TRI
#
# LOI CU: probe _opt_e2e dung g = zeros_list(n) -> grad_norm = 0.0 ->
# `if gn > 0.0` KHONG BAO GIO dung -> coef = 1.0 -> CA HAI nhanh deu di
# duong nhanh `adamw_step_glm`. So sanh clip=1.0 vs clip=1e9 vi the vo nghia.
#
# Trong production gn ~ 11 (gradient that), nen coef = clip/(gn+eps) ~ 0.09
# -> di duong CHAM: r1 = f32_copy_to_buf (281 ms) + f32_zero + f32_addcmul.
#
# Probe nay do voi g CO GIA TRI THAT:
#   A: clip=1.0  -> coef ~ 0.09 -> duong cham (nhu production)
#   B: clip=1e9  -> coef cap 1.0 -> duong nhanh
# chenh B - A = gia that cua duong clip.
import tv.training.gpt2_ref124
import tv.training.trainer


def mk_opt(n: "i64", groups: "list[i64]", clip: "f64") -> "AdamW":
    return new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999,
                       0.00000001, 0.0, clip)


def mk_groups(n: "i32") -> "list[i64]":
    out: "list[i64]" = []
    k: "i32" = 0
    while k < 147:
        out.append(768)
        k = k + 1
    out.append(n - 147 * 768)
    return out


def fill_g(g: "list[f32]", n: "i32") -> "f64":
    """Ghi gradient THAT (0.001) de grad_norm > 0 — dieu kien de vao duong clip."""
    i: "i32" = 0
    while i < n:
        g[i] = 0.001
        i = i + 1
    return float(g[0])


def check_gn(opt: "AdamW") -> "f64":
    gn: "f32" = opt.grad_norm()
    return float(gn)


def step_min(opt: "AdamW", reps: "i32") -> "f64":
    best: "f64" = 1.0e9
    k: "i32" = 0
    while k < reps:
        t0 = now_ms()
        lr = opt.step()
        t1 = now_ms()
        if float(t1 - t0) < best:
            best = float(t1 - t0)
        k = k + 1
    return best


def run_a(n: "i32", groups: "list[i64]") -> "f64":
    print("--- A: clip=1.0, g THAT -> coef ~ 0.09 -> duong CHAM ---")
    opt = mk_opt(n, groups, 1.0)
    fg: "f64" = fill_g(opt.g, n)
    gn: "f64" = check_gn(opt)
    print("  g[0]=" + str(fg) + "  grad_norm=" + str(gn))
    if gn <= 0.0:
        print("  CANH BAO: grad_norm = 0 -> test vo nghia, duong clip khong chay!")
    d: "f64" = step_min(opt, 3)
    print("  opt.step() min = " + str(d) + " ms")
    return d


def run_b(n: "i32", groups: "list[i64]") -> "f64":
    print("--- B: clip=1e9, g THAT -> coef cap 1.0 -> duong NHANH ---")
    opt = mk_opt(n, groups, 1000000000.0)
    fg: "f64" = fill_g(opt.g, n)
    gn: "f64" = check_gn(opt)
    print("  g[0]=" + str(fg) + "  grad_norm=" + str(gn))
    d: "f64" = step_min(opt, 3)
    print("  opt.step() min = " + str(d) + " ms")
    return d


def report(da: "f64", db: "f64") -> "i32":
    print("")
    print("--- tong hop ---")
    print("A clip=1.0 (duong cham)  = " + str(da) + " ms")
    print("B clip=1e9 (duong nhanh) = " + str(db) + " ms")
    print("chenh B - A              = " + str(db - da) + " ms")
    print("")
    print("--- doc ---")
    print("Neu A ~ 781 va B ~ 532 -> duong clip CHINH LA 249 ms con thieu.")
    print("Neu A ~ B              -> duong clip khong ton gi, phai tim cho khac.")
    return 0


def main() -> 'i32':
    print("=== PROBE CLIP PATH THAT (g khac 0) ===")
    n: "i32" = 124439808
    print("n = " + str(n) + "  (" + str(float(n * 4) / 1048576.0) + " MB)")
    print("")
    groups: "list[i64]" = mk_groups(n)
    da: "f64" = run_a(n, groups)
    print("")
    db: "f64" = run_b(n, groups)
    print("")
    return report(da, db)
