# GATE _p6x — YEU CAU #6 (2026-10-27): offset / const-fill / counter
#
# Bo khop mau mo rong trong CUNG bo matcher P6:
#   (a) chi so `off + iv` loop-invariant   -> `d[j] = flat[off + j]`, `g[o+k] = a[k]`
#   (b) const-fill `a[iv] = c` (c invariant) -> `z[i] = 0.0`, `h.p[i] = 0.0`
#   (c) counter rieng `o[dst]` dong do `iv`  -> `o[dst] = a[i]`, ACC `cd[bc] += Ct[bt]`
# Tat ca deu van GIU hop dong OOB (ArgumentOutOfRangeException + message/paramName)
# va van KHONG nem khi vong khong chay.
#
# LUU: duong `while` chi khop mau khi bien dem va BIEN DEM n la BIEN
# (`ekind(n_node) != 'var'` -> tu choi, han che CO SAN cua #5) nen cac vong
# while o day deu dung bien `n*` rieng. Duong `for` chi can `la_node`.
#
# Chay:
#   /d/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_p6x.tkv out/_p6x.exe main
#   ./out/_p6x.exe

class _Hd:
    p: "list[f32]"
    def __init__(self, p: "list[f32]"):
        self.p = p


def _mk(n: "i32", a1: "f32") -> "list[f32]":
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append(a1)
        i = i + 1
    return out


def _seq(n: "i32") -> "list[f32]":
    # gia tri i -> de phan biet tung vi tri
    out: "list[f32]" = []
    i = 0
    while i < n:
        out.append((0.0) / 1.0)
        i = i + 1
    i = 0
    while i < n:
        out[i] = f32(float(i))
        i = i + 1
    return out


_OOB = "Index was out of range. Must be non-negative and less than the size of the collection."


def main() -> "i32":
    total = 0

    # ---- [1] (a) offset tren SOURCE, vong `while` ----
    n16 = 16
    flat = _seq(32)
    d = _mk(16, -1.0)
    off = 10
    i = 0
    while i < n16:
        d[i] = flat[off + i]
        i = i + 1
    bad = 0
    i = 0
    while i < n16:
        if float(d[i]) != float(10 + i):
            bad = bad + 1
        i = i + 1
    total = total + bad
    print("[1] off-src  bad=" + str(bad))

    # ---- [2] (a) offset tren DEST, vong `while` ----
    a = _seq(16)
    g = _mk(40, -1.0)
    o = 20
    i = 0
    while i < n16:
        g[o + i] = a[i]
        i = i + 1
    bad = 0
    ng = 40
    i = 0
    while i < ng:
        if i < 20 or i >= 36:
            if float(g[i]) != -1.0:
                bad = bad + 1
        else:
            if float(g[i]) != float(i - 20):
                bad = bad + 1
        i = i + 1
    total = total + bad
    print("[2] off-dst  bad=" + str(bad))

    # ---- [3] (a) hinh gpt2_unflatten: `for j in range(len(d)): d[j] = flat[off+j]` ----
    dd = _mk(16, -1.0)
    flat2 = _seq(32)
    off2 = 5
    for j in range(len(dd)):
        dd[j] = flat2[off2 + j]
    bad = 0
    i = 0
    while i < n16:
        if float(dd[i]) != float(5 + i):
            bad = bad + 1
        i = i + 1
    total = total + bad
    print("[3] unflatten(for) bad=" + str(bad))

    # ---- [4] (b) const-fill hang so tren bien ----
    n64 = 64
    z = _mk(64, 7.0)
    i = 0
    while i < n64:
        z[i] = 0.0
        i = i + 1
    bad = 0
    i = 0
    while i < n64:
        if float(z[i]) != 0.0:
            bad = bad + 1
        i = i + 1
    zf: "f32" = 2.5
    i = 0
    while i < n64:
        z[i] = zf
        i = i + 1
    i = 0
    while i < n64:
        if float(z[i]) != 2.5:
            bad = bad + 1
        i = i + 1
    total = total + bad
    print("[4] const-fill bad=" + str(bad))

    # ---- [5] (b) const-fill tren TRUONG record (hinh zero_grad production) ----
    h = _Hd(_mk(128, 9.0))
    for i2 in range(len(h.p)):
        h.p[i2] = 0.0
    bad = 0
    nh = 128
    i = 0
    while i < nh:
        if float(h.p[i]) != 0.0:
            bad = bad + 1
        i = i + 1
    total = total + bad
    print("[5] const-fill attr bad=" + str(bad))

    # ---- [6] (c) counter rieng cho DEST ----
    o2 = _mk(64, -1.0)
    a2 = _seq(16)
    dst = 8
    i = 0
    while i < n16:
        o2[dst] = a2[i]
        dst = dst + 1
        i = i + 1
    bad = 0
    no = 64
    i = 0
    while i < no:
        if i < 8 or i >= 24:
            if float(o2[i]) != -1.0:
                bad = bad + 1
        else:
            if float(o2[i]) != float(i - 8):
                bad = bad + 1
        i = i + 1
    total = total + bad
    print("[6] counter-dst bad=" + str(bad))

    # ---- [7] (c) ACC: doc + ghi qua 2 counter (hinh `_f32p` [2]) ----
    n32 = 32
    nb = 8
    cd = _mk(32, 0.0)
    Ct = _seq(32)
    bc = 4
    bt = 10
    c = 0
    while c < nb:
        cd[bc] = cd[bc] + Ct[bt]
        bc = bc + 1
        bt = bt + 1
        c = c + 1
    bad = 0
    i = 0
    while i < n32:
        if i < 4 or i >= 12:
            if float(cd[i]) != 0.0:
                bad = bad + 1
        else:
            if float(cd[i]) != float(10 + i - 4):
                bad = bad + 1
        i = i + 1
    total = total + bad
    print("[7] acc-2counter bad=" + str(bad))

    # ---- [8] (a) OOB: off < 0 -> PHAI nem ----
    msg: "str" = "no-throw"
    n4 = 4
    try:
        fs = _mk(8, 1.0)
        ds = _mk(4, 1.0)
        offs = -1
        k = 0
        while k < n4:
            ds[k] = fs[offs + k]
            k = k + 1
        msg = "no-throw"
    except Exception as e:
        msg = str(e)
    print("[8] off<0 -> '" + msg + "'")
    if msg == "no-throw" or msg.find(_OOB) < 0 or msg.find("Parameter name: index") < 0:
        total = total + 1
        print("[8] FAIL hop dong OOB")

    # ---- [9] (a) OOB: off + n > Count -> PHAI nem ----
    msg = "no-throw"
    try:
        fs = _mk(8, 1.0)
        ds = _mk(4, 1.0)
        offs = 6          # 6 + 4 = 10 > 8
        k = 0
        while k < n4:
            ds[k] = fs[offs + k]
            k = k + 1
        msg = "no-throw"
    except Exception as e:
        msg = str(e)
    print("[9] off+n>Cnt -> '" + msg + "'")
    if msg == "no-throw" or msg.find(_OOB) < 0 or msg.find("Parameter name: index") < 0:
        total = total + 1
        print("[9] FAIL hop dong OOB")

    # ---- [10] (b) OOB const-fill: n > Count -> nem; n = 0 -> KHONG nem ----
    msg = "no-throw"
    n5 = 5
    try:
        zc = _mk(4, 1.0)
        k = 0
        while k < n5:
            zc[k] = 0.0
            k = k + 1
        msg = "no-throw"
    except Exception as e:
        msg = str(e)
    print("[10] fill n>Cnt -> '" + msg + "'")
    if msg == "no-throw" or msg.find(_OOB) < 0 or msg.find("Parameter name: index") < 0:
        total = total + 1
        print("[10] FAIL hop dong OOB")
    msg = "no-throw"
    n0 = 0
    try:
        zc = _mk(4, 1.0)
        k = 0
        while k < n0:
            zc[k] = 0.0
            k = k + 1
        msg = "no-throw len=" + str(len(zc))
    except Exception as e:
        msg = str(e)
    print("[10b] fill n=0 -> '" + msg + "'")
    if msg != "no-throw len=4":
        total = total + 1
        print("[10b] FAIL (vong khong chay ma van nem)")

    # ---- [11] (c) OOB counter: dst < 0 va dst + rem > Count ----
    msg = "no-throw"
    try:
        oc = _mk(8, 1.0)
        ac = _mk(4, 1.0)
        dstc = -2
        k = 0
        while k < n4:
            oc[dstc] = ac[k]
            dstc = dstc + 1
            k = k + 1
        msg = "no-throw"
    except Exception as e:
        msg = str(e)
    print("[11] dst<0 -> '" + msg + "'")
    if msg == "no-throw" or msg.find(_OOB) < 0 or msg.find("Parameter name: index") < 0:
        total = total + 1
        print("[11] FAIL hop dong OOB")
    msg = "no-throw"
    try:
        oc = _mk(8, 1.0)
        ac = _mk(4, 1.0)
        dstc = 6          # 6 + 4 = 10 > 8
        k = 0
        while k < n4:
            oc[dstc] = ac[k]
            dstc = dstc + 1
            k = k + 1
        msg = "no-throw"
    except Exception as e:
        msg = str(e)
    print("[11b] dst+rem>Cnt -> '" + msg + "'")
    if msg == "no-throw" or msg.find(_OOB) < 0 or msg.find("Parameter name: index") < 0:
        total = total + 1
        print("[11b] FAIL hop dong OOB")

    # ---- [12] henh sau sua bug `ble` -> `bge`: vong NHO hon len(list) ----
    # (truoc do preheader nem AOOE vo logic khi `n < Count`)
    n4b = 4
    nbig = 100
    rn = _mk(100, 0.0)
    an = _mk(100, 0.0)
    bn = _mk(100, 0.0)
    i = 0
    while i < n4b:
        rn[i] = an[i] + bn[i]
        i = i + 1
    bad = 0
    i = 0
    while i < n4b:
        if float(rn[i]) != 0.0:
            bad = bad + 1
        i = i + 1
    total = total + bad
    # va vong `for` qua mot list DAI hon bien dem
    fo: "list[f32]" = _mk(100, 3.0)
    bo: "list[f32]" = _mk(100, 4.0)
    ro: "list[f32]" = _mk(100, 0.0)
    for q in range(7):
        ro[q] = fo[q] + bo[q]
    i = 0
    while i < n4b:
        if float(ro[i]) != 7.0:
            bad = bad + 1
        i = i + 1
    total = total + bad
    print("[12] n<Cnt bad=" + str(bad) + " (nbig=" + str(nbig) + ")")

    print("_p6x done fails=" + str(total))
    return 0