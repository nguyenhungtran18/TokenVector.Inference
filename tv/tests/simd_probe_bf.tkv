# PROBE BF — P6 da luong TKV: thread_spawn/join qua record (2026-10-21)
# BF[1]: thread_spawn(f, i64) + join -> gia tri dung? (co so)
# BF[2]: record co field Tensor + i64 qua thread_spawn; N worker ghi DISJOINT
#        vao C Tensor CHUNG -> bit-exact vs 1 luong toan bo?
# BF[3]: speedup: matmul chunk, 1 vs 4 workers (now_ms trong main — bug #8)
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bf.tkv out/bf.exe main
#   ./out/bf.exe
import tv.training.tensor
import tv.training.simd_matmul

# LUU Y P6: record field KHONG nhan class khac file (Tensor bi tu choi) ->
# truyen list[f32] (la Tensor.data) — container field duoc chap nhan.
class BfJob:
    ad: "list[f32]"
    bd: "list[f32]"
    cd: "list[f32]"
    kdim: 'i64'
    n: 'i64'
    i0: 'i64'
    i1: 'i64'
    def __init__(self, ad: "list[f32]", bd: "list[f32]", cd: "list[f32]", kdim: 'i64', n: 'i64', i0: 'i64', i1: 'i64'):
        self.ad = ad
        self.bd = bd
        self.cd = cd
        self.kdim = kdim
        self.n = n
        self.i0 = i0
        self.i1 = i1

def _bf_id(x: 'i64') -> 'i64':
    return x + 1

# C[i0:i1, :] = A[i0:i1, :] x B — cung thu tu p tang dan moi phan tu (bit-exact
# giua chunk va toan bo vi moi phan tu tinh doc lap).
def _bf_rows(j: "BfJob") -> 'i64':
    ad = j.ad
    bd = j.bd
    cd = j.cd
    kdim = j.kdim
    n = j.n
    i = j.i0
    while i < j.i1:
        ib = i * kdim
        ic = i * n
        p = 0
        while p < kdim:
            av = ad[ib + p]
            bp = p * n
            q = 0
            while q < n:
                cd[ic + q] = cd[ic + q] + av * bd[bp + q]
                q = q + 1
            p = p + 1
        i = i + 1
    return j.i1 - j.i0

def _fill(rows: 'i64', cols: 'i64', seed: 'i64') -> "Tensor":
    out = t_zeros([rows, cols])
    d = out.data
    for i in range(rows * cols):
        d[i] = (float((i * 13 + seed) % 211) - 105.0) / 105.0
    return out

def _maxdiff(a: "Tensor", b: "Tensor") -> 'f64':
    da = a.data
    db = b.data
    m = 0.0
    for i in range(len(da)):
        dd = da[i] - db[i]
        if dd < 0.0:
            dd = 0.0 - dd
        if dd > m:
            m = dd
    return m

def main() -> 'i32':
    fails = 0

    # ---- BF[1]: thread_spawn(f, i64) + join ------------------------------
    h1 = thread_spawn(_bf_id, 10)
    h2 = thread_spawn(_bf_id, 20)
    r1 = thread_join(h1)
    r2 = thread_join(h2)
    ok1 = 0
    if r1 == 11:
        if r2 == 21:
            ok1 = 1
    print("BF[1] spawn/join i64: r1=" + str(r1) + " r2=" + str(r2) + " ok=" + str(ok1))
    if ok1 != 1:
        fails = fails + 1

    # ---- BF[2]: 4 worker, ghi disjoint vao C chung — bit-exact -----------
    m = 256
    n = 256
    kk = 256
    a = _fill(m, kk, 3)
    b = _fill(kk, n, 7)
    c_ref = t_zeros([m, n])
    rows_ref = _bf_rows(BfJob(a.data, b.data, c_ref.data, kk, n, 0, m))
    c_par = t_zeros([m, n])
    h1 = thread_spawn(_bf_rows, BfJob(a.data, b.data, c_par.data, kk, n, 0, 64))
    h2 = thread_spawn(_bf_rows, BfJob(a.data, b.data, c_par.data, kk, n, 64, 128))
    h3 = thread_spawn(_bf_rows, BfJob(a.data, b.data, c_par.data, kk, n, 128, 192))
    h4 = thread_spawn(_bf_rows, BfJob(a.data, b.data, c_par.data, kk, n, 192, 256))
    s1 = thread_join(h1)
    s2 = thread_join(h2)
    s3 = thread_join(h3)
    s4 = thread_join(h4)
    md = _maxdiff(c_ref, c_par)
    print("BF[2] 4-worker disjoint rows: rows=" + str(s1 + s2 + s3 + s4) + " maxdiff=" + str(md))
    if md > 0.0:
        fails = fails + 1

    # ---- BF[3]: speedup 1 vs 4 workers ----------------------------------
    m2 = 512
    n2 = 512
    k2 = 1024
    a2 = _fill(m2, k2, 11)
    b2 = _fill(k2, n2, 13)
    c1 = t_zeros([m2, n2])
    t0 = now_ms()
    _bf_rows(BfJob(a2.data, b2.data, c1.data, k2, n2, 0, m2))
    t1 = now_ms()
    dv1 = t1 - t0
    c2 = t_zeros([m2, n2])
    t0 = now_ms()
    j1 = thread_spawn(_bf_rows, BfJob(a2.data, b2.data, c2.data, k2, n2, 0, 128))
    j2 = thread_spawn(_bf_rows, BfJob(a2.data, b2.data, c2.data, k2, n2, 128, 256))
    j3 = thread_spawn(_bf_rows, BfJob(a2.data, b2.data, c2.data, k2, n2, 256, 384))
    j4 = thread_spawn(_bf_rows, BfJob(a2.data, b2.data, c2.data, k2, n2, 384, 512))
    w1 = thread_join(j1)
    w2 = thread_join(j2)
    w3 = thread_join(j3)
    w4 = thread_join(j4)
    t1 = now_ms()
    dv4 = t1 - t0
    md2 = _maxdiff(c1, c2)
    ratio = 0.0
    if dv4 > 0.0:
        ratio = dv1 / dv4
    print("BF[3] matmul 512x1024x512: 1w=" + str(dv1) + " ms  4w=" + str(dv4) + " ms  speedup=" + str(ratio) + " maxdiff=" + str(md2) + " rows=" + str(w1 + w2 + w3 + w4))
    if md2 > 0.0:
        fails = fails + 1

    if fails == 0:
        print("BF RESULT: ALL PASS")
    else:
        print("BF RESULT: " + str(fails) + " FAILS")
    print("BF done")
    return 0
