import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    ih = 4 * h
    V = VocabSize
    NL = NLayers
    print("=== 2 lenh ATen cua mlp_bwd, 4 BO WEIGHT THAT (72 MB > L3 15 MB) ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    w1a = t_zeros([h, ih])
    w1b = t_zeros([h, ih])
    w1c = t_zeros([h, ih])
    w1d = t_zeros([h, ih])
    w2a = t_zeros([ih, h])
    w2b = t_zeros([ih, h])
    w2c = t_zeros([ih, h])
    w2d = t_zeros([ih, h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    inner = t_zeros([n, ih])
    at = t_zeros([n, ih])
    dxs2 = t_zeros([n, ih])
    dxs1 = t_zeros([n, h])
    dbuf = t_zeros([n, ih])
    xd = x.data
    gd = gout.data
    ad = at.data
    d2d = dxs2.data
    d1d = dxs1.data
    ind = inner.data
    dbd = dbuf.data
    w1ad = w1a.data
    w1bd = w1b.data
    w1cd = w1c.data
    w1dd = w1d.data
    w2ad = w2a.data
    w2bd = w2b.data
    w2cd = w2c.data
    w2dd = w2d.data
    base = V * h + MaxPos * h + h + h
    stride = h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h
    print("4 bo w1 + 4 bo w2 = " + str(8 * h * ih * 4 / 1048576.0) + " MB")

    ow1a = base + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1a = ow1a + 4 * h * h
    ow2a = ob1a + 4 * h
    ob2a = ow2a + 4 * h * h
    b1 = base + stride
    ow1b = b1 + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1b = ow1b + 4 * h * h
    ow2b = ob1b + 4 * h
    ob2b = ow2b + 4 * h * h
    b2 = base + 2 * stride
    ow1c = b2 + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1c = ow1c + 4 * h * h
    ow2c = ob1c + 4 * h
    ob2c = ow2c + 4 * h * h
    b3 = base + 3 * stride
    ow1d = b3 + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1d = ow1d + 4 * h * h
    ow2d = ob1d + 4 * h
    ob2d = ow2d + 4 * h * h

    # warm
    r = onednn_linear_bwd_off(ad, gd, w2ad, d2d, gflat, n, ih, h, ow2a, ob2a)
    r = onednn_linear_bwd_off(ad, gd, w2bd, d2d, gflat, n, ih, h, ow2b, ob2b)
    r = onednn_linear_bwd_off(ad, gd, w2cd, d2d, gflat, n, ih, h, ow2c, ob2c)
    r = onednn_linear_bwd_off(ad, gd, w2dd, d2d, gflat, n, ih, h, ow2d, ob2d)
    r = onednn_linear_bwd_off(xd, dbd, w1ad, d1d, gflat, n, h, ih, ow1a, ob1a)
    r = onednn_linear_bwd_off(xd, dbd, w1bd, d1d, gflat, n, h, ih, ow1b, ob1b)
    r = onednn_linear_bwd_off(xd, dbd, w1cd, d1d, gflat, n, h, ih, ow1c, ob1c)
    r = onednn_linear_bwd_off(xd, dbd, w1dd, d1d, gflat, n, h, ih, ow1d, ob1d)

    t0 = now_ms()
    ra = onednn_linear_bwd_off(ad, gd, w2ad, d2d, gflat, n, ih, h, ow2a, ob2a)
    tA1 = now_ms() - t0
    t0 = now_ms()
    rb = torch_gelu_bwd(d2d, ind, dbd, n * ih)
    tB1 = now_ms() - t0
    t0 = now_ms()
    rc = onednn_linear_bwd_off(xd, dbd, w1ad, d1d, gflat, n, h, ih, ow1a, ob1a)
    tC1 = now_ms() - t0

    t0 = now_ms()
    ra = onednn_linear_bwd_off(ad, gd, w2bd, d2d, gflat, n, ih, h, ow2b, ob2b)
    tA2 = now_ms() - t0
    t0 = now_ms()
    rb = torch_gelu_bwd(d2d, ind, dbd, n * ih)
    tB2 = now_ms() - t0
    t0 = now_ms()
    rc = onednn_linear_bwd_off(xd, dbd, w1bd, d1d, gflat, n, h, ih, ow1b, ob1b)
    tC2 = now_ms() - t0

    t0 = now_ms()
    ra = onednn_linear_bwd_off(ad, gd, w2cd, d2d, gflat, n, ih, h, ow2c, ob2c)
    tA3 = now_ms() - t0
    t0 = now_ms()
    rb = torch_gelu_bwd(d2d, ind, dbd, n * ih)
    tB3 = now_ms() - t0
    t0 = now_ms()
    rc = onednn_linear_bwd_off(xd, dbd, w1cd, d1d, gflat, n, h, ih, ow1c, ob1c)
    tC3 = now_ms() - t0

    t0 = now_ms()
    ra = onednn_linear_bwd_off(ad, gd, w2dd, d2d, gflat, n, ih, h, ow2d, ob2d)
    tA4 = now_ms() - t0
    t0 = now_ms()
    rb = torch_gelu_bwd(d2d, ind, dbd, n * ih)
    tB4 = now_ms() - t0
    t0 = now_ms()
    rc = onednn_linear_bwd_off(xd, dbd, w1dd, d1d, gflat, n, h, ih, ow1d, ob1d)
    tC4 = now_ms() - t0

    tA = tA1 + tA2 + tA3 + tA4
    tB = tB1 + tB2 + tB3 + tB4
    tC = tC1 + tC2 + tC3 + tC4
    print("A) r2  [n,ih]x[ih,h]  " + str(tA1) + " " + str(tA2) + " " + str(tA3) + " " + str(tA4) + "  TB=" + str(tA / 4.0) + " ms  rc=" + str(ra))
    print("B) gelu_bwd           " + str(tB1) + " " + str(tB2) + " " + str(tB3) + " " + str(tB4) + "  TB=" + str(tB / 4.0) + " ms")
    print("C) r1  [n,h]x[h,ih]   " + str(tC1) + " " + str(tC2) + " " + str(tC3) + " " + str(tC4) + "  TB=" + str(tC / 4.0) + " ms  rc=" + str(rc))
    print("---")
    print("A+B+C TB/layer = " + str((tA + tB + tC) / 4.0) + " ms")
    print("GFLOP/s A = " + str(4.0 * n * h * ih / 1e9 / (tA / 4.0 / 1000.0)))
    print("GFLOP/s C = " + str(4.0 * n * h * ih / 1e9 / (tC / 4.0 / 1000.0)))
    return 0
