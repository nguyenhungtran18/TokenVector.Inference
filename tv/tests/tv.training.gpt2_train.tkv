# G4 x G2: NOI TRAINER VAO GPT-2 (ROADMAP_TRAIN — muc tieu 2/3 cua §2)
#
# AdamW cua `trainer.tkv` lam viec tren MOT vector phang, con GPT-2 (`gpt2_ref`)
# giu 28 tensor rieng. Module nay lam cau noi:
#   - flatten/unflatten trong so (thu tu CO DINH = dung thu tu dau ra cua
#     `gpt2_backward`, cung la thu tu `gpt2_init`)
#   - mot buoc train that: forward -> loss -> backward -> clip -> AdamW -> ghi
#     trong so tro lai tensor
#   - checkpoint dung nguyen dinh dang cua trainer (bit f32 -> resume bit-exact)
#
# Thu tu 28 tensor (index trong list):
#   [0] wte  [1] wpe  [2] lnf_g  [3] lnf_b
#   layer li: base = 4 + li*12
#     0 ln1_g  1 ln1_b  2 w_qkv  3 b_qkv  4 w_proj  5 b_proj
#     6 ln2_g  7 ln2_b  8 w1     9 b1    10 w2     11 b2

import tv.training.gpt2_ref
import tv.training.trainer

def gpt2_group_sizes(ps: 'list[Tensor]') -> 'list[i64]':
    # kich thuoc tung tensor -> nhom cho grad norm (giong PyTorch: L2 tung
    # tensor roi L2 cac norm)
    out = []
    for i in range(len(ps)):
        # quirk compiler: `ps[i].data` truc tiep bi hieu sai dtype — phai
        # gan Tensor ra bien roi moi lay .data.
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def gpt2_n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def gpt2_flatten(ps: 'list[Tensor]') -> 'list[f32]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            out.append(d[j])
    return out

def gpt2_unflatten(ps: 'list[Tensor]', flat: 'list[f32]') -> 'i32':
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = flat[off + j]
        off = off + len(d)
    return 0

def gpt2_copy_into(dst: 'list[f32]', src: 'list[f32]') -> 'i32':
    for i in range(len(src)):
        dst[i] = src[i]
    return 0

# ---- goi model voi ps (thay vi 20 tham so roi) -----------------------------

def gpt2_fwd_ps(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]') -> "Tensor":
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    _wte = ps[0]
    _wpe = ps[1]
    _g = ps[2]
    _b = ps[3]
    return gpt2_forward(ids, pos, _wte, _wpe, ln1_g, ln1_b, wq, bq, wp, bp,
                        ln2_g, ln2_b, w1, b1, w2, b2, _g, _b)

def gpt2_bwd_ps(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]') -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    _wte = ps[0]
    _wpe = ps[1]
    _g = ps[2]
    _b = ps[3]
    return gpt2_backward(ids, pos, _wte, _wpe, ln1_g, ln1_b, wq, bq, wp, bp,
                         ln2_g, ln2_b, w1, b1, w2, b2, _g, _b)

def gpt2_loss_of(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]') -> 'f32':
    z = gpt2_fwd_ps(ps, ids, pos)
    return gpt2_loss(z, ids)

# ---- mot buoc train --------------------------------------------------------

def gpt2_train_step(opt: "AdamW", ps: 'list[Tensor]',
                    ids: 'list[i64]', pos: 'list[i64]') -> 'f32':
    loss = gpt2_loss_of(ps, ids, pos)
    grads = gpt2_bwd_ps(ps, ids, pos)
    opt.zero_grad()
    off = 0
    for i in range(len(grads)):
        gt = grads[i]
        d = gt.data
        for j in range(len(d)):
            opt.g[off + j] = opt.g[off + j] + d[j]
        off = off + len(d)
    opt.step()
    # ghi trong so da cap nhat tro lai tensor
    gpt2_unflatten(ps, opt.p)
    return loss

def gpt2_train_steps(opt: "AdamW", ps: 'list[Tensor]',
                     ids: 'list[i64]', pos: 'list[i64]', n_steps: 'i64') -> 'list[f32]':
    losses = []
    for s in range(n_steps):
        losses.append(gpt2_train_step(opt, ps, ids, pos))
    return losses
