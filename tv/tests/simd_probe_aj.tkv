# BENCH 124M — GPT-2 that (12/12/768, vocab50257), seq8 cung fixture g2
# Import CHI ref124 + trainer: KHONG import gpt2_ref/gpt2_train (mirror nho 256/64).
# Flatten/unflatten/group inline (ps-driven) vi gpt2_train gan voi ban nho.
# In so lieu tong ms + so buoc (chia tay ngoai):
#   tkvc tv/tests/simd_bench_124m.tkv %TEMP%/b124.exe main && %TEMP%/b124.exe
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> "list[f32]":
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

# ---- forward + loss (ban sao gpt2_fwd_ps, ten rieng de tranh clash) --------
def _f124_loss(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'f32':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    z = gpt2_forward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                     ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd)
    return gpt2_loss(z, ids)

# ---- backward (ban sao gpt2_bwd_ps) ----------------------------------------
def _f124_bwd(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_backward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                         ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd)

# ---- 1 buoc train day du (ban sao gpt2_train_step, flatten inline) ----------
# (P1.2 fused da REVERT sau probe simd_probe_ah: fused cham hon — giu 2 vong.)
def _step124(opt: "AdamW", ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32') -> 'f32':
    loss = _f124_loss(ps, ids, pos, simd)
    grads = _f124_bwd(ps, ids, pos, simd)
    opt.zero_grad()
    off = 0
    for i in range(len(grads)):
        gt = grads[i]
        d = gt.data
        for j in range(len(d)):
            opt.g[off + j] = opt.g[off + j] + d[j]
        off = off + len(d)
    opt.step()
    # ghi trong so da cap nhat tro lai tensor (unflatten inline)
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)
    return loss

# ---- chuan bi: nhom + copy ps vao opt.p (inline) ---------------------------
def _prepare(opt: "AdamW", ps: 'list[Tensor]') -> 'i32':
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            opt.p[off + j] = d[j]
        off = off + len(d)
    return 0

def _n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def _groups(ps: 'list[Tensor]') -> 'list[i64]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def _mk_opt(n: 'i64', groups: 'list[i64]', total: 'i64') -> "AdamW":
    return new_adamw_g(n, groups, 2, total, 0.05, 0.0025, 0.9, 0.999,
                       0.00000001, 0.0, 1.0)

def main() -> 'i32':
    # PROBE AJ — GC per phase cua 1 buoc 124M (P1.3 perf-plan):
    # moi phase: do ms + gc_collect + gc_allocated_bytes (live heap) + delta
    # gc_counts() (gen0/1/2 collection count = proxy churn).
    FIX = "tv/tests/fixtures/"
    ids = load_ints(FIX + "g2_ids.txt")
    pos = load_ints(FIX + "g2_pos.txt")
    ps = gpt2_init(7)
    n = _n_param(ps)
    groups = _groups(ps)
    opt = _mk_opt(n, groups, 4)
    _prepare(opt, ps)
    # warmup 1 buoc day du (JIT + cache)
    _ = _step124(opt, ps, ids, pos, 1)

    gc_collect()
    b0 = gc_allocated_bytes()
    c0 = gc_counts()
    t0 = now_ms()
    loss = _f124_loss(ps, ids, pos, 1)
    t1 = now_ms()
    gc_collect()
    a1 = gc_allocated_bytes()
    c1 = gc_counts()
    print("AJ1 FWD+LOSS  ms=" + str(t1 - t0) + " liveMB=" + str((a1 - b0) / 1048576.0) + " gen=" + str(c0) + "->" + str(c1))

    grads = _f124_bwd(ps, ids, pos, 1)
    t2 = now_ms()
    gc_collect()
    a2 = gc_allocated_bytes()
    c2 = gc_counts()
    print("AJ2 BWD       ms=" + str(t2 - t1) + " liveMB=" + str((a2 - a1) / 1048576.0) + " gen=" + str(c1) + "->" + str(c2))

    opt.zero_grad()
    t3 = now_ms()
    gc_collect()
    a3 = gc_allocated_bytes()
    c3 = gc_counts()
    print("AJ3 ZERO_GRAD ms=" + str(t3 - t2) + " liveMB=" + str((a3 - a2) / 1048576.0) + " gen=" + str(c2) + "->" + str(c3))

    o2 = 0
    for i in range(len(grads)):
        gt = grads[i]
        d = gt.data
        for j in range(len(d)):
            opt.g[o2 + j] = opt.g[o2 + j] + d[j]
        o2 = o2 + len(d)
    t4 = now_ms()
    gc_collect()
    a4 = gc_allocated_bytes()
    c4 = gc_counts()
    print("AJ4 GRAD_ACC  ms=" + str(t4 - t3) + " liveMB=" + str((a4 - a3) / 1048576.0) + " gen=" + str(c3) + "->" + str(c4))

    opt.step()
    t5 = now_ms()
    gc_collect()
    a5 = gc_allocated_bytes()
    c5 = gc_counts()
    print("AJ5 ADAMW     ms=" + str(t5 - t4) + " liveMB=" + str((a5 - a4) / 1048576.0) + " gen=" + str(c4) + "->" + str(c5))

    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)
    t6 = now_ms()
    gc_collect()
    a6 = gc_allocated_bytes()
    c6 = gc_counts()
    print("AJ6 UNFLAT    ms=" + str(t6 - t5) + " liveMB=" + str((a6 - a5) / 1048576.0) + " gen=" + str(c5) + "->" + str(c6))
    print("AJ TONG       ms=" + str(t6 - t0) + " totalLiveMB=" + str((a6 - b0) / 1048576.0) + " gen=" + str(c0) + "->" + str(c6))
    print("AJ loss=" + str(loss))
    return 0
