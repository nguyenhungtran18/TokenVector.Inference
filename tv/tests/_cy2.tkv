# PROBE TAM _cy2 — kich ban kieu list cho M4 (Tensor.data = List[Double]?)
#   T5: local list khai ro `out: "list[f32]" = []` trong ham -> "Tensor" —
#       co ép List[Single] khong? (neu CO -> wire M4 duoc, chi sua 1 dong/builder)
#   T6: bo chuyen doi _as32 (rebuild append) — thoi gian 38M ptu + kieu ket qua
import tv.training.tensor

# T5 — builder voi local list khai ro kieu
def _mkT5(n: 'i64') -> "Tensor":
    out: "list[f32]" = []
    for i in range(n):
        out.append(0.0)
    return Tensor(out, [n], 0)

# T6 — bo chuyen doi Double -> Single (rebuild)
def _as32(d: "list[f32]", n: 'i64') -> "list[f32]":
    out = []
    for i in range(n):
        out.append(d[i])
    return out

def _fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def main() -> 'i32':
    m: "i64" = 64
    n: "i64" = 48
    k: "i64" = 80
    T: "i64" = 64

    # ---- T5: Tensor tao boi builder co local list khai ro kieu -------------
    t5a = _mkT5(m * k)
    rv1 = _fill(t5a.data, m * k, 1)
    t5b = _mkT5(k * n)
    rv2 = _fill(t5b.data, k * n, 2)
    c5 = _mkT5(m * n)
    a5 = t5a.data
    b5 = t5b.data
    c5d = c5.data
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(a5, m, k, k, T, 0)
    hB = simd_gemm_packed_create(b5, k, n, n, T, 0)
    st5 = simd_gemm_packed(hA, hB, c5d, T)
    print("CY2 T5 builder+local-annot packed st=" + str(st5) + " c5d[0]=" + str(c5d[0]))

    # ---- T6: bo chuyen doi (rebuild) — do thoi gian 38M --------------------
    big = t_zeros([1000000, 38])
    rvb = _fill(big.data, 38000000, 5)
    best = 1.0e18
    conv = []
    q = 0
    while q < 3:
        t0 = now_ms()
        conv = _as32(big.data, 38000000)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY2 T6 _as32 rebuild 38M ptu best=" + str(best) + " ms len=" + str(len(conv)))

    # kieu ket qua cua _as32 co dung cho packed khong?
    small = t_zeros([m, k])
    rvs = _fill(small.data, m * k, 9)
    a6 = _as32(small.data, m * k)
    b6 = _as32(t5b.data, k * n)
    t6c = _mkT5(m * n)
    c6 = t6c.data
    hA6: "i64" = 0
    hB6: "i64" = 0
    hA6 = simd_gemm_packed_create(a6, m, k, k, T, 0)
    hB6 = simd_gemm_packed_create(b6, k, n, n, T, 0)
    st6 = simd_gemm_packed(hA6, hB6, c6, T)
    print("CY2 T6b packed tu _as32(Tensor.data) st=" + str(st6) + " c6[0]=" + str(c6[0]))
    print("CY2 done")
    return 0