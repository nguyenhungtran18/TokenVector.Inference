# PROBE TAM _cy3 — profile M5 primitives tai 124M (best-of-3, ms)
# Cau hoi: f32_copy_to_buf/from_buf co THAT su nhanh (reflection 1 lan + memcpy)
# hay cham (lam M5 wire net LOSS nhu do seq8 +4.7%)?
import tv.training.tensor
import tv.training.trainer

# builder co annotation -> ep List[Single] TAI RETURN (append trong main KHONG ep)
def _mkz(n: 'i64') -> "list[f32]":
    out = []
    for i in range(n):
        out.append((float(0) - 0.0) / 1.0)
    return out

def _mko(n: 'i64') -> "list[f32]":
    out = []
    for i in range(n):
        out.append((float(1) - 0.0) / 1.0)
    return out

def main() -> 'i32':
    n: "i64" = 124000000
    print("CY3 n=" + str(n))
    pl = _mkz(n)
    gl = _mkz(n)
    ml = _mkz(n)
    vl = _mko(n)
    i = 0
    while i < n:
        gl[i] = float((i % 13) - 6) * 0.001
        i = i + 1
    pp = alloc_bytes(n * 4)
    pm = alloc_bytes(n * 4)
    pv = alloc_bytes(n * 4)
    pg = alloc_bytes(n * 4)

    # copy_to_buf best-of-3
    best = 1.0e18
    q = 0
    while q < 3:
        t0 = now_ms()
        r1 = f32_copy_to_buf(gl, pg, n)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY3 copy_to_buf(g 124M) best=" + str(best) + " ms r=" + str(r1))

    best = 1.0e18
    q = 0
    while q < 3:
        t0 = now_ms()
        r2 = f32_copy_to_buf(pl, pp, n)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY3 copy_to_buf(p 124M) best=" + str(best) + " ms")

    # adamw_step native best-of-3
    best = 1.0e18
    q = 0
    while q < 3:
        t0 = now_ms()
        st = adamw_step(pp, pm, pv, pg, n, 0.001, 0.9, 0.999, 0.00000001, 0.0, 0.9, 0.031)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY3 adamw_step native best=" + str(best) + " ms st=" + str(st))

    # copy_from_buf best-of-3
    best = 1.0e18
    q = 0
    while q < 3:
        t0 = now_ms()
        r3 = f32_copy_from_buf(pp, pl, n)
        t1 = now_ms()
        d1 = t1 - t0
        if d1 < best:
            best = d1
        q = q + 1
    print("CY3 copy_from_buf(p 124M) best=" + str(best) + " ms")

    # reference: vong interpreted cu (1 phan tu 4 phep toan) — 1 lan
    t0 = now_ms()
    i = 0
    while i < n:
        gi = gl[i]
        pl[i] = pl[i] * 0.999
        ml[i] = 0.9 * ml[i] + 0.1 * gi
        vl[i] = 0.999 * vl[i] + 0.001 * gi * gi
        pl[i] = pl[i] - 0.001 * ml[i] / (sqrt(vl[i]) + 1.0)
        i = i + 1
    t1 = now_ms()
    print("CY3 vong interpreted cu (reference) = " + str(t1 - t0) + " ms")
    print("CY3 done")
    return 0