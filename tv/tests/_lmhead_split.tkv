# PROBE LM-HEAD / EMBED BWD SPLIT (HANDOFF §0.131 muc 5 - uu tien (b))
# Muc dich: phan NGOAI 12 layer = 522 ms/step (do o _bwd_outer.tkv). Boc ra:
#   1) lmhead_bwd_fused_list (softmax-grad + dxf + dwte) - GEMM that
#   2) dwte  = t_zeros([VocabSize, h])   = 38.6M float = 154 MB zero-fill
#   3) gwte_e = t_zeros([VocabSize * h]) = 38.6M float = 154 MB zero-fill
#   4) f32_list_add 38.6M x2 (dwte+=gwte_e, gflat+=dwte)
#   5) op_embed_bwd cho wpe
#   6) gpt2_layernorm_bwd cho lnf
#   7) vong managed `for k in range(MaxPos*h)` = 786K
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_lmhead_split.tkv out/lsp.exe main
#   copy -> out/lsp_n10.dll + runtimeconfig ; dotnet out/lsp_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize
    nv = V * h

    xf = t_zeros([n, h])
    wte = t_zeros([V, h])
    wpe = t_zeros([MaxPos, h])
    lnf_g = t_zeros([h])
    lnf_b = t_zeros([h])
    gx = t_zeros([n, h])
    gout = t_zeros([n, h])

    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % V)
        i = i + 1
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1

    print("=== LMHEAD/EMBED BWD SPLIT seq=" + str(n) + " V=" + str(V) + " nv=" + str(nv) + " ===")

    # ---- 1) lmhead_bwd_fused_list (GEMM that) ----
    dxf = t_zeros([n, h])
    dwte = t_zeros([V, h])
    # logits [n, V] = 51.5M float = 206 MB. Trong production day la saves[0]
    # (da tinh trong forward), KHONG cap phat o bwd. Probe cap 1 lan o day.
    logits = t_zeros([n, V])
    m6_pids = alloc_bytes(n * 4)
    m6_i = 0
    while m6_i < n:
        _w = write_i32(m6_pids, m6_i * 4, ids[m6_i])
        m6_i = m6_i + 1
    _lgd = logits.data
    _wtd = wte.data
    _xfd = xf.data
    _dd = dxf.data
    _dw = dwte.data
    m6_sc: "f32" = 1.0 / float(n)
    st = lmhead_bwd_fused_list(_lgd, m6_pids, _wtd, _xfd, _dd, _dw, n, 1, h, V, m6_sc)
    best1 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        st = lmhead_bwd_fused_list(_lgd, m6_pids, _wtd, _xfd, _dd, _dw, n, 1, h, V, m6_sc)
        dt = now_ms() - t0
        if dt < best1:
            best1 = dt
        kk = kk + 1
    print("1) lmhead_bwd_fused_list    best-of-5 ms=" + str(best1) + "  st=" + str(st))

    # ---- 2) dwte = t_zeros([V,h]) 154 MB ----
    best2 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        z = t_zeros([V, h])
        dt = now_ms() - t0
        if dt < best2:
            best2 = dt
        kk = kk + 1
    print("2) t_zeros([V,h]) 154MB     best-of-5 ms=" + str(best2))

    # ---- 3) gwte_e = t_zeros([V*h]) 154 MB ----
    best3 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        z2 = t_zeros([nv])
        dt = now_ms() - t0
        if dt < best3:
            best3 = dt
        kk = kk + 1
    print("3) t_zeros([V*h]) 154MB     best-of-5 ms=" + str(best3))

    # ---- 4) f32_list_add 38.6M ----
    gwte_e = t_zeros([nv])
    hold = t_zeros([nv])
    _dwl = dwte.data
    _gwl = gwte_e.data
    _hld = hold.data
    rs = f32_list_add(_dwl, _gwl, nv)
    best4 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        rs = f32_list_add(_dwl, _gwl, nv)
        dt = now_ms() - t0
        if dt < best4:
            best4 = dt
        kk = kk + 1
    print("4) f32_list_add 38.6M       best-of-5 ms=" + str(best4) + "  rs=" + str(rs))

    # ---- 5) op_embed_bwd cho wpe ----
    best5 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        gwpe = op_embed_bwd(wpe, pos, h, gx)
        dt = now_ms() - t0
        if dt < best5:
            best5 = dt
        kk = kk + 1
    print("5) op_embed_bwd wpe         best-of-5 ms=" + str(best5))

    # ---- 6) gpt2_layernorm_bwd lnf ----
    hold2 = t_zeros([2 * h])
    gfl2 = hold2.data
    _xfin = gx.data
    _lnfg = lnf_g.data
    _lnfb = lnf_b.data
    _dxfd = dxf.data
    best6 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        rl = gpt2_layernorm_bwd(gx, lnf_g, lnf_b, dxf, gfl2, 0, h)
        dt = now_ms() - t0
        if dt < best6:
            best6 = dt
        kk = kk + 1
    print("6) gpt2_layernorm_bwd lnf   best-of-5 ms=" + str(best6))

    # ---- 7) vong managed MaxPos*h = 786K ----
    best7 = 1.0e9
    kk = 0
    while kk < 5:
        t0 = now_ms()
        for k in range(MaxPos * h):
            _hld[k] = _hld[k] + 0.0
        dt = now_ms() - t0
        if dt < best7:
            best7 = dt
        kk = kk + 1
    print("7) vong managed 786K        best-of-5 ms=" + str(best7))

    tot = best1 + best2 + best3 + best4 * 2.0 + best5 + best6 + best7
    print("SUM 1..7 (f32_list_add x2) = " + str(tot))
    return 0
