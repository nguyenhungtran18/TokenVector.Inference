import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    hd = HeadDim
    ih = 4 * h
    V = VocabSize
    NL = NLayers
    print("=== 5 manh duong NATIVE cua gpt2_attention_bwd ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    wqkv = t_zeros([h, 3 * h])
    wproj = t_zeros([h, h])
    bqkv = t_zeros([3 * h])
    bproj = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    abuf = []
    abuf.append(t_zeros([n, ih]))
    abuf.append(t_zeros([n, h]))
    j = 2
    while j < 12:
        abuf.append(t_zeros([n, ih]))
        j = j + 1
    qkv = t_zeros([n, 3 * h])
    dctxT = t_zeros([n, h])
    ctxT = t_zeros([n, h])
    dqkv = t_zeros([n, 3 * h])
    qkvd = qkv.data
    dcd = dctxT.data
    ctd = ctxT.data
    dqd = dqkv.data
    gd = gout.data
    inv = 1.0 / sqrt(float(hd))
    base = V * h + MaxPos * h + h + h
    oq = base + h + h
    obq = oq + 3 * h * h
    op = obq + 3 * h
    obp = op + h * h

    q = gpt2_linear(x, wqkv, bqkv, n, h, 3 * h, 1, qkv)
    c = smm_dot(gout, wproj, n, h, h)
    r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, n, h, hd, inv, NHeads)
    l = linear_dw_fused(ctd, gd, gflat, op, n, h, h)
    lb = gpt2_linear_bwd(x, wqkv, dqkv, n, h, 3 * h, 1, gflat, oq, obq)

    t0 = now_ms()
    i = 0
    while i < 5:
        q = gpt2_linear(x, wqkv, bqkv, n, h, 3 * h, 1, qkv)
        i = i + 1
    t1 = (now_ms() - t0) / 5.0
    t0 = now_ms()
    i = 0
    while i < 5:
        c = smm_dot(gout, wproj, n, h, h)
        i = i + 1
    t2 = (now_ms() - t0) / 5.0
    t0 = now_ms()
    i = 0
    while i < 5:
        r = attention_bwd_merge_multi(qkvd, dcd, ctd, dqd, n, h, hd, inv, NHeads)
        i = i + 1
    t3 = (now_ms() - t0) / 5.0
    t0 = now_ms()
    i = 0
    while i < 5:
        l = linear_dw_fused(ctd, gd, gflat, op, n, h, h)
        i = i + 1
    t4 = (now_ms() - t0) / 5.0
    t0 = now_ms()
    i = 0
    while i < 5:
        lb = gpt2_linear_bwd(x, wqkv, dqkv, n, h, 3 * h, 1, gflat, oq, obq)
        i = i + 1
    t5 = (now_ms() - t0) / 5.0
    print("1) qkv fwd gpt2_linear       = " + str(t1) + " ms")
    print("2) dctxT smm_dot             = " + str(t2) + " ms")
    print("3) attention_bwd_merge_multi = " + str(t3) + " ms  rc=" + str(r))
    print("4) linear_dw_fused dw_proj   = " + str(t4) + " ms  rc=" + str(l))
    print("5) gpt2_linear_bwd qkv       = " + str(t5) + " ms")
    s = t1 + t2 + t3 + t4 + t5
    print("   TONG 5 manh               = " + str(s) + " ms")
    print("   ca ham native do duoc     = 105.25 ms")
    print("   glue .tkv                 = " + str(105.25 - s) + " ms")
    return 0
