import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    hd = HeadDim
    V = VocabSize
    NL = NLayers
    print("=== .tkv A/B 4 bo weight: ATen vs native (lap lai de chac) ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    wqa = t_zeros([h, 3 * h])
    wqb = t_zeros([h, 3 * h])
    wqc = t_zeros([h, 3 * h])
    wqd = t_zeros([h, 3 * h])
    wpa = t_zeros([h, h])
    wpb = t_zeros([h, h])
    wpc = t_zeros([h, h])
    wpd = t_zeros([h, h])
    bqkv = t_zeros([3 * h])
    bproj = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    abuf = []
    abuf.append(t_zeros([n, 4 * h]))
    abuf.append(t_zeros([n, h]))
    j = 2
    while j < 12:
        abuf.append(t_zeros([n, 4 * h]))
        j = j + 1
    base = V * h + MaxPos * h + h + h
    stride = h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h
    oa = base + h + h
    oba = oa + 3 * h * h
    opa = oba + 3 * h
    obpa = opa + h * h
    ob = base + stride + h + h
    obb = ob + 3 * h * h
    opb = obb + 3 * h
    obpb = opb + h * h
    oc = base + 2 * stride + h + h
    obc = oc + 3 * h * h
    opc = obc + 3 * h
    obpc = opc + h * h
    od = base + 3 * stride + h + h
    obd = od + 3 * h * h
    opd = obd + 3 * h
    obpd = opd + h * h

    r = gpt2_attention_bwd(x, wqa, bqkv, wpa, bproj, n, gout, 1, gflat, oa, oba, opa, obpa, abuf)
    r = gpt2_attention_bwd(x, wqb, bqkv, wpb, bproj, n, gout, 1, gflat, ob, obb, opb, obpb, abuf)
    r = gpt2_attention_bwd(x, wqc, bqkv, wpc, bproj, n, gout, 1, gflat, oc, obc, opc, obpc, abuf)
    r = gpt2_attention_bwd(x, wqd, bqkv, wpd, bproj, n, gout, 1, gflat, od, obd, opd, obpd, abuf)
    r = gpt2_attention_bwd(x, wqa, bqkv, wpa, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
    r = gpt2_attention_bwd(x, wqb, bqkv, wpb, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
    r = gpt2_attention_bwd(x, wqc, bqkv, wpc, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
    r = gpt2_attention_bwd(x, wqd, bqkv, wpd, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)

    k = 0
    while k < 3:
        t0 = now_ms()
        r = gpt2_attention_bwd(x, wqa, bqkv, wpa, bproj, n, gout, 1, gflat, oa, oba, opa, obpa, abuf)
        r = gpt2_attention_bwd(x, wqb, bqkv, wpb, bproj, n, gout, 1, gflat, ob, obb, opb, obpb, abuf)
        r = gpt2_attention_bwd(x, wqc, bqkv, wpc, bproj, n, gout, 1, gflat, oc, obc, opc, obpc, abuf)
        r = gpt2_attention_bwd(x, wqd, bqkv, wpd, bproj, n, gout, 1, gflat, od, obd, opd, obpd, abuf)
        ta = (now_ms() - t0) / 4.0
        t0 = now_ms()
        r = gpt2_attention_bwd(x, wqa, bqkv, wpa, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
        r = gpt2_attention_bwd(x, wqb, bqkv, wpb, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
        r = gpt2_attention_bwd(x, wqc, bqkv, wpc, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
        r = gpt2_attention_bwd(x, wqd, bqkv, wpd, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
        tb = (now_ms() - t0) / 4.0
        print("lan " + str(k + 1) + ": ATen = " + str(ta) + "  native = " + str(tb) + "  ti le = " + str(tb / ta))
        k = k + 1
    return 0
