# PROBE OPT.STEP WRAPPER (HANDOFF §0.132 - uu tien (c), buoc 4)
# Su that da do:
#   opt.step() (method tren class)  = 1157 ms
#   chep than ham ra main           =  484 ms
# Cung phep tinh. Doc field = 0.0 ms (probe _field_read). _bp/lr_at trivial.
# => Nghi: chi phi nam o GOI METHOD tren class instance, khong phai than ham.
#
# Probe nay tach 3 duong, do XEN KE trong cung vong lap de loai nhieu:
#   A) opt.step()             - method, doc self.*
#   B) _body(opt)             - ham tu do, tham so la instance, doc o.*
#   C) inline trong main      - bien local
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_opt_wrap.tkv out/owr.exe main
#   copy -> out/owr_n10.dll + runtimeconfig ; dotnet out/owr_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.trainer

def _body(opt: "AdamW") -> 'f32':
    # chep NGUYEN VAN than AdamW.step() voi clip=1.0 (bench dung clip=1.0)
    lr = lr_at(opt.t, opt.warmup, opt.total, opt.lr_max, opt.lr_min)
    t1 = opt.t + 1
    bc1 = 1.0 - _bp(opt.b1, t1)
    bc2 = 1.0 - _bp(opt.b2, t1)
    step_size = lr / bc1
    bc2s = sqrt(bc2)
    gl = opt.g
    pl = opt.p
    pgl = opt.pg
    ppl = opt.pp
    pml = opt.pm
    pvl = opt.pv
    r1 = f32_copy_to_buf(gl, pgl, opt.n)
    if opt.pdirty != 0:
        r2 = f32_copy_to_buf(pl, ppl, opt.n)
        opt.pdirty = 0
    wde = opt.wd * bc1
    stw = adamw_step(ppl, pml, pvl, pgl, opt.n,
                     step_size, opt.b1, opt.b2, opt.eps, wde, bc1, bc2s)
    r3 = f32_copy_from_buf(ppl, pl, opt.n)
    opt.t = opt.t + 1
    return lr

def main() -> 'i32':
    n = 124439808
    print("=== OPT.STEP WRAPPER n=" + str(n) + " ===")

    groups: "list[i64]" = [n]
    opt = new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999, 1.0e-8, 0.0, 1.0)
    opt.t = 0
    gl = opt.g
    i = 0
    while i < n:
        gl[i] = 0.001
        i = i + 1
    pl = opt.p
    i = 0
    while i < n:
        pl[i] = 0.02
        i = i + 1
    opt.push_p()

    ppl = opt.pp
    pml = opt.pm
    pvl = opt.pv
    pgl = opt.pg

    # lam nong: 2 vong moi duong truoc khi do
    _w0 = opt.step()
    _w1 = _body(opt)

    bestA = 1.0e9
    bestB = 1.0e9
    bestC = 1.0e9
    kk = 0
    while kk < 4:
        # C) inline TRUOC (kiem chung bias thu tu)
        t0 = now_ms()
        lrC = lr_at(opt.t, opt.warmup, opt.total, opt.lr_max, opt.lr_min)
        t1 = opt.t + 1
        bc1c = 1.0 - _bp(opt.b1, t1)
        bc2c = 1.0 - _bp(opt.b2, t1)
        ssc = lrC / bc1c
        bc2sc = sqrt(bc2c)
        r1c = f32_copy_to_buf(gl, pgl, n)
        if opt.pdirty != 0:
            r2c = f32_copy_to_buf(pl, ppl, n)
            opt.pdirty = 0
        wdec = opt.wd * bc1c
        stwc = adamw_step(ppl, pml, pvl, pgl, n, ssc, opt.b1, opt.b2, opt.eps, wdec, bc1c, bc2sc)
        r3c = f32_copy_from_buf(ppl, pl, n)
        opt.t = opt.t + 1
        dtC = now_ms() - t0
        if dtC < bestC:
            bestC = dtC
        # B) ham tu do
        t0 = now_ms()
        lrB = _body(opt)
        dtB = now_ms() - t0
        if dtB < bestB:
            bestB = dtB
        # A) method (CUOI)
        t0 = now_ms()
        lrA = opt.step()
        dtA = now_ms() - t0
        if dtA < bestA:
            bestA = dtA
        kk = kk + 1

    print("THU TU DAO: C -> B -> A")
    print("A) opt.step()  method        best-of-4 ms=" + str(bestA) + "  lr=" + str(lrA))
    print("B) _body(opt)  ham tu do     best-of-4 ms=" + str(bestB) + "  lr=" + str(lrB))
    print("C) inline      bien local    best-of-4 ms=" + str(bestC) + "  lr=" + str(lrC))
    print("A-B = " + str(bestA - bestB) + "   B-C = " + str(bestB - bestC))
    return 0
