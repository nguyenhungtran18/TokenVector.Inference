# PROBE GEMM TRANS-A (2026-11-10) — trans-A co phai thu pham khong?
# Cung shape, chi khac co transpose A hay khong:
#   smm_fwd_pd(a[V,n], b[n,h], V, h, n)     -> khong trans
#   smm_fwd_at_pd(a[V,n], b[n,h], V, h, n)  -> trans-A
import tv.training.gpt2_ref124
import tv.training.simd_matmul

def main() -> 'i32':
    h = HiddenSize
    V = VocabSize
    n = 1024
    print("=== GEMM TRANS-A: [V,n]x[n,h] V=" + str(V) + " n=" + str(n) + " h=" + str(h) + " ===")

    a = t_zeros([V, n])
    b = t_zeros([n, h])
    fl = 2.0 * float(V) * float(h) * float(n)

    # khong trans
    o = smm_fwd_pd(a, b, V, h, n)
    t0 = now_ms()
    o = smm_fwd_pd(a, b, V, h, n)
    t1 = now_ms()
    o = smm_fwd_pd(a, b, V, h, n)
    t2 = now_ms()
    dt_no = min(t1 - t0, t2 - t1)
    print("A) smm_fwd_pd    (no trans) = " + str(dt_no) + " ms -> " + str(fl / (dt_no * 1.0e6)) + " GFLOPS")

    # trans-A
    o2 = smm_fwd_at_pd(a, b, V, h, n)
    t0 = now_ms()
    o2 = smm_fwd_at_pd(a, b, V, h, n)
    t1 = now_ms()
    o2 = smm_fwd_at_pd(a, b, V, h, n)
    t2 = now_ms()
    dt_at = min(t1 - t0, t2 - t1)
    print("B) smm_fwd_at_pd (trans-A)  = " + str(dt_at) + " ms -> " + str(fl / (dt_at * 1.0e6)) + " GFLOPS")
    print("C) trans / no-trans         = " + str(dt_at / dt_no) + "x")
    return 0
