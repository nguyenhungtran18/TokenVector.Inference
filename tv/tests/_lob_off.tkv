import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 2
    h = 4
    ig = 8
    x = t_zeros([n, ig])
    w = t_zeros([ig, h])
    gy = t_zeros([n, h])
    gflat = t_zeros([ig * h + h])
    dx = t_zeros([n, ig])
    xx1 = x.data
    ww1 = w.data
    gg1 = gy.data
    dxx1 = dx.data
    gf1 = gflat.data
    rc = onednn_linear_bwd_off(xx1, gg1, ww1, dxx1, gf1, n, ig, h, 0, ig * h)
    print("rc=" + str(rc))
    return 0
