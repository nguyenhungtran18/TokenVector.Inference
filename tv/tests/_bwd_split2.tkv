# PROBE BWD SPLIT v2 (2026-11-10) — do lai tren DUONG PRODUCTION
#
# Vi sao co probe nay: _block_split.tkv (09:07) va _mlp_split.tkv (09:19) deu
# truyen gflat=None -> roi vao native fallback, KHONG phai duong bench chay.
# HANDOFF §0.131/§0.132 da dinh chinh dung loi nay. Probe nay truyen:
#   - gflat = opt.g THUC (co data, da zero)  -> ATen path
#   - offs  = 12 offset that cua layer       -> onednn_linear_bwd_off
#   - abuf  = 10 slot (co slot 8/9 cua §0.132)
# de so lieu khop voi bench.
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_bwd_split2.tkv out/bws2.exe main
#   copy out/bws2.exe -> out/bws2_n10.dll + runtimeconfig ; dotnet out/bws2_n10.dll
#
# LUU Y bug #8: now_ms() chi dat trong main. Moi ham chi 1 list phang (bug #2).
import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    h4 = 4 * h
    h3 = 3 * h

    # ---- tham so (gia tri 0 la du cho timing; cung so phep) ----
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    ln1_g = t_zeros([h])
    ln1_b = t_zeros([h])
    ln2_g = t_zeros([h])
    ln2_b = t_zeros([h])
    wqkv = t_zeros([h, h3])
    bqkv = t_zeros([h3])
    wproj = t_zeros([h, h])
    bproj = t_zeros([h])
    w1 = t_zeros([h, h4])
    b1 = t_zeros([h4])
    w2 = t_zeros([h4, h])
    b2 = t_zeros([h])

    # ---- gflat THUC: tong numel cua ps (giong _n_param cua bench) ----
    npar = VocabSize * h + MaxPos * h + h + h
    npar = npar + NLayers * (h + h + h3 * h + h3 + h * h + h + h + h + h4 * h + h4 + h4 * h + h)
    gt = t_zeros([npar])
    gflat = gt.data

    # ---- offs that cho layer 0 (mirror poff cua gpt2_backward) ----
    base = VocabSize * h + MaxPos * h + h + h
    offs = []
    acc = base
    offs.append(acc)
    acc = acc + h
    offs.append(acc)
    acc = acc + h
    offs.append(acc)
    acc = acc + h3 * h
    offs.append(acc)
    acc = acc + h3
    offs.append(acc)
    acc = acc + h * h
    offs.append(acc)
    acc = acc + h
    offs.append(acc)
    acc = acc + h
    offs.append(acc)
    acc = acc + h
    offs.append(acc)
    acc = acc + h4 * h
    offs.append(acc)
    acc = acc + h4
    offs.append(acc)
    acc = acc + h4 * h
    offs.append(acc)
    print("PROBE npar=" + str(npar) + " len(gflat)=" + str(len(gflat)) + " offs[11]=" + str(offs[11]))

    # ---- abuf 10 slot (giong _mk_abuf pool=1) ----
    abuf = []
    for i in range(5):
        abuf.append(t_zeros([n, h]))
    for i in range(3):
        abuf.append(t_zeros([n, h3]))
    abuf.append(t_zeros([n, h4]))
    abuf.append(t_zeros([n, h]))

    # ---- saves (giong forward_saved) ----
    sav_a = t_zeros([n, h])
    sav_r = t_zeros([n, h])
    sav_m = t_zeros([n, h])
    sav_in = t_zeros([n, h4])
    sav_ag = t_zeros([n, h4])
    ibuf = t_zeros([n, h4])
    dbuf = t_zeros([n, h4])

    print("=== BWD SPLIT v2 (PRODUCTION PATH) seq=" + str(n) + " ===")

    # ---- A) gpt2_block_bwd FULL, dung y nhu gpt2_backward goi ----
    for i in range(1):
        rb = gpt2_block_bwd(x, ln1_g, ln1_b, wqkv, bqkv, wproj, bproj,
                            ln2_g, ln2_b, w1, b1, w2, b2, gout, 1, gflat, offs,
                            sav_r, sav_a, sav_m, sav_in, sav_ag, ibuf, dbuf, abuf)
    t0 = now_ms()
    for i in range(4):
        rb = gpt2_block_bwd(x, ln1_g, ln1_b, wqkv, bqkv, wproj, bproj,
                            ln2_g, ln2_b, w1, b1, w2, b2, gout, 1, gflat, offs,
                            sav_r, sav_a, sav_m, sav_in, sav_ag, ibuf, dbuf, abuf)
    t_blk = now_ms() - t0
    print("A) block_bwd FULL (prod)   4it ms=" + str(t_blk) + "  per-layer=" + str(t_blk / 4.0))

    # ---- B) attention_bwd rieng, cung gflat + offs ----
    o_qkv = offs[2]
    o_bqkv = offs[3]
    o_proj = offs[4]
    o_bproj = offs[5]
    for i in range(2):
        ra = gpt2_attention_bwd(x, wqkv, bqkv, wproj, bproj, n, gout, 1, gflat,
                                o_qkv, o_bqkv, o_proj, o_bproj, abuf)
    t0 = now_ms()
    for i in range(8):
        ra = gpt2_attention_bwd(x, wqkv, bqkv, wproj, bproj, n, gout, 1, gflat,
                                o_qkv, o_bqkv, o_proj, o_bproj, abuf)
    t_att = now_ms() - t0
    print("B) attention_bwd (prod)    8it ms=" + str(t_att) + "  per-layer=" + str(t_att / 8.0))

    # ---- C) mlp_bwd rieng, co abuf + offs (duong ATen) ----
    o_w1 = offs[8]
    o_b1 = offs[9]
    o_w2 = offs[10]
    o_b2 = offs[11]
    for i in range(1):
        rm = gpt2_mlp_bwd(x, w1, b1, w2, b2, n, gout, 1, gflat,
                          o_w1, o_b1, o_w2, o_b2, sav_in, sav_ag, ibuf, dbuf, abuf)
    t0 = now_ms()
    for i in range(4):
        rm = gpt2_mlp_bwd(x, w1, b1, w2, b2, n, gout, 1, gflat,
                          o_w1, o_b1, o_w2, o_b2, sav_in, sav_ag, ibuf, dbuf, abuf)
    t_mlp = now_ms() - t0
    print("C) mlp_bwd (prod, ATen)    4it ms=" + str(t_mlp) + "  per-layer=" + str(t_mlp / 4.0))

    # ---- D) layernorm_bwd x2 (nhu block goi) ----
    o_l2g = offs[6]
    o_l2b = offs[7]
    o_l1g = offs[0]
    o_l1b = offs[1]
    for i in range(3):
        rl2 = gpt2_layernorm_bwd(sav_r, ln2_g, ln2_b, rm[0], gflat, o_l2g, o_l2b)
        rl1 = gpt2_layernorm_bwd(x, ln1_g, ln1_b, ra[0], gflat, o_l1g, o_l1b)
    t0 = now_ms()
    for i in range(20):
        rl2 = gpt2_layernorm_bwd(sav_r, ln2_g, ln2_b, rm[0], gflat, o_l2g, o_l2b)
        rl1 = gpt2_layernorm_bwd(x, ln1_g, ln1_b, ra[0], gflat, o_l1g, o_l1b)
    t_ln = now_ms() - t0
    print("D) 2x layernorm_bwd       20it ms=" + str(t_ln) + "  per-layer=" + str(t_ln / 20.0))

    # ---- E) 2x simd_add [n,h] ----
    # quirk: phai gan phan tu ra bien TRUOC roi moi lay .data
    drl2 = rl2[0]
    drl1 = rl1[0]
    _gd = gout.data
    _dl2 = drl2.data
    _dl1 = drl1.data
    t0 = now_ms()
    for i in range(50):
        simd_add(_gd, _dl2, _gd)
        simd_add(_dl1, _gd, _dl1)
    t_add = now_ms() - t0
    print("E) 2x simd_add            50it ms=" + str(t_add) + "  per-layer=" + str(t_add / 50.0))

    # ---- F) tong manh vs block full ----
    per_blk = t_blk / 4.0
    sum_p = t_att / 8.0 + t_mlp / 4.0 + t_ln / 20.0 + t_add / 50.0
    print("F) SUM manh per-layer = " + str(sum_p) + "   block FULL = " + str(per_blk))
    print("G) CHENH (glue/alloc) = " + str(per_blk - sum_p))
    print("H) 12 layer: block=" + str(per_blk * 12.0) + "  sum=" + str(sum_p * 12.0))
    return 0
