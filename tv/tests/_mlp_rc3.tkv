import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize
    ih = 4 * h
    print("=== mlp_bwd rc tren gflat PRODUCTION ===")
    # dung dung npar nhu gpt2_backward
    npar = V * h + MaxPos * h + h + h
    npar = npar + NLayers * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    print("npar = " + str(npar) + "  gflat len = " + str(len(gflat)))

    a = t_zeros([n, ih])
    gout = t_zeros([n, h])
    w2 = t_zeros([ih, h])
    w1 = t_zeros([h, ih])
    x = t_zeros([n, h])
    dxs2 = t_zeros([n, ih])
    dxs1 = t_zeros([n, h])
    ad = a.data
    gd = gout.data
    w2d = w2.data
    w1d = w1.data
    xd = x.data
    d2d = dxs2.data
    d1d = dxs1.data

    # offset layer 0 nhu production: base = V*h + MaxPos*h + h + h
    base = V * h + MaxPos * h + h + h
    o_w1: "i64" = base + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    o_b1: "i64" = o_w1 + 4 * h * h
    o_w2: "i64" = o_b1 + 4 * h
    o_b2: "i64" = o_w2 + 4 * h * h
    print("o_w1=" + str(o_w1) + " o_b1=" + str(o_b1) + " o_w2=" + str(o_w2) + " o_b2=" + str(o_b2))
    print("o_b2 + h = " + str(o_b2 + h) + "  (phai <= " + str(npar) + ")")

    r2 = onednn_linear_bwd_off(ad, gd, w2d, d2d, gflat, n, ih, h, o_w2, o_b2)
    print("A) r2 (ih->h)  rc = " + str(r2))
    r1 = onednn_linear_bwd_off(xd, d2d, w1d, d1d, gflat, n, h, ih, o_w1, o_b1)
    print("B) r1 (h->ih)  rc = " + str(r1))
    if r2 == 0:
        if r1 == 0:
            print("=> CA HAI DI ATen")
        else:
            print("=> r1 ROI VE smm_*")
    else:
        print("=> r2 ROI VE smm_*")
    return 0
