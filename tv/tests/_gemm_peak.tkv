# PROBE GEMM PEAK (2026-11-10) — tkv GEMM dat bao nhieu % dinh tren may nay?
#
# §5.1b ghi dinh do duoc: 75.5 GFLOP/s 1 luong, ~515 GFLOP/s 14 luong.
# §0.133 tinh lmhead_bwd_fused_list = 158 GFLOPS va ket luan "sat tran".
# Probe nay do TRUC TIEP tkv GEMM o 2 shape lon de kiem chung "sat tran".
#
# Shape 1: dxf = gg x wte   : [1024,50257] x [50257,768] -> 39.5 GFLOP
# Shape 2: dwte = gg^T x xf : [50257,1024] x [1024,768] -> 39.5 GFLOP
import tv.training.gpt2_ref124
import tv.training.simd_matmul

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize
    print("=== GEMM PEAK seq=" + str(n) + " ===")

    # ---- A) smm_dot_pd: [n,V] x [V,h]  (dxf) ----
    a1 = t_zeros([n, V])
    b1 = t_zeros([V, h])
    o1 = smm_dot_pd(a1, b1, n, h, V)
    t0 = now_ms()
    o1 = smm_dot_pd(a1, b1, n, h, V)
    t1 = now_ms()
    o2 = smm_dot_pd(a1, b1, n, h, V)
    t2 = now_ms()
    dt1 = min(t1 - t0, t2 - t1)
    fl1 = 2.0 * float(n) * float(V) * float(h)
    print("A) smm_dot_pd [n,V]x[V,h] = " + str(dt1) + " ms  -> " + str(fl1 / (dt1 * 1.0e6)) + " GFLOPS")

    # ---- B) smm_fwd_at_pd: [V,n] x [n,h] (dwte, trans-A) ----
    a2 = t_zeros([V, n])
    b2 = t_zeros([n, h])
    o3 = smm_fwd_at_pd(a2, b2, V, h, n)
    t0 = now_ms()
    o3 = smm_fwd_at_pd(a2, b2, V, h, n)
    t1 = now_ms()
    o4 = smm_fwd_at_pd(a2, b2, V, h, n)
    t2 = now_ms()
    dt2 = min(t1 - t0, t2 - t1)
    fl2 = 2.0 * float(V) * float(h) * float(n)
    print("B) smm_fwd_at_pd [V,n]x[n,h] = " + str(dt2) + " ms  -> " + str(fl2 / (dt2 * 1.0e6)) + " GFLOPS")

    # ---- C) GEMM vuong lon de tim dinh thuc su ----
    m3 = 2048
    a3 = t_zeros([m3, m3])
    b3 = t_zeros([m3, m3])
    o5 = smm_dot_pd(a3, b3, m3, m3, m3)
    t0 = now_ms()
    o5 = smm_dot_pd(a3, b3, m3, m3, m3)
    t1 = now_ms()
    o6 = smm_dot_pd(a3, b3, m3, m3, m3)
    t2 = now_ms()
    dt3 = min(t1 - t0, t2 - t1)
    fl3 = 2.0 * float(m3) * float(m3) * float(m3)
    print("C) smm_dot_pd 2048^3        = " + str(dt3) + " ms  -> " + str(fl3 / (dt3 * 1.0e6)) + " GFLOPS")
    return 0
