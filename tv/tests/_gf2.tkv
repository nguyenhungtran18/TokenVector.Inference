# PROBE _gf2 — tinh chinh nguong routing M6b: m=512 + shape production that
# ----------------------------------------------------------------------------
# Bo sung cho _gf1 (da do S1/S3/S5 tai m=8/256/1024):
#   - m=512 cho S1/S3/S5 (tim crossover giua 256 va 1024)
#   - shape production that: qkv fwd/dx, fc up fwd, fc down fwd/dx(w2),
#     c_proj fwd/dx, gCtx attention (k=seq — tai seq256/1024 di routing)
#   - fc dx (m,768,3072,tb1) = S1 da do roi -> khong lap
# cur = production (smm_fwd/smm_dot, k>=256 -> _smm_pk M4)
# full = simd_gemm_full T=256 mode=0 (fullA: cd alloc trong timing;
#        fullB: cd reuse ngoai timing)
# BIT tinh fail chi khi > 1e-4 (tol gate); <= 1e-4 = ghi chu f32 ulp.
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_gf2.tkv out/gf2.exe main; out/gf2.exe
import tv.training.tensor
import tv.training.simd_matmul

TOL = 0.0001

def _min(a: 'f64', b: 'f64') -> 'f64':
    if b < a:
        return b
    return a

def _maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def _fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _run_cur(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
             tb: 'i32', sc: "list[f32]") -> "list[f32]":
    if tb == 0:
        rb = smm_fwd(a, b, m, n, k)
    else:
        rb = smm_dot(a, b, m, n, k, sc)
    return rb.data

def _run_full(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
              ndim: 'i64', tb: 'i32', cd: "list[f32]") -> 'i32':
    ad: "list[f32]" = a.data
    bd: "list[f32]" = b.data
    rv = simd_gemm_full(ad, bd, cd, m, n, k, ndim, tb, 256, 0)
    return rv

def _calib(x: 'f64') -> 'i64':
    # chon so lan lap inner de vong do >= ~200ms (vuot phan giai now_ms 15.6ms)
    if x >= 200.0:
        return 1
    if x <= 0.0:
        return 64
    ic = 200.0 / x + 1.0
    if ic > 64.0:
        return 64
    return int(ic)

def _bench(tag: 'str', a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
           ndim: 'i64', tb: 'i32', reps: 'i64') -> 'i32':
    scratch: "list[f32]" = []
    for i in range(m * n):
        scratch.append(0.0)
    cdB: "list[f32]" = []
    for i in range(m * n):
        cdB.append(0.0)

    tcur = 1000000000.0
    tfA = 1000000000.0
    tfB = 1000000000.0
    rdata: "list[f32]" = scratch
    cdA: "list[f32]" = scratch
    rc = 0
    r = 0
    while r < reps:
        # calib cur (1 lan chua tinh)
        t0 = now_ms()
        rdata = _run_cur(a, b, m, n, k, tb, scratch)
        t1 = now_ms()
        ic = _calib(float(t1 - t0))
        t0 = now_ms()
        x = 0
        while x < ic:
            rdata = _run_cur(a, b, m, n, k, tb, scratch)
            x = x + 1
        t1 = now_ms()
        tcur = _min(tcur, float(t1 - t0) / float(ic))

        cdt = t_zeros([m, n])
        cdA = cdt.data
        # calib fullA
        t0 = now_ms()
        rc = _run_full(a, b, m, n, k, ndim, tb, cdA)
        t1 = now_ms()
        iA = _calib(float(t1 - t0))
        t0 = now_ms()
        x = 0
        while x < iA:
            rc = _run_full(a, b, m, n, k, ndim, tb, cdA)
            x = x + 1
        t1 = now_ms()
        tfA = _min(tfA, float(t1 - t0) / float(iA))
        if rc != 0:
            print("  [FAIL] " + tag + " fullA rc=" + str(rc))
            return 1

        # calib fullB
        t0 = now_ms()
        rc = _run_full(a, b, m, n, k, ndim, tb, cdB)
        t1 = now_ms()
        iB = _calib(float(t1 - t0))
        t0 = now_ms()
        x = 0
        while x < iB:
            rc = _run_full(a, b, m, n, k, ndim, tb, cdB)
            x = x + 1
        t1 = now_ms()
        tfB = _min(tfB, float(t1 - t0) / float(iB))
        if rc != 0:
            print("  [FAIL] " + tag + " fullB rc=" + str(rc))
            return 1
        r = r + 1

    md = _maxdiff(rdata, cdB, m * n)
    print("GF2 " + tag + "  cur=" + str(tcur) + "ms  fullA=" + str(tfA)
          + "ms (" + str(tcur / tfA) + "x)  fullB=" + str(tfB)
          + "ms (" + str(tcur / tfB) + "x)  BIT=" + str(md))
    if md > TOL:
        print("  [FAIL] " + tag + " BIT " + str(md) + " > tol " + str(TOL))
        return 1
    return 0

# tao A [m][k], fill, chay bench
def _ab(tag: 'str', m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', tb: 'i32',
        bT: "Tensor", reps: 'i64', seed: 'i64') -> 'i32':
    a = t_zeros([m, k])
    _fill(a.data, m * k, seed)
    return _bench(tag, a, bT, m, n, k, ndim, tb, reps)

def main() -> 'i32':
    h = 768
    four = 3072
    V = 50257
    qo = 2304
    fails = 0

    # weights (B dung chung cho ca fwd va dx — giong production)
    Wqkv = t_zeros([h, qo])
    W1 = t_zeros([h, four])
    W2 = t_zeros([four, h])
    Wp = t_zeros([h, h])
    Wte = t_zeros([V, h])
    _fill(Wqkv.data, h * qo, 21)
    _fill(W1.data, h * four, 22)
    _fill(W2.data, four * h, 23)
    _fill(Wp.data, h * h, 24)
    _fill(Wte.data, V * h, 25)

    print("GF2 tinh chinh nguong: m=512 + shape production (cur=_smm_pk vs full T=256)")

    # ---- m=512 cho 3 shape da do o _gf1 (tim crossover 256..1024) ---------
    fails = fails + _ab("S1 m=512  [512x768x3072]  tb1", 512, h, four, four, 1, W1, 3, 31)
    fails = fails + _ab("S3 m=512  [512x768x50257]  tb0", 512, h, V, h, 0, Wte, 3, 32)
    fails = fails + _ab("S5 m=512  [512x50257x768]  tb1", 512, V, h, h, 1, Wte, 3, 33)

    # ---- qkv proj: fwd (m,2304,768,tb0) + dx (m,768,2304,tb1) -------------
    fails = fails + _ab("qkvF m=8    (8,2304,768)    tb0", 8, qo, h, qo, 0, Wqkv, 5, 34)
    fails = fails + _ab("qkvF m=256  (256,2304,768)  tb0", 256, qo, h, qo, 0, Wqkv, 3, 34)
    fails = fails + _ab("qkvF m=1024 (1024,2304,768) tb0", 1024, qo, h, qo, 0, Wqkv, 3, 34)
    fails = fails + _ab("qkvD m=8    (8,768,2304)    tb1", 8, h, qo, qo, 1, Wqkv, 5, 35)
    fails = fails + _ab("qkvD m=256  (256,768,2304)  tb1", 256, h, qo, qo, 1, Wqkv, 3, 35)
    fails = fails + _ab("qkvD m=1024 (1024,768,2304) tb1", 1024, h, qo, qo, 1, Wqkv, 3, 35)

    # ---- fc up (mlp gate): fwd (m,3072,768,tb0); dx = S1 da do ------------
    fails = fails + _ab("fcupF m=8    (8,3072,768)    tb0", 8, four, h, four, 0, W1, 5, 36)
    fails = fails + _ab("fcupF m=256  (256,3072,768)  tb0", 256, four, h, four, 0, W1, 3, 36)
    fails = fails + _ab("fcupF m=1024 (1024,3072,768) tb0", 1024, four, h, four, 0, W1, 3, 36)

    # ---- fc down (w2): fwd (m,768,3072,tb0) + dx (m,3072,768,tb1) ---------
    fails = fails + _ab("fcdnF m=8    (8,768,3072)    tb0", 8, h, four, h, 0, W2, 5, 37)
    fails = fails + _ab("fcdnF m=256  (256,768,3072)  tb0", 256, h, four, h, 0, W2, 3, 37)
    fails = fails + _ab("fcdnF m=1024 (1024,768,3072) tb0", 1024, h, four, h, 0, W2, 3, 37)
    fails = fails + _ab("fcdnD m=8    (8,3072,768)    tb1", 8, four, h, h, 1, W2, 5, 38)
    fails = fails + _ab("fcdnD m=256  (256,3072,768)  tb1", 256, four, h, h, 1, W2, 3, 38)
    fails = fails + _ab("fcdnD m=1024 (1024,3072,768) tb1", 1024, four, h, h, 1, W2, 3, 38)

    # ---- c_proj attention: fwd (m,768,768,tb0) + dx (m,768,768,tb1) -------
    fails = fails + _ab("cprjF m=8    (8,768,768)    tb0", 8, h, h, h, 0, Wp, 5, 39)
    fails = fails + _ab("cprjF m=256  (256,768,768)  tb0", 256, h, h, h, 0, Wp, 3, 39)
    fails = fails + _ab("cprjF m=1024 (1024,768,768) tb0", 1024, h, h, h, 0, Wp, 3, 39)
    fails = fails + _ab("cprjD m=8    (8,768,768)    tb1", 8, h, h, h, 1, Wp, 5, 40)
    fails = fails + _ab("cprjD m=256  (256,768,768)  tb1", 256, h, h, h, 1, Wp, 3, 40)
    fails = fails + _ab("cprjD m=1024 (1024,768,768) tb1", 1024, h, h, h, 1, Wp, 3, 40)

    # ---- gCtx attention: (m, 64, k=m, ndim=64, tb0) — k=seq, m=8 khong di routing (k<256)
    Bv = t_zeros([256, 64])
    _fill(Bv.data, 256 * 64, 41)
    fails = fails + _ab("gCtx m=256  (256,64,k=256)  tb0", 256, 64, 256, 64, 0, Bv, 3, 42)
    Bv2 = t_zeros([1024, 64])
    _fill(Bv2.data, 1024 * 64, 43)
    fails = fails + _ab("gCtx m=1024 (1024,64,k=1024) tb0", 1024, 64, 1024, 64, 0, Bv2, 3, 44)

    print("GF2 done fails=" + str(fails) + " (chi tinh fail neu BIT > 1e-4)")
    return fails