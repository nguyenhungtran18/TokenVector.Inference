# PROBE EXP — throughput exp() cua .tkv (HANDOFF §0.67 muc A)
# ---------------------------------------------------------
# `attention_bwd` tai seq1024 di nhanh 12 worker (moi head 1 worker) nen no DA song
# song, khong phai muc "khong scale". Nhung moi head lam softmax causal:
#   sum_{t=0}^{n-1} (t+1) = n(n+1)/2 = 524 800 exp  -> x12 head = 6 297 600 exp/block.
# x12 block = 75.6M exp/buoc (bwd) + cung bay nhieu o fwd.
#
# Probe do thang chi phi do: vong exp() tren N phan tu, 1 luong, KHONG GEMM.
# Neu 6.3M exp ~ 600 ms thi softmax chinh la toan bo 625 ms cua attention_bwd.
import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    hd = HeadDim
    nh = NHeads
    cnt = nh * (n * (n + 1)) // 2
    print("EX n=" + str(n) + " heads=" + str(nh) + " exp/block = " + str(cnt))

    src = t_zeros([cnt])
    dst = t_zeros([cnt])
    sd = src.data
    i = 0
    while i < cnt:
        sd[i] = 0.001 * float(i % 1000)
        i = i + 1
    dd = dst.data

    b1 = 1.0e9
    k = 0
    while k < 3:
        t0 = now_ms()
        i = 0
        while i < cnt:
            dd[i] = exp(sd[i])
            i = i + 1
        t1 = now_ms()
        if t1 - t0 < b1:
            b1 = t1 - t0
        k = k + 1

    print("EX exp_loop 1T     = " + str(b1) + " ms cho " + str(cnt) + " exp")
    print("EX ns/exp          = " + str(b1 * 1000000.0 / float(cnt)))
    print("EX 12 block        = " + str(b1 * 12.0) + " ms (neu chi 1 luong)")

    # so sanh: cung so phan tu nhung chi cong (khong exp) -> biet chi phi rieng cua exp
    b2 = 1.0e9
    k = 0
    while k < 3:
        t0 = now_ms()
        i = 0
        while i < cnt:
            dd[i] = sd[i] + 1.0
            i = i + 1
        t1 = now_ms()
        if t1 - t0 < b2:
            b2 = t1 - t0
        k = k + 1
    print("EX add_loop (doi chieu) = " + str(b2) + " ms")
    return 0
