# PROBE CJ2 — M4 wire A/B v3: f32 path TRUC TIEP Tensor.data (sau fix t_zeros list[f32])
# ---------------------------------------------------------------------------
# Lich su:
#   CJ (old): arm M4 qua convert interpreted d2s -> nuot gain (S3 0.67x).
#   CJ2 v1 (f64 ABI): production data luc do la List[float64> (layout f32@4i) ->
#     PackedCreate64 doc duoc double[] NHUNG noi dung la cap 2 float32 xep thanh
#     double -> KET QUA RAC (2^65) — da chot bang _cj3/_cj4.
#   FIX repo (2026-10-25): t_zeros/t_alloc_grad sinh list[f32] THAT -> runtime
#     List[Single], layout f32@4i NGUYEN (managed punned get/set khong doi), gate
#     15/15 suite xanh. Gio f32 path nhan TRUC TIEP Tensor.data, 0 convert.
# Quyet dinh wire: M4 <= BASE (best-of-3) + maxdiff <= 1e-4 (f32 ulp) tai S1/S3/S5.
#
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj2.tkv out/cj2.exe main
#      ./out/cj2.exe
import tv.training.tensor
import tv.training.simd_matmul

def _f64view(d: "list[f32]") -> "list[f64]":
    # GIU DE KHONG PHA MA — KHONG DUA VAO NUA (xem lich su tren)
    return d

def _cj2_fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _cj2_maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

# Pipeline M4 wire v3 (f32): pack TRUC TIEP tu Tensor.data (khong convert),
# run ghi truc tiep vao sc/Tensor (cung list[f32]).
def _cj2_m4(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
            ra: 'i64', ca: 'i64', sa: 'i64', ta: 'i32',
            rb: 'i64', cb: 'i64', sb: 'i64', tb: 'i32',
            T: 'i64', sc: "list[f32]" = None, ph: "list[f64]" = None) -> "Tensor":
    t0 = now_ms()
    ad = a.data
    bd = b.data
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(ad, ra, ca, sa, T, ta)
    hB = simd_gemm_packed_create(bd, rb, cb, sb, T, tb)
    t1 = now_ms()
    if sc != None:
        raw = sc
        rawt = a
    else:
        rawt = t_zeros([m, n])
        raw = rawt.data
    tgt = raw
    st = simd_gemm_packed(hA, hB, tgt, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    t2 = now_ms()
    if ph != None:
        ph.append(t1 - t0)
        ph.append(t2 - t1)
    return Tensor(raw, [m, n], 0)

def _cj2_phstr(ph: "list[f64]") -> 'str':
    if len(ph) < 2:
        return ""
    return ("pack=" + str(ph[0]) + " run=" + str(ph[1]))

def main() -> 'i32':
    print("CJ2: M4 wire v3 f32 direct on Tensor.data (post t_zeros fix), best-of-3, T=768")
    rs = 3
    nq = 1024
    h = 768
    V = 50257
    four = 3072
    T: "i64" = 768

    # ---- S1 dx1 [1024x768] = A[1024,3072] x B^T[768,3072] : smm_dot (serial, trans_b=1)
    ta1 = t_zeros([nq, four])
    tb1 = t_zeros([h, four])
    _f1 = _cj2_fill(ta1.data, nq * four, 1)
    _f2 = _cj2_fill(tb1.data, h * four, 2)
    v1b = 1.0e18
    res1 = ta1
    i = 0
    while i < rs:
        t0 = now_ms()
        res1 = smm_dot(ta1, tb1, nq, h, four)
        t1 = now_ms()
        if t1 - t0 < v1b:
            v1b = t1 - t0
        i = i + 1
    v1t = 1.0e18
    ph1: "list[f64]" = None
    i = 0
    while i < rs:
        ph1 = []
        t0 = now_ms()
        res1m = _cj2_m4(ta1, tb1, nq, h, four, nq, four, four, 0, h, four, four, 1, T, None, ph1)
        t1 = now_ms()
        if t1 - t0 < v1t:
            v1t = t1 - t0
        i = i + 1
    md1 = _cj2_maxdiff(res1.data, res1m.data, nq * h)
    print("CJ2 S1 dx1  serial  base=" + str(v1b) + " m4=" + str(v1t)
          + " sp=" + str(v1b / v1t) + "x maxdiff=" + str(md1)
          + " | " + _cj2_phstr(ph1))
    # chuan doa: C[0,0] = dot(A[0], B[0]), C[0,1] = dot(A[0], B[1]) (B^T)
    s00 = 0.0
    s01 = 0.0
    p = 0
    while p < four:
        s00 = s00 + ta1.data[0 * four + p] * tb1.data[0 * four + p]
        s01 = s01 + ta1.data[0 * four + p] * tb1.data[1 * four + p]
        p = p + 1
    print("CJ2 S1 diag base[0]=" + str(res1.data[0]) + " base[1]=" + str(res1.data[1])
          + " m4[0]=" + str(res1m.data[0]) + " m4[1]=" + str(res1m.data[1])
          + " scalar[0]=" + str(s00) + " scalar[1]=" + str(s01))

    # ---- S3 dxf [1024x768] = A[1024,50257] x B[50257,768] : smm_fwd_pd (sc)
    ta3 = t_zeros([nq, V])
    tb3 = t_zeros([V, h])
    _f3 = _cj2_fill(ta3.data, nq * V, 3)
    _f4 = _cj2_fill(tb3.data, V * h, 4)
    sc3t = t_zeros([nq, h])
    sc3 = sc3t.data
    tg3t = t_zeros([nq, h])
    tg3 = tg3t.data
    v3b = 1.0e18
    res3 = ta3
    i = 0
    while i < rs:
        t0 = now_ms()
        res3 = smm_fwd_pd(ta3, tb3, nq, h, V, sc3)
        t1 = now_ms()
        if t1 - t0 < v3b:
            v3b = t1 - t0
        i = i + 1
    v3t = 1.0e18
    ph3: "list[f64]" = None
    i = 0
    while i < rs:
        ph3 = []
        t0 = now_ms()
        res3m = _cj2_m4(ta3, tb3, nq, h, V, nq, V, V, 0, V, h, h, 0, T, tg3, ph3)
        t1 = now_ms()
        if t1 - t0 < v3t:
            v3t = t1 - t0
        i = i + 1
    md3 = _cj2_maxdiff(sc3, res3m.data, nq * h)
    print("CJ2 S3 dxf  wave-12 base=" + str(v3b) + " m4=" + str(v3t)
          + " sp=" + str(v3b / v3t) + "x maxdiff=" + str(md3)
          + " | " + _cj2_phstr(ph3))

    # ---- S5 lgts [1024x50257] = A[1024,768] x B^T[50257,768] : smm_dot_pd (sc)
    ta5 = t_zeros([nq, h])
    tb5 = t_zeros([V, h])
    _f5 = _cj2_fill(ta5.data, nq * h, 7)
    _f6 = _cj2_fill(tb5.data, V * h, 8)
    sc5t = t_zeros([nq, V])
    sc5 = sc5t.data
    tg5t = t_zeros([nq, V])
    tg5 = tg5t.data
    v5b = 1.0e18
    res5 = ta5
    i = 0
    while i < rs:
        t0 = now_ms()
        res5 = smm_dot_pd(ta5, tb5, nq, V, h, sc5)
        t1 = now_ms()
        if t1 - t0 < v5b:
            v5b = t1 - t0
        i = i + 1
    v5t = 1.0e18
    ph5: "list[f64]" = None
    i = 0
    while i < rs:
        ph5 = []
        t0 = now_ms()
        res5m = _cj2_m4(ta5, tb5, nq, V, h, nq, h, h, 0, V, h, h, 1, T, tg5, ph5)
        t1 = now_ms()
        if t1 - t0 < v5t:
            v5t = t1 - t0
        i = i + 1
    md5 = _cj2_maxdiff(sc5, res5m.data, nq * V)
    print("CJ2 S5 lgts wave-12 base=" + str(v5b) + " m4=" + str(v5t)
          + " sp=" + str(v5b / v5t) + "x maxdiff=" + str(md5)
          + " | " + _cj2_phstr(ph5))

    # ---- S6 nho kieu attention: [1024x64] x B^T[1024,64] : smm_dot (serial)
    s6 = 1024
    hd = 64
    ta6 = t_zeros([s6, hd])
    tb6 = t_zeros([s6, hd])
    _f7 = _cj2_fill(ta6.data, s6 * hd, 11)
    _f8 = _cj2_fill(tb6.data, s6 * hd, 12)
    v6b = 1.0e18
    res6 = ta6
    i = 0
    while i < rs:
        t0 = now_ms()
        res6 = smm_dot(ta6, tb6, s6, s6, hd)
        t1 = now_ms()
        if t1 - t0 < v6b:
            v6b = t1 - t0
        i = i + 1
    v6t = 1.0e18
    ph6: "list[f64]" = None
    i = 0
    while i < rs:
        ph6 = []
        t0 = now_ms()
        res6m = _cj2_m4(ta6, tb6, s6, s6, hd, s6, hd, hd, 0, s6, hd, hd, 1, T, None, ph6)
        t1 = now_ms()
        if t1 - t0 < v6t:
            v6t = t1 - t0
        i = i + 1
    md6 = _cj2_maxdiff(res6.data, res6m.data, s6 * s6)
    print("CJ2 S6 att  small   base=" + str(v6b) + " m4=" + str(v6t)
          + " sp=" + str(v6b / v6t) + "x maxdiff=" + str(md6)
          + " | " + _cj2_phstr(ph6))

    print("CJ2 done")
    return 0
