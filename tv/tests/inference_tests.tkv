def test_awq_asym_and_fp16() -> 'i32':
    w = _nd_f32(8)
    for i in range(8):
        w[i] = float(i) - 2.0
    packed = _nd_i64(4)
    scales = _nd_f32(0)
    zps = _nd_i64(0)
    quantize_int4_grouped_asym(w, 1, 8, 4, packed, scales, zps)
    assert len(packed) == 4 and len(scales) == 2 and (len(zps) == 2)
    y = _nd_f32(8)
    dequantize_int4_grouped_asym(packed, y, 1, 8, 4, scales, zps)
    for i in range(8):
        assert abs(w[i] - y[i]) < max(scales) * 2.0
    p = _nd_f32(6)
    q = inv_permute_cols(permute_cols(p, 2, 3, [2, 0, 1]), 2, 3, [2, 0, 1])
    for i in range(6):
        assert q[i] == p[i]
    a = _nd_f32(4)
    a[0] = 1.0
    a[3] = 1.0
    qa = _nd_i8(8)
    quantize_fp16(a, qa)
    y2 = _nd_f32(4)
    nb = _nd_f32(2)
    matmul_fp16(qa, qa, nb, y2, 2, 2, 2)
    assert abs(y2[0] - 1.0) < 0.001 and abs(y2[3] - 1.0) < 0.001
    return 0

def test_autograd_gradcheck_and_adam() -> 'i32':
    w1 = _nd_f32(1)
    w1[0] = 0.7
    b1 = _nd_f32(1)
    w2 = _nd_f32(1)
    w2[0] = -0.4
    b2 = _nd_f32(1)
    h1 = lin_head(w1, b1, 1, 1, 1)
    h2 = lin_head(w2, b2, 1, 1, 1)
    x = _nd_f32(1)
    x[0] = 2.0
    t = _nd_f32(1)
    t[0] = 1.0
    h = relu_forward(h1.forward(x))
    y = h2.forward(h)
    dy = _nd_f32(1)
    mse_backward(y, t, dy)
    dh = h2.backward(dy)
    h1.backward(relu_backward(h, dh))
    analytic = h2.gw[0]
    e = 0.001
    w2[0] = w2[0] + e
    lp = mse_forward(h2.forward(relu_forward(h1.forward(x))), t)
    w2[0] = w2[0] - 2.0 * e
    lm = mse_forward(h2.forward(relu_forward(h1.forward(x))), t)
    w2[0] = w2[0] + e
    numeric = (lp - lm) / (2.0 * e)
    assert abs(analytic - numeric) < 0.01
    st = adam_state(1, 0.01)
    p = _nd_f32(1)
    p[0] = 1.0
    gg = _nd_f32(1)
    gg[0] = 2.0
    st.step(p, gg)
    assert p[0] < 1.0
    return 0

def test_pack_mask_and_preprocess() -> 'i32':
    m = pack_block_mask([1, 2], [2, 2], [0, 0])
    assert len(m) == 12
    assert m[0] == 0.0 and m[2] == -1000000000000000000000000000000.0 and (m[6] == 0.0)
    img = _nd_f32(2 * 2 * 1)
    for i in range(4):
        img[i] = float(i + 1)
    normalize_inplace(img, [1.0], [2.0], 1)
    assert img[0] == 0.0 and img[3] == 1.5
    ch = hwc_to_chw(img, 2, 2, 1)
    assert ch[0] == 0.0 and ch[3] == 1.5
    pt = patchify(img, 2, 2, 1, 2)
    assert len(pt) == 4 and pt[0] == 0.0 and (pt[3] == 1.5)
    return 0

def _rep_f32(v: 'f32', n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(v)
    return out

def _onnx_tensor_init(gr: 'OnnxGraph', name: 'str', shape: 'list[i64]', vals: 'list[f32]') -> 'i32':
    t = OnnxTensor(1, name, 1, "")
    t.dtype = 1
    for d in shape:
        _ah1056_8 = t.dims
        _ah1056_8.append(d)
    _qx1001 = []
    for _qx1005 in vals:
        _qx1001.append(_qx1005)
    t.float_data = _qx1001
    _ah1061_4 = gr.initializers
    _ah1061_4.append(t)
    return 0

def test_lstm_unrolled_end_to_end() -> 'i32':
    m = OnnxModel(1, 0, "", "", "", 0, "", OnnxGraph(1, ""))
    lstm = OnnxNode(1, "", "")
