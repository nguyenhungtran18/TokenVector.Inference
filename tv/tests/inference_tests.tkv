def test_lora_forward_and_step() -> 'i32':
    w = _nd_f32(12)
    fill_const(w, 0.1)
    b = _nd_f32(3)
    fill_const(b, 0.0)
    l = lora_linear_create(w, b, 1, 3, 4, 2, 1.0)
    x = _nd_f32(4)
    fill_const(x, 1.0)
    y = l.forward(x)
    assert len(y) == 3
    t = _nd_f32(3)
    fill_const(t, 0.0)
    loss0 = lora_train_row(l, x, t, 0.1)
    assert loss0 >= 0.0
    y2 = l.forward(x)
    changed = 0
    for i in range(3):
        if abs(y2[i] - y[i]) > 0.000001:
            changed = 1
    assert changed
    return 0

def test_hal_matmul_relu() -> 'i32':
    a = _nd_f32(4)
    fill_const(a, 2.0)
    b = _nd_f32(4)
    fill_const(b, 3.0)
    aa = _nd_f32(4)
    bb = _nd_f32(4)
    for i in range(4):
        aa[i] = float(i + 1)
        bb[i] = 1.0
    yy = _nd_f32(4)
    hal_matmul(aa, bb, yy, 2, 2, 2)
    assert abs(yy[0] - 3.0) < 0.00001
    assert abs(yy[3] - 7.0) < 0.00001
    r = _nd_f32(3)
    r[0] = -1.0
    r[1] = 0.0
    r[2] = 2.0
    hal_relu(r, r)
    assert r[0] == 0.0 and r[1] == 0.0 and (r[2] == 2.0)
    return 0

def test_string_tensor_pack_roundtrip() -> 'i32':
    st = str_tensor_new()
