def test_scan_run_driver() -> 'i32':
    acc = _nd_f32(1)
    acc[0] = 0.0
    rows = _nd_f32(4)
    for i in range(4):
        acc[0] = acc[0] + 1.0
        rows[i] = float(i)
    assert acc[0] == 4.0
    assert len(rows) == 4
    assert rows[0] == 0.0 and rows[3] == 3.0
    return 0

def test_prefix_skip_plan() -> 'i32':
    store = PrefixStore(1, 8, 0, 0)
    # Phai dung _nd_i64 (list[i64]) chu KHONG dung literal `[1, 2, ...]`.
    # Literal int khong kich thuoc tao List`1<TkvInt>; `intern`/`plan_prefix`
    # khai bao `toks: 'list[i64]'` -> doc `toks[i]` ra rac ->
    # `h * 1099511628211` phinh to -> OverflowException ("gia tri int qua
    # lon: khong vua int64"). TokenVector KHONG kiem tra kieu khi truyen
    # doi so ham.
    toks = _nd_i64(16)
    for i in range(16):
        toks[i] = i + 1
    store.intern(toks, 16)
    toks2 = _nd_i64(18)
    for i in range(16):
        toks2[i] = toks[i]
    toks2[16] = 99
    toks2[17] = 100
    plan = plan_prefix(store, toks2, 16)
    assert plan.hit and plan.skip_len == 16
    packed = apply_plan(plan, 18)
    sk = packed >> 32
    sf = packed - (sk << 32)
    assert sk == 16 and sf == 2
    return 0

def test_beam_log_softmax_and_tree() -> 'i32':
    logits = _nd_f32(3)
    logits[0] = 1.0
    logits[1] = 2.0
    logits[2] = 3.0
    sm = log_softmax(logits)
    assert len(sm) == 3
    assert sm[2] > sm[1] and sm[1] > sm[0]
    tree = TreeDraft(1)
    c0 = tree.add(1, 0, 0.0)
    c = tree.add(2, c0, -1.0)
    _ah1345_11 = tree.nodes[c]
    assert _ah1345_11.parent == c0
    assert len(tree.path(c)) == 2
    return 0

def test_vit_graph_builds() -> 'i32':
    cfg = default_vit_config()
    cfg.image_size = 32
    cfg.patch_size = 8
    cfg.hidden = 64
    cfg.num_layers = 1
    cfg.num_heads = 4
    cfg.num_classes = 10
    g = build_vit_graph(cfg)
    assert len(g.nodes) > 0
    assert len(g.outputs) > 0
    return 0

def _zero_bytes(n: 'i64') -> 'str':
    buf = []
    for i in range(n):
        buf.append(0)
    return bytes_from_list(buf)

def test_gguf_k_quant_gate_structural() -> 'i32':
    raised = 0
    try:
        _dequant_k_gated(_zero_bytes(10), 0, 300, 6)
    except Exception:
        raised = 1
    assert raised
    raised = 0
    try:
        _dequant_k_gated(_zero_bytes(50), 0, 256, 6)
    except Exception:
        raised = 1
    assert raised
    return 0

def main(sel: 'str' = "all") -> 'i32':
    # `sel` = "all" (mac dinh) hoac so thu tu 1..26.
    #
    # LY DO co tham so (2026-09-26): co case nem
    # AccessViolationException. TokenVector KHONG bat duoc loai nay bang
    # 'except Exception' (chi bat duoc Exception), nen 1 case lam treo
    # se LAM HONG TAT CA cac case phia sau. Chay MOI case trong MOT
    # process rieng (driver PowerShell) thi crash chi doc 1 case do, phan
    # con lai van chay tiep va co ket qua.
    _only = 0
    if sel != "all":
        _only = int(sel)
    passed = 0
    failed = 0
    passed = passed + _pick(_only, 1, "generate_loop_text", 1)
    passed = passed + _pick(_only, 2, "writer_modelproto", 2)
    passed = passed + _pick(_only, 3, "constant_fold_translate", 3)
    passed = passed + _pick(_only, 4, "gathernd_scatter", 4)
    passed = passed + _pick(_only, 5, "range_eye_cumsum", 5)
    passed = passed + _pick(_only, 6, "mish_prelu_instancenorm", 6)
    passed = passed + _pick(_only, 7, "speculative_all_accept", 7)
    passed = passed + _pick(_only, 8, "tools_parse_validate", 8)
    passed = passed + _pick(_only, 9, "autograd_trains_step", 9)
    passed = passed + _pick(_only, 10, "grammar_prefix_mask", 10)
    passed = passed + _pick(_only, 11, "if_loop_end_to_end", 11)
    passed = passed + _pick(_only, 12, "awq_asym_and_fp16", 12)
    passed = passed + _pick(_only, 13, "autograd_gradcheck_and_adam", 13)
    passed = passed + _pick(_only, 14, "pack_mask_and_preprocess", 14)
    passed = passed + _pick(_only, 15, "lstm_unrolled", 15)
    passed = passed + _pick(_only, 16, "resize_nearest_einsum", 16)
    passed = passed + _pick(_only, 17, "qlinear_conv_matmulinteger", 17)
    passed = passed + _pick(_only, 18, "lora_forward_and_step", 18)
    passed = passed + _pick(_only, 19, "hal_matmul_relu", 19)
    passed = passed + _pick(_only, 20, "string_tensor_pack", 20)
    passed = passed + _pick(_only, 21, "string_ops_side_table", 21)
    passed = passed + _pick(_only, 22, "scan_run_driver", 22)
    passed = passed + _pick(_only, 23, "prefix_skip_plan", 23)
    passed = passed + _pick(_only, 24, "beam_log_softmax_tree", 24)
    passed = passed + _pick(_only, 25, "vit_graph_builds", 25)
    passed = passed + _pick(_only, 26, "gguf_k_quant_gate", 26)
    if _only != 0:
        return 0
    _nf = 26 - passed
    print("RESULT passed=" + str(passed) + " failed=" + str(_nf))
    return 0

def _pick(only: 'i64', idx: 'i64', name: 'str', case_idx: 'i64') -> 'i32':
    if only != 0 and only != idx:
        return 0
    return _run_case(name, case_idx)

def _run_case(name: 'str', idx: 'i64') -> 'i32':
    ok = 0
    _err = ""
    try:
        if idx == 1:
            test_generate_loop_text()
        if idx == 2:
            test_writer_emits_modelproto()
        if idx == 3:
            test_constant_fold_translate()
        if idx == 4:
            test_gathernd_scatter()
        if idx == 5:
            test_range_eye_cumsum()
        if idx == 6:
            test_mish_prelu_instancenorm()
        if idx == 7:
            test_speculative_all_accept()
        if idx == 8:
            test_tools_parse_validate()
        if idx == 9:
            test_autograd_trains_step()
        if idx == 10:
            test_grammar_prefix_mask()
        if idx == 11:
            test_if_loop_end_to_end()
        if idx == 12:
            test_awq_asym_and_fp16()
        if idx == 13:
            test_autograd_gradcheck_and_adam()
        if idx == 14:
            test_pack_mask_and_preprocess()
        if idx == 15:
            test_lstm_unrolled_end_to_end()
        if idx == 16:
            test_resize_nearest_einsum()
        if idx == 17:
            test_qlinear_conv_matmulinteger_dynquant()
        if idx == 18:
            test_lora_forward_and_step()
        if idx == 19:
            test_hal_matmul_relu()
        if idx == 20:
            test_string_tensor_pack_roundtrip()
        if idx == 21:
            test_string_ops_and_session_side_table()
        if idx == 22:
            test_scan_run_driver()
        if idx == 23:
            test_prefix_skip_plan()
        if idx == 24:
            test_beam_log_softmax_and_tree()
        if idx == 25:
            test_vit_graph_builds()
        if idx == 26:
            test_gguf_k_quant_gate_structural()
        ok = 1
    except Exception as e:
        ok = 0
        _err = str(e)
    if ok == 1:
        print("[PASS] " + name)
    else:
        print("[FAIL] " + name + " :: " + _err)
    return ok


