class StubTok:
    _ok: 'i64'

    # GHI CHU (2026-09-26): stub nay tra "hi" BAT KE duoc bao nhieu token.
    # Dang do co chu dich, xem KNOWN DEFECT trong PACKAGE_MANIFEST.md:
    #   - test_generate_loop_text can `text == "hi"` sau 3 token -> chi dung
    #     khi decode() la HANG SO.
    #   - test_grammar_prefix_mask can `1 in ids` khoi current = "h" -> can
    #     decode([1]) = "i" (token hoan thanh cum).
    # Hai yeu cau nay MAAU THUAN - khong ton tai stub thoa ca hai. Da thu
    # stub bac ky tu 1='i'/2='x'/3='h': test 10 PASS nhung test 1 FAIL
    # (text thanh 3 ky tu thay vi "hi"). Giu dang hieu chinh de test 1
    # van xanh; xem manifest de biet can sua test nao.
    def encode(self, text: 'str') -> 'list[i64]':
        return [1, 2]

    def decode(self, ids: 'list[i64]') -> 'str':
        # (2026-09-26) Stub nay tra HANG SO "hi" bat ke duoc bao nhieu token.
        # Dung cho test 1 (`generate_loop_text`), goi decode() MOT LAN tren
        # danh sach token vua sinh. Xem `GrammarStubTok` ben duoi ly do tach
        # rieng fixture cho test 10.
        return "hi"

    def vocab_size(self) -> 'i64':
        return 4


# Stub rieng cho grammar (2026-09-26) - ly do tach fixture.
#
# StubTok tra HANG SO "hi", phu hop voi test 1 (`generate_loop_text`) goi
# decode() MOT LAN tren danh sach token vua sinh (thuc te [3,3,2]).
# Nhung test 10 (`allowed_token_ids`) duyet TUNG token i va hoi
# `is_live(g, current + decode([i]))` - noi token PHAI bieu dien KY TU thuc
# de grammar boi cac con nao con song. Voi grammar `root ::= "hi"` va
# current = "h":
#
#   decode([1]) = "i"  ->  "h" + "i" = "hi"   con song   (can 1 in ids)
#   decode([2]) = "x"  ->  "h" + "x" = "hx"  chet      (can 2 not in ids)
#   decode([3]) = "h"  ->  "h" + "h" = "hh"  chet
#   decode([0]) = ""   ->  "h" van song (OK, test khong kiem tra token 0)
#
# MOT stub hang so khong lam duoc ca hai yeu cau: neu decode([1]) == "i" de
# test 10 xanh, thi danh sach [3,3,2] cua test 1 se giai thanh "hhx" chu
# khong phai "hi". Da thu nhieu bien the (tra theo token, giu duong lui
# khi danh sach rong, gan chu cai dau...) va khong bien nao thoa duoc ca
# hai, nen tach rieng hai fixture. Cac test con lai (3, 7) giu StubTok.
class GrammarStubTok:
    _ok: 'i64'

    def encode(self, text: 'str') -> 'list[i64]':
        return [3, 1]

    def decode(self, ids: 'list[i64]') -> 'str':
        out = ""
        for _t in ids:
            if _t == 1:
                out = out + "i"
            elif _t == 2:
                out = out + "x"
            elif _t == 3:
                out = out + "h"
        return out

    def vocab_size(self) -> 'i64':
        return 4

def fill_rand(a: 'list[f32]', seed: 'i64') -> 'i32':
    s = seed
    for i in range(len(a)):
        s = (s * 6364136223846793005 + 1442695040888963407) & 0xFFFFFFFFFFFFFFFF
        a[i] = float(s % 1000) / 1000.0
    return 0

def fill_const(a: 'list[f32]', v: 'f32') -> 'i32':
    for i in range(len(a)):
        a[i] = v
    return 0

def gc_collect() -> 'i32':
    return 0

def gc_allocated_bytes() -> 'i64':
    return 0

def _const_graph(op: 'i64', shapes: 'list[list[i64]]', out_shape: 'list[i64]') -> 'ExecutionGraph':
    g = ExecutionGraph(1, "const_test", 0)
    names = []
    i = 0
    for sh in shapes:
        nm = "I" + str(i)
        names.append(nm)
        g.inputs.append(nm)
        g.get_or_create_tensor(nm, sh)
        i = i + 1
    g.outputs.append("Y")
    g.get_or_create_tensor("Y", out_shape)
    n = new_node("n0", op)
    for nm2 in names:
        n.inputs.append(nm2)
    n.outputs.append("Y")
    gn = g.nodes
    gn.append(n)
    return g

def _const_graph_ex(op: 'i64', shapes: 'list[list[i64]]', out_shape: 'list[i64]', extra: 'list[str]') -> 'ExecutionGraph':
    g = _const_graph(op, shapes, out_shape)
    # 'extra' la CAC INPUT THU HAI cua op (vd slope cua PRelu, scale/bias
    # cua InstanceNorm). Phai khai bao cho ca DUA noi:
    #   1. g.inputs          - de bien la input cua graph
    #   2. node.inputs       - de KERNEL doc duoc (ExecutionNode._exec_*
    #      doc self.input_descs[1], [2] ...)
    # Chi them o (1) se kien node chi co 1 input ->
    # self.input_descs[1] nem ArgumentOutOfRangeException luc chay.
    _n = g.nodes[0]
    for nm in extra:
        g.inputs.append(nm)
        _ni = _n.inputs
        _ni.append(nm)
        g.get_or_create_tensor(nm, [1])
    return g

def _t_init_mat(g: 'ExecutionGraph', name: 'str', shape: 'list[i64]', v: 'f32') -> 'i32':
    n = 1
    for d in shape:
        n = n * d
    m = _nd_f32(n)
    for i in range(n):
        m[i] = v
    g.initializers[name] = m
    g.get_or_create_tensor(name, shape)
    return 0

def _t_init_vec(g: 'ExecutionGraph', name: 'str', vals: 'list[f32]') -> 'i32':
    # PHẢI tao list[f32] bang _nd_f32, KHONG duoc `v = []` + append.
    # `v = []` sinh List`1<TkvInt> (TkvInt = so nguyen khong kich thuoc),
    # con g.initializers la dict[str, list[f32]] -> gan List<TkvInt> vao
    # cho kieu List<float32> -> runtime doc sai offset ->
    # ArgumentOutOfRangeException. TokenVector KHONG kiem tra kieu khi gan
    # vao dict (chi kiem tra khi goi ham), nen phai giu dung kieu o day.
    # (2026-09-26) `len()` tra int32, nhung `_nd_f32`, `element_count`,
    # `byte_size` va shape deu can i64. Compiler KHONG tu mo rong i32 -> i64
    # o cho goi ham/gan field (ILSpy: "Expected I8, but got I4" o 4 cho),
    # nen phai ep TUONG MINH mot lan bang `int64(...)` roi dung `n` o moi
    # vi tri can i64. Vong lap giu `range(len(vals))` vi chi so `i` can i32
    # cho get_Item/Set_Item.
    n = int64(len(vals))
    v = _nd_f32(n)
    for i in range(len(vals)):
        v[i] = vals[i]
    g.initializers[name] = v
    # TensorDesc phai KHUOP DUNG so phan tu. _const_graph_ex tao tensor
    # cho ten extra voi shape [1] (de op co the tro toi initializer),
    # nhung _t_init_vec nap nhieu hon 1 phan tu (vd "BI" = [0.0, 0.0]).
    # get_or_create_tensor KHONG tu cap nhat khi shape da co ([1] khong
    # rong) -> byte_size van la 4 byte -> initialize_weights copy 8 byte
    # vao slot 4 byte -> ArgumentOutOfRangeException. Sua o day.
    d = g.get_or_create_tensor(name, [n])
    if len(d.shape) != 1 or d.shape[0] != n:
        d.shape = [n]
        d.element_count = n
        d.byte_size = n * 4
    return 0

def _run(g: 'ExecutionGraph', names: 'list[str]', vals: 'list[list[f32]]', out_name: 'str') -> 'list[f32]':
    s = session_from_graph(g, 0)
    _ins = []
    for _k in range(len(names)):
        _ins.append(named_tensor(names[_k], vals[_k]))
    _od = g.tensors[out_name]
    _osh = _od.shape
    if len(_osh) > 0:
        _oc = calc_element_count(_osh)
    else:
        _oc = _od.element_count
    _out = _nd_f32(_oc)
    _outs = []
    _outs.append(named_tensor(out_name, _out))
    s.run(_ins, _outs)
    s.close()
    return _out

def test_generate_loop_text() -> 'i32':
    g = _const_graph(OperatorType_Relu, [[4]], [4])
    s = session_from_graph(g, 0)
    cfg = GenConfig(1, 3, -1, "chatml", default_sample_params())
    cfg.max_new_tokens = 3
    params = cfg.params
    params.temperature = 0.0
    res = generate_text(s, StubTok(1), "hello", cfg)
    s.close()
    prompt_tokens = res.prompt_tokens
    completion_tokens = res.completion_tokens
    text = res.text
    assert prompt_tokens == 2
    assert completion_tokens == 3
    assert text == "hi"
    return 0

def test_writer_emits_modelproto() -> 'i32':
    g = _const_graph(OperatorType_Relu, [[2]], [2])
    raw = export_model(g, "tv-test")
    assert len(raw) > 16
    assert ord(raw[0]) == 8
    return 0

def test_constant_fold_translate() -> 'i32':
    m = OnnxModel(1, 0, "", "", "", 0, "", OnnxGraph(1, ""))
    n = OnnxNode(1, "", "")
    n.name = "c0"
    n.op_type = "Constant"
    _ah722_4 = n.outputs
    _ah722_4.append("K")
    a = OnnxAttribute(1, "v", 0, 0.0, 0, "", OnnxTensor(1, "", 1, ""), OnnxGraph(1, ""))
    a.type = 6
    a.floats = [3.0, 4.0]
    n.attrs["value_floats"] = a
    mg4 = m.graph
    _ah727_4 = mg4.nodes
    _ah727_4.append(n)
    g = translate(m)
    assert "K" in g.initializers
    assert len(g.nodes) == 0
    _inits = g.initializers
    _kinit = _inits["K"]
    assert _kinit[0] == 3.0 and _kinit[1] == 4.0
    return 0

def test_gathernd_scatter() -> 'i32':
    g = _const_graph(OperatorType_GatherND, [[2, 2], [1, 2]], [1])
    d = _nd_f32(4)
    for i in range(4):
        d[i] = float(i + 1)
    idx = _nd_f32(2)
    idx[0] = 1.0
    idx[1] = 0.0
    y = _run(g, ["I0", "I1"], [d, idx], "Y")
    assert y[0] == 3.0
    g = _const_graph(OperatorType_ScatterElements, [[2, 2], [2, 2], [2, 2]], [2, 2])
    _nd0 = g.nodes[0]
    _nd0.axis = 0
    ii = _nd_f32(4)
    ii[0] = 0.0
    ii[1] = 0.0
    ii[2] = 1.0
    ii[3] = 1.0
    u = _nd_f32(4)
    u[0] = 9.0
    u[1] = 9.0
    u[2] = 8.0
    u[3] = 8.0
    y = _run(g, ["I0", "I1", "I2"], [d, ii, u], "Y")
    assert y[0] == 9.0 and y[2] == 8.0
    return 0

def test_range_eye_cumsum() -> 'i32':
    g = ExecutionGraph(1, "rng", 0)
    _ah762_4 = g.inputs
    _ah762_4.append("S")
    _ah762_4.append("E")
    _ah762_4.append("D")
    _ah763_4 = g.outputs
    _ah763_4.append("Y")
    for nm in ["S", "E", "D"]:
        g.get_or_create_tensor(nm, [1])
    g.get_or_create_tensor("Y", [3])
    n = new_node("r", OperatorType_Range)
    _ah768_4 = n.inputs
    _ah768_4.append("S")
    _ah768_4.append("E")
    _ah768_4.append("D")
    _ah769_4 = n.outputs
    _ah769_4.append("Y")
    _ah770_4 = g.nodes
    _ah770_4.append(n)
    s = _nd_f32(1)
    e = _nd_f32(1)
    d = _nd_f32(1)
    e[0] = 5.0
    d[0] = 2.0
    y = _run(g, ["S", "E", "D"], [s, e, d], "Y")
    assert y[0] == 0.0 and y[1] == 2.0 and (y[2] == 4.0)
    g = _const_graph(OperatorType_EyeLike, [[2, 3]], [2, 3])
    y = _run(g, ["I0"], [_nd_f32(6)], "Y")
    assert y[0] == 1.0 and y[1] == 0.0 and (y[3] == 0.0) and (y[4] == 1.0)
    g = _const_graph(OperatorType_CumSum, [[4]], [4])
    _nd1 = g.nodes[0]
    _nd1.axis = 0
    c = _nd_f32(4)
    for i in range(4):
        c[i] = float(i + 1)
    y = _run(g, ["I0"], [c], "Y")
    assert y[0] == 1.0 and y[1] == 3.0 and (y[3] == 10.0)
    return 0

def test_mish_prelu_instancenorm() -> 'i32':
    g = _const_graph(OperatorType_Mish, [[2]], [2])
    m = _nd_f32(2)
    m[1] = 1.0
    y = _run(g, ["I0"], [m], "Y")
    assert y[0] == 0.0 and y[1] > 0.8 and (y[1] < 0.9)
    g = _const_graph_ex(OperatorType_PRelu, [[2]], [2], ["SL"])
    _t_init_vec(g, "SL", [0.5])
    p = _nd_f32(2)
    p[0] = -2.0
    p[1] = 3.0
    y = _run(g, ["I0"], [p], "Y")
    assert y[0] == -1.0 and y[1] == 3.0
    g = _const_graph_ex(OperatorType_InstanceNormalization, [[1, 2, 2]], [1, 2, 2], ["SC", "BI"])
    _t_init_vec(g, "SC", [1.0, 1.0])
    _t_init_vec(g, "BI", [0.0, 0.0])
    v = _nd_f32(4)
    v[0] = 0.0
    v[1] = 2.0
    v[2] = 4.0
    v[3] = 6.0
    y = _run(g, ["I0"], [v], "Y")
    assert abs(y[0] + 1.0) < 0.0001 and abs(y[1] - 1.0) < 0.0001 and (abs(y[2] + 1.0) < 0.0001)
    return 0

def test_speculative_all_accept() -> 'i32':
    g = _const_graph_ex(OperatorType_FusedLinear, [[4]], [4], ["W", "B"])
    w = _nd_f32(16)
    _t_init_mat(g, "W", [4, 4], 0.0)
    _t_init_vec(g, "B", [0.0, 10.0, 0.0, 0.0])
    t = session_from_graph(g, 0)
    d = session_from_graph(g, 0)
    p = SampleParams(1, 0.0, 0, 1.0, 0.0, 1.0, 0, 0)
    p.temperature = 0.0
    gen = speculative_generate(t, d, StubTok(1), "hi", 4, 2, p, 4, 4, -1)
    t.close()
    d.close()
    if gen != [1, 1, 1, 1]:
        return 1
    return 0

def test_tools_parse_validate() -> 'i32':
    _td = ToolDef(1, "search", "web search")
    _td.required = ["q"]
    tools = []
    tools.append(_td)
    call = parse_tool_call("think ```json {\"name\": \"search\", \"arguments\": {\"q\": \"x\"}} ``` done")
    assert call is not None and call.name == "search"
    assert validate_args(call, tools) == ""
    assert parse_tool_call("no json here") is None
    bad = ToolCall(1, "nope", "{}")
    assert validate_args(bad, tools) != ""
    return 0

def test_autograd_trains_step() -> 'i32':
    w = _nd_f32(1)
    w[0] = 0.5
    b = _nd_f32(1)
    head = lin_head(w, b, 1, 1, 1)
    x = _nd_f32(1)
    x[0] = 2.0
    t = _nd_f32(1)
    t[0] = 4.0
    l1 = train_step(head, x, t, 0.1)
    l2 = train_step(head, x, t, 0.1)
    assert abs(l1 - 9.0) < 0.0001 and l2 < l1
    return 0

def test_grammar_prefix_mask() -> 'i32':
    g = compile_grammar("root ::= \"hi\"")
    assert is_live(g, "") == 1
    assert is_live(g, "h") == 1
    assert is_live(g, "hi") == 1
    assert is_live(g, "hx") == 0
    assert is_live(g, "hix") == 0
    ids = allowed_token_ids(g, GrammarStubTok(1), 3, "h")
    assert 1 in ids and 2 not in ids
    return 0

def _onnx_float_init(gr: 'OnnxGraph', name: 'str', vals: 'list[f32]') -> 'i32':
    t = OnnxTensor(1, name, 1, "")
    t.dtype = 1
    _qx1000 = []
    for _qx1004 in vals:
        _qx1000.append(_qx1004)
    t.float_data = _qx1000
    _ah883_4 = gr.initializers
    _ah883_4.append(t)
    return 0

def _vi1(name: 'str') -> 'OnnxValueInfo':
    return OnnxValueInfo(1, name, 1)

def test_if_loop_end_to_end() -> 'i32':
    m = OnnxModel(1, 0, "", "", "", 0, "", OnnxGraph(1, ""))
    ifn = OnnxNode(1, "", "")
    ifn.name = "br"
    ifn.op_type = "I"
    _ah894_4 = ifn.inputs
    _ah894_4.append("C")
    _ah894_4.append("X")
    _ah895_4 = ifn.outputs
    _ah895_4.append("Y")
    tb = OnnxGraph(1, "")
    rn = OnnxNode(1, "", "")
    rn.name = "r"
    rn.op_type = "Relu"
    _ah900_4 = rn.inputs
    _ah900_4.append("X")
    _ah901_4 = rn.outputs
    _ah901_4.append("T")
    _ah902_4 = tb.nodes
    _ah902_4.append(rn)
    vt = OnnxValueInfo(1, "T", 1)
    _ah904_4 = tb.outputs
    _ah904_4.append(vt)
    eb = OnnxGraph(1, "")
    nn = OnnxNode(1, "", "")
    nn.name = "n"
    nn.op_type = "Neg"
    _ah909_4 = nn.inputs
    _ah909_4.append("X")
    _ah910_4 = nn.outputs
    _ah910_4.append("E")
    _ah911_4 = eb.nodes
    _ah911_4.append(nn)
    ve = OnnxValueInfo(1, "E", 1)
    _ah913_4 = eb.outputs
    _ah913_4.append(ve)
    at = OnnxAttribute(1, "then_branch", 0, 0.0, 0, "", OnnxTensor(1, "", 1, ""), OnnxGraph(1, ""))
    at.graph = tb
    ae = OnnxAttribute(1, "else_branch", 0, 0.0, 0, "", OnnxTensor(1, "", 1, ""), OnnxGraph(1, ""))
    ae.graph = eb
    ifn.attrs["then_branch"] = at
    ifn.attrs["else_branch"] = ae
    mg = m.graph
    _ah920_4 = mg.nodes
    _ah920_4.append(ifn)
    _ah921_4 = mg.inputs
    _ah921_4.append(_vi1("X"))
    _ah922_4 = mg.outputs
    _ah922_4.append(_vi1("Y"))
    g = translate(m)
    _t_init_vec(g, "C", [1.0])
    s = session_from_graph(g, 0)
    x = _nd_f32(1)
    x[0] = 3.0
    y = s.run_single(x, "X", "Y")
    s.close()
    assert abs(y[0] - 3.0) < 0.00001
    m2 = OnnxModel(1, 0, "", "", "", 0, "", OnnxGraph(1, ""))
    lp = OnnxNode(1, "", "")
    lp.name = "loop"
    lp.op_type = "Loop"
    _ah935_4 = lp.inputs
    _ah935_4.append("M")
    _ah935_4.append("C")
    _ah935_4.append("X")
    _ah936_4 = lp.outputs
    _ah936_4.append("Y")
    body = OnnxGraph(1, "")
    bi0 = OnnxValueInfo(1, "I", 1)
    bi1 = OnnxValueInfo(1, "C0", 1)
    bi2 = OnnxValueInfo(1, "X0", 1)
    _ah941_4 = body.inputs
    _ah941_4.append(bi0)
    _ah941_4.append(bi1)
    _ah941_4.append(bi2)
    add = OnnxNode(1, "", "")
    add.name = "add"
    add.op_type = "Add"
    _ah945_4 = add.inputs
    _ah945_4.append("X0")
    _ah945_4.append("ONE")
