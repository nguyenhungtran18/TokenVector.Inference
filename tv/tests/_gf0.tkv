# PROBE _gf0 — smoke simd_gemm_full (tkvc 2026-10-26, Yeu cau #2 Uu tien A)
# ----------------------------------------------------------------------------
# Compiler team giao: simd_gemm_full(a, b, c, m, n, k, ndim, trans_b, T, mode)
#   mode=0 ghi de c = AxB, mode=1 tich luy c += AxB; a/b/c = list[f32].
# Verifying tu repo nay (khong tin tuong reply):
#   [1] mode0 tb0 vs scalar ref            (TOL 1e-4)
#   [2] mode0 tb1 (B luu [n][k]) vs ref    (TOL 1e-4)
#   [3] mode1 tich luy vs c0 + ref         (TOL 1e-4)
#   [4] BIT vs wrapper _smm_pk (k=256, T=256, smm_fwd)  — mong doi 0.0
#   [5] edge: T > min(m,n)                 (TOL 1e-4)
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_gf0.tkv out/gf0.exe main; out/gf0.exe
import tv.training.tensor
import tv.training.simd_matmul

TOL = 0.0001

def _fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def report(name: 'str', d: 'f64', tol: 'f64') -> 'i32':
    if d <= tol:
        print("  [PASS] " + name + "  maxdiff=" + str(d))
        return 0
    print("  [FAIL] " + name + "  maxdiff=" + str(d) + "  tol=" + str(tol))
    return 1

# scalar ref: C[m][n] = A[m][k] x B[k][n] (tb=0) hoac A x B^T (tb=1, B luu [n][k])
def _ref(a: "list[f32]", b: "list[f32]", m: 'i64', n: 'i64', k: 'i64',
         ndim: 'i64', tb: 'i32', base: "list[f32]", acc: 'i32') -> "list[f32]":
    out = []
    for i in range(m * n):
        out.append(0.0)
    i = 0
    while i < m:
        j = 0
        while j < n:
            s = 0.0
            p = 0
            while p < k:
                bv = 0.0
                if tb == 0:
                    bv = b[p * ndim + j]
                else:
                    bv = b[j * ndim + p]
                s = s + a[i * k + p] * bv
                p = p + 1
            if acc == 1:
                out[i * n + j] = base[i * n + j] + s
            else:
                out[i * n + j] = s
            j = j + 1
        i = i + 1
    return out

def main() -> 'i32':
    fails = 0

    # ---- [1] mode0 tb0 20x20x20 T=8 (co pre-fill 999 de chac ghi de) -------
    A = t_zeros([20, 20])
    B = t_zeros([20, 20])
    C = t_zeros([20, 20])
    _fill(A.data, 400, 1)
    _fill(B.data, 400, 2)
    for i in range(400):
        C.data[i] = 999.0
    ad: "list[f32]" = A.data
    bd: "list[f32]" = B.data
    cd: "list[f32]" = C.data
    rv = simd_gemm_full(ad, bd, cd, 20, 20, 20, 20, 0, 8, 0)
    if rv != 0:
        print("  [FAIL] c1 rc=" + str(rv))
        fails = fails + 1
    else:
        ref1 = _ref(A.data, B.data, 20, 20, 20, 20, 0, C.data, 0)
        fails = fails + report("c1 mode0 tb0 20x20x20 T=8", _maxdiff(C.data, ref1, 400), TOL)

    # ---- [2] mode0 tb1 — B luu [n][k] = [13][9], ndim=k=9, m=17 ------------
    A2 = t_zeros([17, 9])
    B2 = t_zeros([13, 9])
    C2 = t_zeros([17, 13])
    _fill(A2.data, 153, 3)
    _fill(B2.data, 117, 4)
    ad2: "list[f32]" = A2.data
    bd2: "list[f32]" = B2.data
    cd2: "list[f32]" = C2.data
    rv = simd_gemm_full(ad2, bd2, cd2, 17, 13, 9, 9, 1, 4, 0)
    if rv != 0:
        print("  [FAIL] c2 rc=" + str(rv))
        fails = fails + 1
    else:
        ref2 = _ref(A2.data, B2.data, 17, 13, 9, 9, 1, C2.data, 0)
        fails = fails + report("c2 mode0 tb1 17x13x9 T=4", _maxdiff(C2.data, ref2, 221), TOL)

    # ---- [3] mode1 tich luy (prefill c0) ------------------------------------
    A3 = t_zeros([17, 13])
    B3 = t_zeros([13, 9])
    C3 = t_zeros([17, 9])
    _fill(A3.data, 221, 5)
    _fill(B3.data, 117, 6)
    _fill(C3.data, 153, 7)
    ad3: "list[f32]" = A3.data
    bd3: "list[f32]" = B3.data
    cd3: "list[f32]" = C3.data
    c0: "list[f32]" = []
    for i in range(153):
        c0.append(cd3[i])
    rv = simd_gemm_full(ad3, bd3, cd3, 17, 9, 13, 9, 0, 4, 1)
    if rv != 0:
        print("  [FAIL] c3 rc=" + str(rv))
        fails = fails + 1
    else:
        ref3 = _ref(A3.data, B3.data, 17, 9, 13, 9, 0, c0, 1)
        fails = fails + report("c3 mode1 acc 17x9x13 T=4", _maxdiff(C3.data, ref3, 153), TOL)

    # ---- [4] BIT vs wrapper _smm_pk: k=256 -> smm_fwd (M4 packed), T=256 ----
    m4 = 32
    n4 = 48
    k4 = 256
    A4 = t_zeros([m4, k4])
    B4 = t_zeros([k4, n4])
    C4 = t_zeros([m4, n4])
    _fill(A4.data, m4 * k4, 8)
    _fill(B4.data, k4 * n4, 9)
    rb4 = smm_fwd(A4, B4, m4, n4, k4)
    ad4: "list[f32]" = A4.data
    bd4: "list[f32]" = B4.data
    cd4: "list[f32]" = C4.data
    rv = simd_gemm_full(ad4, bd4, cd4, m4, n4, k4, n4, 0, 256, 0)
    if rv != 0:
        print("  [FAIL] c4 rc=" + str(rv))
        fails = fails + 1
    else:
        fails = fails + report("c4 BIT vs _smm_pk (smm_fwd 32x48x256)",
                               _maxdiff(C4.data, rb4.data, m4 * n4), 0.0)

    # ---- [5] edge: T lon hon min(m,n) ---------------------------------------
    A5 = t_zeros([1, 7])
    B5 = t_zeros([7, 5])
    C5 = t_zeros([1, 5])
    _fill(A5.data, 7, 10)
    _fill(B5.data, 35, 11)
    ad5: "list[f32]" = A5.data
    bd5: "list[f32]" = B5.data
    cd5: "list[f32]" = C5.data
    rv = simd_gemm_full(ad5, bd5, cd5, 1, 5, 7, 5, 0, 16, 0)
    if rv != 0:
        print("  [FAIL] c5 rc=" + str(rv))
        fails = fails + 1
    else:
        ref5 = _ref(A5.data, B5.data, 1, 5, 7, 5, 0, C5.data, 0)
        fails = fails + report("c5 edge 1x5x7 T=16 (> min)", _maxdiff(C5.data, ref5, 5), TOL)

    print("SMOKE simd_gemm_full: fails=" + str(fails) + "/5")
    return fails
