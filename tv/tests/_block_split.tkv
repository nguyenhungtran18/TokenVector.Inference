# PROBE BLOCK-BWD SPLIT (SPEC_FUSED_SDPA_BWD §4.9 - tim 55 ms/layer con thieu)
# Muc dich: gpt2_attention_bwd do rieng = 65 ms/layer (co abuf) nhung bwd full
# step = 3156/12 = 263 ms/layer. Can biet phan con lai nam o dau:
#   LN fwd recompute / mlp_bwd / LN bwd / simd_add / attention_bwd.
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_block_split.tkv out/bsplit.exe main
#   copy -> out/bsplit_n10.dll + runtimeconfig ; dotnet out/bsplit_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    h4 = 4 * h
    h3 = 3 * h

    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    ln1_g = t_zeros([h])
    ln1_b = t_zeros([h])
    ln2_g = t_zeros([h])
    ln2_b = t_zeros([h])
    wqkv = t_zeros([h, h3])
    bqkv = t_zeros([h3])
    wproj = t_zeros([h, h])
    bproj = t_zeros([h])
    w1 = t_zeros([h, h4])
    b1 = t_zeros([h4])
    w2 = t_zeros([h4, h])
    b2 = t_zeros([h])

    # pool giong production
    abuf = [t_zeros([1]), t_zeros([1]), t_zeros([n, h]), t_zeros([n, h]),
            t_zeros([n, h]), t_zeros([1]), t_zeros([n, h3]), t_zeros([n, h3])]
    sav_a = t_zeros([n, h])
    sav_r = t_zeros([n, h])
    sav_m = t_zeros([n, h])
    sav_in = t_zeros([n, h4])
    sav_ag = t_zeros([n, h4])
    ibuf = t_zeros([n, h4])
    dbuf = t_zeros([n, h4])

    print("=== BLOCK BWD SPLIT seq=" + str(n) + " ===")

    # ---- A) toan bo gpt2_block_bwd (production, co save_*) ----
    for i in range(1):
        rb = gpt2_block_bwd(x, ln1_g, ln1_b, wqkv, bqkv, wproj, bproj,
                            ln2_g, ln2_b, w1, b1, w2, b2, gout, 1, None, None,
                            sav_r, sav_a, sav_m, sav_in, sav_ag, ibuf, dbuf, abuf)
    t0 = now_ms()
    for i in range(4):
        rb = gpt2_block_bwd(x, ln1_g, ln1_b, wqkv, bqkv, wproj, bproj,
                            ln2_g, ln2_b, w1, b1, w2, b2, gout, 1, None, None,
                            sav_r, sav_a, sav_m, sav_in, sav_ag, ibuf, dbuf, abuf)
    t_blk = now_ms() - t0
    print("A) gpt2_block_bwd FULL   4 iters ms=" + str(t_blk) + "  -> per-layer " + str(t_blk / 4.0))

    # ---- B) attention_bwd rieng (co abuf) ----
    for i in range(2):
        ra = gpt2_attention_bwd(x, wqkv, bqkv, wproj, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
    t0 = now_ms()
    for i in range(8):
        ra = gpt2_attention_bwd(x, wqkv, bqkv, wproj, bproj, n, gout, 1, None, -1, -1, -1, -1, abuf)
    t_att = now_ms() - t0
    print("B) attention_bwd (abuf)  8 iters ms=" + str(t_att) + "  -> per-layer " + str(t_att / 8.0))

    # ---- C) mlp_bwd rieng (co save_*) ----
    for i in range(1):
        rm = gpt2_mlp_bwd(x, w1, b1, w2, b2, n, gout, 1, None, -1, -1, -1, -1, sav_in, sav_ag, ibuf, dbuf)
    t0 = now_ms()
    for i in range(4):
        rm = gpt2_mlp_bwd(x, w1, b1, w2, b2, n, gout, 1, None, -1, -1, -1, -1, sav_in, sav_ag, ibuf, dbuf)
    t_mlp = now_ms() - t0
    print("C) mlp_bwd (save_*)      4 iters ms=" + str(t_mlp) + "  -> per-layer " + str(t_mlp / 4.0))

    # ---- D) LN bwd x2 (native) ----
    dxln = t_zeros([n, h])
    holder = t_zeros([2 * h])
    gfl = holder.data
    _xd = x.data
    _sad = sav_a.data
    _smd = sav_m.data
    _l1g = ln1_g.data
    _l2g = ln2_g.data
    _dxd = dxln.data
    t0 = now_ms()
    for i in range(20):
        rc1 = layernorm_bwd_fused(_xd, _sad, _l1g, _dxd, gfl, n, h, 0, h)
        rc2 = layernorm_bwd_fused(_xd, _smd, _l2g, _dxd, gfl, n, h, 0, h)
    t_ln = now_ms() - t0
    print("D) LN bwd x2 native      20 iters ms=" + str(t_ln) + "  -> per-layer " + str(t_ln / 20.0) + "  rc=" + str(rc1) + "/" + str(rc2))

    # ---- E) 2x simd_add [n,h] ----
    _gd2 = gout.data
    _ad2 = sav_a.data
    _md2 = sav_m.data
    t0 = now_ms()
    for i in range(50):
        simd_add(_gd2, _ad2, _gd2)
        simd_add(_gd2, _md2, _gd2)
    t_add = now_ms() - t0
    print("E) 2x simd_add [n,h]     50 iters ms=" + str(t_add) + "  -> per-layer " + str(t_add / 50.0))

    # ---- F) tong manh ----
    sum_p = t_att / 8.0 + t_mlp / 4.0 + t_ln / 20.0 + t_add / 50.0
    print("SUM parts per-layer = " + str(sum_p) + "   (block full = " + str(t_blk / 4.0) + ")")
    return 0
