import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    ih = 4 * h
    V = VocabSize
    NL = NLayers
    print("=== gpt2_mlp_bwd DAY DU vs 3 MANH, cung 4 bo weight ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    w1a = t_zeros([h, ih])
    w1b = t_zeros([h, ih])
    w1c = t_zeros([h, ih])
    w1d = t_zeros([h, ih])
    w2a = t_zeros([ih, h])
    w2b = t_zeros([ih, h])
    w2c = t_zeros([ih, h])
    w2d = t_zeros([ih, h])
    b1 = t_zeros([ih])
    b2 = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    inner = t_zeros([n, ih])
    at = t_zeros([n, ih])
    ibuf = t_zeros([n, ih])
    dbuf = t_zeros([n, ih])
    abuf = []
    abuf.append(t_zeros([n, ih]))
    abuf.append(t_zeros([n, h]))
    j = 2
    while j < 12:
        abuf.append(t_zeros([n, ih]))
        j = j + 1
    base = V * h + MaxPos * h + h + h
    stride = h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h

    ow1a = base + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1a = ow1a + 4 * h * h
    ow2a = ob1a + 4 * h
    ob2a = ow2a + 4 * h * h
    b1o = base + stride
    ow1b = b1o + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1b = ow1b + 4 * h * h
    ow2b = ob1b + 4 * h
    ob2b = ow2b + 4 * h * h
    b2o = base + 2 * stride
    ow1c = b2o + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1c = ow1c + 4 * h * h
    ow2c = ob1c + 4 * h
    ob2c = ow2c + 4 * h * h
    b3o = base + 3 * stride
    ow1d = b3o + h + h + 3 * h * h + 3 * h + h * h + h + h + h
    ob1d = ow1d + 4 * h * h
    ow2d = ob1d + 4 * h
    ob2d = ow2d + 4 * h * h

    # warm
    r = gpt2_mlp_bwd(x, w1a, b1, w2a, b2, n, gout, 0, gflat, ow1a, ob1a, ow2a, ob2a, inner, at, ibuf, dbuf, abuf)
    r = gpt2_mlp_bwd(x, w1b, b1, w2b, b2, n, gout, 0, gflat, ow1b, ob1b, ow2b, ob2b, inner, at, ibuf, dbuf, abuf)
    r = gpt2_mlp_bwd(x, w1c, b1, w2c, b2, n, gout, 0, gflat, ow1c, ob1c, ow2c, ob2c, inner, at, ibuf, dbuf, abuf)
    r = gpt2_mlp_bwd(x, w1d, b1, w2d, b2, n, gout, 0, gflat, ow1d, ob1d, ow2d, ob2d, inner, at, ibuf, dbuf, abuf)

    t0 = now_ms()
    r = gpt2_mlp_bwd(x, w1a, b1, w2a, b2, n, gout, 0, gflat, ow1a, ob1a, ow2a, ob2a, inner, at, ibuf, dbuf, abuf)
    f1 = now_ms() - t0
    t0 = now_ms()
    r = gpt2_mlp_bwd(x, w1b, b1, w2b, b2, n, gout, 0, gflat, ow1b, ob1b, ow2b, ob2b, inner, at, ibuf, dbuf, abuf)
    f2 = now_ms() - t0
    t0 = now_ms()
    r = gpt2_mlp_bwd(x, w1c, b1, w2c, b2, n, gout, 0, gflat, ow1c, ob1c, ow2c, ob2c, inner, at, ibuf, dbuf, abuf)
    f3 = now_ms() - t0
    t0 = now_ms()
    r = gpt2_mlp_bwd(x, w1d, b1, w2d, b2, n, gout, 0, gflat, ow1d, ob1d, ow2d, ob2d, inner, at, ibuf, dbuf, abuf)
    f4 = now_ms() - t0
    full = (f1 + f2 + f3 + f4) / 4.0
    print("FULL gpt2_mlp_bwd: " + str(f1) + " " + str(f2) + " " + str(f3) + " " + str(f4) + "  TB=" + str(full) + " ms")
    print("3 manh (probe truoc) TB = 50.75 ms")
    print("=> GLUE = " + str(full - 50.75) + " ms/layer")
    return 0
