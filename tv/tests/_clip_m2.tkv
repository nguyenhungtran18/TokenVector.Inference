# PROBE CLIP BREAKDOWN m2 — f32_zero tren buffer 474 MB
import tv.training.gpt2_ref124
import tv.training.trainer


def main() -> 'i32':
    print("=== CLIP BREAKDOWN: rzp f32_zero ===")
    n: "i32" = 124439808
    print("n = " + str(n) + "  (" + str(float(n * 4) / 1048576.0) + " MB)")
