# PROBE K64N — kiem: ep k=64 qua duong NATIVE (_smm_full) co nhanh hon va co
# bit-giong duong hien tai (tiled .tkv) khong?
# ------------------------------------------------------------------------
# Goc re (HANDOFF §0.70): `_smm_core` re nhanh theo `k`:
#     if k >= 256 -> _smm_full / _smm_pk  (native)
#     else        -> duong tiled .tkv: Ct/AtB/BtB + 16x16 tile + simd_gemm + _acc_f
# 72 GEMM cua gpt2_attention_bwd co k = hd = 64 -> roi vao duong tiled va chi dat
# 13.8 GFLOP/s (do o `_g64`), trong khi cung shape voi k=256 dat 91.4 GFLOP/s.
#
# Probe nay so TRUC TIEP 2 duong tren cung du lieu: toc do + so phan tu lech bit.
# Neu bit giong va nhanh hon nhieu -> chi can ha nguong `k >= 256` (1 dong, 3 mirror).
#
# Chay: dotnet out/k64n.exe
import tv.training.gpt2_ref124
import tv.training.simd_matmul

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def main() -> 'i32':
    n = 1024
    hd = HeadDim
    reps = 6
    a = t_zeros([n, hd])
    b = t_zeros([n, hd])
    ad = a.data
    bd = b.data
    i = 0
    while i < n * hd:
        ad[i] = float(i % 17) * 0.01 - 0.08
        bd[i] = float(i % 13) * 0.01 - 0.06
        i = i + 1

    c_tiled = smm_dot(a, b, n, n, hd)
    c_native = _smm_full(a, b, n, n, hd, hd, 1)
    td = c_tiled.data
    nd = c_native.data
    bad = 0
    mx = 0.0
    i = 0
    while i < n * n:
        dv = td[i] - nd[i]
        if dv < 0.0:
            dv = 0.0 - dv
        if dv > mx:
            mx = dv
        if td[i] != nd[i]:
            bad = bad + 1
        i = i + 1
    print("K64N bit_bad=" + str(bad) + " / " + str(n * n) + "  maxdiff=" + str(mx))

    b1 = 1.0e9
    k = 0
    while k < 3:
        t0 = now_ms()
        i = 0
        while i < reps:
            c1 = smm_dot(a, b, n, n, hd)
            i = i + 1
        t1 = now_ms()
        if t1 - t0 < b1:
            b1 = t1 - t0
        k = k + 1

    b2 = 1.0e9
    k = 0
    while k < 3:
        t0 = now_ms()
        i = 0
        while i < reps:
            c2 = _smm_full(a, b, n, n, hd, hd, 1)
            i = i + 1
        t1 = now_ms()
        if t1 - t0 < b2:
            b2 = t1 - t0
        k = k + 1

    fl = 2.0 * float(n) * float(n) * float(hd) * float(reps)
    print("K64N tiled  (hien tai) = " + str(b1 / float(reps)) + " ms/lời   "
          + str(fl / b1 / 1000000.0) + " GFLOP/s")
    print("K64N native (_smm_full)= " + str(b2 / float(reps)) + " ms/lời   "
          + str(fl / b2 / 1000000.0) + " GFLOP/s")
    print("K64N ty le nhanh hon   = " + str(b1 / b2))
    return 0
