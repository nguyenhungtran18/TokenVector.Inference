import tv.training.trainer
import tv.runtime.f32_bits

# PROBE _det (2026-10-28): do TINH XAC DINH tung giai doan cua pipeline
# train 1 buoc. Chay nhieu lan, diff output: dong dau tien khac nhau chi ra
# buoc bi loi (copy -> zero_grad -> loss_grad -> grad_norm -> step).

FIX = "tv/tests/fixtures/train_cases.txt"


def _i64(t: 'str') -> 'i64':
    v = 0
    for k in range(len(t)):
        v = v * 10 + (ord(t[k]) - 48)
    return v


def _ints(ln: 'str') -> 'list[i64]':
    out = []
    toks = ln.split(" ")
    for j in range(len(toks)):
        if len(toks[j]) > 0:
            out.append(_i64(toks[j]))
    return out


def _floats(ln: 'str') -> 'list[f32]':
    out = []
    toks = ln.split(" ")
    for j in range(len(toks)):
        if len(toks[j]) > 0:
            out.append(float(toks[j]))
    return out


def _sec_lines(lines: 'list[str]', name: 'str') -> 'list[str]':
    out = []
    on = 0
    for i in range(len(lines)):
        ln = lines[i]
        if len(ln) >= 5 and ln[0:5] == "#sec ":
            if ln[5:] == name:
                on = 1
            else:
                on = 0
        elif on == 1:
            out.append(ln)
    return out


def _sec_first(lines: 'list[str]', name: 'str') -> 'str':
    xs = _sec_lines(lines, name)
    if len(xs) > 0:
        return xs[0]
    return ""


def _kv(ln: 'str', key: 'str') -> 'i64':
    parts = ln.split(" ")
    for i in range(len(parts)):
        kv = parts[i].split("=")
        if len(kv) == 2:
            if kv[0] == key:
                return _i64(kv[1])
    return -1


def _kvf(ln: 'str', key: 'str') -> 'f32':
    parts = ln.split(" ")
    for i in range(len(parts)):
        kv = parts[i].split("=")
        if len(kv) == 2:
            if kv[0] == key:
                return float(kv[1])
    return 0.0


def _flat_rows(rows: 'list[str]') -> 'list[f32]':
    out = []
    for i in range(len(rows)):
        vals = _floats(rows[i])
        for j in range(len(vals)):
            out.append(vals[j])
    return out


def _concat4(a: 'list[f32]', b: 'list[f32]', c: 'list[f32]', d: 'list[f32]') -> 'list[f32]':
    out = []
    for i in range(len(a)):
        out.append(a[i])
    for i in range(len(b)):
        out.append(b[i])
    for i in range(len(c)):
        out.append(c[i])
    for i in range(len(d)):
        out.append(d[i])
    return out


def _bits_of_list(v: 'list[f32]') -> 'str':
    s = ""
    for i in range(len(v)):
        s = s + str(f64_to_f32_bits(float(v[i]))) + " "
    return s


def _copy_into(dst: 'list[f32]', src: 'list[f32]') -> 'i32':
    # cung dang vong nhu trainer_tests (P6 vectorize thanh F1)
    for i in range(len(src)):
        dst[i] = src[i]
    return 0


def _slice_x(xs: 'list[f32]', idx: 'i64') -> 'list[f32]':
    out = []
    for i in range(4):
        out.append(xs[idx * 4 + i])
    return out


def main() -> 'i32':
    txt = read_file(FIX)
    lines = txt.split("\n")
    pl = _sec_first(lines, "params")
    in_d = _kv(pl, "in")
    n_param = _kv(pl, "n_param")
    warmup = _kv(pl, "warmup")
    total = _kv(pl, "total")
    lr_max = _kvf(pl, "lr_max")
    lr_min = _kvf(pl, "lr_min")
    wd = _kvf(pl, "wd")
    b1 = _kvf(pl, "b1")
    b2 = _kvf(pl, "b2")
    eps = _kvf(pl, "eps")
    clip = _kvf(pl, "clip")
    accum = _kv(pl, "accum")
    n_samples = _kv(pl, "n_samples")

    ini = _sec_lines(lines, "init")
    p0 = _concat4(_floats(ini[0]), _floats(ini[1]), _floats(ini[2]), _floats(ini[3]))
    xs = _flat_rows(_sec_lines(lines, "x"))
    ys = _ints(_sec_first(lines, "y"))

    o1 = new_adamw(n_param, warmup, total, lr_max, lr_min, b1, b2, eps, wd, clip)

    # [A2] pone buffer (f32buf toan 1.0 - do vong __init___W1 vectorized)
    _pn = o1.pone
    _ptaddr = o1.pt
    _onb = f32buf_wrap(_pn, n_param)
    _sp = ""
    for k in range(n_param):
        _sp = _sp + str(_onb[k]) + " "
    print("A2_pone=" + _sp)

    # [A] copy
    _copy_into(o1.p, p0)
    print("A_p_copy=" + _bits_of_list(o1.p))

    # [B] zero_grad
    o1.zero_grad()
    print("B_g_zero=" + _bits_of_list(o1.g))

    # [C] 2x mlp_loss_grad
    s1 = new_sampler(n_samples, 42)
    _i0 = s1.next_idx()
    _l0 = mlp_loss_grad(o1.p, _slice_x(xs, _i0), ys[_i0], o1.g, 1.0 / float(accum))
    _i1 = s1.next_idx()
    _l1 = mlp_loss_grad(o1.p, _slice_x(xs, _i1), ys[_i1], o1.g, 1.0 / float(accum))
    print("C_l0=" + str(_l0) + " l1=" + str(_l1))
    print("C_g_grad=" + _bits_of_list(o1.g))

    # [D] grad_norm
    gn = o1.grad_norm()
    print("D_gn=" + str(gn))

    # [E] step
    o1.step()
    print("E_p_step=" + _bits_of_list(o1.p))

    # [F] m/v sau step (sync)
    _smv = o1.sync_mv()
    print("F_m=" + _bits_of_list(o1.m))
    print("F_v=" + _bits_of_list(o1.v))
    return 0
