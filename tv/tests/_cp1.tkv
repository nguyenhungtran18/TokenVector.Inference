# PROBE _CP1 — A3: tai sao f32_copy_to_buf 1700ms trong CJ8 nhung 78ms trong CY3?
# ----------------------------------------------------------------------------
# Cung mot process, tung buoc mo phong them mot yeu to context cua CJ8:
#   A: baseline (CY3-style)         -> mong doi ~78ms
#   B: live-set lon (+5 bufs + pl)  -> ap luc RAM
#   C: zero_grad worker spawn/join  -> anh huong thread
#   D: ghi interpreted vao gl       -> mimics backward write
#   D2: churn list nho (mimics GC)  -> xem co reproduce 1700ms khong
#   E: doc interpreted gl           -> mimics grad_norm
# n=124M (496MB/list) — giong CJ8/CY3.
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cp1.tkv out/cp1.exe main; out/cp1.exe
import tv.training.tensor

def _mkz(n: 'i64') -> "list[f32]":
    out = []
    for i in range(n):
        out.append((float(0) - 0.0) / 1.0)
    return out

def _best_copy(src: "list[f32]", pg: 'i64', n: 'i64', reps: 'i64') -> 'f64':
    best = 1.0e18
    q = 0
    while q < reps:
        t0 = now_ms()
        r = f32_copy_to_buf(src, pg, n)
        t1 = now_ms()
        d = float(t1 - t0)
        if d < best:
            best = d
        q = q + 1
    return best

class _ZJob:
    gl: "list[f32]"
    def __init__(self, gl: "list[f32]") -> 'i64':
        self.gl = gl

def _zr_one(j: "_ZJob") -> 'i64':
    for i in range(len(j.gl)):
        j.gl[i] = 0.0
    return 0

def main() -> 'i32':
    n = 124000000
    gl = _mkz(n)
    pg = alloc_bytes(n * 4)
    rz = f32_zero(pg, n)

    # A: baseline CY3-style
    print("CP1 A baseline copy_to_buf(496MB) = " + str(_best_copy(gl, pg, n, 3)) + " ms")

    # B: +live set (5 bufs + pl)
    pl = _mkz(n)
    pp = alloc_bytes(n * 4)
    pm = alloc_bytes(n * 4)
    pv = alloc_bytes(n * 4)
    pt = alloc_bytes(n * 4)
    po = alloc_bytes(n * 4)
    z1 = f32_zero(pp, n)
    z2 = f32_zero(pm, n)
    z3 = f32_zero(pv, n)
    z4 = f32_zero(pt, n)
    z5 = f32_zero(po, n)
    print("CP1 B +live set (6 bufs + 2 lists = ~4.5GB) = " + str(_best_copy(gl, pg, n, 3)) + " ms")

    # C: zero_grad worker spawn/join (mimics step dau forward)
    zh = thread_spawn(_zr_one, _ZJob(gl))
    jz = thread_join(zh)
    print("CP1 C after zero worker = " + str(_best_copy(gl, pg, n, 3)) + " ms")

    # D: ghi interpreted vao gl (mimics backward)
    i = 0
    while i < n:
        gl[i] = float((i % 13) - 6) * 0.001
        i = i + 1
    print("CP1 D after interpreted write = " + str(_best_copy(gl, pg, n, 3)) + " ms")

    # D2: churn — 5M list nho (mimics GC garbage truoc r1)
    junk = []
    for i in range(5000000):
        junk.append(i * 1.0)
    print("CP1 D2 after 5M-elem churn = " + str(_best_copy(gl, pg, n, 3)) + " ms")

    # E: doc interpreted (mimics grad_norm)
    s = 0.0
    i = 0
    while i < n:
        s = s + gl[i] * gl[i]
        i = i + 1
    print("CP1 E after interpreted read (sum=" + str(s) + ") = " + str(_best_copy(gl, pg, n, 3)) + " ms")
    print("CP1 done")
    return 0