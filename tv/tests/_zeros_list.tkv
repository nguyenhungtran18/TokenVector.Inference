# PROBE ZEROS_LIST (2026-11-10) — zeros_list(n) ton bao nhieu so voi buffer native?
#
# t_zeros -> zeros_list(n) -> List<f32>. Do duoc t_zeros([V,h]) = 125 ms cho
# 147 MB = 1.2 GB/s, trong khi f32_zero tren buffer native = 15 ms (10 GB/s).
# Probe nay do rieng tung manh de biet ai la diem nghen.
import tv.training.gpt2_ref124

def main() -> 'i32':
    h = HiddenSize
    V = VocabSize
    nv: "i64" = V * h
    mb = float(nv * 4) / 1048576.0
    print("=== ZEROS_LIST  n=" + str(nv) + "  (" + str(mb) + " MB) ===")

    # --- A) zeros_list (duong hien tai cua t_zeros) ---
    t0 = now_ms()
    a = zeros_list(nv)
    t1 = now_ms()
    b = zeros_list(nv)
    t2 = now_ms()
    c = zeros_list(nv)
    t3 = now_ms()
    print("A) zeros_list x3        = " + str(t1 - t0) + " / " + str(t2 - t1) + " / " + str(t3 - t2) + " ms")

    # --- B) alloc + f32_zero + wrap ---
    p = alloc_bytes(nv * 4)
    t4 = now_ms()
    r1 = f32_zero(p, nv)
    w1 = f32buf_wrap(p, nv)
    t5 = now_ms()
    r2 = f32_zero(p, nv)
    w2 = f32buf_wrap(p, nv)
    t6 = now_ms()
    r3 = f32_zero(p, nv)
    w3 = f32buf_wrap(p, nv)
    t7 = now_ms()
    print("B) alloc+zero+wrap x3   = " + str(t5 - t4) + " / " + str(t6 - t5) + " / " + str(t7 - t6) + " ms")

    # --- C) chi f32_zero ---
    t8 = now_ms()
    z1 = f32_zero(p, nv)
    t9 = now_ms()
    z2 = f32_zero(p, nv)
    t10 = now_ms()
    print("C) f32_zero x2          = " + str(t9 - t8) + " / " + str(t10 - t9) + " ms")

    # --- D) chi f32buf_wrap ---
    t11 = now_ms()
    x1 = f32buf_wrap(p, nv)
    t12 = now_ms()
    x2 = f32buf_wrap(p, nv)
    t13 = now_ms()
    print("D) f32buf_wrap x2       = " + str(t12 - t11) + " / " + str(t13 - t12) + " ms")

    # --- E) t_zeros that (co ca Tensor alloc) ---
    t14 = now_ms()
    _t1 = t_zeros([V, h])
    t15 = now_ms()
    _t2 = t_zeros([V, h])
    t16 = now_ms()
    print("E) t_zeros([V,h]) x2    = " + str(t15 - t14) + " / " + str(t16 - t15) + " ms")

    f1 = free_bytes(p)

    print("")
    print("--- ket luan ---")
    print("A (zeros_list)      lan cuoi = " + str(t3 - t2) + " ms")
    print("B (alloc+zero+wrap) lan cuoi = " + str(t7 - t6) + " ms")
    print("C (f32_zero)        lan cuoi = " + str(t10 - t9) + " ms")
    print("D (f32buf_wrap)     lan cuoi = " + str(t13 - t12) + " ms")
    return 0
