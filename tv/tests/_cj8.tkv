# PROBE CJ8 — PHASE PROFILE 1 buoc train PRODUCTION-REAL (P1.1/P5.5/M4/M6/M5)
# ---------------------------------------------------------------------------
# Ban sao dung y _step124 cua simd_bench_124m_seq (mode 1) nhung tach timer
# tung phase + trong step() tach rieng tung phep (giong _cy3, best-of-3 tai
# cho nho, day la 1 lan tai 124M):
#   zero worker (song song fwd) | fwd | loss | bwd | step (r1/addcmul/adamw/
#   r3/r4/r5) | copy-back ps <- opt.p
# Muc do: tim 17s du thua (full-step 29.5 - fwd/bwd 12.4 @seq1024) va chot
# M5-opt bo r2/r4/r5 thuc su loi duoc bao nhieu.
# seq doc tu cfg (tv/tests/_seq_cfg.txt) — dat 256 de RAM an toan.
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj8.tkv out/cj8.exe main
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

CFG = "tv/tests/_seq_cfg.txt"

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> "list[f32]":
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

def _mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def _mk_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

def _f124_fwd2(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32',
               sc5: "list[f32]" = None) -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_forward_saved(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                              ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd, sc5)

def _f124_bwd(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]', simd: 'i32',
              gflat: 'list[f32]' = None, saves: 'list[Tensor]' = None,
              sc4: "list[f32]" = None) -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_backward(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                         ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], simd, gflat, saves, sc4)

class _BqZrJob:
    gl: "list[f32]"
    def __init__(self, gl: "list[f32]"):
        self.gl = gl

def _bq_zr_one(j: "_BqZrJob") -> 'i64':
    for i in range(len(j.gl)):
        j.gl[i] = 0.0
    return 0

def _n_param(ps: 'list[Tensor]') -> 'i64':
    n = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        n = n + len(d)
    return n

def _groups(ps: 'list[Tensor]') -> 'list[i64]':
    out = []
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        out.append(len(d))
    return out

def main() -> 'i32':
    cfg = load_ints(CFG)
    seq = cfg[0]
    print("CJ8 phase profile seq=" + str(seq))
    ids = _mk_ids(seq)
    pos = _mk_pos(seq)
    ps = gpt2_init(7)
    n = _n_param(ps)
    groups = _groups(ps)
    opt = new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999,
                      0.00000001, 0.0, 1.0)
    # prepare: ps -> opt.p (setup)
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            opt.p[off + j] = d[j]
        off = off + len(d)
    sc5 = t_zeros([seq * VocabSize])
    sc4 = t_zeros([VocabSize * HiddenSize])
    sd = sc5.data
    cd = sc4.data

    # ---- WARMUP 1 buoc (khong do) -----------------------------------------
    zh0 = thread_spawn(_bq_zr_one, _BqZrJob(opt.g))
    sv0 = _f124_fwd2(ps, ids, pos, 1, sd)
    l0 = gpt2_loss(sv0[0], ids)
    jz0 = thread_join(zh0)
    gr0 = _f124_bwd(ps, ids, pos, 1, opt.g, sv0, cd)
    opt.step()
    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)

    # ---- MEASURED 1 buoc, tach phase ---------------------------------------
    t0 = now_ms()
    zh = thread_spawn(_bq_zr_one, _BqZrJob(opt.g))
    t_sp = now_ms()
    sv = _f124_fwd2(ps, ids, pos, 1, sd)
    t_fw = now_ms()
    loss = gpt2_loss(sv[0], ids)
    t_ls = now_ms()
    jz = thread_join(zh)
    t_zr = now_ms()
    grads = _f124_bwd(ps, ids, pos, 1, opt.g, sv, cd)
    t_bw = now_ms()

    # step() tach pha — cong thuc copy y step() hien tai (5 copy)
    lr = lr_at(opt.t, opt.warmup, opt.total, opt.lr_max, opt.lr_min)
    gn = opt.grad_norm()
    t_gn = now_ms()
    coef = 1.0
    if gn > 0.0:
        coef = opt.clip / (gn + 0.000001)
        if coef > 1.0:
            coef = 1.0
    t1 = opt.t + 1
    bc1 = 1.0 - _bp(opt.b1, t1)
    bc2 = 1.0 - _bp(opt.b2, t1)
    step_size = lr / bc1
    bc2s = sqrt(bc2)
    gl: "list[f32]" = opt.g
    pl: "list[f32]" = opt.p
    pgl: "i64" = opt.pg
    ppl: "i64" = opt.pp
    pml: "i64" = opt.pm
    pvl: "i64" = opt.pv
    ptl: "i64" = opt.pt
    ponl: "i64" = opt.pone
    rsm = opt.sync_mv()
    ml: "list[f32]" = opt.m
    vl: "list[f32]" = opt.v
    r1 = f32_copy_to_buf(gl, pgl, opt.n)
    t_r1 = now_ms()
    gsrc: "i64" = pgl
    if coef != 1.0:
        rzp = f32_zero(ptl, opt.n)
        rax = f32_addcmul(ptl, pgl, ponl, coef, opt.n)
        gsrc = ptl
    t_clip = now_ms()
    r2 = f32_copy_to_buf(pl, ppl, opt.n)
    t_r2 = now_ms()
    wde = opt.wd * bc1
    stw = adamw_step(ppl, pml, pvl, gsrc, opt.n,
                     step_size, opt.b1, opt.b2, opt.eps, wde, bc1, bc2s)
    t_aw = now_ms()
    r3 = f32_copy_from_buf(ppl, pl, opt.n)
    t_r3 = now_ms()
    r4 = f32_copy_from_buf(pml, ml, opt.n)
    r5 = f32_copy_from_buf(pvl, vl, opt.n)
    t_r45 = now_ms()
    opt.t = opt.t + 1

    off = 0
    for i in range(len(ps)):
        t = ps[i]
        d = t.data
        for j in range(len(d)):
            d[j] = opt.p[off + j]
        off = off + len(d)
    t6 = now_ms()

    print("CJ8 loss=" + str(loss))
    print("CJ8 zero_worker(spawn) = " + str(t_sp - t0) + " ms")
    print("CJ8 FWD                = " + str(t_fw - t_sp) + " ms")
    print("CJ8 LOSS               = " + str(t_ls - t_fw) + " ms")
    print("CJ8 zero_join          = " + str(t_zr - t_ls) + " ms")
    print("CJ8 BWD                = " + str(t_bw - t_zr) + " ms")
    print("CJ8   grad_norm        = " + str(t_gn - t_bw) + " ms")
    print("CJ8   r1 copy g->buf    = " + str(t_r1 - t_gn) + " ms")
    print("CJ8   clip addcmul      = " + str(t_clip - t_r1) + " ms")
    print("CJ8   r2 copy p->buf    = " + str(t_r2 - t_clip) + " ms")
    print("CJ8   adamw_step        = " + str(t_aw - t_r2) + " ms")
    print("CJ8   r3 copy p<-buf    = " + str(t_r3 - t_r2) + " ms")
    print("CJ8   r4+r5 m/v<-buf    = " + str(t_r45 - t_r3) + " ms")
    print("CJ8 copy-back ps<-opt.p = " + str(t6 - t_r45) + " ms")
    print("CJ8 TOTAL              = " + str(t6 - t0) + " ms")
    print("CJ8 done")
    return 0
