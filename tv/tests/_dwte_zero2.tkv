# PROBE DWTE ZERO v2 (2026-11-10) — GHI DE hay CONG DON?
# Nap san dwte = 1.0 roi goi kernel 1 lan:
#   - neu ket qua ~0        -> GHI DE (t_zeros truoc do VO ICH)
#   - neu ket qua ~1 + grad -> CONG DON (phai zero)
import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize
    print("=== DWTE ZERO v2 V=" + str(V) + " ===")

    xf = t_zeros([n, h])
    wte = t_zeros([V, h])
    dxf = t_zeros([n, h])
    dwte = t_zeros([V, h])
    logits = t_zeros([n, V])
    pids = alloc_bytes(n * 4)
    j = 0
    while j < n:
        w = write_i32(pids, j * 4, (j * 37 + 11) % 50257)
        j = j + 1

    _lgd = logits.data
    _wtd = wte.data
    _xfd = xf.data
    _dd = dxf.data
    _dw = dwte.data
    sc = 1.0 / float(n)

    # nap san 1.0 vao dwte
    k = 0
    while k < V * h:
        _dw[k] = 1.0
        k = k + 1
    before = 0.0
    for k in range(0, V * h, 9973):
        before = before + _dw[k]
    print("A) sum truoc khi goi (moi phan tu = 1.0) = " + str(before))

    st = lmhead_bwd_fused_list(_lgd, pids, _wtd, _xfd, _dd, _dw, n, 1, h, V, sc)

    after = 0.0
    for k in range(0, V * h, 9973):
        after = after + _dw[k]
    print("B) sum sau khi goi                          = " + str(after))
    print("C) st=" + str(st))
    if after < before * 0.5:
        print("D) KET LUAN: GHI DE -> t_zeros 154MB truoc do la VO ICH (tiet kiem ~125 ms)")
    else:
        print("D) KET LUAN: CONG DON -> phai zero, KHONG bo duoc")
    return 0
