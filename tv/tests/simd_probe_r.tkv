# PROBE R — in tung phan tu: ref dw[k,o] vs dwT vs dw (smm path)
import tv.training.tensor
import tv.training.gpt2_ref
import tv.training.simd_matmul

def fill(m: 'i64', n: 'i64', kind: 'i64') -> "Tensor":
    out = t_zeros([m, n])
    d = out.data
    for i in range(m * n):
        if kind == 5:
            d[i] = (float((i * 7 + 13) % 97) - 48.0) / 48.0
        if kind == 6:
            d[i] = (float((i * 13 + 7) % 59) - 29.0) / 29.0
    return out

def main() -> 'i32':
    m = 32
    in_d = 64
    out_d = 192
    x = fill(m, in_d, 5)
    gy = fill(m, out_d, 6)

    acc = 0.0
    for i in range(m):
        acc = acc + x.data[i * in_d + 3] * gy.data[i * out_d + 5]
    print("R0 ref dw[3,5] = " + str(acc))

    gyT = smm_transpose(gy, m, out_d)
    print("R1 gyT[5,3] (can = gy[3,5]) = " + str(gyT.data[5 * m + 3]) + " vs gy[3,5] = " + str(gy.data[3 * out_d + 5]))

    dwT = smm_dot(gyT, x, out_d, in_d, m)
    print("R2 dwT[5,3] (can = ref) = " + str(dwT.data[5 * in_d + 3]))

    dw = smm_transpose(dwT, out_d, in_d)
    print("R3 dw[3,5] (can = ref) = " + str(dw.data[3 * out_d + 5]))
    return 0
