# PROBE BC — P5.8 chuan doan tiep (2 gia thuyet con lai tu BB):
# BC-v1  = clone v1 (nhanh, doi chieu) — giong BB-v1.
# BC-v5  = v3 (bien thua, da do = khong cham) + chi nhanh use_acc voi
#          simd_add/simd_sub call site (KHONG chay vi use_acc=0 tai shape nay)
#          -> neu cham: nguyen nhan = call site simd_add/simd_sub lam codegen.
# BC-v6  = copy NGUYEN VAN _p58_core + _p58_tile_a_at + _p58_ceildiv vao probe,
#          goi trans_a=0 -> neu cham TRONG PROBE: noi dung function;
#          neu nhanh: vi tri/checkbox module simd_matmul.
# Shape: m=256, n=2304, k=768 (qkv-like, cung AY/BB). Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bc.tkv out/bc.exe main
#   ./out/bc.exe
import tv.training.ops
import tv.training.simd_matmul

def _fill(rows: 'i64', cols: 'i64', seed: 'i64') -> "Tensor":
    out = t_zeros([rows, cols])
    d = out.data
    for i in range(rows * cols):
        d[i] = (float((i * 13 + seed) % 211) - 105.0) / 105.0
    return out

def _bc_ceildiv(a: 'i64', b: 'i64') -> 'i64':
    r = 0
    s = 0
    while s < a:
        s = s + b
        r = r + 1
    return r

# ---- BC-v1: clone v1 nhanh (doi chieu) ----------------------------------------
def _bc_v1(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32') -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Ct = _zeros_list(T * T)
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            At = _tile_a(a, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                Bt = _tile_b(b, ndim, p0, pw, j0, jb, T, trans_b)
                simd_gemm(At, Bt, Ct, T)
                r = 0
                while r < ib:
                    bc = (i0 + r) * n + j0
                    bt = r * T
                    c = 0
                    while c < jb:
                        cd[bc + c] = cd[bc + c] + Ct[bt + c]
                        c = c + 1
                    r = r + 1
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return C

# ---- BC-v5: v3 + chi nhanh use_acc + simd_add/simd_sub call site (khong chay) --
def _bc_v5(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32') -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Rt = _zeros_list(T * T)
    p0t = _bc_ceildiv(k, T)
    j0t = _bc_ceildiv(n, T)
    use_acc = 0
    if p0t >= 2:
        if j0t == 1:
            if m * n >= T * T:
                use_acc = 1
    acc = _zeros_list(1)
    if use_acc == 1:
        acc = _zeros_list(T * T)
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            At = _tile_a(a, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                Bt = _tile_b(b, ndim, p0, pw, j0, jb, T, trans_b)
                simd_gemm(At, Bt, Rt, T)
                if use_acc == 1:
                    simd_add(acc, Rt, acc)
                else:
                    r = 0
                    while r < ib:
                        bc = (i0 + r) * n + j0
                        bt = r * T
                        c = 0
                        while c < jb:
                            cd[bc + c] = cd[bc + c] + Rt[bt + c]
                            c = c + 1
                        r = r + 1
                j0 = j0 + jb
            p0 = p0 + pw
        if use_acc == 1:
            r = 0
            while r < ib:
                bc = (i0 + r) * n
                bt = r * T
                c = 0
                while c < n:
                    cd[bc + c] = cd[bc + c] + acc[bt + c]
                    c = c + 1
                r = r + 1
            simd_sub(acc, acc, acc)
        i0 = i0 + ib
    return C

# ---- BC-v6: copy NGUYEN VAN tu simd_matmul (trans_a=0 khi goi) -----------------
def _bc_v6_tile_a_at(a: "Tensor", mdim: 'i64', i0: 'i64', ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'list[f32]':
    out = _zeros_list(T * T)
    d = a.data
    t = 0
    while t < pw:
        src = (p0 + t) * mdim + i0
        off = t
        r = 0
        while r < ib:
            out[r * T + off] = (d[src + r] - 0.0) / 1.0
            r = r + 1
        t = t + 1
    return out

def _bc_v6_core(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64', ndim: 'i64', trans_b: 'i32', trans_a: 'i32') -> "Tensor":
    T = _imin(_tilek(k), _roundup64(_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Rt = _zeros_list(T * T)
    p0t = _bc_ceildiv(k, T)
    j0t = _bc_ceildiv(n, T)
    use_acc = 0
    if p0t >= 2:
        if j0t == 1:
            if m * n >= T * T:
                use_acc = 1
    acc = _zeros_list(1)
    if use_acc == 1:
        acc = _zeros_list(T * T)
    i0 = 0
    while i0 < m:
        ib = _imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _imin(T, k - p0)
            if trans_a == 1:
                At = _bc_v6_tile_a_at(a, m, i0, ib, p0, pw, T)
            else:
                At = _tile_a(a, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _imin(T, n - j0)
                Bt = _tile_b(b, ndim, p0, pw, j0, jb, T, trans_b)
                simd_gemm(At, Bt, Rt, T)
                if use_acc == 1:
                    simd_add(acc, Rt, acc)
                else:
                    r = 0
                    while r < ib:
                        bc = (i0 + r) * n + j0
                        bt = r * T
                        c = 0
                        while c < jb:
                            cd[bc + c] = cd[bc + c] + Rt[bt + c]
                            c = c + 1
                        r = r + 1
                j0 = j0 + jb
            p0 = p0 + pw
        if use_acc == 1:
            r = 0
            while r < ib:
                bc = (i0 + r) * n
                bt = r * T
                c = 0
                while c < n:
                    cd[bc + c] = cd[bc + c] + acc[bt + c]
                    c = c + 1
                r = r + 1
            simd_sub(acc, acc, acc)
        i0 = i0 + ib
    return C

def main() -> 'i32':
    m = 256
    n = 2304
    kk = 768
    a = _fill(m, kk, 3)
    b = _fill(kk, n, 7)
    print("BC m=" + str(m) + " n=" + str(n) + " k=" + str(kk))
    c1 = _bc_v1(a, b, m, n, kk, kk, 1)
    c5 = _bc_v5(a, b, m, n, kk, kk, 1)
    c6 = _bc_v6_core(a, b, m, n, kk, kk, 1, 0)
    d5 = c5.data[0] - c1.data[0]
    d6 = c6.data[0] - c1.data[0]
    print("BC bit5=" + str(d5) + " bit6=" + str(d6))
    i = 0
    while i < 3:
        t0 = now_ms()
        c1 = _bc_v1(a, b, m, n, kk, kk, 1)
        t1 = now_ms()
        dv1 = t1 - t0
        t0 = now_ms()
        c5 = _bc_v5(a, b, m, n, kk, kk, 1)
        t1 = now_ms()
        dv5 = t1 - t0
        t0 = now_ms()
        c6 = _bc_v6_core(a, b, m, n, kk, kk, 1, 0)
        t1 = now_ms()
        dv6 = t1 - t0
        print("BC rep" + str(i) + " v1=" + str(dv1) + "  v5simdbranch=" + str(dv5) + "  v6copy=" + str(dv6))
        i = i + 1
    print("BC done")
    return 0
