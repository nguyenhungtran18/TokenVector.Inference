# PROBE OPT.STEP BENCH-MIMIC (HANDOFF §0.132 - uu tien (c), buoc 5)
# Mau thuan can giai:
#   _opt_wrap.tkv : opt.step() = 1172 ms, _body(opt) = 484 ms  (ca 2 thu tu)
#   bench mode 2  : pha opt = 859-875 ms  (TRUOC va SAU khi doi sang wrapper)
# Neu method that su ton 1172 thi bench phai thay. Neu bench dung 875 thi
# probe cua toi do sai cho nao do.
#
# Khac biet giua probe va bench:
#   - bench: groups = 28 nhom (moi tham so 1 nhom), clip = 1.0, wd = 0.0
#   - probe: groups = 1 nhom, clip = 1.0, wd = 0.0
#   - bench: opt.step() chay NGAY SAU bwd (cache/RAM dang nong)
#
# Probe nay dung CA HAI cau hinh groups va do 3 duong.
#
# Chay:
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_opt_benchmimic.tkv out/obm.exe main
#   copy -> out/obm_n10.dll + runtimeconfig ; dotnet out/obm_n10.dll
#
# LUU Y bug #8: now_ms() phai dat trong main.
import tv.training.trainer

def _mk(n: 'i64', groups: 'list[i64]', wd: 'f32', clip: 'f32') -> "AdamW":
    return new_adamw_g(n, groups, 2, 1000, 0.05, 0.0025, 0.9, 0.999, 1.0e-8, wd, clip)

def _fill(o: "AdamW", n: 'i64') -> 'i32':
    gl = o.g
    i = 0
    while i < n:
        gl[i] = 0.001
        i = i + 1
    pl = o.p
    i = 0
    while i < n:
        pl[i] = 0.02
        i = i + 1
    return 0

def _run(n: 'i64', ng: 'i64') -> 'i32':
    # groups: ng nhom deu nhau (giong _groups(ps) cua bench khi ng = 28)
    groups: "list[i64]" = []
    per = n / ng
    i = 0
    while i < ng:
        groups.append(per)
        i = i + 1
    o = _mk(n, groups, 0.0, 1.0)
    o.t = 0
    _fill(o, n)
    # lam nong
    _w = o.step()
    _w2 = _adamw_step_impl(o)

    bestM = 1.0e9
    bestF = 1.0e9
    kk = 0
    while kk < 4:
        t0 = now_ms()
        lrM = o.step()
        dt = now_ms() - t0
        if dt < bestM:
            bestM = dt
        t0 = now_ms()
        lrF = _adamw_step_impl(o)
        dt = now_ms() - t0
        if dt < bestF:
            bestF = dt
        kk = kk + 1
    print("groups=" + str(ng) + "  opt.step()=" + str(bestM)
          + "  _adamw_step_impl(o)=" + str(bestF)
          + "  chenh=" + str(bestM - bestF))
    return 0

def main() -> 'i32':
    n = 124439808
    print("=== OPT.STEP BENCH-MIMIC n=" + str(n) + " ===")
    _run(n, 1)
    _run(n, 28)
    _run(n, 1)
    return 0
