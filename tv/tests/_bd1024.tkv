# PROBE BD1024 — phan ra `gpt2_block_bwd` tai seq 1024 (HANDOFF §0.64 muc A)
# -----------------------------------------------------------------------
# Muc dich: HANDOFF §0.64 ket luan 69% thoi gian 1 luong la non-GEMM, nhung do la
# UOC LUONG. Probe nay do truc tiep 4 vung cua block_bwd tai seq lon, de biet
# phan non-GEMM nam o dau truoc khi cat.
#
# Vi sao seq lon + 1 luong:
#   - `now_ms()` co do phan giai ~15.6 ms (xem `_am`). Tai seq1024 mot lan goi
#     block_bwd o 1 luong ~1.6 s nen moi vung deu >> 1 quantum -> khong phai batch.
#   - O 14 luong GEMM nhanh 4.5x nhung phan non-GEMM khong nhanh, nen ty le
#     non-GEMM/GEMV nhin ro hon o 1 luong; va 1 luong la moc so sanh truc tiep
#     voi torch T=1 (15180 ms full step).
#
# Chay (tu goc repo):
#   TKV_GEMM_THREADS=1 dotnet out/bd1024.exe
# Build:
#   "D:/TokenVector/Release/dist/tkvc-tv.exe" tv/tests/_bd1024.tkv out/bd1024.exe main
#
# Khong doi mot dong code production nao: chi goi cac ham san co.
import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.simd_matmul

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def main() -> 'i32':
    seq = 1024
    cfg = read_file("tv/tests/_seq_cfg.txt")
    cl = cfg.split("\n")
    for i in range(len(cl)):
        if len(cl[i]) > 0:
            v = int(float(cl[i]))
            if v > 0:
                seq = v
            break

    h = HiddenSize

    # ids/pos tong hop, tat dinh (khong phu thuoc fixture seq8)
    ids = []
    pos = []
    for i in range(seq):
        ids.append((i * 37 + 11) % VocabSize)
        pos.append(i)
    print("BD seq=" + str(seq) + " h=" + str(h) + " NLayers=" + str(NLayers))

    ps = gpt2_init(7)

    # forward giu xins (giong backward that)
    t0 = now_ms()
    x = gpt2_embed(ids, pos, ps[0], ps[1])
    xins = []
    for i in range(NLayers):
        xins.append(x)
        b = 4 + i * 12
        x = gpt2_block(x, ps[b + 0], ps[b + 1], ps[b + 2], ps[b + 3],
                       ps[b + 4], ps[b + 5], ps[b + 6], ps[b + 7],
                       ps[b + 8], ps[b + 9], ps[b + 10], ps[b + 11], 1)
    t1 = now_ms()
    print("BD FORWARD_12L    = " + str(t1 - t0) + " ms")

    li = 6
    base = 4 + li * 12
    xi = xins[li]
    gy = t_zeros([seq, h])
    dd = gy.data
    for i in range(seq * h):
        dd[i] = 0.1

    # forward_saved de lay save_r/save_a/save_m — production LUON truyen 3 tensor nay
    # (gpt2_backward: saves[3+N+li], saves[3+2N+li], saves[3+3N+li]); thieu chung thi
    # block_bwd recompute attention fwd + 2 layernorm -> do sai lon.
    l1g = []
    l1b = []
    wq = []
    bq = []
    wp = []
    bp = []
    l2g = []
    l2b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for i in range(NLayers):
        bb = 4 + i * 12
        l1g.append(ps[bb + 0])
        l1b.append(ps[bb + 1])
        wq.append(ps[bb + 2])
        bq.append(ps[bb + 3])
        wp.append(ps[bb + 4])
        bp.append(ps[bb + 5])
        l2g.append(ps[bb + 6])
        l2b.append(ps[bb + 7])
        w1.append(ps[bb + 8])
        b1.append(ps[bb + 9])
        w2.append(ps[bb + 10])
        b2.append(ps[bb + 11])
    sc5 = t_zeros([seq * VocabSize])
    sv = gpt2_forward_saved(ids, pos, ps[0], ps[1], l1g, l1b, wq, bq, wp, bp,
                            l2g, l2b, w1, b1, w2, b2, ps[2], ps[3], 1, sc5.data)
    xi = sv[3 + li]
    s_r = sv[3 + NLayers + li]
    s_a = sv[3 + 2 * NLayers + li]
    s_m = sv[3 + 3 * NLayers + li]
    a = s_a

    # gflat cua 1 block (goff >= 0 = duong production cua trainer)
    numel = []
    numel.append(h)
    numel.append(h)
    numel.append(3 * h * h)
    numel.append(3 * h)
    numel.append(h * h)
    numel.append(h)
    numel.append(h)
    numel.append(h)
    numel.append(4 * h * h)
    numel.append(4 * h)
    numel.append(4 * h * h)
    numel.append(h)
    offs12 = []
    accf = 0
    for j in range(12):
        offs12.append(accf)
        accf = accf + numel[j]
    gflatb = t_zeros([accf])

    b_ln = 1.0e9
    b_att = 1.0e9
    b_mlp = 1.0e9
    b_blk = 1.0e9
    b_res = 1.0e9

    k = 0
    while k < 2:
        t2 = now_ms()
        rl1 = gpt2_layernorm_bwd(xi, ps[base + 0], ps[base + 1], gy,
                                 gflatb.data, offs12[0], offs12[1])
        rl2 = gpt2_layernorm_bwd(xi, ps[base + 6], ps[base + 7], gy,
                                 gflatb.data, offs12[6], offs12[7])
        t3 = now_ms()
        # DUONG PRODUCTION: phai truyen gflat + offsets, neu khong thi mlp/attention
        # di nhanh khac (tra Tensor / copy) va phep tru "ceremony" se sai.
        rb = gpt2_attention_bwd(a, ps[base + 2], ps[base + 3],
                                ps[base + 4], ps[base + 5], seq, gy, 1,
                                gflatb.data, offs12[2], offs12[3], offs12[4], offs12[5])
        t4 = now_ms()
        rm = gpt2_mlp_bwd(a, ps[base + 8], ps[base + 9],
                          ps[base + 10], ps[base + 11], seq, gy, 1,
                          gflatb.data, offs12[8], offs12[9], offs12[10], offs12[11])
        t5 = now_ms()
        blk = gpt2_block_bwd(xi, ps[base + 0], ps[base + 1], ps[base + 2],
                             ps[base + 3], ps[base + 4], ps[base + 5],
                             ps[base + 6], ps[base + 7], ps[base + 8],
                             ps[base + 9], ps[base + 10], ps[base + 11],
                             gy, 1, gflatb.data, offs12, s_r, s_a, s_m)
        t6 = now_ms()
        b_ln = _mn(b_ln, t3 - t2)
        b_att = _mn(b_att, t4 - t3)
        b_mlp = _mn(b_mlp, t5 - t4)
        b_blk = _mn(b_blk, t6 - t5)
        k = k + 1

    b_sum = b_ln + b_att + b_mlp
    b_res = b_blk - b_sum

    print("BD LN_BWD_x2      = " + str(b_ln) + " ms")
    print("BD ATTENTION_BWD  = " + str(b_att) + " ms")
    print("BD MLP_BWD        = " + str(b_mlp) + " ms")
    print("BD SUM_3_vung     = " + str(b_sum) + " ms")
    print("BD BLOCK_BWD      = " + str(b_blk) + " ms (production, co gflat)")
    print("BD CON_LAI        = " + str(b_res) + " ms (block_bwd - 3 vung: residual/copy/ceremony)")
    print("BD BUCKET 12x     = " + str(b_blk * 12.0) + " ms")

    # ty le phan tram so voi block_bwd
    print("BD PCT LN=" + str(b_ln * 100.0 / b_blk) + " ATT=" + str(b_att * 100.0 / b_blk)
          + " MLP=" + str(b_mlp * 100.0 / b_blk) + " RES=" + str(b_res * 100.0 / b_blk))
    return 0
