# PROBE LM — chia vung "lm-head + op_embed_bwd" (HANDOFF §0.68: 7230 ms @1 luong,
# 2464 ms @14 luong, 17% cua buoc) thanh tung op. Day la vung DUY NHAT chua mo.
# ---------------------------------------------------------------------------
# Duong production `simd==1` trong gpt2_backward gom:
#   1  lmhead_bwd_fused_list  (native M6: softmax-grad + dxf + dwte trong 1 call)
#   2  op_embed_bwd(wte, ids)  -> gwte_e   (V*h = 38.6M)
#   3  op_embed_bwd(wpe, pos)  -> gwpe     (MaxPos*h = 786K)
#   4  f32_list_add(dwte, gwte_e)          (V*h = 38.6M)
#   5  vong gwpe -> gflat                  (MaxPos*h = 786K, .tkv tung ptu)
#
# Chay: dotnet out/lm1024.exe   (khong can seq; logits/dwte cap theo seq trong _seq_cfg)
import tv.training.gpt2_ref124

def _mn(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def main() -> 'i32':
    n = 1024
    cfg = read_file("tv/tests/_seq_cfg.txt")
    cl = cfg.split("\n")
    for i in range(len(cl)):
        if len(cl[i]) > 0:
            v = int(float(cl[i]))
            if v > 0:
                n = v
            break

    h = HiddenSize
    V = VocabSize
    np_ = MaxPos
    print("LM n=" + str(n) + " h=" + str(h) + " V=" + str(V))

    ps = gpt2_init(7)
    wte = ps[0]
    wpe = ps[1]

    ids = []
    pos = []
    for i in range(n):
        ids.append((i * 37 + 11) % V)
        pos.append(i)

    xf = t_zeros([n, h])
    dxf = t_zeros([n, h])
    gwte = t_zeros([V, h])
    gwpe = t_zeros([np_, h])
    gl = t_zeros([V * h])

    # logits: t_zeros + dien de co du lieu that (51.5M)
    lg = t_zeros([n * V], )

    # ids buffer cho m6
    pids = alloc_bytes(n * 4)
    i = 0
    while i < n:
        w = write_i32(pids, i * 4, ids[i])
        i = i + 1

    sc: "f32" = 1.0 / float(n)

    b_m6 = 1.0e9
    b_e1 = 1.0e9
    b_e2 = 1.0e9
    b_ad = 1.0e9
    b_gw = 1.0e9

    k = 0
    while k < 2:
        lgd: "list[f32]" = lg.data
        wtd: "list[f32]" = wte.data
        xfd: "list[f32]" = xf.data
        dfd: "list[f32]" = dxf.data
        dwd: "list[f32]" = gwte.data
        t0 = now_ms()
        st = lmhead_bwd_fused_list(lgd, pids, wtd, xfd, dfd, dwd, n, 1, h, V, sc)
        t1 = now_ms()
        e1 = op_embed_bwd(wte, ids, h, xf)
        t2 = now_ms()
        e2 = op_embed_bwd(wpe, pos, h, xf)
        t3 = now_ms()
        gld: "list[f32]" = gl.data
        e1d: "list[f32]" = e1.data
        rad = f32_list_add(gld, e1d, V * h)
        t4 = now_ms()
        gflatb = t_zeros([40 * h * h + 40 * h])
        gf: "list[f32]" = gflatb.data
        o_wpe = 100
        e2d: "list[f32]" = e2.data
        i = 0
        while i < np_ * h:
            gf[o_wpe + i] = gf[o_wpe + i] + e2d[i]
            i = i + 1
        t5 = now_ms()
        if t1 - t0 < b_m6:
            b_m6 = t1 - t0
        if t2 - t1 < b_e1:
            b_e1 = t2 - t1
        if t3 - t2 < b_e2:
            b_e2 = t3 - t2
        if t4 - t3 < b_ad:
            b_ad = t4 - t3
        if t5 - t4 < b_gw:
            b_gw = t5 - t4
        k = k + 1

    print("LM lmhead_bwd_fused (native) = " + str(b_m6) + " ms  st=" + str(st))
    print("LM op_embed_bwd(wte) ids     = " + str(b_e1) + " ms  (V*h=" + str(V * h) + ")")
    print("LM op_embed_bwd(wpe) pos     = " + str(b_e2) + " ms  (MaxPos*h=" + str(np_ * h) + ")")
    print("LM f32_list_add dwte         = " + str(b_ad) + " ms")
    print("LM vong gwpe -> gflat        = " + str(b_gw) + " ms  (.tkv tung ptu)")
    tot = b_m6 + b_e1 + b_e2 + b_ad + b_gw
    print("LM TONG_do_duoc              = " + str(tot) + " ms")
    return 0
