# PROBE BWD TAIL v5 (2026-11-10) — phan NGOAI 12 block cua gpt2_backward
#
# _bwd_insitu: block_bwd = 140 ms/layer (mlp 62 + attention 78, glue = 0).
# 12 block = 1680 ms. Nhung gpt2_backward = ~2860 ms.
# => ~1180 ms nam NGOAI 12 block. Probe nay do phan duoi do:
#    lmhead_bwd_fused_list (2 GEMM 39.5 GFLOP) + t_zeros dwte/gwte + embed + lnf.
import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    V = VocabSize

    xf = t_zeros([n, h])
    wte = t_zeros([V, h])
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1

    print("=== BWD TAIL v5 seq=" + str(n) + " ===")

    # --- A) t_zeros dwte [V,h] 154 MB ---
    t0 = now_ms()
    for i in range(3):
        dwte = t_zeros([V, h])
    t_dwte = (now_ms() - t0) / 3.0
    print("A) t_zeros dwte [V,h] 154MB   = " + str(t_dwte))

    # --- B) t_zeros gwte_e [V*h] 154 MB ---
    t0 = now_ms()
    for i in range(3):
        gw = t_zeros([V * h])
    t_gw = (now_ms() - t0) / 3.0
    print("B) t_zeros gwte_e [V*h] 154MB = " + str(t_gw))

    # --- C) lmhead_bwd_fused_list: 2 GEMM 39.5 GFLOP moi cai ---
    dxf = t_zeros([n, h])
    dwte2 = t_zeros([V, h])
    logits = t_zeros([n, V])
    pids = alloc_bytes(n * 4)
    j = 0
    while j < n:
        w = write_i32(pids, j * 4, ids[j])
        j = j + 1
    _lgd = logits.data
    _wtd = wte.data
    _xfd = xf.data
    _dd = dxf.data
    _dw = dwte2.data
    sc = 1.0 / float(n)
    # warm
    st = lmhead_bwd_fused_list(_lgd, pids, _wtd, _xfd, _dd, _dw, n, 1, h, V, sc)
    t0 = now_ms()
    for i in range(3):
        st = lmhead_bwd_fused_list(_lgd, pids, _wtd, _xfd, _dd, _dw, n, 1, h, V, sc)
    t_lm = (now_ms() - t0) / 3.0
    print("C) lmhead_bwd_fused_list      = " + str(t_lm) + "  st=" + str(st))

    # --- D) f32_list_add 38.6M x2 ---
    a1 = t_zeros([V * h])
    a2 = t_zeros([V * h])
    _a1 = a1.data
    _a2 = a2.data
    t0 = now_ms()
    for i in range(3):
        f32_list_add(_a1, _a2, _a1)
    t_add = (now_ms() - t0) / 3.0
    print("D) f32_list_add [V*h] 154MB   = " + str(t_add))

    # --- E) tong phan duoi ---
    tail = t_dwte + t_gw + t_lm + t_add * 2.0
    print("E) TAIL sum (dwte+gw+lm+2add) = " + str(tail))
    print("F) 12 block (tu _bwd_insitu)  = 1680")
    print("G) block + tail               = " + str(1680.0 + tail))
    print("H) gpt2_backward do duoc      = ~2860 (bench 2844)")
    return 0
