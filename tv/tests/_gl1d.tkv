# PROBE _gl1d — A/B dung nhu production DUOI AP LUC GC DONG THOI (request #4, 4A)
# Muc dich: test hypothesis A3.1 ("adamw_step_glm pin 496MB -> GC dung tuong
# +1.9s/buoc"). Worker rieng lien tuc GC.Collect() (gen2 blocking) TRONG KHI
# main thread dang giu pin va goi P/Invoke — day la dieu kien ma bench A/B
# chi co khi co luong alloc dong thoi (14-worker bench).
#   A: r1 = f32_copy_to_buf(gl, pgl, n) + adamw_step(...)    (dang chay)
#   B: adamw_step_glm(ppl, pml, pvl, gl, ...)                (ung vien)
# Chay:
#   /d/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_gl1d.tkv out/gl1d.exe main
#   ./out/gl1d.exe
import tv.training.tensor


def _gc_worker() -> 'i32':
    k = 0
    while k < 80:
        t = t_zeros([262144])
        d = t.data
        d[0] = 1.0
        c = gc_collect()
        k = k + 1
    return 0


def main() -> 'i32':
    n = 124439808
    lr = 0.0025
    b1 = 0.9
    b2 = 0.999
    eps = 0.00000001
    wd = 0.0
    bc1 = 0.1
    bc2s = 0.001

    p = alloc_bytes(n * 4)
    m = alloc_bytes(n * 4)
    v = alloc_bytes(n * 4)
    pgl = alloc_bytes(n * 4)
    rz1 = f32_zero(p, n)
    rz2 = f32_zero(m, n)
    rz3 = f32_zero(v, n)
    rz4 = f32_zero(pgl, n)
    gt = t_zeros([n])
    gl = gt.data

    # warmup
    w1 = f32_copy_to_buf(gl, pgl, n)
    w2 = adamw_step(p, m, v, pgl, n, lr, b1, b2, eps, wd, bc1, bc2s)
    w3 = adamw_step_glm(p, m, v, gl, n, lr, b1, b2, eps, wd, bc1, bc2s)

    gc0 = gc_counts()
    h = thread_spawn(_gc_worker)

    bestA = 1000000000.0
    bestB = 1000000000.0
    r = 0
    while r < 5:
        t0 = now_ms()
        ra1 = f32_copy_to_buf(gl, pgl, n)
        ra2 = adamw_step(p, m, v, pgl, n, lr, b1, b2, eps, wd, bc1, bc2s)
        t1 = now_ms()
        rb1 = adamw_step_glm(p, m, v, gl, n, lr, b1, b2, eps, wd, bc1, bc2s)
        t2 = now_ms()
        dA = t1 - t0
        dB = t2 - t1
        if dA < bestA:
            bestA = dA
        if dB < bestB:
            bestB = dB
        r = r + 1

    wj = thread_join(h)
    gc1 = gc_counts()
    print("GL1D gc_counts before=" + str(gc0) + " after=" + str(gc1))
    print("GL1D n=" + str(n) + " (GC worker dang chay song song)")
    print("GL1D A prod r1+adamw_step = " + str(bestA) + " ms")
    print("GL1D B adamw_step_glm     = " + str(bestB) + " ms")
    print("GL1D B-A                  = " + str(bestB - bestA) + " ms")
    fb1 = free_bytes(p)
    fb2 = free_bytes(m)
    fb3 = free_bytes(v)
    fb4 = free_bytes(pgl)
    print("GL1D done")
    return 0