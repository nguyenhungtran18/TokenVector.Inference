import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    hd = HeadDim
    V = VocabSize
    NL = NLayers
    print("=== .tkv: overhead cua wrapper managed cho tung loai list ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    print("gflat = " + str(len(gflat)) + " phan tu = " + str(len(gflat) * 4 / 1048576.0) + " MB")
    wqkv = t_zeros([h, 3 * h])
    wproj = t_zeros([h, h])
    bqkv = t_zeros([3 * h])
    bproj = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    dx = t_zeros([n, h])
    qkv = t_zeros([n, 3 * h])
    ctxT = t_zeros([n, h])
    qkvd = qkv.data
    ctd = ctxT.data
    xd = x.data
    gd = gout.data
    dxd = dx.data
    wqd = wqkv.data
    wpd = wproj.data
    bqd = bqkv.data
    bpd = bproj.data
    base = V * h + MaxPos * h + h + h
    oq = base + h + h
    obq = oq + 3 * h * h
    op = obq + 3 * h
    obp = op + h * h

    # 1) torch_sdpa_fwd: list 9.4 MB (qkv)
    s = torch_sdpa_fwd(qkvd, ctd, n, NHeads, hd)
    t0 = now_ms()
    i = 0
    while i < 10:
        s = torch_sdpa_fwd(qkvd, ctd, n, NHeads, hd)
        i = i + 1
    t_sdpa = (now_ms() - t0) / 10.0
    print("1) torch_sdpa_fwd      (qkv 9.4 MB)  = " + str(t_sdpa) + " ms   [C probe: 8.11]")

    # 2) torch_attention_bwd: gflat 498 MB
    r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat, n, h, NHeads, hd, oq, obq, op, obp)
    t0 = now_ms()
    i = 0
    while i < 6:
        r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat, n, h, NHeads, hd, oq, obq, op, obp)
        i = i + 1
    t_bwd = (now_ms() - t0) / 6.0
    print("2) torch_attention_bwd (gflat 498 MB) = " + str(t_bwd) + " ms   [C probe: 63.10]  rc=" + str(r))
    print("   chenh lech = " + str(t_bwd - 63.10) + " ms")
    return 0
