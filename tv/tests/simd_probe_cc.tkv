# PROBE CC — CHUAN DOAN GĐ13 (2026-10-22): ADAMW PARALLEL LAN THU 3
# Boi canh: ADAMW_STEP 3930 ms (11% buoc @124M), da bust 2 lan (BL: SHARED-12
# = 0.36x, OWN+MERGE = 0.29x — merge 372M = 11.7s), boxing DA loai (GĐ9).
# Them du lieu moi tu probe CE (GĐ11): benh "phep toan + ghi list CHUNG" xuat
# hien khi worker ghi ROI doc lai (read-your-write) tren list chung; copy thuan
# (khong doc lai) van 2.0-3.0x; worker ghi own-seg + doc lai own van 2.4-7.3x.
# KET QUA (N=124M, now_ms, best-of-2/1):
#   V0 serial 3297ms | V1 own-seg 1266ms (2.60x) | V2 shared+readback 10984ms (0.30x)
#   V4 copy shared 1297ms (2.54x) | V5 REGISTERS 9937ms (0.33x) | V3 own+merge 2766ms (1.19x)
# BIT: V2-vs-V0 dp=dm=dv=0.0 (bit-exact). V5-vs-V0 dp=9.5e-07 dm=dv=0.0
#   (V5 khong luu tron f32 truoc khi tinh p -> p lech 1 ULP; m/v van chinh xac).
# -> KET LUAN GĐ13: V5 (phep toan toan bo trong thanh ghi, ghi p/m/v 1 lan,
#   KHONG doc-lai) van BUST 0.33x — GIONG V2 (0.30x). Doc-lai khong phai thu pham;
#   benh la phep toan + ghi list CHUNG (van the BL/CE da do). Worker chi scale khi
#   ghi seg RIENG (V1 2.60x), nhung dua ve list chung bang merge serial (V3 1.19x)
#   hay ghi chung (V5) deu an het loi. KHONG co hinh thai AdamW song song nao net
#   win -> DONG GĐ13, khong wire.
#
# -> HYPOTHESIS can chot: doc-lai tren list CHUNG la thu pham (khong phai
# "phep toan + ghi chung" don thuan). V5 do chinh dieu do: phep toan toan bo
# trong thanh ghi (register), ghi p/m/v 1 lan, KHONG doc lai sau khi ghi.
#
# Bien the (N = 124.000.000, now_ms, >=2 lan/variant, best):
#   V0 serial        — copy NGUYEN vong AdamW.step hien tai (GĐ10, co doc-lai)
#   V1 own-seg       — worker ghi seg RIENG, KHONG merge (BL[2] — ceiling compute)
#   V2 shared+readback — copy NGUYEN _bl_aw_shared (BL[2] — benh da do 0.36x)
#   V3 own+merge     — worker own-seg + MAIN merge serial (BL[3] — 0.29x)
#   V4 copy shared   — dieu kien: 12 worker copy g -> tmp, KHONG phep toan
#   V5 REGISTERS     — phep toan trong thanh ghi, ghi p/m/v 1 lan, KHONG doc lai
#                      (UNG VIEN WIRE neu V5 scale)
# Bit-check (subset 12M, inline trong main): V5 vs V2 vs V0 cung dau vao.
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cc.tkv out/cc.exe main
#   ./out/cc.exe

def _cc_div(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return 0
    q = 0
    r = a
    while r >= b:
        step = b
        add = 1
        while (step + step) <= r:
            step = step + step
            add = add + add
        r = r - step
        q = q + add
    return q

def _cc_seg_sz(n: 'i64', k: 'i64') -> 'i64':
    return _cc_div((k + 1) * n, 12) - _cc_div(k * n, 12)

def _cc_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def _cc_zeros(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(0.0)
    return out

def _cc_fill(n: 'i64', salt: 'i64') -> 'list[f32]':
    out = []
    i = 0
    while i < n:
        out.append(float((((i * 131) + salt) % 997) - 498) * 0.017)
        i = i + 1
    return out

def _cc_copy_seg(dst: 'list[f32]', src: 'list[f32]', dlo: 'i64', cnt: 'i64') -> 'i64':
    i = 0
    while i < cnt:
        dst[dlo + i] = src[i]
        i = i + 1
    return 0

# ---- V0 serial — copy NGUYEN vong AdamW.step hien tai (GĐ10, co doc-lai) --
def _cc_aw_ser(p: 'list[f32]', m: 'list[f32]', v: 'list[f32]', g: 'list[f32]',
               n: 'i64', coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
               ks: 'f64', epss: 'f64') -> 'i64':
    i = 0
    while i < n:
        gi = g[i] * coef
        p[i] = p[i] * wdf
        m[i] = b1 * m[i] + (1.0 - b1) * gi
        v[i] = b2 * v[i] + (1.0 - b2) * gi * gi
        p[i] = p[i] - ks * m[i] / (sqrt(v[i]) + epss)
        i = i + 1
    return 0

class _CcJob:
    pl: "list[f32]"
    ml: "list[f32]"
    vl: "list[f32]"
    gl: "list[f32]"
    pseg: "list[f32]"
    mseg: "list[f32]"
    vseg: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    coef: 'f64'
    wdf: 'f64'
    b1: 'f64'
    b2: 'f64'
    ks: 'f64'
    epss: 'f64'
    def __init__(self, pl: "list[f32]", ml: "list[f32]", vl: "list[f32]",
                 gl: "list[f32]", pseg: "list[f32]", mseg: "list[f32]",
                 vseg: "list[f32]", lo: 'i64', hi: 'i64',
                 coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
                 ks: 'f64', epss: 'f64'):
        self.pl = pl
        self.ml = ml
        self.vl = vl
        self.gl = gl
        self.pseg = pseg
        self.mseg = mseg
        self.vseg = vseg
        self.lo = lo
        self.hi = hi
        self.coef = coef
        self.wdf = wdf
        self.b1 = b1
        self.b2 = b2
        self.ks = ks
        self.epss = epss

# ---- V1 own-seg (copy NGUYEN _bl_aw_own) — ghi seg rieng, KHONG merge ------
def _cc_aw_own(j: "_CcJob") -> 'i64':
    ps = j.pseg
    ms = j.mseg
    vs = j.vseg
    k = 0
    i = j.lo
    while i < j.hi:
        gi = j.gl[i] * j.coef
        pv = j.pl[i] * j.wdf
        mv = j.b1 * j.ml[i] + (1.0 - j.b1) * gi
        vv = j.b2 * j.vl[i] + (1.0 - j.b2) * gi * gi
        pv = pv - j.ks * mv / (sqrt(vv) + j.epss)
        ps[k] = pv
        ms[k] = mv
        vs[k] = vv
        k = k + 1
        i = i + 1
    return 0

# ---- V2 shared + doc-lai (copy NGUYEN _bl_aw_shared — BL[2]) ---------------
def _cc_aw_shared(j: "_CcJob") -> 'i64':
    i = j.lo
    while i < j.hi:
        gi = j.gl[i] * j.coef
        j.pl[i] = j.pl[i] * j.wdf
        j.ml[i] = j.b1 * j.ml[i] + (1.0 - j.b1) * gi
        j.vl[i] = j.b2 * j.vl[i] + (1.0 - j.b2) * gi * gi
        j.pl[i] = j.pl[i] - j.ks * j.ml[i] / (sqrt(j.vl[i]) + j.epss)
        i = i + 1
    return 0

# ---- V5 REGISTERS — phep toan thanh ghi, ghi 1 lan, KHONG doc lai ---------
# BIT-EXACT voi V0: V0 luu m/v vao list[f32] (lam tron f32) ROI doc lai de
# tinh p -> p dung GIA TRI F32. V5 lap lai phep lam tron bang scratch RIENG
# cua worker (rt[0] = mv; mv32 = rt[0]) — khong doc list chung.
def _cc_aw_reg(j: "_CcJob") -> 'i64':
    rt = []
    rt.append(0.0)
    i = j.lo
    while i < j.hi:
        gi = j.gl[i] * j.coef
        pv = j.pl[i] * j.wdf
        mv = j.b1 * j.ml[i] + (1.0 - j.b1) * gi
        vv = j.b2 * j.vl[i] + (1.0 - j.b2) * gi * gi
        rt[0] = mv
        mv32 = rt[0]
        rt[0] = vv
        vv32 = rt[0]
        pv = pv - j.ks * mv32 / (sqrt(vv32) + j.epss)
        j.pl[i] = pv
        j.ml[i] = mv
        j.vl[i] = vv
        i = i + 1
    return 0

# ---- V4 copy shared — dieu kien khong phep toan ---------------------------
class _CcCpJob:
    al: "list[f32]"
    bl: "list[f32]"
    lo: 'i64'
    hi: 'i64'
    def __init__(self, al: "list[f32]", bl: "list[f32]", lo: 'i64', hi: 'i64'):
        self.al = al
        self.bl = bl
        self.lo = lo
        self.hi = hi

def _cc_cp_one(j: "_CcCpJob") -> 'i64':
    i = j.lo
    while i < j.hi:
        j.bl[i] = j.al[i]
        i = i + 1
    return 0

# ---- 12 spawn/join — moi bien the 1 ham rieng (bai hoc GĐ4) ---------------
def _cc_v1_all(p: 'list[f32]', m: 'list[f32]', v: 'list[f32]', g: 'list[f32]',
               p0: "list[f32]", m0: "list[f32]", v0: "list[f32]",
               p1: "list[f32]", m1: "list[f32]", v1: "list[f32]",
               p2: "list[f32]", m2: "list[f32]", v2: "list[f32]",
               p3: "list[f32]", m3: "list[f32]", v3: "list[f32]",
               p4: "list[f32]", m4: "list[f32]", v4: "list[f32]",
               p5: "list[f32]", m5: "list[f32]", v5: "list[f32]",
               p6: "list[f32]", m6: "list[f32]", v6: "list[f32]",
               p7: "list[f32]", m7: "list[f32]", v7: "list[f32]",
               p8: "list[f32]", m8: "list[f32]", v8: "list[f32]",
               p9: "list[f32]", m9: "list[f32]", v9: "list[f32]",
               p10: "list[f32]", m10: "list[f32]", v10: "list[f32]",
               p11: "list[f32]", m11: "list[f32]", v11: "list[f32]",
               n: 'i64', coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
               ks: 'f64', epss: 'f64') -> 'i32':
    r0 = _cc_div(0 * n, 12)
    r1 = _cc_div(1 * n, 12)
    r2 = _cc_div(2 * n, 12)
    r3 = _cc_div(3 * n, 12)
    r4 = _cc_div(4 * n, 12)
    r5 = _cc_div(5 * n, 12)
    r6 = _cc_div(6 * n, 12)
    r7 = _cc_div(7 * n, 12)
    r8 = _cc_div(8 * n, 12)
    r9 = _cc_div(9 * n, 12)
    r10 = _cc_div(10 * n, 12)
    r11 = _cc_div(11 * n, 12)
    h0 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p0, m0, v0, r0, r1, coef, wdf, b1, b2, ks, epss))
    h1 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p1, m1, v1, r1, r2, coef, wdf, b1, b2, ks, epss))
    h2 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p2, m2, v2, r2, r3, coef, wdf, b1, b2, ks, epss))
    h3 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p3, m3, v3, r3, r4, coef, wdf, b1, b2, ks, epss))
    h4 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p4, m4, v4, r4, r5, coef, wdf, b1, b2, ks, epss))
    h5 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p5, m5, v5, r5, r6, coef, wdf, b1, b2, ks, epss))
    h6 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p6, m6, v6, r6, r7, coef, wdf, b1, b2, ks, epss))
    h7 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p7, m7, v7, r7, r8, coef, wdf, b1, b2, ks, epss))
    h8 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p8, m8, v8, r8, r9, coef, wdf, b1, b2, ks, epss))
    h9 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p9, m9, v9, r9, r10, coef, wdf, b1, b2, ks, epss))
    h10 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p10, m10, v10, r10, r11, coef, wdf, b1, b2, ks, epss))
    h11 = thread_spawn(_cc_aw_own, _CcJob(p, m, v, g, p11, m11, v11, r11, n, coef, wdf, b1, b2, ks, epss))
    j0 = thread_join(h0)
    j1 = thread_join(h1)
    j2 = thread_join(h2)
    j3 = thread_join(h3)
    j4 = thread_join(h4)
    j5 = thread_join(h5)
    j6 = thread_join(h6)
    j7 = thread_join(h7)
    j8 = thread_join(h8)
    j9 = thread_join(h9)
    j10 = thread_join(h10)
    j11 = thread_join(h11)
    return 0

def _cc_v2_all(p: 'list[f32]', m: 'list[f32]', v: 'list[f32]', g: 'list[f32]',
               n: 'i64', coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
               ks: 'f64', epss: 'f64') -> 'i32':
    r0 = _cc_div(0 * n, 12)
    r1 = _cc_div(1 * n, 12)
    r2 = _cc_div(2 * n, 12)
    r3 = _cc_div(3 * n, 12)
    r4 = _cc_div(4 * n, 12)
    r5 = _cc_div(5 * n, 12)
    r6 = _cc_div(6 * n, 12)
    r7 = _cc_div(7 * n, 12)
    r8 = _cc_div(8 * n, 12)
    r9 = _cc_div(9 * n, 12)
    r10 = _cc_div(10 * n, 12)
    r11 = _cc_div(11 * n, 12)
    zd = []
    zd.append(0.0)
    h0 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r0, r1, coef, wdf, b1, b2, ks, epss))
    h1 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r1, r2, coef, wdf, b1, b2, ks, epss))
    h2 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r2, r3, coef, wdf, b1, b2, ks, epss))
    h3 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r3, r4, coef, wdf, b1, b2, ks, epss))
    h4 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r4, r5, coef, wdf, b1, b2, ks, epss))
    h5 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r5, r6, coef, wdf, b1, b2, ks, epss))
    h6 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r6, r7, coef, wdf, b1, b2, ks, epss))
    h7 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r7, r8, coef, wdf, b1, b2, ks, epss))
    h8 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r8, r9, coef, wdf, b1, b2, ks, epss))
    h9 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r9, r10, coef, wdf, b1, b2, ks, epss))
    h10 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r10, r11, coef, wdf, b1, b2, ks, epss))
    h11 = thread_spawn(_cc_aw_shared, _CcJob(p, m, v, g, zd, zd, zd, r11, n, coef, wdf, b1, b2, ks, epss))
    j0 = thread_join(h0)
    j1 = thread_join(h1)
    j2 = thread_join(h2)
    j3 = thread_join(h3)
    j4 = thread_join(h4)
    j5 = thread_join(h5)
    j6 = thread_join(h6)
    j7 = thread_join(h7)
    j8 = thread_join(h8)
    j9 = thread_join(h9)
    j10 = thread_join(h10)
    j11 = thread_join(h11)
    return 0

def _cc_v5_all(p: 'list[f32]', m: 'list[f32]', v: 'list[f32]', g: 'list[f32]',
               n: 'i64', coef: 'f64', wdf: 'f64', b1: 'f64', b2: 'f64',
               ks: 'f64', epss: 'f64') -> 'i32':
    r0 = _cc_div(0 * n, 12)
