import tv.runtime.simt
import tv.runtime.backend
import tv.runtime.dynamic_shapes
import tv.vision.vit_weights
import tv.onnx.protobuf_reader
import tv.quantization.engine
import tv.quantization.types
import tv.server.batcher
def _clip_grads_for_test(arrays: 'list[list[f32]]', max_norm: 'f32') -> 'f32':
    total = 0.0
    for a in arrays:
        for i in range(len(a)):
            total = total + a[i] * a[i]
    nrm = sqrt(total)
    if nrm <= max_norm or nrm == 0.0:
        return nrm
    scale = max_norm / nrm
    for a in arrays:
        for i in range(len(a)):
            a[i] = a[i] * scale
    return nrm


def test_simt_matmul() -> 'i32':
    a = _nd_f32(4)
    b = _nd_f32(4)
    y = _nd_f32(4)
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    a[3] = 4.0
    b[0] = 1.0
    b[1] = 0.0
    b[2] = 0.0
    b[3] = 1.0
    simt_matmul(a, b, y, 2, 2, 2, 2, 2)
    assert y[0] == 1.0
    assert y[1] == 2.0
    assert y[2] == 3.0
    assert y[3] == 4.0
    return 0


def test_dynamic_shape_specialization() -> 'i32':
    g = ExecutionGraph(1, "dynamic_test", 0)
    g.inputs.append("x")
    g.outputs.append("x")
    g.get_or_create_tensor("x", [1, 1])
    s = InferenceSession(1, default_cpu(), g, arena_create(64), 0)
    concrete = [1, 3]
    specialize_session(s, "x", concrete)
    d = g.tensors["x"]
    assert d.shape[0] == 1
    assert d.shape[1] == 3
    assert d.element_count == 3
    s.close()
    return 0


def test_vit_weight_remap() -> 'i32':
    assert _remap_layer_key("patch_embed.proj.weight") == "patch_w"
    assert _remap_layer_key("blocks.0.attn.qkv.bias") == "L0_qkv_b"
    assert _remap_layer_key("norm.weight") == "lnf_g"
    return 0


def test_backend_dispatch() -> 'i32':
    d = simulation_backend(2, 2)
    assert backend_status(d) == "simulated"
    cuda = backend_for_kind(2)
    assert backend_status(cuda) != "available"
    npu = backend_for_kind(3)
    assert backend_status(npu) != "available"
    a = _nd_f32(4)
    b = _nd_f32(4)
    y = _nd_f32(4)
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    a[3] = 4.0
    b[0] = 1.0
    b[1] = 0.0
    b[2] = 0.0
    b[3] = 1.0
    d.matmul(a, b, y, 2, 2, 2)
    assert y[0] == 1.0
    assert y[1] == 2.0
    assert y[2] == 3.0
    assert y[3] == 4.0
    return 0


def test_pretrain_gradient_clipping() -> 'i32':
    a = _nd_f32(2)
    a[0] = 3.0
    a[1] = 4.0
    arrays = []
    arrays.append(a)
    nrm = _clip_grads_for_test(arrays, 2.5)
    assert nrm == 5.0
    assert a[0] == 1.5
    assert a[1] == 2.0
    return 0


# ===== Chuyen tu C# xUnit (FastProtobufReaderTests) sang Pure TokenVector.
# Mirror tu tests/TokenVector.Inference.Tests/FastProtobufReaderTests.cs:
# varint [0x96,0x01] -> 150, [0xAC,0x02] -> 300, float IEEE754, chuoi.
def test_protobuf_varint() -> 'i32':
    r1 = FastProtobufReader(1, chr(150) + chr(1), 0, 0)
    assert r1.read_varint32() == 150
    r2 = FastProtobufReader(1, chr(172) + chr(2), 0, 0)
    assert r2.read_varint64() == 300
    r3 = FastProtobufReader(1, chr(1), 0, 0)
    assert r3.read_varint32() == 1
    r4 = FastProtobufReader(1, chr(128) + chr(128) + chr(128) + chr(128) + chr(16), 0, 0)
    assert r4.read_varint64() == 4294967296
    return 0


def test_protobuf_float() -> 'i32':
    # Pi float32 LE: 0x40490FDB -> [0xDB, 0x0F, 0x49, 0x40]
    buf = chr(219) + chr(15) + chr(73) + chr(64)
    r = FastProtobufReader(1, buf, 0, 0)
    v = r.read_float()
    assert abs(v - 3.1415927) < 0.000001
    return 0


def test_protobuf_string() -> 'i32':
    buf = chr(21) + "TokenVector.Inference"
    r = FastProtobufReader(1, buf, 0, 0)
    assert r.read_string() == "TokenVector.Inference"
    return 0


# ===== Chuyen tu C# xUnit (QuantizationTests) sang Pure TokenVector.
# Mirror CalibrateMinMax_Symmetric_CalculatesCorrectScale:
# [-12.7, 0, 6.35, 12.7] -> scale 0.1, zp 0.
def test_calibrate_minmax() -> 'i32':
    d = _nd_f32(4)
    d[0] = -12.7
    d[1] = 0.0
    d[2] = 6.35
    d[3] = 12.7
    p = calibrate_minmax(d, 1)
    assert abs(p.scale - 0.1) < 0.00001
    assert p.zero_point == 0
    return 0


def test_quantize_roundtrip() -> 'i32':
    # Mirror QuantizeAndDequantize_Int8_PreservesValuesWithLowError:
    # maxdiff <= scale.
    original = _nd_f32(5)
    original[0] = -1.5
    original[1] = -0.5
    original[2] = 0.0
    original[3] = 0.5
    original[4] = 1.5
    p = calibrate_minmax(original, 1)
    q = _nd_i8(5)
    quantize_int8_symmetric(original, q, p.scale)
    dq = _nd_f32(5)
    dequantize_int8_symmetric(q, dq, p.scale)
    maxdiff = 0.0
    for i in range(5):
        df = original[i] - dq[i]
        if df < 0.0:
            df = 0.0 - df
        if df > maxdiff:
            maxdiff = df
    assert maxdiff <= p.scale + 0.000001
    return 0


def test_fp8_roundtrip() -> 'i32':
    # Mirror FP8_E4M3/E5M2_ConversionRoundtripAccuracy.
    _e4 = _nd_f32(6)
    _e4[0] = 0.0
    _e4[1] = 0.5
    _e4[2] = 1.0
    _e4[3] = -1.0
    _e4[4] = 2.5
    _e4[5] = 16.0
    for i in range(6):
        v = _e4[i]
        rec = fp8e4m3_from_float(v).to_float()
        av = v
        if av < 0.0:
            av = 0.0 - av
        rel = 0.0
        _den = av + 0.00001
        if _den != 0.0:
            _num = v - rec
            if _num < 0.0:
                _num = 0.0 - _num
            rel = _num / _den
        assert rel < 0.15
    _e5 = _nd_f32(6)
    _e5[0] = 0.0
    _e5[1] = 0.25
    _e5[2] = 1.0
    _e5[3] = -2.0
    _e5[4] = 64.0
    _e5[5] = 512.0
    for i in range(6):
        v = _e5[i]
        rec = fp8e5m2_from_float(v).to_float()
        av = v
        if av < 0.0:
            av = 0.0 - av
        rel = 0.0
        _den = av + 0.00001
        if _den != 0.0:
            _num = v - rec
            if _num < 0.0:
                _num = 0.0 - _num
            rel = _num / _den
        assert rel < 0.25
    return 0


def test_batcher_queue() -> 'i32':
    # Mirror DynamicBatcherTests (phan dong bo, khong thread):
    # FIFO + empty sentinel. Phan async (spawn worker) thuoc server runtime.
    q = BatcherQueue(1)
    _e = q.try_read()
    assert _e.done == 1
    d1 = _nd_f32(1)
    d1[0] = 1.0
    d2 = _nd_f32(1)
    d2[0] = 2.0
    # (2026-09-27) Code lai cho dung: input la field container, gan explicit.
    r1w = BatchRequest(1, 0, 0, "")
    r1w.input = d1
    q.write(r1w)
    r2w = BatchRequest(1, 0, 0, "")
    r2w.input = d2
    q.write(r2w)
    r1 = q.try_read()
    assert r1.input[0] == 1.0
    r2 = q.try_read()
    assert r2.input[0] == 2.0
    _e2 = q.try_read()
    assert _e2.done == 1
    return 0


def main() -> 'i32':
    test_simt_matmul()
    test_dynamic_shape_specialization()
    test_vit_weight_remap()
    test_backend_dispatch()
    test_pretrain_gradient_clipping()
    test_protobuf_varint()
    test_protobuf_float()
    test_protobuf_string()
    test_calibrate_minmax()
    test_quantize_roundtrip()
    test_fp8_roundtrip()
    test_batcher_queue()
    print("gap tests: PASS")
    return 0
