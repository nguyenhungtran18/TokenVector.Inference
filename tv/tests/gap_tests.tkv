import tv.runtime.session

# (2026-10-15) Compiler moi KHONG cho index truc tiep vao property `shape`:
# loi "il_codegen: d.shape[0] khong hop le (shape=[])". Doc property qua
# bien trung gian roi index moi duoc, nen bo ham nay cho cac diem can doc 1
# phan tu cua shape.
def _shp_at_gt(d: 'TensorDesc', i: 'i64') -> 'i64':
    _s = d.shape
    return _s[i]
# (2026-09-28) Hang so module KHONG import duoc giua cac module (chi ham/record
# duoc import) - `inference_tests.tkv:42` cung phai khai bao lai y het. Gia tri
# lay tu tv/runtime/session.tkv va tv/optimization/kernels.tkv.
OperatorType_FusedLinear = 2
OperatorType_Relu = 8
OperatorType_Add = 13
ActivationFunction_Relu = 1
def _clip_grads_for_test(arrays: 'list[list[f32]]', max_norm: 'f32') -> 'f32':
    total = 0.0
    for a in arrays:
        for i in range(len(a)):
            total = total + a[i] * a[i]
    nrm = sqrt(total)
    if nrm <= max_norm or nrm == 0.0:
        return nrm
    scale = max_norm / nrm
    for a in arrays:
        for i in range(len(a)):
            a[i] = a[i] * scale
    return nrm


def test_simt_matmul() -> 'i32':
    a = _nd_f32(4)
    b = _nd_f32(4)
    y = _nd_f32(4)
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    a[3] = 4.0
    b[0] = 1.0
    b[1] = 0.0
    b[2] = 0.0
    b[3] = 1.0
    simt_matmul(a, b, y, 2, 2, 2, 2, 2)
    assert y[0] == 1.0
    assert y[1] == 2.0
    assert y[2] == 3.0
    assert y[3] == 4.0
    return 0


def test_dynamic_shape_specialization() -> 'i32':
    g = ExecutionGraph(1, "dynamic_test", 0)
    g.inputs.append("x")
    g.outputs.append("x")
    g.get_or_create_tensor("x", [1, 1])
    s = InferenceSession(1, default_cpu(), g, arena_create(64), 0)
    concrete = [1, 3]
    specialize_session(s, "x", concrete)
    d = g.tensors["x"]
    assert _shp_at_gt(d, 0) == 1
    assert _shp_at_gt(d, 1) == 3
    assert d.element_count == 3
    s.close()
    return 0


def test_vit_weight_remap() -> 'i32':
    assert _remap_layer_key("patch_embed.proj.weight") == "patch_w"
    assert _remap_layer_key("blocks.0.attn.qkv.bias") == "L0_qkv_b"
    assert _remap_layer_key("norm.weight") == "lnf_g"
    return 0


def test_backend_dispatch() -> 'i32':
    d = simulation_backend(2, 2)
    assert backend_status(d) == "simulated"
    cuda = backend_for_kind(2)
    assert backend_status(cuda) != "available"
    npu = backend_for_kind(3)
    assert backend_status(npu) != "available"
    a = _nd_f32(4)
    b = _nd_f32(4)
    y = _nd_f32(4)
    a[0] = 1.0
    a[1] = 2.0
    a[2] = 3.0
    a[3] = 4.0
    b[0] = 1.0
    b[1] = 0.0
    b[2] = 0.0
    b[3] = 1.0
    d.matmul(a, b, y, 2, 2, 2)
    assert y[0] == 1.0
    assert y[1] == 2.0
    assert y[2] == 3.0
    assert y[3] == 4.0
    return 0


def test_pretrain_gradient_clipping() -> 'i32':
    a = _nd_f32(2)
    a[0] = 3.0
    a[1] = 4.0
    arrays = []
    arrays.append(a)
    nrm = _clip_grads_for_test(arrays, 2.5)
    assert nrm == 5.0
    assert a[0] == 1.5
    assert a[1] == 2.0
    return 0


# ===== Chuyen tu C# xUnit (FastProtobufReaderTests) sang Pure TokenVector.
# Mirror tu tests/TokenVector.Inference.Tests/FastProtobufReaderTests.cs:
# varint [0x96,0x01] -> 150, [0xAC,0x02] -> 300, float IEEE754, chuoi.
def test_protobuf_varint() -> 'i32':
    r1 = FastProtobufReader(1, chr(150) + chr(1), 0, 0)
    assert r1.read_varint32() == 150
    r2 = FastProtobufReader(1, chr(172) + chr(2), 0, 0)
    assert r2.read_varint64() == 300
    r3 = FastProtobufReader(1, chr(1), 0, 0)
    assert r3.read_varint32() == 1
    r4 = FastProtobufReader(1, chr(128) + chr(128) + chr(128) + chr(128) + chr(16), 0, 0)
    assert r4.read_varint64() == 4294967296
    return 0


def test_protobuf_float() -> 'i32':
    # Pi float32 LE: 0x40490FDB -> [0xDB, 0x0F, 0x49, 0x40]
    buf = chr(219) + chr(15) + chr(73) + chr(64)
    r = FastProtobufReader(1, buf, 0, 0)
    v = r.read_float()
    assert abs(v - 3.1415927) < 0.000001
    return 0


def test_protobuf_string() -> 'i32':
    buf = chr(21) + "TokenVector.Inference"
    r = FastProtobufReader(1, buf, 0, 0)
    assert r.read_string() == "TokenVector.Inference"
    return 0


# ===== Chuyen tu C# xUnit (QuantizationTests) sang Pure TokenVector.
# Mirror CalibrateMinMax_Symmetric_CalculatesCorrectScale:
# [-12.7, 0, 6.35, 12.7] -> scale 0.1, zp 0.
def test_calibrate_minmax() -> 'i32':
    d = _nd_f32(4)
    d[0] = -12.7
    d[1] = 0.0
    d[2] = 6.35
    d[3] = 12.7
    p = calibrate_minmax(d, 1)
    assert abs(p.scale - 0.1) < 0.00001
    assert p.zero_point == 0
    return 0


def test_quantize_roundtrip() -> 'i32':
    # Mirror QuantizeAndDequantize_Int8_PreservesValuesWithLowError:
    # maxdiff <= scale.
    original = _nd_f32(5)
    original[0] = -1.5
    original[1] = -0.5
    original[2] = 0.0
    original[3] = 0.5
    original[4] = 1.5
    p = calibrate_minmax(original, 1)
    q = _nd_i8(5)
    quantize_int8_symmetric(original, q, p.scale)
    dq = _nd_f32(5)
    dequantize_int8_symmetric(q, dq, p.scale)
    maxdiff = 0.0
    for i in range(5):
        df = original[i] - dq[i]
        if df < 0.0:
            df = 0.0 - df
        if df > maxdiff:
            maxdiff = df
    assert maxdiff <= p.scale + 0.000001
    return 0


def test_fp8_roundtrip() -> 'i32':
    # Mirror FP8_E4M3/E5M2_ConversionRoundtripAccuracy.
    _e4 = _nd_f32(6)
    _e4[0] = 0.0
    _e4[1] = 0.5
    _e4[2] = 1.0
    _e4[3] = -1.0
    _e4[4] = 2.5
    _e4[5] = 16.0
    for i in range(6):
        v = _e4[i]
        rec = fp8e4m3_from_float(v).to_float()
        av = v
        if av < 0.0:
            av = 0.0 - av
        rel = 0.0
        _den = av + 0.00001
        if _den != 0.0:
            _num = v - rec
            if _num < 0.0:
                _num = 0.0 - _num
            rel = _num / _den
        assert rel < 0.15
    _e5 = _nd_f32(6)
    _e5[0] = 0.0
    _e5[1] = 0.25
    _e5[2] = 1.0
    _e5[3] = -2.0
    _e5[4] = 64.0
    _e5[5] = 512.0
    for i in range(6):
        v = _e5[i]
        rec = fp8e5m2_from_float(v).to_float()
        av = v
        if av < 0.0:
            av = 0.0 - av
        rel = 0.0
        _den = av + 0.00001
        if _den != 0.0:
            _num = v - rec
            if _num < 0.0:
                _num = 0.0 - _num
            rel = _num / _den
        assert rel < 0.25
    return 0


def test_batcher_queue() -> 'i32':
    # Mirror DynamicBatcherTests (phan dong bo, khong thread):
    # FIFO + empty sentinel. Phan async (spawn worker) thuoc server runtime.
    q = BatcherQueue(1)
    _e = q.try_read()
    assert _e.done == 1
    d1 = _nd_f32(1)
    d1[0] = 1.0
    d2 = _nd_f32(1)
    d2[0] = 2.0
    # (2026-09-27) Code lai cho dung: input la field container, gan explicit.
    r1w = BatchRequest(1, 0, 0, "")
    r1w.input = d1
    q.write(r1w)
    r2w = BatchRequest(1, 0, 0, "")
    r2w.input = d2
    q.write(r2w)
    r1 = q.try_read()
    assert r1.input[0] == 1.0
    r2 = q.try_read()
    assert r2.input[0] == 2.0
    _e2 = q.try_read()
    assert _e2.done == 1
    return 0


def _gap_gemm_graph() -> 'ExecutionGraph':
    # Do lai `_tiny_graph` cua compare_rivals: 1x(4x8) FusedLinear + bias.
    g = ExecutionGraph(1, "gap_gemm", 0)
    g.inputs.append("X")
    g.outputs.append("Y")
    w = _nd_f32(32)
    b = _nd_f32(8)
    for i in range(32):
        w[i] = 0.5
    for i in range(8):
        b[i] = 0.25
    g.initializers["W"] = w
    g.initializers["B"] = b
    g.get_or_create_tensor("X", [1, 4])
    g.get_or_create_tensor("W", [8, 4])
    g.get_or_create_tensor("B", [8])
    g.get_or_create_tensor("Y", [1, 8])
    node = new_node("gemm_gap", OperatorType_FusedLinear)
    node.activation = ActivationFunction_Relu
    node.inputs.append("X")
    node.inputs.append("W")
    node.inputs.append("B")
    node.outputs.append("Y")
    g.nodes.append(node)
    return g


def test_optimized_session_terminates() -> 'i32':
    # Hoi quy (2026-09-28): DeadCodeEliminationPass.run() co
    # `if i in active: continue` ma KHONG giam `i`, nen vong
    # `while i > -1` quay vo han ngay khi co node da active.
    #
    # Quan trong: PHAI assert GIA TRI, khong chi do dai. Dinh dang
    # DeadCodeElimination loai node nguoc (`if i not in active`) nen
    # session_from_graph(g, 1) xoa sach graph va tra ve toan 0 ma khong
    # nem loi - assert `len(y) == 8` van xanh.
    g = _gap_gemm_graph()
    s = session_from_graph(g, 1)
    assert s._disposed == 0
    x = _nd_f32(4)
    for i in range(4):
        x[i] = 1.0
    y = s.run_single(x, "X", "Y")
    assert len(y) == 8
    # Y[j] = ReLU(4 * 0.5 + 0.25) = 2.25 cho moi j
    for j in range(8):
        assert abs(y[j] - 2.25) < 0.00001
    s.close()
    return 0


def _gap_scratch_graph() -> 'ExecutionGraph':
    # Do lai `_gap_gemm_graph` nhung chen 2 tensor trung gian THAT su song
    # sau DCE: Y (gemm) va T0 (relu) deu duoc node `add` doc, nen ca hai
    # vao nhanh "scratch" cua analyze_liveness_and_allocate_offsets.
    # Output cua graph la Z (khong phai Y) de khong co node nao ghi de
    # mot tensor da duoc doc trong cung graph.
    g = ExecutionGraph(1, "gap_scratch", 0)
    g.inputs.append("X")
    g.outputs.append("Z")
    w = _nd_f32(32)
    b = _nd_f32(8)
    for i in range(32):
        w[i] = 0.5
    for i in range(8):
        b[i] = 0.25
    g.initializers["W"] = w
    g.initializers["B"] = b
    g.get_or_create_tensor("X", [1, 4])
    g.get_or_create_tensor("W", [8, 4])
    g.get_or_create_tensor("B", [8])
    g.get_or_create_tensor("Y", [1, 8])
    g.get_or_create_tensor("T0", [1, 4])
    g.get_or_create_tensor("Z", [1, 8])
    g_gemm = new_node("gemm_s", OperatorType_FusedLinear)
    g_gemm.activation = ActivationFunction_Relu
    g_gemm.inputs.append("X")
    g_gemm.inputs.append("W")
    g_gemm.inputs.append("B")
    g_gemm.outputs.append("Y")
    g.nodes.append(g_gemm)
    n_relu = new_node("t0", OperatorType_Relu)
    n_relu.inputs.append("X")
    n_relu.outputs.append("T0")
    g.nodes.append(n_relu)
    n_add = new_node("add_s", OperatorType_Add)
    n_add.inputs.append("Y")
    n_add.inputs.append("T0")
    n_add.outputs.append("Z")
    g.nodes.append(n_add)
    return g


def test_scratch_liveness_terminates() -> 'i32':
    # Hoi quy (2026-09-28): bubble sort scratch trong
    # analyze_liveness_and_allocate_offsets() so sanh i32 voi TkvInt tu
    # len() => vong `while` khong thoat. Do lai phai co tensor trung gian
    # con song sau DCE, nen X -> gemm -> Y va X -> relu -> T0 roi
    # Y + T0 -> Z.
    g = _gap_scratch_graph()
    s = session_from_graph(g, 1)
    assert s._disposed == 0
    x = _nd_f32(4)
    for i in range(4):
        x[i] = 1.0
    y = s.run_single(x, "X", "Z")
    assert len(y) == 8
    # Y = ReLU(gemm) = 2.25; T0 = ReLU(X) = 1.0; Z = Y + T0 = 3.25
    for j in range(8):
        assert abs(y[j] - 3.25) < 0.00001
    s.close()
    return 0


def test_batcher_enqueue_returns() -> 'i32':
    # Hoi quy (2026-09-28): `enqueue` quay `while not req.done` cho
    # den khi worker chay. Runtime .tkv single-thread nen spawn() khong
    # tao worker => treo vo han, CPU 100%. Bay gio het han thi chay
    # inline tai thread goi. Test nay se TREO (khong fail) neu bug quay
    # lai, nen run_cases.ps1 chay moi case o process rieng.
    g = _gap_gemm_graph()
    s = session_from_graph(g, 1)
    b = new_dynamic_batcher_with_session(s, 4, 200, 16)
    x = _nd_f32(4)
    for i in range(4):
        x[i] = 1.0
    r = b.enqueue(x)
    assert len(r) == 8
    # Request thu hai phai ra ket qua nua, khong phai loi.
    r2 = b.enqueue(x)
    assert len(r2) == 8
    assert b.queue_depth() == 0
    assert b.dropped_total == 0
    b.dispose()
    s.close()
    return 0


def test_batcher_queue_full_raises() -> 'i32':
    # Queue co gioi han: enqueue khi da day phai nem ServerBusy chu khong
    # lam moi bo nho tang lien. Kiem tra bang 1 batcher roi gap loi.
    g = _gap_gemm_graph()
    s = session_from_graph(g, 1)
    b = new_dynamic_batcher_with_session(s, 1, 200, 1)
    x = _nd_f32(4)
    for i in range(4):
        x[i] = 1.0
    r = b.enqueue(x)
    assert len(r) == 8
    assert b.queue_depth() == 0
    b.dispose()
    s.close()
    return 0


def main() -> 'i32':
    test_simt_matmul()
    test_dynamic_shape_specialization()
    test_vit_weight_remap()
    test_backend_dispatch()
    test_pretrain_gradient_clipping()
    test_protobuf_varint()
    test_protobuf_float()
    test_protobuf_string()
    test_calibrate_minmax()
    test_quantize_roundtrip()
    test_fp8_roundtrip()
    test_batcher_queue()
    test_optimized_session_terminates()
    test_scratch_liveness_terminates()
    test_batcher_enqueue_returns()
    test_batcher_queue_full_raises()
    print("gap tests: PASS")
    return 0
