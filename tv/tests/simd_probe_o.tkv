# PROBE O — gpt2_linear_bwd: dx/dw/db rieng le
import tv.training.tensor
import tv.training.gpt2_ref
import tv.training.simd_matmul

def fill(m: 'i64', n: 'i64', kind: 'i64') -> "Tensor":
    out = t_zeros([m, n])
    d = out.data
    for i in range(m * n):
        if kind == 5:
            d[i] = (float((i * 7 + 13) % 97) - 48.0) / 48.0
        if kind == 6:
            d[i] = (float((i * 13 + 7) % 59) - 29.0) / 29.0
    return out

def md(a: "Tensor", b: "Tensor") -> 'f32':
    da = a.data
    db = b.data
    m = 0.0
    for i in range(len(da)):
        dd = da[i] - db[i]
        if dd < 0.0:
            dd = 0.0 - dd
        if dd > m:
            m = dd
    return m

def main() -> 'i32':
    ps = gpt2_init(7)
    w = ps[6]
    x = fill(32, 64, 5)
    gy = fill(32, 192, 6)
    r0 = gpt2_linear_bwd(x, w, gy, 32, 64, 192)
    r1 = gpt2_linear_bwd(x, w, gy, 32, 64, 192, 1)
    d0 = r0[0]
    d1 = r1[0]
    w0 = r0[1]
    w1 = r1[1]
    b0 = r0[2]
    b1 = r1[2]
    print("O1 dx diff=" + str(md(d0, d1)))
    print("O2 dw diff=" + str(md(w0, w1)))
    print("O3 db diff=" + str(md(b0, b1)))
    return 0
