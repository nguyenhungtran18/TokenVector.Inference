# PROBE BY — P6 GĐ8 (2026-10-22): CHI PHI TILE-BUILD + ACCUMULATE trong _smm_core
#
# VI SAO PROBE NAY: do P6 GĐ5, ATTN_BWD @1024 = 11.3 s (942 ms/layer), trong do
# 12 worker (1 head/worker) wall 516 ms. GEMM native chi ~10 ms/head
# (6 GEMM x 67 MMAC @ 83 GFLOP/s) => ~95% thoi gian la INTERPRETER:
#   - dong tile (build) : 12M ptu/head
#   - cong don (accum)  : 6M ptu/head
# Do la nguon: moi ptu qua vong lap .tkv ~ 20-30 ns; 18M ptu => ~500 ms.
#
# DO 4 PHEP:
#   [0] A-tile (doc theo hang, lien tuc): ban W (ep kieu `(-0.0)/1.0` + 2 nhanh)
#       vs ban P (index chay, khong ep kieu) -> ns/ptu + BIT-EQUAL?
#   [1] B-tile trans_b=1 (doc STRIDED): W vs P -> ns/ptu + BIT-EQUAL?
#   [2] accumulate: `cd = cd + Ct` vs `cd = Ct` (p-tile dau) -> ns/ptu + EQUAL?
#   [3] GEMM full: core TOI UU (build P + thu tu vong chon theo n_i/n_j + bo
#       cong don p-tile dau + accumulate lien khi n==T) vs smm_dot/smm_fwd
#       hien tai -> MAXDIFF phai = 0.0 + thoi gian (3 shape: 2 head + 1 main).
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_by.tkv out/by.exe main
#   ./out/by.exe
#
# LUU Y: moi phep so sanh deu INLINE trong main (khong dua list qua bien
# tham) — bug compiler da bi phat hien: truyen list qua bien tham co the lam
# SAI GIA TRI (im lang). Kiem tra list[f32] -> list[f32] thi OK.

import tv.training.tensor
import tv.training.simd_matmul


# ---- helpers (ban sao simd_matmul) ---------------------------------------
def _by_imin(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return a
    return b


def _by_roundup64(x: 'i64') -> 'i64':
    r = 64
    while r < x:
        r = r + 64
    return r


def _by_tilek(k: 'i64') -> 'i64':
    r = _by_roundup64(k)
    if r > 1024:
        r = 1024
    return r


def _by_ceil(x: 'i64', T: 'i64') -> 'i64':
    q = 0
    r = 0
    while r < x:
        r = r + T
        q = q + 1
    return q


def _by_zeros(n: 'i64') -> 'list[f32]':
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    return out


# ---- W: ban build HIEN TAI (verbatim tu simd_matmul) ---------------------
def _by_tile_a_w(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
                 ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < ib:
                if j < pw:
                    out[i * T + j] = (d[(i0 + i) * kdim + (p0 + j)] - 0.0) / 1.0
                else:
                    out[i * T + j] = z
            else:
                out[i * T + j] = z
            j = j + 1
        i = i + 1
    return 0


def _by_tile_b_w(out: "list[f32]", d: "list[f32]", ndim: 'i64', p0: 'i64',
                 pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'i64':
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < pw:
                if j < br:
                    if trans_b == 1:
                        out[i * T + j] = (d[(r0 + j) * ndim + (p0 + i)] - 0.0) / 1.0
                    else:
                        out[i * T + j] = (d[(p0 + i) * ndim + (r0 + j)] - 0.0) / 1.0
                else:
                    out[i * T + j] = z
            else:
                out[i * T + j] = z
            j = j + 1
        i = i + 1
    return 0


# ---- P: ban build TOI UU (index chay, khong ep kieu) ---------------------
def _by_tile_a_p(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
                 ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    if ib == T and pw == T:
        i = 0
        dst = 0
        while i < T:
            src = (i0 + i) * kdim + p0
            j = 0
            while j < T:
                out[dst] = d[src + j]
                dst = dst + 1
                j = j + 1
            i = i + 1
        return 0
    z = 0.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < ib:
                if j < pw:
                    out[i * T + j] = d[(i0 + i) * kdim + (p0 + j)]
                else:
                    out[i * T + j] = z
            else:
                out[i * T + j] = z
            j = j + 1
        i = i + 1
    return 0


def _by_tile_b_p(out: "list[f32]", d: "list[f32]", ndim: 'i64', p0: 'i64',
                 pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'i64':
    if pw == T and br == T:
        i = 0
        dst = 0
        while i < T:
            if trans_b == 1:
                idx = r0 * ndim + (p0 + i)
                j = 0
                while j < T:
                    out[dst] = d[idx]
                    dst = dst + 1
                    idx = idx + ndim
                    j = j + 1
            else:
                src = (p0 + i) * ndim + r0
                j = 0
                while j < T:
                    out[dst] = d[src + j]
                    dst = dst + 1
                    j = j + 1
            i = i + 1
        return 0
    z = 0.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < pw:
                if j < br:
                    if trans_b == 1:
                        out[i * T + j] = d[(r0 + j) * ndim + (p0 + i)]
                    else:
                        out[i * T + j] = d[(p0 + i) * ndim + (r0 + j)]
                else:
                    out[i * T + j] = z
            else:
                out[i * T + j] = z
            j = j + 1
        i = i + 1
    return 0


# ---- accumulate: ban hien tai vs ban toi uu ------------------------------
def _by_acc_w(cd: "list[f32]", Ct: "list[f32]", n: 'i64', i0: 'i64',
              ib: 'i64', j0: 'i64', jb: 'i64', T: 'i64') -> 'i64':
    r = 0
    while r < ib:
        bc = (i0 + r) * n + j0
        bt = r * T
        c = 0
        while c < jb:
            cd[bc + c] = cd[bc + c] + Ct[bt + c]
            c = c + 1
        r = r + 1
    return 0


def _by_acc_p(cd: "list[f32]", Ct: "list[f32]", n: 'i64', i0: 'i64',
              ib: 'i64', j0: 'i64', jb: 'i64', T: 'i64', first: 'i32') -> 'i64':
    if jb == n and ib == T:
        # khoi C lien tuc (n == T) -> copy phang
        base = i0 * n
        c = 0
        if first == 1:
            while c < T * T:
                cd[base + c] = Ct[c]
                c = c + 1
            return 0
        while c < T * T:
            cd[base + c] = cd[base + c] + Ct[c]
            c = c + 1
        return 0
    r = 0
    while r < ib:
        bc = (i0 + r) * n + j0
        bt = r * T
        c = 0
        if first == 1:
            while c < jb:
                cd[bc + c] = Ct[bt + c]
                c = c + 1
        else:
            while c < jb:
                cd[bc + c] = cd[bc + c] + Ct[bt + c]
                c = c + 1
        r = r + 1
    return 0


# ---- core TOI UU --------------------------------------------------------
def _by_core(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
             ndim: 'i64', trans_b: 'i32') -> "Tensor":
    T = _by_imin(_by_tilek(k), _by_roundup64(_by_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Ct = _by_zeros(T * T)
    AtB = _by_zeros(T * T)
    BtB = _by_zeros(T * T)
    n_i = _by_ceil(m, T)
    n_j = _by_ceil(n, T)
    if n_j < n_i:
        # vong p0 -> j0 -> i0: B tile build 1 lan cho moi (p0,j0)
        p0 = 0
        while p0 < k:
            pw = _by_imin(T, k - p0)
            j0 = 0
            while j0 < n:
                jb = _by_imin(T, n - j0)
                rv = _by_tile_b_p(BtB, b.data, ndim, p0, pw, j0, jb, T, trans_b)
                i0 = 0
                while i0 < m:
                    ib = _by_imin(T, m - i0)
                    rv2 = _by_tile_a_p(AtB, a.data, k, i0, ib, p0, pw, T)
                    simd_gemm(AtB, BtB, Ct, T)
                    first = 0
                    if p0 == 0:
                        first = 1
                    rv3 = _by_acc_p(cd, Ct, n, i0, ib, j0, jb, T, first)
                    i0 = i0 + ib
                j0 = j0 + jb
            p0 = p0 + pw
        return C
    # vong i0 -> p0 -> j0: A tile build 1 lan cho moi (i0,p0)
    i0 = 0
    while i0 < m:
        ib = _by_imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _by_imin(T, k - p0)
            rv = _by_tile_a_p(AtB, a.data, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _by_imin(T, n - j0)
                rv2 = _by_tile_b_p(BtB, b.data, ndim, p0, pw, j0, jb, T, trans_b)
                simd_gemm(AtB, BtB, Ct, T)
                first = 0
                if p0 == 0:
                    first = 1
                rv3 = _by_acc_p(cd, Ct, n, i0, ib, j0, jb, T, first)
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return C


def main() -> 'i32':
    # ================= data =================
    # A [1024, 64] — gia tri "khong dyadic" de bat loi lam tron
    A = t_zeros([1024, 64])
    ad = A.data
    i = 0
    while i < 1024:
        j = 0
        while j < 64:
            x = (i * 64 + j) * 2654435761
            x = x % 1000000007
            ad[i * 64 + j] = float(x) / 30000000.0 - 0.5
            j = j + 1
        i = i + 1
    # K [1024, 64] (cho trans_b=1)
    K = t_zeros([1024, 64])
    kd = K.data
    i = 0
    while i < 1024:
        j = 0
        while j < 64:
            x = (i * 64 + j) * 40503
            x = x % 999999937
            kd[i * 64 + j] = float(x) / 30000000.0 - 0.5
            j = j + 1
        i = i + 1
    # P [1024, 1024]
    P = t_zeros([1024, 1024])
    pd = P.data
    i = 0
    while i < 1024:
        j = 0
        while j < 1024:
            x = (i * 1024 + j) * 97
            x = x % 1000003
            pd[i * 1024 + j] = float(x) / 3000000.0 - 0.5
            j = j + 1
        i = i + 1
    # X [1024, 768], W [768, 2304] (shape main-thread)
    X = t_zeros([1024, 768])
    xd = X.data
    i = 0
    while i < 1024:
        j = 0
        while j < 768:
            xd[i * 768 + j] = float((i * 768 + j) % 7919) / 30000.0 - 0.5
            j = j + 1
        i = i + 1
    W = t_zeros([768, 2304])
    wd = W.data
    i = 0
    while i < 768:
        j = 0
        while j < 2304:
            wd[i * 2304 + j] = float((i * 2304 + j) % 6271) / 30000.0 - 0.5
            j = j + 1
        i = i + 1

    T = 64
    bufW = _by_zeros(T * T)
    bufP = _by_zeros(T * T)

    # ================= BY[0] A-tile =================
    R = 256
    t0 = now_us()
    r = 0
    while r < R:
        rv = _by_tile_a_w(bufW, ad, 64, 0, T, 0, T, T)
        r = r + 1
    tW = now_us() - t0
    t0 = now_us()
    r = 0
    while r < R:
        rv = _by_tile_a_p(bufP, ad, 64, 0, T, 0, T, T)
        r = r + 1
    tP = now_us() - t0
    # so sanh BIT (dung trong main, khong dua list qua ham)
    bad = 0
    r = 0
    while r < T * T:
        if bufW[r] != bufP[r]:
            bad = bad + 1
        r = r + 1
    npt = R * T * T
    print("BY[0] A-tile  W=" + str(tW / 1000.0) + "ms  P=" + str(tP / 1000.0) + "ms  x" + str(tW / float(tP)) + "  ns/ptu W=" + str(tW * 1000.0 / float(npt)) + " P=" + str(tP * 1000.0 / float(npt)) + "  sai=" + str(bad))

    # ================= BY[1] B-tile trans_b=1 =================
    t0 = now_us()
    r = 0
    while r < R:
        rv = _by_tile_b_w(bufW, kd, 64, 0, T, 0, T, T, 1)
        r = r + 1
    tW = now_us() - t0
    t0 = now_us()
    r = 0
    while r < R:
        rv = _by_tile_b_p(bufP, kd, 64, 0, T, 0, T, T, 1)
        r = r + 1
    tP = now_us() - t0
    bad = 0
    r = 0
    while r < T * T:
        if bufW[r] != bufP[r]:
            bad = bad + 1
        r = r + 1
    print("BY[1] B-tile(t1) W=" + str(tW / 1000.0) + "ms  P=" + str(tP / 1000.0) + "ms  x" + str(tW / float(tP)) + "  ns/ptu W=" + str(tW * 1000.0 / float(npt)) + " P=" + str(tP * 1000.0 / float(npt)) + "  sai=" + str(bad))

    # ================= BY[2] accumulate =================
    Cw = t_zeros([1024, 1024])
    cwd = Cw.data
    Cp = t_zeros([1024, 1024])
    cpd = Cp.data
    Ct = _by_zeros(T * T)
    ri = 0
    while ri < T * T:
        Ct[ri] = float(ri % 1000) / 1000.0 - 0.5
        ri = ri + 1
    t0 = now_us()
    r = 0
    while r < R:
        rv = _by_acc_w(cwd, Ct, 1024, 0, T, 0, T, T)
        r = r + 1
    tW = now_us() - t0
    t0 = now_us()
    r = 0
    while r < R:
        rv = _by_acc_p(cpd, Ct, 1024, 0, T, 0, T, T, 0)
        r = r + 1
    tP = now_us() - t0
    bad = 0
    r = 0
    while r < T * T:
        if cwd[r] != cpd[r]:
            bad = bad + 1
        r = r + 1
    print("BY[2] accum    W=" + str(tW / 1000.0) + "ms  P=" + str(tP / 1000.0) + "ms  x" + str(tW / float(tP)) + "  ns/ptu W=" + str(tW * 1000.0 / float(npt)) + " P=" + str(tP * 1000.0 / float(npt)) + "  sai=" + str(bad))

    # ================= BY[3] GEMM full =================
    # shape 1: smm_dot(A[1024,64], K[1024,64], 1024, 1024, 64)  (head: Smat)
    t0 = now_us()
    c1 = smm_dot(A, K, 1024, 1024, 64)
    t1 = now_us() - t0
    t0 = now_us()
    c2 = _by_core(A, K, 1024, 1024, 64, 64, 1)
    t2 = now_us() - t0
    md = 0.0
    c1d = c1.data
    c2d = c2.data
    r = 0
    while r < 1024 * 1024:
        d = c1d[r] - c2d[r]
        if d < 0.0:
            d = 0.0 - d
        if d > md:
            md = d
        r = r + 1
    print("BY[3a] smm_dot 1024x1024x64  cur=" + str(t1 / 1000.0) + "ms  new=" + str(t2 / 1000.0) + "ms  x" + str(t1 / float(t2)) + "  maxdiff=" + str(md))

    # shape 2: smm_fwd(P[1024,1024], K[1024,64], 1024, 64, 1024) (head: gCtx)
    t0 = now_us()
    c3 = smm_fwd(P, K, 1024, 64, 1024)
    t1 = now_us() - t0
    t0 = now_us()
    c4 = _by_core(P, K, 1024, 64, 1024, 64, 0)
    t2 = now_us() - t0
    md = 0.0
    c3d = c3.data
    c4d = c4.data
    r = 0
    while r < 1024 * 64:
        d = c3d[r] - c4d[r]
        if d < 0.0:
            d = 0.0 - d
        if d > md:
            md = d
        r = r + 1
    print("BY[3b] smm_fwd 1024x64x1024   cur=" + str(t1 / 1000.0) + "ms  new=" + str(t2 / 1000.0) + "ms  x" + str(t1 / float(t2)) + "  maxdiff=" + str(md))

    # shape 3: smm_fwd(X[1024,768], W[768,2304], 1024, 2304, 768) (main-thread qkv)
    t0 = now_us()
    c5 = smm_fwd(X, W, 1024, 2304, 768)
    t1 = now_us() - t0
    t0 = now_us()
    c6 = _by_core(X, W, 1024, 2304, 768, 2304, 0)
    t2 = now_us() - t0
    md = 0.0
    c5d = c5.data
    c6d = c6.data
    r = 0
    while r < 1024 * 2304:
        d = c5d[r] - c6d[r]
        if d < 0.0:
            d = 0.0 - d
        if d > md:
            md = d
        r = r + 1
    print("BY[3c] smm_fwd 1024x2304x768 cur=" + str(t1 / 1000.0) + "ms  new=" + str(t2 / 1000.0) + "ms  x" + str(t1 / float(t2)) + "  maxdiff=" + str(md))

    print("BY done")
    return 0
