# PROBE _cj4 — tach nguon list f64: literal list[f64] (test compiler) vs t_zeros data
# Neu (1) PASS va (2) FAIL -> loi o provenance list (coerce/annotation), khong o native.
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj4.tkv out/cj4.exe main
import tv.training.tensor
import tv.training.simd_matmul

def _f64view(d: "list[f32]") -> "list[f64]":
    return d

def _ref(a: "list[f64]", b: "list[f64]", c: "list[f64]", n: 'i64') -> 'i64':
    i = 0
    while i < n:
        j = 0
        while j < n:
            s = 0.0
            p = 0
            while p < n:
                s = s + a[i * n + p] * b[p * n + j]
                p = p + 1
            c[i * n + j] = s
            j = j + 1
        i = i + 1
    return 0

def _maxdiff(a: "list[f64]", b: "list[f64]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def _ng(a: "list[f64]", cnt: 'i64') -> 'i64':
    g = 0
    i = 0
    while i < cnt:
        if a[i] > 1.0e18 or a[i] < -1.0e18:
            g = g + 1
        i = i + 1
    return g

def main() -> 'i32':
    n: "i64" = 32
    m = n * n

    # ---- (1) literal list[f64] — y heth test packed_f64 cua compiler ----
    a1: "list[f64]" = []
    b1: "list[f64]" = []
    c1: "list[f64]" = []
    i = 0
    while i < m:
        a1.append(float(i % 7))
        b1.append(float(i % 5))
        c1.append(0.0)
        i = i + 1
    h1a = simd_gemm_packed_create(a1, n, n, n, n, 0)
    h1b = simd_gemm_packed_create(b1, n, n, n, n, 0)
    st1 = simd_gemm_packed(h1a, h1b, c1, n)
    fa = simd_gemm_packed_free(h1a)
    fb = simd_gemm_packed_free(h1b)
    cref: "list[f64]" = []
    i = 0
    while i < m:
        cref.append(0.0)
        i = i + 1
    _ref(a1, b1, cref, n)
    print("J4(1) literal-f64 st=" + str(st1) + " maxdiff=" + str(_maxdiff(c1, cref, m))
          + " ngarbage=" + str(_ng(c1, m)) + " c1[0]=" + str(c1[0]) + " ref[0]=" + str(cref[0]))

    # ---- (2) t_zeros data + _f64view — dung trong _cj3 ----
    A2 = t_zeros([n, n])
    B2 = t_zeros([n, n])
    i = 0
    while i < m:
        A2.data[i] = float(i % 7)
        B2.data[i] = float(i % 5)
        i = i + 1
    C2 = t_zeros([n, n])
    print("J4(2-pre) A2.data[0..3]=" + str(A2.data[0]) + "," + str(A2.data[1]) + ","
          + str(A2.data[2]) + "," + str(A2.data[3])
          + " B2.data[0..3]=" + str(B2.data[0]) + "," + str(B2.data[1]) + ","
          + str(B2.data[2]) + "," + str(B2.data[3]))
    va = _f64view(A2.data)
    vb = _f64view(B2.data)
    print("J4(2-view) va[0..3]=" + str(va[0]) + "," + str(va[1]) + "," + str(va[2]) + ","
          + str(va[3]) + " vb[0..3]=" + str(vb[0]) + "," + str(vb[1]) + "," + str(vb[2]) + "," + str(vb[3]))
    vc = _f64view(C2.data)
    h2a = simd_gemm_packed_create(va, n, n, n, n, 0)
    h2b = simd_gemm_packed_create(vb, n, n, n, n, 0)
    st2 = simd_gemm_packed(h2a, h2b, vc, n)
    fc = simd_gemm_packed_free(h2a)
    fd = simd_gemm_packed_free(h2b)
    print("J4(2) t_zeros+view st=" + str(st2) + " maxdiff=" + str(_maxdiff(C2.data, cref, m))
          + " ngarbage=" + str(_ng(C2.data, m)) + " c2[0]=" + str(C2.data[0]))

    # ---- (3) literal list[f64] cho a/b, target t_zeros+view ----
    C3 = t_zeros([n, n])
    vc3 = _f64view(C3.data)
    h3a = simd_gemm_packed_create(a1, n, n, n, n, 0)
    h3b = simd_gemm_packed_create(b1, n, n, n, n, 0)
    st3 = simd_gemm_packed(h3a, h3b, vc3, n)
    fe = simd_gemm_packed_free(h3a)
    ff = simd_gemm_packed_free(h3b)
    print("J4(3) lit-src t_zeros-C st=" + str(st3) + " maxdiff=" + str(_maxdiff(C3.data, cref, m))
          + " ngarbage=" + str(_ng(C3.data, m)) + " c3[0]=" + str(C3.data[0]))

    # ---- (4) f32 path truc tiep tren t_zeros data (khong view) — exception loai runtime type ----
    print("J4(4) goi f32-path tren t_zeros data...")
    d4 = A2.data
    st4 = simd_gemm_packed_create(d4, n, n, n, n, 0)
    print("J4(4) st4=" + str(st4) + " (neu khong nem -> runtime la List[Single])")
    print("J4 done")
    return 0
