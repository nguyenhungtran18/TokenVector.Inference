# PROBE _oob — ghi lai HOP DONG exception hien tai cua 'lst[i]' vuot vung.
# Dung de chot cau hoi §4.1 (kieu + message + thoi diem) truoc khi hoist bounds-check.
# Chay:
#   /d/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_oob_probe.tkv out/_oob.exe main
#   ./out/_oob.exe
#
# NOTE (BUG compiler, 2026-10-27): file NAY ban dau co
#   __tkv_import__ = ["tkv_test_lib"]
# nhung tkv_test_lib.tkv chi ton tai o Release/tests/ — thu muc nay khong tim
# duoc no -> tkvc-tv.exe SEGFAULT (exit 139, 0xc0000005) va bat cua so
# 'System Error: Exception Processing Message 0xc00000005 - Unexpected
# parameters', KHONG in ra thong diep loi nao. Repro toi gian:
#   file co dong import  -> exit 139, khong exe
#   file khong dong do   -> '[tkvc] da dich', exit 0
# Bo dong import di (probe nay khong dung check()) la chay duoc.


def main() -> "i32":
    total = 0
    n: "i32" = 8
    a: "list[f32]" = []
    i = 0
    while i < n:
        a.append(1.5)
        i = i + 1

    # [1] doc vuot vung (i == len)
    s1: "str" = "no-throw"
    try:
        x = a[n]
        s1 = "no-throw val=" + str(x)
    except Exception as e:
        s1 = str(e)
    print("OOB[1] read  i==len  -> '" + s1 + "'")

    # [2] ghi vuot vung (i == len)
    s2: "str" = "no-throw"
    try:
        a[n] = 3.0
        s2 = "no-throw"
    except Exception as e:
        s2 = str(e)
    print("OOB[2] write i==len  -> '" + s2 + "'")

    # [3] chi so AM dong ('a[-1]' bang bien, khong phai hang so)
    neg: "i32" = -1
    s3: "str" = "no-throw"
    try:
        y = a[neg]
        s3 = "no-throw val=" + str(y)
    except Exception as e:
        s3 = str(e)
    print("OOB[3] read  i=-1    -> '" + s3 + "'")

    # [4] i64 vuot int32 — conv.ovf.i4 co nang khong?
    big: "i64" = 5000000000
    s4: "str" = "no-throw"
    try:
        z = a[big]
        s4 = "no-throw val=" + str(z)
    except Exception as e:
        s4 = str(e)
    print("OOB[4] read  i=5e9   -> '" + s4 + "'")

    # [5] vong se khong chay (n=0) nhung index van vuot -> hien tai KHONG nem
    b: "list[f32]" = []
    s5: "str" = "no-throw"
    lim: "i32" = 0
    k = 0
    while k < lim:
        s5 = str(b[k])
        k = k + 1
    print("OOB[5] vong khong chay (len=0, lim=0) -> '" + s5 + "'")

    # [6] vong chay nhung index vuot giua vong
    c: "list[f32]" = []
    c.append(1.0)
    s6: "str" = "no-throw"
    kk = 0
    while kk < 5:
        try:
            s6 = str(c[kk])
        except Exception as e:
            s6 = "threw at kk=" + str(kk) + ": " + str(e)
            kk = 99
        kk = kk + 1
    print("OOB[6] vong chay qua len (len=1, lim=5) -> '" + s6 + "'")

    print("_oob done")
    return 0