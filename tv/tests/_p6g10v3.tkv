# PROBE P6G10V3 — dump raw bytes of torch_attention_bwd outputs
import tv.training.tensor

def main() -> 'i32':
    n = 2
    h = 64
    nhd = 1
    hd = 64
    xt = t_zeros([n, h])
    xd = xt.data
    i = 0
    while i < n * h:
        xd[i] = float(i % 17) * 0.02 - 0.16
        i = i + 1
    gout = t_zeros([n, h])
    gd = gout.data
    i = 0
    while i < n * h:
        gd[i] = float((i * 3 + 5) % 23) * 0.01 - 0.11
        i = i + 1
    w_qkv = t_zeros([h, 3 * h])
    wqd = w_qkv.data
    i = 0
    while i < h * 3 * h:
        wqd[i] = float((i * 7 + 11) % 29) * 0.005 - 0.07
        i = i + 1
    b_qkv = t_zeros([3 * h])
    bqd = b_qkv.data
    i = 0
    while i < 3 * h:
        bqd[i] = float(i % 13) * 0.01 - 0.06
        i = i + 1
    w_proj = t_zeros([h, h])
    wpd = w_proj.data
    i = 0
    while i < h * h:
        wpd[i] = float((i * 5 + 3) % 31) * 0.004 - 0.06
        i = i + 1
    b_proj = t_zeros([h])
    bpd = b_proj.data
    i = 0
    while i < h:
        bpd[i] = float(i % 11) * 0.01 - 0.05
        i = i + 1
    dx = t_zeros([n, h])
    gflat = t_zeros([h * 3 * h + 3 * h + h * h + h])
    _dxd = dx.data
    _gfl = gflat.data
    o_qkv = 0
    o_bqkv = h * 3 * h
    o_proj = o_bqkv + 3 * h
    o_bproj = o_proj + h * h
    rc = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, _dxd, _gfl, n, h, nhd, hd, o_qkv, o_bqkv, o_proj, o_bproj)
    print("attn_bwd rc=" + str(rc))

    p = alloc_bytes(4)
    i = 0
    while i < n * h:
        write_f32(p, 0, _dxd[i])
        print("DX " + str(i) + " " + hex(read_i32(p, 0) & 255) + " " + hex((read_i32(p, 0) >> 8) & 255) + " " + hex((read_i32(p, 0) >> 16) & 255) + " " + hex((read_i32(p, 0) >> 24) & 255))
        i = i + 1
    i = 0
    while i < h * 3 * h:
        write_f32(p, 0, _gfl[i])
        print("DQW " + str(i) + " " + hex(read_i32(p, 0) & 255) + " " + hex((read_i32(p, 0) >> 8) & 255) + " " + hex((read_i32(p, 0) >> 16) & 255) + " " + hex((read_i32(p, 0) >> 24) & 255))
        i = i + 1
    i = 0
    while i < 3 * h:
        write_f32(p, 0, _gfl[o_bqkv + i])
        print("DQB " + str(i) + " " + hex(read_i32(p, 0) & 255) + " " + hex((read_i32(p, 0) >> 8) & 255) + " " + hex((read_i32(p, 0) >> 16) & 255) + " " + hex((read_i32(p, 0) >> 24) & 255))
        i = i + 1
    i = 0
    while i < h * h:
        write_f32(p, 0, _gfl[o_proj + i])
        print("DPW " + str(i) + " " + hex(read_i32(p, 0) & 255) + " " + hex((read_i32(p, 0) >> 8) & 255) + " " + hex((read_i32(p, 0) >> 16) & 255) + " " + hex((read_i32(p, 0) >> 24) & 255))
        i = i + 1
    i = 0
    while i < h:
        write_f32(p, 0, _gfl[o_bproj + i])
        print("DPB " + str(i) + " " + hex(read_i32(p, 0) & 255) + " " + hex((read_i32(p, 0) >> 8) & 255) + " " + hex((read_i32(p, 0) >> 16) & 255) + " " + hex((read_i32(p, 0) >> 24) & 255))
        i = i + 1
    return 0
