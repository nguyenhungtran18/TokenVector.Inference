# PROBE NT3 — bit pattern f32 cua v .tkv
# Chay: D:\TokenVector\Release\dist\tkvc-tv.exe tv/tests/_nt3.tkv out/nt3.exe main
#       dotnet out/nt3_n10.dll > out/nt3_tkv.txt
import tv.training.tensor

def main() -> 'i32':
    tv = t_zeros([1001])
    k = 0
    while k < 1001:
        tv.data[k] = float(k) * 0.04 - 20.0
        k = k + 1
    p = alloc_bytes(4)
    k = 0
    while k < 1001:
        write_f32(p, 0, tv.data[k])
        print("NT3 vbits=" + hex(read_i32(p, 0)))
        k = k + 1
    free_bytes(p)
    return 0
