# PROBE BH — P6 GĐ3 PROTOTYPE: SONG SONG BUILD TILE (worker xay, main gemm)
#
# Y TUONG (theo so do AQ 2026-10-21 @1024: MLP_BWD 16.5s, LHEAD 11.8s —
# chua ai dot): _smm_core/_p58_core_simple chi can ~2ms/gemm native (T=768,
# MT) NHUNG BUILD TILE interpreted (append/indexed write T^2 = 589824 ptu)
# moi goi ~0.1-1.5s -> chip phi thuc nam o build. P6 GĐ3: WORKER build tile
# RIENG (indexed write vao buffer main pre-alloc, KHONG append, KHONG goi
# simd_gemm), MAIN replay gemm + accumulate theo DUNG thu tu i0->p0->j0.
# Cung tile + cung thu tu tich lu -> BIT-EXACT voi duong cu.
#
# AN TOAN NATIVE (cuc ky quan trong): worker KHONG goi simd_gemm (T=768 >= 96
# -> tkv_run_mt dung g_job global KHONG CO LOCK = race). Worker chi ghi list
# .NET rieng/disjoint (da chung minh BG2/BF). Main thread goi simd_gemm don
# thuy -> native MT binh thuong.
#
# Cac do luong (BH[x]): timing tai MAIN (bug #8), best-of 2 (reps=2).
# BIT = maxdiff toan phan — phai 0.0.
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bh.tkv out/bh.exe main
#   ./out/bh.exe
#
# Phan MLP: phan rach gpt2_mlp_bwd (simd=1, n=1024) thanh 5 goi — chot phan
# nao la build tile / gelu / gflat de chon dich GĐ3.

import tv.training.gpt2_ref124
import tv.training.trainer
import tv.training.ops
import tv.training.simd_matmul

# ---- nho giong simd_matmul (copy, khong dua vao flatten import) -----------

def _bh_imin(a: 'i64', b: 'i64') -> 'i64':
    if a < b:
        return a
    return b

def _bh_ru64(x: 'i64') -> 'i64':
    r = 64
    while r < x:
        r = r + 64
    return r

def _bh_tilek(k: 'i64') -> 'i64':
    r = _bh_ru64(k)
    if r > 1024:
        r = 1024
    return r

def _bh_ceil(x: 'i64', T: 'i64') -> 'i64':
    q = 0
    r = 0
    while r < x:
        r = r + T
        q = q + 1
    return q

# chia nguyen (tranh phu thuoc semanrics '/' cua i64) — g >= 0
def _bh_gq(g: 'i64', stride: 'i64') -> 'i64':
    if g < 0:
        return 0
    q = 0
    s = g
    while s >= stride:
        s = s - stride
        q = q + 1
    return q

# gidx -> (i0, p0, j0) theo thu tu i0 ngoai, p0, j0 (khop _p58_core_simple)
def _bh_i0(g: 'i64', stride: 'i64', T: 'i64') -> 'i64':
    return _bh_gq(g, stride) * T

def _bh_p0(g: 'i64', stride: 'i64', n_j: 'i64', T: 'i64') -> 'i64':
    i0idx = _bh_gq(g, stride)
    rem = g - i0idx * stride
    return _bh_gq(rem, n_j) * T

def _bh_j0(g: 'i64', stride: 'i64', n_j: 'i64', T: 'i64') -> 'i64':
    i0idx = _bh_gq(g, stride)
    rem = g - i0idx * stride
    p0idx = _bh_gq(rem, n_j)
    return (rem - p0idx * n_j) * T

# list[f32] dung cho simd_gemm (quy uoc append bieu thuc (x - 0.0)/1.0)
def _bh_zeros(n: 'i64') -> 'list[f32]':
    out = []
    i = 0
    while i < n:
        out.append((float(0) - 0.0) / 1.0)
        i = i + 1
    return out

def _bh_fill(t: "Tensor", seed: 'i64') -> 'i64':
    d = t.data
    m = len(d)
    i = 0
    while i < m:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return m

def _bh_maxdiff(a: "Tensor", b: "Tensor", cnt: 'i64') -> 'f64':
    dmax = 0.0
    ad = a.data
    bd = b.data
    i = 0
    while i < cnt:
        e = ad[i] - bd[i]
        if e < 0.0:
            e = -e
        if e > dmax:
            dmax = e
        i = i + 1
    return dmax

def _bh_noop(i: 'i64') -> 'i64':
    return 0

# ---- tile writers (indexed write vao buffer pre-alloc — viet DAY DU T^2,
# bao gom vung pad = 0 vi buffer bi tai su dung qua wave) --------------------

def _bh_tile_a_w(out: "list[f32]", d: "list[f32]", kdim: 'i64', i0: 'i64',
                 ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    # A luu [m hang][k cot]: tile[i,j] = A[i0+i, p0+j] khi i<ib, j<pw
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < ib:
                if j < pw:
                    out[i * T + j] = (d[(i0 + i) * kdim + (p0 + j)] - 0.0) / 1.0
                else:
                    out[i * T + j] = z
            else:
                out[i * T + j] = z
            j = j + 1
        i = i + 1
    return 0

def _bh_tile_b_w(out: "list[f32]", d: "list[f32]", ndim: 'i64', p0: 'i64',
                 pw: 'i64', r0: 'i64', br: 'i64', T: 'i64', trans_b: 'i32') -> 'i64':
    # trans_b=0: B luu [k hang][n cot]; trans_b=1: B luu [n hang][k cot]
    z = (float(0) - 0.0) / 1.0
    i = 0
    while i < T:
        j = 0
        while j < T:
            if i < pw:
                if j < br:
                    if trans_b == 1:
                        out[i * T + j] = (d[(r0 + j) * ndim + (p0 + i)] - 0.0) / 1.0
                    else:
                        out[i * T + j] = (d[(p0 + i) * ndim + (r0 + j)] - 0.0) / 1.0
                else:
                    out[i * T + j] = z
            else:
                out[i * T + j] = z
            j = j + 1
        i = i + 1
    return 0

def _bh_tile_a_at_w(out: "list[f32]", d: "list[f32]", mdim: 'i64', i0: 'i64',
                    ib: 'i64', p0: 'i64', pw: 'i64', T: 'i64') -> 'i64':
    # trans-A: a luu [k hang][m cot] (=A^T): tile[i,j] = A_stored[p0+j? ...]
    # giong _p58_tile_a_at: At[r][t] = A_stored[(p0+t)*mdim + (i0+r)]
    z = (float(0) - 0.0) / 1.0
    r = 0
    while r < T:
        t = 0
        while t < T:
            if r < ib:
                if t < pw:
                    out[r * T + t] = (d[(p0 + t) * mdim + (i0 + r)] - 0.0) / 1.0
                else:
                    out[r * T + t] = z
            else:
                out[r * T + t] = z
            t = t + 1
        r = r + 1
    return 0

# ---- worker: build 1 cap tile (At + Bt) cho 1 gemm-call -------------------
# KHONG goi simd_gemm; KHONG append (buffer main pre-alloc) -> an toan.
class _BhJob:
    gidx: 'i64'
    ad: "list[f32]"
    bd: "list[f32]"
    kdim: 'i64'
    mdim: 'i64'
    ndim: 'i64'
    T: 'i64'
    trans_a: 'i32'
    trans_b: 'i32'
    i0: 'i64'
    ib: 'i64'
    p0: 'i64'
    pw: 'i64'
    j0: 'i64'
    jb: 'i64'
    ta: "list[f32]"
    tb: "list[f32]"
    def __init__(self, gidx: 'i64', ad: "list[f32]", bd: "list[f32]",
                  kdim: 'i64', mdim: 'i64', ndim: 'i64', T: 'i64',
                  trans_a: 'i32', trans_b: 'i32',
                  i0: 'i64', ib: 'i64', p0: 'i64', pw: 'i64',
                  j0: 'i64', jb: 'i64', ta: "list[f32]", tb: "list[f32]"):
        self.gidx = gidx
        self.ad = ad
        self.bd = bd
        self.kdim = kdim
        self.mdim = mdim
        self.ndim = ndim
        self.T = T
        self.trans_a = trans_a
        self.trans_b = trans_b
        self.i0 = i0
        self.ib = ib
        self.p0 = p0
        self.pw = pw
        self.j0 = j0
        self.jb = jb
        self.ta = ta
        self.tb = tb

def _bh_one(j: "_BhJob") -> 'i64':
    if j.gidx < 0:
        return 0
    rv = 0
    if j.trans_a == 1:
        rv = _bh_tile_a_at_w(j.ta, j.ad, j.mdim, j.i0, j.ib, j.p0, j.pw, j.T)
    else:
        rv = _bh_tile_a_w(j.ta, j.ad, j.kdim, j.i0, j.ib, j.p0, j.pw, j.T)
    rv2 = _bh_tile_b_w(j.tb, j.bd, j.ndim, j.p0, j.pw, j.j0, j.jb, j.T, j.trans_b)
    return rv + rv2

# gemm 1 goi + accumulate vung that vao C — thu tu goi = thu tu tich lu
def _bh_do(Ct: "list[f32]", ta: "list[f32]", tb: "list[f32]", T: 'i64',
           cd: "list[f32]", i0: 'i64', ib: 'i64', j0: 'i64', jb: 'i64',
           n: 'i64') -> 'i64':
    simd_gemm(ta, tb, Ct, T)
    r = 0
    while r < ib:
        bc = (i0 + r) * n + j0
        bt = r * T
        c = 0
        while c < jb:
            cd[bc + c] = cd[bc + c] + Ct[bt + c]
            c = c + 1
        r = r + 1
    return 0

# ---- serial baseline: copy _p58_core_simple (builder cung cong thuc) ------
def _bh_core_s(ad: "list[f32]", bd: "list[f32]", m: 'i64', n: 'i64', k: 'i64',
               ndim: 'i64', trans_b: 'i32', trans_a: 'i32') -> "Tensor":
    T = _bh_imin(_bh_tilek(k), _bh_ru64(_bh_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Ct = _bh_zeros(T * T)
    ta = _bh_zeros(T * T)
    tb = _bh_zeros(T * T)
    i0 = 0
    while i0 < m:
        ib = _bh_imin(T, m - i0)
        p0 = 0
        while p0 < k:
            pw = _bh_imin(T, k - p0)
            if trans_a == 1:
                rv = _bh_tile_a_at_w(ta, ad, m, i0, ib, p0, pw, T)
            else:
                rv = _bh_tile_a_w(ta, ad, k, i0, ib, p0, pw, T)
            j0 = 0
            while j0 < n:
                jb = _bh_imin(T, n - j0)
                rv = _bh_tile_b_w(tb, bd, ndim, p0, pw, j0, jb, T, trans_b)
                rv = _bh_do(Ct, ta, tb, T, cd, i0, ib, j0, jb, n)
                j0 = j0 + jb
            p0 = p0 + pw
        i0 = i0 + ib
    return C

# ---- pipelined: 12 worker build tile, main replay gemm — BIT-EXACT --------
# Wave = 12 gemm-call lien tiep (gidx tang = i0 -> p0 -> j0). Slot kem
# (g >= ng) van spawn worker gidx=-1 (no-op) vi khong co lenh spawn co dieu
# kien da chung minh.
def _bh_core_p(ad: "list[f32]", bd: "list[f32]", m: 'i64', n: 'i64', k: 'i64',
               ndim: 'i64', trans_b: 'i32', trans_a: 'i32') -> "Tensor":
    T = _bh_imin(_bh_tilek(k), _bh_ru64(_bh_imin(m, n)))
    C = t_zeros([m, n])
    cd = C.data
    Ct = _bh_zeros(T * T)
    ta0 = _bh_zeros(T * T)
    ta1 = _bh_zeros(T * T)
    ta2 = _bh_zeros(T * T)
    ta3 = _bh_zeros(T * T)
    ta4 = _bh_zeros(T * T)
    ta5 = _bh_zeros(T * T)
    ta6 = _bh_zeros(T * T)
    ta7 = _bh_zeros(T * T)
    ta8 = _bh_zeros(T * T)
    ta9 = _bh_zeros(T * T)
    ta10 = _bh_zeros(T * T)
    ta11 = _bh_zeros(T * T)
    tb0 = _bh_zeros(T * T)
    tb1 = _bh_zeros(T * T)
    tb2 = _bh_zeros(T * T)
    tb3 = _bh_zeros(T * T)
    tb4 = _bh_zeros(T * T)
    tb5 = _bh_zeros(T * T)
    tb6 = _bh_zeros(T * T)
    tb7 = _bh_zeros(T * T)
    tb8 = _bh_zeros(T * T)
    tb9 = _bh_zeros(T * T)
    tb10 = _bh_zeros(T * T)
    tb11 = _bh_zeros(T * T)
    n_i = _bh_ceil(m, T)
    n_p = _bh_ceil(k, T)
    n_j = _bh_ceil(n, T)
    stride = n_p * n_j
    ng = n_i * stride
    wave = 0
    while wave * 12 < ng:
        # ---- derive guse + spec slot 0..11 --------------------------------
        g0 = -1
        if wave * 12 + 0 < ng:
            g0 = wave * 12 + 0
        i0_0 = _bh_i0(g0, stride, T)
        ib_0 = _bh_imin(T, m - i0_0)
        p0_0 = _bh_p0(g0, stride, n_j, T)
        pw_0 = _bh_imin(T, k - p0_0)
        j0_0 = _bh_j0(g0, stride, n_j, T)
        jb_0 = _bh_imin(T, n - j0_0)

        g1 = -1
        if wave * 12 + 1 < ng:
            g1 = wave * 12 + 1
        i0_1 = _bh_i0(g1, stride, T)
        ib_1 = _bh_imin(T, m - i0_1)
        p0_1 = _bh_p0(g1, stride, n_j, T)
        pw_1 = _bh_imin(T, k - p0_1)
        j0_1 = _bh_j0(g1, stride, n_j, T)
        jb_1 = _bh_imin(T, n - j0_1)

        g2 = -1
        if wave * 12 + 2 < ng:
            g2 = wave * 12 + 2
        i0_2 = _bh_i0(g2, stride, T)
        ib_2 = _bh_imin(T, m - i0_2)
        p0_2 = _bh_p0(g2, stride, n_j, T)
        pw_2 = _bh_imin(T, k - p0_2)
        j0_2 = _bh_j0(g2, stride, n_j, T)
        jb_2 = _bh_imin(T, n - j0_2)

        g3 = -1
        if wave * 12 + 3 < ng:
            g3 = wave * 12 + 3
        i0_3 = _bh_i0(g3, stride, T)
        ib_3 = _bh_imin(T, m - i0_3)
        p0_3 = _bh_p0(g3, stride, n_j, T)
        pw_3 = _bh_imin(T, k - p0_3)
        j0_3 = _bh_j0(g3, stride, n_j, T)
        jb_3 = _bh_imin(T, n - j0_3)

        g4 = -1
        if wave * 12 + 4 < ng:
            g4 = wave * 12 + 4
        i0_4 = _bh_i0(g4, stride, T)
        ib_4 = _bh_imin(T, m - i0_4)
        p0_4 = _bh_p0(g4, stride, n_j, T)
        pw_4 = _bh_imin(T, k - p0_4)
        j0_4 = _bh_j0(g4, stride, n_j, T)
        jb_4 = _bh_imin(T, n - j0_4)

        g5 = -1
        if wave * 12 + 5 < ng:
            g5 = wave * 12 + 5
        i0_5 = _bh_i0(g5, stride, T)
        ib_5 = _bh_imin(T, m - i0_5)
        p0_5 = _bh_p0(g5, stride, n_j, T)
        pw_5 = _bh_imin(T, k - p0_5)
        j0_5 = _bh_j0(g5, stride, n_j, T)
        jb_5 = _bh_imin(T, n - j0_5)

        g6 = -1
        if wave * 12 + 6 < ng:
            g6 = wave * 12 + 6
        i0_6 = _bh_i0(g6, stride, T)
        ib_6 = _bh_imin(T, m - i0_6)
        p0_6 = _bh_p0(g6, stride, n_j, T)
        pw_6 = _bh_imin(T, k - p0_6)
        j0_6 = _bh_j0(g6, stride, n_j, T)
        jb_6 = _bh_imin(T, n - j0_6)

        g7 = -1
        if wave * 12 + 7 < ng:
            g7 = wave * 12 + 7
        i0_7 = _bh_i0(g7, stride, T)
        ib_7 = _bh_imin(T, m - i0_7)
        p0_7 = _bh_p0(g7, stride, n_j, T)
        pw_7 = _bh_imin(T, k - p0_7)
        j0_7 = _bh_j0(g7, stride, n_j, T)
        jb_7 = _bh_imin(T, n - j0_7)

        g8 = -1
        if wave * 12 + 8 < ng:
            g8 = wave * 12 + 8
        i0_8 = _bh_i0(g8, stride, T)
        ib_8 = _bh_imin(T, m - i0_8)
        p0_8 = _bh_p0(g8, stride, n_j, T)
        pw_8 = _bh_imin(T, k - p0_8)
        j0_8 = _bh_j0(g8, stride, n_j, T)
        jb_8 = _bh_imin(T, n - j0_8)

        g9 = -1
        if wave * 12 + 9 < ng:
            g9 = wave * 12 + 9
        i0_9 = _bh_i0(g9, stride, T)
        ib_9 = _bh_imin(T, m - i0_9)
        p0_9 = _bh_p0(g9, stride, n_j, T)
        pw_9 = _bh_imin(T, k - p0_9)
        j0_9 = _bh_j0(g9, stride, n_j, T)
        jb_9 = _bh_imin(T, n - j0_9)

        g10 = -1
        if wave * 12 + 10 < ng:
            g10 = wave * 12 + 10
        i0_10 = _bh_i0(g10, stride, T)
        ib_10 = _bh_imin(T, m - i0_10)
        p0_10 = _bh_p0(g10, stride, n_j, T)
        pw_10 = _bh_imin(T, k - p0_10)
        j0_10 = _bh_j0(g10, stride, n_j, T)
        jb_10 = _bh_imin(T, n - j0_10)

        g11 = -1
        if wave * 12 + 11 < ng:
            g11 = wave * 12 + 11
        i0_11 = _bh_i0(g11, stride, T)
        ib_11 = _bh_imin(T, m - i0_11)
        p0_11 = _bh_p0(g11, stride, n_j, T)
        pw_11 = _bh_imin(T, k - p0_11)
        j0_11 = _bh_j0(g11, stride, n_j, T)
        jb_11 = _bh_imin(T, n - j0_11)

        # ---- spawn 12 worker (unrolled — chung minh tu P6 GĐ1/GĐ2) --------
        hb0 = thread_spawn(_bh_one, _BhJob(g0, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_0, ib_0, p0_0, pw_0, j0_0, jb_0, ta0, tb0))
        hb1 = thread_spawn(_bh_one, _BhJob(g1, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_1, ib_1, p0_1, pw_1, j0_1, jb_1, ta1, tb1))
        hb2 = thread_spawn(_bh_one, _BhJob(g2, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_2, ib_2, p0_2, pw_2, j0_2, jb_2, ta2, tb2))
        hb3 = thread_spawn(_bh_one, _BhJob(g3, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_3, ib_3, p0_3, pw_3, j0_3, jb_3, ta3, tb3))
        hb4 = thread_spawn(_bh_one, _BhJob(g4, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_4, ib_4, p0_4, pw_4, j0_4, jb_4, ta4, tb4))
        hb5 = thread_spawn(_bh_one, _BhJob(g5, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_5, ib_5, p0_5, pw_5, j0_5, jb_5, ta5, tb5))
        hb6 = thread_spawn(_bh_one, _BhJob(g6, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_6, ib_6, p0_6, pw_6, j0_6, jb_6, ta6, tb6))
        hb7 = thread_spawn(_bh_one, _BhJob(g7, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_7, ib_7, p0_7, pw_7, j0_7, jb_7, ta7, tb7))
        hb8 = thread_spawn(_bh_one, _BhJob(g8, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_8, ib_8, p0_8, pw_8, j0_8, jb_8, ta8, tb8))
        hb9 = thread_spawn(_bh_one, _BhJob(g9, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_9, ib_9, p0_9, pw_9, j0_9, jb_9, ta9, tb9))
        hb10 = thread_spawn(_bh_one, _BhJob(g10, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_10, ib_10, p0_10, pw_10, j0_10, jb_10, ta10, tb10))
        hb11 = thread_spawn(_bh_one, _BhJob(g11, ad, bd, k, m, ndim, T, trans_a, trans_b, i0_11, ib_11, p0_11, pw_11, j0_11, jb_11, ta11, tb11))

        # ---- join (phai gan bien — quirk P6 GĐ1) ---------------------------
        rj0 = thread_join(hb0)
        rj1 = thread_join(hb1)
        rj2 = thread_join(hb2)
        rj3 = thread_join(hb3)
        rj4 = thread_join(hb4)
        rj5 = thread_join(hb5)
        rj6 = thread_join(hb6)
        rj7 = thread_join(hb7)
        rj8 = thread_join(hb8)
        rj9 = thread_join(hb9)
        rj10 = thread_join(hb10)
        rj11 = thread_join(hb11)

        # ---- replay gemm DUNG thu tu i0 -> p0 -> j0 (bit-exact) -----------
        if g0 >= 0:
            rrp0 = _bh_do(Ct, ta0, tb0, T, cd, i0_0, ib_0, j0_0, jb_0, n)
        if g1 >= 0:
            rrp1 = _bh_do(Ct, ta1, tb1, T, cd, i0_1, ib_1, j0_1, jb_1, n)
        if g2 >= 0:
            rrp2 = _bh_do(Ct, ta2, tb2, T, cd, i0_2, ib_2, j0_2, jb_2, n)
        if g3 >= 0:
            rrp3 = _bh_do(Ct, ta3, tb3, T, cd, i0_3, ib_3, j0_3, jb_3, n)
        if g4 >= 0:
            rrp4 = _bh_do(Ct, ta4, tb4, T, cd, i0_4, ib_4, j0_4, jb_4, n)
        if g5 >= 0:
            rrp5 = _bh_do(Ct, ta5, tb5, T, cd, i0_5, ib_5, j0_5, jb_5, n)
        if g6 >= 0:
            rrp6 = _bh_do(Ct, ta6, tb6, T, cd, i0_6, ib_6, j0_6, jb_6, n)
        if g7 >= 0:
            rrp7 = _bh_do(Ct, ta7, tb7, T, cd, i0_7, ib_7, j0_7, jb_7, n)
        if g8 >= 0:
            rrp8 = _bh_do(Ct, ta8, tb8, T, cd, i0_8, ib_8, j0_8, jb_8, n)
        if g9 >= 0:
            rrp9 = _bh_do(Ct, ta9, tb9, T, cd, i0_9, ib_9, j0_9, jb_9, n)
        if g10 >= 0:
            rrp10 = _bh_do(Ct, ta10, tb10, T, cd, i0_10, ib_10, j0_10, jb_10, n)
        if g11 >= 0:
            rrp11 = _bh_do(Ct, ta11, tb11, T, cd, i0_11, ib_11, j0_11, jb_11, n)

        wave = wave + 1
    return C

def _bh_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

def main() -> 'i32':
    fails = 0

    # ---- BH[0]: spawn+join TRONG VONG LAP (respawn handle) — 100 lan ------
    t0 = now_ms()
    micro = 0
    km = 0
    while km < 100:
        hm = thread_spawn(_bh_noop, km)
        rvm = thread_join(hm)
        micro = micro + rvm
        km = km + 1
    t1 = now_ms()
    print("BH[0] spawn+join x100 = " + str(t1 - t0) + " ms (micro=" + str(micro) + ")")

    # ---- BH[1]: chot copy serial vs LIBRARY + pipe vs serial (nho) --------
    # m=64, n=1024, k=64 -> T=64, ng = 1*1*16 = 16 > 12 -> 2 wave (test multi)
    m1 = 64
    n1 = 1024
    k1 = 64
    a1 = t_zeros([m1, k1])
    b1 = t_zeros([n1, k1])
    _bh_fill(a1, 3)
    _bh_fill(b1, 5)
    c_lib1 = smm_dot(a1, b1, m1, n1, k1)
    c_ser1 = _bh_core_s(a1.data, b1.data, m1, n1, k1, k1, 1, 0)
    c_par1 = _bh_core_p(a1.data, b1.data, m1, n1, k1, k1, 1, 0)
    d1 = _bh_maxdiff(c_lib1, c_ser1, m1 * n1)
    d2 = _bh_maxdiff(c_lib1, c_par1, m1 * n1)
    print("BH[1] small dot 64x1024x64 (ng=16, 2 wave): LIB-vs-SER=" + str(d1)
          + "  LIB-vs-PAR=" + str(d2))
    if d1 > 0.0:
        fails = fails + 1
    if d2 > 0.0:
        fails = fails + 1

    # fwd + trans-A nho
    a2 = t_zeros([128, 300])
    b2 = t_zeros([300, 70])
    _bh_fill(a2, 7)
    _bh_fill(b2, 11)
    c_libf = smm_fwd(a2, b2, 128, 70, 300)
    c_serf = _bh_core_s(a2.data, b2.data, 128, 70, 300, 70, 0, 0)
    c_parf = _bh_core_p(a2.data, b2.data, 128, 70, 300, 70, 0, 0)
    d3 = _bh_maxdiff(c_libf, c_serf, 128 * 70)
    d4 = _bh_maxdiff(c_libf, c_parf, 128 * 70)
    print("BH[1] small fwd 128x70x300: LIB-vs-SER=" + str(d3) + "  LIB-vs-PAR=" + str(d4))
    if d3 > 0.0:
        fails = fails + 1
    if d4 > 0.0:
        fails = fails + 1

    # trans-A: a luu [k hang][m cot] = [300][128]
    a3 = t_zeros([300, 128])
    b3 = t_zeros([300, 70])
    _bh_fill(a3, 13)
    _bh_fill(b3, 17)
    c_liba = smm_fwd_at(a3, b3, 128, 70, 300)
    c_sera = _bh_core_s(a3.data, b3.data, 128, 70, 300, 70, 0, 1)
    c_para = _bh_core_p(a3.data, b3.data, 128, 70, 300, 70, 0, 1)
    d5 = _bh_maxdiff(c_liba, c_sera, 128 * 70)
    d6 = _bh_maxdiff(c_liba, c_para, 128 * 70)
    print("BH[1] small at 128x70x300: LIB-vs-SER=" + str(d5) + "  LIB-vs-PAR=" + str(d6))
    if d5 > 0.0:
        fails = fails + 1
    if d6 > 0.0:
        fails = fails + 1

    # ---- BH[2]: overhead 24 buffer (nhung _bh_core_p moi lan goi) ---------
    TT = 768 * 768
    t0 = now_ms()
    z0 = _bh_zeros(TT)
    z1 = _bh_zeros(TT)
    z2 = _bh_zeros(TT)
    z3 = _bh_zeros(TT)
    z4 = _bh_zeros(TT)
    z5 = _bh_zeros(TT)
    z6 = _bh_zeros(TT)
    z7 = _bh_zeros(TT)
    z8 = _bh_zeros(TT)
    z9 = _bh_zeros(TT)
    z10 = _bh_zeros(TT)
    z11 = _bh_zeros(TT)
    z12 = _bh_zeros(TT)
    z13 = _bh_zeros(TT)
    z14 = _bh_zeros(TT)
    z15 = _bh_zeros(TT)
    z16 = _bh_zeros(TT)
    z17 = _bh_zeros(TT)
    z18 = _bh_zeros(TT)
    z19 = _bh_zeros(TT)
    z20 = _bh_zeros(TT)
    z21 = _bh_zeros(TT)
    z22 = _bh_zeros(TT)
    z23 = _bh_zeros(TT)
    t1 = now_ms()
    print("BH[2] overhead 24 tile-buf (T=768) = " + str(t1 - t0) + " ms  (tinh vao PAR)")

    # ---- SYNTHETIC 124M-shape tensors -------------------------------------
    h = 768
    four = 3072
    nq = 1024
    V = 50257
    TGY = t_zeros([nq, four])
    TW1 = t_zeros([h, four])
    TXH = t_zeros([h, nq])
    TGG = t_zeros([nq, V])
    TWTE = t_zeros([V, h])
    TXF = t_zeros([nq, h])
    _bh_fill(TGY, 1)
    _bh_fill(TW1, 2)
    _bh_fill(TXH, 3)
    _bh_fill(TGG, 4)
    _bh_fill(TWTE, 5)
    _bh_fill(TXF, 6)

    rs = 2

    # ---- S1: dx1 = smm_dot(gy[n,4h], w[h,4h]) -> m=nq, n=h, k=4h ---------
    v_l1 = 1.0e18
    v_s1 = 1.0e18
    v_p1 = 1.0e18
    krep = 0
    while krep < rs:
        t0 = now_ms()
        c1l = smm_dot(TGY, TW1, nq, h, four)
        t1 = now_ms()
        v_l1 = _bh_smt(v_l1, t1 - t0)
        t0 = now_ms()
        c1s = _bh_core_s(TGY.data, TW1.data, nq, h, four, four, 1, 0)
        t1 = now_ms()
        v_s1 = _bh_smt(v_s1, t1 - t0)
        t0 = now_ms()
        c1p = _bh_core_p(TGY.data, TW1.data, nq, h, four, four, 1, 0)
        t1 = now_ms()
        v_p1 = _bh_smt(v_p1, t1 - t0)
        krep = krep + 1
    d1b = _bh_maxdiff(c1l, c1p, nq * h)
    print("BH S1 dx1 [1024x768x3072] LIB=" + str(v_l1) + " SER=" + str(v_s1)
          + " PAR=" + str(v_p1) + " ms  speedup=" + str(v_l1 / v_p1)
          + "  BIT LIB-vs-PAR=" + str(d1b))
    if d1b > 0.0:
        fails = fails + 1

    # ---- S2: dw1 = smm_fwd(xT[h,nq], gy[nq,4h]) -> m=h, n=4h, k=nq --------
    v_l2 = 1.0e18
    v_s2 = 1.0e18
    v_p2 = 1.0e18
    krep = 0
    while krep < rs:
        t0 = now_ms()
        c2l = smm_fwd(TXH, TGY, h, four, nq)
        t1 = now_ms()
        v_l2 = _bh_smt(v_l2, t1 - t0)
        t0 = now_ms()
        c2s = _bh_core_s(TXH.data, TGY.data, h, four, nq, four, 0, 0)
        t1 = now_ms()
        v_s2 = _bh_smt(v_s2, t1 - t0)
        t0 = now_ms()
        c2p = _bh_core_p(TXH.data, TGY.data, h, four, nq, four, 0, 0)
        t1 = now_ms()
        v_p2 = _bh_smt(v_p2, t1 - t0)
        krep = krep + 1
    d2b = _bh_maxdiff(c2l, c2p, h * four)
    print("BH S2 dw1 [768x3072x1024] LIB=" + str(v_l2) + " SER=" + str(v_s2)
          + " PAR=" + str(v_p2) + " ms  speedup=" + str(v_l2 / v_p2)
          + "  BIT LIB-vs-PAR=" + str(d2b))
    if d2b > 0.0:
        fails = fails + 1

    # ---- S3: dxf = smm_fwd(gg[nq,V], wte[V,h]) -> m=nq, n=h, k=V ---------
    v_l3 = 1.0e18
    v_s3 = 1.0e18
    v_p3 = 1.0e18
    krep = 0
    while krep < rs:
        t0 = now_ms()
        c3l = smm_fwd(TGG, TWTE, nq, h, V)
        t1 = now_ms()
        v_l3 = _bh_smt(v_l3, t1 - t0)
        t0 = now_ms()
        c3s = _bh_core_s(TGG.data, TWTE.data, nq, h, V, h, 0, 0)
        t1 = now_ms()
        v_s3 = _bh_smt(v_s3, t1 - t0)
        t0 = now_ms()
        c3p = _bh_core_p(TGG.data, TWTE.data, nq, h, V, h, 0, 0)
        t1 = now_ms()
        v_p3 = _bh_smt(v_p3, t1 - t0)
        krep = krep + 1
    d3b = _bh_maxdiff(c3l, c3p, nq * h)
    print("BH S3 dxf [1024x768x50257] LIB=" + str(v_l3) + " SER=" + str(v_s3)
          + " PAR=" + str(v_p3) + " ms  speedup=" + str(v_l3 / v_p3)
          + "  BIT LIB-vs-PAR=" + str(d3b))
    if d3b > 0.0:
        fails = fails + 1

    # ---- S4: dwte = smm_fwd_at(gg[nq,V], xf[nq,h]) -> m=V, n=h, k=nq ------
    v_l4 = 1.0e18
    v_s4 = 1.0e18
    v_p4 = 1.0e18
    krep = 0
    while krep < rs:
        t0 = now_ms()
        c4l = smm_fwd_at(TGG, TXF, V, h, nq)
        t1 = now_ms()
        v_l4 = _bh_smt(v_l4, t1 - t0)
        t0 = now_ms()
        c4s = _bh_core_s(TGG.data, TXF.data, V, h, nq, h, 0, 1)
        t1 = now_ms()
        v_s4 = _bh_smt(v_s4, t1 - t0)
        t0 = now_ms()
        c4p = _bh_core_p(TGG.data, TXF.data, V, h, nq, h, 0, 1)
        t1 = now_ms()
        v_p4 = _bh_smt(v_p4, t1 - t0)
        krep = krep + 1
    d4b = _bh_maxdiff(c4l, c4p, V * h)
    print("BH S4 dwte [50257x768x1024] LIB=" + str(v_l4) + " SER=" + str(v_s4)
          + " PAR=" + str(v_p4) + " ms  speedup=" + str(v_l4 / v_p4)
          + "  BIT LIB-vs-PAR=" + str(d4b))
    if d4b > 0.0:
        fails = fails + 1

    # ---- S5: logits = smm_dot(xf[nq,h], wte[V,h]) -> m=nq, n=V, k=h ------
    v_l5 = 1.0e18
    v_s5 = 1.0e18
    v_p5 = 1.0e18
    krep = 0
    while krep < rs:
        t0 = now_ms()
        c5l = smm_dot(TXF, TWTE, nq, V, h)
        t1 = now_ms()
        v_l5 = _bh_smt(v_l5, t1 - t0)
        t0 = now_ms()
        c5s = _bh_core_s(TXF.data, TWTE.data, nq, V, h, h, 1, 0)
        t1 = now_ms()
        v_s5 = _bh_smt(v_s5, t1 - t0)
        t0 = now_ms()
        c5p = _bh_core_p(TXF.data, TWTE.data, nq, V, h, h, 1, 0)
        t1 = now_ms()
        v_p5 = _bh_smt(v_p5, t1 - t0)
        krep = krep + 1
    d5b = _bh_maxdiff(c5l, c5p, nq * V)
    print("BH S5 logits [1024x50257x768] LIB=" + str(v_l5) + " SER=" + str(v_s5)
          + " PAR=" + str(v_p5) + " ms  speedup=" + str(v_l5 / v_p5)
          + "  BIT LIB-vs-PAR=" + str(d5b))
    if d5b > 0.0:
        fails = fails + 1

    # ---- BH[3]: PHAN RACH MLP_BWD (simd=1, n=1024) ------------------------
    X = t_zeros([nq, h])
    B1 = t_zeros([four])
    W2 = t_zeros([four, h])
    B2 = t_zeros([h])
    GY = t_zeros([nq, h])
    _bh_fill(X, 21)
    _bh_fill(B1, 22)
    _bh_fill(W2, 23)
    _bh_fill(B2, 24)
    _bh_fill(GY, 25)
    # offsets gflat: o_w2=0 (4h*h), o_b2=4h*h (h), o_w1=4h*h+h (h*4h), o_b1 = h*4h+4h*h+h (4h)
    o_w2 = four * h
    o_b2 = o_w2 + h
    o_w1 = o_b2 + four
    o_b1 = o_w1 + h * four
    gsz = o_b1 + four
    GF = _bh_zeros(gsz)

    t0 = now_ms()
    inner = gpt2_linear(X, TW1, B1, nq, h, four, 1)
    t1 = now_ms()
    v_in = t1 - t0

    t0 = now_ms()
    aa = t_zeros([nq * four])
    for i in range(nq * four):
        aa.data[i] = gelu_erf(inner.data[i])
    t1 = now_ms()
    v_gf = t1 - t0

    t0 = now_ms()
    r2 = gpt2_linear_bwd(aa, W2, GY, nq, four, h, 1, GF, o_w2, o_b2)
    t1 = now_ms()
    v_r2 = t1 - t0

    t0 = now_ms()
    d_inner = op_gelu_erf_bwd(inner, r2[0])
    t1 = now_ms()
    v_gb = t1 - t0

    t0 = now_ms()
    r1 = gpt2_linear_bwd(X, TW1, d_inner, nq, h, four, 1, GF, o_w1, o_b1)
    t1 = now_ms()
    v_r1 = t1 - t0

    sum5 = v_in + v_gf + v_r2 + v_gb + v_r1

    t0 = now_ms()
    rfull = gpt2_mlp_bwd(X, TW1, B1, W2, B2, nq, GY, 1, GF, o_w1, o_b1, o_w2, o_b2)
    t1 = now_ms()
    v_wh = t1 - t0

    print("BH[3] MLP_BWD parts: inner_fwd=" + str(v_in) + " gelu_fwd=" + str(v_gf)
          + " r2(dx2+dw2+db2)=" + str(v_r2) + " gelu_bwd=" + str(v_gb)
          + " r1(dx1+dw1+db1)=" + str(v_r1) + " ms")
    print("BH[3] sum_parts=" + str(sum5) + "  WHOLE gpt2_mlp_bwd=" + str(v_wh)
          + "  chk=" + str(sum5 - v_wh))

    # ---- chot ket luan ----------------------------------------------------
    if fails == 0:
        print("BH RESULT: ALL BIT-EXACT (fails=0)")
    else:
        print("BH RESULT: FAILS=" + str(fails))
    print("BH done")
    return 0
