# PROBE 17 — tach "fwd" thanh: model (forward_saved) | loss | cap phat t_zeros.
import tv.training.gpt2_ref124
import tv.training.tensor

def mk_ids(n: 'i64') -> 'list[i64]':
    ids = []
    i = 0
    while i < n:
        ids.append((i * 37 + 11) % 50257)
        i = i + 1
    return ids

def mk_pos(n: 'i64') -> 'list[i64]':
    pos = []
    i = 0
    while i < n:
        pos.append(i)
        i = i + 1
    return pos

def fwd_saved(ps: 'list[Tensor]', ids: 'list[i64]', pos: 'list[i64]') -> 'list[Tensor]':
    ln1_g = []
    ln1_b = []
    wq = []
    bq = []
    wp = []
    bp = []
    ln2_g = []
    ln2_b = []
    w1 = []
    b1 = []
    w2 = []
    b2 = []
    for li in range(NLayers):
        base = 4 + li * 12
        ln1_g.append(ps[base + 0])
        ln1_b.append(ps[base + 1])
        wq.append(ps[base + 2])
        bq.append(ps[base + 3])
        wp.append(ps[base + 4])
        bp.append(ps[base + 5])
        ln2_g.append(ps[base + 6])
        ln2_b.append(ps[base + 7])
        w1.append(ps[base + 8])
        b1.append(ps[base + 9])
        w2.append(ps[base + 10])
        b2.append(ps[base + 11])
    return gpt2_forward_saved(ids, pos, ps[0], ps[1], ln1_g, ln1_b, wq, bq, wp, bp,
                              ln2_g, ln2_b, w1, b1, w2, b2, ps[2], ps[3], 1, None)

def main() -> 'i32':
    seq = 1024
    ids = mk_ids(seq)
    pos = mk_pos(seq)
    ps = gpt2_init(7)
    sv0 = fwd_saved(ps, ids, pos)
    l0 = gpt2_loss(sv0[0], ids)
    t0 = now_ms()
    sv1 = fwd_saved(ps, ids, pos)
    t1 = now_ms()
    l1 = gpt2_loss(sv1[0], ids)
    t2 = now_ms()
    t3 = now_ms()
    sv2 = fwd_saved(ps, ids, pos)
    t4 = now_ms()
    print("MODEL " + str(t1 - t0) + " ms / " + str(t4 - t3) + " ms   LOSS " + str(t2 - t1) + " ms  (l=" + str(l1) + " warm=" + str(l0) + ")")

    z0 = now_ms()
    a1 = t_zeros([seq, VocabSize])
    a2 = t_zeros([seq, VocabSize])
    z1 = now_ms()
    print("TZEROS logits x2 = " + str(z1 - z0) + " ms")

    b0 = now_ms()
    a3 = t_zeros([seq, 4 * 768])
    a4 = t_zeros([seq, 4 * 768])
    a5 = t_zeros([seq, 4 * 768])
    a6 = t_zeros([seq, 4 * 768])
    a7 = t_zeros([seq, 4 * 768])
    a8 = t_zeros([seq, 4 * 768])
    a9 = t_zeros([seq, 4 * 768])
    a10 = t_zeros([seq, 4 * 768])
    a11 = t_zeros([seq, 4 * 768])
    a12 = t_zeros([seq, 4 * 768])
    a13 = t_zeros([seq, 4 * 768])
    a14 = t_zeros([seq, 4 * 768])
    b1 = now_ms()
    print("TZEROS 12x[1024,3072] = " + str(b1 - b0) + " ms")
    return 0
