# PROBE T — 28 grad: simd=1 vs simd=0 tung tensor
import tv.training.tensor
import tv.training.gpt2_ref
import tv.training.gpt2_train
import tv.training.trainer
import tv.training.simd_matmul

def _is_comment(ln: 'str') -> 'i32':
    if len(ln) < 1:
        return 1
    if ln[0] == "#":
        return 1
    return 0

def load_floats(path: 'str') -> "list[f32]":
    txt = read_file(path)
    lines = txt.split("\n")
    vals = []
    for i in range(len(lines)):
        if _is_comment(lines[i]) == 1:
            continue
        toks = lines[i].split(" ")
        for j in range(len(toks)):
            if len(toks[j]) > 0:
                vals.append(float(toks[j]))
    return vals

def load_ints(path: 'str') -> 'list[i64]':
    f = load_floats(path)
    out = []
    for i in range(len(f)):
        out.append(int(f[i]))
    return out

def _tmd(a: "Tensor", b: "Tensor") -> 'f32':
    da = a.data
    db = b.data
    m = 0.0
    for i in range(len(da)):
        d = float(da[i]) - float(db[i])
        if d < 0.0:
            d = -d
        if d > m:
            m = d
    return m

def main() -> 'i32':
    FIX = "tv/tests/fixtures/"
    ps = gpt2_init(7)
    ids = load_ints(FIX + "g2_ids.txt")
    pos = load_ints(FIX + "g2_pos.txt")
    g0 = gpt2_bwd_ps(ps, ids, pos)
    g1 = gpt2_bwd_ps(ps, ids, pos, 1)
    for i in range(len(g0)):
        d = _tmd(g0[i], g1[i])
        if d > 0.0001:
            print("T tensor " + str(i) + " diff=" + str(d))
    print("T done, n=" + str(len(g0)))
    return 0
