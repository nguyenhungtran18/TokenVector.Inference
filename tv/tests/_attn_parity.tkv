import tv.training.gpt2_ref124

def main() -> 'i32':
    n = 1024
    h = HiddenSize
    hd = HeadDim
    V = VocabSize
    NL = NLayers
    print("=== ATen torch_attention_bwd: co ghi gradient that khong? ===")
    npar = V * h + MaxPos * h + h + h
    npar = npar + NL * (h + h + 3 * h * h + 3 * h + h * h + h + h + h + 4 * h * h + 4 * h + 4 * h * h + h)
    gt = t_zeros([npar])
    gflat = gt.data
    wqkv = t_zeros([h, 3 * h])
    wproj = t_zeros([h, h])
    bqkv = t_zeros([3 * h])
    bproj = t_zeros([h])
    x = t_zeros([n, h])
    gout = t_zeros([n, h])
    dx = t_zeros([n, h])
    xd = x.data
    gd = gout.data
    dxd = dx.data
    wqd = wqkv.data
    wpd = wproj.data
    bqd = bqkv.data
    bpd = bproj.data
    i = 0
    while i < n * h:
        xd[i] = 0.01 * float(i % 97) - 0.4
        gd[i] = 0.02 * float(i % 53) - 0.5
        i = i + 1
    i = 0
    while i < h * 3 * h:
        wqd[i] = 0.001 * float(i % 31) - 0.015
        i = i + 1
    i = 0
    while i < h * h:
        wpd[i] = 0.001 * float(i % 29) - 0.014
        i = i + 1
    base = V * h + MaxPos * h + h + h
    oq = base + h + h
    obq = oq + 3 * h * h
    op = obq + 3 * h
    obp = op + h * h
    i = 0
    while i < 3 * h * h + 3 * h + h * h + h:
        gflat[oq + i] = 0.0
        i = i + 1
    r = torch_attention_bwd(xd, gd, wqd, bqd, wpd, bpd, dxd, gflat, n, h, NHeads, hd, oq, obq, op, obp)
    print("ATen rc = " + str(r))
    s1 = 0.0
    s2 = 0.0
    s3 = 0.0
    i = 0
    while i < 3 * h * h:
        s1 = s1 + abs(gflat[oq + i])
        i = i + 1
    i = 0
    while i < h * h:
        s2 = s2 + abs(gflat[op + i])
        i = i + 1
    i = 0
    while i < n * h:
        s3 = s3 + abs(dxd[i])
        i = i + 1
    print("|dw_qkv| tong = " + str(s1))
    print("|dw_proj| tong = " + str(s2))
    print("|dx| tong     = " + str(s3))
    return 0
