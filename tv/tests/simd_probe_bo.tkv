# PROBE BO — P6 GĐ6: PHAN RAC MLP_BWD (2026-10-21)
#
# Muc dich: giai thich MLP_BWD 11828ms @1024 (AQ — pha lon nhat, 986ms/layer).
# Sau P6 GĐ3 (builder fix GEMM) + GĐ4 (gelu parallel), chua ai do lai tung
# thanh phan. Doc code gpt2_mlp_bwd: inner = gpt2_linear (smm_fwd + bias) ->
# a = t_zeros -> gelu_fwd -> r2 = gpt2_linear_bwd (dx smm_dot + xT transpose
# + dw smm_fwd + db + gflat pack) -> gelu_bwd -> r1 = gpt2_linear_bwd.
# Probe DO TRUC TIPE (mot layer, n=1024, du lieu synthetic nong, simd=1,
# gflat + goff/dboff >= 0 — cung duong voi bench mode 1):
#   BO[1]  whole   = gpt2_mlp_bwd(...) x2 best
#   BO[2a] innerG  = smm_fwd(x, w1, n, 4h, h)        (GEMM inner)
#   BO[2b] bias    = _bo_bias (vong cong bias n*4h)
#   BO[3]  alloc a = t_zeros([n*4h])
#   BO[4]  geluF   = op_gelu_erf_fwd (PROXY SERIAL — production dung
#                    _gelu_fwd_par private, khong goi duoc tu probe)
#   BO[5]  r2      = gpt2_linear_bwd(a, w2, gout, ...) — toan bo
#   BO[6]  geluB   = op_gelu_erf_bwd (CUNG call production, parallel)
#   BO[7]  r1      = gpt2_linear_bwd(x, w1, d_inner, ...) — toan bo
#   chk1 = (2a+2b+3+4+5+6+7 - whole)/whole
#   Sub-split r2 (copy NGUYEN VAN tung phep gpt2_linear_bwd):
#   BO[8]  dx2     = smm_dot(gout, w2, n, 4h, h)
#   BO[9]  xT2     = smm_transpose(a, n, 4h)          (3.15M copy)
#   BO[10] dw2     = smm_fwd(xT2, gout, 4h, h, n)
#   BO[11] db2     = _bo_dbpack (n*h + gflat write)
#   BO[12] pack2   = _bo_pack dw2 -> gflat (4h*h)
#   chk2 = (sum - r2)/r2
#   Sub-split r1 (cung cu):
#   BO[13] dx1 = smm_dot(d_inner, w1, n, h, 4h)
#   BO[14] xT1 = smm_transpose(x, n, h)               (0.79M)
#   BO[15] dw1 = smm_fwd(xT1, d_inner, h, 4h, n)
#   BO[16] db1 = _bo_dbpack (n*4h + gflat)
#   BO[17] pack1 = _bo_pack dw1 -> gflat (h*4h)
#   chk3 = (sum - r1)/r1
#   BO[18] allocTong = 6 buffer zero-fill (y, a, dx2, dw2, dx1, dw1) —
#          diagnostic PHI ZERO-FILL (tach rieng vi nam trong cac phep khac)
# Toan bo timing o MAIN (bug #8). Mot list phang/ham (bug #2).
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_bo.tkv out/bo.exe main
#   ./out/bo.exe

import tv.training.gpt2_ref124
import tv.training.simd_matmul
import tv.training.ops

def _bo_smt(a: 'f64', b: 'f64') -> 'f64':
    if a < b:
        return a
    return b

# ---- fill (moi ham MOT list phang) ----------------------------------------
def _bo_fx(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 131) % 97) - 48) * 0.011)
    return out

def _bo_fw1(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 77) % 89) - 44) * 0.0091)
    return out

def _bo_fb1(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 53) % 83) - 41) * 0.0071)
    return out

def _bo_fw2(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 149) % 101) - 50) * 0.0083)
    return out

def _bo_fb2(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 61) % 79) - 39) * 0.0067)
    return out

def _bo_fg(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n):
        out.append(float(((i * 173) % 103) - 51) * 0.013)
    return out

# ---- copy NGUYEN VAN tu gpt2_ref (cac phep trong linear_bwd / gpt2_linear)
def _bo_bias(yd: "list[f32]", b: "list[f32]", n: 'i64', out_d: 'i64') -> 'i64':
    # gpt2_linear simd: cong bias vao y (sau smm_fwd)
    for i in range(n):
        base = i * out_d
        for o in range(out_d):
            yd[base + o] = yd[base + o] + b[o]
    return 0

def _bo_dbpack(gy: "list[f32]", n: 'i64', out_d: 'i64',
               gflat: "list[f32]", dboff: 'i64') -> 'i64':
    # gpt2_linear_bwd simd + dboff >= 0: tinh db, ghi thang gflat
    for i in range(n):
        base = i * out_d
        for o in range(out_d):
            gflat[dboff + o] = gflat[dboff + o] + gy[base + o]
    return 0

def _bo_pack(dwd: "list[f32]", cnt: 'i64',
             gflat: "list[f32]", goff: 'i64') -> 'i64':
    # gpt2_linear_bwd simd + goff >= 0: dw -> gflat
    for k in range(cnt):
        gflat[goff + k] = gflat[goff + k] + dwd[k]
    return 0

def main() -> 'i64':
    n = 1024
    h = HiddenSize
    ih = 4 * h
    # ---- data -------------------------------------------------------------
    xt = t_new(_bo_fx(n * h), [n, h])
    w1t = t_new(_bo_fw1(h * ih), [h, ih])
    b1t = t_new(_bo_fb1(ih), [ih])
    w2t = t_new(_bo_fw2(ih * h), [ih, h])
    b2t = t_new(_bo_fb2(h), [h])
    goutt = t_new(_bo_fg(n * h), [n, h])
    # gflat layout: o_w1=0, o_w2=h*ih, o_b1=2*h*ih, o_b2=2*h*ih+ih
    o_w1 = 0
    o_w2 = h * ih
    o_b1 = 2 * h * ih
    o_b2 = 2 * h * ih + ih
    gflat = t_zeros([2 * h * ih + ih + h]).data

    # ---- BO[1] whole ------------------------------------------------------
    v1 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        rw = gpt2_mlp_bwd(xt, w1t, b1t, w2t, b2t, n, goutt, 1, gflat,
                          o_w1, o_b1, o_w2, o_b2)
        d1 = now_ms() - t0
        v1 = _bo_smt(v1, d1)
        krep = krep + 1
    print("BO[1] whole mlp_bwd = " + str(v1) + " ms")

    # ---- BO[2a] inner GEMM + BO[2b] bias ----------------------------------
    v2a = 1.0e18
    v2b = 1.0e18
    krep = 0
    innert = None
    while krep < 2:
        t0 = now_ms()
        y0 = smm_fwd(xt, w1t, n, ih, h)
        d2a = now_ms() - t0
        v2a = _bo_smt(v2a, d2a)
        t0 = now_ms()
        rb = _bo_bias(y0.data, b1t.data, n, ih)
        d2b = now_ms() - t0
        v2b = _bo_smt(v2b, d2b)
        innert = y0
        krep = krep + 1
    print("BO[2a] inner GEMM = " + str(v2a) + " ms  BO[2b] bias = " + str(v2b) + " ms")

    # ---- BO[3] alloc a ----------------------------------------------------
    v3 = 1.0e18
    krep = 0
    at = None
    while krep < 2:
        t0 = now_ms()
        at = t_zeros([n * ih])
        d3 = now_ms() - t0
        v3 = _bo_smt(v3, d3)
        krep = krep + 1
    print("BO[3] alloc a [n*4h] = " + str(v3) + " ms")

    # ---- BO[4] gelu fwd (PROXY SERIAL) ------------------------------------
    v4 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        at2 = op_gelu_erf_fwd(innert)
        d4 = now_ms() - t0
        v4 = _bo_smt(v4, d4)
        krep = krep + 1
    print("BO[4] geluF PROXY serial = " + str(v4) + " ms")

    # ---- BO[5] r2 = linear_bwd(a, w2, gout, in=4h, out=h) ----------------
    v5 = 1.0e18
    krep = 0
    r2t = None
    while krep < 2:
        t0 = now_ms()
        r2t = gpt2_linear_bwd(at, w2t, goutt, n, ih, h, 1, gflat, o_w2, o_b2)
        d5 = now_ms() - t0
        v5 = _bo_smt(v5, d5)
        krep = krep + 1
    print("BO[5] r2 linear_bwd (in=4h,out=h) = " + str(v5) + " ms")

    # ---- BO[6] gelu bwd (CUNG call production) ---------------------------
    v6 = 1.0e18
    krep = 0
    d_innert = None
    while krep < 2:
        t0 = now_ms()
        d_innert = op_gelu_erf_bwd(innert, r2t[0])
        d6 = now_ms() - t0
        v6 = _bo_smt(v6, d6)
        krep = krep + 1
    print("BO[6] geluB (production) = " + str(v6) + " ms")

    # ---- BO[7] r1 = linear_bwd(x, w1, d_inner, in=h, out=4h) -------------
    v7 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        r1t = gpt2_linear_bwd(xt, w1t, d_innert, n, h, ih, 1, gflat, o_w1, o_b1)
        d7 = now_ms() - t0
        v7 = _bo_smt(v7, d7)
        krep = krep + 1
    print("BO[7] r1 linear_bwd (in=h,out=4h) = " + str(v7) + " ms")

    sum1 = v2a + v2b + v3 + v4 + v5 + v6 + v7
    print("BO sum1 = " + str(sum1) + " ms  whole = " + str(v1)
          + " ms  chk1 = " + str((sum1 - v1) / v1))

    # ---- Sub-split r2 (copy phep gpt2_linear_bwd) -------------------------
    v8 = 1.0e18
    krep = 0
    dx2t = None
    while krep < 2:
        t0 = now_ms()
        dx2t = smm_dot(goutt, w2t, n, ih, h)
        d8 = now_ms() - t0
        v8 = _bo_smt(v8, d8)
        krep = krep + 1
    print("BO[8] dx2 smm_dot = " + str(v8) + " ms")

    v9 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        xT2t = smm_transpose(at, n, ih)
        d9 = now_ms() - t0
        v9 = _bo_smt(v9, d9)
        krep = krep + 1
    print("BO[9] xT2 transpose (4h*n) = " + str(v9) + " ms")

    v10 = 1.0e18
    krep = 0
    dw2t = None
    while krep < 2:
        t0 = now_ms()
        dw2t = smm_fwd(xT2t, goutt, ih, h, n)
        d10 = now_ms() - t0
        v10 = _bo_smt(v10, d10)
        krep = krep + 1
    print("BO[10] dw2 smm_fwd = " + str(v10) + " ms")

    v11 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        r11 = _bo_dbpack(goutt.data, n, h, gflat, o_b2)
        d11 = now_ms() - t0
        v11 = _bo_smt(v11, d11)
        krep = krep + 1
    print("BO[11] db2+gflat (n*h) = " + str(v11) + " ms")

    v12 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        r12 = _bo_pack(dw2t.data, ih * h, gflat, o_w2)
        d12 = now_ms() - t0
        v12 = _bo_smt(v12, d12)
        krep = krep + 1
    print("BO[12] pack dw2->gflat (4h*h) = " + str(v12) + " ms")

    sum2 = v8 + v9 + v10 + v11 + v12
    print("BO sum2 = " + str(sum2) + " ms  r2 = " + str(v5)
          + " ms  chk2 = " + str((sum2 - v5) / v5))

    # ---- Sub-split r1 -----------------------------------------------------
    v13 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        dx1t = smm_dot(d_innert, w1t, n, h, ih)
        d13 = now_ms() - t0
        v13 = _bo_smt(v13, d13)
        krep = krep + 1
    print("BO[13] dx1 smm_dot = " + str(v13) + " ms")

    v14 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        xT1t = smm_transpose(xt, n, h)
        d14 = now_ms() - t0
        v14 = _bo_smt(v14, d14)
        krep = krep + 1
    print("BO[14] xT1 transpose (h*n) = " + str(v14) + " ms")

    v15 = 1.0e18
    krep = 0
    dw1t = None
    while krep < 2:
        t0 = now_ms()
        dw1t = smm_fwd(xT1t, d_innert, h, ih, n)
        d15 = now_ms() - t0
        v15 = _bo_smt(v15, d15)
        krep = krep + 1
    print("BO[15] dw1 smm_fwd = " + str(v15) + " ms")

    v16 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        r16 = _bo_dbpack(d_innert.data, n, ih, gflat, o_b1)
        d16 = now_ms() - t0
        v16 = _bo_smt(v16, d16)
        krep = krep + 1
    print("BO[16] db1+gflat (n*4h) = " + str(v16) + " ms")

    v17 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        r17 = _bo_pack(dw1t.data, h * ih, gflat, o_w1)
        d17 = now_ms() - t0
        v17 = _bo_smt(v17, d17)
        krep = krep + 1
    print("BO[17] pack dw1->gflat (h*4h) = " + str(v17) + " ms")

    sum3 = v13 + v14 + v15 + v16 + v17
    print("BO sum3 = " + str(sum3) + " ms  r1 = " + str(v7)
          + " ms  chk3 = " + str((sum3 - v7) / v7))

    # ---- BO[18] allocTong: 6 buffer zero-fill (diagnostic) ---------------
    v18 = 1.0e18
    krep = 0
    while krep < 2:
        t0 = now_ms()
        a1 = t_zeros([n * ih])
        a2 = t_zeros([n * ih])
        a3 = t_zeros([n * ih])
        a4 = t_zeros([ih * h])
        a5 = t_zeros([n * h])
        a6 = t_zeros([h * ih])
        d18 = now_ms() - t0
        v18 = _bo_smt(v18, d18)
        krep = krep + 1
    print("BO[18] allocTong 6 buf (y,a,dx2,dw2,dx1,dw1) = " + str(v18)
          + " ms  (le — nam trong cac phep khac)")
    print("BO done")
    return 0
