# PROBE _gf1 — A/B simd_gemm_full vs duong production hien tai (_smm_pk M4)
# ----------------------------------------------------------------------------
# 0 thay doi code train. 4 shape CG + guard m=8 (seq8 khong duoc regress):
#   S1 dx1  [mx768x3072] tb=1 (smm_dot)      S3 dxf [mx768x50257] tb=0 (smm_fwd)
#   S5 lgts [mx50257x768] tb=1 (smm_dot sc)  S4 dwte ta=1 -> full N/A (khong co trans_a)
# Moi shape 3 bien the best-of-5 (now_ms 15.6ms):
#   cur   = production hien tai (smm_fwd/smm_dot, k>=256 -> _smm_pk M4)
#   fullA = simd_gemm_full mode=0, cd = t_zeros trong timing (thay the truc tiep)
#   fullB = simd_gemm_full mode=0, cd reuse ngoai timing (khi wire co scratch)
# + BIT maxdiff full vs cur (ky vong 0.0)
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_gf1.tkv out/gf1.exe main; out/gf1.exe
import tv.training.tensor
import tv.training.simd_matmul

def _min(a: 'f64', b: 'f64') -> 'f64':
    if b < a:
        return b
    return a

def _maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def _fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

# chay 1 bien the, tra ve (ms, tensor ket qua)
def _run_cur(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
             tb: 'i32', sc: "list[f32]") -> "list[f32]":
    if tb == 0:
        rb = smm_fwd(a, b, m, n, k)
    else:
        rb = smm_dot(a, b, m, n, k, sc)
    return rb.data

def _run_full(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
              ndim: 'i64', tb: 'i32', cd: "list[f32]") -> 'i32':
    ad: "list[f32]" = a.data
    bd: "list[f32]" = b.data
    rv = simd_gemm_full(ad, bd, cd, m, n, k, ndim, tb, 256, 0)
    return rv

def _bench(tag: 'str', a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
           ndim: 'i64', tb: 'i32', reps: 'i64') -> 'i32':
    scratch: "list[f32]" = []
    for i in range(m * n):
        scratch.append(0.0)
    cdB: "list[f32]" = []
    for i in range(m * n):
        cdB.append(0.0)

    tcur = 1000000000.0
    tfA = 1000000000.0
    tfB = 1000000000.0
    rdata: "list[f32]" = scratch
    cdA: "list[f32]" = scratch
    rc = 0
    r = 0
    while r < reps:
        t0 = now_ms()
        rdata = _run_cur(a, b, m, n, k, tb, scratch)
        t1 = now_ms()
        tcur = _min(tcur, float(t1 - t0))

        cdt = t_zeros([m, n])
        cdA = cdt.data
        t0 = now_ms()
        rc = _run_full(a, b, m, n, k, ndim, tb, cdA)
        t1 = now_ms()
        tfA = _min(tfA, float(t1 - t0))
        if rc != 0:
            print("  [FAIL] " + tag + " fullA rc=" + str(rc))
            return 1

        t0 = now_ms()
        rc = _run_full(a, b, m, n, k, ndim, tb, cdB)
        t1 = now_ms()
        tfB = _min(tfB, float(t1 - t0))
        if rc != 0:
            print("  [FAIL] " + tag + " fullB rc=" + str(rc))
            return 1
        r = r + 1

    md = _maxdiff(rdata, cdB, m * n)
    print("GF1 " + tag + "  cur=" + str(tcur) + "ms  fullA=" + str(tfA)
          + "ms (" + str(tcur / tfA) + "x)  fullB=" + str(tfB)
          + "ms (" + str(tcur / tfB) + "x)  BIT=" + str(md))
    if md > 0.0:
        return 1
    return 0

def main() -> 'i32':
    nq = 1024
    h = 768
    V = 50257
    four = 3072
    fails = 0

    # shape data (giong CG mode 3)
    A1 = t_zeros([nq, four])
    B1 = t_zeros([h, four])
    A34 = t_zeros([nq, V])
    B35 = t_zeros([V, h])
    D45 = t_zeros([nq, h])
    _fill(A1.data, nq * four, 1)
    _fill(B1.data, h * four, 2)
    _fill(A34.data, nq * V, 3)
    _fill(B35.data, V * h, 4)
    _fill(D45.data, nq * h, 5)

    # m=8 guard data
    A1s = t_zeros([8, four])
    A34s = t_zeros([8, V])
    D45s = t_zeros([8, h])
    _fill(A1s.data, 8 * four, 6)
    _fill(A34s.data, 8 * V, 7)
    _fill(D45s.data, 8 * h, 8)

    # m=256 guard data (seq256)
    A1m = t_zeros([256, four])
    A34m = t_zeros([256, V])
    D45m = t_zeros([256, h])
    _fill(A1m.data, 256 * four, 9)
    _fill(A34m.data, 256 * V, 10)
    _fill(D45m.data, 256 * h, 11)

    print("GF1 A/B simd_gemm_full vs _smm_pk (best-of-5, T=256)")

    # S1 dx1 [mx768x3072] tb=1 (ndim=k=3072)
    fails = fails + _bench("S1 m=1024 [1024x768x3072] tb1", A1, B1, nq, h, four, four, 1, 3)
    fails = fails + _bench("S1 m=256  [256x768x3072]  tb1", A1m, B1, 256, h, four, four, 1, 3)
    fails = fails + _bench("S1 m=8    [8x768x3072]    tb1", A1s, B1, 8, h, four, four, 1, 5)

    # S3 dxf [mx768x50257] tb=0 (ndim=n=768)
    fails = fails + _bench("S3 m=1024 [1024x768x50257] tb0", A34, B35, nq, h, V, h, 0, 3)
    fails = fails + _bench("S3 m=256  [256x768x50257]  tb0", A34m, B35, 256, h, V, h, 0, 3)
    fails = fails + _bench("S3 m=8    [8x768x50257]    tb0", A34s, B35, 8, h, V, h, 0, 5)

    # S5 lgts [mx50257x768] tb=1 (ndim=k=768)
    fails = fails + _bench("S5 m=1024 [1024x50257x768] tb1", D45, B35, nq, V, h, h, 1, 3)
    fails = fails + _bench("S5 m=256  [256x50257x768]  tb1", D45m, B35, 256, V, h, h, 1, 3)
    fails = fails + _bench("S5 m=8    [8x50257x768]    tb1", D45s, B35, 8, V, h, h, 1, 5)

    print("S4 dwte ta=1: simd_gemm_full N/A (khong co trans_a) -> giu duong smm_fwd_at")
    print("GF1 done fails=" + str(fails) + " (BIT khong 0 = packed vs full khac thu tu tile -> xem tol gate 1e-4)")
    return fails
