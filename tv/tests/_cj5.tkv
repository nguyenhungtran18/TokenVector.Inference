# PROBE CJ5 — M4 f32 routing threshold: m nho (seq8/256) + sweep T
# ---------------------------------------------------------------------------
# CJ2 v3 cho thay m=1024: S1 2.04x, S3 1.69x, S5 2.43x (T=768). Truoc khi wire
# can biet m nho (seq8=8, seq256=256) co regress khong (pack B co dinh ~250ms
# trong khi base nho) va T nao tot (256 vs 768).
# Goi: D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/_cj5.tkv out/cj5.exe main
import tv.training.tensor
import tv.training.simd_matmul

def _fill(d: "list[f32]", n: 'i64', seed: 'i64') -> 'i64':
    i = 0
    while i < n:
        d[i] = float(((i * 131 + seed) % 97) - 48) * 0.0021
        i = i + 1
    return n

def _maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        dv = a[i] - b[i]
        if dv < 0.0:
            dv = -dv
        if dv > dmax:
            dmax = dv
        i = i + 1
    return dmax

def _m4(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64',
        rb: 'i64', cb: 'i64', sb: 'i64', tb: 'i32',
        T: 'i64', sc: "list[f32]", ph: "list[f64]") -> 'i32':
    # A: m×k trans=0; B params rieng (S3: B k×n trans0; S5: B n×k trans1)
    t0 = now_ms()
    ad = a.data
    bd = b.data
    hA: "i64" = 0
    hB: "i64" = 0
    hA = simd_gemm_packed_create(ad, m, k, k, T, 0)
    hB = simd_gemm_packed_create(bd, rb, cb, sb, T, tb)
    t1 = now_ms()
    st = simd_gemm_packed(hA, hB, sc, T)
    fa = simd_gemm_packed_free(hA)
    fb = simd_gemm_packed_free(hB)
    t2 = now_ms()
    ph.append(t1 - t0)
    ph.append(t2 - t1)
    return st

# S3-like: A m×k, B k×n trans0, base = smm_fwd_pd (sc out)
def _s3(m: 'i64', T: 'i64', tag: 'str') -> 'i64':
    k = 50257
    n = 768
    rs = 3
    A = t_zeros([m, k])
    B = t_zeros([k, n])
    sc = t_zeros([m, n])
    tg = t_zeros([m, n])
    _fill(A.data, m * k, 3)
    _fill(B.data, k * n, 4)
    vb = 1.0e18
    i = 0
    while i < rs:
        t0 = now_ms()
        rb = smm_fwd_pd(A, B, m, n, k, sc.data)
        t1 = now_ms()
        if t1 - t0 < vb:
            vb = t1 - t0
        i = i + 1
    vt = 1.0e18
    ph: "list[f64]" = None
    i = 0
    while i < rs:
        ph = []
        t0 = now_ms()
        st = _m4(A, B, m, n, k, k, n, n, 0, T, tg.data, ph)
        t1 = now_ms()
        if t1 - t0 < vt:
            vt = t1 - t0
        i = i + 1
    md = _maxdiff(sc.data, tg.data, m * n)
    print(tag + " S3 m=" + str(m) + " T=" + str(T) + " base=" + str(vb) + " m4=" + str(vt)
          + " sp=" + str(vb / vt) + "x md=" + str(md)
          + " pack=" + str(ph[0]) + " run=" + str(ph[1]))
    return 0

# S5-like: A m×k(k=768), B n×k trans1, base = smm_dot_pd (sc out)
def _s5(m: 'i64', T: 'i64', tag: 'str') -> 'i64':
    k = 768
    n = 50257
    rs = 3
    A = t_zeros([m, k])
    B = t_zeros([n, k])
    sc = t_zeros([m, n])
    tg = t_zeros([m, n])
    _fill(A.data, m * k, 7)
    _fill(B.data, n * k, 8)
    vb = 1.0e18
    i = 0
    while i < rs:
        t0 = now_ms()
        rb = smm_dot_pd(A, B, m, n, k, sc.data)
        t1 = now_ms()
        if t1 - t0 < vb:
            vb = t1 - t0
        i = i + 1
    vt = 1.0e18
    ph: "list[f64]" = None
    i = 0
    while i < rs:
        ph = []
        t0 = now_ms()
        st = _m4(A, B, m, n, k, n, k, k, 1, T, tg.data, ph)
        t1 = now_ms()
        if t1 - t0 < vt:
            vt = t1 - t0
        i = i + 1
    md = _maxdiff(sc.data, tg.data, m * n)
    print(tag + " S5 m=" + str(m) + " T=" + str(T) + " base=" + str(vb) + " m4=" + str(vt)
          + " sp=" + str(vb / vt) + "x md=" + str(md)
          + " pack=" + str(ph[0]) + " run=" + str(ph[1]))
    return 0

# S1-like serial: A m×k(3072), B n(768)×k trans1, base = smm_dot
def _s1(m: 'i64', T: 'i64', tag: 'str') -> 'i64':
    k = 3072
    n = 768
    rs = 3
    A = t_zeros([m, k])
    B = t_zeros([n, k])
    sc = t_zeros([m, n])
    tg = t_zeros([m, n])
    _fill(A.data, m * k, 1)
    _fill(B.data, n * k, 2)
    vb = 1.0e18
    i = 0
    while i < rs:
        t0 = now_ms()
        rb = smm_dot(A, B, m, n, k)
        t1 = now_ms()
        if t1 - t0 < vb:
            vb = t1 - t0
        i = i + 1
    vt = 1.0e18
    ph: "list[f64]" = None
    i = 0
    while i < rs:
        ph = []
        t0 = now_ms()
        st = _m4(A, B, m, n, k, n, k, k, 1, T, tg.data, ph)
        t1 = now_ms()
        if t1 - t0 < vt:
            vt = t1 - t0
        i = i + 1
    md = _maxdiff(rb.data, tg.data, m * n)
    print(tag + " S1 m=" + str(m) + " T=" + str(T) + " base=" + str(vb) + " m4=" + str(vt)
          + " sp=" + str(vb / vt) + "x md=" + str(md)
          + " pack=" + str(ph[0]) + " run=" + str(ph[1]))
    return 0

def main() -> 'i32':
    print("CJ5: M4 f32 threshold (m=8/256/1024) + T sweep")
    _s3(8, 768, "(a)")
    _s3(256, 768, "(b)")
    _s3(256, 256, "(c)")
    _s5(8, 768, "(d)")
    _s5(256, 768, "(e)")
    _s5(256, 256, "(f)")
    _s1(8, 768, "(g)")
    _s1(256, 768, "(h)")
    _s1(256, 256, "(i)")
    print("CJ5 done")
    return 0