# TokenVector Module: Server — Dynamic micro-batcher with session pool
# Batch members run in parallel over a pool of sessions (one arena each):
# no shared-arena race and real concurrent throughput. Bounded queue with
# backpressure (enqueue raises ServerBusy instead of growing memory blindly).

import tv.runtime.session
import tv.numerics.tensor

# (2026-09-28) So lan quay toi da cho `enqueue` cho.
#
# `spawn(self._worker)` khong tao ra worker that (runtime .tkv hien tai chay
# single-thread), nen request duoc ghi vao queue roi khong bao gio duoc
# danh dau `done`. `_bch_spin_yield()` la stub return 0 => vong quay khong
# bao gio ket thuc va CPU chay 100%. Do do `stress_concurrent` trong
# compare_rivals.tkv treo vo han.
#
# Khi het han: chay chinh tai thread goi (inline fallback) de van tra ve
# ket qua. Neu worker that co chay, no xu ly req truoc khi het han nen
# duong "co worker" giu nguyen hanh vi micro-batching.
#
# Gioi han so LAN QUAY chu khong phai theo dong ho: `_bch_now_us()` cung la
# stub return 0, nen han thoi gian se luon ban.
_BCH_SPIN_LIMIT = 200000


def _bch_now_us() -> "i64":
    return 0


def _bch_spin_yield() -> "i32":
    return 0


class Cancelled(Exception):
    msg: "str"

class Infer(Exception):
    msg: "str"

class ServerBusy(Exception):
    msg: "str"

class BatchRequest:
    _ok: "i64"
    input: "list[f32]"
    done: "i32"
    cancelled: "i32"
    result: "list[f32]"
    error: "str"
    _claimed: "i32"
    def __init__(self, inp: "list[f32]"):
        self.input = inp
        self.done = 0
        self.cancelled = 0
        self.result = []
        self.error = ""
        # (2026-10-16) Co the worker thread VA duong inline trong `enqueue`
        # cung chay mot request tren cung mot session (pool chi co 1 phien tu,
        # arena dung chung) -> hong mem. `_claimed` dam phai mot ben giu lai.
        self._claimed = 0


class BatcherQueue:
    _ok: "i64"
    items: "list[BatchRequest]"
    def __init__(self):
        self.items = []
    def write(self, req: "BatchRequest") -> "i32":
        self.items.append(req)
        return 0
    def try_read(self) -> "BatchRequest":
        if len(self.items) == 0:
            # (2026-09-27) Code lai cho dung: sentinel done=1/cancelled=1
            # (worker bo qua), input rong mac dinh.
            _empty = BatchRequest([])
            _empty.done = 1
            _empty.cancelled = 1
            return _empty
        head = self.items[0]
        rest = []
        for i in range(1, len(self.items)):
            rest.append(self.items[i])
        self.items = rest
        return head
    def wait_read(self, timeout_ms: "i64") -> "BatchRequest":
        return self.try_read()
    def close(self) -> "i32":
        self.items = []
        return 0


class DynamicBatcher:
    _ok: "i64"
    max_batch: "i64"
    timeout_us: "i64"
    max_queue: "i64"
    pool: "list[InferenceSession]"
    queue: "BatcherQueue"
    queued: "i64"
    dropped_total: "i64"
    _closed: "i32"
    def __init__(self, session: "InferenceSession", max_batch: "i64" = 32, timeout_us: "i64" = 200, worker_count: "i64" = 4, max_queue: "i64" = 10000):
        self.max_batch = max(1, max_batch)
        self.timeout_us = timeout_us
        self.max_queue = max(1, max_queue)
        # pool[0] reuses the caller's (already optimized) session; the rest share
        # its optimized graph with their own arenas - graph is read-only during run.
        # NOTE: single-session pool (worker sessions need ctor support for
        # record-typed fields, chua co) - mo rong sau.
        self.pool = [session]
        self.queue = BatcherQueue(1)
        self.queued = 0
        self.dropped_total = 0
        self._closed = 0
# (2026-10-16) `spawn` da bi compiler moi bo; thay bang `thread_spawn`
        # (tra ve Task<T>). Khong giu handle duoc: compiler khong chap nhan
        # dtype 'thread' cho field cua record, va lenh goi co gia tri thi
        # phai gan bien. Worker chay fire-and-forget; `enqueue` van co duong
        # chay inline nen request van duoc xu ly ke worker co chay hay khong.
        _worker_task = thread_spawn(_batcher_worker_entry, self)

    def enqueue(self, inp: "list[f32]") -> "list[f32]":
        if self._closed:
            raise Disposed("DynamicBatcher")
        if self.queued >= self.max_queue:
            self.dropped_total = self.dropped_total + 1
            raise ServerBusy("batcher queue full. Retry later.")
        req = BatchRequest(inp)
        # (2026-10-16) Compiler moi: gan list vao field sau khi tao (`req.input
        # = inp`) lam field DO DAI dung nhung GIA TRI sai/None. Truyen `inp`
        # thang cho `.ctor` (`BatchRequest.__init__(self, inp)`).
        self.queued = self.queued + 1
        _ah63_8 = self.queue
        _ah63_8.write(req)
        _spins = 0
        while not req.done and not req.cancelled:
            _spins = _spins + 1
            if _spins >= _BCH_SPIN_LIMIT:
                # Khong worker nao chay request -> tu chay tai day thay vi treo.
                # Neu worker DA giu request (`_claimed`), `_run_one` se khong
                # chay lai; khi do phai CHO no xong chu duoc tra ve ket qua
                # rong/half-written.
                if len(self.pool) > 0:
                    _sess_inline = self.pool[0]
                    _run_one(req, _sess_inline)
                    _wait2 = 0
                    while not req.done and not req.cancelled and _wait2 < _BCH_SPIN_LIMIT * 8:
                        _wait2 = _wait2 + 1
                        _bch_spin_yield()
                break
            _bch_spin_yield()
        self.queued = self.queued - 1
        if req.cancelled:
            raise Cancelled("request cancelled while queued")
        if req.error != "":
            raise Infer(req.error)
        return req.result

    def cancel_all(self) -> 'i32':
        # best-effort drain: mark queued requests cancelled
        _wloop0 = 1
        while _wloop0:
            _ah76_18 = self.queue
            req = _ah76_18.try_read()
            if req.done and req.cancelled:
                break
            req.cancelled = 1
            self.queued = self.queued - 1
        return 0

    def _worker(self) -> 'i32':
        batch = []
        batch.append(BatchRequest([]))
        batch.pop()
        while not self._closed:
            _ah87_20 = self.queue
            first = _ah87_20.wait_read(50)
            if first.done and first.cancelled:
                continue
            if first.cancelled:
                self.queued = self.queued - 1
                continue
            batch.append(first)
            t0 = _bch_now_us()
            while len(batch) < self.max_batch and (_bch_now_us() - t0) < self.timeout_us:
                _ah96_22 = self.queue
                nxt = _ah96_22.try_read()
                if not (nxt.done and nxt.cancelled):
                    if nxt.cancelled:
                        self.queued = self.queued - 1
                    else:
                        batch.append(nxt)
                else:
                    _bch_spin_yield()
            self._exec_batch(batch)
            batch = []
            batch.append(BatchRequest([]))
            batch.pop()
        return 0

    def _exec_batch(self, batch: "list[BatchRequest]") -> 'i32':
        _nthread = len(self.pool)
        if _nthread <= 1:
            _nthread = 1
        for i in range(len(batch)):
            _sess = self.pool[i % _nthread]
            _run_one(batch[i], _sess)
        return 0

    def queue_depth(self) -> "i64":
        return self.queued

    def dispose(self) -> 'i32':
        self._closed = 1
        _ah120_8 = self.queue
        _ah120_8.close()
        return 0

def _run_one(req: "BatchRequest", session: "InferenceSession") -> "i32":
    if req.cancelled or req.done:
        return 0
    # (2026-10-16) Chi mot ben duoc chay request nay: worker thread va duong
    # fallback inline trong `enqueue` deu goi qua day tren cung mot session
    # (pool chi co 1 phien tu, arena dung chung) - chay song song se hong mem
    # va sinh loi "infer failed" rau rac.
    if req._claimed:
        return 0
    req._claimed = 1
    try:
        # (2026-10-16) `req.result = <list>` cung gan list vao field -> gia tri
        # sai. Copy phan tu vao list rong da khoi tao san trong `.ctor`.
        _out = session.run_single(req.input)
        for _oi in range(len(_out)):
            req.result.append(_out[_oi])
        req.done = 1
    except Exception as e:
        req.error = "infer failed"
        req.done = 1
    return 0


# (2026-10-16) `thread_spawn(fn)` chi nhan TEN ham (bien) va toi da 1 tham so;
# `self._worker` la method nen bi compiler phan giu la field khong ton tai.
# Voi vay can mot ham bao cap o cap module nham worker.
def _batcher_worker_entry(b: "DynamicBatcher") -> "i32":
    return b._worker()


# 2026-09-25: factory khoi tao DynamicBatcher.
# Compiler moi PHAI dung thu tu tham so cua `__init__`:
#   DynamicBatcher(session, max_batch, timeout_us, worker_count, max_queue)
# nen moi lai goi .ctor thay vi truyen 1 tham so cho MOI field.
def new_dynamic_batcher_with_session(session: "InferenceSession", max_batch: "i64",
                                     timeout_us: "i64", max_queue: "i64") -> "DynamicBatcher":
    # `__init__` da gan `pool = [session]` va `queue = BatcherQueue(1)`.
    return DynamicBatcher(session, max_batch, timeout_us, 4, max_queue)