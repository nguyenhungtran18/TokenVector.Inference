# PROBE CV — CO CHE KHONG THIET KE: GIU SCRATCH LIST TRONG FIELD CUA CLASS
#
# Boi canh: M3c wire can 1 buffer persistent [n*V] (logits, fwd) va 1 buffer
#   [V*h] (dwte, bwd). TKV KHONG cho phep gan lai bien module trong ham (§0.40)
#   -> buffer phai threading tu 1 object dai han. Carrier sach nhat = FIELD
#   cua class (TKV cho phep gan field — t_view / _PdJob / AdamW deu gan).
#
# CQ da chot kieu: scratch = t_zeros.data (List[Single]) + param "list[f32]".
# CV xac nhan TRUOC khi wire (ky luat §13.2):
#   CV1: class co field list; __init__ gan 1 list rong.
#   CV2: ham tu do (khong phai method) nhan object, gan field = list moi
#        (append), roi doc/ghi qua field do — khong crash, khong corruption.
#   CV3: field lam scratch cho _smm_cd nhu sc binh thuong — goi smm_dot_pd
#        2 lan, xac nhan lan 2 van BIT (khong bi stale/corrupt).
#
# Chay (tu goc repo):
#   D:/TokenVector/Release/dist/tkvc-tv.exe tv/tests/simd_probe_cv.tkv out/cv.exe main
#   out/cv.exe

import tv.training.tensor
import tv.training.simd_matmul

class _CvBox:
    sc5: "list[f32]"
    sc4: "list[f32]"
    def __init__(self):
        self.sc5 = []
        self.sc4 = []

def _cv_setup(b: "_CvBox", tot5: 'i64', tot4: 'i64') -> 'i64':
    # gan field = list moi (tu do function, khong phai method)
    s5 = []
    i = 0
    while i < tot5:
        s5.append((float(0) - 0.0) / 1.0)
        i = i + 1
    b.sc5 = s5
    s4 = []
    j = 0
    while j < tot4:
        s4.append((float(0) - 0.0) / 1.0)
        j = j + 1
    b.sc4 = s4
    return tot5 + tot4

def _cv_fill(d: "list[f32]", seed: 'i64') -> 'i64':
    n = len(d)
    i = 0
    while i < n:
        d[i] = (float(((i * 131 + seed) % 97) - 48) * 0.0021 - 0.0) / 1.0
        i = i + 1
    return n

def _cv_maxdiff(a: "list[f32]", b: "list[f32]", cnt: 'i64') -> 'f64':
    dmax = 0.0
    i = 0
    while i < cnt:
        e = a[i] - b[i]
        if e < 0.0:
            e = -e
        if e > dmax:
            dmax = e
        i = i + 1
    return dmax

def main() -> 'i32':
    nq = 1024
    h = 768
    V = 50257

    # CV1+CV2: tao box, gan field list qua ham tu do, doc/ghi qua field
    box = _CvBox()
    tot = _cv_setup(box, nq * V, V * h)
    n5 = len(box.sc5)
    n4 = len(box.sc4)
    box.sc5[0] = 1.5
    box.sc4[0] = 2.5
    v5 = box.sc5[0]
    v4 = box.sc4[0]
    ok12 = 0
    if n5 == nq * V:
        if n4 == V * h:
            if v5 == 1.5:
                if v4 == 2.5:
                    ok12 = 1
    print("CV1+2 box field: sc5.len=" + str(n5) + " sc4.len=" + str(n4)
          + " sc5[0]=" + str(v5) + " sc4[0]=" + str(v4)
          + " -> " + str(ok12) + " (1=PASS)")

    # CV3: field lam scratch cho smm_dot_pd — goi 2 lan, BIT vs t_zeros binh thuong
    A = t_zeros([nq, h])
    B = t_zeros([V, h])
    _cv_fill(A.data, 3)
    _cv_fill(B.data, 4)
    Cref = smm_dot_pd(A, B, nq, V, h)
    t0 = now_ms()
    C1 = smm_dot_pd(A, B, nq, V, h, box.sc5)
    t1 = now_ms()
    v_1 = t1 - t0
    t0 = now_ms()
    C2 = smm_dot_pd(A, B, nq, V, h, box.sc5)
    t1 = now_ms()
    v_2 = t1 - t0
    d1 = _cv_maxdiff(Cref.data, C1.data, nq * V)
    d2 = _cv_maxdiff(Cref.data, C2.data, nq * V)
    ok3 = 0
    if d1 == 0.0:
        if d2 == 0.0:
            ok3 = 1
    print("CV3 field-scratch smm_dot_pd: lan1=" + str(v_1) + " ms lan2="
          + str(v_2) + " ms MAXDIFF=" + str(d1) + "/" + str(d2)
          + " -> " + str(ok3) + " (1=PASS)")

    print("CV done")
    return 0
