import tv.runtime.session
import tv.numerics.tensor

class PagedKVPool:
    _ok: 'i64'
    num_pages: 'i64'
    page_len: 'i64'
    hidden_dim: 'i64'
    tick: 'i64'
    free: 'list[i64]'
    last_use: 'list[i64]'
    owner: 'dict[i64,i64]'

    def __init__(self, num_pages: 'i64', page_len: 'i64', hidden_dim: 'i64'):
        if num_pages <= 0 or page_len <= 0 or hidden_dim <= 0:
            raise Arg("num_pages/page_len/hidden_dim must be > 0")
        self.num_pages = num_pages
        self.page_len = page_len
        self.hidden_dim = hidden_dim
        _qx1000 = []
        for _qx1001 in range(num_pages):
            _qx1000.append(_qx1001)
        self.free = _qx1000
        self.last_use = []
        _zf38 = 0
        while _zf38 < num_pages:
            _ah29_12 = self.last_use
            _ah29_12.append(0)
            _zf38 = _zf38 + 1
        self.tick = 0
        self.owner = {}

    def free_count(self) -> 'i64':
        return len(self.free)

    def alloc_page(self, seq_id: 'i64') -> 'i64':
        self.tick = self.tick + 1
        if len(self.free) == 0:
            return -1
        free = self.free
        p = free[len(free) - 1]
        rest = []
        for i in range(len(free) - 1):
            rest.append(free[i])
        self.free = rest
        self.owner[p] = seq_id
        self.last_use[p] = self.tick
        return p

    def touch(self, page: 'i64') -> 'i32':
        self.tick = self.tick + 1
        self.last_use[page] = self.tick
        return 0

    def release_seq(self, seq_id: 'i64') -> 'i32':
        for p in self.owner:
            if self.owner[p] == seq_id:
                owner = self.owner
                owner.pop(p)
                _ah55_16 = self.free
                _ah55_16.append(p)
        return 0

    def evict_lru(self, spare: 'i64'=-1) -> 'i64':
        best = -1
        best_tick = -1
        for p in self.owner:
            if self.owner[p] == spare:
                continue
            if best < 0 or self.last_use[p] < best_tick:
                best = p
                best_tick = self.last_use[p]
        if best < 0:
            return -1
        owner2 = self.owner
        victim = owner2.pop(best)
        return (victim << 32) | best

    def reclaim(self, page: 'i64', seq_id: 'i64') -> 'i32':
        self.owner[page] = seq_id
        self.last_use[page] = self.tick
        return 0

class PagedSequence:
    _ok: 'i64'
    seq_id: 'i64'
    pages: 'list[i64]'
    tokens: 'i64'

    def __init__(self, seq_id: 'i64'):
        self.seq_id = seq_id
        self.pages = []
        self.tokens = 0

    def pages_needed(self, total_tokens: 'i64', page_len: 'i64') -> 'i64':
        return (total_tokens + page_len - 1) // page_len

    def ensure_capacity(self, pool: 'PagedKVPool', total_tokens: 'i64') -> 'i32':
        need = self.pages_needed(total_tokens, pool.page_len)
        while len(self.pages) < need:
            p = pool.alloc_page(self.seq_id)
            if p < 0:
                return 0
            _ah97_12 = self.pages
            _ah97_12.append(p)
            pool.touch(p)
        return 1

    def locate(self, pos: 'i64', page_len: 'i64') -> 'i64':
        return (self.pages[pos // page_len] << 32) | (pos % page_len)

class PrefixStore:
    _ok: 'i64'
    hidden_dim: 'i64'
    hits: 'i64'
    misses: 'i64'
    pages: 'dict[i64,list[f32]]'
    refs: 'dict[i64,i64]'

    def __init__(self, hidden_dim: 'i64'):
        self.hidden_dim = hidden_dim
        self.pages = {}
        self.refs = {}
        self.hits = 0
        self.misses = 0

    def block_hash(self, toks: 'list[i64]') -> 'i64':
        h = 1469598103934665603
        for t in toks:
            h = h * 1099511628211 + t
            h = h % 9223372036854775807
            h = h & 4294967295
        return h

    def intern(self, toks: 'list[i64]', page_len: 'i64') -> 'i64':
        h = self.block_hash(toks)
        if h in self.pages:
            self.refs[h] = self.refs[h] + 1
            self.hits = self.hits + 1
            return h
        self.pages[h] = _nd_f32(page_len * self.hidden_dim)
        self.refs[h] = 1
        self.misses = self.misses + 1
        return h

    def release(self, h: 'i64') -> 'i32':
        if h in self.refs:
            self.refs[h] = self.refs[h] - 1
            if self.refs[h] <= 0:
                _ah140_16 = self.refs
                _ah140_16.pop(h, 0)
                _ah141_16 = self.pages
                _ah141_16.pop(h, [])
        return 0

    def hit_rate(self) -> 'f64':
        tot = self.hits + self.misses
        if tot > 0:
            _c1 = float(self.hits) / tot
        else:
            _c1 = 0.0
        return _c1


def _paged_kv_probe() -> "i32":
    return 0
