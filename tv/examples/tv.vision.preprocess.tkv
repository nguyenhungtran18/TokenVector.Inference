import tv.runtime.session
import tv.numerics.tensor

def resize_bilinear_nhwc(x: 'list[f32]', h: 'i64', w: 'i64', c: 'i64', oh: 'i64', ow: 'i64') -> 'list[f32]':
    y = _nd_f32(oh * ow * c)
    sh = oh / h
    sw = ow / w
    for o in range(oh):
        sh_src = (o + 0.5) / sh - 0.5
        for u in range(ow):
            sw_src = (u + 0.5) / sw - 0.5
            h0 = int(sh_src)
            w0 = int(sw_src)
            fh = sh_src - h0
            fw = sw_src - w0
            if h0 < 0:
                h0 = 0
            if w0 < 0:
                w0 = 0
            if h0 + 1 < h:
                _c1 = h0 + 1
            else:
                _c1 = h0
            h1 = _c1
            if w0 + 1 < w:
                _c2 = w0 + 1
            else:
                _c2 = w0
            w1 = _c2
            for ch in range(c):
                v00 = x[(h0 * w + w0) * c + ch]
                v01 = x[(h0 * w + w1) * c + ch]
                v10 = x[(h1 * w + w0) * c + ch]
                v11 = x[(h1 * w + w1) * c + ch]
                y[(o * ow + u) * c + ch] = v00 * (1.0 - fh) * (1.0 - fw) + v01 * (1.0 - fh) * fw + v10 * fh * (1.0 - fw) + v11 * fh * fw
    return y

def normalize_inplace(x: 'list[f32]', mean: 'list[f32]', std: 'list[f32]', c: 'i64') -> 'i32':
    for i in range(len(x) // c):
        for ch in range(c):
            x[i * c + ch] = (x[i * c + ch] - mean[ch]) / std[ch]
    return 0

def hwc_to_chw(x: 'list[f32]', h: 'i64', w: 'i64', c: 'i64') -> 'list[f32]':
    y = _nd_f32(c * h * w)
    for r in range(h):
        for u in range(w):
            for ch in range(c):
                y[(ch * h + r) * w + u] = x[(r * w + u) * c + ch]
    return y

def patchify(x: 'list[f32]', h: 'i64', w: 'i64', c: 'i64', p: 'i64') -> 'list[f32]':
    if h % p != 0 or w % p != 0:
        raise Arg("H and W must be multiples of patch size")
    nh = h // p
    nw = w // p
    y = _nd_f32(nh * nw * p * p * c)
    for i in range(nh):
        for j in range(nw):
            for r in range(p):
                for u in range(p):
                    for ch in range(c):
                        y[(((i * nw + j) * p + r) * p + u) * c + ch] = x[((i * p + r) * w + (j * p + u)) * c + ch]
    return y
