// TokenVector Benchmark Suite — Competitor comparison (ORT vs LibTorch vs TokenVector)
// Ported from: benchmarks/TokenVector.Inference.Benchmarks/Program.cs +
//   ColdStart / Latency / GC / INT8-Throughput / StressTestRunner
// Run: tv run tv/benchmarks/compare_rivals.tv

module tv.benchmarks.compare_rivals

import tv.inference
import tv.runtime.session
import tv.runtime.execution_graph
import tv.runtime.execution_node
import tv.optimization.kernels
import tv.quantization.engine
import tv.quantization.matmul
import tv.numerics.tensor

# Reference numbers (measured .NET 8 Release, x86-64 AVX2+FMA).
# Kept as constants so CI can assert regression gates without native ORT/Torch installed.
const ORT_COLD_MS = 35.0
const TORCH_COLD_MS = 28.0
const ORT_LAT_US = 320.0
const TORCH_LAT_US = 410.0
const ORT_INT8_MS = 380.0
const TORCH_INT8_MS = 310.0

public def main():
    print("==========================================================================")
    print("  TokenVector.Inference (.tv) — Competitor Benchmark Suite                ")
    print("==========================================================================")
    cold = bench_cold_start()
    lat = bench_latency()
    gc = bench_gc()
    tp = bench_throughput()
    stress_hot()
    stress_concurrent()
    print("")
    print("--- COMPETITOR COMPARISON (lower is better, except RPS) ---")
    print(f"Cold-start parse+arena : TV {cold:.2f} ms | ORT {ORT_COLD_MS:.2f} ms | Torch {TORCH_COLD_MS:.2f} ms | {TORCH_COLD_MS/cold:.2f}x vs Torch")
    print(f"Single-sample FusedLinear 64x128 GELU: TV {lat:.2f} us | ORT {ORT_LAT_US:.2f} us | Torch {TORCH_LAT_US:.2f} us | {ORT_LAT_US/lat:.1f}x vs ORT")
    print(f"GC per 5k runs          : TV {gc} B (Zero-GC) | ORT >240KB | Torch interop overhead")
    print(f"INT8 2000 runs          : TV {tp[1]:.2f} ms | ORT {ORT_INT8_MS:.2f} ms | Torch {TORCH_INT8_MS:.2f} ms | {ORT_INT8_MS/tp[1]:.2f}x vs ORT")
    print("==========================================================================")
    print("  All .tv Benchmark & Stress Scenarios Executed Successfully!             ")
    print("==========================================================================")

def _tiny_graph(m: int, k: int, n: int, act: ActivationFunction) -> InferenceSession:
    g = ExecutionGraph("bench")
    g.inputs.append("X")
    g.outputs.append("Y")
    w = NDArray[float32]([n, k])
    b = NDArray[float32]([n])
    fill_rand(w, 42)
    fill_rand(b, 7)
    g.initializers["W"] = w
    g.initializers["B"] = b
    g.get_or_create_tensor("X", [1, k])
    g.get_or_create_tensor("W", w.shape)
    g.get_or_create_tensor("B", b.shape)
    g.get_or_create_tensor("Y", [1, n])
    node = ExecutionNode(f"gemm_{m}x{k}x{n}", OperatorType.FusedLinear)
    node.activation = act
    node.inputs.append("X"); node.inputs.append("W"); node.inputs.append("B")
    node.outputs.append("Y")
    g.nodes.append(node)
    return InferenceSession(g, True)

def bench_cold_start() -> float:
    t0 = now_ms()
    s = _tiny_graph(1, 32, 64, ActivationFunction.ReLU)
    dt = now_ms() - t0
    print(f"[1/4] Cold-start & arena alloc: {dt * 1000:.2f} us (gate: <2.5x ORT)")
    s.close()
    return dt

def bench_latency() -> float:
    s = _tiny_graph(1, 64, 128, ActivationFunction.GELU)
    x = NDArray[float32]([1, 64])
    fill_const(x, 1.0)
    for i in range(1000):
        s.run_single(x)
    iters = 10000
    t0 = now_us()
    for i in range(iters):
        s.run_single(x)
    avg = float(now_us() - t0) / iters
    print(f"[2/4] Single-sample FusedLinear 64x128 GELU: {avg:.3f} us (gate: <1ms)")
    s.close()
    return avg

def bench_gc() -> int:
    s = _tiny_graph(1, 64, 64, ActivationFunction.ReLU)
    x = NDArray[float32]([1, 64])
    for i in range(500):
        s.run_single(x)
    gc_collect()
    b0 = gc_allocated_bytes()
    for i in range(5000):
        s.run_single(x)
    used = gc_allocated_bytes() - b0
    print(f"[3/4] Heap per 5k inferences: {used} B (gate: 0 B Zero-GC)")
    s.close()
    return used

def bench_throughput() -> tuple[float, float]:
    # FP32 fused vs INT8 symmetric, M=16 K=256 N=256 x2000 (mirrors Program.cs)
    m = 16; k = 256; n = 256
    iters = 2000
    xf = NDArray[float32]([m, k]); wf = NDArray[float32]([n, k]); yf = NDArray[float32]([m, n])
    fill_rand(xf, 1); fill_rand(wf, 2)
    t0 = now_ms()
    for i in range(iters):
        kernels.fused_matmul_bias_act(ptr_of(xf), ptr_of(wf), 0, ptr_of(yf), m, n, k, ActivationFunction.None, True)
    fp32_ms = now_ms() - t0
    p = engine.calibrate_minmax(xf, True)
    xi = NDArray[int8]([m, k]); wi = NDArray[int8]([n, k])
    engine.quantize_int8_symmetric(xf, xi, p.scale)
    engine.quantize_int8_symmetric(wf, wi, p.scale)
    t1 = now_ms()
    for i in range(iters):
        matmul.matmul_int8_symmetric(ptr_of(xi), ptr_of(wi), 0, ptr_of(yf), m, n, k, p.scale, p.scale)
    int8_ms = now_ms() - t1
    print(f"[4/4] FP32 {fp32_ms:.2f} ms | INT8 {int8_ms:.2f} ms | speedup {fp32_ms/max(int8_ms,1e-9):.2f}x (gate: >=2.8x)")
    return (fp32_ms, int8_ms)

def stress_hot():
    # 250k continuous runs — endurance / leak gate
    s = _tiny_graph(1, 64, 64, ActivationFunction.ReLU)
    x = NDArray[float32]([1, 64])
    n = 250000
    t0 = now_ms()
    for i in range(n):
        s.run_single(x)
    dt = (now_ms() - t0) / 1000.0
    rps = n / max(dt, 1e-9)
    print(f"[stress] Hot-path endurance {n} runs: {rps:.0f} req/s, GC {gc_counts()} (gate: 0/0/0)")
    s.close()

def stress_concurrent():
    # 32 workers x 10k burst via DynamicBatcher
    s = _tiny_graph(1, 64, 64, ActivationFunction.ReLU)
    b = DynamicBatcher(s, 32, 200)
    x = NDArray[float32]([1, 64])
    n = 10000
    t0 = now_ms()
    parallel_for(n, num_workers=32, fn=lambda i: b.enqueue(x))
    dt = (now_ms() - t0) / 1000.0
    print(f"[stress] Concurrent 32T/{n} burst: {n/max(dt,1e-9):.0f} req/s (gate: 0 dropped)")
    b.dispose()
    s.close()

extern def now_ms() -> float
extern def now_us() -> int
extern def fill_rand(a: NDArray[float32], seed: int)
extern def fill_const(a: NDArray[float32], v: float32)
extern def ptr_of(a: NDArray) -> int
extern def gc_collect()
extern def gc_allocated_bytes() -> int
extern def gc_counts() -> str
extern def parallel_for(n: int, num_workers: int, fn: func(int))
