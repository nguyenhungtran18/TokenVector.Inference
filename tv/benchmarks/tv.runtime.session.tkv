class ExecutionNode:
    _ok: 'i64'
    id: 'i64'
    name: 'str'
    op_type: 'i64'
    inputs: 'list[str]'
    outputs: 'list[str]'
    input_descs: 'list[TensorDesc]'
    output_descs: 'list[TensorDesc]'
    activation: 'i64'
    alpha: 'f32'
    beta: 'f32'
    epsilon: 'f32'
    trans_a: 'i64'
    trans_b: 'i64'
    strides: 'list[i64]'
    pads: 'list[i64]'
    perm: 'list[i64]'
    axis: 'i64'
    axes: 'list[i64]'
    keepdims: 'i64'
    kernel_shape: 'list[i64]'
    clip_min: 'f32'
    clip_max: 'f32'
    tri_upper: 'i64'
    tri_k: 'i64'
    topk_largest: 'i64'
    topk_sorted: 'i64'
    qlinear_axis: 'i64'
    cum_exclusive: 'i64'
    cum_reverse: 'i64'
    prelu_slope: 'f32'
    const_fill: 'f32'
    eq: 'str'
    rs_mode: 'i64'
    rs_ctm: 'i64'
    rs_nearest: 'i64'
    scale_a: 'f32'
    scale_b: 'f32'
    scale_y: 'f32'
    zp_a: 'i64'
    zp_b: 'i64'
    zp_y: 'i64'
    scales_w: 'list[f32]'
    num_heads: 'i64'
    num_kv_heads: 'i64'
    causal: 'i64'
    attn_scale_override: 'f32'
    kv_offset: 'i64'

    def __init__(self, name: 'str', op: 'i64'):
        self.id = -1
        self.name = name
        self.op_type = op
        self.inputs = []
        self.outputs = []
        self.input_descs = []
        self.output_descs = []
        self.activation = ActivationFunction_None
        self.alpha = 1.0
        self.beta = 1.0
        self.epsilon = 0.00001
        self.trans_a = 0
        self.trans_b = 0
        # (2026-09-26) Ba list nay PHAI la list[i64], khong phai literal.
        #
        # `[1, 1]` / `[0, 0, 0, 0]` / `[]` tao `List<TkvInt>` (TkvInt = so
        # nguyen vo han chu so) trong khi khai bao field la 'list[i64]'.
        # TokenVector KHONG kiem tra kieu phan tu khi gan -> kernel doc
        # `self.strides[0]` nhu mot TkvInt struct thay vi int64, doc ra gia
        # tri rac. `_nd_i64(n)` tao san list[i64] DUNG do dai.
        self.strides = _nd_i64(2)
        self.strides[0] = 1
        self.strides[1] = 1
        self.pads = _nd_i64(4)
        self.pads[0] = 0
        self.pads[1] = 0
        self.pads[2] = 0
        self.pads[3] = 0
        self.perm = _nd_i64(0)
        self.axis = -1
        self.axes = []
        self.keepdims = 1
        self.kernel_shape = []
        self.clip_min = -340000000000000000000000000000000000000
        self.clip_max = 340000000000000000000000000000000000000
        self.tri_upper = 0
        self.tri_k = 0
        self.topk_largest = 1
        self.topk_sorted = 1
        self.qlinear_axis = 1
        self.cum_exclusive = 0
        self.cum_reverse = 0
        self.prelu_slope = 0.25
        self.const_fill = 0.0
        self.eq = ""
        self.rs_mode = 0
        self.rs_ctm = 0
        self.rs_nearest = 0
        self.scale_a = 1.0
        self.scale_b = 1.0
        self.scale_y = 1.0
        self.zp_a = 0
        self.zp_b = 0
        self.zp_y = 0
        self.scales_w = []
        self.num_heads = 0
        self.num_kv_heads = 0
        self.causal = 0
        self.attn_scale_override = 0.0
        self.kv_offset = 0

    def execute(self, arena: 'ExecutionMemoryArena') -> 'i32':
        op = self.op_type
        if op == OperatorType_FusedLinear or op == OperatorType_MatMul:
            self._exec_linear(arena)
        elif op == OperatorType_Gemm:
            self._exec_gemm(arena)
        elif op == OperatorType_FusedConv2D or op == OperatorType_Conv2D:
            self._exec_conv2d(arena)
        elif op == OperatorType_RMSNorm:
            self._exec_rms_norm(arena)
        elif op == OperatorType_LayerNorm:
            self._exec_layer_norm(arena)
        elif op == OperatorType_Relu:
            self._exec_unary(arena, ActivationFunction_ReLU)
        elif op == OperatorType_Gelu:
            self._exec_unary(arena, ActivationFunction_GELU)
        elif op == OperatorType_Silu:
            self._exec_unary(arena, ActivationFunction_SiLU)
        elif op == OperatorType_Sigmoid:
            self._exec_unary(arena, ActivationFunction_Sigmoid)
        elif op == OperatorType_Tanh:
            self._exec_unary(arena, ActivationFunction_Tanh)
        elif op == OperatorType_LeakyRelu:
            self._exec_leaky(arena)
        elif op == OperatorType_Elu:
            self._exec_elu(arena)
        elif op == OperatorType_Softplus:
            self._exec_softplus(arena)
        elif op == OperatorType_Sqrt:
            self._exec_unary_math(arena, 0)
        elif op == OperatorType_Exp:
            self._exec_unary_math(arena, 1)
        elif op == OperatorType_Log:
            self._exec_unary_math(arena, 2)
        elif op == OperatorType_Neg:
            self._exec_unary_math(arena, 3)
        elif op == OperatorType_Reciprocal:
            self._exec_unary_math(arena, 4)
        elif op == OperatorType_Abs:
            self._exec_unary_math(arena, 5)
        elif op == OperatorType_Add:
            self._exec_binary(arena, BinaryOp_Add)
        elif op == OperatorType_Sub:
            self._exec_binary(arena, BinaryOp_Sub)
        elif op == OperatorType_Mul:
            self._exec_binary(arena, BinaryOp_Mul)
        elif op == OperatorType_Div:
            self._exec_binary(arena, BinaryOp_Div)
        elif op == OperatorType_Pow:
            self._exec_pow(arena)
        elif op == OperatorType_Min:
            self._exec_variadic(arena, 0)
        elif op == OperatorType_Max:
            self._exec_variadic(arena, 1)
        elif op == OperatorType_Mean:
            self._exec_variadic(arena, 2)
        elif op == OperatorType_Sum:
            self._exec_variadic(arena, 3)
        elif op == OperatorType_Where:
            self._exec_where(arena)
        elif op == OperatorType_Clip:
            self._exec_clip(arena)
        elif op == OperatorType_Softmax:
            self._exec_softmax(arena)
        elif op == OperatorType_LogSoftmax:
            self._exec_log_softmax(arena)
        elif op == OperatorType_Trilu:
            self._exec_trilu(arena)
        elif op == OperatorType_TopK:
            self._exec_topk(arena)
        elif op == OperatorType_QuantizeLinear:
            self._exec_quantize_linear(arena)
        elif op == OperatorType_DequantizeLinear:
            self._exec_dequantize_linear(arena)
        elif op == OperatorType_QLinearMatMul:
            self._exec_qlinear_matmul(arena)
        elif op == OperatorType_GatherND:
            self._exec_gather_nd(arena)
        elif op == OperatorType_ScatterElements:
            self._exec_scatter(arena)
        elif op == OperatorType_Range:
            self._exec_range(arena)
        elif op == OperatorType_EyeLike:
            self._exec_eye_like(arena)
        elif op == OperatorType_ConstantOfShape:
            self._exec_const_of_shape(arena)
        elif op == OperatorType_CumSum:
            self._exec_cumsum(arena)
        elif op == OperatorType_InstanceNormalization:
            self._exec_instance_norm(arena)
        elif op == OperatorType_Mish:
            self._exec_mish(arena)
        elif op == OperatorType_PRelu:
            self._exec_prelu(arena)
        elif op == OperatorType_Resize:
            self._exec_resize(arena)
        elif op == OperatorType_Einsum:
            self._exec_einsum(arena)
        elif op == OperatorType_QLinearConv:
            self._exec_qlinear_conv(arena)
        elif op == OperatorType_MatMulInteger:
            self._exec_matmul_integer(arena)
        elif op == OperatorType_DynamicQuantizeLinear:
            self._exec_dyn_quant(arena)
        elif op == OperatorType_Attention:
            self._exec_attention(arena)
        elif op == OperatorType_QuantizedGemm:
            _ah585_37 = self.input_descs[0]
            _ah585_65 = self.input_descs[0]
            aq = arena.get_int8_span(_ah585_37.offset, _ah585_65.element_count)
            _ah586_37 = self.input_descs[1]
            _ah586_65 = self.input_descs[1]
            wq = arena.get_int8_span(_ah586_37.offset, _ah586_65.element_count)
            _ah587_38 = self.output_descs[0]
            _ah587_67 = self.output_descs[0]
            yf = arena.get_float_span(_ah587_38.offset, _ah587_67.element_count)
            if len(self.input_descs) > 2:
                _ah589_42 = self.input_descs[2]
                _ah589_70 = self.input_descs[2]
                bf = arena.get_float_span(_ah589_42.offset, _ah589_70.element_count)
            else:
                bf = _nd_f32(0)
            if len(self.scales_w) > 0:
                matmul_int8_per_channel(aq, wq, bf, yf, self._m(), self._n_gemm(), self._k_gemm(), self.scale_a, self.scales_w)
            else:
                matmul_int8_symmetric(aq, wq, bf, yf, self._m(), self._n_gemm(), self._k_gemm(), self.scale_a, self.scale_b)
        elif op == OperatorType_Gather:
            self._exec_gather(arena)
        elif op == OperatorType_Slice:
            self._exec_slice(arena)
        elif op == OperatorType_Split:
            self._exec_split(arena)
        elif op == OperatorType_Expand:
            self._exec_expand(arena)
        elif op == OperatorType_ReduceMean:
            self._exec_reduce(arena, 0)
        elif op == OperatorType_ReduceSum:
            self._exec_reduce(arena, 1)
        elif op == OperatorType_ReduceMax:
            self._exec_reduce(arena, 2)
        elif op == OperatorType_GlobalAveragePool:
            self._exec_gap(arena)
        elif op == OperatorType_MaxPool:
            self._exec_pool(arena, 1)
        elif op == OperatorType_AveragePool:
