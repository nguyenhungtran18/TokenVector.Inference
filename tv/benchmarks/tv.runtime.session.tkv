def named_tensor(name: 'str', data: 'list[f32]') -> 'NamedTensor':
    t = NamedTensor(1, name)
    t.data = data
    t.qdata = []
    t.idata = []
    return t

def named_qdata(name: 'str', qdata: 'list[i32]') -> 'NamedTensor':
    t = NamedTensor(1, name)
    t.data = []
    t.qdata = qdata
    t.idata = []
    return t

def named_idata(name: 'str', idata: 'list[i64]') -> 'NamedTensor':
    t = NamedTensor(1, name)
    t.data = []
    t.qdata = []
    t.idata = idata
    return t

def session_from_graph(graph: 'ExecutionGraph', apply_optimizations: 'i32') -> 'InferenceSession':
    provider = default_cpu()
    require(provider)
    if apply_optimizations:
        p1 = ConstantFoldingPass(1)
        p1.run(graph)
        p2 = QdqFoldPass(1)
        p2.run(graph)
        p3 = OperatorFusionPass(1)
        p3.run(graph)
        p4 = DeadCodeEliminationPass(1)
        p4.run(graph)
    graph.analyze_liveness_and_allocate_offsets()
    arena = arena_create(graph.total_arena_bytes)
    graph.initialize_weights(arena)
    return InferenceSession(1, provider, graph, arena, 0)

# ===== optimization.passes (merged: cycle passes<->session) =====
class IGraphPass:
    _ok: 'i64'

    def name(self) -> 'str':
        return ""

    def run(self, graph: 'ExecutionGraph') -> 'i32':
        return 0

class ConstantFoldingPass(IGraphPass):

    def name(self) -> 'str':
        return "ConstantFoldingPass"

    def run(self, graph: 'ExecutionGraph') -> 'i32':
        modified = 0
        doomed = []
        for _ni in range(len(graph.nodes)):
            node = graph.nodes[_ni]
            all_const = len(node.inputs) > 0
            for nm in node.inputs:
                if nm not in graph.initializers:
                    all_const = 0
                    break
            if not all_const or len(node.outputs) == 0:
                continue
            out_name = node.outputs[0]
            sdesc = graph.tensors[node.inputs[0]]
            src = graph.initializers[node.inputs[0]]
            if node.op_type == OperatorType_Transpose and len(sdesc.shape) == 2:
                folded = _nd_f32([sdesc.shape[1], sdesc.shape[0]])
                for r in range(sdesc.shape[0]):
                    for c in range(sdesc.shape[1]):
                        folded[c * sdesc.shape[0] + r] = src[r * sdesc.shape[1] + c]
                graph.initializers[out_name] = folded
                doomed.append(_ni)
                modified = 1
            elif node.op_type == OperatorType_Reshape:
                if out_name in graph.tensors:
                    desc = graph.tensors[out_name]
                    folded = _nd_f32(desc.shape)
                    _nsrc = len(src)
                    _nfold = len(folded)
                    n = min(_nsrc, _nfold)
                    for i in range(n):
                        folded[i] = src[i]
                    graph.initializers[out_name] = folded
                    doomed.append(_ni)
                    modified = 1
        _dd = 0
        _keep = []
        for _ki in range(len(graph.nodes)):
            if _dd < len(doomed) and _ki == doomed[_dd]:
                _dd = _dd + 1
            else:
                _keep.append(graph.nodes[_ki])
        graph.nodes = _keep
        return modified

class OperatorFusionPass(IGraphPass):

    def name(self) -> 'str':
        return "OperatorFusionPass"

    def run(self, graph: 'ExecutionGraph') -> 'i32':
        modified = 0
        i = 0
        while i < len(graph.nodes) - 1:
            n1 = graph.nodes[i]
            n2 = graph.nodes[i + 1]
            fused = 0
            if n1.op_type == OperatorType_MatMul and n2.op_type == OperatorType_Add and (len(n1.outputs) > 0):
                inter = n1.outputs[0]
                if len(n2.inputs) >= 2 and (n2.inputs[0] == inter or n2.inputs[1] == inter):
                    if n2.inputs[0] == inter:
                        _c1 = n2.inputs[1]
                    else:
                        _c1 = n2.inputs[0]
                    bias = _c1
                    if bias in graph.initializers:
                        n1.op_type = OperatorType_FusedLinear
                        _ah3039_24 = n1.inputs
                        _ah3039_24.append(bias)
                        n1.outputs[0] = n2.outputs[0]
                        _ah3041_24 = graph.nodes
                        _ah3041_24.pop(i + 1)
                        modified = 1
                        fused = 1
            if not fused:
                i = i + 1
        i = 0
        while i < len(graph.nodes) - 1:
            n1 = graph.nodes[i]
            n2 = graph.nodes[i + 1]
            fused = 0
            if (n1.op_type == OperatorType_FusedLinear or n1.op_type == OperatorType_MatMul) and (n2.op_type == OperatorType_Relu or n2.op_type == OperatorType_Gelu or n2.op_type == OperatorType_Silu or (n2.op_type == OperatorType_Sigmoid) or (n2.op_type == OperatorType_Tanh)):
                if len(n1.outputs) > 0 and len(n2.inputs) > 0 and (n1.outputs[0] == n2.inputs[0]):
                    n1.op_type = OperatorType_FusedLinear
                    if n2.op_type == OperatorType_Relu:
                        n1.activation = ActivationFunction_ReLU
                    elif n2.op_type == OperatorType_Gelu:
                        n1.activation = ActivationFunction_GELU
                    elif n2.op_type == OperatorType_Silu:
                        n1.activation = ActivationFunction_SiLU
                    elif n2.op_type == OperatorType_Sigmoid:
                        n1.activation = ActivationFunction_Sigmoid
                    elif n2.op_type == OperatorType_Tanh:
                        n1.activation = ActivationFunction_Tanh
                    n1.outputs[0] = n2.outputs[0]
                    _ah3065_20 = graph.nodes
                    _ah3065_20.pop(i + 1)
                    modified = 1
                    fused = 1
            if not fused:
                i = i + 1
        i = 0
        while i < len(graph.nodes) - 1:
            n1 = graph.nodes[i]
            n2 = graph.nodes[i + 1]
            fused = 0
            if n1.op_type == OperatorType_Conv2D and n2.op_type == OperatorType_Relu:
                if len(n1.outputs) > 0 and len(n2.inputs) > 0 and (n1.outputs[0] == n2.inputs[0]):
                    n1.op_type = OperatorType_FusedConv2D
                    n1.outputs[0] = n2.outputs[0]
                    _ah3079_20 = graph.nodes
                    _ah3079_20.pop(i + 1)
                    modified = 1
                    fused = 1
            if not fused:
                i = i + 1
        return modified

class QdqFoldPass(IGraphPass):

    def name(self) -> 'str':
        return "QdqFoldPass"

    def run(self, graph: 'ExecutionGraph') -> 'i32':
        modified = 0
        i = 0
        while i < len(graph.nodes):
            node = graph.nodes[i]
            if node.op_type == OperatorType_QuantizeLinear and len(node.outputs) == 1:
                if i + 1 < len(graph.nodes):
                    nxt = graph.nodes[i + 1]
                    if nxt.op_type == OperatorType_DequantizeLinear and len(nxt.inputs) > 0 and (nxt.inputs[0] == node.outputs[0]) and (len(nxt.outputs) == 1):
                        orig = node.inputs[0]
                        dead = nxt.outputs[0]
                        for nd in graph.nodes:
                            for k in range(len(nd.inputs)):
                                if nd.inputs[k] == dead:
                                    nd.inputs[k] = orig
                        for o in range(len(graph.outputs)):
                            if graph.outputs[o] == dead:
                                graph.outputs[o] = orig
                        _ah3109_24 = graph.nodes
                        _ah3109_24.pop(i + 1)
                        _ah3110_24 = graph.nodes
                        _ah3110_24.pop(i)
                        modified = 1
                        continue
            i = i + 1
        return modified

class DeadCodeEliminationPass(IGraphPass):

    def name(self) -> 'str':
        return "DeadCodeEliminationPass"

    def run(self, graph: 'ExecutionGraph') -> 'i32':
        orig = len(graph.nodes)
        required = {}
        for _o in graph.outputs:
            required[_o] = 1
        active = {}
        changed = 1
        while changed:
            changed = 0
            i = len(graph.nodes) - 1
            while i > -1:
                if i in active:
                    continue
                node = graph.nodes[i]
                hit = 0
                for o in node.outputs:
                    if o in required:
                        hit = 1
                        break
                if hit:
                    active[i] = 1
                    for nm in node.inputs:
                        if nm not in required:
                            required[nm] = 1
                            changed = 1
                i = i + -1
        _qx1000 = []
        for i in range(len(graph.nodes)):
            if i not in active:
                _qx1000.append(graph.nodes[i])
        graph.nodes = _qx1000
        dead = []
        _tensor_keys = graph.tensors.keys()
        for nm in _tensor_keys:
            if nm not in required and nm not in graph.inputs and (nm not in graph.outputs):
                dead.append(nm)
        for nm in dead:
            graph.tensors.pop(nm, make_tensor_desc(nm, [], 1))
            if nm in graph.initializers:
                graph.initializers.pop(nm, [])
        return len(graph.nodes) < orig
