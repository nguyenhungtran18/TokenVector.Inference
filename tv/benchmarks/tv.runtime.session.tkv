class Disposed(Exception):
    msg: 'str'

class NotFound(Exception):
    msg: 'str'

class NamedTensor:
    _ok: 'i64'
    name: 'str'
    data: 'list[f32]'
    qdata: 'list[i32]'
    idata: 'list[i64]'

    def __init__(self, name: 'str', data: 'list[f32]', qdata: 'list[i32]', idata: 'list[i64]'):
        self.name = name
        self.data = data
        self.qdata = qdata
        self.idata = idata

class InferenceSession:
    _ok: 'i64'
    provider: 'ExecutionProvider'
    graph: 'ExecutionGraph'
    arena: 'ExecutionMemoryArena'
    _disposed: 'i64'

    def __init__(self, graph: 'ExecutionGraph', apply_optimizations: 'i32'=1):
        _c1 = default_cpu()
        self.provider = _c1
        require(self.provider)
        self.graph = graph
        if apply_optimizations:
            p1 = ConstantFoldingPass(1)
            p1.run(graph)
            p2 = QdqFoldPass(1)
            p2.run(graph)
            p3 = OperatorFusionPass(1)
            p3.run(graph)
            p4 = DeadCodeEliminationPass(1)
            p4.run(graph)
        graph.analyze_liveness_and_allocate_offsets()
        self.arena = arena_create(graph.total_arena_bytes)
        graph.bind_tensors(self.arena)
        graph.initialize_weights(self.arena)
        self._disposed = 0

    def run(self, inputs: 'list[NamedTensor]', outputs: 'list[NamedTensor]') -> 'i32':
        gr = self.graph
        if self._disposed:
            raise Disposed("InferenceSession")
        for inp in inputs:
            if inp.name in gr.tensors:
                desc = gr.tensors[inp.name]
                if len(inp.qdata) > 0:
                    _ah2753_20 = self.arena
                    _ah2753_20.copy_from_int8(desc.offset, inp.qdata)
                elif len(inp.idata) > 0:
                    _ah2755_20 = self.arena
                    _ah2755_20.copy_from_int32(desc.offset, inp.idata)
                else:
                    _ah2757_20 = self.arena
                    _ah2757_20.copy_from(desc.offset, inp.data)
        for node in gr.nodes:
            if node.op_type == OperatorType_StringConcat or node.op_type == OperatorType_StringEqual or node.op_type == OperatorType_StringLength:
                self._exec_string_node(node)
            else:
                node.execute(self.arena)
        for out in outputs:
            if out.name in gr.tensors:
                desc = gr.tensors[out.name]
                if len(out.qdata) > 0:
                    _ah2767_20 = self.arena
                    _ah2767_20.copy_to_int8(desc.offset, out.qdata)
                elif len(out.idata) > 0:
