# ===== device (merged) =====
class Arg(Exception):
    msg: "str"

class Unavailable(Exception):
    msg: "str"


class ExecutionProvider:
    _ok: "i64"
    def name(self) -> "str":
        return ""
    def kind(self) -> "i64":
        return 0
    def available(self) -> "i32":
        return 0
    def unavailable_reason(self) -> "str":
        return ""


# enum -> module constants
DeviceKind_CPU = 0
DeviceKind_CUDA = 1
DeviceKind_ROCM = 2
DeviceKind_METAL = 3
DeviceKind_VULKAN = 4
DeviceKind_NPU = 5

class CpuProvider(ExecutionProvider):
    def __init__(self):
        self._ok = 1
    def name(self) -> "str":
        return "TokenVectorCPU"
    def kind(self) -> "i64":
        return DeviceKind_CPU
    def available(self) -> "i32":
        return 1
    def unavailable_reason(self) -> "str":
        return ""

class AcceleratorStub(ExecutionProvider):
    _kind: 'i64'
    _reason: 'str'
    def __init__(self, kind: "i64", reason: "str"):
        self._kind = kind
        self._reason = reason

    def name(self) -> "str":
        if self._kind == DeviceKind_CUDA:
            return "TokenVectorCUDA"
        if self._kind == DeviceKind_ROCM:
            return "TokenVectorROCM"
        if self._kind == DeviceKind_METAL:
            return "TokenVectorMetal"
        if self._kind == DeviceKind_VULKAN:
            return "TokenVectorVulkan"
        return "TokenVectorNPU"

    def kind(self) -> "i64":
        return self._kind
    def available(self) -> "i32":
        return 0
    def unavailable_reason(self) -> "str":
        return self._reason

def default_cpu() -> "ExecutionProvider":
    return CpuProvider(1)

def require(provider: "ExecutionProvider") -> "i32":
    if not provider.available():
        raise Unavailable("execution provider '" + str(provider.name()) + "' unavailable: " + str(provider.unavailable_reason()) + "")
    return 0

# ===== memory_arena (merged) =====
# TokenVector Module: Runtime — Memory Arena (Zero-GC scratchpad)
# 64-byte aligned unmanaged arena with tensor liveness reuse.
# This module owns lifetime + safe slice API.




class OutOfRange(Exception):
    msg: "str"


class ExecutionMemoryArena:
    _ok: "i64"
    size_in_bytes: 'i64'
    handle: 'i64'
    fmap: 'dict[i64,list[f32]]'
    qmap: 'dict[i64,list[i32]]'
    imap: 'dict[i64,list[i64]]'
    def __init__(self, size_in_bytes: "i64"):
        if size_in_bytes == 0:
            size_in_bytes = 64
        # Align up to 64 bytes (AVX2 / AVX-512)
        size_in_bytes = (size_in_bytes + 63) // 64 * 64
        self.size_in_bytes = size_in_bytes
        self.handle = native_arena_alloc(size_in_bytes)
        self.fmap = {}
        self.qmap = {}
        self.imap = {}

    # List-backed buffers: a .tkv 'list' is a reference type, so handing the
    # same list object back to every get_*_span(offset, ...) makes writes
    # performed by ExecutionNode.execute() visible to later readers. Offsets
    # keep the same liveness/scratchpad-reuse semantics as the flat arena.
    def _grow_f(self, off: "i64", count: "i64") -> "list[f32]":
        if off in self.fmap:
            cur = self.fmap[off]
            if len(cur) >= count:
                return cur
            big = _nd_f32(count)
            for i in range(len(cur)):
                big[i] = cur[i]
            self.fmap[off] = big
            return big
        fresh = _nd_f32(count)
        self.fmap[off] = fresh
        return fresh

    def _grow_q(self, off: "i64", count: "i64") -> "list[i32]":
        if off in self.qmap:
            cur = self.qmap[off]
            if len(cur) >= count:
                return cur
            big = _nd_i8(count)
            for i in range(len(cur)):
                big[i] = cur[i]
            self.qmap[off] = big
            return big
        fresh = _nd_i8(count)
        self.qmap[off] = fresh
        return fresh

    def _grow_i(self, off: "i64", count: "i64") -> "list[i64]":
        if off in self.imap:
            cur = self.imap[off]
            if len(cur) >= count:
                return cur
            big = _nd_i64(count)
            for i in range(len(cur)):
                big[i] = cur[i]
            self.imap[off] = big
            return big
        fresh = _nd_i64(count)
        self.imap[off] = fresh
        return fresh

    def bind(self, byte_offset: "i64", count: "i64", dtype: "i64") -> 'i32':
        if dtype == 3:
            _ah = self._grow_q(byte_offset, count)
        elif dtype == 6:
            _ah2 = self._grow_i(byte_offset, count)
        else:
            _ah3 = self._grow_f(byte_offset, count)
        return 0

    def get_float_span(self, byte_offset: "i64", count: "i64") -> "list[f32]":
        return self._grow_f(byte_offset, count)

    # Pure .tkv copies through zero-copy views (no host memmove dependency)
    def copy_from(self, byte_offset: "i64", src: "list[f32]") -> 'i32':
        dst = self.get_float_span(byte_offset, len(src))
        for i in range(len(src)):
            dst[i] = src[i]
        return 0

    def copy_to(self, byte_offset: "i64", dst: "list[f32]") -> 'i32':
        src = self.get_float_span(byte_offset, len(dst))
        for i in range(len(dst)):
            dst[i] = src[i]
        return 0

    def copy_from_int8(self, byte_offset: "i64", src: "list[i32]") -> 'i32':
        dst = self.get_int8_span(byte_offset, len(src))
        for i in range(len(src)):
            dst[i] = src[i]
        return 0

    def copy_to_int8(self, byte_offset: "i64", dst: "list[i32]") -> 'i32':
        src = self.get_int8_span(byte_offset, len(dst))
        for i in range(len(dst)):
            dst[i] = src[i]
        return 0

    def copy_from_int32(self, byte_offset: "i64", src: "list[i64]") -> 'i32':
        dst = self.get_int32_span(byte_offset, len(src))
        for i in range(len(dst)):
            dst[i] = src[i]
        return 0

    def copy_to_int32(self, byte_offset: "i64", dst: "list[i64]") -> 'i32':
        src = self.get_int32_span(byte_offset, len(dst))
        for i in range(len(dst)):
            dst[i] = src[i]
        return 0

    def get_int8_span(self, byte_offset: "i64", count: "i64") -> "list[i32]":
        return self._grow_q(byte_offset, count)

    def get_int32_span(self, byte_offset: "i64", count: "i64") -> "list[i64]":
        return self._grow_i(byte_offset, count)

    def _check_range(self, byte_offset: "i64", num_bytes: "i64") -> 'i32':
        if byte_offset < 0 or byte_offset + num_bytes > self.size_in_bytes:
            raise OutOfRange("offset " + str(byte_offset) + "+" + str(num_bytes) + " exceeds arena " + str(self.size_in_bytes) + "")
        return 0

    def dispose(self) -> 'i32':
        if self.handle != 0:
            native_arena_free(self.handle)
            self.handle = 0
        return 0

# --- host intrinsics: raw memory only (alloc/free/view), like libc malloc.
# Everything built on top (copies, kernels, graphs) is pure .tkv.
def native_arena_alloc(size_in_bytes: "i64") -> "i64":
    return 0
def native_arena_free(handle: "i64") -> "i32":
    return 0
def native_arena_float_view(handle: "i64", byte_offset: "i64", count: "i64") -> "list[f32]":
    return []
def native_arena_int8_view(handle: "i64", byte_offset: "i64", count: "i64") -> "list[i32]":
    return []
def native_arena_int32_view(handle: "i64", byte_offset: "i64", count: "i64") -> "list[i64]":
    return []


def arena_create(size_in_bytes: 'i64') -> 'ExecutionMemoryArena':
    if size_in_bytes == 0:
        size_in_bytes = 64
    aligned = (size_in_bytes + 63) // 64 * 64
    h = native_arena_alloc(aligned)
    return ExecutionMemoryArena(1, aligned, h)

