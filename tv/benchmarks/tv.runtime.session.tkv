# TokenVector Module: Runtime — Execution Graph + Liveness Analysis



class ExecutionGraph:
    _ok: "i64"
    name: 'str'
    nodes: 'list[ExecutionNode]'
    tensors: 'dict[str,TensorDesc]'
    inputs: 'list[str]'
    outputs: 'list[str]'
    initializers: 'dict[str,list[f32]]'
    initializers_int8: 'dict[str,list[i32]]'
    str_values: 'dict[str,list[str]]'
    dim_params: 'dict[str,list[str]]'
    total_arena_bytes: 'i64'
    def __init__(self, name: "str" = "TokenVectorGraph"):
        self.name = name
        self.nodes = []
        self.tensors = {}
        self.inputs = []
        self.outputs = []
        self.initializers = {}
        self.initializers_int8 = {}
        # string tensors (StringConcat/Equal/Length): name -> "UTF"-8 values,
        # side table outside the numeric arena (no "list[f32]" in numerics).
        self.str_values = {}
        self.total_arena_bytes = 0

    def get_or_create_tensor(self, name: "str", shape: "list[i64]", dtype: "i64" = 1) -> "TensorDesc":
        if name in self.tensors:
            existing = self.tensors[name]
            if len(shape) > 0 and len(existing.shape) == 0:
                existing.shape = shape
                existing.element_count = calc_element_count(shape)
                existing.byte_size = existing.element_count * dtype_size(dtype)
            return existing
        desc = make_tensor_desc(name, shape, dtype)
        self.tensors[name] = desc
        return desc

    # Greedy interval allocation: persistent (weights+IO) + scratchpad reuse
    def analyze_liveness_and_allocate_offsets(self) -> 'i32':
        for i in range(len(self.nodes)):
            node = self.nodes[i]
            node.id = i
            _ah2599_12 = node.input_descs
            _ah2599_12.clear()
            for nm in node.inputs:
                if nm in self.tensors:
                    t = self.tensors[nm]
                    _ah2603_20 = node.input_descs
                    _ah2603_20.append(t)
                    if t.lifetime_start == -1:
                        t.lifetime_start = i
                    t.lifetime_end = i
            _ah2607_12 = node.output_descs
            _ah2607_12.clear()
            for nm in node.outputs:
                if nm in self.tensors:
                    t = self.tensors[nm]
                    _ah2611_20 = node.output_descs
                    _ah2611_20.append(t)
                    if t.lifetime_start == -1:
                        t.lifetime_start = i
                    t.lifetime_end = i
        for nm in self.inputs:
            if nm in self.tensors:
                t = self.tensors[nm]
                t.is_input = 1
                t.lifetime_start = 0
                t.lifetime_end = len(self.nodes)
        for nm in self.outputs:
            if nm in self.tensors:
                t = self.tensors[nm]
                t.is_output = 1
                t.lifetime_start = 0
                t.lifetime_end = len(self.nodes)
        cur = 0
        _f32_keys = self.initializers.keys()
        for nm in _f32_keys:
            if nm in self.tensors:
                t = self.tensors[nm]
                t.is_initializer = 1
                t.offset = cur
                cur = cur + ((t.byte_size + 63) // 64 * 64)
        _i8_keys = self.initializers_int8.keys()
        for nm in _i8_keys:
            if nm in self.tensors:
                t = self.tensors[nm]
                t.is_initializer = 1
                t.offset = cur
                cur = cur + ((t.byte_size + 63) // 64 * 64)
        for nm in self.inputs:
            if nm in self.tensors:
                t = self.tensors[nm]
                if t.offset == -1:
                    t.offset = cur
                    cur = cur + ((t.byte_size + 63) // 64 * 64)
        for nm in self.outputs:
            if nm in self.tensors:
                t = self.tensors[nm]
                if t.offset == -1:
                    t.offset = cur
                    cur = cur + ((t.byte_size + 63) // 64 * 64)
        # scratchpad reuse, sorted by lifetime_start
        scratch = []
        _ah2654_17 = self.tensors
        for t in _ah2654_17.values():
            if not t.is_initializer and not t.is_input and not t.is_output:
                scratch.append(t)
        _si = 0
        while _si < len(scratch) - 1:
            _sj = _si + 1
            while _sj < len(scratch):
                _a = scratch[_si]
                _b = scratch[_sj]
                if _b.lifetime_start < _a.lifetime_start:
                    scratch[_si] = _b
                    scratch[_sj] = _a
                _sj = _sj + 1
            _si = _si + 1
        # (2026-09-26) Ba list kiem tra slot cua arena phai la list[i64].
        # `[]` tao `List<TkvInt>`, sau do code day vao gia tri i64 that
        # (`a_off.append(chosen)`, `a_size.append(aligned)`,
        # `a_end.append(t.lifetime_end)`) ma khong co kiem tra kieu phan tu,
        # nen doc sai offset -> cap vung nho sai -> ghi ngoai bien.
        a_off = _nd_i64(0)
        a_size = _nd_i64(0)
        a_end = _nd_i64(0)
        max_scratch = 0
        for t in scratch:
            # R22 (2026-09-26): SUA DIEU KIEN LOC DANH SACH SLOT.
            #
            # Ban dau: `if a_end[_k] >= t.lifetime_start: _keep.append(_k)`
            # - tuc la CHI GIU slot khi nguoi cu o do CON SONG (`a_end` =
            # lifetime_end cua chu so cu) tai thoi diem `t` bat dau ->
            # chinh xac la truong hop CHONG LAN, nhung lai la truong hop
            # duoc PHAI tranh. Haieu qua: khong bao gio tai dung slot da
            # trong, va KHONG bao gio tai dung slot thuc su trong.
            #
            # Do do hai tensor cung song (do lai doc o cung mot node) bi cap
            # CUNG mot offset. Repro that tren do ho If:
            #     br_t_T off=192 lifetime=[0,2]
            #     br_e_E off=192 lifetime=[1,2]
            # Node Where doc ca hai cung luc -> doc cung mot vung nho ->
            # nhan gia tri ghi sau cung (nhan nhanh else). Loi IM LANG:
            # khong nem loi, chi ra so sai.
            #
            # DUNG DIEU KIEN: slot chi tai dung khi nguoi cu KET THUC
            # TRUOC khi `t` bat dau (`a_end < t.lifetime_start`).
            _keep = []
            for _k in range(len(a_off)):
                if a_end[_k] < t.lifetime_start:
                    _keep.append(_k)
            _ko = []
            _ks = []
            _ke = []
            for _k in _keep:
                _ko.append(a_off[_k])
                _ks.append(a_size[_k])
                _ke.append(a_end[_k])
            a_off = _ko
            a_size = _ks
            a_end = _ke
            chosen = -1
            for idx in range(len(a_off)):
                if a_size[idx] >= t.byte_size:
                    chosen = a_off[idx]
                    a_off[idx] = chosen
                    a_size[idx] = a_size[idx]
                    a_end[idx] = t.lifetime_end
                    break
            if chosen == -1:
                chosen = cur + max_scratch
                aligned = (t.byte_size + 63) // 64 * 64
                max_scratch = max_scratch + aligned
                a_off.append(chosen)
                a_size.append(aligned)
                a_end.append(t.lifetime_end)
            t.offset = chosen
        self.total_arena_bytes = cur + max_scratch + 64
        return 0

    def bind_tensors(self, arena: "ExecutionMemoryArena") -> 'i32':
        _tens = self.tensors
        for nm in _tens:
            t = _tens[nm]
            if t.offset >= 0:
                arena.bind(t.offset, t.element_count, t.dtype)
        return 0

    def initialize_weights(self, arena: "ExecutionMemoryArena") -> 'i32':
        _f32_keys = self.initializers.keys()
        for nm in _f32_keys:
            if nm in self.tensors:
                t = self.tensors[nm]
                if t.offset >= 0:
                    arena.copy_from(t.offset, self.initializers[nm])
        _i8_keys = self.initializers_int8.keys()
        for nm in _i8_keys:
            if nm in self.tensors:
                t = self.tensors[nm]
                if t.offset >= 0:
                    arena.copy_from_int8(t.offset, self.initializers_int8[nm])
        return 0


