        pw = _c131
        oh = (ih + 2 * ph - kh) // sh + 1
        ow = (iw + 2 * pw - kw) // sw + 1
        mult = xs * ws / ys
        for b in range(n):
            for o in range(oc):
                for r in range(oh):
                    for u in range(ow):
                        acc = 0
                        for c in range(ic):
