def _split2(s: 'str', sep: 'str') -> 'list[str]':
    out = []
    rest = s
    while s == s:
        i = rest.find(sep)
        if i < 0:
            out.append(rest)
            break
        out.append(rest[:i])
        rest = rest[i + len(sep):]
    return out

def _strides(shape: 'list[i64]') -> 'list[i64]':
    n = len(shape)
    st = []
    _zf106 = 0
    while _zf106 < n:
        st.append(1)
        _zf106 = _zf106 + 1
    i = n - 2
    while i > -1:
        st[i] = st[i + 1] * shape[i + 1]
        i = i + -1
    return st

def _read_ints(arena: 'ExecutionMemoryArena', descs: 'list[TensorDesc]', pos: 'i64') -> 'list[i64]':
    out = []
    if len(descs) > pos:
        d = descs[pos]
        v = arena.get_float_span(d.offset, d.element_count)
        for i in range(len(v)):
            out.append(int(v[i]))
    return out

def _einsum_off(val: 'dict[str,i64]', bc: 'list[i64]', batch: 'list[i64]', shape: 'list[i64]', core: 'str') -> 'i64':
    nb = 1
    for d in batch:
        nb = nb * d
    core_n = 1
    for i in range(len(shape) - len(batch), len(shape)):
        core_n = core_n * shape[i]
    bf = 0
    for i in range(len(bc)):
        bf = bf * batch[i] + bc[i]
    st = _strides(shape)
    off = bf * core_n
    base = len(shape) - len(core)
    for i in range(len(core)):
        off = off + val[core[i:i + 1]] * st[base + i]
    return off

def _reduce_out_index(n: 'i64', shape: 'list[i64]', src_st: 'list[i64]', axes: 'list[i64]', keepdims: 'i64', out_shape: 'list[i64]') -> 'i64':
    out_st = _strides(out_shape)
    rem = n
    idx = 0
    o = len(out_shape) - 1
    a = len(shape) - 1
    while a > -1:
        c = rem % shape[a]
        rem = rem // shape[a]
        if a in axes:
            if keepdims != 0:
                idx = idx + 0 * out_st[o]
                o = o - 1
        else:
            idx = idx + c * out_st[o]
            o = o - 1
        a = a + -1
    return idx






