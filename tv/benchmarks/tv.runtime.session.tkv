                                h = r * sh - ph + kr
                                if h >= 0 and h < ih:
                                    for kc in range(kw):
                                        ww = u * sw - pw + kc
                                        if ww >= 0 and ww < iw:
                                            xv = int(x[((b * ic + c) * ih + h) * iw + ww]) - xzp
                                            wv = int(w[((o * wic + c) * kh + kr) * kw + kc]) - wzp
                                            acc = acc + xv * wv
