TensorDataType_Double = 11
TensorDataType_Uint32 = 12
TensorDataType_Uint64 = 13
TensorDataType_Complex64 = 14
TensorDataType_Complex128 = 15
TensorDataType_BFloat16 = 16
TensorDataType_Float8E4M3FN = 17
TensorDataType_Float8E4M3FNUZ = 18
TensorDataType_Float8E5M2 = 19
TensorDataType_Float8E5M2FNUZ = 20

class TensorDesc:
    _ok: 'i64'
    name: 'str'
    shape: 'list[i64]'
    dtype: 'i64'
    element_count: 'i64'
    byte_size: 'i64'
    offset: 'i64'
    is_input: 'i64'
    is_output: 'i64'
    is_initializer: 'i64'
    lifetime_start: 'i64'
    lifetime_end: 'i64'

    def __init__(self, name: 'str', shape: 'list[i64]', dtype: 'i64' = 1):
        self.name = name
        self.shape = shape
        self.dtype = dtype
        self.element_count = calc_element_count(shape)
        self.byte_size = self.element_count * dtype_size(dtype)
        self.offset = -1
        self.is_input = 0
        self.is_output = 0
        self.is_initializer = 0
        self.lifetime_start = -1
        self.lifetime_end = -1

def calc_element_count(shape: 'list[i64]') -> 'i64':
    if shape is None or len(shape) == 0:
        return 1
    total = 1
    for d in shape:
        if d > 0:
            _c1 = d
        else:
            _c1 = 1
        dim = _c1
        total = total * dim
    return total

def dtype_size(dtype: 'i64') -> 'i64':
    if dtype == TensorDataType_Float:
        return 4
    if dtype == TensorDataType_Float16 or dtype == TensorDataType_BFloat16:
        return 2
    if dtype == TensorDataType_Int8 or dtype == TensorDataType_Uint8:
        return 1
    if dtype == TensorDataType_Float8E4M3FN or dtype == TensorDataType_Float8E5M2:
        return 1
    if dtype == TensorDataType_Int32:
        return 4
    if dtype == TensorDataType_Int64 or dtype == TensorDataType_Double:
        return 8
    return 4


def make_tensor_desc(name: 'str', shape: 'list[i64]', dtype: 'i64') -> 'TensorDesc':
    ec = calc_element_count(shape)
    bs = ec * dtype_size(dtype)
    d = TensorDesc(1, name, dtype, ec, bs, -1, 0, 0, 0, -1, -1)
    d.shape = shape
    return d

