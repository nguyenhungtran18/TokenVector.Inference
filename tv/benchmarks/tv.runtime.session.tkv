def pack_rows(parts: 'list[list[f32]]') -> 'list[f32]':
    total = 0
    if len(parts) > 0:
        _lh1 = parts[0]
        _c7 = len(_lh1)
    else:
        _c7 = 0
    width = _c7
    for p in parts:
        total = total + len(p)
    out = _nd_f32(total)
    o = 0
    for p in parts:
        for i in range(len(p)):
            out[o] = p[i]
            o = o + 1
    return out

def unpack_rows(packed: 'list[f32]', sizes: 'list[i64]') -> 'list[list[f32]]':
    out = []
    o = 0
    for s in sizes:
        part = _nd_f32(s)
        for i in range(s):
            part[i] = packed[o + i]
        o = o + s
        out.append(part)
    return out

def pack_block_mask(q_lens: 'list[i64]', kv_lens: 'list[i64]', kv_offsets: 'list[i64]') -> 'list[f32]':
    sq = 0
    for q in q_lens:
        sq = sq + q
    sk = 0
    for k in kv_lens:
        sk = sk + k
    m = _nd_f32(sq * sk)
    for i in range(sq * sk):
        m[i] = -1000000000000000000000000000000.0
    qo = 0
    ko = 0
    for s in range(len(q_lens)):
        if s < len(kv_offsets):
            _c8 = kv_offsets[s]
        else:
            _c8 = 0
        off = _c8
        for i in range(q_lens[s]):
            for j in range(kv_lens[s]):
                if q_lens[s] == 1 and kv_lens[s] > 1:
                    _c9 = off + i
                else:
                    _c9 = j
                kj = _c9
                if kj < kv_lens[s]:
                    m[(qo + i) * sk + ko + j] = 0.0
        qo = qo + q_lens[s]
        ko = ko + kv_lens[s]
    return m




def _nd_f32(n: "i64") -> "list[f32]":
    out = []
    _zf42 = 0
    while _zf42 < n:
        out.append(0.0)
        _zf42 = _zf42 + 1
    return out

def _nd_i64(n: "i64") -> "list[i64]":
    out = []
    _zf43 = 0
    while _zf43 < n:
