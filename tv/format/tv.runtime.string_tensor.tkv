import tv.numerics.tensor

class StArg(Exception):
    msg: 'str'

class StringTensor:
    _ok: 'i64'
    values: 'list[str]'

    def __init__(self, values: 'list[str]'):
        _qx1000 = []
        for _qx1001 in values:
            _qx1000.append(_qx1001)
        self.values = _qx1000

    def __len__(self) -> 'i32':
        return len(self.values)

    def get(self, i: 'i64') -> 'str':
        return self.values[i]

    def append(self, s: 'str') -> 'i32':
        _ah23_8 = self.values
        _ah23_8.append(s)
        return 0


def offs_blob_end(count: 'i64', offs: 'list[i64]', pos: 'i64') -> 'i32':
    return 0

def utf8_len(s: 'str') -> 'i64':
    n = 0
    for i in range(len(s)):
        c = ord(s[i])
        if c < 128:
            n = n + 1
        elif c < 2048:
            n = n + 2
        elif c < 65536:
            n = n + 3
        else:
            n = n + 4
    return n

def utf8_write(s: 'str', blob: 'list[i32]', pos: 'i64') -> 'i64':
    for i in range(len(s)):
        c = ord(s[i])
        if c < 128:
            blob[pos] = c
            pos = pos + 1
        elif c < 2048:
            blob[pos] = 192 | c >> 6
            blob[pos + 1] = 128 | c & 63
            pos = pos + 2
        elif c < 65536:
            blob[pos] = 224 | c >> 12
            blob[pos + 1] = 128 | c >> 6 & 63
            blob[pos + 2] = 128 | c & 63
            pos = pos + 3
        else:
            blob[pos] = 240 | c >> 18
            blob[pos + 1] = 128 | c >> 12 & 63
            blob[pos + 2] = 128 | c >> 6 & 63
            blob[pos + 3] = 128 | c & 63
            pos = pos + 4
    return pos - (pos - utf8_len(s))

def utf8_read(blob: 'list[i32]', start: 'i64', end: 'i64') -> 'str':
    out = ""
    i = start
    while i < end:
        b0 = blob[i]
        if b0 < 0:
            b0 = b0 + 256
        if b0 < 128:
            out = out + chr(b0)
            i = i + 1
        elif b0 & 224 == 192 and i + 1 < end:
            b1 = blob[i + 1]
            if b1 < 0:
                b1 = b1 + 256
            out = out + chr((b0 & 31) << 6 | b1 & 63)
            i = i + 2
        elif b0 & 240 == 224 and i + 2 < end:
            b1 = blob[i + 1]
            b2 = blob[i + 2]
            if b1 < 0:
                b1 = b1 + 256
            if b2 < 0:
                b2 = b2 + 256
            out = out + chr((b0 & 15) << 12 | (b1 & 63) << 6 | b2 & 63)
            i = i + 3
        elif b0 & 248 == 240 and i + 3 < end:
            b1 = blob[i + 1]
            b2 = blob[i + 2]
            b3 = blob[i + 3]
            if b1 < 0:
                b1 = b1 + 256
            if b2 < 0:
                b2 = b2 + 256
            if b3 < 0:
                b3 = b3 + 256
            out = out + chr((b0 & 7) << 18 | (b1 & 63) << 12 | (b2 & 63) << 6 | b3 & 63)
            i = i + 4
        else:
            out = out + "?"
            i = i + 1
    return out

def str_concat(a: 'StringTensor', b: 'StringTensor') -> 'StringTensor':
    n = min(len(a), len(b))
    out = str_tensor_new()
    for i in range(n):
        out.append(a.get(i) + b.get(i))
    return out

def str_equal(a: 'StringTensor', b: 'StringTensor') -> 'StringTensor':
    n = min(len(a), len(b))
    out = str_tensor_new()
    for i in range(n):
        if a.get(i) == b.get(i):
            _c1 = "true"
        else:
            _c1 = "false"
        out.append(_c1)
    return out


def unpack(offs: 'list[i64]', blob: 'list[i32]', count: 'i64') -> 'StringTensor':
    t = str_tensor_new()
    for i in range(count):
        start = offs[i]
        if i + 1 <= count:
            _c3 = offs[i + 1]
        else:
            _c3 = len(blob)
        end = _c3
        _ah137_8 = t.values
        _ah137_8.append(utf8_read(blob, start, end))
    return t


def _st_nd_f32(n: "i64") -> "list[f32]":
    out = []
    _zf45 = 0
    while _zf45 < n:
        out.append(0.0)
        _zf45 = _zf45 + 1
    return out

def _st_nd_i64(n: "i64") -> "list[i64]":
    out = []
    _zf46 = 0
    while _zf46 < n:
        out.append(0)
        _zf46 = _zf46 + 1
    return out

def _st_nd_i8(n: "i64") -> "list[i64]":
    out = []
    _zf47 = 0
    while _zf47 < n:
        out.append(0)
        _zf47 = _zf47 + 1
    return out


def str_tensor_new() -> 'StringTensor':
    return StringTensor(1)

def str_tensor(vals: 'list[str]') -> 'StringTensor':
    t = StringTensor(1)
    t.values = vals
    return t

def pack_offs(st: 'StringTensor') -> 'list[i64]':
    # Can LEN + 1 moc (2026-09-26).
    #
    # `unpack` doc `offs[i + 1]` lam `end` cua chuoi i. Voi chuoi CUOI,
    # i + 1 == count, nen phai co them moc chua TONG do dai byte. Ban dau chi
    # cap `len(st.values)` moc -> unpack() roi sang nhanh `end = len(blob)`,
    # ma pack_blob cap `total + 1` byte (mot byte NUL duoi de chot chuoi) ->
    # chuoi cuoi nhan them byte 0: "x\0" != "x", va len(offs) cung sai so
    # voi chuan (len + 1).
    n = len(st.values)
    offs = _st_nd_i64(n + 1)
    pos = 0
    for i in range(n):
        offs[i] = pos
        pos = pos + utf8_len(st.values[i])
    offs[n] = pos
    return offs

def pack_blob(st: 'StringTensor') -> 'list[i32]':
    total = 0
    for s in st.values:
        total = total + utf8_len(s)
    blob = _st_nd_i8(total + 1)
    pos = 0
    for i in range(len(st.values)):
        pos = pos + utf8_write(st.values[i], blob, pos)
    return blob
