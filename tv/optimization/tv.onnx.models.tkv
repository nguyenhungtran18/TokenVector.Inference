# TokenVector Module: ONNX — Proto models


# enum -> module constants
TensorDataType_Undefined = 0
TensorDataType_Float = 1
TensorDataType_Uint8 = 2
TensorDataType_Int8 = 3
TensorDataType_Uint16 = 4
TensorDataType_Int16 = 5
TensorDataType_Int32 = 6
TensorDataType_Int64 = 7
TensorDataType_String = 8
TensorDataType_Bool = 9
TensorDataType_Float16 = 10
TensorDataType_Double = 11
TensorDataType_Uint32 = 12
TensorDataType_Uint64 = 13
TensorDataType_Complex64 = 14
TensorDataType_Complex128 = 15
TensorDataType_BFloat16 = 16
TensorDataType_Float8E4M3FN = 17
TensorDataType_Float8E4M3FNUZ = 18
TensorDataType_Float8E5M2 = 19
TensorDataType_Float8E5M2FNUZ = 20
AttributeType_Undefined = 0
AttributeType_Float = 1
AttributeType_Int = 2
AttributeType_String = 3
AttributeType_Tensor = 4
AttributeType_Graph = 5
AttributeType_Floats = 6
AttributeType_Ints = 7
AttributeType_Strings = 8
AttributeType_Tensors = 9
AttributeType_Graphs = 10

class OnnxAttribute:
    _ok: "i64"
    name: 'str'
    type: 'i64'
    f: 'f32'
    i: 'i64'
    s: 'str'
    t: 'OnnxTensor'
    graph: 'OnnxGraph'
    floats: 'list[f32]'
    ints: 'list[i64]'
    strings: 'list[str]'
    def __init__(self, name: "str" = ""):
        self.name = name
        self.type = AttributeType_Undefined
        self.f = 0.0
        self.i = 0
        self.s = ""
        self.t = None
        self.graph = None
        self.floats = []
        self.ints = []
        self.strings = []

class OnnxTensor:
    _ok: "i64"
    name: 'str'
    dtype: 'i64'
    dims: 'list[i64]'
    raw: 'str'
    float_data: 'list[f32]'
    int32_data: 'list[i64]'
    int64_data: 'list[i64]'
    double_data: 'list[f64]'
    string_data: 'list[str]'
    def __init__(self, name: "str" = ""):
        self.name = name
        self.dtype = TensorDataType_Float
        self.dims = []
        self.raw = b""
        self.float_data = []
        self.int32_data = []
        self.int64_data = []
        self.double_data = []
        self.string_data = []

    def extract_float_array(self) -> "list[f32]":
        if len(self.float_data) > 0:
            out = _mo_nd_f32(len(self.float_data))
            for i in range(len(self.float_data)):
                out[i] = self.float_data[i]
            return out
        if len(self.raw) >= 4:
            return native_floats_from_raw(self.raw)
        return _mo_nd_f32(0)

    def extract_string_array(self) -> "list[str]":
        if len(self.string_data) > 0:
            _qx1000 = []
            for _qx1001 in self.string_data:
                _qx1000.append(_qx1001)
            return _qx1000
        if len(self.raw) > 0:
            # raw_data for STRING tensors is repeated length-prefixed? rare; use utf8 whole as single
            return [raw_bytes_to_str(self.raw)]
        return []

    def extract_int32_array(self) -> "list[i64]":
        if len(self.int32_data) > 0:
            return self.int32_data
        if len(self.int64_data) > 0:
            _c9 = []
            for x in self.int64_data:
                _c9.append(int(x))
            return _c9
        if len(self.raw) >= 4:
            return native_ints_from_raw(self.raw)
        return []

class OnnxValueInfo:
    _ok: "i64"
    name: 'str'
    dtype: 'i64'
    dims: 'list[i64]'
    def __init__(self, name: "str" = ""):
        self.name = name
        self.dtype = TensorDataType_Float
        self.dims = []

class OnnxNode:
    _ok: "i64"
    name: 'str'
    op_type: 'str'
    inputs: 'list[str]'
    outputs: 'list[str]'
    attrs: 'dict[str,OnnxAttribute]'
    def __init__(self):
        self.name = ""
        self.op_type = ""
        self.inputs = []
        self.outputs = []
        self.attrs = {}

class OnnxGraph:
    _ok: "i64"
    name: 'str'
    nodes: 'list[OnnxNode]'
    initializers: 'list[OnnxTensor]'
    inputs: 'list[OnnxValueInfo]'
    outputs: 'list[OnnxValueInfo]'
    value_infos: 'list[OnnxValueInfo]'
    def __init__(self):
        self.name = ""
        self.nodes = []
        self.initializers = []
        self.inputs = []
        self.outputs = []
        self.value_infos = []

class OnnxModel:
    _ok: "i64"
    ir_version: 'i64'
    producer_name: 'str'
    producer_version: 'str'
    domain: 'str'
    model_version: 'i64'
    doc_string: 'str'
    graph: 'OnnxGraph'
    def __init__(self):
        self.ir_version = 0
        self.producer_name = ""
        self.producer_version = ""
        self.domain = ""
        self.model_version = 0
        self.doc_string = ""
        self.graph = onnx_graph_new()

def native_floats_from_raw(raw: "str") -> "list[f32]":
    return []
def native_ints_from_raw(raw: "str") -> "list[i64]":
    return []
def raw_bytes_to_str(raw: "str") -> "str":
    return ""


def _mo_nd_f32(n: "i64") -> "list[f32]":
    out = []
    _zf9 = 0
    while _zf9 < n:
        out.append(0.0)
        _zf9 = _zf9 + 1
    return out

def _mo_nd_i64(n: "i64") -> "list[i64]":
    out = []
    _zf10 = 0
    while _zf10 < n:
        out.append(0)
        _zf10 = _zf10 + 1
    return out

def _mo_nd_i8(n: "i64") -> "list[i64]":
    out = []
    _zf11 = 0
    while _zf11 < n:
        out.append(0)
        _zf11 = _zf11 + 1
    return out

def onnx_model_new() -> "OnnxModel":
    return OnnxModel(1, 0, "", "", "", 0, "", onnx_graph_new())

def onnx_graph_new() -> "OnnxGraph":
    return OnnxGraph(1, "")

def onnx_node_new() -> "OnnxNode":
    return OnnxNode(1, "", "")

def onnx_attr_new() -> "OnnxAttribute":
    return OnnxAttribute(1, "", 0, 0.0, 0, "", onnx_tensor_new(), onnx_graph_new())

def onnx_tensor_new() -> "OnnxTensor":
    return OnnxTensor(1, "", 1, "")

def onnx_vi_new() -> "OnnxValueInfo":
    return OnnxValueInfo(1, "", 1)
