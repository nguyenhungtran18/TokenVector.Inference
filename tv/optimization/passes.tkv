// TokenVector Module: Optimization — Graph passes

module tv.optimization.passes

import tv.runtime.execution_graph
import tv.runtime.execution_node
import tv.optimization.kernels
import tv.numerics.tensor

public interface IGraphPass:
    def name(self) -> str
    def run(self, graph: ExecutionGraph) -> bool

public class ConstantFoldingPass implements IGraphPass:
    def name(self) -> str: return "ConstantFoldingPass"

    public def run(self, graph: ExecutionGraph) -> bool:
        modified = False
        doomed: list[ExecutionNode] = []
        for node in graph.nodes:
            all_const = len(node.inputs) > 0
            for nm in node.inputs:
                if nm not in graph.initializers:
                    all_const = False
                    break
            if not all_const or len(node.outputs) == 0:
                continue
            out_name = node.outputs[0]
            src = graph.initializers[node.inputs[0]]
            if node.op_type == OperatorType.Transpose and len(src.shape) == 2:
                folded = NDArray[float32]([src.shape[1], src.shape[0]])
                for r in range(src.shape[0]):
                    for c in range(src.shape[1]):
                        folded[c * src.shape[0] + r] = src[r * src.shape[1] + c]
                graph.initializers[out_name] = folded
                doomed.append(node)
                modified = True
            elif node.op_type == OperatorType.Reshape:
                if out_name in graph.tensors:
                    desc = graph.tensors[out_name]
                    folded = NDArray[float32](desc.shape)
                    n = min(len(src), len(folded))
                    for i in range(n):
                        folded[i] = src[i]
                    graph.initializers[out_name] = folded
                    doomed.append(node)
                    modified = True
        for n in doomed:
            graph.nodes.remove(n)
        return modified

public class OperatorFusionPass implements IGraphPass:
    def name(self) -> str: return "OperatorFusionPass"

    public def run(self, graph: ExecutionGraph) -> bool:
        modified = False
        # Pass 1: MatMul + Add(bias const) -> FusedLinear
        i = 0
        while i < len(graph.nodes) - 1:
            n1 = graph.nodes[i]
            n2 = graph.nodes[i + 1]
            fused = False
            if n1.op_type == OperatorType.MatMul and n2.op_type == OperatorType.Add and len(n1.outputs) > 0:
                inter = n1.outputs[0]
                if len(n2.inputs) >= 2 and (n2.inputs[0] == inter or n2.inputs[1] == inter):
                    bias = n2.inputs[1] if n2.inputs[0] == inter else n2.inputs[0]
                    if bias in graph.initializers:
                        n1.op_type = OperatorType.FusedLinear
                        n1.inputs.append(bias)
                        n1.outputs[0] = n2.outputs[0]
                        graph.nodes.pop(i + 1)
                        modified = True
                        fused = True
            if not fused:
                i = i + 1
        # Pass 2: Linear + Act -> FusedLinear(act)
        i = 0
        while i < len(graph.nodes) - 1:
            n1 = graph.nodes[i]
            n2 = graph.nodes[i + 1]
            fused = False
            if (n1.op_type == OperatorType.FusedLinear or n1.op_type == OperatorType.MatMul) and \
               (n2.op_type == OperatorType.Relu or n2.op_type == OperatorType.Gelu or n2.op_type == OperatorType.Silu or n2.op_type == OperatorType.Sigmoid or n2.op_type == OperatorType.Tanh):
                if len(n1.outputs) > 0 and len(n2.inputs) > 0 and n1.outputs[0] == n2.inputs[0]:
                    n1.op_type = OperatorType.FusedLinear
                    if n2.op_type == OperatorType.Relu: n1.activation = ActivationFunction.ReLU
                    elif n2.op_type == OperatorType.Gelu: n1.activation = ActivationFunction.GELU
                    elif n2.op_type == OperatorType.Silu: n1.activation = ActivationFunction.SiLU
                    elif n2.op_type == OperatorType.Sigmoid: n1.activation = ActivationFunction.Sigmoid
                    elif n2.op_type == OperatorType.Tanh: n1.activation = ActivationFunction.Tanh
                    n1.outputs[0] = n2.outputs[0]
                    graph.nodes.pop(i + 1)
                    modified = True
                    fused = True
            if not fused:
                i = i + 1
        # Pass 3: Conv2D + Relu -> FusedConv2D
        i = 0
        while i < len(graph.nodes) - 1:
            n1 = graph.nodes[i]
            n2 = graph.nodes[i + 1]
            fused = False
            if n1.op_type == OperatorType.Conv2D and n2.op_type == OperatorType.Relu:
                if len(n1.outputs) > 0 and len(n2.inputs) > 0 and n1.outputs[0] == n2.inputs[0]:
                    n1.op_type = OperatorType.FusedConv2D
                    n1.outputs[0] = n2.outputs[0]
                    graph.nodes.pop(i + 1)
                    modified = True
                    fused = True
            if not fused:
                i = i + 1
        return modified

public class QdqFoldPass implements IGraphPass:
    # Folds QDQ roundtrips (QuantizeLinear -> DequantizeLinear no-op pairs from
    # ORT-style exported models) by rewiring consumers to the original tensor.
    # Genuine quantized compute stays as QLinearMatMul with exact 8-input math.
    def name(self) -> str: return "QdqFoldPass"

    public def run(self, graph: ExecutionGraph) -> bool:
        modified = False
        i = 0
        while i < len(graph.nodes):
            node = graph.nodes[i]
            # pattern: QuantizeLinear immediately consumed by matching DequantizeLinear
            if node.op_type == OperatorType.QuantizeLinear and len(node.outputs) == 1:
                if i + 1 < len(graph.nodes):
                    nxt = graph.nodes[i + 1]
                    if nxt.op_type == OperatorType.DequantizeLinear and len(nxt.inputs) > 0 and \
                       nxt.inputs[0] == node.outputs[0] and len(nxt.outputs) == 1:
                        # roundtrip pair: rewire downstream to the original source
                        orig = node.inputs[0]
                        dead = nxt.outputs[0]
                        for nd in graph.nodes:
                            for k in range(len(nd.inputs)):
                                if nd.inputs[k] == dead:
                                    nd.inputs[k] = orig
                        for o in range(len(graph.outputs)):
                            if graph.outputs[o] == dead:
                                graph.outputs[o] = orig
                        graph.nodes.pop(i + 1)
                        graph.nodes.pop(i)
                        modified = True
                        continue
            i = i + 1
        return modified

public class DeadCodeEliminationPass implements IGraphPass:
    def name(self) -> str: return "DeadCodeEliminationPass"

    public def run(self, graph: ExecutionGraph) -> bool:
        orig = len(graph.nodes)
        required: set[str] = set(graph.outputs)
        active: set[int] = set()  # node ids by index
        changed = True
        while changed:
            changed = False
            for i in range(len(graph.nodes) - 1, -1, -1):
                if i in active:
                    continue
                node = graph.nodes[i]
                hit = False
                for o in node.outputs:
                    if o in required:
                        hit = True
                        break
                if hit:
                    active.add(i)
                    for nm in node.inputs:
                        if nm not in required:
                            required.add(nm)
                            changed = True
        graph.nodes = [graph.nodes[i] for i in range(len(graph.nodes)) if i in active]
        dead: list[str] = []
        for nm in graph.tensors:
            if nm not in required and nm not in graph.inputs and nm not in graph.outputs:
                dead.append(nm)
        for nm in dead:
            graph.tensors.pop(nm)
            if nm in graph.initializers:
                graph.initializers.pop(nm)
        return len(graph.nodes) < orig
