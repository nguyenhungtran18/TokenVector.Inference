# TokenVector Module: ONNX — Model Parser


import tv.onnx.models
import tv.onnx.protobuf_reader

# enum -> module constants (wire, synced with runtime bundle)
WireType_Varint = 0
WireType_Fixed64 = 1
WireType_LengthDelimited = 2
WireType_StartGroup = 3
WireType_EndGroup = 4
WireType_Fixed32 = 5


class ArgNull(Exception):
    msg: "str"


def parse_file(path: "str") -> "OnnxModel":
    if path == "":
        raise ArgNull("path")
    buf = parser_read_bytes(path)  # native fs; throws if missing
    return parse_bytes(buf)

def parse_bytes(buf: "str") -> "OnnxModel":
    r = FastProtobufReader(1, buf, 0, 0)
    model = onnx_model_new()
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            model.ir_version = r.read_varint64()
        elif field == 3:
            model.producer_name = r.read_string()
        elif field == 4:
            model.producer_version = r.read_string()
        elif field == 5:
            model.domain = r.read_string()
        elif field == 6:
            model.model_version = r.read_varint64()
        elif field == 7:
            model.doc_string = r.read_string()
        elif field == 8:
            model.graph = _parse_graph(r.read_length_delimited())
        else:
            r.skip_field(wt)
    return model

def _parse_graph(buf: "str") -> "OnnxGraph":
    r = FastProtobufReader(1, buf, 0, 0)
    g = onnx_graph_new()
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            _ah61_12 = g.nodes
            _ah61_12.append(_parse_node(r.read_length_delimited()))
        elif field == 2:
            g.name = r.read_string()
        elif field == 5:
            _ah65_12 = g.initializers
            _ah65_12.append(_parse_tensor(r.read_length_delimited()))
        elif field == 11:
            _ah67_12 = g.inputs
            _ah67_12.append(_parse_value_info(r.read_length_delimited()))
        elif field == 12:
            _ah69_12 = g.outputs
            _ah69_12.append(_parse_value_info(r.read_length_delimited()))
        elif field == 13:
            _ah71_12 = g.value_infos
            _ah71_12.append(_parse_value_info(r.read_length_delimited()))
        else:
            r.skip_field(wt)
    return g

def _parse_node(buf: "str") -> "OnnxNode":
    r = FastProtobufReader(1, buf, 0, 0)
    n = onnx_node_new()
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            _ah85_12 = n.inputs
            _ah85_12.append(r.read_string())
        elif field == 2:
            _ah87_12 = n.outputs
            _ah87_12.append(r.read_string())
        elif field == 3:
            n.name = r.read_string()
        elif field == 4:
            n.op_type = r.read_string()
        elif field == 5:
            a = _parse_attr(r.read_length_delimited())
            if a.name != "":
                n.attrs[a.name] = a
        else:
            r.skip_field(wt)
    return n

def _parse_attr(buf: "str") -> "OnnxAttribute":
    r = FastProtobufReader(1, buf, 0, 0)
    a = onnx_attr_new()
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            a.name = r.read_string()
        elif field == 2:
            a.f = r.read_float()
        elif field == 3:
            a.i = r.read_varint64()
        elif field == 4:
            a.s = r.read_string()
        elif field == 5:
            a.t = _parse_tensor(r.read_length_delimited())
        elif field == 6:
            a.graph = _parse_graph(r.read_length_delimited())
        elif field == 7:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah124_20 = a.floats
                    _ah124_20.append(sub.read_float())
            else:
                _ah126_16 = a.floats
                _ah126_16.append(r.read_float())
        elif field == 8:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah131_20 = a.ints
                    _ah131_20.append(sub.read_varint64())
            else:
                _ah133_16 = a.ints
                _ah133_16.append(r.read_varint64())
        elif field == 9:
            _ah135_12 = a.strings
            _ah135_12.append(r.read_string())
        elif field == 20:
            a.type = r.read_varint32()
        else:
            r.skip_field(wt)
    return a

def _parse_tensor(buf: "str") -> "OnnxTensor":
    r = FastProtobufReader(1, buf, 0, 0)
    t = onnx_tensor_new()
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah154_20 = t.dims
                    _ah154_20.append(sub.read_varint64())
            else:
                _ah156_16 = t.dims
                _ah156_16.append(r.read_varint64())
        elif field == 2:
            t.dtype = r.read_varint32()
        elif field == 4:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah163_20 = t.float_data
                    _ah163_20.append(sub.read_float())
            else:
                _ah165_16 = t.float_data
                _ah165_16.append(r.read_float())
        elif field == 5:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah170_20 = t.int32_data
                    _ah170_20.append(sub.read_varint32())
            else:
                _ah172_16 = t.int32_data
                _ah172_16.append(r.read_varint32())
        elif field == 6:
            # TensorProto.string_data: repeated bytes
            _ah175_12 = t.string_data
            _ah175_12.append(r.read_string())
        elif field == 7:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah180_20 = t.int64_data
                    _ah180_20.append(sub.read_varint64())
            else:
                _ah182_16 = t.int64_data
                _ah182_16.append(r.read_varint64())
        elif field == 8:
            t.name = r.read_string()
        elif field == 9:
            t.raw = r.read_length_delimited()
        elif field == 10:
            if wt == WireType_LengthDelimited:
                sub = FastProtobufReader(1, r.read_length_delimited(), 0, 0)
                while sub.has_more():
                    _ah191_20 = t.double_data
                    _ah191_20.append(sub.read_double())
            else:
                _ah193_16 = t.double_data
                _ah193_16.append(r.read_double())
        else:
            r.skip_field(wt)
    return t

def _parse_value_info(buf: "str") -> "OnnxValueInfo":
    r = FastProtobufReader(1, buf, 0, 0)
    vi = onnx_vi_new()
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            vi.name = r.read_string()
        elif field == 2:
            _parse_type(r.read_length_delimited(), vi)
        else:
            r.skip_field(wt)
    return vi

def _parse_type(buf: "str", target: "OnnxValueInfo") -> "i32":
    r = FastProtobufReader(1, buf, 0, 0)
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            _parse_tensor_type(r.read_length_delimited(), target)
        else:
            r.skip_field(wt)
    return 0

def _parse_tensor_type(buf: "str", target: "OnnxValueInfo") -> "i32":
    r = FastProtobufReader(1, buf, 0, 0)
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            target.dtype = r.read_varint32()
        elif field == 2:
            _parse_shape(r.read_length_delimited(), target.dims)
        else:
            r.skip_field(wt)
    return 0

def _parse_shape(buf: "str", dims: "list[i64]") -> "i32":
    r = FastProtobufReader(1, buf, 0, 0)
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            dims.append(_parse_dim(r.read_length_delimited()))
        else:
            r.skip_field(wt)
    return 0

def _parse_dim(buf: "str") -> "i64":
    r = FastProtobufReader(1, buf, 0, 0)
    val = 1
    while r.has_more():
        field = r.read_tag_field()
        wt = r.last_wt
        if field == 0:
            break
        if field == 1:
            val = r.read_varint64()
        else:
            r.skip_field(wt)
    return val

def parser_read_bytes(path: "str") -> "str":
    return ""
