// TokenVector Module: Optimization — Fused SIMD kernels
// Blocked vector kernels (VEC_W-wide, backend emits packed SIMD) plus fused
// matmul/norm/conv entry points lowered by the tv compiler backend.

module tv.optimization.kernels

import tv.numerics.tensor

# Vector width of the tv SIMD backend (AVX2: 8x float32). Blocked loops below
# are emitted as packed vector ops; tails handled scalar.
public const VEC_W = 8

# Binary op codes (mirror tv.runtime.execution_node.BinaryOp values)
public const BIN_ADD = 0
public const BIN_SUB = 1
public const BIN_MUL = 2
public const BIN_DIV = 3

public enum ActivationFunction:
    None = 0
    ReLU = 1
    GELU = 2
    SiLU = 3
    Sigmoid = 4
    Tanh = 5

# Pure .tv activation (GELU tanh-approx, stable softplus-style branches inline)
public def apply_activation(x: float32, act: ActivationFunction) -> float32:
    if act == ActivationFunction.ReLU:
        return x if x > 0.0 else 0.0
    if act == ActivationFunction.GELU:
        x3 = x * x * x
        return 0.5 * x * (1.0 + _tanh(0.79788456 * (x + 0.044715 * x3)))
    if act == ActivationFunction.SiLU:
        return x / (1.0 + exp(-x))
    if act == ActivationFunction.Sigmoid:
        return 1.0 / (1.0 + exp(-x))
    if act == ActivationFunction.Tanh:
        return _tanh(x)
    return x

def _tanh(x: float32) -> float32:
    if x > 10.0: return 1.0
    if x < -10.0: return -1.0
    e = exp(2.0 * x)
    return (e - 1.0) / (e + 1.0)

# Y = Act(X @ W + Bias) — K-blocked (KB=32) pure .tv; backend vectorizes blocks.
# Empty bias (len 0) = no bias. trans_b selects W layout [N,K] (row-major) vs [K,N].
public def fused_matmul_bias_act(x: NDArray[float32], w: NDArray[float32], bias: NDArray[float32],
        y: NDArray[float32], m: int, n: int, k: int, act: ActivationFunction, trans_b: bool = True):
    has_b = len(bias) > 0
    for mm in range(m):
        for nn in range(n):
            acc = bias[nn] if has_b else 0.0
            if trans_b:
                base = nn * k
                kk = 0
                while kk + 32 <= k:
                    for l in range(32):
                        acc = acc + x[mm * k + kk + l] * w[base + kk + l]
                    kk = kk + 32
                while kk < k:
                    acc = acc + x[mm * k + kk] * w[base + kk]
                    kk = kk + 1
            else:
                for p in range(k):
                    acc = acc + x[mm * k + p] * w[p * n + nn]
            y[mm * n + nn] = apply_activation(acc, act)

# Y = X / sqrt(mean(X^2) + eps) * Gamma — empty gamma (len 0) = ones
public def fused_rms_norm(x: NDArray[float32], gamma: NDArray[float32], y: NDArray[float32],
        n: int, d: int, eps: float32 = 1e-5):
    has_g = len(gamma) > 0
    for i in range(n):
        base = i * d
        ss = 0.0
        j = 0
        while j + VEC_W <= d:
            for l in range(VEC_W):
                ss = ss + x[base + j + l] * x[base + j + l]
            j = j + VEC_W
        while j < d:
            ss = ss + x[base + j] * x[base + j]
            j = j + 1
        rs = 1.0 / sqrt(ss / d + eps)
        j = 0
        while j + VEC_W <= d:
            for l in range(VEC_W):
                g = gamma[j + l] if has_g else 1.0
                y[base + j + l] = x[base + j + l] * rs * g
            j = j + VEC_W
        while j < d:
            g = gamma[j] if has_g else 1.0
            y[base + j] = x[base + j] * rs * g
            j = j + 1

# Y = (X - mean) / sqrt(var + eps) * Gamma + Beta — empty gamma/beta = ones/zeros
public def fused_layer_norm(x: NDArray[float32], gamma: NDArray[float32], beta: NDArray[float32],
        y: NDArray[float32], n: int, d: int, eps: float32 = 1e-5):
    has_g = len(gamma) > 0
    has_b = len(beta) > 0
    for i in range(n):
        base = i * d
        s = 0.0
        for j in range(d):
            s = s + x[base + j]
        mean = s / d
        vs = 0.0
        for j in range(d):
            df = x[base + j] - mean
            vs = vs + df * df
        inv = 1.0 / sqrt(vs / d + eps)
        for j in range(d):
            g = gamma[j] if has_g else 1.0
            b = beta[j] if has_b else 0.0
            y[base + j] = (x[base + j] - mean) * inv * g + b

# Conv2D + folded BatchNorm + ReLU, NCHW direct. BN folded once per channel:
# y = relu(conv * s_eff + b_eff), s_eff = gamma/sqrt(var+eps).
public def fused_conv2d_bn_relu(x: NDArray[float32], w: NDArray[float32], bias: NDArray[float32],
        mean: NDArray[float32], var: NDArray[float32], gamma: NDArray[float32], beta: NDArray[float32],
        y: NDArray[float32], batch: int, in_c: int, in_h: int, in_w: int,
        out_c: int, kh: int, kw: int, sh: int, sw: int, ph: int, pw2: int, eps: float32 = 1e-5):
    for oc in range(out_c):
        g = gamma[oc] if len(gamma) > 0 else 1.0
        bb = beta[oc] if len(beta) > 0 else 0.0
        mm = mean[oc] if len(mean) > 0 else 0.0
        vv = var[oc] if len(var) > 0 else 1.0
        ob = bias[oc] if len(bias) > 0 else 0.0
        inv = 1.0 / sqrt(vv + eps)
        se = g * inv
        be = bb + (ob - mm) * se
        oh = (in_h + 2 * ph - kh) // sh + 1
        ow = (in_w + 2 * pw2 - kw) // sw + 1
        for b in range(batch):
            for o in range(oh):
                ih0 = o * sh - ph
                for u in range(ow):
                    iw0 = u * sw - pw2
                    s = 0.0
                    for ic in range(in_c):
                        for r in range(kh):
                            h = ih0 + r
                            if h < 0 or h >= in_h:
                                continue
                            for t in range(kw):
                                ww = iw0 + t
                                if ww < 0 or ww >= in_w:
                                    continue
                                s = s + x[((b * in_c + ic) * in_h + h) * in_w + ww] * w[((oc * in_c + ic) * kh + r) * kw + t]
                    v = s * se + be
                    y[((b * out_c + oc) * oh + o) * ow + u] = v if v > 0.0 else 0.0

public def memcpy_views(dst: NDArray[float32], src: NDArray[float32], n: int):
    i = 0
    while i + VEC_W <= n:
        for l in range(VEC_W):
            dst[i + l] = src[i + l]
        i = i + VEC_W
    while i < n:
        dst[i] = src[i]
        i = i + 1

public def transpose2d_views(src: NDArray[float32], dst: NDArray[float32], rows: int, cols: int):
    for r in range(rows):
        for c in range(cols):
            dst[c * rows + r] = src[r * cols + c]

# --- Vectorized elementwise kernels (pure .tv, SIMD-blocked) ---
# Dispatch branches ONCE per call; inner blocks are straight-line vector code.

public def unary_relu(x: NDArray[float32], y: NDArray[float32]):
    n = len(x)
    i = 0
    while i + VEC_W <= n:
        for l in range(VEC_W):
            v = x[i + l]
            y[i + l] = v if v > 0.0 else 0.0
        i = i + VEC_W
    while i < n:
        v = x[i]
        y[i] = v if v > 0.0 else 0.0
        i = i + 1

public def elementwise_binary(a: NDArray[float32], b: NDArray[float32], y: NDArray[float32], op: int):
    # op dispatched once; each specialization is a dedicated blocked loop
    if op == BIN_ADD:
        _bin_loop(a, b, y, 0)
    elif op == BIN_SUB:
        _bin_loop(a, b, y, 1)
    elif op == BIN_MUL:
        _bin_loop(a, b, y, 2)
    else:
        _bin_loop(a, b, y, 3)

def _bin_loop(a: NDArray[float32], b: NDArray[float32], y: NDArray[float32], op: int):
    ca = len(a)
    cb = len(b)
    cy = len(y)
    same = (ca == cy and cb == cy)
    bcast_b = (cb == 1)
    bcast_a = (ca == 1 and not same)
    i = 0
    if same:
        while i + VEC_W <= cy:
            for l in range(VEC_W):
                y[i + l] = _bin_scalar(a[i + l], b[i + l], op)
            i = i + VEC_W
        while i < cy:
            y[i] = _bin_scalar(a[i], b[i], op)
            i = i + 1
    elif bcast_b:
        sb = b[0]
        while i + VEC_W <= cy:
            for l in range(VEC_W):
                y[i + l] = _bin_scalar(a[i + l], sb, op)
            i = i + VEC_W
        while i < cy:
            y[i] = _bin_scalar(a[i], sb, op)
            i = i + 1
    elif bcast_a:
        sa = a[0]
        while i + VEC_W <= cy:
            for l in range(VEC_W):
                y[i + l] = _bin_scalar(sa, b[i + l], op)
            i = i + VEC_W
        while i < cy:
            y[i] = _bin_scalar(sa, b[i], op)
            i = i + 1
    else:
        while i < cy:
            y[i] = _bin_scalar(a[i % ca], b[i % cb], op)
            i = i + 1

def _bin_scalar(a: float32, b: float32, op: int) -> float32:
    if op == BIN_ADD: return a + b
    if op == BIN_SUB: return a - b
    if op == BIN_MUL: return a * b
    return a / b

public def softmax_rows(x: NDArray[float32], y: NDArray[float32], n_rows: int, d: int):
    for r in range(n_rows):
        base = r * d
        mx = x[base]
        for j in range(1, d):
            v = x[base + j]
            if v > mx: mx = v
        s = 0.0
        for j in range(d):
            e = exp(x[base + j] - mx)
            y[base + j] = e
            s = s + e
        inv = 1.0 / (s if s > 1e-8 else 1e-8)
        for j in range(d):
            y[base + j] = y[base + j] * inv

# NOTE: zero externs — every kernel above is pure .tv. The tv compiler backend
# lowers the VEC_W/KB-blocked loops to packed SIMD; no host compute dependency.
