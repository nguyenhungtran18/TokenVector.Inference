# TokenVector Module: Text — Tree speculative decoding
# Draft model proposes a token TREE (width x depth); the target model verifies
# whole paths in one pass and accepts the longest matching prefix, then samples
# one extra token. Falls back to plain autoregressive steps when nothing matches.

import tv.runtime.session
import tv.text.sampling
import tv.text.tokenizer
import tv.numerics.tensor


class DraftNode:
    _ok: 'i64'
    token: 'i64'
    parent: 'i64'
    logp: 'f32'
    children: 'list[i64]'
    target_ok: 'i32'
    def __init__(self, token: 'i64', parent: 'i64', logp: 'f32'):
        self.token = token
        self.parent = parent
        self.logp = logp
        self.target_ok = 0


class TreeDraft:
    _ok: 'i64'
    nodes: 'list[DraftNode]'
    def __init__(self):
        self.nodes = [DraftNode(1, -1, -1, 0.0, 0)]

    def add(self, token: 'i64', parent: 'i64', logp: 'f32') -> 'i64':
        _ah22_8 = self.nodes
        _ah22_8.append(DraftNode(1, token, parent, logp, 0))
        idx = len(self.nodes) - 1
        _pn = self.nodes[parent]
        _ah24_8 = _pn.children
        _ah24_8.append(idx)
        return idx

    def path(self, i: 'i64') -> 'list[i64]':
        # Phai gom ca token cua node GOC (2026-09-26).
        #
        # Vong `while i > 0` cu co dieu kien thoat ngay khi i ve 0, nen token
        # cua node goc (id 0) CHUA BAO GIO duoc them -> path() tra ve thieu
        # 1 phan tu. `add(1, 0, 0.0)` tao root co id 0 va parent tro ve chinh
        # no, nen khong the doi thanh `i >= 0` (se lap vo han). Thay vao do
        # di len den khi bat gap root roi prepend token cua root mot lan.
        #
        # `guard` chan truong hop chu ky parent hu (khong phai trong du lieu
        # hop le) de tranh treo vong lap.
        out = []
        out.append(0)
        out.pop()
        guard = 0
        while i > 0 and guard < 4096:
            _ah30_26 = self.nodes[i]
            out.insert(0, _ah30_26.token)
            _ah31_16 = self.nodes[i]
            i = _ah31_16.parent
            guard = guard + 1
        if i == 0:
            _ah30_27 = self.nodes[0]
            out.insert(0, _ah30_27.token)
        return out


def _tree_logits_for(session: 'InferenceSession', history: 'list[i64]', in_dim: 'i64', vocab: 'i64') -> 'list[f32]':
    inp = _nd_f32(in_dim)
    for i in range(in_dim):
        inp[i] = 0.0
    n_hist = 0
    for _ in history:
        n_hist = n_hist + 1
    if n_hist > in_dim:
        tail_n = in_dim
        start = n_hist - in_dim
    else:
        tail_n = n_hist
        start = 0
    base = in_dim - tail_n
    for i in range(tail_n):
        inp[base + i] = float(history[start + i])
    out = session.run_single(inp)
    _no = len(out)
    if _no > vocab:
        _no = vocab
    lg = _nd_f32(_no)
    for i in range(_no):
        lg[i] = out[len(out) - _no + i]
    return lg


def _greedy_top(logits: 'list[f32]', k: 'i64', toks_out: 'list[i64]', lps_out: 'list[f32]') -> 'i32':
    work = _nd_f32(len(logits))
    for i in range(len(logits)):
        work[i] = logits[i]
    picked = []
    picked.append(0)
    picked.pop()
    _nstart = len(logits)
    _nk = min(k, _nstart)
    for _ in range(_nk):
        best = -1
        for i in range(len(logits)):
            dup = 0
            for p in picked:
                if p == i:
                    dup = 1
            if dup == 1:
                continue
            if best < 0 or work[i] > work[best]:
                best = i
        if best < 0:
            break
        picked.append(best)
        toks_out.append(best)
        lps_out.append(work[best])
    return 0


def expand_tree(draft: 'InferenceSession', root_history: 'list[i64]', width: 'i64', depth: 'i64', in_dim: 'i64', vocab: 'i64', max_nodes: 'i64'=64) -> 'TreeDraft':
    tree = TreeDraft(1)
    frontier = [0]
    for _d in range(depth):
        nxt = []
        nxt.append(0)
        nxt.pop()
        for node in frontier:
            if len(tree.nodes) >= max_nodes:
                break
            _qx1000 = []
            for _qx1005 in root_history:
                _qx1000.append(_qx1005)
            hist = _qx1000 + tree.path(node)
            lg = _tree_logits_for(draft, hist, in_dim, vocab)
            _toks = []
            _toks.append(0)
            _toks.pop()
            _lps = []
            _lps.append(0.0)
            _lps.pop()
            _greedy_top(lg, width, _toks, _lps)
            for _ti in range(len(_toks)):
                tok = _toks[_ti]
                lp = _lps[_ti]
                idx = tree.add(tok, node, lp)
                nxt.append(idx)
        frontier = nxt
        if len(frontier) == 0 or len(tree.nodes) >= max_nodes:
            break
    return tree


def verify_tree(target: 'InferenceSession', tree: 'TreeDraft', history: 'list[i64]', params: 'SampleParams', in_dim: 'i64', vocab: 'i64', eos: 'i64'=-1) -> 'list[i64]':
    _qx1001 = []
    for _qx1006 in range(1, len(tree.nodes)):
        _qx1001.append(_qx1006)
    order = _qx1001
    cum = {}
    for i in order:
        _ah98_12 = tree.nodes[i]
        p = _ah98_12.parent
        if p in cum:
            _c2 = cum[p]
        else:
            _c2 = 0.0
        _ah103_17 = tree.nodes[i]
        cum[i] = _c2 + _ah103_17.logp
    accepted = []
    accepted.append(0)
    accepted.pop()
    cur = 0
    _guard = 0
    while _guard < len(tree.nodes) + 1:
        _guard = _guard + 1
        _kids = []
        _kids.append(0)
        _kids.pop()
        _nd = tree.nodes[cur]
        for c in _nd.children:
            _kids.append(c)
        if len(_kids) == 0:
            break
        _hist = []
        for _h in history:
            _hist.append(_h)
        _pth = tree.path(cur)
        for _t in _pth:
            _hist.append(_t)
        lg = _tree_logits_for(target, _hist, in_dim, vocab)
        best = 0
        best_v = lg[0]
        for i in range(1, len(lg)):
            if lg[i] > best_v:
                best_v = lg[i]
                best = i
        nxt = -1
        for c in _kids:
            _cn = tree.nodes[c]
            if _cn.token == best:
                nxt = c
                break
        if nxt < 0:
            break
        _an = tree.nodes[nxt]
        accepted.append(_an.token)
        cur = nxt
        if _an.token == eos:
            break
    tail_hist = []
    for _h in history:
        tail_hist.append(_h)
    _ap = tree.path(cur)
    for _t in _ap:
        tail_hist.append(_t)
    lg = _tree_logits_for(target, tail_hist, in_dim, vocab)
    extra = sample_token(lg, params, tail_hist)
    accepted.append(extra)
    return accepted


def tree_speculative_generate(target: 'InferenceSession', draft: 'InferenceSession', tokenizer: 'Tokenizer', prompt: 'str', max_new_tokens: 'i64', width: 'i64', depth: 'i64', params: 'SampleParams', in_dim: 'i64', vocab: 'i64', eos: 'i64'=-1) -> 'list[i64]':
    ids = tokenizer.encode(prompt)
    for _ in range(max_new_tokens):
        tree = expand_tree(draft, ids, width, depth, in_dim, vocab)
        got = verify_tree(target, tree, ids, params, in_dim, vocab, eos)
        if len(got) == 0:
            break
        for t in got:
            ids.append(t)
        if got[len(got) - 1] == eos:
            break
        if len(got) <= 1:
            lg = _tree_logits_for(target, ids, in_dim, vocab)
            nxt = sample_token(lg, params, ids)
            ids.append(nxt)
            if nxt == eos:
                break
    return ids
