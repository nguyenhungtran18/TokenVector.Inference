class ModelSession:
    _ok: 'i64'
    session: 'InferenceSession'
    batcher: 'DynamicBatcher'
    server: 'EmbeddedServer'

    def __init__(self, model_path: 'str'):
        m = parse_file(model_path)
        g = translate(m)
        sess = session_from_graph(g, 1)
        self.session = sess
        self.batcher = new_dynamic_batcher(1, 32, 200, 10000)
        self.server = new_embedded_server(sess, 8080, default_server_options())

    def run(self, input_tensor: 'list[f32]') -> 'list[f32]':
        _ah36_15 = self.session
        return _ah36_15.run_single(input_tensor)

    def run_named(self, names: 'list[str]', tensors: 'list[list[f32]]', out_names: 'list[str]') -> 'dict[str,list[f32]]':
        inputs = []
        inputs.append(named_tensor("", _nd_f32(1)))
        inputs.pop(0)
        for i in range(len(names)):
            inputs.append(named_tensor(names[i], tensors[i]))
        outs = []
        outs.append(named_tensor("", _nd_f32(1)))
        outs.pop(0)
        for o in out_names:
            session = self.session
            _ah44_19 = session.graph
            tdict = _ah44_19.tensors
            desc = tdict[o]
            _shp = desc.shape
            _ec = desc.element_count
            if len(_shp) > 0:
                _c1 = _shp
            else:
                _c1 = [_ec]
            shape = _c1
            outs.append(named_tensor(o, _nd_f32(calc_element_count(shape))))
        _ah51_8 = self.session
        _ah51_8.run(inputs, outs)
        res = {}
        for oo in outs:
            res[oo.name] = oo.data
        return res

    def serve(self, port: 'i64'=8080) -> 'EmbeddedServer':
        options = default_server_options()
        self.server = new_embedded_server(self.session, port, options)
        return self.server

    def generate(self, tokenizer: 'Tokenizer', prompt: 'str', max_new_tokens: 'i64'=128, temperature: 'f32'=0.0) -> 'GenResult':
        cfg = GenConfig(1, max_new_tokens, -1, "chatml", default_sample_params())
        params = cfg.params
        params.temperature = temperature
        return generate_text(self.session, tokenizer, prompt, cfg)

    def chat(self, tokenizer: 'Tokenizer', messages: 'list[ChatMessage]', max_new_tokens: 'i64'=128, temperature: 'f32'=0.0) -> 'GenResult':
        cfg = GenConfig(1, max_new_tokens, -1, "chatml", default_sample_params())
        params = cfg.params
        params.temperature = temperature
        return chat_generate(self.session, tokenizer, messages, cfg)

    def enable_batching(self, max_batch: 'i64'=32, timeout_us: 'i64'=200, workers: 'i64'=4, max_queue: 'i64'=10000) -> 'DynamicBatcher':
        self.batcher = new_dynamic_batcher(1, max_batch, timeout_us, max_queue)
        return self.batcher

    def make_kv_cache(self, max_seq: 'i64', hidden_dim: 'i64') -> 'AttentionKvCache':
        return create_kv_cache(max_seq, hidden_dim)

    def quantize_int8(self, data: 'list[f32]', scale: 'f32') -> 'list[i32]':
        out = _nd_i8(len(data))
        quantize_int8_symmetric(data, out, scale)
        return out

    def quantize_int8_per_channel(self, data: 'list[f32]', rows: 'i64', cols: 'i64', out: 'list[i32]', scales: 'list[f32]') -> 'i32':
        params = calibrate_per_channel_minmax(data, rows, cols, 1)
        for r in range(rows):
            _ah89_27 = params[r]
            scales.append(_ah89_27.scale)
        quantize_int8_per_channel(data, out, rows, cols, scales)
        return 0

    def calibrate(self, data: 'list[f32]', method: 'str'="minmax", symmetric: 'i32'=1) -> 'QuantParams':
        if method == "kl":
            return calibrate_kl(data)
        if method == "percentile":
            return calibrate_percentile(data, 99.99, symmetric)
        if method == "mse":
            return calibrate_mse(data)
        return calibrate_minmax(data, symmetric)

    def close(self) -> 'i32':
        _sv = self.server
        _sv.dispose()
        _bt = self.batcher
        _bt.dispose()
        _ss = self.session
        _ss.close()
        return 0

def _model_session_new(sess: 'InferenceSession') -> 'ModelSession':
    b = new_dynamic_batcher(1, 32, 200, 10000)
    sv = new_embedded_server(sess, 8080, default_server_options())
    return ModelSession(1, sess, b, sv)

def load_onnx(model_path: 'str') -> 'ModelSession':
    m = parse_file(model_path)
    g = translate(m)
    return _model_session_new(session_from_graph(g, 1))

def load_onnx_bytes(buf: 'str') -> 'ModelSession':
    model = parse_bytes(buf)
    return from_graph(translate(model))

def make_lora(in_features: 'i64', out_features: 'i64', rank: 'i64', alpha: 'f32', m: 'i64'=1) -> 'LoRALinear':
    w = _nd_f32(out_features * in_features)
    b = _nd_f32(out_features)
    for i in range(len(w)):
        w[i] = 0.0
    for i in range(len(b)):
        b[i] = 0.0
    return LoRALinear(w, b, m, out_features, in_features, rank, alpha)

def load_gguf(path: 'str', allow_unverified: 'i32'=0) -> 'i32':
    return GGUFReader(1, "", 0, allow_unverified, 0)

def from_graph(graph: 'ExecutionGraph') -> 'ModelSession':
    return _model_session_new(session_from_graph(graph, 1))

