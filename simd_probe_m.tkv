# PROBE M — simd_gemm(n) co lam hoi goi sau khong (checksum truoc/sau)
def tl(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n * n):
        out.append((float(i % 7) - 3.0) / 7.0)
    return out

def run_n(n: 'i64') -> 'f32':
    a = tl(n)
    b = tl(n)
    c = tl(n)
    simd_gemm(a, b, c, n)
    s = 0.0
    for i in range(n * n):
        s = s + c[i]
    return s

def main() -> 'i32':
    s64a = run_n(64)
    print("n=64 truoc: sum=" + str(s64a))
    s192 = run_n(192)
    print("n=192      : sum=" + str(s192))
    s64b = run_n(64)
    print("n=64 sau   : sum=" + str(s64b))
    if s64a == s64b:
        print("KHONG hoi (64 truoc == 64 sau)")
    else:
        print("CO HONG: 64 sau lech " + str(s64b - s64a))
    s256 = run_n(256)
    print("n=256      : sum=" + str(s256))
    s64c = run_n(64)
    if s64a == s64c:
        print("256 KHONG hoi")
    else:
        print("256 CO HONG: lech " + str(s64c - s64a))
    s96 = run_n(96)
    print("n=96       : sum=" + str(s96))
    s64d = run_n(64)
    if s64a == s64d:
        print("96 KHONG hoi")
    else:
        print("96 CO HONG: lech " + str(s64d - s64a))
    return 0
