# PROBE AB — f32buf lam FIELD cua class (can cho AdamW p/m/v/g)
class Wallet:
    p: 'f32buf'
    n: 'i64'

    def __init__(self, n: 'i64'):
        self.n = n
        self.p = f32buf(n)
        i = 0
        while i < n:
            self.p[i] = float(i) * 1.0
            i = i + 1

    def get(self, i: 'i64') -> 'f32':
        return self.p[i]

    def bump(self) -> 'i64':
        s = 0
        i = 0
        while i < self.n:
            s = s + int(self.p[i])
            i = i + 1
        return s

def main() -> 'i32':
    w = Wallet(16)
    print("AB get(5)=" + str(w.get(5)) + " sum=" + str(w.bump()))
    return 0
