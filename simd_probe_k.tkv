# PROBE K — smm_dot: 1 i-tile vs da i-tile
import tv.training.tensor
import tv.training.simd_matmul

def fill(m: 'i64', n: 'i64', kind: 'i64') -> "Tensor":
    out = t_zeros([m, n])
    d = out.data
    for i in range(m * n):
        if kind == 5:
            d[i] = (float((i * 7 + 13) % 97) - 48.0) / 48.0
        if kind == 8:
            d[i] = (float((i * 19 + 3) % 73) - 36.0) / 36.0
    return out

def md(a: "Tensor", b: "Tensor") -> 'f32':
    da = a.data
    db = b.data
    m = 0.0
    for i in range(len(da)):
        dd = da[i] - db[i]
        if dd < 0.0:
            dd = 0.0 - dd
        if dd > m:
            m = dd
    return m

def ref_dot(a: "Tensor", b: "Tensor", m: 'i64', n: 'i64', k: 'i64') -> "Tensor":
    c = t_zeros([m, n])
    cd = c.data
    ad = a.data
    bd = b.data
    for i in range(m):
        for j in range(n):
            acc = 0.0
            for p in range(k):
                acc = acc + ad[i * k + p] * bd[j * k + p]
            cd[i * n + j] = acc
    return c

def main() -> 'i32':
    a1 = fill(64, 64, 8)
    b1 = fill(64, 64, 5)
    r1 = ref_dot(a1, b1, 64, 64, 64)
    s1 = smm_dot(a1, b1, 64, 64, 64)
    print("K1 1 i-tile (m=T=64): diff=" + str(md(r1, s1)))

    a2 = fill(128, 64, 8)
    r2 = ref_dot(a2, b1, 128, 64, 64)
    s2 = smm_dot(a2, b1, 128, 64, 64)
    print("K2 2 i-tile (m=128,T=64): diff=" + str(md(r2, s2)))

    a3 = fill(192, 32, 8)
    b3 = fill(64, 32, 5)
    r3 = ref_dot(a3, b3, 192, 64, 32)
    s3 = smm_dot(a3, b3, 192, 64, 32)
    print("K3 3 i-tile, pw=32<T=64 (giong J2): diff=" + str(md(r3, s3)))
    return 0
