# PROBE I — tile list tay voi append bieu thuc doc Tensor (pattern fill_expr)
import tv.training.tensor

def tile(n: 'i64', src: "Tensor") -> 'list[f32]':
    out = []
    d = src.data
    i = 0
    while i < n:
        out.append((d[i] - 0.0) / 1.0)
        i = i + 1
    return out

def main() -> 'i32':
    nn = 64
    s = t_zeros([nn * nn])
    a = tile(nn * nn, s)
    b = tile(nn * nn, s)
    c = tile(nn * nn, s)
    simd_gemm(a, b, c, nn)
    print("I1 tile tu Tensor data: OK")
    return 0
