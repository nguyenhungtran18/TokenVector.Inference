    "cells":  [
                  "# 1/4 - clone + dotnet (fault-tolerant)\nprint(\u0027===== ALL NATIVE KERNELS -\u003e PURE TKV (14+7+2) + LOSS CHECK =====\u0027)\n# 1/4 - clone main + prototype + Inference, install .NET (fault-tolerant)\nimport subprocess, os, shutil\nprint(\u0027===== INTEGRATE 14 PURE TKV KERNELS INTO NATIVE BUILD + LOSS CHECK =====\u0027)\nfor d,br in [(\u0027/content/TVmain\u0027,\u0027main\u0027),(\u0027/content/TVcpu\u0027,\u0027prototype/cuda-backend\u0027)]:\n    subprocess.run(\u0027rm -rf \u0027+d, shell=True)\n    subprocess.run(\u0027git clone --depth 1 --branch \u0027+br+\u0027 https://github.com/nguyenhungtran18/TokenVector.git \u0027+d, shell=True, capture_output=True, text=True, timeout=600)\n    print(br, subprocess.check_output(\u0027git -C \u0027+d+\u0027 rev-parse --short HEAD\u0027, shell=True).decode().strip())\nsubprocess.run(\u0027rm -rf /content/TVinf\u0027, shell=True)\nsubprocess.run(\u0027git clone --depth 1 https://github.com/nguyenhungtran18/TokenVector.Inference.git /content/TVinf\u0027, shell=True, capture_output=True, text=True, timeout=600)\ndotnet=shutil.which(\u0027dotnet\u0027)\nif not dotnet:\n    print(\u0027dotnet not found -\u003e installing .NET 10 SDK...\u0027)\n    p=subprocess.run(\u0027wget -q https://dot.net/v1/dotnet-install.sh -O /tmp/dotnet-install.sh \u0026\u0026 chmod +x /tmp/dotnet-install.sh \u0026\u0026 /tmp/dotnet-install.sh --channel 10.0 --install-dir /usr/share/dotnet\u0027, shell=True, capture_output=True, text=True, timeout=900)\n    print(\u0027install rc=\u0027,p.returncode)\n    dotnet=\u0027/usr/share/dotnet/dotnet\u0027\nprint(\u0027dotnet =\u0027,dotnet,\u0027exists=\u0027,os.path.exists(dotnet))",
                  "# 2/4 - build TOAN BO native kernel tu .tkv THUAN (43 exports) + copy .so\nimport subprocess, shutil, os, re\nroot=\u0027/content/TVmain/Release/tools/simd_native\u0027\nex=\u0027/content/TVcpu/Release/cuda_backend/examples\u0027\nbwd=[\u0027bias_add_rows_cpu.cpu.c\u0027,\u0027softmax_causal_fwd_pure.cpu.c\u0027,\u0027merge_hb_head_cpu.cpu.c\u0027,\n     \u0027layernorm_bwd_cpu.cpu.c\u0027,\u0027gelu_erf_bwd_pure.cpu.c\u0027,\u0027gelu_erf_fwd_pure.cpu.c\u0027,\n     \u0027bias_grad_cpu.cpu.c\u0027,\u0027softmax_causal_bwd_pure.cpu.c\u0027,\u0027embed_bwd_pure.cpu.c\u0027,\n     \u0027layernorm_fwd_cpu.cpu.c\u0027]\nparts=[]\nfor f in bwd:\n    s=open(ex+\u0027/\u0027+f).read()\n    ls=[l for l in s.split(\u0027\\n\u0027) if not l.startswith(\u0027#include\u0027) and not l.startswith(\u0027#define\u0027) and l.strip()!=\u0027\u0027]\n    parts.append(\u0027\\n\u0027.join(ls))\nhdr=\u0027#include \u003cimmintrin.h\u003e\\n#include \u003cmath.h\u003e\\n#include \u003cstdlib.h\u003e\\n#define EXPORT __attribute__((visibility(\"default\")))\\n\u0027\nopen(root+\u0027/tkv_bwd_ops.c\u0027,\u0027w\u0027).write(hdr+\u0027\\n\\n\u0027.join(parts)+\u0027\\n\u0027)\nshutil.copyfile(ex+\u0027/linear_dw_cpu.cpu.c\u0027, root+\u0027/tkv_linear_dw.c\u0027)\nshutil.copyfile(ex+\u0027/linear_dx_cpu.cpu.c\u0027, root+\u0027/tkv_linear_dx.c\u0027)\np=root+\u0027/tkv_simd_native.c\u0027; s=open(p).read()\nfor name,gf in [(\u0027F32ListAdd\u0027,\u0027f32_list_add_cpu.cpu.c\u0027),(\u0027F32ListCopy\u0027,\u0027f32_list_copy_cpu.cpu.c\u0027)]:\n    s=re.sub(r\u0027EXPORT int \u0027+name+r\u0027\\(.*?\\n\\}\\n\u0027, open(ex+\u0027/\u0027+gf).read().strip()+\u0027\\n\u0027, s, count=1, flags=re.S)\nopen(p,\u0027w\u0027).write(s)\nshutil.copyfile(ex+\u0027/flash_all_cpu.cpu.c\u0027, root+\u0027/tkv_flash_attn.c\u0027)\nshutil.copyfile(ex+\u0027/attn_cuda_stub_cpu.cpu.c\u0027, root+\u0027/tkv_attn_cuda.c\u0027)\nsrcs=\u0027tkv_simd_native.c tkv_cuda_native.c tkv_linear_dw.c tkv_bwd_ops.c tkv_flash_attn.c tkv_step124.c tkv_prof.c tkv_attn_cuda.c\u0027\nr=subprocess.run(\u0027cd \u0027+root+\u0027 \u0026\u0026 gcc -O2 -mavx2 -mfma -shared -fPIC \u0027+srcs+\u0027 -lm -lpthread -ldl -o tkv_simd_native.so\u0027, shell=True, capture_output=True, text=True, timeout=600)\nprint(\u0027ALL-TKV native build rc=\u0027,r.returncode)\nassert r.returncode==0, r.stderr[:3000]\nshutil.copyfile(root+\u0027/tkv_simd_native.so\u0027,\u0027/content/TVinf/demo/tkv_simd_native.so\u0027)\nprint(\u0027.so copied to Inference demo\u0027)",
                  "# 3/4 - bench CPU: native all-TKV (bseq mode2) vs PyTorch eager CPU\nimport subprocess, os, re, statistics as st, shutil\nDOT=shutil.which(\u0027dotnet\u0027) or \u0027/usr/share/dotnet/dotnet\u0027\nCFG=\u0027/content/TVinf/tv/tests/_seq_cfg.txt\u0027\ndef native_once():\n    open(CFG,\u0027w\u0027).write(\u00271024\\n2\\n1\\n\u0027)\n    env=dict(os.environ); env.pop(\u0027TKV_TORCH_GPU\u0027,None)\n    p=subprocess.run(\u0027cd /content/TVinf \u0026\u0026 LD_LIBRARY_PATH=/content/TVinf/demo \u0027+DOT+\u0027 demo/bseq.dll\u0027,\n                     shell=True,capture_output=True,text=True,timeout=1800,env=env)\n    m=re.search(r\u0027BPHASE seq=(\\d+) fwd=([\\d.]+) loss=([\\d.]+) bwd=([\\d.]+) opt=([\\d.]+) copyback=([\\d.]+) TONG=([\\d.]+) loss_val=([\\d.]+)\u0027,p.stdout or \u0027\u0027)\n    if not m: print(\u0027native parse FAIL rc=\u0027,p.returncode,(p.stdout or \u0027\u0027)[-600:],(p.stderr or \u0027\u0027)[:400]); return None\n    d=dict(zip([\u0027seq\u0027,\u0027fwd\u0027,\u0027loss\u0027,\u0027bwd\u0027,\u0027opt\u0027,\u0027copyback\u0027,\u0027TONG\u0027,\u0027loss_val\u0027],map(float,m.groups())))\n    return d\nruns=[x for x in [native_once() for _ in range(3)] if x]\nfor r in runs: print(\u0027native TONG=%.1f us (%.2f ms) loss=%.6f\u0027%(r[\u0027TONG\u0027],r[\u0027TONG\u0027]/1000.0,r[\u0027loss_val\u0027]))\nnat_ms=st.median([r[\u0027TONG\u0027] for r in runs])/1000.0\nprint(\u0027NATIVE all-TKV median = %.2f ms\u0027%nat_ms)\n# PyTorch eager CPU, GPT2-124M, T=1024, 1 step fwd+bwd+AdamW\nimport torch\nfrom transformers import GPT2Config, GPT2LMHeadModel\nworker=r\u0027\u0027\u0027\nimport time, statistics as st, torch\nfrom transformers import GPT2Config, GPT2LMHeadModel\ntorch.manual_seed(7); T=1024\ncfg=GPT2Config(n_layer=12,n_head=12,n_embd=768,n_positions=T,vocab_size=50257,\n               resid_pdrop=0.0,attn_pdrop=0.0,embd_pdrop=0.0)\nm=GPT2LMHeadModel(cfg).train()\nopt=torch.optim.AdamW(m.parameters(),lr=5e-5,betas=(0.9,0.999),eps=1e-8,weight_decay=0.0)\nids=torch.tensor([[(i*37+11)%50257 for i in range(T)]],dtype=torch.long)\nms=[]\nfor step in range(3):\n    t0=time.perf_counter()\n    loss=m(ids,labels=ids).loss; loss.backward(); opt.step(); opt.zero_grad()\n    dt=(time.perf_counter()-t0)*1000; ms.append(dt)\n    print(\u0027torch-cpu step %d loss=%.4f %.1f ms\u0027%(step,float(loss),dt),flush=True)\nprint(\u0027TORCH_CPU median ms=%.1f\u0027%st.median(ms),flush=True)\n\u0027\u0027\u0027\nopen(\u0027/content/torch_cpu_ref.py\u0027,\u0027w\u0027).write(worker)\np=subprocess.run([\u0027python\u0027,\u0027-u\u0027,\u0027/content/torch_cpu_ref.py\u0027],capture_output=True,text=True,timeout=1800)\nprint((p.stdout or \u0027\u0027)[-2000:])\nmt=re.search(r\u0027TORCH_CPU median ms=([\\d.]+)\u0027,p.stdout or \u0027\u0027)\nif mt:\n    torch_ms=float(mt.group(1))\n    print(\u0027=== SPEEDUP native(all-TKV) vs PyTorch CPU = %.2fx ===\u0027%(torch_ms/nat_ms))\nelse:\n    print(\u0027torch parse FAIL\u0027,(p.stderr or \u0027\u0027)[-800:])",
                  "# 4/4 - summary\nprint(\u0027Native loss must stay 25.45386. Speedup is measured, not claimed.\u0027)"
              ],
