# Build and Output Folders
bin/
obj/
TestResults/
.vs/
.idea/
.vscode/

# Compiled artifacts
*.exe
*.dll
*.pdb
*.ilk

# OS Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.tmp
*~

# Generated dotted import copies emitted next to a root-level build target
# (e.g. tv.runtime.session.tkv). These are STALE duplicates of the canonical
# sources under tv/ and stdlib/ - several had already drifted. Never edit or
# commit them; sync the canonical file instead.
/tv.*.tkv

# Scratch output cua test (pack_tests.tkv ghi shard vao day)
/tv/tests/_tmp_*/

# Cau hinh runtime cho bench/probe theo seq va probe do luong (ghi de khi
# chay — khong commit; xem header cua file .tkv de biet cach tao)
/tv/tests/_seq_cfg.txt
/tv/tests/_thr_cfg.txt

# Build output cua probe/bench (exe + IL + log), 25 MB
# Benchmark scratch — tracked: scripts (.py/.ps1) + committed logs; everything else ignored
/benchmark/*
!/benchmark/*.py
!/benchmark/*.ps1
!/benchmark/*.md
!/benchmark/*.log

# Distribution output: a full duplicate of the source tree plus a bundled
# compiler .exe (which *.exe already excludes, so committing it would produce
# an incomplete package). Kept as a local directory, not in git.
/release/

# Freebuff platform metadata
.freebuff/

# Gate 124M: pointer duong dan fixture ngoai repo (runtime file)
tv/tests/g2_full_dir.txt

# Fixture GPT-2 124M (~2.3 GB, sinh bang gen_gpt2_fixture.py --full) — NGOAI git
tv/tests/fixtures-124m/
# Perch session metadata (khong phai source)
.perch/

# Scratch do luong flash SDPA (probe .c + build artifact, khong phai source)
/_flash_work/
/_fw2/
/_fw3/

# NuGet build artifacts (packaging/*.nupkg regenerable via packaging/pack.ps1)
/packaging/*.nupkg
