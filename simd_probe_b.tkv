# PROBE B — global co kieu + gán tu function
SIMD_MODE: "i64" = 0
CFG_LIST: "list[i64]" = [7]

def read_mode() -> 'i64':
    return SIMD_MODE * 1000 + CFG_LIST[0]

def set_plain(v: 'i32') -> 'i32':
    SIMD_MODE = v
    CFG_LIST[0] = v + 100
    return 0

def main() -> 'i32':
    print("doc truc tiep: " + str(read_mode()) + " (dung neu khong sua gi = 007 -> 7)")
    set_plain(5)
    print("sau set_plain(5): " + str(read_mode()) + " (5105 neu gan module, 107 neu chi local + list dung)")
    return 0
