# PROBE F — local annotated f32
import tv.training.tensor
def fill_ann(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n * n):
        v: "f32" = 0.0
        if i % 3 == 0:
            v = float(i % 7) / 7.0
        out.append(v)
    return out

def main() -> 'i32':
    n = 64
    a = fill_ann(n)
    out2 = []
    for i in range(n * n):
        out2.append(float(i % 5) / 5.0)
    c = t_zeros([n, n])
    cd = c.data
    simd_gemm(a, out2, cd, n)
    print("ann-local OK")
    return 0
