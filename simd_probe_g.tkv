# PROBE G — xac dinh runtime type cua tung kieu list dung trong simd_gemm
import tv.training.tensor

def fill_probe_style(n: 'i64') -> 'list[f32]':
    out = []
    for i in range(n * n):
        out.append((float(i % 97) - 48.0) / 48.0)
    return out

def main() -> 'i32':
    n = 64
    c1 = t_zeros([n, n])
    c2 = t_zeros([n, n])
    c3 = t_zeros([n, n])
    d1 = c1.data
    d2 = c2.data
    d3 = c3.data
    simd_gemm(d1, d2, d3, n)
    print("G1 all-t_zeros OK")
    a = fill_probe_style(n)
    simd_gemm(a, a, d3, n)
    print("G2 probe-style x t_zeros OK")
    return 0
